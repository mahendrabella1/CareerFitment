rules_version = '2';

// Firestore security rules for user accounts.
// Deploy from the Firebase console (Firestore -> Rules) or `firebase deploy
// --only firestore:rules`.
service cloud.firestore {
  match /databases/{database}/documents {

    // Admins (keep in sync with lib/auth/admins.ts) may read every profile.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['support@onegrasp.com'];
    }
    // A user may read/write their OWN profile; admins may read all profiles and
    // write them (e.g. to assign a school).
    match /users/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if request.auth != null && (request.auth.uid == uid || isAdmin());
    }
    // Admin-managed list of schools.
    match /schools/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // App settings written from /admin - currently `payment` (fee on/off and
    // price). ONLY an admin may write: the server trusts these values when it
    // creates a Razorpay order, so a student who could edit them could set
    // their own price or waive the fee. Reads are open to signed-in users so
    // the admin console can show the current state.
    match /settings/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // Admin-managed coupon codes (/admin/coupons). Same reasoning as
    // `settings` above - lib/coupons.ts reads these server-side (via the
    // Admin SDK, which bypasses these rules) to price every order, so only an
    // admin may add or remove one from here.
    match /coupons/{doc} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }
    // Admin-managed institutional links (/admin/institutional) - a school's
    // free-signup code and contact details. Tighter than `coupons` above:
    // nothing needs authenticated-but-non-admin reads here. Redemption
    // (marking a new student paid) and the pre-signup validity check both
    // go through server routes using the Admin SDK, which bypasses these
    // rules entirely - a signed-in student never reads or writes this
    // collection directly, and it holds school contact emails/phones that
    // shouldn't be readable by guessing the collection name in devtools.
    match /institutional_links/{code} {
      allow read, write: if isAdmin();
    }
    // Everything else denied by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}