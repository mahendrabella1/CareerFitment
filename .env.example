# Public — safe to expose to the browser
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only — NEVER expose to the browser or commit this value.
# Used by API routes (lib/supabase/client.ts -> getSupabaseAdmin) to bypass
# RLS when generating sessions and writing responses/scores.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin dashboard access token (/admin + GET /api/leads). Change this for
# production; if unset, defaults to "onegrasp-admin-dev".
ADMIN_TOKEN=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Firebase / Firestore (questions + leads). EASIEST: skip these and just drop
# the downloaded key file at project/serviceAccountKey.json instead.
# Otherwise paste the three values from that JSON here. Keep the quotes on the
# private key; the literal \n sequences are converted to real newlines at load.
# ---------------------------------------------------------------------------
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ---------------------------------------------------------------------------
# Firebase WEB config (PUBLIC — safe to expose) for user accounts (Auth +
# Firestore). Get these from Firebase console -> Project settings -> Your apps
# -> Web app -> SDK setup and configuration. Required for /register, /signin,
# /account to actually work. Also enable Email/Password in Authentication.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-web-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=careerfitment.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=careerfitment
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=careerfitment.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# ---------------------------------------------------------------------------
# SMTP for emailing reports from /admin (Hostinger). Add the REAL values in
# Vercel -> Settings -> Environment Variables and in a local .env.local.
# NEVER commit the real password.
# ---------------------------------------------------------------------------
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=support@onegrasp.com
SMTP_PASS=your-smtp-password

# ---------------------------------------------------------------------------
# Razorpay — assessment fee gate. KEY_ID is public (used by the browser
# checkout); KEY_SECRET is SERVER-ONLY — never expose or commit it. Amount is
# in paise (9900 = ₹99). Set the real values in .env.local / Vercel env.
#
# The ID and the SECRET must be copied from the SAME "Generate Key" click in
# Razorpay Dashboard -> Account & Settings -> API Keys. Regenerating replaces
# BOTH; updating only one gives "Authentication failed" on the order call and
# "The api key provided is invalid" in the checkout window.
#
# Prefer RAZORPAY_KEY_ID (server-only name): NEXT_PUBLIC_* is inlined at BUILD
# time, so changing it in Vercel needs a fresh deploy WITHOUT the build cache
# before it takes effect. Set both if you like — RAZORPAY_KEY_ID wins.
#
# NOTE: the fee on/off switch and the price are now controlled from /admin
# ("Assessment payment"), stored in Firestore at settings/payment. The
# RAZORPAY_AMOUNT_PAISE values below are only the fallback used before an admin
# has ever saved, or if the server can't reach Firestore. The KEY_ID/KEY_SECRET
# still have to come from env — with no secret, nobody is charged regardless of
# what the admin switch says.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_AMOUNT_PAISE=9900
NEXT_PUBLIC_RAZORPAY_AMOUNT_PAISE=9900

# ---------------------------------------------------------------------------
# Meta (Facebook) Pixel — site-wide tracking, all CTAs + PageView + Lead /
# CompleteRegistration / Purchase. Get the ID from Meta Events Manager.
# Leave unset to disable the pixel entirely (nothing loads).
# ---------------------------------------------------------------------------
NEXT_PUBLIC_META_PIXEL_ID=your-meta-pixel-id

# ---------------------------------------------------------------------------
# OneGrasp CRM — every registration and captured lead is pushed here server-
# side (app/api/crm-lead, app/api/leads). SERVER-ONLY — never expose this as
# a NEXT_PUBLIC_* var or call the CRM webhook from client-side code; the
# token would leak to anyone viewing page source / devtools network tab.
# ---------------------------------------------------------------------------
ONEGRASP_CRM_WEBHOOK_TOKEN=ogk_live_your-token-here
