# Environment Variables - Copy to .env.local and fill in actual values

# Groq AI API Key (for education search feature)
# Get from: https://console.groq.com/keys
# Format: gsk_...
# ⚠️ NEVER commit .env.local to git - add to .gitignore
GROQ_API_KEY=gsk_your_actual_key_here

# Firebase Configuration (if using Firebase auth)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (server-side only) - required for the /admin payment
# on/off toggle to persist, and for coupon-redemption logging. Without these,
# lib/paymentSettings.ts falls back to env-only defaults (source: "env").
# Get from: Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Razorpay (payment gate) - without RAZORPAY_KEY_SECRET, isPaymentActive()
# reports false and every student gets in free (see lib/paymentSettings.ts
# and lib/razorpay.ts). RAZORPAY_KEY_ID has a baked-in fallback in code, but
# the secret has none and must be set here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Assessment fee in paise. Defaults to 199900 (₹1999) if unset.
RAZORPAY_AMOUNT_PAISE=

# SMTP (transactional email) - without these, every email silently no-ops:
# the student's assessment-completion email, the team's "new lead"/"student
# finished"/"payment received" notifications (lib/studentEmail.ts,
# lib/leadEmail.ts), and the admin's manual "send full report" action
# (app/api/admin/send-report/route.ts), which instead returns a clear
# "Email not configured" error naming exactly what's missing.
# SMTP_HOST must be the bare hostname (e.g. "smtp.hostinger.com"), no
# "https://" prefix. Port 465 = SSL, 587 = STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# Where "new lead" / "student completed" team notifications go. Defaults to
# support@onegrasp.com if unset - override on staging so it doesn't page the
# real inbox.
TEAM_NOTIFY_EMAIL=

# Database (when needed)
DATABASE_URL=

# API URLs
NEXT_PUBLIC_API_URL=http://localhost:3000

# Feature Flags
SHOW_TOOLKIT=true
SHOW_REPORTS=true
SHOW_AI_ASSISTANT=true
