cm.org/"},{"text":"Supply Planner / Planning Manager"}],[{"text":"Procurement"},{"text":"Sourcing, vendor management, negotiation, ERP"},{"text":"CIPS","url":"https://www.cips.org/"},{"text":"Procurement Manager"}],[{"text":"Logistics"},{"text":"Transportation, warehousing, fulfilment, Excel"},{"text":"DHL Supply Chain","url":"https://www.dhl.com/global-en/home/our-divisions/supply-chain.html"},{"text":"Logistics Manager"}],[{"text":"E-Commerce Operations"},{"text":"Orders, inventory, fulfilment, marketplaces"},{"text":"Amazon Jobs","url":"https://www.amazon.jobs/"},{"text":"E-Commerce Operations Manager"}],[{"text":"Supply-Chain Analytics"},{"text":"Excel, SQL, Power BI, forecasting"},{"text":"Microsoft Power BI","url":"https://www.microsoft.com/en-us/power-platform/products/power-bi"},{"text":"Supply Chain Analytics Manager"}]]},{"type":"note","label":"2035–2046","text":"Move from coordination into planning and decision-making. Build capability in forecasting, supply-chain analytics, ERP, automation, AI-assisted planning, supplier risk and sustainability."}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"h","text":"Government / public routes"},{"type":"table","header":["Route","Who can apply","Pay and cost","Link"],"rows":[[{"text":"AICTE Internship Portal"},{"text":"Students meeting individual opportunity requirements"},{"text":"Varies;"},{"text":"AICTE Internship Portal","url":"https://internship.aicte-india.org/"}],[{"text":"National Career Service"},{"text":"Students/job seekers meeting individual listings"},{"text":"Varies;"},{"text":"National Career Service","url":"https://www.ncs.gov.in/"}],[{"text":"Public-sector logistics/operations internships"},{"text":"Depends on organisation and notification"},{"text":"Varies;"},{"text":"MyGov","url":"https://www.mygov.in/"}]]},{"type":"h","text":"Private / industry routes"},{"type":"table","header":["Route","What it is","Cost and timing","Link"],"rows":[[{"text":"E-commerce operations internships"}