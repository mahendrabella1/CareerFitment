nsors"},{"text":"Weather stations"},{"text":"Water systems"},{"text":"Smart meters"},{"text":"to monitor urban conditions."}]},{"type":"h","text":"5. Autonomous & Connected Mobility"},{"type":"p","text":"Future urban planning increasingly needs to consider:"},{"type":"list","items":[{"text":"EVs"},{"text":"Autonomous vehicles"},{"text":"V2X"},{"text":"Shared mobility"},{"text":"Smart traffic signals"},{"text":"Dynamic curb management"},{"text":"Mobility-as-a-Service"}]},{"type":"h","text":"6. Climate Intelligence"},{"type":"p","text":"Future smart cities will combine:"},{"type":"flow","items":["Climate data","GIS","AI","infrastructure","urban planning"],"sep":"+"},{"type":"p","text":"to model:"},{"type":"list","items":[{"text":"Heat"},{"text":"Flooding"},{"text":"Water stress"},{"text":"Air quality"},{"text":"Disaster risk"}]},{"type":"h","text":"7. Urban IoT"},{"type":"p","text":"Applications include:"},{"type":"list","items":[{"text":"Smart street lighting"},{"text":"Parking"},{"text":"Waste collection"},{"text":"Water leakage"},{"text":"Air quality"},{"text":"Public safety"},{"text":"Energy management"}]},{"type":"h","text":"Recommended Final Skill Stack"},{"type":"h","text":"Planning"},{"type":"flow","items":["Urban Planning","Regional Planning","Land Use","Infrastructure"],"sep":"+"},{"type":"h","text":"Spatial"},{"type":"flow","items":["GIS","Remote Sensing","Spatial Databases","GeoAI"],"sep":"+"},{"type":"h","text":"Data"},{"type":"flow","items":["SQL","Python","GeoPandas","Statistics","Power BI"],"sep":"+"},{"type":"h","text":"Technology"},{"type":"flow","items":["IoT","Cloud","APIs","Data Platforms","Digital Twins"],"sep":"+"},{"type":"h","text":"Mobility"},{"type":"flow","items":["Public Transport","ITS","EV","Active Mobility"],"sep":"+"},{"type":"h","text":"Sustainability"},{"type":"flow","items":["Climate Resilience","Green Infrastructure","Energy","Water"],"sep":"+"},{"type":"h","text":"Consulting"},{"type":"flow","items":["Project Management","Stakehol