,{"type":"h","text":"5. Transportation Planning"},{"type":"p","text":"Excellent for smart mobility specialization."},{"type":"h","text":"6. Data Science / Urban Analytics"},{"type":"p","text":"Useful for highly quantitative smart-city careers."},{"type":"h","text":"7. MBA — Infrastructure / Technology / Public Management"},{"type":"p","text":"More useful later when transitioning toward consulting and leadership."},{"type":"h","text":"Career Specializations"},{"type":"h","text":"🏙 Smart City Strategy"},{"type":"p","text":"Master planning + digital transformation."},{"type":"h","text":"🗺 Urban GIS & Analytics"},{"type":"p","text":"Spatial data and evidence-based planning."},{"type":"h","text":"🚇 Smart Mobility"},{"type":"flow","items":["Public transport","ITS","EV","mobility analytics."],"sep":"+"},{"type":"h","text":"💧 Smart Water"},{"type":"flow","items":["Water infrastructure","IoT","analytics."],"sep":"+"},{"type":"h","text":"♻️ Smart Waste"},{"type":"flow","items":["Waste systems","route optimization","sensors."],"sep":"+"},{"type":"h","text":"⚡ Smart Energy"},{"type":"flow","items":["Energy management","distributed energy","urban sustainability."],"sep":"+"},{"type":"h","text":"🌡 Climate-Smart Cities"},{"type":"flow","items":["Climate adaptation","resilience","urban analytics."],"sep":"+"},{"type":"h","text":"🧠 AI for Cities"},{"type":"flow","items":["AI","GIS","urban data","scenario modelling."],"sep":"+"},{"type":"h","text":"🪐 Urban Digital Twins"},{"type":"flow","items":["3D cities","GIS","IoT","simulation."],"sep":"+"},{"type":"h","text":"Career Progression"},{"type":"h","text":"Smart City Consulting Route"},{"type":"flow","items":["B.Plan","Urban Planning / GIS Intern","Smart City Analyst","Smart City Consultant","Senior Smart City Consultant","Smart City Project Lead","Urban Transformation Director","Smart City Strategy Leader"]},{"type":"h","text":"GIS → Smart City Route"},{"type":"flow","items":["B.Plan","GIS Intern","GIS / Spatial Analyst","Urban Data A