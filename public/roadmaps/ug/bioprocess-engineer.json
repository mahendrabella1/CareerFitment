ext":"Centrifugation"},{"text":"Chromatography"},{"text":"UF/DF"},{"text":"Purification"}]},{"type":"h","text":"📋 Quality"},{"type":"list","items":[{"text":"GMP"},{"text":"GLP"},{"text":"Validation"},{"text":"CAPA"},{"text":"Risk management"},{"text":"QbD"}]},{"type":"h","text":"💻 Digital"},{"type":"list","items":[{"text":"Python"},{"text":"MATLAB"},{"text":"Excel"},{"text":"DoE"},{"text":"Statistical analysis"},{"text":"Process modelling"},{"text":"Bioprocess control"}]},{"type":"h","text":"🤖 Future"},{"type":"list","items":[{"text":"AI/ML"},{"text":"Digital twins"},{"text":"PAT"},{"text":"Automated bioreactors"},{"text":"Continuous bioprocessing"},{"text":"Robotics"},{"text":"Real-time process optimisation"}]},{"type":"h","text":"Ideal Graduate Profile"},{"type":"p","text":"By graduation, the student should ideally be able to demonstrate:"},{"type":"p","text":"“I understand biological production systems and can design, operate and analyse bioprocesses, work with upstream and downstream processing, understand bioreactor scale-up and process control, apply GMP and statistical optimisation, and use data-driven tools to improve bioprocess performance.”"},{"type":"p","text":"For Biotechnology Engineering → Bioprocess Engineer, the strongest employability combination is:"},{"type":"flow","items":["Biotechnology","Bioreactor Engineering","Upstream/Downstream Processing","Scale-up","GMP","Process Control","Data/AI."],"sep":"+"}]}]}