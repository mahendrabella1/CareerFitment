ed Master's"},{"type":"list","items":[{"text":"MSc Occupational Health & Safety"},{"text":"MSc Environmental Management"},{"text":"MSc Safety Management"},{"text":"Master's in Industrial Safety"}]}]},{"heading":"Career Specializations","kind":"other","blocks":[{"type":"h","text":"1. Industrial Safety"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Manufacturing"},{"text":"Machinery"},{"text":"Electrical safety"},{"text":"Material handling"},{"text":"Workplace hazards"}]},{"type":"h","text":"2. Fire & Life Safety"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Fire protection"},{"text":"Fire prevention"},{"text":"Emergency response"},{"text":"Fire systems"},{"text":"Building safety"}]},{"type":"h","text":"3. Process Safety"},{"type":"p","text":"Particularly valuable in:"},{"type":"list","items":[{"text":"Oil & gas"},{"text":"Chemical"},{"text":"Petrochemical"},{"text":"Pharmaceutical"}]},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"HAZOP"},{"text":"LOPA"},{"text":"Process hazards"},{"text":"Safety instrumented systems"},{"text":"Major accident prevention"}]},{"type":"h","text":"4. Environmental Management"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Waste"},{"text":"Water"},{"text":"Air emissions"},{"text":"Environmental compliance"},{"text":"Sustainability"}]},{"type":"h","text":"5. Occupational Health"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Industrial hygiene"},{"text":"Ergonomics"},{"text":"Exposure assessment"},{"text":"Workplace health"}]},{"type":"h","text":"6. EHS Analytics"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Safety dashboards"},{"text":"Incident prediction"},{"text":"Leading indicators"},{"text":"Risk analytics"},{"text":"AI-assisted safety analysis"}]}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"flow","items":["Safety Officer / EHS Officer","Safety Engineer / EHS Engineer","Senior Safety Engineer /