rile procedures"},{"text":"Emergency cardiac cases"}]},{"type":"p","text":"Maintain a clinical logbook documenting procedures and skills without patient-identifying information."}]},{"heading":"Entry-Level Roles","kind":"other","blocks":[{"type":"p","text":"Possible starting positions include:"},{"type":"list","items":[{"text":"Cath-Lab Technologist"},{"text":"Cardiovascular Technologist"},{"text":"Cardiac Catheterization Technologist"},{"text":"Cardiology Technologist"},{"text":"Cath-Lab Technician"},{"text":"Interventional Cardiology Technologist"},{"text":"Junior Cardiovascular Technologist"}]},{"type":"p","text":"The primary target is:"},{"type":"h","text":"Cath-Lab Technologist"}]},{"heading":"Employer Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Employer Type","High-Value Skills"],"rows":[[{"text":"Cardiac Hospitals"},{"text":"Cath-lab + cardiovascular procedures"}],[{"text":"Multi-specialty Hospitals"},{"text":"Cath-lab + emergency care"}],[{"text":"Medical Colleges"},{"text":"Procedures + documentation"}],[{"text":"Heart Institutes"},{"text":"Advanced interventional cardiology"}],[{"text":"Trauma Centres"},{"text":"Emergency cardiovascular support"}],[{"text":"Interventional Centres"},{"text":"PCI equipment + hemodynamics"}],[{"text":"Medical Device Companies"},{"text":"Device + clinical application"}],[{"text":"Cardiac Research Centres"},{"text":"Data + procedure documentation"}]]}]},{"heading":"Certifications & Additional Learning","kind":"certifications","blocks":[{"type":"p","text":"Useful areas include:"},{"type":"h","text":"Emergency"},{"type":"list","items":[{"text":"Basic Life Support"},{"text":"CPR"},{"text":"First Aid"},{"text":"Emergency cardiovascular response"}]},{"type":"h","text":"Clinical"},{"type":"list","items":[{"text":"ECG"},{"text":"Infection control"},{"text":"Sterile technique"},{"text":"Hemodynamic monitoring"},{"text":"Cath-lab safety"}]},{"type":"h","text":"Technical"},{"type":"list","items":[{"text":"Radiation 