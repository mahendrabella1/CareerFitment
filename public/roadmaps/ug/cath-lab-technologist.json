xt":"Angiography system familiarity"},{"text":"Cath-lab equipment"},{"text":"Catheter and guidewire knowledge"},{"text":"Contrast injector"},{"text":"Hemodynamic monitor"},{"text":"Emergency equipment"}]},{"type":"h","text":"Safety"},{"type":"list","items":[{"text":"BLS/CPR"},{"text":"Radiation protection"},{"text":"Sterile technique"},{"text":"Infection control"},{"text":"Contrast-reaction awareness"}]},{"type":"h","text":"Portfolio"},{"type":"p","text":"At least 3–5 projects, such as:"},{"type":"list","items":[{"text":"Cath-lab equipment checklist"},{"text":"Coronary angiography workflow study"},{"text":"Radiation-safety audit"},{"text":"Hemodynamic waveform portfolio"},{"text":"Cath-lab emergency preparedness project"}]}]},{"heading":"Ideal Portfolio","kind":"other","blocks":[{"type":"p","text":"Cardiovascular Technology Degree"},{"type":"p","text":"+"},{"type":"p","text":"Cardiac Anatomy & Physiology"},{"type":"p","text":"+"},{"type":"p","text":"ECG"},{"type":"p","text":"+"},{"type":"p","text":"Cath-Lab Training"},{"type":"p","text":"+"},{"type":"p","text":"Angiography"},{"type":"p","text":"+"},{"type":"p","text":"Hemodynamic Monitoring"},{"type":"p","text":"+"},{"type":"p","text":"Interventional Device Knowledge"},{"type":"p","text":"+"},{"type":"p","text":"Sterile Technique"},{"type":"p","text":"+"},{"type":"p","text":"Radiation Safety"},{"type":"p","text":"+"},{"type":"p","text":"BLS / Emergency Training"},{"type":"p","text":"+"},{"type":"p","text":"Clinical Internship"},{"type":"p","text":"+"},{"type":"p","text":"Cath-Lab Logbook"},{"type":"p","text":"+"},{"type":"flow","items":["3–5 Projects","Cath-Lab Technologist"]}]},{"heading":"Best Overall Positioning","kind":"other","blocks":[{"type":"h","text":"Best pathway:"},{"type":"flow","items":["Cardiac/CV Technology","Cardiovascular Anatomy & Physiology","ECG","Cath-Lab Equipment","Sterile Technique","Hemodynamic Monitoring","Angiography & PCI Exposure","Clinical Internship","Cath-Lab Technologist","Senior/Lead Technologist","Specialty or Cath-Lab Supervisor"]},{"type":"p","text":"The strongest long-term profile is:"},{"type":"p","text":"A technically skilled cardiovascular professional with strong cath-lab workflow knowledge, hemodynamic monitoring ability, interventional-device familiarity, radiation and infection-control discipline, emergency preparedness and the ability to support complex cardiovascular procedures safely and efficiently."}]}]}