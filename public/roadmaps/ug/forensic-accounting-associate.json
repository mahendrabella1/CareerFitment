"},{"text":"Working-capital analysis"}]},{"type":"h","text":"Audit"},{"type":"list","items":[{"text":"Audit planning"},{"text":"Internal controls"},{"text":"Risk assessment"},{"text":"Sampling"},{"text":"Vouching"},{"text":"Verification"},{"text":"Substantive procedures"},{"text":"Audit evidence"},{"text":"Working papers"},{"text":"Internal audit"}]},{"type":"h","text":"Forensic investigation"},{"type":"list","items":[{"text":"Fraud-risk assessment"},{"text":"Fraud schemes"},{"text":"Asset misappropriation"},{"text":"Financial statement fraud"},{"text":"Procurement fraud"},{"text":"Revenue manipulation"},{"text":"Expense fraud"},{"text":"Vendor fraud"},{"text":"Payroll fraud"},{"text":"Conflict-of-interest analysis"},{"text":"Investigation documentation"},{"text":"Evidence preservation"},{"text":"Interview techniques"}]},{"type":"h","text":"Analytics"},{"type":"list","items":[{"text":"Advanced Excel"},{"text":"SQL"},{"text":"Power BI"},{"text":"Python/pandas"},{"text":"Statistical analysis"},{"text":"Benford's Law concepts"},{"text":"Duplicate transaction detection"},{"text":"Outlier analysis"},{"text":"Network/relationship analysis"},{"text":"Transaction pattern analysis"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"ERP systems"},{"text":"SAP/Oracle concepts"},{"text":"Audit analytics"},{"text":"Data extraction"},{"text":"Digital evidence fundamentals"},{"text":"E-discovery concepts"},{"text":"Case-management systems"}]},{"type":"h","text":"Portfolio target"},{"type":"p","text":"Build 6–8 forensic accounting projects:"},{"type":"list","items":[{"text":"Financial statement fraud investigation"},{"text":"Duplicate-payment detection"},{"text":"Procurement/vendor fraud investigation"},{"text":"Payroll fraud analysis"},{"text":"Revenue manipulation investigation"},{"text":"Benford's Law transaction analysis"},{"text":"Related-party transaction investigation"},{"text":"Complete forensic audit case"}]},{"type":"p","text":"A strong capstone should f