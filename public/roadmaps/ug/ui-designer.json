":"Accessible forms"},{"text":"Inclusive design"}]},{"type":"h","text":"Project"},{"type":"h","text":"End-to-End Product Design Case Study"},{"type":"h","text":"Example:"},{"type":"p","text":"Design a healthcare, education, fintech, or productivity application."},{"type":"h","text":"Include:"},{"type":"flow","items":["Research","Personas","User Flow","Wireframes","UI","Prototype","Testing","Iteration"]},{"type":"h","text":"Year 4 — Professional UI Design"},{"type":"p","text":"The final year should simulate a professional product-design environment."},{"type":"h","text":"Advanced UI"},{"type":"list","items":[{"text":"Design systems"},{"text":"Complex dashboards"},{"text":"SaaS interfaces"},{"text":"Data-heavy interfaces"},{"text":"Enterprise UX"},{"text":"Responsive systems"},{"text":"Mobile design"},{"text":"Web applications"},{"text":"Cross-platform design"}]},{"type":"h","text":"Product collaboration"},{"type":"h","text":"Learn how designers work with:"},{"type":"list","items":[{"text":"Product managers"},{"text":"Developers"},{"text":"Researchers"},{"text":"Marketing"},{"text":"Data analysts"},{"text":"Engineers"},{"text":"Business teams"}]},{"type":"h","text":"Design handoff"},{"type":"h","text":"Understand:"},{"type":"list","items":[{"text":"Design specifications"},{"text":"Component documentation"},{"text":"Design tokens"},{"text":"Developer handoff"},{"text":"Responsive behaviour"},{"text":"States"},{"text":"Edge cases"},{"text":"Asset preparation"}]},{"type":"h","text":"Front-end awareness"},{"type":"h","text":"Learn basic:"},{"type":"list","items":[{"text":"HTML"},{"text":"CSS"},{"text":"JavaScript"},{"text":"Responsive design"},{"text":"CSS Flexbox/Grid"},{"text":"React concepts"}]},{"type":"p","text":"A UI Designer does not need to become a full-stack developer, but understanding how interfaces are implemented greatly improves collaboration with engineers."},{"type":"h","text":"Emerging technologies"},{"type":"h","text":"Explore:"},{"type":"list","items":