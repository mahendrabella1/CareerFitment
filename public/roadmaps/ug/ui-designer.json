ents"},{"text":"Design systems"},{"text":"Forms"},{"text":"Dashboards"},{"text":"Mobile interfaces"},{"text":"Web interfaces"}]},{"type":"h","text":"UX"},{"type":"list","items":[{"text":"User research"},{"text":"Personas"},{"text":"User journeys"},{"text":"Information architecture"},{"text":"User flows"},{"text":"Usability testing"}]},{"type":"h","text":"Interaction"},{"type":"list","items":[{"text":"Prototyping"},{"text":"Micro-interactions"},{"text":"Motion"},{"text":"Transitions"},{"text":"States"},{"text":"Feedback"}]},{"type":"h","text":"Tools"},{"type":"list","items":[{"text":"Figma"},{"text":"FigJam"},{"text":"Photoshop"},{"text":"Illustrator"},{"text":"Prototyping tools"},{"text":"Design-system tools"}]},{"type":"h","text":"Technical"},{"type":"list","items":[{"text":"HTML"},{"text":"CSS"},{"text":"JavaScript basics"},{"text":"Responsive design"},{"text":"React awareness"},{"text":"Developer handoff"}]},{"type":"h","text":"Product"},{"type":"list","items":[{"text":"Product thinking"},{"text":"Business goals"},{"text":"User metrics"},{"text":"A/B testing awareness"},{"text":"Product analytics"}]},{"type":"h","text":"Future"},{"type":"list","items":[{"text":"AI UX"},{"text":"Human-AI interaction"},{"text":"Generative UI"},{"text":"Multimodal design"},{"text":"Spatial interfaces"}]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Practical product-design experience is essential."},{"type":"h","text":"Good internship targets"},{"type":"list","items":[{"text":"Product companies"},{"text":"SaaS companies"},{"text":"Startups"},{"text":"FinTech companies"},{"text":"EdTech companies"},{"text":"HealthTech companies"},{"text":"E-commerce companies"},{"text":"Design agencies"},{"text":"UX consultancies"},{"text":"Digital agencies"},{"text":"Consumer-tech companies"},{"text":"AI companies"},{"text":"Design-system teams"}]},{"type":"h","text":"Internship progression"},{"type":"note","label":"Year 1","text":"Visual design internship"},{"type":