,"text":"For a serious policy career, research methodology and quantitative skills are more valuable than collecting many generic certificates."}]},{"heading":"Careers you can be hired as","kind":"careers","blocks":[{"type":"h","text":"Direct roles"},{"type":"list","items":[{"text":"Policy Analyst"},{"text":"Policy Researcher"},{"text":"Policy Associate"},{"text":"Research Associate"},{"text":"Governance Analyst"},{"text":"Public Policy Associate"},{"text":"Public Affairs Analyst"},{"text":"Programme Analyst"},{"text":"Government Relations Analyst"},{"text":"Policy Research Assistant"}]},{"type":"h","text":"Adjacent roles"},{"type":"list","items":[{"text":"Economic Analyst"},{"text":"Political Analyst"},{"text":"Social Researcher"},{"text":"Development Consultant"},{"text":"Monitoring & Evaluation Analyst"},{"text":"Public Sector Consultant"},{"text":"Regulatory Analyst"},{"text":"Research Consultant"},{"text":"Think Tank Researcher"},{"text":"Data/Policy Analyst"}]},{"type":"h","text":"Long-term roles"},{"type":"list","items":[{"text":"Senior Policy Analyst"},{"text":"Policy Advisor"},{"text":"Senior Research Fellow"},{"text":"Public Policy Consultant"},{"text":"Policy Director"},{"text":"Programme Director"},{"text":"Research Director"},{"text":"Governance Specialist"},{"text":"Chief Policy Advisor"}]}]},{"heading":"Postgraduate study in India","kind":"pg_india","blocks":[{"type":"p","text":"For policy careers, postgraduate study is often highly valuable."},{"type":"table","header":["PG option","Best for"],"rows":[[{"text":"MA Public Policy"},{"text":"Core policy career"}],[{"text":"MPP"},{"text":"Professional policy analysis"}],[{"text":"MA Economics"},{"text":"Economic policy"}],[{"text":"MA Political Economy"},{"text":"Political-economic research"}],[{"text":"MA Political Science"},{"text":"Governance/politics"}],[{"text":"MA Public Administration"},{"text":"Government administration"}],[{"text":"MA Development Studies"},{"text":"Development policy"}],[{"text":