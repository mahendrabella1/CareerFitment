:"list","items":[{"text":"Age group"},{"text":"Region"},{"text":"Product"},{"text":"Policy tenure"}]},{"type":"h","text":"Build"},{"type":"h","text":"Excel/SQL database"},{"type":"h","text":"Data cleaning"},{"type":"h","text":"Power BI dashboard"},{"type":"h","text":"Analyse"},{"type":"list","items":[{"text":"Claims by product"},{"text":"Claims by region"},{"text":"Average claim value"},{"text":"Average TAT"},{"text":"Pending claims"},{"text":"Approval/rejection trends"},{"text":"High-frequency claim patterns"},{"text":"Monthly claims"}]},{"type":"flow","items":["This gives the student practical evidence of claims","analytics","business understanding."],"sep":"+"}]},{"heading":"Certifications and Learning","kind":"certifications","blocks":[{"type":"h","text":"Insurance"},{"type":"p","text":"Explore professional learning from organisations such as:"},{"type":"list","items":[{"text":"Insurance Institute of India"},{"text":"National Insurance Academy"}]},{"type":"p","text":"Relevant subjects include:"},{"type":"list","items":[{"text":"Insurance principles"},{"text":"Claims management"},{"text":"Risk management"},{"text":"General insurance"},{"text":"Life insurance"}]},{"type":"p","text":"Specific examination structures, eligibility and current certification requirements should be verified from the relevant official organisation before enrolment."},{"type":"h","text":"Analytics"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Advanced Excel"},{"text":"Power BI"},{"text":"SQL"},{"text":"Statistics"},{"text":"Python basics"}]}]},{"heading":"Careers You Can Be Hired As","kind":"careers","blocks":[{"type":"h","text":"Entry-level"},{"type":"list","items":[{"text":"Claims Executive"},{"text":"Claims Processing Executive"},{"text":"Insurance Operations Executive"},{"text":"Insurance Executive"},{"text":"Claims Associate"},{"text":"Health Claims Executive"},{"text":"Motor Claims Executive"},{"text":"TPA Executive"},{"text":"Insurance Operations Associate"},{"text":"Customer Claims Executive"}]},{"type":"h","text":"Mid-level"},{"type":"list","items":[{"text":"Senior Claims Executive"},{"text":"Claims Analyst"},{"text":"Claims Specialist"},{"text":"Claims Team Leader"},{"text":"Claims Quality Analyst"},{"text":"Insurance Operations Manager"}]},{"type":"h","text":"Senior"},{"type":"list","items":[{"text":"Claims Manager"},{"text":"Senior Claims Manager"},{"text":"Regional Claims Manager"},{"text":"Head of Claims"},{"text":"Claims Operations Director"}]},{"type":"h","text":"Interview Questions"},{"type":"h","text":"Insurance"},{"type":"list","items":[{"text":"What is an insurance claim?"},{"text":"What is the difference between a policyholder and an insured?"},{"text":"What is a deductible?"},{"text":"What is an exclusion?"},{"text":"What is an endorsement?"},{"text":"What is a sum insured?"},{"text":"What is claim intimation?"},{"text":"What is a TPA?"},{"text":"What is claim settlement?"},{"text":"What is the difference between approval and repudiation?"}]},{"type":"h","text":"Claims"},{"type":"list","items":[{"text":"Explain the claims lifecycle."},{"text":"What documents would you verify before processing a claim?"},{"text":"How would you handle missing documents?"},{"text":"How would you handle a delayed claim?"},{"text":"How would you respond to a customer challenging a claim decision?"},{"text":"How would you prioritise multiple pending claims?"}]},{"type":"h","text":"Analytics"},{"type":"list","items":[{"text":"Which KPIs would you track for a claims department?"},{"text":"How would you reduce claims TAT?"},{"text":"How would you analyse an increase in claim rejection?"},{"text":"How can AI help identify suspicious claims?"}]}]},{"heading":"Postgraduate Study in India","kind":"pg_india","blocks":[{"type":"p","text":"Relevant options include:"},{"type":"h","text":"MBA"},{"type":"list","items":[{"text":"MBA Insurance"},{"text":"MBA Finance"},{"text":"MBA Risk Management"},{"text":"MBA Business Analytics"},{"text":"MBA Operations"},{"text":"MBA Banking & Financial Services"}]},{"type":"h","text":"Other options"},{"type":"list","items":[{"text":"PG Diploma in Insurance"},{"text":"Insurance and Risk Management programmes"},{"text":"MSc Finance/Risk"},{"text":"Business Analytics programmes"}]},{"type":"p","text":"For senior insurance management, an MBA can complement practical claims experience."},{"type":"h","text":"Government / Public-Sector Route"},{"type":"p","text":"Possible directions include:"},{"type":"list","items":[{"text":"Public-sector insurance organisations"},{"text":"Government-backed insurance programmes"},{"text":"Public-sector banks with insurance operations"},{"text":"Government healthcare schemes"},{"text":"Insurance regulatory/administrative support roles"},{"text":"Public-sector claims operations"}]},{"type":"p","text":"Recruitment may occur through organisation-specific examinations, professional recruitment processes or government notifications."},{"type":"p","text":"Eligibility and current recruitment rules should always be checked against the relevant official notification."}]},{"heading":"Study Abroad","kind":"abroad","blocks":[{"type":"p","text":"Relevant master's programmes include:"},{"type":"list","items":[{"text":"MSc Insurance & Risk Management"},{"text":"MSc Risk Management"},{"text":"MSc Finance"},{"text":"MSc Actuarial Science"},{"text":"MSc Business Analytics"},{"text":"MSc Financial Risk Management"},{"text":"MBA Finance/Risk"}]},{"type":"p","text":"Useful destinations include:"},{"type":"list","items":[{"text":"UK"},{"text":"USA"},{"text":"Canada"},{"text":"Australia"},{"text":"Singapore"},{"text":"Ireland"},{"text":"Germany"},{"text":"Netherlands"}]},{"type":"p","text":"For a claims-focused career, combine:"},{"type":"flow","items":["Insurance","Risk","Analytics"],"sep":"+"},{"type":"p","text":"rather than pursuing finance alone."}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"Claims Executive"},{"type":"h","text"