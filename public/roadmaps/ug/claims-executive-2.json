":"list","items":[{"text":"Insurance principles"},{"text":"Policy interpretation"},{"text":"Claims lifecycle"},{"text":"Health/general insurance"},{"text":"Risk fundamentals"}]},{"type":"h","text":"Claims"},{"type":"list","items":[{"text":"Claim registration"},{"text":"Documentation"},{"text":"Verification"},{"text":"Settlement"},{"text":"Query management"},{"text":"Escalation"}]},{"type":"h","text":"Analytics"},{"type":"list","items":[{"text":"Advanced Excel"},{"text":"SQL"},{"text":"Power BI"},{"text":"Statistics"},{"text":"Python basics"}]},{"type":"h","text":"Risk"},{"type":"list","items":[{"text":"Fraud indicators"},{"text":"Risk assessment"},{"text":"Claims quality"},{"text":"Audit awareness"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Claims-management systems"},{"text":"CRM"},{"text":"Workflow automation"},{"text":"OCR/document AI"},{"text":"AI-assisted claims"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Communication"},{"text":"Attention to detail"},{"text":"Customer handling"},{"text":"Problem solving"},{"text":"Confidentiality"},{"text":"Compliance awareness"}]}]},{"heading":"Target Progression","kind":"growth","blocks":[{"type":"h","text":"BBA Banking & Insurance"},{"type":"flow","items":["Insurance/Claims Internship","Claims Executive","Senior Claims Executive","Claims Analyst / Specialist","Claims Team Leader","Claims Manager","Senior Claims Manager","Head of Claims","Insurance Operations Director"]},{"type":"h","text":"Best Profile by Graduation"},{"type":"p","text":"A strong graduate should have:"},{"type":"list","items":[{"text":"BBA/BMS/BBM in Banking & Insurance"},{"text":"Insurance/claims internship"},{"text":"Strong understanding of insurance principles"},{"text":"Claims lifecycle knowledge"},{"text":"Policy and document verification skills"},{"text":"Health/motor/general insurance awareness"},{"text":"Advanced Excel"},{"text":"Power BI"},{"text":"Basic SQL"},{"text":"Claims analytics project"}