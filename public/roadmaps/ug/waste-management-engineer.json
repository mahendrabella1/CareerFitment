ering"}],[{"text":"Reporting"},{"text":"Excel + Power BI"}],[{"text":"Environmental assessment"},{"text":"EIA"}],[{"text":"Sustainability"},{"text":"Circular economy"}],[{"text":"Data analysis"},{"text":"Python / SQL"}],[{"text":"Design"},{"text":"AutoCAD"}],[{"text":"Field work"},{"text":"Sampling + inspections"}],[{"text":"Communication"},{"text":"Technical reporting"}]]}]},{"heading":"Certifications & Learning","kind":"certifications","blocks":[{"type":"p","text":"Useful supplementary areas include:"},{"type":"h","text":"Environmental"},{"type":"list","items":[{"text":"Environmental management systems"},{"text":"Environmental auditing"},{"text":"Waste management"},{"text":"Environmental impact assessment"},{"text":"Pollution control"}]},{"type":"h","text":"Quality & Safety"},{"type":"list","items":[{"text":"ISO 14001 fundamentals"},{"text":"ISO 45001 fundamentals"},{"text":"Industrial safety"},{"text":"Environmental auditing"}]},{"type":"h","text":"Technical"},{"type":"list","items":[{"text":"GIS/QGIS"},{"text":"AutoCAD"},{"text":"Advanced Excel"},{"text":"Power BI"},{"text":"Python"},{"text":"Environmental monitoring"}]},{"type":"h","text":"Sustainability"},{"type":"list","items":[{"text":"Circular economy"},{"text":"Life-cycle assessment"},{"text":"Carbon accounting"},{"text":"ESG fundamentals"}]},{"type":"p","text":"Certifications should supplement fieldwork, laboratory skills and environmental project experience."}]},{"heading":"PG Options","kind":"pg_india","blocks":[{"type":"p","text":"A PG is not mandatory for entry-level Waste Management Engineer roles."},{"type":"h","text":"Relevant options"},{"type":"list","items":[{"text":"M.Tech Environmental Engineering"},{"text":"M.Tech Environmental Management"},{"text":"M.Tech Waste Management"},{"text":"M.Tech Water Resources"},{"text":"M.Tech Sustainable Engineering"},{"text":"M.Sc Environmental Science"},{"text":"Master's in Sustainability"}]},{"type":"h","text":"Management route"},{"type":"p","text":"After gai