nternship report"},{"text":"Industry exposure"}],[{"text":"Year 4 Sem 1"},{"text":"Advanced safety + specialisation"},{"text":"Standards + mentor"},{"text":"Full audit project"},{"text":"Professional capability"}],[{"text":"Year 4 Sem 2"},{"text":"Dissertation + placement preparation"},{"text":"Faculty/industry mentor"},{"text":"Safety audit portfolio"},{"text":"Employability"}]]}]},{"heading":"Industrial safety foundation","kind":"build","blocks":[{"type":"p","text":"Master:"},{"type":"list","items":[{"text":"Workplace safety"},{"text":"Occupational hazards"},{"text":"Accident prevention"},{"text":"Safety management"},{"text":"Hazard identification"},{"text":"Risk assessment"},{"text":"Hierarchy of controls"},{"text":"PPE"},{"text":"Safe work procedures"},{"text":"Permit-to-work systems"},{"text":"Lockout/Tagout"},{"text":"Safety signage"},{"text":"Incident reporting"},{"text":"Emergency preparedness"}]},{"type":"p","text":"Understand the basic hierarchy:"},{"type":"flow","items":["Elimination","Substitution","Engineering Controls","Administrative Controls","PPE"]},{"type":"p","text":"PPE should not be treated as the only safety solution."}]},{"heading":"Hazard identification","kind":"other","blocks":[{"type":"p","text":"Learn to identify:"},{"type":"h","text":"Physical hazards"},{"type":"list","items":[{"text":"Noise"},{"text":"Vibration"},{"text":"Heat"},{"text":"Radiation"},{"text":"Lighting"},{"text":"Pressure"},{"text":"Moving machinery"}]},{"type":"h","text":"Chemical hazards"},{"type":"list","items":[{"text":"Flammable materials"},{"text":"Toxic substances"},{"text":"Corrosives"},{"text":"Reactive chemicals"},{"text":"Compressed gases"},{"text":"Dusts"},{"text":"Solvents"}]},{"type":"h","text":"Biological hazards"},{"type":"list","items":[{"text":"Bacteria"},{"text":"Viruses"},{"text":"Biological waste"},{"text":"Occupational exposure"}]},{"type":"h","text":"Ergonomic hazards"},{"type":"list","items":[{"text":"Manual handling"},{"text":"Repetitive work"},{"t