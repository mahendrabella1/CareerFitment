:"HSE/environment"}],[{"text":"M.Sc Disaster Management"},{"text":"Emergency/disaster management"}],[{"text":"M.Tech Industrial Safety"},{"text":"Advanced safety engineering"}],[{"text":"M.Tech Fire Engineering"},{"text":"Fire engineering"}],[{"text":"M.Tech Environmental Engineering"},{"text":"Environmental/HSE"}],[{"text":"PG Diploma Industrial Safety"},{"text":"Professional safety"}],[{"text":"PG Diploma Fire & Safety"},{"text":"Fire safety"}],[{"text":"MBA Operations/Project Management"},{"text":"Management pathway"}],[{"text":"MBA Sustainability/HSE-related management"},{"text":"Corporate leadership"}],[{"text":"PhD Safety/Industrial Engineering"},{"text":"Advanced research"}]]},{"type":"p","text":"Exact programme titles, eligibility and statutory recognition should be verified for the intended job."}]},{"heading":"Study abroad","kind":"abroad","blocks":[{"type":"table","header":["Country","Example universities","Funding route","Gate to check"],"rows":[[{"text":"UK"},{"text":"University of Birmingham, Loughborough, Imperial"},{"text":"University/external scholarships"},{"text":"Programme requirements"}],[{"text":"USA"},{"text":"Texas A&M, University of Michigan, Columbia"},{"text":"Assistantships + scholarships"},{"text":"Programme prerequisites"}],[{"text":"Germany"},{"text":"TUM, RWTH Aachen"},{"text":"DAAD + university funding"},{"text":"Programme/credit requirements"}],[{"text":"Australia"},{"text":"UNSW, Monash, Queensland"},{"text":"RTP + university funding"},{"text":"Academic requirements"}],[{"text":"Canada"},{"text":"UBC, Toronto, McGill"},{"text":"Research funding"},{"text":"Programme fit"}],[{"text":"Netherlands"},{"text":"Delft, Eindhoven"},{"text":"University scholarships"},{"text":"Programme requirements"}],[{"text":"Singapore"},{"text":"NUS, NTU"},{"text":"University scholarships"},{"text":"Programme prerequisites"}]]},{"type":"p","text":"DAAD India","url":"https://www.daad.in/en/"},{"type":"h","text":"Strong application profile"},{"type":"p","te