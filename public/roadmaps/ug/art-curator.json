{"title":"Career Roadmap: Art Curator","role":"Art Curator","summary":"Career Domain: Media, Communication, Arts & Design · Qualification Pathway: BFA – Painting · Target Career: Art Curator","facts":{"Current degree":"BFA (Bachelor of Fine Arts)","Course":"Painting"},"about":[{"label":"About this roadmap","text":"This roadmap was drafted with AI assistance from OneGrasp's related roadmaps and is awaiting expert review. Check fees, dates, eligibility and exam patterns on the official websites before you rely on them."}],"intro":[],"horizons":[],"sections":[{"heading":"Career Overview","kind":"other","blocks":[{"type":"p","text":"An Art Curator selects and organises artworks into exhibitions and collections, researches them and writes the story that connects them for visitors."},{"type":"h","text":"What a Art Curator does"},{"type":"list","items":[{"text":"Research artists and artworks"},{"text":"Plan exhibitions and choose works"},{"text":"Write catalogues, wall texts and essays"},{"text":"Coordinate loans, installation and events"}]},{"type":"p","text":"Where they work:"},{"type":"list","items":[{"text":"Galleries and museums"},{"text":"Art foundations and biennales"},{"text":"Corporate and private collections"},{"text":"Auction houses"}]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Career stage","Typical role"],"rows":[[{"text":"Entry-level"},{"text":"Curatorial Assistant"}],[{"text":"Early career"},{"text":"Assistant Curator"}],[{"text":"Mid-level"},{"text":"Curator"}],[{"text":"Senior"},{"text":"Senior Curator"}],[{"text":"Leadership"},{"text":"Museum / Foundation Director"}]]}]},{"heading":"Year-by-Year Learning Roadmap","kind":"build","blocks":[{"type":"h","text":"Year 1: Art and history"},{"type":"list","items":[{"text":"Make and study art"},{"text":"Read art history"},{"text":"Visit every exhibition you can and write notes"}]},{"type":"h","text":"Year 2: Writing and research"},{"type":"list","items":[{"text":"Write reviews and short essays"},{"text":"Learn how galleries and museums work"},{"text":"Volunteer at a gallery"}]},{"type":"h","text":"Year 3: Curate"},{"type":"list","items":[{"text":"Curate a small student show"},{"text":"Intern at a gallery, museum or biennale"},{"text":"Build contacts with artists"}]},{"type":"h","text":"Year 4: Prepare for a curatorial career"},{"type":"list","items":[{"text":"Curate a larger exhibition with a catalogue"},{"text":"Build a writing portfolio"},{"text":"Apply for MA Curatorial Studies / Art History"}]}]},{"heading":"Essential Skills","kind":"build","blocks":[{"type":"table","header":["Skill","Type"],"rows":[[{"text":"Art-historical research"},{"text":"Technical"}],[{"text":"Exhibition planning"},{"text":"Technical"}],[{"text":"Curatorial writing"},{"text":"Technical"}],[{"text":"Collection management"},{"text":"Technical"}],[{"text":"Networking"},{"text":"Professional"}],[{"text":"Organisation"},{"text":"Professional"}],[{"text":"Clear writing"},{"text":"Professional"}]]}]},{"heading":"Tools and Technologies to Learn","kind":"build","blocks":[{"type":"list","items":[{"text":"Exhibition planning tools"},{"text":"Collection databases"},{"text":"InDesign for catalogues"}]}]},{"heading":"Internships and Practical Experience","kind":"internships","blocks":[{"type":"list","items":[{"text":"Galleries"},{"text":"Museums"},{"text":"Art foundations and biennales"}]}]},{"heading":"Certifications and Additional Training","kind":"certifications","blocks":[{"type":"list","items":[{"text":"Short museum and curatorial courses"}]},{"type":"note","label":"Before you enrol","text":"Check the current syllabus, fees and eligibility on the certifying body's official website."}]},{"heading":"Higher Education Options in India","kind":"pg_india","blocks":[{"type":"p","text":"Options after your degree:"},{"type":"list","items":[{"text":"MA Art History / Curatorial Studies"},{"text":"MA Museology"}]},{"type":"p","text":"Entrance exams and tests to know:"},{"type":"list","items":[{"text":"University entrance tests"},{"text":"UGC NET (Visual Arts)"}]}]},{"heading":"Study Abroad Options","kind":"abroad","blocks":[{"type":"list","items":[{"text":"MA Curating (UK, Europe)"}]}]},{"heading":"Career Opportunities","kind":"careers","blocks":[{"type":"p","text":"Roles a Art Curator can grow into or move across to:"},{"type":"list","items":[{"text":"Gallery Manager"},{"text":"Art Historian"},{"text":"Museum Educator"},{"text":"Art Critic"}]}]},{"heading":"Recommended Career Progression","kind":"growth","blocks":[{"type":"flow","items":["Curatorial Assistant","Assistant Curator","Curator","Senior Curator","Museum / Foundation Director"]}]}],"drafted":true}