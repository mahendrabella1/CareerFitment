ciations"}]},{"type":"h","text":"Project 3 — Wildlife Habitat Mapping"},{"type":"p","text":"Use QGIS to map habitat suitability for a selected species."},{"type":"p","text":"Workflow:"},{"type":"flow","items":["Satellite Data","Land Cover","Habitat Variables","GIS Analysis","Suitability Map"]},{"type":"h","text":"Project 4 — Human-Wildlife Conflict Analysis"},{"type":"p","text":"Analyze publicly available or supervised field data related to:"},{"type":"list","items":[{"text":"Crop damage"},{"text":"Livestock predation"},{"text":"Wildlife movement"},{"text":"Conflict locations"}]},{"type":"p","text":"Create a GIS-based conflict-risk map."},{"type":"h","text":"Project 5 — Bird Population Monitoring"},{"type":"p","text":"Conduct repeated bird surveys using standardized methods."},{"type":"p","text":"Analyze:"},{"type":"list","items":[{"text":"Species abundance"},{"text":"Seasonal variation"},{"text":"Habitat preference"},{"text":"Diversity"},{"text":"Population trends"}]},{"type":"p","text":"Build an R-based visualization/report."}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Target organizations and projects involving:"},{"type":"h","text":"Wildlife Research"},{"type":"list","items":[{"text":"Wildlife research institutes"},{"text":"Universities"},{"text":"Zoology departments"},{"text":"Ecology research groups"},{"text":"Biodiversity organizations"}]},{"type":"h","text":"Conservation"},{"type":"list","items":[{"text":"Wildlife conservation NGOs"},{"text":"Protected-area research projects"},{"text":"Species recovery programs"},{"text":"Biodiversity projects"}]},{"type":"h","text":"Government / Public Research"},{"type":"p","text":"Potential areas include:"},{"type":"list","items":[{"text":"Forest and wildlife departments"},{"text":"National parks"},{"text":"Wildlife sanctuaries"},{"text":"Tiger reserves"},{"text":"Biodiversity authorities"},{"text":"Government research institutions"}]},{"type":"p","text":"Specific recruitment eli