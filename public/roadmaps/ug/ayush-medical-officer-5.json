,{"type":"h","text":"Naturopathic procedures under supervision"},{"type":"h","text":"Follow-up documentation"},{"type":"h","text":"Referral coordination"},{"type":"h","text":"Health education"}]},{"heading":"Core Skill Stack","kind":"other","blocks":[{"type":"table","header":["Skill Area","Skills"],"rows":[[{"text":"Naturopathy"},{"text":"Naturopathic principles, therapeutic approaches, lifestyle interventions"}],[{"text":"Yoga"},{"text":"Yoga therapy, breathing practices, relaxation, meditation"}],[{"text":"Clinical"},{"text":"History taking, basic assessment, monitoring"}],[{"text":"Nutrition"},{"text":"Dietary assessment, nutrition counselling, therapeutic diet fundamentals"}],[{"text":"Preventive Health"},{"text":"Health promotion, lifestyle modification, screening awareness"}],[{"text":"Communication"},{"text":"Patient counselling, active listening, health education"}],[{"text":"Documentation"},{"text":"Clinical notes, patient records, reports"}],[{"text":"Public Health"},{"text":"Community health, health campaigns, awareness programmes"}],[{"text":"Digital Health"},{"text":"Electronic health records, telehealth, digital documentation"}],[{"text":"Research"},{"text":"Literature review, evidence appraisal, basic statistics"}]]}]},{"heading":"Clinical & Professional Workflow","kind":"other","blocks":[{"type":"h","text":"Patient Registration"},{"type":"h","text":"Chief Complaint"},{"type":"h","text":"Medical & Lifestyle History"},{"type":"h","text":"Clinical Assessment"},{"type":"h","text":"Risk / Red-Flag Identification"},{"type":"h","text":"Naturopathy & Yoga Assessment"},{"type":"h","text":"Individualised Wellness / Therapeutic Plan"},{"type":"h","text":"Patient Education"},{"type":"h","text":"Intervention"},{"type":"h","text":"Progress Monitoring"},{"type":"h","text":"Follow-up"},{"type":"h","text":"Continue / Modify / Refer"},{"type":"p","text":"A critical professional competency is knowing when a patient requires investigation, specialist assessment, emergency treatment, or referral outside the practitioner's scope."}]},{"heading":"Technical & Digital Skills","kind":"other","blocks":[{"type":"p","text":"An AYUSH Medical Officer increasingly benefits from digital-health capabilities."},{"type":"h","text":"Essential"},{"type":"h","text":"MS Excel"},{"type":"h","text":"Electronic health records"},{"type":"h","text":"Digital patient documentation"},{"type":"h","text":"Hospital information systems"},{"type":"h","text":"Teleconsultation platforms"},{"type":"h","text":"Medical presentation tools"},{"type":"h","text":"Basic healthcare data analysis"},{"type":"h","text":"Advanced"},{"type":"h","text":"Power BI"},{"type":"h","text":"Healthcare dashboards"},{"type":"h","text":"Digital patient monitoring"},{"type":"h","text":"Telehealth workflows"},{"type":"h","text":"AI-assisted literature search"},{"type":"h","text":"Clinical documentation tools"},{"type":"h","text":"Basic health-data analytics"}]},{"heading":"Recommended Software & Resources","kind":"other","blocks":[{"type":"table","header":["Category","Tools"],"rows":[[{"text":"Documentation"},{"text":"MS Word, Google Docs"}],[{"text":"Data"},{"text":"Excel, Google Sheets"}],[{"text":"Analytics"},{"text":"Power BI"}],[{"text":"Research"},{"text":"PubMed, Google Scholar, Scopus"}],[{"text":"References"},{"text":"Zotero, Mendeley"}],[{"text":"Presentations"},{"text":"PowerPoint, Canva"}],[{"text":"Digital Health"},{"text":"EHR/HMIS platforms"}],[{"text":"Communication"},{"text":"Telemedicine platforms"}],[{"text":"AI Assistance"},{"text":"AI research and summarisation tools"}]]},{"type":"p","text":"AI should be used as an assistive research and documentation tool, not as a substitute for professional clinical judgment."}]},{"heading":"UG Projects","kind":"other","blocks":[{"type":"p","text":"Students should build projects demonstrating practical healthcare understanding."},{"type":"h","text":"Project 1 — Lifestyle Disease Risk Assessment"},{"type":"p","text":"Develop a structured assessment covering:"},{"type":"h","text":"Physical activity"},{"type":"h","text":"Sleep"},{"type":"h","text":"Nutrition"},{"type":"h","text":"Stress"},{"type":"h","text":"BMI"},{"type":"h","text":"Lifestyle patterns"},{"type":"h","text":"Project 2 — Yoga-Based Wellness Programme"},{"type":"p","text":"Design a supervised programme for a defined population such as:"},{"type":"h","text":"College students"},{"type":"h","text":"Office workers"},{"type":"h","text":"Older adults"},{"type":"h","text":"School teachers"},{"type":"p","text":"Measure appropriate wellness outcomes before and after the programme."},{"type":"h","text":"Project 3 — Community Health Survey"},{"type":"h","text":"Conduct a supervised survey on:"},{"type":"h","text":"Physical activity"},{"type":"h","text":"Nutrition"},{"type":"h","text":"Sleep"},{"type":"h","text":"Stress"},{"type":"h","text":"Lifestyle habits"},{"type":"h","text":"Preventive-health awareness"},{"type":"h","text":"Project 4 — Digital Wellness Dashboard"},{"type":"h","text":"Create a dashboard containing:"},{"type":"h","text":"Patient/participant demographics"},{"type":"h","text":"Lifestyle indicators"},{"type":"h","text":"Follow-up status"},{"type":"h","text":"Programme participation"},{"type":"h","text":"Outcome indicators"},{"type":"h","text":"Project 5 — Evidence Review"},{"type":"p","text":"Conduct a structured literature review on a topic such as:"},{"type":"h","text":"Yoga and stress management"},{"type":"h","text":"Lifestyle interventions"},{"type":"h","text":"Sleep and wellness"},{"type":"h","text":"Preventive health"},{"type":"h","text":"Mind-body interventions"},{"type":"p","text":"The project should distinguish traditional practice claims from evidence supported by contemporary research."}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"h","text":"Year 1"},{"type":"p","text":"Focus on observation and foundational exposure."},{"type":"h","text":"Target:"},{"type":"h","text":"Yoga centres"},{"typ