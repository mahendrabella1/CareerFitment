[{"text":"Enterprise Architecture Proposal"},{"text":"Architecture + consulting"}]]},{"type":"h","text":"Best Final-Year Project"},{"type":"p","text":"Instead of creating only another CRUD application, build an end-to-end digital transformation case study."},{"type":"flow","items":["Real Business Problem","Stakeholder Analysis","Current-State Process","Pain-Point Identification","Data Analysis","Technology Options","Cost-Benefit Analysis","Proposed Architecture","Prototype / MVP","Implementation Roadmap","Expected Business Impact"]},{"type":"p","text":"This demonstrates consulting ability much more effectively."}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"h","text":"Year 1"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"IT Support Intern"},{"text":"Technology Intern"},{"text":"Software Intern"},{"text":"Business Operations Intern"}]},{"type":"p","text":"Focus on:"},{"type":"h","text":"Technology + communication"},{"type":"h","text":"Year 2"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Business Analyst Intern"},{"text":"IT Analyst Intern"},{"text":"Technology Consulting Intern"},{"text":"Software Consulting Intern"}]},{"type":"p","text":"Focus on:"},{"type":"flow","items":["Requirements","SQL","software","process analysis"],"sep":"+"},{"type":"h","text":"Year 3"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"IT Consulting Intern"},{"text":"Technology Consulting Intern"},{"text":"Cloud Consulting Intern"},{"text":"Data Consulting Intern"},{"text":"Cybersecurity Consulting Intern"}]},{"type":"p","text":"Focus on:"},{"type":"h","text":"Client problem solving + specialization"},{"type":"h","text":"Year 4"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Technology Consultant"},{"text":"IT Consultant"},{"text":"Business Technology Analyst"},{"text":"Associate Consultant"},{"text":"Technology Analyst"}]}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"