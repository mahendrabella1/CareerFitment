le","Payment"]},{"type":"p","text":"Also understand:"},{"type":"list","items":[{"text":"Purchase orders"},{"text":"Sales orders"},{"text":"Credit notes"},{"text":"Debit notes"},{"text":"Expense claims"},{"text":"Vendor payments"},{"text":"Customer receipts"},{"text":"Bank transactions"}]},{"type":"h","text":"Bank reconciliation"},{"type":"p","text":"Learn how to identify:"},{"type":"list","items":[{"text":"Unpresented cheques"},{"text":"Bank charges"},{"text":"Direct credits"},{"text":"Direct debits"},{"text":"Timing differences"},{"text":"Duplicate transactions"},{"text":"Recording errors"}]},{"type":"h","text":"Year 3 — Tax, Audit and Reporting"},{"type":"h","text":"Indian taxation fundamentals"},{"type":"p","text":"Develop working knowledge of:"},{"type":"list","items":[{"text":"GST"},{"text":"TDS"},{"text":"Income-tax basics"},{"text":"Tax invoices"},{"text":"Input tax credit"},{"text":"GST reconciliation"},{"text":"TDS deductions"},{"text":"Tax documentation"}]},{"type":"p","text":"For actual tax filing, representation or regulated professional practice, always verify the current statutory requirements and professional eligibility."},{"type":"h","text":"Audit"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Audit evidence"},{"text":"Vouching"},{"text":"Verification"},{"text":"Internal controls"},{"text":"Reconciliations"},{"text":"Sampling"},{"text":"Audit working papers"},{"text":"Financial statement assertions"},{"text":"Audit observations"}]},{"type":"h","text":"Financial reporting"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"P&L preparation"},{"text":"Balance sheet preparation"},{"text":"Cash flow"},{"text":"Notes to accounts"},{"text":"Month-end closing"},{"text":"Year-end closing"},{"text":"Management reporting"}]},{"type":"h","text":"Year 4 — Move Beyond Bookkeeping"},{"type":"p","text":"The goal should be to become an accountant who can analyse and improve financial information, not merely enter transactions."},{"t