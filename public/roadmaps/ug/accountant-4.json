ry"},{"text":"Power BI"},{"text":"SQL"},{"text":"Basic Python/RPA"},{"text":"AI-assisted accounting tools"}]},{"type":"h","text":"Finance"},{"type":"list","items":[{"text":"Financial analysis"},{"text":"Budgeting"},{"text":"Forecasting"},{"text":"Financial modelling"},{"text":"Working capital"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Communication"},{"text":"Attention to detail"},{"text":"Analytical thinking"},{"text":"Documentation"},{"text":"Business understanding"},{"text":"Ethics and confidentiality"}]},{"type":"h","text":"Target Progression"},{"type":"flow","items":["Accounting + Excel","Year 2: Tally/ERP + GST + reconciliation","Year 3: Internship + audit/tax/reporting","Year 4: Financial analysis + Power BI + automation","0–2 Years: Junior Accountant / Accounts Executive","3–6 Years: Accountant / Senior Accountant","6–10 Years: Accounts Manager / FP&A / Reporting Specialist","10–15 Years: Financial Controller / Finance Manager","15+ Years: Finance Head / CFO-track"],"label":"Year 1"},{"type":"h","text":"Best profile by graduation"},{"type":"flow","items":["B.Com BAF","accounting internship","strong financial accounting","Advanced Excel","Tally/ERP","GST/TDS fundamentals","reconciliation","financial statement analysis","Power BI/SQL","one professional qualification pathway"],"sep":"+"},{"type":"p","text":"This makes the graduate suitable not only for Accountant roles but also for longer-term progression into audit, taxation, financial reporting, FP&A, management accounting, finance analytics and controllership."},{"type":"p","text":"1168 | UG | Commerce | B.Com (Bachelor of Commerce) | Banking, Accounting & Finance (BAF) | Banking Associate"}]}]}