{"title":"Tax Analyst Roadmap","role":"Tax Analyst","summary":"Tax rules and rates change frequently, so students should always learn from the current assessment year rules when performing actual tax work.","facts":{"Current degree":"B.Com (Bachelor of Commerce)"},"about":[],"intro":[],"horizons":[],"sections":[{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"flow","items":["B.Com Taxation","Tax Intern","Tax Analyst","Senior Tax Analyst","Tax Consultant / Tax Specialist","Tax Manager","Tax Director / Head of Tax"]},{"type":"p","text":"Possible specialisations:"},{"type":"list","items":[{"text":"Direct Tax Analyst"},{"text":"Corporate Tax Analyst"},{"text":"GST Analyst"},{"text":"Indirect Tax Analyst"},{"text":"Tax Compliance Analyst"},{"text":"International Tax Analyst"},{"text":"Transfer Pricing Analyst"},{"text":"Tax Research Analyst"},{"text":"Tax Technology Analyst"},{"text":"Tax Advisory Associate"}]}]},{"heading":"What to Build Each Year","kind":"build","blocks":[{"type":"table","header":["Year","Core Focus","Expected Outcome"],"rows":[[{"text":"Year 1"},{"text":"Accounting + taxation fundamentals"},{"text":"Understand tax and financial statements"}],[{"text":"Year 2"},{"text":"Direct tax + GST"},{"text":"Perform basic tax analysis"}],[{"text":"Year 3"},{"text":"Corporate tax + compliance + analytics"},{"text":"Become internship-ready"}],[{"text":"Year 4 / Advanced Track"},{"text":"Tax advisory + international tax"},{"text":"Job-ready tax professional"}]]},{"type":"h","text":"Year 1 — Accounting & Tax Foundations"},{"type":"h","text":"Accounting"},{"type":"p","text":"Master:"},{"type":"list","items":[{"text":"Journal entries"},{"text":"Ledger"},{"text":"Trial balance"},{"text":"Profit & Loss"},{"text":"Balance Sheet"},{"text":"Cash Flow Statement"},{"text":"Depreciation"},{"text":"Inventory"},{"text":"Receivables"},{"text":"Payables"},{"text":"Accruals"},{"text":"Provisions"}]},{"type":"h","text":"Tax Fundamentals"},{"type":"p","text":"Underst