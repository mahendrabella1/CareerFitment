ters"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Basis weight / GSM"},{"text":"Moisture"},{"text":"Thickness"},{"text":"Density"},{"text":"Formation"},{"text":"Porosity"},{"text":"Smoothness"},{"text":"Opacity"},{"text":"Brightness"},{"text":"Tensile strength"},{"text":"Tear strength"},{"text":"Burst strength"},{"text":"Folding endurance"}]},{"type":"h","text":"Year 3 — Paper Chemistry & Coating Technology"},{"type":"p","text":"This is one of the most important areas for a Paper Technologist."},{"type":"h","text":"Paper Chemistry"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Retention chemistry"},{"text":"Sizing chemistry"},{"text":"Dry-strength additives"},{"text":"Wet-strength additives"},{"text":"Optical brighteners"},{"text":"Fillers"},{"text":"Pigments"},{"text":"Dyes"},{"text":"Defoamers"},{"text":"Fixing agents"},{"text":"Surface treatment chemicals"}]},{"type":"h","text":"Common Paper Additives"},{"type":"p","text":"Understand the role of:"},{"type":"list","items":[{"text":"Starch"},{"text":"Calcium carbonate"},{"text":"Kaolin/clay"},{"text":"Titanium dioxide"},{"text":"Alum"},{"text":"Polymers"},{"text":"Optical brightening agents"}]},{"type":"h","text":"Coating Technology"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Pigment coating"},{"text":"Binder systems"},{"text":"Coating formulations"},{"text":"Surface sizing"},{"text":"Barrier coatings"},{"text":"Functional coatings"},{"text":"Coating rheology"},{"text":"Coat weight"},{"text":"Surface coverage"},{"text":"Drying"},{"text":"Coating defects"}]},{"type":"h","text":"Important Coating Properties"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Viscosity"},{"text":"Rheology"},{"text":"Adhesion"},{"text":"Surface energy"},{"text":"Smoothness"},{"text":"Gloss"},{"text":"Printability"},{"text":"Water resistance"},{"text":"Oil/grease resistance"},{"text":"Abrasion resistance"}]},{"type":"h","text":"Year 3–4 — Testing & Quality Engineer