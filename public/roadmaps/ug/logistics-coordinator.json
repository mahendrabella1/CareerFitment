pply-chain project"}],[{"text":"Logistics Analyst"},{"text":"Excel + SQL + Power BI"},{"text":"Logistics dashboard"}],[{"text":"Warehouse Coordinator"},{"text":"Inventory + WMS + operations"},{"text":"Warehouse case study"}],[{"text":"Transport Coordinator"},{"text":"Fleet + routing + tracking"},{"text":"Route-planning project"}],[{"text":"Trade Operations Executive"},{"text":"Documentation + compliance"},{"text":"Import/export portfolio"}],[{"text":"Procurement Coordinator"},{"text":"Supplier + PO + inventory"},{"text":"Procurement case study"}]]},{"type":"h","text":"Career reality"},{"type":"p","text":"Logistics Coordinator is a realistic entry-level career target for this degree."},{"type":"p","text":"Students should expect their first role to sometimes be titled Logistics Executive, Operations Executive, Import-Export Executive or Supply Chain Coordinator rather than exactly “Logistics Coordinator.”"}]},{"heading":"Postgraduate study in India","kind":"pg_india","blocks":[{"type":"table","header":["PG pathway","Best suited for"],"rows":[[{"text":"M.Com"},{"text":"Commerce + logistics/business"}],[{"text":"M.Com International Business"},{"text":"International trade"}],[{"text":"MBA Supply Chain Management"},{"text":"Supply-chain leadership"}],[{"text":"MBA Logistics & Supply Chain Management"},{"text":"Direct logistics specialisation"}],[{"text":"MBA International Business"},{"text":"Global trade and business"}],[{"text":"MBA Operations Management"},{"text":"Operations + logistics"}],[{"text":"M.Sc Supply Chain Management"},{"text":"Specialised supply-chain career"}],[{"text":"M.Sc Logistics"},{"text":"Logistics specialisation"}],[{"text":"MBA Business Analytics"},{"text":"Data-driven supply-chain roles"}],[{"text":"PG Diploma in Logistics & Supply Chain"},{"text":"Practical career specialisation"}],[{"text":"PG Diploma in International Trade"},{"text":"EXIM pathway"}],[{"text":"PhD Supply Chain Management"},{"text":"Academic/research career"}]]},{"type":"p","text