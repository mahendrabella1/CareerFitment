":"Writers"},{"text":"Musicians"},{"text":"Cinematographers"},{"text":"Editors"},{"text":"Production companies"},{"text":"OTT platforms"},{"text":"Broadcasters"},{"text":"Distributors"}]},{"type":"h","text":"Rights Matrix"},{"type":"p","text":"Create a matrix such as:"},{"type":"table","header":["Right","Owner","Licensed To","Territory","Duration"],"rows":[[{"text":"OTT"},{"text":"X"},{"text":"Platform A"},{"text":"India"},{"text":"5 years"}],[{"text":"Satellite"},{"text":"X"},{"text":"Broadcaster B"},{"text":"India"},{"text":"3 years"}],[{"text":"Music"},{"text":"Y"},{"text":"Label C"},{"text":"Worldwide"},{"text":"10 years"}],[{"text":"Remake"},{"text":"X"},{"text":"Studio D"},{"text":"South Asia"},{"text":"7 years"}]]},{"type":"p","text":"This is a highly useful practical skill."}]},{"heading":"IP Due Diligence","kind":"other","blocks":[{"type":"p","text":"Before acquiring or licensing content, legal teams need to establish whether the rights actually belong to the party offering them."},{"type":"h","text":"Workflow"},{"type":"flow","items":["Identify IP","Identify Owner","Check Agreements","Verify Assignments","Check Licences","Search Registrations","Identify Disputes","Check Third-Party Rights","Identify Restrictions","Prepare Risk Report"]},{"type":"p","text":"The student should learn to identify:"},{"type":"list","items":[{"text":"Ownership gaps"},{"text":"Unclear assignments"},{"text":"Expired licenses"},{"text":"Conflicting rights"},{"text":"Existing disputes"},{"text":"Third-party claims"},{"text":"Territory restrictions"},{"text":"Exclusivity restrictions"}]}]},{"heading":"Trademark & Brand Protection","kind":"other","blocks":[{"type":"p","text":"Entertainment companies often have valuable brands."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Trademark searching"},{"text":"Classification"},{"text":"Brand clearance"},{"text":"Trademark applications"},{"text":"Opposition"},{"text":"Infringement"},{"text":"Passing off"},{"text":"Domain-name