{"title":"Career Roadmap: Sub-Editor","role":"Sub-Editor","summary":"Career Domain: Media, Communication, Arts & Design · Qualification Pathway: BJMC / B.A. Journalism & Mass Communication – Print & Digital Journalism · Target Career: Sub-Editor","facts":{"Current degree":"BJMC / B.A. Journalism & Mass Communication","Course":"Print & Digital Journalism"},"about":[{"label":"About this roadmap","text":"This roadmap was drafted with AI assistance from OneGrasp's related roadmaps and is awaiting expert review. Check fees, dates, eligibility and exam patterns on the official websites before you rely on them."}],"intro":[],"horizons":[],"sections":[{"heading":"Career Overview","kind":"other","blocks":[{"type":"p","text":"A Sub-Editor checks and shapes news before it is published - fixing facts, grammar and length, writing headlines and making stories clear and fair."},{"type":"h","text":"What a Sub-Editor does"},{"type":"list","items":[{"text":"Edit reporters' copy for accuracy, clarity and style"},{"text":"Write headlines, captions and summaries"},{"text":"Check facts, names and numbers"},{"text":"Lay out pages or format stories for the web"}]},{"type":"p","text":"Where they work:"},{"type":"list","items":[{"text":"Newspapers and magazines"},{"text":"Digital news sites"},{"text":"News agencies"},{"text":"Publishing houses"}]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Career stage","Typical role"],"rows":[[{"text":"Entry-level"},{"text":"Trainee Sub-Editor"}],[{"text":"Early career"},{"text":"Sub-Editor"}],[{"text":"Mid-level"},{"text":"Senior Sub-Editor"}],[{"text":"Senior"},{"text":"Chief Sub-Editor"}],[{"text":"Leadership"},{"text":"News Editor"}]]}]},{"heading":"Year-by-Year Learning Roadmap","kind":"build","blocks":[{"type":"h","text":"Year 1: Language and news basics"},{"type":"list","items":[{"text":"Master grammar and style in English or your language"},{"text":"Read 2 newspapers daily"},{"text":"Learn news values and ethics"}]},{"type":"h","text":"Year 2: Editing craft"},{"type":"list","items":[{"text":"Practise editing and headline writing daily"},{"text":"Learn media law (defamation, contempt)"},{"text":"Learn a CMS like WordPress"}]},{"type":"h","text":"Year 3: Desk experience"},{"type":"list","items":[{"text":"Intern on a news desk"},{"text":"Edit a college publication"},{"text":"Learn SEO headlines and fact-checking tools"}]}]},{"heading":"Essential Skills","kind":"build","blocks":[{"type":"table","header":["Skill","Type"],"rows":[[{"text":"Copy editing"},{"text":"Technical"}],[{"text":"Headline writing"},{"text":"Technical"}],[{"text":"Fact-checking"},{"text":"Technical"}],[{"text":"Media law"},{"text":"Technical"}],[{"text":"CMS"},{"text":"Technical"}],[{"text":"Attention to detail"},{"text":"Professional"}],[{"text":"Speed"},{"text":"Professional"}],[{"text":"Judgement"},{"text":"Professional"}]]}]},{"heading":"Tools and Technologies to Learn","kind":"build","blocks":[{"type":"list","items":[{"text":"CMS (WordPress, Arc)"},{"text":"Style guides"},{"text":"Fact-checking tools"},{"text":"InDesign / QuarkXPress (print)"}]}]},{"heading":"Internships and Practical Experience","kind":"internships","blocks":[{"type":"list","items":[{"text":"Newspaper desks"},{"text":"Digital newsrooms"},{"text":"News agencies"}]}]},{"heading":"Certifications and Additional Training","kind":"certifications","blocks":[{"type":"list","items":[{"text":"Google News Initiative training"},{"text":"Fact-checking courses"}]},{"type":"note","label":"Before you enrol","text":"Check the current syllabus, fees and eligibility on the certifying body's official website."}]},{"heading":"Higher Education Options in India","kind":"pg_india","blocks":[{"type":"p","text":"Options after your degree:"},{"type":"list","items":[{"text":"PG Diploma in Journalism (IIMC, ACJ)"},{"text":"MA Journalism"}]},{"type":"p","text":"Entrance exams and tests to know:"},{"type":"list","items":[{"text":"IIMC entrance"},{"text":"CUET-