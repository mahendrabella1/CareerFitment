","text":"Analytics"},{"type":"p","text":"Strong additions:"},{"type":"list","items":[{"text":"Advanced Excel"},{"text":"Power BI"},{"text":"SQL"},{"text":"Python"}]},{"type":"h","text":"Management"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Project management"},{"text":"Lean"},{"text":"Six Sigma"},{"text":"Operations management"}]},{"type":"p","text":"For regulated maritime training, use recognised maritime training providers and verify current regulatory recognition before enrolling."}]},{"heading":"Jobs You Can Target After B.Sc","kind":"careers","blocks":[{"type":"h","text":"Direct-entry roles"},{"type":"table","header":["Job","Typical Focus"],"rows":[[{"text":"Port Operations Executive"},{"text":"Port operations"}],[{"text":"Port Operations Trainee"},{"text":"Operational support"}],[{"text":"Terminal Operations Executive"},{"text":"Terminal activities"}],[{"text":"Shipping Operations Executive"},{"text":"Vessel/shipping coordination"}],[{"text":"Port Operations Assistant"},{"text":"Daily operations"}],[{"text":"Cargo Operations Executive"},{"text":"Cargo handling"}],[{"text":"Vessel Operations Executive"},{"text":"Vessel coordination"}],[{"text":"Marine Operations Executive"},{"text":"Marine operations"}],[{"text":"Port Documentation Executive"},{"text":"Documentation"}],[{"text":"Shipping Executive"},{"text":"Shipping coordination"}],[{"text":"Logistics Executive"},{"text":"Cargo movement"}],[{"text":"Terminal Operations Coordinator"},{"text":"Terminal coordination"}],[{"text":"Yard Operations Executive"},{"text":"Yard management"}],[{"text":"Port Planning Assistant"},{"text":"Planning and scheduling"}],[{"text":"Maritime Operations Analyst"},{"text":"Operational analytics"}]]}]},{"heading":"Strong Employer-Ready Profile","kind":"other","blocks":[{"type":"p","text":"The strongest graduate profile is:"},{"type":"flow","items":["Maritime Science","Port Operations","Shipping Documentation","Logistics","Excel","Power BI","SQL","Safety","Communi