 Handling"},{"text":"★★"},{"text":"★★★★"},{"text":"★★★★★"}],[{"text":"Logistics"},{"text":"★"},{"text":"★★★"},{"text":"★★★★"}],[{"text":"Excel"},{"text":"★★★"},{"text":"★★★★"},{"text":"★★★★★"}],[{"text":"Power BI"},{"text":"—"},{"text":"★"},{"text":"★★★"},{"text":"★★★★"}],[{"text":"SQL"},{"text":"—"},{"text":"★"},{"text":"★★★"}],[{"text":"Shipping Documentation"},{"text":"★"},{"text":"★★★"},{"text":"★★★★"},{"text":"★★★★★"}],[{"text":"Safety"},{"text":"★★★"},{"text":"★★★★"},{"text":"★★★★★"}],[{"text":"Communication"},{"text":"★★★"},{"text":"★★★★"},{"text":"★★★★★"}],[{"text":"Data Analytics"},{"text":"★"},{"text":"★★"},{"text":"★★★★"}]]}]},{"heading":"Practical Projects","kind":"other","blocks":[{"type":"h","text":"Project 1 — Port Operations Dashboard"},{"type":"p","text":"Analyse:"},{"type":"list","items":[{"text":"Vessel arrivals"},{"text":"Cargo volume"},{"text":"Berth utilisation"},{"text":"Vessel turnaround"},{"text":"Yard occupancy"}]},{"type":"p","text":"Use:"},{"type":"h","text":"Excel + Power BI"},{"type":"h","text":"Project 2 — Vessel Turnaround Optimisation"},{"type":"p","text":"Identify:"},{"type":"list","items":[{"text":"Waiting time"},{"text":"Berthing delay"},{"text":"Cargo handling delay"},{"text":"Documentation delay"},{"text":"Equipment delay"}]},{"type":"p","text":"Recommend operational improvements."},{"type":"h","text":"Project 3 — Container Yard Optimisation"},{"type":"p","text":"Analyse:"},{"type":"list","items":[{"text":"Container arrivals"},{"text":"Yard capacity"},{"text":"Dwell time"},{"text":"Empty containers"},{"text":"Gate traffic"}]},{"type":"p","text":"Create an optimisation proposal."},{"type":"h","text":"Project 4 — Port Congestion Analysis"},{"type":"p","text":"Study:"},{"type":"flow","items":["Vessel traffic","truck traffic","yard utilisation","berth availability"],"sep":"+"},{"type":"p","text":"Create a congestion-risk dashboard."},{"type":"h","text":"Project 5 — Digital Port Concept"},{"type":"p","text":"Design a conceptual Smart