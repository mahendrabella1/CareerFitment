 — Sustainability Assessment"},{"type":"p","text":"Conduct a simulated sustainability assessment for a company."},{"type":"p","text":"Analyze:"},{"type":"flow","items":["Environmental Baseline","Carbon","Energy","Water","Waste","Supply Chain","ESG Gaps","Improvement Roadmap"]},{"type":"p","text":"This should become the student's primary portfolio project."}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Practical environmental exposure is highly valuable."},{"type":"h","text":"Relevant internships"},{"type":"list","items":[{"text":"Sustainability Intern"},{"text":"ESG Intern"},{"text":"Environmental Engineering Intern"},{"text":"Environmental Consultant Intern"},{"text":"Carbon Accounting Intern"},{"text":"Climate Analyst Intern"},{"text":"Environmental Monitoring Intern"},{"text":"EIA Intern"},{"text":"Energy Analyst Intern"},{"text":"Sustainability Reporting Intern"}]},{"type":"h","text":"Relevant organizations"},{"type":"list","items":[{"text":"Environmental consulting firms"},{"text":"Sustainability consultancies"},{"text":"Engineering companies"},{"text":"Manufacturing companies"},{"text":"Renewable-energy companies"},{"text":"Infrastructure companies"},{"text":"ESG advisory firms"},{"text":"Environmental laboratories"},{"text":"Government/environmental organizations"},{"text":"Research institutions"}]},{"type":"p","text":"The best internship combines environmental data + business analysis + sustainability recommendations rather than only laboratory work."}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"type":"h","text":"Sustainability"},{"type":"list","items":[{"text":"Sustainability Analyst"},{"text":"Sustainability Consultant"},{"text":"Sustainability Associate"},{"text":"ESG Analyst"},{"text":"ESG Consultant"}]},{"type":"h","text":"Environmental"},{"type":"list","items":[{"text":"Environmental Engineer"},{"text":"Environmental Consultant"},{"text":"Environmental Analyst"},{"text":"Environmental 