dvanced Excel"},{"text":"Power BI"},{"text":"SQL"},{"text":"Python"},{"text":"Data visualization"}]},{"type":"h","text":"Standards / Systems"},{"type":"p","text":"Learn the principles behind:"},{"type":"list","items":[{"text":"ISO 14001"},{"text":"Environmental management systems"},{"text":"GHG accounting standards"},{"text":"Life-cycle assessment standards"}]},{"type":"p","text":"Certification should follow practical understanding rather than replace it."}]},{"heading":"PG Options","kind":"pg_india","blocks":[{"type":"p","text":"A PG is not mandatory for entry-level sustainability roles, but specialization can be valuable."},{"type":"h","text":"Technical"},{"type":"list","items":[{"text":"M.Tech Environmental Engineering"},{"text":"M.Tech Environmental Management"},{"text":"M.Tech Energy & Environment"},{"text":"M.Tech Climate/Environmental Engineering"}]},{"type":"h","text":"Management"},{"type":"list","items":[{"text":"MBA Sustainability"},{"text":"MBA Environmental Management"},{"text":"MBA Energy Management"},{"text":"MBA Operations/Supply Chain"}]},{"type":"h","text":"Specialized"},{"type":"list","items":[{"text":"M.Sc Environmental Science"},{"text":"M.Sc Climate Science"},{"text":"Master's in Sustainability"},{"text":"Master's in Environmental Management"},{"text":"Master's in Renewable Energy"}]},{"type":"h","text":"Career Specializations"}]},{"heading":"ESG Consulting","kind":"other","blocks":[{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"ESG assessment"},{"text":"Materiality"},{"text":"Sustainability KPIs"},{"text":"Reporting"},{"text":"ESG strategy"}]},{"type":"p","text":"Path:"},{"type":"flow","items":["Sustainability Analyst","ESG Consultant","Senior Consultant","ESG Manager"]}]},{"heading":"Carbon & Climate","kind":"other","blocks":[{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"GHG inventories"},{"text":"Carbon accounting"},{"text":"Reduction strategies"},{"text":"Climate risk"},{"text":"Net-zero planning"}]},{"type":"p","text":"Path:"},{"type":"flow","items":["Carbon Analyst","Climate Consultant","Senior Climate Consultant","Climate Strategy Lead"]}]},{"heading":"Environmental Compliance","kind":"other","blocks":[{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Environmental regulations"},{"text":"Permits"},{"text":"Monitoring"},{"text":"Audits"},{"text":"Compliance systems"}]},{"type":"p","text":"Path:"},{"type":"flow","items":["Environmental Engineer","Environmental Consultant","Compliance Manager"]}]},{"heading":"Circular Economy","kind":"other","blocks":[{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Waste reduction"},{"text":"Recycling"},{"text":"Product lifecycle"},{"text":"Resource efficiency"},{"text":"Circular business models"}]}]},{"heading":"Sustainable Supply Chain","kind":"other","blocks":[{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Supplier emissions"},{"text":"Scope 3"},{"text":"Sustainable procurement"},{"text":"Logistics emissions"},{"text":"Supplier ESG assessments"}]},{"type":"p","text":"This combines particularly well with supply-chain analytics."}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"Sustainability consulting route"},{"type":"flow","items":["B.Tech Environmental Engineering","Sustainability / Environmental Intern","Sustainability Analyst","Sustainability Consultant","Senior Sustainability Consultant","Sustainability Manager","Sustainability Director"]},{"type":"h","text":"Climate route"},{"type":"flow","items":["Environmental Engineer","Carbon Analyst","Climate Consultant","Senior Climate Consultant","Climate Strategy Lead","Climate / Sustainability Director"]},{"type":"h","text":"Corporate sustainability route"},{"type":"flow","items":["Environmental Engineer","ESG / Sustainability Analyst","Sustainability Specialist","Sustainability Manager","Head of Sustainability / ESG"]},{"type":"h","text":"Emerging Technologies"},{"type":"p","text":"Sustainability is 