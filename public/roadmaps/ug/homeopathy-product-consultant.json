ic statistics"},{"type":"h","text":"Understand:"},{"type":"h","text":"Mean"},{"type":"h","text":"Median"},{"type":"h","text":"Percentages"},{"type":"h","text":"Trends"},{"type":"h","text":"Correlation"},{"type":"h","text":"Survey analysis"}]},{"heading":"AI in Homeopathy Product Consulting","kind":"other","blocks":[{"type":"h","text":"AI can improve productivity in:"},{"type":"h","text":"Market research"},{"type":"h","text":"Product information organization"},{"type":"h","text":"Competitor analysis"},{"type":"h","text":"Content drafting"},{"type":"h","text":"FAQ creation"},{"type":"h","text":"Training-material development"},{"type":"h","text":"Customer-feedback analysis"},{"type":"h","text":"Sales-data analysis"},{"type":"h","text":"Literature organization"},{"type":"h","text":"Responsible workflow"},{"type":"h","text":"AI-Assisted Draft / Analysis"},{"type":"h","text":"Source Verification"},{"type":"h","text":"Clinical / Product Review"},{"type":"h","text":"Regulatory Review"},{"type":"h","text":"Human Approval"},{"type":"h","text":"Published Material"},{"type":"p","text":"AI should not independently generate or approve medical claims."}]},{"heading":"Product Portfolio Management","kind":"other","blocks":[{"type":"p","text":"Learn to manage a product portfolio."},{"type":"h","text":"Example:"},{"type":"table","header":["Product","Category","Customer","Market Position","Priority"],"rows":[[{"text":"Product A"},{"text":"Respiratory"},{"text":"Consumer"},{"text":"Established"},{"text":"High"}],[{"text":"Product B"},{"text":"Digestive"},{"text":"Consumer"},{"text":"Growth"},{"text":"Medium"}],[{"text":"Product C"},{"text":"Wellness"},{"text":"Consumer"},{"text":"New"},{"text":"High"}]]},{"type":"h","text":"Analyze:"},{"type":"h","text":"Sales"},{"type":"h","text":"Demand"},{"type":"h","text":"Competition"},{"type":"h","text":"Customer feedback"},{"type":"h","text":"Distribution"},{"type":"h","text":"Product lifecycle"},{"type":"h","text":"Growth opportunities"}]},{"hea