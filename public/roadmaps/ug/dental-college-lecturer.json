n"},{"type":"h","text":"Diagnosis"},{"type":"h","text":"Treatment planning"},{"type":"h","text":"Preventive dentistry"},{"type":"h","text":"Restorative procedures"},{"type":"h","text":"Prosthetic procedures"},{"type":"h","text":"Periodontal care"},{"type":"h","text":"Oral surgery"},{"type":"h","text":"Pediatric dental care"},{"type":"h","text":"Community dentistry"}]},{"heading":"What to Learn During BDS","kind":"other","blocks":[{"type":"h","text":"Year 1 — Scientific Foundation"},{"type":"p","text":"Focus on understanding the biological foundations of dentistry."},{"type":"h","text":"Learn"},{"type":"h","text":"Human anatomy"},{"type":"h","text":"Physiology"},{"type":"h","text":"Biochemistry"},{"type":"h","text":"Dental anatomy"},{"type":"h","text":"Oral biology"},{"type":"h","text":"Basic scientific terminology"},{"type":"h","text":"Build"},{"type":"h","text":"Scientific reading"},{"type":"h","text":"Medical/dental literature searching"},{"type":"h","text":"Presentation skills"},{"type":"h","text":"Academic note-making"},{"type":"h","text":"Basic research awareness"}]},{"heading":"Year 2 — Preclinical & Disease Foundation","kind":"build","blocks":[{"type":"p","text":"Develop an understanding of oral disease and dental materials."},{"type":"h","text":"Learn"},{"type":"h","text":"Pathology"},{"type":"h","text":"Microbiology"},{"type":"h","text":"Pharmacology"},{"type":"h","text":"Dental materials"},{"type":"h","text":"Preclinical restorative dentistry"},{"type":"h","text":"Oral pathology fundamentals"},{"type":"h","text":"Additional Skills"},{"type":"h","text":"Case presentation"},{"type":"h","text":"Dental charting"},{"type":"h","text":"Basic statistics"},{"type":"h","text":"Scientific poster creation"},{"type":"h","text":"Literature review"},{"type":"h","text":"Year 3 — Clinical Dentistry"},{"type":"p","text":"Begin connecting theory with patient management."},{"type":"h","text":"Areas"},{"type":"h","text":"Oral medicine"},{"type":"h","text":"Oral surgery"},{"typ