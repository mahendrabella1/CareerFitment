aviour"},{"text":"Market research"},{"text":"STP"},{"text":"Branding"},{"text":"Digital marketing"},{"text":"Customer journey"}]},{"type":"h","text":"Performance"},{"type":"list","items":[{"text":"Paid search"},{"text":"Paid social"},{"text":"Media buying"},{"text":"Retargeting"},{"text":"Lead generation"},{"text":"Conversion optimization"},{"text":"Campaign optimization"}]},{"type":"h","text":"Analytics"},{"type":"list","items":[{"text":"Excel"},{"text":"Power BI"},{"text":"SQL"},{"text":"Web analytics"},{"text":"Attribution"},{"text":"A/B testing"},{"text":"Customer analytics"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"CRM"},{"text":"Analytics/tracking tools"},{"text":"Marketing automation"},{"text":"AI tools"},{"text":"Basic Python"}]},{"type":"h","text":"Business"},{"type":"list","items":[{"text":"CAC"},{"text":"LTV"},{"text":"ROAS"},{"text":"Revenue"},{"text":"Margins"},{"text":"Budgeting"},{"text":"Forecasting"}]}]},{"heading":"Final Portfolio Target","kind":"other","blocks":[{"type":"p","text":"By graduation, the student should have:"},{"type":"list","items":[{"text":"1 paid campaign simulation"},{"text":"1 marketing performance dashboard"},{"text":"1 CRO/A-B testing project"},{"text":"1 customer acquisition economics project"},{"text":"1 full-funnel performance marketing capstone"},{"text":"Excel"},{"text":"Power BI"},{"text":"SQL"},{"text":"Analytics/tracking knowledge"},{"text":"CRM exposure"},{"text":"Paid advertising platform familiarity"},{"text":"At least 1 performance marketing internship"},{"text":"A portfolio showing measurable campaign decisions and optimization logic"}]},{"type":"h","text":"Target Graduate Profile"},{"type":"flow","items":["BBA Digital Marketing","Marketing Fundamentals","Consumer Behaviour","Digital Marketing","Paid Search","Paid Social","Marketing Funnel","Tracking","Analytics","CRO","A/B Testing","CAC/LTV/ROAS","Excel","Power BI","SQL","CRM","Marketing Automation","Internship","Performance Marketing As