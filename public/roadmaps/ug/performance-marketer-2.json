{"title":"Career Roadmap: Performance Marketer","role":"Performance Marketer","summary":"A Performance Marketer plans, launches, monitors and optimizes digital marketing campaigns based on measurable business outcomes such as leads, purchases, registrations, app installs or revenue.","facts":{"Current degree":"BBA / BMS / BBM (Bachelor of Business Administration / Management Studies)","Course":"BBA - Digital Marketing"},"about":[{"label":"Primary Goal","text":"Build expertise in paid advertising, customer acquisition, conversion optimization, marketing analytics and ROI-driven growth"}],"intro":[],"horizons":[],"sections":[{"heading":"Overview","kind":"other","blocks":[{"type":"h","text":"Career Roadmap Overview"},{"type":"p","text":"A Performance Marketer plans, launches, monitors and optimizes digital marketing campaigns based on measurable business outcomes such as leads, purchases, registrations, app installs or revenue."},{"type":"p","text":"The role is different from general digital marketing because the primary focus is measurable performance and business outcomes."},{"type":"p","text":"Typical responsibilities include:"},{"type":"list","items":[{"text":"Paid search"},{"text":"Paid social"},{"text":"Campaign planning"},{"text":"Audience targeting"},{"text":"Budget allocation"},{"text":"Landing-page optimization"},{"text":"Conversion tracking"},{"text":"A/B testing"},{"text":"Marketing analytics"},{"text":"Customer acquisition"},{"text":"Retargeting"},{"text":"Campaign optimization"},{"text":"ROI/ROAS analysis"},{"text":"Reporting"}]},{"type":"p","text":"The strongest skill combination is:"},{"type":"flow","items":["Marketing","Paid Media","Analytics","Conversion Optimization","Tracking","Business Economics"],"sep":"+"}]},{"heading":"What to Build During UG","kind":"build","blocks":[{"type":"table","header":["Year","Build This","Learn From","Proof to Create","Gap to Avoid"],"rows":[[{"text":"Year 1"},{"text":"Marketing foundation"},{"text":"Marketing, consumer behaviour, economics, statistics"},{"text":"Marketing case study"},{"text":"Weak marketing fundamentals"}],[{"text":"Year 2"},{"text":"Digital acquisition"},{"text":"SEO, paid ads, social media, content, funnels"},{"text":"Campaign simulation"},{"text":"Learning platforms without understanding marketing"}],[{"text":"Year 3"},{"text":"Performance analytics"},{"text":"Tracking, GA4 concepts, Excel, SQL, Power BI, CRO"},{"text":"Campaign analytics dashboard"},{"text":"Focusing only on ad creatives"}],[{"text":"Final Year"},{"text":"Growth execution"},{"text":"Media buying, experimentation, attribution, budget optimization"},{"text":"Performance marketing capstone + internship"},{"text":"No measurable campaign experience"}]]}]},{"heading":"Semester-by-Semester Roadmap","kind":"build","blocks":[{"type":"h","text":"Semester 1"},{"type":"list","items":[{"text":"Principles of Management"},{"text":"Marketing Fundamentals"},{"text":"Business Economics"},{"text":"Financial Accounting"},{"text":"Business Communication"},{"text":"Consumer Behaviour"},{"text":"Excel fundamentals"}]},{"type":"h","text":"Semester 2"},{"type":"list","items":[{"text":"Digital Marketing Fundamentals"},{"text":"Business Statistics"},{"text":"Market Research"},{"text":"Advertising"},{"text":"Brand Management"},{"text":"Social Media Fundamentals"},{"text":"Advanced Excel"}]},{"type":"h","text":"Semester 3"},{"type":"list","items":[{"text":"Search Engine Marketing"},{"text":"Search Engine Optimization"},{"text":"Social Media Marketing"},{"text":"Content Marketing"},{"text":"Email Marketing"},{"text":"Customer Journey"},{"text":"Google Analytics concepts"}]},{"type":"h","text":"Semester 4"},{"type":"list","items":[{"text":"Paid Search"},{"text":"Paid Social"},{"text":"Conversion Funnels"},{"text":"Landing-page optimization"},{"text":"Marketing KPIs"},{"text":"Campaign tracking"},{"text":"A/B testing"},{"text":"Power BI"}]},{"type":"h","text":"Semester 5"},{"type":"list","items":[{"text":"Performance Marketing Strategy"},{"text":"Attribution"},{"text":"Marketing Analytics"},{"text":"Customer Acquisition"},{"text":"Retargeting"},{"text":"Marketing automation"},{"text":"Basic SQL"},{"text":"Python analytics fundamentals"}]},{"type":"h","text":"Semester 6"},{"type":"list","items":[{"text":"Performance marketing internship"},{"text":"Campaign optimization project"},{"text":"Marketing analytics dashboard"},{"text":"Growth experiment"},{"text":"Capstone"},{"text":"Portfolio development"}]}]},{"heading":"Performance Marketing Fundamentals","kind":"other","blocks":[{"type":"p","text":"Understand the complete acquisition cycle:"},{"type":"flow","items":["Audience","Ad","Click","Landing Page","Conversion","Customer","Revenue","Retention"]},{"type":"p","text":"Learn the difference between:"},{"type":"h","text":"Awareness"},{"type":"list","items":[{"text":"Reach"},{"text":"Impressions"},{"text":"Video views"}]},{"type":"h","text":"Acquisition"},{"type":"list","items":[{"text":"Clicks"},{"text":"Leads"},{"text":"Sign-ups"},{"text":"Purchases"}]},{"type":"h","text":"Revenue"},{"type":"list","items":[{"text":"Revenue"},{"text":"ROAS"},{"text":"CAC"},{"text":"LTV"},{"text":"Contribution margin"}]},{"type":"p","text":"The objective is not simply to generate clicks. It is to generate economically valuable customer outcomes."}]},{"heading":"Paid Advertising","kind":"other","blocks":[{"type":"p","text":"Develop working knowledge of major paid-media channels."},{"type":"h","text":"Search Advertising"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Search intent"},{"text":"Keywords"},{"text":"Match types"},{"text":"Ad groups"},{"text":"Search terms"},{"text":"Ad copy"},{"text":"Quality/relevance concepts"},{"text":"Bidding"},{"text":"Conversion tracking"},{"text":"Search campaigns"},{"text":"Shopping/product advertising concepts"}]},{"type":"h","text":"Social Advertising"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Audience targeting"},{"text":"Custom audiences"},{"text":"Lookalike/similar audiences"},{"text":"Retargeting"},{"text":"Creative testing"},{"text":"Campaign objectives"},{"text":"Placements"},{"text":"Frequency"},{"text":"Conversion campaigns"}]},{"type":"p","text":"Platforms may include:"},{"type":"list","items":[{"text":"Google Ads"},{"text":"Meta Ads"},{"text":"LinkedIn Ads"},{"text":"YouTube advertising"},{"text":"Other relevant ad platforms"}]},{"type":"p","text":"Platform interfaces and policies change frequently, so students should learn the underlying concepts rather than memorize one platform's current interface."}]},{"heading":"Marketing Funnel","kind":"other","blocks":[{"type":"p","text":"Understand:"},{"type":"flow","items":["Impression","Click","Landing Page","Lead/Signup","Qualified Customer","Purchase","Repeat Purchase"]},{"type":"h","text":"Funnel Metrics"},{"type":"list","items":[{"text":"Impressions"},{"text":"Reach"},{"text":"CTR"},{"text":"CPC"},{"text":"Landing-page view"},{"text":"Conversion rate"},{"text":"CPL"},{"text":"CPA"},{"text":"CAC"},{"text":"AOV"},{"text":"ROAS"},{"text":"LTV"}]},{"type":"p","text":"Example:"},{"type":"flow","items":["10,000 impressions","500 clicks","50 leads","10 customers"]},{"type":"p","text":"Students should identify where the biggest funnel loss occurs and test improvements there."}]},{"heading":"Important Performance Marketing Metrics","kind":"other","blocks":[{"type":"table","header":["Metric","Meaning"],"rows":[[{"text":"CTR"},{"text":"Click-through rate"}],[{"text":"CPC"},{"text":"Cost per click"}],[{"text":"CPM"},{"text":"Cost per thousand impressions"}],[{"text":"CPL"},{"text":"Cost per lead"}],[{"text":"CPA"},{"text":"Cost per acquisition/action"}],[{"text":"CAC"},{"text":"Customer acquisition cost"}],[{"text":"CVR"},{"text":"Conversion rate"}],[{"text":"AOV"},{"text":"Average order value"}],[{"text":"ROAS"},{"text":"Return on ad spend"}],[{"text":"LTV"},{"text":"Customer lifetime value"}],[{"text":"MER"},{"text":"Marketing efficiency ratio"}],[{"text":"Frequency"},{"text":"Average exposure to an audience"}]]},{"type":"h","text":"Key formulas"},{"type":"h","text":"CTR = Clicks ÷ Impressions × 100"},{"type":"h","text":"Conversion Rate = Conversions ÷ Relevant Visitors/Clicks × 100"},{"type":"h","text":"CPC = Ad Spend ÷ Clicks"},{"type":"h","text":"CPA = Ad Spend ÷ Conversions"},{"type":"h","text":"ROAS = Attributed Revenue ÷ Ad Spend"},{"type":"p","text":"These metrics must always be interpreted in context; a high ROAS does not automatically mean a campaign is profitable if margins and other costs are ignored."}]},{"heading":"Customer Acquisition Economics","kind":"other","blocks":[{"type":"p","text":"Learn:"},{"type":"h","text":"CAC"},{"type":"h","text":"CAC = Total Acquisition Cost ÷ New Customers Acquired"},{"type":"h","text":"LTV"},{"type":"p","text":"Understand customer value over the relationship period."},{"type":"note","label":"LTV","text":"CAC"},{"type":"p","text":"Use this as a directional unit-economics measure rather than a universal pass/fail rule."},{"type":"p","text":"Also understand:"},{"type":"list","items":[{"text":"Gross margin"},{"text":"Contribution margin"},{"text":"Payback period"},{"text":"Retention"},{"text":"Churn"},{"text":"Repeat purchases"},{"text":"Customer cohorts"}]},{"type":"p","text":"A strong performance marketer understands profitability, not just advertising metrics."}]},{"heading":"Audience & Customer Segmentation","kind":"other","blocks":[{"type":"p","text":"Learn how to divide audiences based on:"},{"type":"list","items":[{"text":"Demographics"},{"text":"Geography"},{"text":"Interests"},{"text":"Behaviour"},{"text":"Purchase history"},{"text":"Website activity"},{"text":"Customer lifecycle"},{"text":"Engagement"},{"text":"Intent"}]},{"type":"p","text":"Useful frameworks:"},{"type":"list","items":[{"text":"ICP"},{"text":"Buyer persona"},{"text":"RFM"},{"text":"Customer lifecycle"},{"text":"New vs returning customers"},{"text":"High-value vs low-value customers"}]}]},{"heading":"Conversion Rate Optimization","kind":"other","blocks":[{"type":"p","text":"Learn how to improve the percentage of visitors who take the desired action."},{"type":"h","text":"Landing Page"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Headline"},{"text":"Value proposition"},{"text":"CTA"},{"text":"Trust signals"},{"text":"Social proof"},{"text":"Product benefits"},{"text":"Form length"},{"text":"Page speed"},{"text":"Mobile usability"},{"text":"Pricing"},{"text":"FAQ"},{"text":"Objection handling"}]},{"type":"h","text":"CRO Process"},{"type":"flow","items":["Identify Problem","Form Hypothesis","Test","Measure","Analyse","Iterate"]}]},{"heading":"A/B Testing & Experimentation","kind":"other","blocks":[{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Control vs treatment"},{"text":"Hypothesis"},{"text":"Primary metric"},{"text":"Sample size concepts"},{"text":"Statistical significance"},{"text":"Confidence intervals"},{"text":"Test duration"},{"text":"Experiment bias"},{"text":"False positives"},{"text":"Multiple testing awareness"}]},{"type":"p","text":"Examples:"},{"type":"list","items":[{"text":"Ad A vs Ad B"},{"text":"Landing page A vs B"},{"text":"CTA A vs B"},{"text":"Headline A vs B"},{"text":"Pricing presentation A vs B"}]},{"type":"p","text":"Avoid declaring a winner simply because one version has a slightly higher percentage without considering statistical and business significance."}]},{"heading":"Marketing Analytics","kind":"other","blocks":[{"type":"h","text":"Excel"},{"type":"p","text":"Master:"},{"type":"list","items":[{"text":"XLOOKUP"},{"text":"INDEX/MATCH"},{"text":"SUMIFS"},{"text":"COUNTIFS"},{"text":"IF/IFS"},{"text":"IFERROR"},{"text":"PivotTables"},{"text":"Charts"},{"text":"Power Query"}]},{"type":"h","text":"Power BI"},{"type":"p","text":"Build dashboards for:"},{"type":"list","items":[{"text":"Campaign performance"},{"text":"Channel performance"},{"text":"Lead generation"},{"text":"CAC"},{"text":"ROAS"},{"text":"Conversion"},{"text":"Revenue"},{"text":"Customer segments"}]},{"type":"h","text":"SQL"},{"type":"p","text":"Learn:"},{"type":"p","text":"SELECT"},{"type":"p","text":"WHERE"},{"type":"p","text":"GROUP BY"},{"type":"p","text":"HAVING"},{"type":"p","text":"ORDER BY"},{"type":"p","text":"CASE"},{"type":"p","text":"JOIN"},{"type":"p","text":"CTEs"},{"type":"p","text":"Subqueries"},{"type":"p","text":"Window Functions"}]},{"heading":"Tracking & Measurement","kind":"other","blocks":[{"type":"p","text":"A performance marketer must understand how campaign actions are measured."},{"type":"p","text":"Learn concepts such as:"},{"type":"list","items":[{"text":"UTM parameters"},{"text":"Conversion events"},{"text":"Pixels/tags"},{"text":"First-party data"},{"text":"Website analytics"},{"text":"Attribution"},{"text":"Event tracking"},{"text":"Funnel tracking"},{"text":"CRM integration"},{"text":"Offline conversion concepts"}]},{"type":"p","text":"Understand the flow:"},{"type":"flow","items":["Ad","Click","Website/App","Event","Analytics","CRM/Database","Revenue"]},{"type":"p","text":"Also understand that attribution systems are imperfect and different platforms may report different results."}]},{"heading":"Analytics Platforms","kind":"other","blocks":[{"type":"p","text":"Develop working knowledge of:"},{"type":"list","items":[{"text":"Google Analytics"},{"text":"Google Tag Manager concepts"},{"text":"Search Console"},{"text":"Advertising-platform analytics"},{"text":"CRM analytics"},{"text":"Power BI"}]},{"type":"p","text":"For a student, understanding how measurement works is more important than memorizing every platform interface."}]},{"heading":"SEO & Organic Acquisition","kind":"other","blocks":[{"type":"p","text":"Although the target role is performance marketing, understand:"},{"type":"list","items":[{"text":"Keyword research"},{"text":"Search intent"},{"text":"On-page SEO"},{"text":"Technical SEO basics"},{"text":"Content strategy"},{"text":"Internal linking"},{"text":"Backlinks"},{"text":"Organic traffic"},{"text":"Search Console"},{"text":"Landing-page relevance"}]},{"type":"p","text":"Performance marketers benefit from understanding the difference between:"},{"type":"h","text":"Paid acquisition vs organic acquisition"},{"type":"p","text":"and how the two interact."}]},{"heading":"Marketing Automation","kind":"other","blocks":[{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Email automation"},{"text":"Lead nurturing"},{"text":"Customer segmentation"},{"text":"Retargeting"},{"text":"CRM workflows"},{"text":"Lifecycle campaigns"},{"text":"Trigger-based communication"},{"text":"Lead scoring"}]},{"type":"p","text":"Example:"},{"type":"flow","items":["Ad","Lead Form","CRM","Lead Score","Email/WhatsApp workflow","Sales","Customer"]}]},{"heading":"Projects to Build","kind":"other","blocks":[{"type":"h","text":"Project 1 — Paid Campaign Simulation"},{"type":"p","text":"Select a fictional product and design:"},{"type":"list","items":[{"text":"Target audience"},{"text":"Campaign objective"},{"text":"Ad groups"},{"text":"Keywords/audiences"},{"text":"Creative concepts"},{"text":"Budget"},{"text":"Bidding approach"},{"text":"Landing page"},{"text":"Conversion event"},{"text":"KPI framework"}]},{"type":"p","text":"Create a simulated campaign report."},{"type":"h","text":"Project 2 — Marketing Performance Dashboard"},{"type":"p","text":"Create a dataset containing:"},{"type":"list","items":[{"text":"Campaign"},{"text":"Channel"},{"text":"Spend"},{"text":"Impressions"},{"text":"Clicks"},{"text":"Leads"},{"text":"Customers"},{"text":"Revenue"}]},{"type":"p","text":"Calculate:"},{"type":"list","items":[{"text":"CTR"},{"text":"CPC"},{"text":"CPL"},{"text":"CPA"},{"text":"Conversion rate"},{"text":"CAC"},{"text":"ROAS"}]},{"type":"p","text":"Build the dashboard in Power BI."},{"type":"h","text":"Project 3 — CRO Experiment"},{"type":"p","text":"Create two landing-page versions."},{"type":"p","text":"Test:"},{"type":"list","items":[{"text":"Headline"},{"text":"CTA"},{"text":"Offer"},{"text":"Form"},{"text":"Social proof"},{"text":"Page layout"}]},{"type":"p","text":"Analyse the results and produce an experiment report."}]},{"heading":"Advanced Capstone Project","kind":"other","blocks":[{"type":"h","text":"Performance Marketing & Growth Intelligence Platform"},{"type":"p","text":"Build a simulated system combining:"},{"type":"flow","items":["Advertising","Analytics","CRM","Attribution","CRO","Revenue Analytics"],"sep":"+"},{"type":"h","text":"Modules"},{"type":"list","items":[{"text":"Campaign database"},{"text":"Customer acquisition"},{"text":"Channel performance"},{"text":"Funnel analytics"},{"text":"CAC"},{"text":"ROAS"},{"text":"Customer cohorts"},{"text":"Attribution"},{"text":"A/B testing"},{"text":"Revenue analysis"},{"text":"Marketing dashboard"}]},{"type":"h","text":"Suggested Stack"},{"type":"flow","items":["Google Analytics concepts","Excel","SQL","Power BI","CRM"],"sep":"+"},{"type":"p","text":"Optional:"},{"type":"h","text":"Python for marketing analytics and forecasting"}]},{"heading":"Specialization Choices","kind":"other","blocks":[{"type":"table","header":["Specialization","Primary Focus"],"rows":[[{"text":"Paid Search"},{"text":"Search advertising"}],[{"text":"Paid Social"},{"text":"Social advertising"}],[{"text":"Growth Marketing"},{"text":"Full-funnel growth"}],[{"text":"Conversion Rate Optimization"},{"text":"Website/app conversion"}],[{"text":"Marketing Analytics"},{"text":"Data-driven marketing"}],[{"text":"E-commerce Performance"},{"text":"Online sales"}],[{"text":"Lead Generation"},{"text":"B2B/B2C lead acquisition"}],[{"text":"App Marketing"},{"text":"Installs and app revenue"}],[{"text":"Affiliate Marketing"},{"text":"Partner-based acquisition"}],[{"text":"Lifecycle Marketing"},{"text":"Retention and customer value"}],[{"text":"Revenue Marketing"},{"text":"Marketing-to-revenue optimization"}]]}]},{"heading":"Internships","kind":"internships","