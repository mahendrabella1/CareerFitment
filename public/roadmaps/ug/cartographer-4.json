Roads"},{"text":"Schools"},{"text":"Hospitals"},{"text":"Public transport"},{"text":"Population"},{"text":"Service coverage"}]},{"type":"p","text":"Then perform:"},{"type":"h","text":"Distance/buffer/accessibility analysis"}]},{"heading":"Year 3 — Remote Sensing + Spatial Analysis","kind":"other","blocks":[{"type":"p","text":"Move beyond basic map creation."},{"type":"h","text":"Remote sensing"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Satellite imagery"},{"text":"Raster data"},{"text":"Spectral bands"},{"text":"Resolution"},{"text":"Image classification"},{"text":"NDVI"},{"text":"NDWI"},{"text":"NDBI"},{"text":"Land-use/land-cover classification"}]},{"type":"h","text":"Data sources"},{"type":"p","text":"Work with:"},{"type":"list","items":[{"text":"Sentinel imagery"},{"text":"Landsat imagery"},{"text":"OpenStreetMap"},{"text":"Government/open geospatial datasets"}]},{"type":"h","text":"Project"},{"type":"h","text":"Land Use/Land Cover Change Analysis"},{"type":"p","text":"Compare two time periods."},{"type":"p","text":"For example:"},{"type":"h","text":"Urban Expansion of a City Between 2015 and 2025"},{"type":"p","text":"Analyse:"},{"type":"list","items":[{"text":"Built-up area"},{"text":"Vegetation"},{"text":"Water bodies"},{"text":"Agricultural land"},{"text":"Change hotspots"}]},{"type":"p","text":"Produce:"},{"type":"flow","items":["Satellite Analysis","Maps","Statistics","Report"],"sep":"+"}]},{"heading":"Year 4 — Advanced Digital Cartography","kind":"other","blocks":[{"type":"p","text":"If the BA is four years, learn how to move from static maps to interactive geospatial products."},{"type":"h","text":"Web GIS"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Leaflet"},{"text":"Mapbox concepts"},{"text":"ArcGIS Online"},{"text":"Web map layers"},{"text":"GeoJSON"},{"text":"APIs"}]},{"type":"h","text":"Programming"},{"type":"p","text":"Learn:"},{"type":"h","text":"Python"},{"type":"list","items":[{"text":"pandas"},{"text":"G