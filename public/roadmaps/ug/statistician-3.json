ime Series"},{"text":"Forecasting, decomposition, ARIMA concepts"}],[{"text":"Multivariate Statistics"},{"text":"PCA, clustering, discriminant analysis"}],[{"text":"Bayesian Statistics"},{"text":"Priors, likelihood, posterior inference"}],[{"text":"Sampling"},{"text":"Probability and survey sampling"}],[{"text":"Quality Control"},{"text":"Control charts, process capability"}],[{"text":"Survival Analysis"},{"text":"Censoring, hazard, survival models"}],[{"text":"Statistical Computing"},{"text":"R, Python, SQL"}],[{"text":"Research"},{"text":"Study design, reproducibility, scientific reporting"}]]}]},{"heading":"Programming & Statistical Computing","kind":"other","blocks":[{"type":"p","text":"A modern Statistician should be highly comfortable with statistical software."},{"type":"h","text":"R — Priority"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Base R"},{"text":"tidyverse"},{"text":"dplyr"},{"text":"ggplot2"},{"text":"tidyr"},{"text":"data.table"},{"text":"Shiny"},{"text":"R Markdown / Quarto"}]},{"type":"p","text":"Use R for:"},{"type":"list","items":[{"text":"Statistical modelling"},{"text":"Exploratory data analysis"},{"text":"Regression"},{"text":"Hypothesis testing"},{"text":"Visualization"},{"text":"Research reporting"}]},{"type":"h","text":"Python"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"NumPy"},{"text":"pandas"},{"text":"SciPy"},{"text":"Matplotlib"},{"text":"seaborn"},{"text":"statsmodels"},{"text":"scikit-learn"}]},{"type":"p","text":"Use Python for:"},{"type":"list","items":[{"text":"Data processing"},{"text":"Statistical modelling"},{"text":"Forecasting"},{"text":"Machine learning"},{"text":"Automation"}]},{"type":"h","text":"SQL"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"SELECT"},{"text":"JOIN"},{"text":"GROUP BY"},{"text":"CTEs"},{"text":"Window functions"},{"text":"Subqueries"},{"text":"Aggregations"}]}]},{"heading":"Statistical Modelling","kind":"other","blocks":[{"type":"p","text":"Deve