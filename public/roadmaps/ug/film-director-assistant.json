{"title":"Career Roadmap: Film Director (Assistant)","role":"Film Director (Assistant)","summary":"Career Domain: Media, Communication, Arts & Design · Qualification Pathway: B.Des – Film & Video Communication · Target Career: Film Director (Assistant)","facts":{"Current degree":"B.Des (Bachelor of Design)","Course":"Film & Video Communication"},"about":[{"label":"About this roadmap","text":"This roadmap was drafted with AI assistance from OneGrasp's related roadmaps and is awaiting expert review. Check fees, dates, eligibility and exam patterns on the official websites before you rely on them."}],"intro":[],"horizons":[],"sections":[{"heading":"Career Overview","kind":"other","blocks":[{"type":"p","text":"An Assistant Director keeps a film or series shoot organised: schedules, call sheets, continuity and coordination between actors and crew, while learning the craft of directing."},{"type":"h","text":"What a Film Director (Assistant) does"},{"type":"list","items":[{"text":"Break down scripts and plan shooting schedules"},{"text":"Prepare call sheets and coordinate actors and crew"},{"text":"Track continuity and keep the set on time"},{"text":"Support the director in rehearsals and post-production"}]},{"type":"p","text":"Where they work:"},{"type":"list","items":[{"text":"Film and web-series production houses"},{"text":"Advertising film companies"},{"text":"TV production"},{"text":"Independent and documentary projects"}]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Career stage","Typical role"],"rows":[[{"text":"Entry-level"},{"text":"Intern / 3rd AD"}],[{"text":"Early career"},{"text":"2nd AD"}],[{"text":"Mid-level"},{"text":"1st AD / Chief AD"}],[{"text":"Senior"},{"text":"Associate Director"}],[{"text":"Leadership"},{"text":"Director"}]]}]},{"heading":"Year-by-Year Learning Roadmap","kind":"build","blocks":[{"type":"h","text":"Year 1: Film language"},{"type":"list","items":[{"text":"Study film history, grammar and screenwriting basics"},{"text":"Shoot short exercises on a phone"},{"text":"Watch and analyse films every week"}]},{"type":"h","text":"Year 2: Production craft"},{"type":"list","items":[{"text":"Learn camera, sound and editing basics"},{"text":"Make 2 short films as director"},{"text":"Learn script breakdown and scheduling"}]},{"type":"h","text":"Year 3: On real sets"},{"type":"list","items":[{"text":"Assist on ad shoots or student films"},{"text":"Learn scheduling software and call sheets"},{"text":"Enter short films in festivals"}]},{"type":"h","text":"Year 4: Portfolio and network"},{"type":"list","items":[{"text":"Final film with a festival plan"},{"text":"Build a showreel"},{"text":"Join productions as an AD intern"}]}]},{"heading":"Essential Skills","kind":"build","blocks":[{"type":"table","header":["Skill","Type"],"rows":[[{"text":"Script breakdown"},{"text":"Technical"}],[{"text":"Scheduling and call sheets"},{"text":"Technical"}],[{"text":"Continuity"},{"text":"Technical"}],[{"text":"Directing basics"},{"text":"Technical"}],[{"text":"Organisation"},{"text":"Professional"}],[{"text":"Calm leadership"},{"text":"Professional"}],[{"text":"Long hours"},{"text":"Professional"}]]}]},{"heading":"Tools and Technologies to Learn","kind":"build","blocks":[{"type":"list","items":[{"text":"StudioBinder or Movie Magic Scheduling"},{"text":"Final Draft / Celtx"},{"text":"DaVinci Resolve / Premiere"}]}]},{"heading":"Internships and Practical Experience","kind":"internships","blocks":[{"type":"list","items":[{"text":"Production houses"},{"text":"Ad film companies"},{"text":"OTT series productions"}]}]},{"heading":"Certifications and Additional Training","kind":"certifications","blocks":[{"type":"list","items":[{"text":"Short courses at film schools"},{"text":"Set-safety training"}]},{"type":"note","label":"Before you enrol","text":"Check the current syllabus, fees and eligibility on the certifying body's official website."}]},{"heading":"Higher Education Options in India","kind":"pg_india","blocks":[{"type":"p","text":"Options after your degree:"},{"type":"list","items":[{"text":"PG Diploma in Direction (FTII, SRFTI)"},{"text":"MA Film Studies"}]},{"type":"p","text":"Entrance exams and tests to know:"},{"type":"list","items":[{"text":"JET (FTII / SRFTI)"}]}]},{"heading":"Study Abroad Options","kind":"abroad","blocks":[{"type":"list","items":[{"text":"MFA Film Directing (US, UK)"}]}]},{"heading":"Career Opportunities","kind":"careers","blocks":[{"type":"p","text":"Roles a Film Director (Assistant) can grow into or move across to:"},{"type":"list","items":[{"text":"Writer"},{"text":"Editor"},{"text":"Producer"},{"text":"Casting Director"}]}]},{"heading":"Recommended Career Progression","kind":"growth","blocks":[{"type":"flow","items":["Intern / 3rd AD","2nd AD","1st AD / Chief AD","Associate Director","Director"]}]}],"drafted":true}