ition environments"},{"text":"Virtual production"},{"text":"Production design"},{"text":"Art direction"}]},{"type":"h","text":"Learn about:"},{"type":"list","items":[{"text":"Construction methods"},{"text":"Scenic painting"},{"text":"Props"},{"text":"Set dressing"},{"text":"Lighting"},{"text":"Camera considerations"},{"text":"Materials"},{"text":"Budgeting"},{"text":"Production schedules"},{"text":"Safety"}]},{"type":"h","text":"Year 4 — Industry Preparation"},{"type":"h","text":"Focus on:"},{"type":"list","items":[{"text":"Internship/assistantship"},{"text":"Real production experience"},{"text":"Complete set-design projects"},{"text":"Portfolio development"},{"text":"Technical documentation"},{"text":"3D renders"},{"text":"Physical models"},{"text":"Behind-the-scenes documentation"}]},{"type":"flow","items":["Build a portfolio that demonstrates concept","design","technical development","final set"]}]},{"heading":"Specialisation Options","kind":"other","blocks":[{"type":"table","header":["Specialisation","Core Focus"],"rows":[[{"text":"Film Set Designer"},{"text":"Film environments"}],[{"text":"Television Set Designer"},{"text":"TV studios and programmes"}],[{"text":"Theatre Set Designer"},{"text":"Stage environments"}],[{"text":"Advertising Set Designer"},{"text":"Commercial campaigns"}],[{"text":"Music Video Set Designer"},{"text":"Artist/video environments"}],[{"text":"Event Set Designer"},{"text":"Live experiences"}],[{"text":"Exhibition Set Designer"},{"text":"Exhibitions and installations"}],[{"text":"Retail Set Designer"},{"text":"Brand environments"}],[{"text":"Photography Set Designer"},{"text":"Editorial/commercial shoots"}],[{"text":"Virtual Production Designer"},{"text":"LED-volume/digital environments"}],[{"text":"Scenic Designer"},{"text":"Theatre and performance environments"}],[{"text":"Production Designer"},{"text":"Overall visual world of a production"}],[{"text":"Art Director"},{"text":"Visual execution and art department"}],[{"text":"Immersive Ex