sor"},{"type":"p","text":"Design/simulate a nanoscale sensor concept."},{"type":"p","text":"Possible applications:"},{"type":"list","items":[{"text":"Gas detection"},{"text":"Biosensing"},{"text":"Temperature"},{"text":"Pressure"}]},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Sensitivity"},{"text":"Selectivity"},{"text":"Response time"},{"text":"Noise"}]},{"type":"h","text":"Project 5 — AI-Based Semiconductor Device Characterization"},{"type":"p","text":"Build a Python system that analyzes device-characterization data."},{"type":"p","text":"Pipeline:"},{"type":"flow","items":["Device Measurements","Data Cleaning","Feature Extraction","Parameter Extraction","ML Model","Device Classification / Prediction"]},{"type":"p","text":"This creates a strong bridge between nanoelectronics + AI/data science."}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Target:"},{"type":"h","text":"Semiconductor Companies"},{"type":"p","text":"Look for:"},{"type":"list","items":[{"text":"Device engineering"},{"text":"Process engineering"},{"text":"VLSI"},{"text":"Verification"},{"text":"Characterization"},{"text":"Reliability"},{"text":"Packaging"}]},{"type":"h","text":"Research Laboratories"},{"type":"p","text":"Seek projects involving:"},{"type":"list","items":[{"text":"Semiconductor devices"},{"text":"Nanoelectronics"},{"text":"MEMS"},{"text":"Sensors"},{"text":"Materials"},{"text":"Photonics"}]},{"type":"h","text":"Universities"},{"type":"p","text":"Approach professors working in:"},{"type":"list","items":[{"text":"Microelectronics"},{"text":"VLSI"},{"text":"Semiconductor physics"},{"text":"Nanoelectronics"},{"text":"MEMS"},{"text":"Computational device modelling"}]},{"type":"h","text":"Electronics R&D Companies"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Sensor development"},{"text":"IC design"},{"text":"Embedded hardware"},{"text":"Power electronics"},{"text":"RF electronics"}]}]},{"heading":"Entry-Level Care