3"}],[{"text":"Industry reports"},{"text":"2–3"}],[{"text":"Policy trackers"},{"text":"1–2"}],[{"text":"Internships"},{"text":"2–3"}],[{"text":"Excel"},{"text":"Advanced"}],[{"text":"Power BI"},{"text":"Working proficiency"}],[{"text":"SQL"},{"text":"Basic"}],[{"text":"Research"},{"text":"Strong"}],[{"text":"Policy writing"},{"text":"Strong"}],[{"text":"Presentation"},{"text":"Strong"}],[{"text":"Industry specialisation"},{"text":"1 sector"}],[{"text":"AI policy/research tools"},{"text":"Practical proficiency"}]]},{"type":"h","text":"Best Practical Path"},{"type":"h","text":"BA Political Economy / Public Policy / Governance"},{"type":"flow","items":["Build economics + governance + public-policy fundamentals","Learn policy research + regulatory monitoring + stakeholder mapping","Master policy writing, executive briefings and presentations","Add Excel + Power BI + basic SQL/Python","Choose an industry such as Technology, FinTech, Healthcare, Energy or Telecom","Complete 2–3 government affairs/public policy internships","Build policy briefs + regulatory analyses + stakeholder maps + policy dashboards","Apply for Government Affairs Associate / Public Affairs Associate / Policy Research Associate / Regulatory Affairs Associate","Gain sector-specific experience","Progress to Government Affairs Executive → Senior Executive → Manager → Director/Head of Government Affairs","Pursue MA Public Policy / Economics / Public Administration / International Relations or MBA when advanced specialisation or management progression requires it."]},{"type":"h","text":"Best 2030-ready combination"},{"type":"flow","items":["Public Policy","Political Economy","Regulatory Intelligence","Government Relations","Stakeholder Management","Industry Expertise","Data Analytics","AI-Assisted Policy Research","Strong Policy Writing."],"sep":"+"}]}]}