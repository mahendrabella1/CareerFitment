:"Synthetic performances"}]},{"type":"p","text":"Understanding rights and contractual consent will become increasingly important."},{"type":"h","text":"Performance Analytics"},{"type":"p","text":"Digital tools may assist with:"},{"type":"list","items":[{"text":"Speech"},{"text":"Timing"},{"text":"Movement"},{"text":"Self-tape review"}]}]},{"heading":"Target Profile at Graduation","kind":"other","blocks":[{"type":"p","text":"An ideal BPA Theatre/Acting graduate should have:"},{"type":"h","text":"Acting"},{"type":"list","items":[{"text":"Strong acting fundamentals"},{"text":"Character-development ability"},{"text":"Script-analysis skills"},{"text":"Improvisation"},{"text":"Emotional expression"}]},{"type":"h","text":"Voice"},{"type":"list","items":[{"text":"Clear diction"},{"text":"Voice projection"},{"text":"Vocal modulation"},{"text":"Speech control"},{"text":"Multilingual ability where relevant"}]},{"type":"h","text":"Physical"},{"type":"list","items":[{"text":"Stage movement"},{"text":"Body awareness"},{"text":"Character physicality"},{"text":"Basic dance/movement training"}]},{"type":"h","text":"Screen"},{"type":"list","items":[{"text":"Camera awareness"},{"text":"Self-taping"},{"text":"Close-up performance"},{"text":"Continuity"},{"text":"Audition technique"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Theatre credits"},{"text":"Short-film experience"},{"text":"Showreel"},{"text":"Headshots"},{"text":"Acting CV"},{"text":"Casting profile"}]}]},{"heading":"Recommended Portfolio","kind":"other","blocks":[{"type":"p","text":"By graduation, the student should ideally have:"},{"type":"p","text":"BPA Theatre / Acting"},{"type":"p","text":"+"},{"type":"p","text":"Multiple Theatre Productions"},{"type":"p","text":"+"},{"type":"p","text":"Short Film Experience"},{"type":"p","text":"+"},{"type":"p","text":"Professional Headshots"},{"type":"p","text":"+"},{"type":"p","text":"Acting CV"},{"type":"p","text":"+"},{"type":"p","text":"Showreel"},{"type":"p","text":"+"},{"type":"p","text":"Monologue Portfolio"},{"type":"p","text":"+"},{"type":"p","text":"Self-Tape Samples"},{"type":"p","text":"+"},{"type":"p","text":"Voice / Dubbing Sample"},{"type":"p","text":"+"},{"type":"p","text":"Performance Credits"},{"type":"p","text":"A particularly strong portfolio could contain:"},{"type":"list","items":[{"text":"3–5 theatre productions"},{"text":"3–5 professionally recorded scenes"},{"text":"1 strong showreel"},{"text":"3 contrasting monologues"},{"text":"1–2 short films"},{"text":"Voice-performance sample"},{"text":"Professional headshots"},{"text":"Updated acting CV"}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"p","text":"ACTING"},{"type":"p","text":"├── Acting Technique"},{"type":"p","text":"├── Character Development"},{"type":"p","text":"├── Script Analysis"},{"type":"p","text":"├── Scene Study"},{"type":"p","text":"├── Improvisation"},{"type":"p","text":"└── Emotional Expression"},{"type":"p","text":"VOICE"},{"type":"p","text":"├── Diction"},{"type":"p","text":"├── Voice Projection"},{"type":"p","text":"├── Modulation"},{"type":"p","text":"├── Speech"},{"type":"p","text":"└── Accent / Language Skills"},{"type":"p","text":"MOVEMENT"},{"type":"p","text":"├── Body Language"},{"type":"p","text":"├── Stage Movement"},{"type":"p","text":"├── Physical Theatre"},{"type":"p","text":"├── Dance"},{"type":"p","text":"└── Character Physicality"},{"type":"p","text":"SCREEN"},{"type":"p","text":"├── Camera Acting"},{"type":"p","text":"├── Self-Taping"},{"type":"p","text":"├── Eye-Line"},{"type":"p","text":"├── Continuity"},{"type":"p","text":"└── Audition Technique"},{"type":"p","text":"PROFESSIONAL"},{"type":"p","text":"├── Headshots"},{"type":"p","text":"├── Acting CV"},{"type":"p","text":"├── Showreel"},{"type":"p","text":"├── Networking"},{"type":"p","text":"├── Personal Branding"},{"type":"p","text":"└── Contract / Rights Awareness"},{"type":"p","text":"TECHNOLOGY"},{"type":"p","text":"├─