"items":[{"text":"Dramatic scene"},{"text":"Naturalistic scene"},{"text":"Comedy scene"},{"text":"Character scene"},{"text":"Monologue"}]},{"type":"p","text":"Keep the strongest performances at the beginning."},{"type":"h","text":"Project 3 — Short Film"},{"type":"p","text":"Participate in a student short film."},{"type":"p","text":"Gain experience with:"},{"type":"list","items":[{"text":"Camera"},{"text":"Blocking"},{"text":"Multiple takes"},{"text":"Continuity"},{"text":"Director's instructions"},{"text":"Scene preparation"}]},{"type":"h","text":"Project 4 — Character Study"},{"type":"p","text":"Select a complex fictional character and document:"},{"type":"list","items":[{"text":"Background"},{"text":"Motivation"},{"text":"Objectives"},{"text":"Relationships"},{"text":"Emotional arc"},{"text":"Physicality"},{"text":"Voice"},{"text":"Performance choices"}]},{"type":"h","text":"Project 5 — Monologue Portfolio"},{"type":"p","text":"Prepare several contrasting monologues:"},{"type":"list","items":[{"text":"Dramatic"},{"text":"Comic"},{"text":"Emotional"},{"text":"Contemporary"},{"text":"Classical/theatrical"}]}]},{"heading":"Internship & Industry Experience","kind":"internships","blocks":[{"type":"p","text":"For actors, practical performance experience is more valuable than a conventional office internship."},{"type":"h","text":"Useful Environments"},{"type":"list","items":[{"text":"Theatre companies"},{"text":"Production houses"},{"text":"Film schools"},{"text":"Independent filmmakers"},{"text":"OTT production teams"},{"text":"Advertising agencies"},{"text":"Casting organizations"},{"text":"Theatre festivals"},{"text":"Performing-arts organizations"}]},{"type":"h","text":"Suitable Opportunities"},{"type":"list","items":[{"text":"Theatre Intern"},{"text":"Acting Intern"},{"text":"Production Assistant"},{"text":"Performer"},{"text":"Assistant Theatre Artist"},{"text":"Casting Assistant"},{"text":"Short-Film Actor"},{"text":"Voice Artist Intern"}]},{"type":"p","text":"S