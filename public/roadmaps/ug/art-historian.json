{"title":"Career Roadmap: Art Historian","role":"Art Historian","summary":"Career Domain: Media, Communication, Arts & Design · Qualification Pathway: BFA – Art History & Aesthetics · Target Career: Art Historian","facts":{"Current degree":"BFA (Bachelor of Fine Arts)","Course":"Art History & Aesthetics"},"about":[{"label":"About this roadmap","text":"This roadmap was drafted with AI assistance from OneGrasp's related roadmaps and is awaiting expert review. Check fees, dates, eligibility and exam patterns on the official websites before you rely on them."}],"intro":[],"horizons":[],"sections":[{"heading":"Career Overview","kind":"other","blocks":[{"type":"p","text":"An Art Historian studies art and visual culture through time - who made it, why and what it means - and shares that knowledge through teaching, writing and museum work."},{"type":"h","text":"What a Art Historian does"},{"type":"list","items":[{"text":"Research artworks, artists and periods"},{"text":"Write papers, books and catalogues"},{"text":"Teach and lecture"},{"text":"Advise museums and collections"}]},{"type":"p","text":"Where they work:"},{"type":"list","items":[{"text":"Universities and colleges"},{"text":"Museums"},{"text":"Research institutes (e.g. IGNCA)"},{"text":"Publishing and auction houses"}]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Career stage","Typical role"],"rows":[[{"text":"Entry-level"},{"text":"Research Assistant"}],[{"text":"Early career"},{"text":"Lecturer / Assistant Professor"}],[{"text":"Mid-level"},{"text":"Associate Professor"}],[{"text":"Senior"},{"text":"Professor"}],[{"text":"Leadership"},{"text":"Head of department / institute"}]]}]},{"heading":"Year-by-Year Learning Roadmap","kind":"build","blocks":[{"type":"h","text":"Year 1: Foundations"},{"type":"list","items":[{"text":"Survey of Indian and world art"},{"text":"Visit museums and keep notes"},{"text":"Learn academic writing"}]},{"type":"h","text":"Year 2: Research skills"},{"type":"list","items":[{"text":"Learn research methods and iconography"},{"text":"Read primary sources"},{"text":"Write a research paper"}]},{"type":"h","text":"Year 3: Specialise"},{"type":"list","items":[{"text":"Pick a period or region"},{"text":"Present at a student seminar"},{"text":"Intern at a museum or research centre"}]},{"type":"h","text":"Year 4: Prepare for PG"},{"type":"list","items":[{"text":"Dissertation on a focused topic"},{"text":"Learn a relevant language (Sanskrit, Persian or a European language)"},{"text":"Apply for MA Art History"}]}]},{"heading":"Essential Skills","kind":"build","blocks":[{"type":"table","header":["Skill","Type"],"rows":[[{"text":"Visual analysis"},{"text":"Technical"}],[{"text":"Research methods"},{"text":"Technical"}],[{"text":"Academic writing"},{"text":"Technical"}],[{"text":"Iconography"},{"text":"Technical"}],[{"text":"Curiosity"},{"text":"Professional"}],[{"text":"Patience"},{"text":"Professional"}],[{"text":"Public speaking"},{"text":"Professional"}]]}]},{"heading":"Tools and Technologies to Learn","kind":"build","blocks":[{"type":"list","items":[{"text":"Library and digital archives"},{"text":"Zotero"},{"text":"Image databases"}]}]},{"heading":"Internships and Practical Experience","kind":"internships","blocks":[{"type":"list","items":[{"text":"Museums"},{"text":"Research institutes"},{"text":"Auction houses"}]}]},{"heading":"Certifications and Additional Training","kind":"certifications","blocks":[{"type":"list","items":[{"text":"Museum and heritage courses"}]},{"type":"note","label":"Before you enrol","text":"Check the current syllabus, fees and eligibility on the certifying body's official website."}]},{"heading":"Higher Education Options in India","kind":"pg_india","blocks":[{"type":"p","text":"Options after your degree:"},{"type":"list","items":[{"text":"MA Art History"},{"text":"Ph.D."}]},{"type":"p","text":"Entrance exams and tests to know:"},{"type":"list","items":[{"text":"UGC NET (Visual Arts)"},{"text":"University entrance tests"}]}]},{"heading":"Study Abroad Options","kind":"abroad","blocks":[{"type":"list","items":[{"text":"MA / Ph.D. Art History (UK, US, Europe)"}]}]},{"heading":"Career Opportunities","kind":"careers","blocks":[{"type":"p","text":"Roles a Art Historian can grow into or move across to:"},{"type":"list","items":[{"text":"Art Curator"},{"text":"Art Critic"},{"text":"Heritage Researcher"},{"text":"Museum Educator"}]}]},{"heading":"Recommended Career Progression","kind":"growth","blocks":[{"type":"flow","items":["Research Assistant","Lecturer / Assistant Professor","Associate Professor","Professor","Head of department / institute"]}]}],"drafted":true}