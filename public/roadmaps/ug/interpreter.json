dence"},{"text":"Interpretation recordings"},{"text":"Translation samples"},{"text":"Terminology glossary"},{"text":"Conference simulations"},{"text":"Internship experience"},{"text":"Academic record"},{"text":"CV"},{"text":"SOP"},{"text":"Recommendations"},{"text":"Language-specific certificates"},{"text":"English-language test where required"}]}]},{"heading":"Going forward","kind":"growth","blocks":[{"type":"h","text":"Career progression"},{"type":"flow","items":["BA Translation & Interpretation","Language/Interpretation Intern","Junior Interpreter","Interpreter","Senior Interpreter","Conference/Diplomatic/Technical Interpreter","Interpretation Lead / Language Services Manager"]},{"type":"h","text":"PhD routes"},{"type":"h","text":"For research/academic careers:"},{"type":"list","items":[{"text":"PhD Translation Studies"},{"text":"PhD Interpretation Studies"},{"text":"PhD Linguistics"},{"text":"PhD Applied Linguistics"},{"text":"PhD Intercultural Communication"},{"text":"PhD Language Studies"},{"text":"PhD International Communication"}]},{"type":"h","text":"2040–2046"},{"type":"p","text":"At senior levels, build expertise in high-stakes conference interpretation, diplomacy, international organisations, specialised technical domains and multilingual communication management. A strong interpreter should also understand AI-assisted speech tools, terminology databases and machine-translation workflows while retaining human responsibility for accuracy, context and confidentiality."}]}]}