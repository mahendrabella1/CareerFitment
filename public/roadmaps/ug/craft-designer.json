{"title":"Career Roadmap: Craft Designer","role":"Craft Designer","summary":"Career Domain: Media, Communication, Arts & Design · Qualification Pathway: BFA – Ceramics / Craft / Textile Arts · Target Career: Craft Designer","facts":{"Current degree":"BFA (Bachelor of Fine Arts)","Course":"Ceramics / Craft / Textile Arts"},"about":[{"label":"About this roadmap","text":"This roadmap was drafted with AI assistance from OneGrasp's related roadmaps and is awaiting expert review. Check fees, dates, eligibility and exam patterns on the official websites before you rely on them."}],"intro":[],"horizons":[],"sections":[{"heading":"Career Overview","kind":"other","blocks":[{"type":"p","text":"A Craft Designer works with artisans to design products rooted in traditional crafts - handloom, wood, metal, bamboo, pottery - that sell in today's markets while keeping the craft alive."},{"type":"h","text":"What a Craft Designer does"},{"type":"list","items":[{"text":"Research crafts and artisan clusters"},{"text":"Design products with artisans"},{"text":"Plan production, costing and quality"},{"text":"Connect products to markets"}]},{"type":"p","text":"Where they work:"},{"type":"list","items":[{"text":"Craft NGOs and social enterprises"},{"text":"Handicraft brands and exporters"},{"text":"Government craft programmes"},{"text":"Own label"}]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Career stage","Typical role"],"rows":[[{"text":"Entry-level"},{"text":"Junior Designer"}],[{"text":"Early career"},{"text":"Craft Designer"}],[{"text":"Mid-level"},{"text":"Senior Designer"}],[{"text":"Senior"},{"text":"Design Head"}],[{"text":"Leadership"},{"text":"Own craft brand"}]]}]},{"heading":"Year-by-Year Learning Roadmap","kind":"build","blocks":[{"type":"h","text":"Year 1: Foundations"},{"type":"list","items":[{"text":"Drawing and material exploration"},{"text":"Study Indian craft traditions"},{"text":"Visit a craft cluster"}]},{"type":"h","text":"Year 2: Design with makers"},{"type":"list","items":[{"text":"Learn co-design with artisans"},{"text":"Learn costing and production"},{"text":"Make a small product range"}]},{"type":"h","text":"Year 3: Field work"},{"type":"list","items":[{"text":"Intern with a craft organisation"},{"text":"Spend weeks in a cluster"},{"text":"Learn fair-trade and GI basics"}]},{"type":"h","text":"Year 4: Collection"},{"type":"list","items":[{"text":"Final collection made with artisans"},{"text":"Show at craft fairs"},{"text":"Plan a market route"}]}]},{"heading":"Essential Skills","kind":"build","blocks":[{"type":"table","header":["Skill","Type"],"rows":[[{"text":"Craft materials and techniques"},{"text":"Technical"}],[{"text":"Product design"},{"text":"Technical"}],[{"text":"Costing"},{"text":"Technical"}],[{"text":"Market linkage"},{"text":"Technical"}],[{"text":"Respect for artisans"},{"text":"Professional"}],[{"text":"Field work"},{"text":"Professional"}],[{"text":"Communication"},{"text":"Professional"}]]}]},{"heading":"Tools and Technologies to Learn","kind":"build","blocks":[{"type":"list","items":[{"text":"Sketching tools"},{"text":"Illustrator"},{"text":"Excel for costing"},{"text":"E-commerce platforms"}]}]},{"heading":"Internships and Practical Experience","kind":"internships","blocks":[{"type":"list","items":[{"text":"Craft NGOs (e.g. Dastkar, Crafts Council of India)"},{"text":"Handicraft exporters"},{"text":"Design studios"}]}]},{"heading":"Certifications and Additional Training","kind":"certifications","blocks":[{"type":"list","items":[{"text":"Craft-design workshops"},{"text":"Schemes of the Development Commissioner (Handicrafts)"}]},{"type":"note","label":"Before you enrol","text":"Check the current syllabus, fees and eligibility on the certifying body's official website."}]},{"heading":"Higher Education Options in India","kind":"pg_india","blocks":[{"type":"p","text":"Options after your degree:"},{"type":"list","items":[{"text":"M.Des Craft / Lifestyle Accessory Design"},{"text":"MFA Crafts"}]},{"type":"p","text":"Entrance exams and tests to know:"},{"type":"list","items":[{"text":"NID DAT"},{"text":"NIFT M.Des entrance"}]}]},{"heading":"Study Abroad Options","kind":"abroad","blocks":[{"type":"list","items":[{"text":"MA Craft / Design (UK, Europe)"}]}]},{"heading":"Career Opportunities","kind":"careers","blocks":[{"type":"p","text":"Roles a Craft Designer can grow into or move across to:"},{"type":"list","items":[{"text":"Textile Artist"},{"text":"Product Designer"},{"text":"Studio Entrepreneur"},{"text":"Merchandiser"}]}]},{"heading":"Recommended Career Progression","kind":"growth","blocks":[{"type":"flow","items":["Junior Designer","Craft Designer","Senior Designer","Design Head","Own craft brand"]}]}],"drafted":true}