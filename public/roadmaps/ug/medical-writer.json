ype":"h","text":"Year 1 — Medical Foundation"},{"type":"p","text":"Focus on understanding the language of medicine."},{"type":"h","text":"Core subjects"},{"type":"h","text":"Anatomy"},{"type":"h","text":"Physiology"},{"type":"h","text":"Biochemistry"},{"type":"h","text":"Medical terminology"},{"type":"h","text":"Basic pathology concepts"},{"type":"h","text":"Introduction to evidence-based medicine"},{"type":"h","text":"Writing development"},{"type":"h","text":"Start learning to:"},{"type":"h","text":"Explain medical concepts clearly"},{"type":"h","text":"Summarize textbook chapters"},{"type":"h","text":"Create patient-friendly explanations"},{"type":"h","text":"Read scientific papers"},{"type":"h","text":"Identify reliable medical sources"},{"type":"h","text":"Distinguish evidence from opinion"},{"type":"h","text":"Recommended projects"},{"type":"p","text":"Write a patient-friendly article on diabetes."},{"type":"p","text":"Convert a complex anatomy topic into an educational article."},{"type":"p","text":"Create a medical terminology glossary."},{"type":"p","text":"Summarize a recent medical research paper."}]},{"heading":"Year 2 — Disease & Clinical Knowledge","kind":"other","blocks":[{"type":"p","text":"Build deeper understanding of disease and treatment."},{"type":"h","text":"Important areas"},{"type":"h","text":"Pathology"},{"type":"h","text":"Pharmacology"},{"type":"h","text":"Microbiology"},{"type":"h","text":"Forensic medicine"},{"type":"h","text":"Community medicine"},{"type":"h","text":"Medical writers should understand:"},{"type":"h","text":"Disease mechanisms"},{"type":"h","text":"Drug mechanisms"},{"type":"h","text":"Adverse effects"},{"type":"h","text":"Contraindications"},{"type":"h","text":"Clinical terminology"},{"type":"h","text":"Diagnostic methods"},{"type":"h","text":"Epidemiology"},{"type":"h","text":"Public-health concepts"},{"type":"h","text":"Writing projects"},{"type":"h","text":"Create:"},{"type":"h","text":"Drug monographs"},{"type":"h","t