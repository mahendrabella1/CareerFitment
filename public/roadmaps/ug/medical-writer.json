n"},{"type":"h","text":"Journals/publishers"},{"type":"h","text":"Medical editing"},{"type":"h","text":"Scientific editing"},{"type":"h","text":"Peer-review support"},{"type":"h","text":"Editorial operations"}]},{"heading":"Employer Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Employer Type","Most Valuable Skills"],"rows":[[{"text":"Pharma"},{"text":"Clinical knowledge + medical writing"}],[{"text":"CRO"},{"text":"Clinical research + regulatory writing"}],[{"text":"Medical Communications Agency"},{"text":"Scientific writing + communication"}],[{"text":"Research Institute"},{"text":"Research + publication writing"}],[{"text":"Hospital"},{"text":"Clinical knowledge + patient communication"}],[{"text":"Medical Publisher"},{"text":"Editing + scientific writing"}],[{"text":"HealthTech"},{"text":"Medical knowledge + digital content"}],[{"text":"Healthcare Startup"},{"text":"Medical knowledge + content + product understanding"}],[{"text":"Academic Institution"},{"text":"Research + academic writing"}],[{"text":"Regulatory Consultancy"},{"text":"Clinical + regulatory documentation"}]]}]},{"heading":"Certifications & Additional Learning","kind":"certifications","blocks":[{"type":"h","text":"Useful areas to study:"},{"type":"h","text":"Medical writing"},{"type":"h","text":"Clinical research"},{"type":"h","text":"Good Clinical Practice"},{"type":"h","text":"Evidence-based medicine"},{"type":"h","text":"Biostatistics"},{"type":"h","text":"Epidemiology"},{"type":"h","text":"Pharmacovigilance"},{"type":"h","text":"Regulatory affairs"},{"type":"h","text":"Scientific communication"},{"type":"h","text":"Research methodology"},{"type":"h","text":"Medical editing"},{"type":"h","text":"Publication ethics"},{"type":"h","text":"High-value combination"},{"type":"h","text":"MBBS"},{"type":"h","text":"+"},{"type":"h","text":"Medical Writing"},{"type":"h","text":"+"},{"type":"h","text":"Clinical Research"},{"type":"h","text":"+"},{"type":"h","text":"Biostatistics"},{"type":"h","text":"+"},{"type":"h","text":"GCP"},{"type":"h","text":"+"},{"type":"h","text":"Scientific Communication"},{"type":"h","text":"+"},{"type":"h","text":"AI Literacy"}]},{"heading":"PG Options","kind":"pg_india","blocks":[{"type":"p","text":"An MBBS graduate does not necessarily need an additional postgraduate medical degree solely to become a medical writer. However, PG education can strengthen specialization."},{"type":"h","text":"Possible directions include:"},{"type":"h","text":"Medical/clinical specialization"},{"type":"h","text":"MD/MS"},{"type":"h","text":"Public Health"},{"type":"h","text":"Community Medicine"},{"type":"h","text":"Pharmacology"},{"type":"h","text":"Pathology"},{"type":"h","text":"Preventive medicine"},{"type":"h","text":"Epidemiology"},{"type":"h","text":"Research-oriented"},{"type":"h","text":"Clinical Research"},{"type":"h","text":"Public Health"},{"type":"h","text":"Epidemiology"},{"type":"h","text":"Biostatistics"},{"type":"h","text":"Health Sciences"},{"type":"h","text":"Non-clinical specialization"},{"type":"h","text":"Medical/Scientific Writing"},{"type":"h","text":"Healthcare Management"},{"type":"h","text":"Regulatory Affairs"},{"type":"h","text":"Clinical Research"},{"type":"h","text":"Medical Communications"},{"type":"h","text":"Public Health"}]},{"heading":"Career Specializations","kind":"other","blocks":[{"type":"h","text":"An MBBS graduate can specialize in:"},{"type":"h","text":"Regulatory Medical Writing"},{"type":"h","text":"Clinical Writing"},{"type":"h","text":"Medical Communications"},{"type":"h","text":"Medical Publications"},{"type":"h","text":"Scientific Writing"},{"type":"h","text":"Medical Editing"},{"type":"h","text":"Patient Education"},{"type":"h","text":"Pharmaceutical Writing"},{"type":"h","text":"Medical Affairs Content"},{"type":"h","text":"Clinical Research Writing"},{"type":"h","text":"Pharmacovigilance Writing"},{"type":"h","text":"HealthTech Content"},{"type":"h","text":"Public Health Writing"},{"type