xt":"Transaction documentation"},{"text":"Contract review"},{"text":"Regulatory research"}]},{"type":"h","text":"Year 4"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Major real estate law practices"},{"text":"Infrastructure companies"},{"text":"Investment firms"},{"text":"Corporate legal teams"}]},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Complex transactions"},{"text":"JDA/development agreements"},{"text":"Commercial leasing"},{"text":"Project documentation"}]},{"type":"h","text":"Final Year"},{"type":"p","text":"Target:"},{"type":"p","text":"Pre-placement internships with the possibility of a PPO."}]},{"heading":"Employer Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Employer","Skills Expected"],"rows":[[{"text":"Real Estate Law Firm"},{"text":"Property law + drafting + due diligence"}],[{"text":"Full-Service Law Firm"},{"text":"Transactions + corporate + property"}],[{"text":"Real Estate Developer"},{"text":"Contracts + approvals + land"}],[{"text":"Infrastructure Company"},{"text":"Land acquisition + contracts + projects"}],[{"text":"Construction Company"},{"text":"Construction contracts + disputes"}],[{"text":"Bank/NBFC"},{"text":"Mortgage + security + documentation"}],[{"text":"REIT/Investment Firm"},{"text":"Transactions + investment documentation"}],[{"text":"Corporate Legal Team"},{"text":"Contracts + compliance + risk"}],[{"text":"Boutique Property Firm"},{"text":"Title + registration + litigation"}]]}]},{"heading":"Certifications & Additional Learning","kind":"certifications","blocks":[{"type":"p","text":"Certifications are secondary to legal competence, but useful areas include:"},{"type":"h","text":"Recommended learning"},{"type":"list","items":[{"text":"Real estate law"},{"text":"Property law"},{"text":"Contract drafting"},{"text":"Contract management"},{"text":"Construction law"},{"text":"Infrastructure law"},{"text":"Arbitration"},{"text":"Negotiation"},{"text":"Real estate finance"},{"tex