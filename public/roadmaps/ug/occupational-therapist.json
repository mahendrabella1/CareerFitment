"},{"text":"+"},{"text":"Assistive Devices"},{"text":"+"},{"text":"Patient Education"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"EHR"},{"text":"+"},{"text":"Tele-Rehabilitation"},{"text":"+"},{"text":"Wearables"},{"text":"+"},{"text":"VR/AR"},{"text":"+"},{"text":"Assistive Technology"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Communication"},{"text":"+"},{"text":"Documentation"},{"text":"+"},{"text":"Teamwork"},{"text":"+"},{"text":"Research"},{"text":"+"},{"text":"Evidence-Based Practice"}]}]},{"heading":"Target Profile by Graduation","kind":"other","blocks":[{"type":"p","text":"By graduation, the student should ideally demonstrate:"},{"type":"list","items":[{"text":"Strong anatomy and physiology knowledge"},{"text":"Strong occupational-therapy foundations"},{"text":"Functional assessment skills"},{"text":"Activity-analysis capability"},{"text":"ADL training skills"},{"text":"Neurological rehabilitation exposure"},{"text":"Orthopaedic rehabilitation exposure"},{"text":"Paediatric OT exposure"},{"text":"Mental-health OT exposure"},{"text":"Assistive-technology awareness"},{"text":"Clinical documentation skills"},{"text":"Patient and family communication"},{"text":"Outcome-measurement knowledge"},{"text":"Supervised clinical experience"},{"text":"One substantial OT research/project portfolio"}]},{"type":"h","text":"Ideal Portfolio"},{"type":"list","items":[{"text":"BOT"},{"text":"+"},{"text":"Clinical Rotations"},{"text":"+"},{"text":"Functional Assessment"},{"text":"+"},{"text":"Activity Analysis"},{"text":"+"},{"text":"Neuro + Ortho Exposure"},{"text":"+"},{"text":"Paediatric Exposure"},{"text":"+"},{"text":"Assistive Technology"},{"text":"+"},{"text":"Outcome Measurement"},{"text":"+"}]},{"type":"flow","items":["Clinical Internship","Occupational Therapist","Specialist OT","Senior / Lead OT","Rehabilitation Leadership"]},{"type":"h","text":"Best Overall Positioning"},{"type":"flow","items":["BOT","broad clini