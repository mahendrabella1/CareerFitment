vanced catalysts"},{"text":"Nanostructured hydrogen materials"},{"text":"Additive manufacturing of advanced materials"},{"text":"Autonomous laboratories"}]},{"type":"p","text":"One particularly strong future combination is:"},{"type":"flow","items":["Nanotechnology","Materials Science","AI/ML","Advanced Characterization."],"sep":"+"}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"list","items":[{"text":"Nanotechnology"},{"text":"+"},{"text":"Materials Science"},{"text":"+"},{"text":"Nanomaterial Synthesis"},{"text":"+"},{"text":"Material Characterization"},{"text":"+"},{"text":"Experimental Design"},{"text":"+"},{"text":"Scientific Data Analysis"},{"text":"+"},{"text":"Python"},{"text":"+"},{"text":"Microscopy / Image Analysis"},{"text":"+"},{"text":"Research Methodology"},{"text":"+"},{"text":"Scientific Writing"},{"text":"+"},{"text":"Laboratory Safety"},{"text":"+"}]},{"type":"flow","items":["Specialization","R&D ENGINEER"]},{"type":"p","text":"For a more future-oriented profile:"},{"type":"list","items":[{"text":"Nanotechnology"},{"text":"+"},{"text":"Advanced Materials"},{"text":"+"},{"text":"Characterization"},{"text":"+"},{"text":"Python / ML"},{"text":"+"},{"text":"Materials Informatics"},{"text":"+"}]},{"type":"flow","items":["Experimental Research","AI-Enabled Materials R&D Engineer"]}]},{"heading":"Target Profile by Graduation","kind":"other","blocks":[{"type":"p","text":"By graduation, the student should be able to execute a basic research project independently under appropriate laboratory supervision:"},{"type":"flow","items":["Research Problem","Literature Review","Research Gap","Hypothesis","Experimental Design","Material Synthesis","Characterization","Data Analysis","Performance Evaluation","Optimization","Technical Report","Prototype / Research Output"]},{"type":"h","text":"Minimum portfolio"},{"type":"p","text":"The student should ideally have:"},{"type":"h","text":"2 research-oriented projects"},{"type":"h","text":"