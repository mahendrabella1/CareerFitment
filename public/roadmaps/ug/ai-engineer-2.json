[{"text":"Prompt design"},{"text":"Structured outputs"},{"text":"Tool calling"},{"text":"Function calling"},{"text":"Retrieval-Augmented Generation"},{"text":"Evaluation"},{"text":"Guardrails"}]}]},{"heading":"RAG Systems","kind":"other","blocks":[{"type":"p","text":"Understand the architecture:"},{"type":"flow","items":["Documents","Chunking","Embeddings","Vector Database","Retriever","Relevant Context","LLM","Response"]},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Embedding models"},{"text":"Vector search"},{"text":"Metadata filtering"},{"text":"Hybrid search"},{"text":"Reranking"},{"text":"Retrieval evaluation"},{"text":"Hallucination analysis"}]},{"type":"p","text":"Potential technologies include:"},{"type":"list","items":[{"text":"FAISS"},{"text":"pgvector"},{"text":"Pinecone"},{"text":"Weaviate"},{"text":"Milvus"},{"text":"The specific vector database matters less than understanding retrieval architecture and evaluation."}]}]},{"heading":"AI Agents","kind":"other","blocks":[{"type":"p","text":"Learn the architecture behind modern AI agents:"},{"type":"flow","items":["User","LLM","Planning / Reasoning","Tools","APIs / Databases / Search","Observation","Next Action","Final Response"]},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Tool calling"},{"text":"Agent loops"},{"text":"State management"},{"text":"Memory"},{"text":"Workflow orchestration"},{"text":"Human-in-the-loop"},{"text":"Failure handling"},{"text":"Avoid building agents simply because they are fashionable; use them where multi-step tool interaction genuinely provides value."}]}]},{"heading":"Year 3–4 — MLOps","kind":"other","blocks":[{"type":"p","text":"A major difference between an ML student and an AI Engineer is the ability to deploy and maintain models."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Model serving"},{"text":"Model versioning"},{"text":"Data versioning"},{"text":"Experiment tracking"},{"text":"CI/CD"},{"text":"Monitoring"},{"t