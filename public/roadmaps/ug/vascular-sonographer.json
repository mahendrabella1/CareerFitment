":"Images"},{"type":"h","text":"Doppler waveforms"},{"type":"h","text":"Velocity measurements"},{"type":"h","text":"Relevant observations"},{"type":"h","text":"Technical limitations"},{"type":"h","text":"Urgent findings and communication where required"}]},{"heading":"Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Skill","Beginner","Intermediate","Advanced"],"rows":[[{"text":"Anatomy"},{"text":"✓"}],[{"text":"Vascular anatomy"},{"text":"✓"}],[{"text":"Ultrasound physics"},{"text":"✓"},{"text":"Advanced"}],[{"text":"B-mode"},{"text":"Basic"},{"text":"✓"},{"text":"Advanced"}],[{"text":"Colour Doppler"},{"text":"Basic"},{"text":"✓"},{"text":"Advanced"}],[{"text":"Spectral Doppler"},{"text":"Basic"},{"text":"✓"},{"text":"Advanced"}],[{"text":"Carotid studies"},{"text":"Basic"},{"text":"✓"},{"text":"Advanced"}],[{"text":"Venous studies"},{"text":"Basic"},{"text":"✓"},{"text":"Advanced"}],[{"text":"Arterial studies"},{"text":"Basic"},{"text":"✓"},{"text":"Advanced"}],[{"text":"DVT examination"},{"text":"Basic"},{"text":"✓"},{"text":"Advanced"}],[{"text":"Abdominal vascular studies"},{"text":"Basic"},{"text":"✓"},{"text":"Advanced"}],[{"text":"Image optimization"},{"text":"Basic"},{"text":"✓"},{"text":"Advanced"}],[{"text":"Documentation"},{"text":"✓"}],[{"text":"Patient communication"},{"text":"✓"}]]}]},{"heading":"Technology Skills","kind":"other","blocks":[{"type":"h","text":"Essential"},{"type":"h","text":"Ultrasound systems"},{"type":"h","text":"PACS"},{"type":"h","text":"DICOM"},{"type":"h","text":"Electronic medical records"},{"type":"h","text":"Digital reporting systems"},{"type":"h","text":"Intermediate"},{"type":"h","text":"Advanced Doppler systems"},{"type":"h","text":"Image archiving"},{"type":"h","text":"Vascular measurement software"},{"type":"h","text":"Structured reporting"},{"type":"h","text":"Advanced"},{"type":"h","text":"3D/4D ultrasound"},{"type":"h","text":"Contrast-enhanced ultrasound concepts"},{"type":"h","text":"Automated vessel