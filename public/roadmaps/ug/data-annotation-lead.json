"}],[{"text":"🇮🇪 Ireland"},{"text":"AI/data and technology"}],[{"text":"🇦🇺 Australia"},{"text":"AI and data science"}],[{"text":"🇸🇬 Singapore"},{"text":"AI, fintech and data operations"}]]},{"type":"h","text":"Useful master's areas"},{"type":"list","items":[{"text":"Artificial Intelligence"},{"text":"Machine Learning"},{"text":"Data Science"},{"text":"Computer Vision"},{"text":"Natural Language Processing"},{"text":"Data Engineering"},{"text":"Human-Centred AI"},{"text":"AI Governance"},{"text":"Business Analytics"}]}]},{"heading":"Career progression","kind":"growth","blocks":[{"type":"h","text":"Data-operations route"},{"type":"h","text":"BCA AI/ML"},{"type":"h","text":"Data Annotation Intern"},{"type":"h","text":"Data Annotation Specialist"},{"type":"h","text":"Senior Annotator"},{"type":"h","text":"Annotation QA Specialist"},{"type":"h","text":"Data Annotation Lead"},{"type":"h","text":"Data Operations Manager"},{"type":"h","text":"AI Data Operations Director"},{"type":"h","text":"Technical route"},{"type":"h","text":"Annotation Specialist"},{"type":"flow","items":["Data Quality Analyst","ML Data Analyst","Data Engineer / ML Data Engineer","MLOps Engineer","AI Data Platform Lead"]},{"type":"h","text":"AI-evaluation route"},{"type":"h","text":"Annotation Specialist"},{"type":"flow","items":["AI Evaluation Specialist","Senior AI Evaluator","Evaluation Lead","AI Evaluation Manager","AI Quality/Governance Lead"]},{"type":"note","label":"Emerging specialisations","text":"2030–2040"},{"type":"h","text":"1. LLM Data Evaluation"},{"type":"p","text":"The industry increasingly needs people to evaluate:"},{"type":"list","items":[{"text":"Factuality"},{"text":"Helpfulness"},{"text":"Relevance"},{"text":"Reasoning quality"},{"text":"Instruction following"},{"text":"Safety"},{"text":"Hallucination"},{"text":"Preference ranking"}]},{"type":"p","text":"This expands the traditional concept of \"annotation\" into AI evaluation."},{"type":"h","text":"2. Human-in-the-loop AI"},{"typ