cts"}]},{"type":"h","text":"Year 3 — Microfabrication"},{"type":"h","text":"Cleanroom Fundamentals"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Cleanroom classifications"},{"text":"Contamination control"},{"text":"Wafer handling"},{"text":"Chemical safety"},{"text":"Process discipline"},{"text":"Personal protective equipment"}]},{"type":"p","text":"Cleanroom processing is highly sensitive to particles and contamination."},{"type":"h","text":"Wafer Processing"},{"type":"p","text":"Learn the general process flow:"},{"type":"flow","items":["Silicon Wafer","Cleaning","Oxidation / Deposition","Photoresist Coating","Lithography","Etching","Doping","Deposition","Metallization","Inspection","Packaging"]},{"type":"p","text":"Actual process sequences vary significantly by device and technology."},{"type":"h","text":"Photolithography"},{"type":"p","text":"Master the basic concepts:"},{"type":"list","items":[{"text":"Wafer cleaning"},{"text":"Resist coating"},{"text":"Spin coating"},{"text":"Soft bake"},{"text":"Mask alignment"},{"text":"Exposure"},{"text":"Development"},{"text":"Hard bake"},{"text":"Pattern inspection"}]},{"type":"p","text":"Understand:"},{"type":"flow","items":["Mask","Exposure","Photoresist","Pattern","Etching / Deposition","Device Structure"]},{"type":"h","text":"Advanced Lithography"},{"type":"p","text":"Build awareness of:"},{"type":"list","items":[{"text":"Electron-beam lithography"},{"text":"Nanoimprint lithography"},{"text":"EUV lithography"},{"text":"Deep-UV lithography"}]},{"type":"p","text":"Understand the trade-offs involving:"},{"type":"list","items":[{"text":"Resolution"},{"text":"Throughput"},{"text":"Cost"},{"text":"Process complexity"}]},{"type":"h","text":"Etching"},{"type":"p","text":"Study:"},{"type":"h","text":"Wet Etching"},{"type":"list","items":[{"text":"Chemical etching"},{"text":"Selectivity"},{"text":"Isotropic behavior"}]},{"type":"h","text":"Dry Etching"},{"type":"list","items":[{"text":"Plasma etching"},{"t