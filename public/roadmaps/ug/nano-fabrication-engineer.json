":[{"text":"Wafer fabrication"},{"text":"Lithography"},{"text":"Etching"},{"text":"Deposition"},{"text":"Doping"}]},{"type":"h","text":"Characterization"},{"type":"list","items":[{"text":"SEM"},{"text":"AFM"},{"text":"XRD"},{"text":"Raman"},{"text":"Ellipsometry"},{"text":"Electrical characterization"}]},{"type":"h","text":"Software"},{"type":"list","items":[{"text":"Python"},{"text":"MATLAB"},{"text":"TCAD"},{"text":"COMSOL"}]},{"type":"h","text":"Manufacturing"},{"type":"list","items":[{"text":"SPC"},{"text":"DOE"},{"text":"Yield analysis"},{"text":"Root-cause analysis"},{"text":"Statistical quality control"}]},{"type":"h","text":"Safety"},{"type":"list","items":[{"text":"Cleanroom safety"},{"text":"Chemical handling"},{"text":"Vacuum systems"},{"text":"Plasma equipment safety"}]}]},{"heading":"PG Options","kind":"pg_india","blocks":[{"type":"p","text":"For advanced nano-fabrication roles, postgraduate education can be highly valuable."},{"type":"h","text":"Semiconductor"},{"type":"list","items":[{"text":"M.Tech Microelectronics"},{"text":"M.Tech VLSI"},{"text":"M.Tech Semiconductor Technology"},{"text":"M.Tech Nanoelectronics"}]},{"type":"h","text":"Nanotechnology"},{"type":"list","items":[{"text":"M.Tech Nanotechnology"},{"text":"M.Tech Nanoscience"},{"text":"M.Sc Nanotechnology"}]},{"type":"h","text":"Materials"},{"type":"list","items":[{"text":"M.Tech Materials Science"},{"text":"M.Tech Materials Engineering"},{"text":"M.Sc Materials Science"}]},{"type":"h","text":"Device / Physics"},{"type":"list","items":[{"text":"M.Tech Semiconductor Devices"},{"text":"M.Sc Solid-State Physics"},{"text":"M.Sc Applied Physics"}]},{"type":"h","text":"Advanced Research"},{"type":"list","items":[{"text":"M.S. / PhD in Nanoelectronics"},{"text":"PhD in Semiconductor Devices"},{"text":"PhD in Nanotechnology"},{"text":"PhD in Materials Science"}]},{"type":"h","text":"Career Specializations"},{"type":"h","text":"1. Lithography Engineer"},{"type":"p","text":"Focus:"},{"type":"list",