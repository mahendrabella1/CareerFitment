:"Polymer blends"},{"text":"Additives"}]},{"type":"h","text":"Processing"},{"type":"list","items":[{"text":"Injection moulding"},{"text":"Extrusion"},{"text":"Blow moulding"},{"text":"Compression moulding"},{"text":"Thermoforming"},{"text":"Compounding"},{"text":"Film processing"}]},{"type":"h","text":"Characterisation"},{"type":"p","text":"Understand the purpose and interpretation of:"},{"type":"list","items":[{"text":"DSC"},{"text":"TGA"},{"text":"FTIR"},{"text":"XRD"},{"text":"SEM"},{"text":"Tensile testing"},{"text":"Impact testing"},{"text":"Hardness"},{"text":"Rheometry"},{"text":"Melt-flow testing"}]},{"type":"h","text":"Engineering"},{"type":"list","items":[{"text":"CAD"},{"text":"Mould/die fundamentals"},{"text":"Process optimisation"},{"text":"SPC"},{"text":"DOE"},{"text":"FMEA"},{"text":"Root-cause analysis"},{"text":"Six Sigma"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Excel"},{"text":"Python"},{"text":"MATLAB"},{"text":"Data analysis"},{"text":"Statistical modelling"},{"text":"Basic AI/ML"},{"text":"Computer-aided engineering"}]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Prioritise manufacturing and laboratory exposure over generic internships."},{"type":"h","text":"Best internship areas"},{"type":"list","items":[{"text":"Polymer processing"},{"text":"Plastics manufacturing"},{"text":"Injection moulding"},{"text":"Extrusion"},{"text":"Polymer testing"},{"text":"Polymer R&D"},{"text":"Compounding"},{"text":"Rubber technology"},{"text":"Automotive plastics"},{"text":"Packaging"},{"text":"Recycling"},{"text":"Materials characterisation"},{"text":"Quality engineering"}]},{"type":"h","text":"Organisations/industry sectors to target"},{"type":"list","items":[{"text":"Petrochemical companies"},{"text":"Polymer manufacturers"},{"text":"Plastics processors"},{"text":"Automotive component manufacturers"},{"text":"Tyre/rubber companies"},{"text":"Packaging companies"},{"text":"Paint/coating manufacturers"},{"text":"Composite manufacturers"},{"text":"Research laboratories"},{"text":"Universities and materials research centres"}]},{"type":"p","text":"During an internship, try to obtain experience with actual machines, materials, test equipment and production problems."}]},{"heading":"Certifications and learning","kind":"certifications","blocks":[{"type":"p","text":"Prioritise practical learning rather than collecting certificates."},{"type":"h","text":"High-value learning"},{"type":"list","items":[{"text":"Polymer science"},{"text":"Polymer processing"},{"text":"Materials characterisation"},{"text":"Injection moulding"},{"text":"Extrusion"},{"text":"Polymer composites"},{"text":"Industrial statistics"},{"text":"Six Sigma"},{"text":"Quality management"},{"text":"CAD"},{"text":"Python/MATLAB"}]},{"type":"p","text":"For academic courses, NPTEL can be useful for materials, chemical engineering, manufacturing and related subjects.","url":"https://nptel.ac.in/"}]},{"heading":"Careers you can be hired as","kind":"careers","blocks":[{"type":"p","text":"After B.Tech/B.E., possible roles include:"},{"type":"list","items":[{"text":"Polymer Engineer"},{"text":"Polymer Processing Engineer"},{"text":"Plastics Engineer"},{"text":"Polymer R&D Engineer"},{"text":"Materials Engineer"},{"text":"Materials Development Engineer"},{"text":"Process Engineer"},{"text":"Production Engineer"},{"text":"Injection Moulding Engineer"},{"text":"Extrusion Engineer"},{"text":"Compounding Engineer"},{"text":"Quality Engineer"},{"text":"Polymer Testing Engineer"},{"text":"Product Development Engineer"},{"text":"Composite Materials Engineer"},{"text":"Rubber Technology Engineer"},{"text":"Packaging Materials Engineer"},{"text":"Recycling Engineer"},{"text":"Application Development Engineer"},{"text":"Technical Service Engineer"},{"text":"Manufacturing Engineer"}]},{"type":"p","text":"With experience, progression can include:"},{"type":"flow","items":["Polymer Engineer","Senior Polymer Engineer","Technica