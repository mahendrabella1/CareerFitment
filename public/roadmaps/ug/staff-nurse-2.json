ing:"},{"type":"list","items":[{"text":"Patient identification"},{"text":"Medication safety"},{"text":"Hand hygiene"},{"text":"Fall prevention"},{"text":"Infection control"},{"text":"Documentation"}]},{"type":"p","text":"Create a report showing:"},{"type":"flow","items":["Finding","Risk","Corrective Action","Follow-up"]},{"type":"h","text":"Project 3 — Medication Safety Project"},{"type":"p","text":"Create a medication-administration checklist covering:"},{"type":"list","items":[{"text":"Correct patient"},{"text":"Correct medicine"},{"text":"Correct dose"},{"text":"Correct route"},{"text":"Correct timing"},{"text":"Allergy check"},{"text":"Documentation"},{"text":"Monitoring"}]},{"type":"h","text":"Project 4 — Community Health Assessment"},{"type":"p","text":"Conduct a structured survey of a non-identifiable population covering:"},{"type":"list","items":[{"text":"Nutrition"},{"text":"Hygiene"},{"text":"Immunization awareness"},{"text":"Lifestyle"},{"text":"Common health risks"},{"text":"Preventive healthcare"}]},{"type":"p","text":"Analyze the findings using Excel."},{"type":"h","text":"Project 5 — Emergency Nursing Simulation"},{"type":"p","text":"Create simulated cases involving:"},{"type":"list","items":[{"text":"Trauma"},{"text":"Cardiac emergency"},{"text":"Respiratory distress"},{"text":"Shock"},{"text":"Seizure"},{"text":"Severe allergic reaction"}]},{"type":"p","text":"Document:"},{"type":"flow","items":["Assessment","Prioritization","Immediate Intervention","Monitoring","Escalation","Documentation"]}]},{"heading":"Clinical Training Strategy","kind":"other","blocks":[{"type":"p","text":"Gain experience across:"},{"type":"h","text":"General Departments"},{"type":"list","items":[{"text":"General medicine"},{"text":"General surgery"},{"text":"Orthopedics"},{"text":"Emergency"},{"text":"ICU"},{"text":"Outpatient department"}]},{"type":"h","text":"Specialty Departments"},{"type":"list","items":[{"text":"Pediatrics"},{"text":"Obstetrics & gynecology"},{"text":"Psy