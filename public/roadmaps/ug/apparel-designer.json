dering"},{"text":"Front/back/side views"},{"text":"Technical flats"}]},{"type":"p","text":"Illustration should communicate the design accurately enough for development, not only look artistic."}]},{"heading":"Textile Knowledge","kind":"other","blocks":[{"type":"p","text":"Understand:"},{"type":"h","text":"Fibres"},{"type":"list","items":[{"text":"Cotton"},{"text":"Linen"},{"text":"Wool"},{"text":"Silk"},{"text":"Rayon/viscose"},{"text":"Polyester"},{"text":"Nylon"},{"text":"Acrylic"},{"text":"Elastane"},{"text":"Regenerated and recycled fibres"}]},{"type":"h","text":"Fabric Structures"},{"type":"list","items":[{"text":"Woven"},{"text":"Knitted"},{"text":"Non-woven"}]},{"type":"h","text":"Fabric Properties"},{"type":"p","text":"Evaluate:"},{"type":"list","items":[{"text":"Weight"},{"text":"Drape"},{"text":"Stretch"},{"text":"Recovery"},{"text":"Hand feel"},{"text":"Breathability"},{"text":"Durability"},{"text":"Shrinkage"},{"text":"Colourfastness"},{"text":"Moisture management"}]},{"type":"h","text":"Sustainable Textiles"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Organic fibres"},{"text":"Recycled fibres"},{"text":"Deadstock"},{"text":"Upcycling"},{"text":"Low-impact dyeing"},{"text":"Circular design"},{"text":"Textile waste reduction"},{"text":"Responsible sourcing"}]}]},{"heading":"Pattern Making & Draping","kind":"other","blocks":[{"type":"p","text":"Develop practical skills in:"},{"type":"list","items":[{"text":"Basic blocks"},{"text":"Bodice blocks"},{"text":"Sleeve blocks"},{"text":"Skirt blocks"},{"text":"Trouser blocks"},{"text":"Dart manipulation"},{"text":"Princess seams"},{"text":"Pleats"},{"text":"Gathers"},{"text":"Tucks"},{"text":"Panels"},{"text":"Collars"},{"text":"Cuffs"},{"text":"Pockets"},{"text":"Closures"},{"text":"Grading"}]},{"type":"h","text":"Draping"},{"type":"p","text":"Learn to develop garments directly on a dress form through:"},{"type":"flow","items":["Fabric","Draping","Pinning","Marking","Pattern Transfer","Prototy