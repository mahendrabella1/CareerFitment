ar"},{"text":"Luxury"},{"text":"Sportswear"},{"text":"Workwear"},{"text":"Occasionwear"},{"text":"Sustainable fashion"},{"text":"Digital fashion"}]},{"type":"h","text":"Trend Workflow"},{"type":"flow","items":["Research","Signals","Theme","Colour Palette","Materials","Silhouette","Design Direction","Collection"]},{"type":"p","text":"Do not simply copy existing runway designs."}]},{"heading":"Collection Development","kind":"other","blocks":[{"type":"p","text":"Learn to develop a coherent collection."},{"type":"p","text":"A collection should have:"},{"type":"list","items":[{"text":"Concept"},{"text":"Target consumer"},{"text":"Inspiration"},{"text":"Moodboard"},{"text":"Colour palette"},{"text":"Fabric direction"},{"text":"Silhouette direction"},{"text":"Design language"},{"text":"Range plan"},{"text":"Individual garment designs"},{"text":"Technical development"},{"text":"Sampling"},{"text":"Final presentation"}]},{"type":"h","text":"Portfolio Collection"},{"type":"p","text":"Build at least 2–3 complete collections, such as:"},{"type":"list","items":[{"text":"Contemporary casualwear"},{"text":"Sustainable/ethical apparel"},{"text":"Occasionwear, sportswear, streetwear or another specialization"}]}]},{"heading":"Apparel Technical Design","kind":"other","blocks":[{"type":"p","text":"Understand the technical side of fashion."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Tech packs"},{"text":"Size specifications"},{"text":"Measurement points"},{"text":"Tolerance"},{"text":"Construction sheets"},{"text":"BOM"},{"text":"Fabric consumption"},{"text":"Trim specifications"},{"text":"Label requirements"},{"text":"Packaging requirements"},{"text":"Sample comments"},{"text":"Fit comments"},{"text":"Revision control"}]},{"type":"h","text":"Fit Development"},{"type":"p","text":"Understand:"},{"type":"flow","items":["First Sample","Fit Trial","Measurements","Corrections","Revised Sample","Approval"]},{"type":"p","text":"Learn basic fitting across different body sha