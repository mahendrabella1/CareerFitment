:"RNA sequences"},{"text":"Sequence alignment"},{"text":"Gene annotation"},{"text":"Variant concepts"},{"text":"Phylogenetics"}]},{"type":"h","text":"Advanced"},{"type":"p","text":"Eventually explore:"},{"type":"list","items":[{"text":"Biopython"},{"text":"R/Bioconductor"},{"text":"Genome browsers"},{"text":"NGS pipelines"},{"text":"Variant analysis"},{"text":"Transcriptomics"}]},{"type":"p","text":"A genetics graduate with wet-lab + computational skills is considerably more versatile than one who knows only basic laboratory procedures."}]},{"heading":"Year 4 — Choose a Specialisation","kind":"other","blocks":[{"type":"table","header":["Specialisation","Focus"],"rows":[[{"text":"Molecular Biology"},{"text":"DNA/RNA analysis and laboratory research"}],[{"text":"Molecular Diagnostics"},{"text":"Genetic and pathogen testing"}],[{"text":"Genomics"},{"text":"Genome analysis and sequencing"}],[{"text":"Cancer Genetics"},{"text":"Molecular oncology research"}],[{"text":"Clinical Genetics"},{"text":"Genetic testing and interpretation support"}],[{"text":"Agricultural Genetics"},{"text":"Crop/animal genetics and breeding"}],[{"text":"Pharmaceutical R&D"},{"text":"Molecular assays and drug research"}],[{"text":"Biotechnology"},{"text":"Industrial and research biotechnology"}],[{"text":"Bioinformatics"},{"text":"Computational genomic analysis"}],[{"text":"Quality Control"},{"text":"Laboratory QA/QC and validation"}]]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Prioritise hands-on molecular laboratory exposure."},{"type":"h","text":"Target environments"},{"type":"list","items":[{"text":"Biotechnology companies"},{"text":"Molecular biology laboratories"},{"text":"Genetic testing laboratories"},{"text":"Pharmaceutical R&D"},{"text":"Biomedical research institutes"},{"text":"University research laboratories"},{"text":"Agricultural biotechnology laboratories"},{"text":"Clinical research organisations"},{"text":"Diagnostic laboratories"},{"text":"G