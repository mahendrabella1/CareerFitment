 concepts"},{"text":"Experiments"},{"text":"Inquiry-based learning"},{"text":"Demonstration"}]},{"type":"h","text":"Social Studies"},{"type":"list","items":[{"text":"History"},{"text":"Geography"},{"text":"Civics"},{"text":"Economics"},{"text":"Map-based learning"}]},{"type":"h","text":"Languages"},{"type":"list","items":[{"text":"Grammar"},{"text":"Reading"},{"text":"Writing"},{"text":"Speaking"},{"text":"Literature"},{"text":"Language acquisition"}]},{"type":"h","text":"Commerce"},{"type":"list","items":[{"text":"Accounting"},{"text":"Business studies"},{"text":"Economics"},{"text":"Financial concepts"}]},{"type":"h","text":"Year 3 — Digital Teaching & Assessment"},{"type":"p","text":"The student should become proficient in technology-enabled teaching."},{"type":"h","text":"Digital teaching"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Video conferencing"},{"text":"Digital whiteboards"},{"text":"Screen sharing"},{"text":"Presentation design"},{"text":"Digital worksheets"},{"text":"Online quizzes"},{"text":"Learning management systems"},{"text":"Educational videos"}]},{"type":"h","text":"Assessment"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Formative assessment"},{"text":"Summative assessment"},{"text":"Diagnostic assessment"},{"text":"Rubrics"},{"text":"Online quizzes"},{"text":"Assignment evaluation"},{"text":"Learning analytics"}]}]},{"heading":"Final Year — Teaching Practice & Online Tutoring","kind":"other","blocks":[{"type":"h","text":"Teaching practice"},{"type":"p","text":"Students should conduct:"},{"type":"list","items":[{"text":"Lesson demonstrations"},{"text":"Micro-teaching"},{"text":"Classroom teaching"},{"text":"Student assessments"},{"text":"Lesson reflections"}]},{"type":"h","text":"Online teaching practice"},{"type":"p","text":"Add:"},{"type":"list","items":[{"text":"Live online classes"},{"text":"Recorded lessons"},{"text":"Digital worksheets"},{"text":"Online tests"},{"text":"Student doubt-solving"},{"