ms":[{"text":"Mass casualties"},{"text":"Field triage"},{"text":"Emergency medical support"},{"text":"Temporary medical facilities"}]},{"type":"h","text":"2. Emergency Operations"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Incident command"},{"text":"Resource coordination"},{"text":"Communication"},{"text":"Emergency planning"}]},{"type":"h","text":"3. Humanitarian Response"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Refugee/displacement response"},{"text":"Medical camps"},{"text":"Public health"},{"text":"Relief operations"}]},{"type":"h","text":"4. Disaster Logistics"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Medical supplies"},{"text":"Transport"},{"text":"Equipment"},{"text":"Shelter"},{"text":"Resource distribution"}]},{"type":"h","text":"5. GIS & Disaster Technology"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Risk mapping"},{"text":"Evacuation planning"},{"text":"Emergency routing"},{"text":"Geospatial analytics"}]}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"Emergency/Field Path"},{"type":"flow","items":["Emergency & Trauma Technology Graduate","Disaster Response Assistant","Emergency Response Professional","Senior Field Response Professional","Disaster Response Coordinator","Emergency Operations Lead"]},{"type":"h","text":"Disaster Management Path"},{"type":"flow","items":["Emergency Care Technology","Field Response Experience","Master's in Disaster Management / Public Health","Disaster Management Officer","Emergency Programme Manager","Disaster Response Leadership"]},{"type":"h","text":"Humanitarian Path"},{"type":"flow","items":["Emergency Response","Field Humanitarian Experience","Humanitarian Response Officer","Emergency Programme Coordinator","Humanitarian Programme Manager","Regional Response Leadership"]},{"type":"h","text":"Emerging Technologies"},{"type":"p","text":"Disaster response is increasingly adopting:"},{"type":"li