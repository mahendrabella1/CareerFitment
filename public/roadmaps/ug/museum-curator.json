{"title":"Museum Curator Roadmap","role":"Museum Curator","summary":"","facts":{"Current degree":"BA (General / Honours) — History"},"about":[],"intro":[],"horizons":[],"sections":[{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Stage","Typical Roles"],"rows":[[{"text":"Entry"},{"text":"Museum Intern, Collections Assistant, Research Assistant"}],[{"text":"Early Career"},{"text":"Museum Assistant, Curatorial Assistant, Documentation Officer"}],[{"text":"Mid Career"},{"text":"Assistant Curator, Curator, Exhibition Coordinator"}],[{"text":"Senior"},{"text":"Senior Curator, Collections Manager"}],[{"text":"Leadership"},{"text":"Chief Curator, Museum Director, Head of Collections"}]]}]},{"heading":"What to Build Each Year","kind":"build","blocks":[{"type":"h","text":"Year 1 — History & Heritage Foundation"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Ancient Indian History"},{"text":"Medieval Indian History"},{"text":"Modern Indian History"},{"text":"World History"},{"text":"Cultural History"},{"text":"Art & Architecture"},{"text":"Heritage Studies"},{"text":"Historical Research Methods"}]},{"type":"p","text":"Build:"},{"type":"list","items":[{"text":"Academic writing"},{"text":"Research skills"},{"text":"Archival reading"},{"text":"Presentation skills"},{"text":"Digital documentation"},{"text":"Basic photography"}]},{"type":"note","label":"Project","text":"Create a digital catalogue of 20 historically significant objects, monuments, photographs, or archival materials."},{"type":"h","text":"Year 2 — Collections & Museum Studies"},{"type":"p","text":"Learn:"},{"type":"h","text":"Museum Fundamentals"},{"type":"list","items":[{"text":"Museum history"},{"text":"Museum types"},{"text":"Collection management"},{"text":"Object documentation"},{"text":"Accessioning"},{"text":"Cataloguing"},{"text":"Storage"},{"text":"Object handling"}]},{"type":"h","text":"Research"},{"type":"list","items":[{"text":"Primary sources"},{"text":