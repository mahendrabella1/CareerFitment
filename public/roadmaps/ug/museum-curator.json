text":"Assign unique accession numbers."},{"text":"Photograph each object."},{"text":"Record dimensions and materials."},{"text":"Establish preliminary dates and origins."},{"text":"Research provenance."},{"text":"Identify ownership or legal documentation."},{"text":"Assess condition with conservation specialists."},{"text":"Enter information into the collection database."},{"text":"Identify objects requiring further research."},{"text":"Develop a preliminary interpretation plan."},{"text":"Store objects appropriately."},{"text":"Maintain a clear audit trail."}]},{"type":"h","text":"Government / Public-Sector Route"},{"type":"p","text":"Potential opportunities may exist in:"},{"type":"list","items":[{"text":"Government museums"},{"text":"State museums"},{"text":"National museums"},{"text":"Archaeological institutions"},{"text":"Archives"},{"text":"Libraries"},{"text":"Cultural departments"},{"text":"Heritage organisations"},{"text":"Universities"},{"text":"Government-funded cultural institutions"}]},{"type":"p","text":"Relevant work areas include:"},{"type":"list","items":[{"text":"Museum administration"},{"text":"Collection management"},{"text":"Curatorial research"},{"text":"Heritage preservation"},{"text":"Exhibition development"},{"text":"Documentation"}]},{"type":"p","text":"Government recruitment may specify particular qualifications such as MA, Museology, Archaeology, History, Art History, or relevant professional experience, depending on the post."}]},{"heading":"Postgraduate Study in India","kind":"pg_india","blocks":[{"type":"p","text":"For a long-term professional curator career, postgraduate study is strongly recommended."},{"type":"h","text":"Strong Options"},{"type":"h","text":"MA / Master's"},{"type":"list","items":[{"text":"MA History"},{"text":"MA Museology"},{"text":"MA Archaeology"},{"text":"MA Art History"},{"text":"MA Heritage Management"},{"text":"MA Ancient Indian History & Archaeology"},{"text":"MA Cultural Studies"},{"text":"Master's in Conservation"},{"text":"Master's in Museum Studies"}]},{"type":"h","text":"Ideal Pathways"},{"type":"h","text":"History Route"},{"type":"flow","items":["BA History","MA History","Museum/heritage internship","Curatorial Research","Curator"]},{"type":"h","text":"Museology Route"},{"type":"flow","items":["BA History","MA Museology / Museum Studies","Museum Internship","Curatorial Assistant","Curator"]},{"type":"p","text":"For major museums, combining historical expertise with formal museology training can be particularly valuable."}]},{"heading":"Study Abroad","kind":"abroad","blocks":[{"type":"p","text":"Potential destinations:"},{"type":"table","header":["Country","Relevant Areas"],"rows":[[{"text":"UK"},{"text":"Museology, Heritage, Museum Studies"}],[{"text":"USA"},{"text":"Museum Studies, Public History"}],[{"text":"Canada"},{"text":"Museum Studies, Heritage"}],[{"text":"Australia"},{"text":"Museum & Heritage Studies"}],[{"text":"France"},{"text":"Art History, Museum Studies"}],[{"text":"Italy"},{"text":"Cultural Heritage, Conservation"}],[{"text":"Germany"},{"text":"Museology, Heritage"}],[{"text":"Netherlands"},{"text":"Museum Studies, Cultural Heritage"}],[{"text":"Switzerland"},{"text":"Museum & Heritage Management"}],[{"text":"Spain"},{"text":"Heritage & Museum Studies"}]]},{"type":"p","text":"Useful master's programmes:"},{"type":"list","items":[{"text":"Museum Studies"},{"text":"Museology"},{"text":"Curatorial Studies"},{"text":"Public History"},{"text":"Heritage Management"},{"text":"Cultural Heritage"},{"text":"Art History"},{"text":"Digital Heritage"}]}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"p","text":"Typical pathway:"},{"type":"flow","items":["BA History","Museum/Heritage Intern","Collections/Research Assistant","Curatorial Assistant","Assistant Curator","Curator","Senior Curator","Chief Curator / Head of Collections","Museum Director"]},{"type":"p","text":"Alternative heritage pathway:"},{"type":"flow","items":["BA History","