endor coordination"},{"text":"Volunteer management"},{"text":"Partner coordination"},{"text":"Stakeholder mapping"},{"text":"Risk management"},{"text":"Documentation"},{"text":"Donor reporting"}]},{"type":"h","text":"Monitoring & Evaluation"},{"type":"p","text":"This is one of the highest-value skill areas for NGO careers."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Theory of Change"},{"text":"Logical Framework / Logframe"},{"text":"Inputs"},{"text":"Activities"},{"text":"Outputs"},{"text":"Outcomes"},{"text":"Impact"},{"text":"Indicators"},{"text":"Baselines"},{"text":"Targets"},{"text":"Data collection"},{"text":"Surveys"},{"text":"Interviews"},{"text":"Focus groups"},{"text":"Impact evaluation"},{"text":"Monitoring dashboards"}]},{"type":"h","text":"Example"},{"type":"note","label":"Programme","text":"Restore degraded community wetlands"},{"type":"flow","items":["Funding","field team","equipment"],"sep":"+","label":"Input"},{"type":"note","label":"Activity","text":"Wetland restoration + community training"},{"type":"note","label":"Output","text":"10 hectares restored"},{"type":"note","label":"Outcome","text":"Improved wetland health and community participation"},{"type":"note","label":"Impact","text":"Improved biodiversity and ecosystem resilience"},{"type":"h","text":"Data skills"},{"type":"p","text":"Build:"},{"type":"list","items":[{"text":"Excel"},{"text":"Power BI"},{"text":"Basic statistics"},{"text":"Survey analysis"},{"text":"Data cleaning"},{"text":"Data visualization"},{"text":"GIS"},{"text":"Basic SQL"},{"text":"Basic Python/R"}]},{"type":"p","text":"Microsoft Excel","url":"https://www.microsoft.com/microsoft-365/excel"},{"type":"p","text":"Microsoft Power BI","url":"https://www.microsoft.com/power-platform/products/power-bi"},{"type":"h","text":"GIS"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"QGIS"},{"text":"Spatial data"},{"text":"Land-use mapping"},{"text":"Habitat mapping"},{"text":"Watershed mapping"},{"text