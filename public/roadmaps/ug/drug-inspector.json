:"certifications","blocks":[{"type":"p","text":"Useful complementary learning areas include:"},{"type":"h","text":"Regulatory"},{"type":"h","text":"Regulatory Affairs"},{"type":"h","text":"Pharmaceutical Jurisprudence"},{"type":"h","text":"Drug regulatory systems"},{"type":"h","text":"Regulatory compliance"},{"type":"h","text":"Quality"},{"type":"h","text":"GMP"},{"type":"h","text":"GLP"},{"type":"h","text":"GCP"},{"type":"h","text":"Quality Management Systems"},{"type":"h","text":"CAPA"},{"type":"h","text":"Validation"},{"type":"h","text":"Risk Management"},{"type":"h","text":"Safety"},{"type":"h","text":"Pharmacovigilance"},{"type":"h","text":"Adverse Drug Reaction reporting"},{"type":"h","text":"Medication safety"},{"type":"h","text":"Analytics"},{"type":"h","text":"Excel"},{"type":"h","text":"Power BI"},{"type":"h","text":"SQL"},{"type":"h","text":"Basic statistics"},{"type":"h","text":"Research"},{"type":"h","text":"Research methodology"},{"type":"h","text":"Scientific writing"},{"type":"h","text":"Evidence-based medicine"},{"type":"h","text":"Clinical research"},{"type":"p","text":"Certifications are supplementary. They do not substitute for statutory eligibility or professional requirements for a Drug Inspector post."}]},{"heading":"PG Options","kind":"pg_india","blocks":[{"type":"p","text":"A B.Pharm graduate interested in regulatory careers can consider:"},{"type":"h","text":"M.Pharm"},{"type":"h","text":"Relevant specialisations may include:"},{"type":"h","text":"Pharmaceutics"},{"type":"h","text":"Pharmaceutical Analysis"},{"type":"h","text":"Pharmaceutical Chemistry"},{"type":"h","text":"Pharmacology"},{"type":"h","text":"Quality Assurance"},{"type":"h","text":"Regulatory-related areas where available"},{"type":"h","text":"Regulatory Affairs"},{"type":"h","text":"Pharmaceutical Regulatory Affairs"},{"type":"h","text":"Regulatory Science"},{"type":"h","text":"Drug Regulatory Affairs"},{"type":"h","text":"Other Options"},{"type":"h","text":"MSc Clinical Re