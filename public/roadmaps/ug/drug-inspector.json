":"h","text":"Meet Applicable Eligibility"},{"type":"h","text":"Professional Registration /"},{"type":"h","text":"Other Required Conditions"},{"type":"h","text":"Relevant Experience Where Required"},{"type":"h","text":"Government Recruitment"},{"type":"h","text":"Selection Process"},{"type":"h","text":"Drug Inspector"},{"type":"h","text":"Senior Regulatory Responsibilities"},{"type":"h","text":"Drug Control / Regulatory Administration"},{"type":"h","text":"Government roles can involve:"},{"type":"h","text":"Pharmacy inspections"},{"type":"h","text":"Wholesale inspections"},{"type":"h","text":"Manufacturing inspections"},{"type":"h","text":"Sampling"},{"type":"h","text":"Regulatory investigations"},{"type":"h","text":"Licensing-related activities"},{"type":"h","text":"Drug-quality monitoring"},{"type":"h","text":"Public-health protection"},{"type":"p","text":"The exact route varies by recruitment authority and current statutory rules."}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"h","text":"0–2 Years"},{"type":"h","text":"B.Pharm graduate"},{"type":"h","text":"QA/QC trainee"},{"type":"h","text":"Regulatory affairs trainee"},{"type":"h","text":"Pharmacovigilance associate"},{"type":"h","text":"Pharmaceutical analyst"},{"type":"h","text":"2–5 Years"},{"type":"h","text":"Regulatory affairs associate"},{"type":"h","text":"QA executive"},{"type":"h","text":"QC analyst"},{"type":"h","text":"Pharmacovigilance professional"},{"type":"h","text":"Regulatory compliance professional"},{"type":"h","text":"5–10 Years"},{"type":"h","text":"Drug Inspector, where recruited and eligible"},{"type":"h","text":"Senior Regulatory Affairs professional"},{"type":"h","text":"Quality Manager"},{"type":"h","text":"Regulatory Compliance Manager"},{"type":"h","text":"Pharmacovigilance Manager"},{"type":"h","text":"10+ Years"},{"type":"h","text":"Potential progression into:"},{"type":"h","text":"Senior regulatory administration"},{"type":"h","text":"Drug-control leadership"},{"type":"h","text":"Regulatory strategy"},{"type":"h","text":"Pharmaceutical quality leadership"},{"type":"h","text":"Regulatory consulting"},{"type":"h","text":"Policy and compliance roles"}]},{"heading":"Target Profile at Graduation","kind":"other","blocks":[{"type":"p","text":"A strong B.Pharm student targeting Drug Inspector/regulatory careers should ideally have:"},{"type":"h","text":"Pharmaceutical Knowledge"},{"type":"h","text":"Pharmaceutics"},{"type":"h","text":"Pharmacology"},{"type":"h","text":"Medicinal chemistry"},{"type":"h","text":"Pharmaceutical analysis"},{"type":"h","text":"Microbiology"},{"type":"h","text":"Pharmacognosy"},{"type":"h","text":"Regulatory Knowledge"},{"type":"h","text":"Pharmaceutical jurisprudence"},{"type":"h","text":"Drug regulation"},{"type":"h","text":"GMP"},{"type":"h","text":"Licensing concepts"},{"type":"h","text":"Labeling"},{"type":"h","text":"Storage requirements"},{"type":"h","text":"Quality standards"},{"type":"h","text":"Quality Skills"},{"type":"h","text":"QA"},{"type":"h","text":"QC"},{"type":"h","text":"CAPA"},{"type":"h","text":"Validation"},{"type":"h","text":"Documentation"},{"type":"h","text":"Risk management"},{"type":"h","text":"Inspection Skills"},{"type":"h","text":"Audit checklist preparation"},{"type":"h","text":"Evidence collection"},{"type":"h","text":"Document review"},{"type":"h","text":"Sampling principles"},{"type":"h","text":"Inspection reporting"},{"type":"h","text":"Digital Skills"},{"type":"h","text":"Excel"},{"type":"h","text":"Power BI"},{"type":"h","text":"Digital records"},{"type":"h","text":"Basic SQL"},{"type":"h","text":"Regulatory databases"}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"h","text":"B.Pharm"},{"type":"h","text":"+"},{"type":"h","text":"Pharmaceutical Sciences"},{"type":"h","text":"+"},{"type":"h","text":"Pharmaceutical Jurisprudence"},{"type":"h","text":"+"},{"type":"h","text":"GMP / QA / QC"},{"type":"h","text":"+"},{"type":"h","text":"Drug Regulatory Knowledge"},{"type":"h","text":"+"},{"type":"h","text":"Inspection & Audit Skills"},{"type":"h","text":"+"},{"type":"h","text":"Sampling & Documentation"},{"type":"h","text":"+"},{"type":"h","text":"Analytical Science"},{"type":"h","text":"+"},{"type":"h","text":"Pharmacovigilance"},{"type":"h","text":"+"},{"type":"h","text":"Regulatory Data Analytics"},{"type":"h","text":"+"},{"type":"h","text":"Professional Ethics"},{"type":"h","text":"DRUG INSPECTOR"}]},{"heading":"Best Overall Positioning","kind":"other","blocks":[{"type":"p","text":"The strongest profile for a future Drug Inspector is:"},{"type":"flow","items":["B.Pharm","Pharmaceutical Jurisprudence","GMP/Quality Assurance","Regulatory Knowledge","Inspection & Documentation","Analytical Science","Public-Health Orientation","Digital Regulatory Skills"],"sep":"+"},{"type":"p","text":"The key distinction is that the Drug Inspector is not simply a pharmacist or laboratory analyst. The role sits at the intersection of pharmaceutical science, law/regulation, quality systems, investigation, and public-health protection."},{"type":"note","label":"Regulatory note","text":"For an actual Drug Inspector position in India, students should verify the latest applicable statutory qualification, professional registration, experience requirements, age limits, recruitment authority and examination/selection process in the specific official notification. These requirements can change and may differ between recruiting authorities."}]}]}