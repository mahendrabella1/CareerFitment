","blocks":[{"type":"flow","items":["Class 12","5-Year Integrated Law Degree","International Law + Public International Law","Human Rights / Humanitarian / Development Internship","Research / NGO / Policy Experience","LL.M. / Master's Specialization","International Organization Internship / Fellowship","Junior / Associate Professional Role","International Organization Professional","Legal / Policy / Programme Specialist","Senior International Affairs Professional","Programme / Legal / Policy Leadership"]},{"type":"p","text":"A second pathway can be:"},{"type":"flow","items":["Law Degree","International NGO / Think Tank","Research / Policy Analyst","International Organization","Programme / Legal Specialist"]}]},{"heading":"What You Learn During UG","kind":"build","blocks":[{"type":"h","text":"Year 1 — Legal Foundations"},{"type":"p","text":"Build a strong foundation in:"},{"type":"h","text":"Core Law"},{"type":"list","items":[{"text":"Legal methods"},{"text":"Legal reasoning"},{"text":"Constitutional law"},{"text":"Contract law"},{"text":"Law of torts"},{"text":"Legal research"},{"text":"Legal writing"}]},{"type":"h","text":"International Awareness"},{"type":"p","text":"Start following:"},{"type":"list","items":[{"text":"International institutions"},{"text":"Global conflicts"},{"text":"International agreements"},{"text":"International trade"},{"text":"Global development"},{"text":"Human-rights developments"}]},{"type":"h","text":"Year 2 — Public International Law"},{"type":"p","text":"Develop strong knowledge of:"},{"type":"list","items":[{"text":"Sources of international law"},{"text":"Treaties"},{"text":"Customary international law"},{"text":"General principles"},{"text":"International organizations"},{"text":"State responsibility"},{"text":"State sovereignty"},{"text":"Jurisdiction"},{"text":"Diplomatic relations"},{"text":"Immunities"},{"text":"International dispute resolution"}]},{"type":"h","text":"Key Concepts"},{"type":"p","text":"Understand:"},{"type":"flow"