otive"},{"type":"p","text":"Look for:"},{"type":"list","items":[{"text":"Automotive electronics"},{"text":"ADAS"},{"text":"Vehicle controls"},{"text":"ECU development"},{"text":"Sensors"},{"text":"Actuators"},{"text":"Testing and validation"}]},{"type":"h","text":"Government/research"},{"type":"p","text":"Potential organisations include:"},{"type":"list","items":[{"text":"DRDO"},{"text":"ISRO"},{"text":"CSIR laboratories"},{"text":"BHEL"},{"text":"BEL"},{"text":"HAL"},{"text":"Government manufacturing/research organisations"}]},{"type":"p","text":"Eligibility, availability and stipend vary by organisation and intake."},{"type":"p","text":"DRDO\nISRO\nBHEL\nBEL\nHAL","url":"https://www.drdo.gov.in/"}]},{"heading":"Certifications and learning","kind":"certifications","blocks":[{"type":"table","header":["Certification / learning","Why it matters"],"rows":[[{"text":"PLC programming"},{"text":"Essential for industrial automation"}],[{"text":"Siemens TIA Portal training"},{"text":"Useful for Siemens-based automation environments"}],[{"text":"Rockwell Automation training"},{"text":"Useful for Allen-Bradley environments"}],[{"text":"MATLAB/Simulink"},{"text":"Control-system modelling and simulation"}],[{"text":"ROS/ROS 2"},{"text":"Robotics development"}],[{"text":"Industrial networking"},{"text":"Connects PLCs, drives, sensors and machines"}],[{"text":"Python/C++"},{"text":"Robotics, automation and data processing"}],[{"text":"Computer vision/OpenCV"},{"text":"Automated inspection"}],[{"text":"AWS/Azure IoT fundamentals"},{"text":"Industrial IoT/cloud systems"}],[{"text":"Functional safety training"},{"text":"Relevant to machinery and safety-critical systems"}]]},{"type":"p","text":"Siemens Learning\nMathWorks Training\nROS 2 Documentation\nNPTEL","url":"https://www.siemens.com/global/en/products/services/digital-enterprise-services/training-services.html"},{"type":"note","label":"Important","text":"Do not collect PLC/robotics certificates without practical projects. For t