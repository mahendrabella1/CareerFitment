"Matplotlib"},{"text":"scikit-learn"}]}]},{"heading":"Five Recommended UG Projects","kind":"other","blocks":[{"type":"h","text":"Project 1 — Statistical Process Control Dashboard"},{"type":"p","text":"Build an SPC dashboard using real or simulated industrial data."},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Mean"},{"text":"Standard deviation"},{"text":"Control limits"},{"text":"Cp/Cpk"},{"text":"Defect rates"},{"text":"Process trends"},{"text":"Use Excel + Power BI."}]},{"type":"h","text":"Project 2 — Paint Quality Prediction System"},{"type":"p","text":"Develop a model using:"},{"type":"list","items":[{"text":"Pigment concentration"},{"text":"Binder ratio"},{"text":"Solvent composition"},{"text":"Viscosity"},{"text":"Drying conditions"}]},{"type":"p","text":"Predict:"},{"type":"p","text":"Adhesion / gloss / hardness / overall quality."},{"type":"h","text":"Project 3 — Edible Oil Quality Monitoring"},{"type":"p","text":"Create a QC study tracking:"},{"type":"list","items":[{"text":"FFA"},{"text":"Peroxide value"},{"text":"Moisture"},{"text":"Colour"},{"text":"Oxidative stability"},{"text":"Analyse how processing/storage conditions influence quality."}]},{"type":"h","text":"Project 4 — Rubber Compound Optimization"},{"type":"p","text":"Study the effect of:"},{"type":"list","items":[{"text":"Carbon black"},{"text":"Sulfur"},{"text":"Accelerators"},{"text":"Plasticizers"},{"text":"Cure temperature/time"}]},{"type":"p","text":"on:"},{"type":"list","items":[{"text":"Tensile strength"},{"text":"Hardness"},{"text":"Elongation"},{"text":"Cure characteristics"},{"text":"Use DoE/ANOVA to identify an improved formulation."}]},{"type":"h","text":"Project 5 — AI-Based Industrial Defect Detection"},{"type":"p","text":"Develop a computer-vision system for detecting visible defects in:"},{"type":"list","items":[{"text":"Painted surfaces"},{"text":"Rubber products"},{"text":"Packaging"},{"text":"Sugar crystals"},{"text":"Manufactured components"}]},{"type":"p","t