ockchain Monitoring"},{"type":"p","text":"Create an IoT system where sensor readings are cryptographically verified and blockchain records provide tamper-evidence."},{"type":"h","text":"Project 3 — Decentralized Certificate Verification"},{"type":"p","text":"Universities issue verifiable certificates whose authenticity can be checked through a blockchain application."},{"type":"h","text":"Project 4 — Secure Document Verification"},{"type":"p","text":"Store document hashes on-chain and verify whether a document has been modified."},{"type":"h","text":"Project 5 — Decentralized Identity Prototype"},{"type":"p","text":"Develop a prototype for identity credentials using cryptographic signatures and decentralized identifiers."},{"type":"h","text":"Project 6 — Smart Contract Security Analyzer"},{"type":"p","text":"Build a tool that detects common Solidity vulnerabilities using static analysis."},{"type":"h","text":"Project 7 — Blockchain Analytics Dashboard"},{"type":"p","text":"Analyze:"},{"type":"list","items":[{"text":"Wallets"},{"text":"Transactions"},{"text":"Token transfers"},{"text":"Contract activity"},{"text":"Gas usage"}]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"h","text":"Year 1"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Software Development Intern"},{"text":"Web Development Intern"},{"text":"Python/JavaScript Intern"}]},{"type":"h","text":"Year 2"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Blockchain Intern"},{"text":"Web3 Developer Intern"},{"text":"Backend Developer Intern"},{"text":"Cybersecurity Intern"},{"text":"Smart Contract Intern"}]},{"type":"h","text":"Year 3"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Blockchain Developer Intern"},{"text":"Smart Contract Developer Intern"},{"text":"Web3 Engineer Intern"},{"text":"Blockchain Security Intern"},{"text":"Protocol Engineering Intern"}]},{"type":"h","text":"Year 4"},{"type":"p","text":"Target:"},{"type":"lis