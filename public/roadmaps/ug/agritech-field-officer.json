ension"}]},{"type":"p","text":"Entrance exams and tests to know:"},{"type":"list","items":[{"text":"ICAR AIEEA PG"},{"text":"IBPS AFO"}]}]},{"heading":"Study Abroad Options","kind":"abroad","blocks":[{"type":"list","items":[{"text":"Not usually needed"}]}]},{"heading":"Career Opportunities","kind":"careers","blocks":[{"type":"p","text":"Roles a AgriTech Field Officer can grow into or move across to:"},{"type":"list","items":[{"text":"Agri Marketing Officer"},{"text":"Precision Agriculture Specialist"},{"text":"Agronomist"},{"text":"Territory Sales Officer"}]}]},{"heading":"Recommended Career Progression","kind":"growth","blocks":[{"type":"flow","items":["Field Officer","Senior Field Officer","Cluster Manager","Regional Manager","Head of Field Operations"]}]}],"drafted":true}