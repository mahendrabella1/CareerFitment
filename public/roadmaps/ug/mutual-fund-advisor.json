 Intern"}],[{"text":"1–3 years"},{"text":"Operations / Distribution / Advisory Associate"}],[{"text":"3–6 years"},{"text":"Investment Advisor / Wealth Manager / Fund Analyst"}],[{"text":"5–8 years"},{"text":"Senior Wealth Manager / Investment Specialist"}],[{"text":"7–12 years"},{"text":"Portfolio/Wealth Management Manager"}],[{"text":"10–15 years"},{"text":"Investment Director / Wealth Management Head"}],[{"text":"15+ years"},{"text":"Senior Investment / Wealth Management Leadership"}]]},{"type":"p","text":"Actual progression varies significantly between distribution, advisory, research and asset-management careers."},{"type":"h","text":"Research Opportunities"},{"type":"p","text":"Possible research areas:"},{"type":"list","items":[{"text":"Mutual fund performance"},{"text":"Asset allocation"},{"text":"Behavioural finance"},{"text":"Portfolio optimisation"},{"text":"Risk-adjusted returns"},{"text":"Passive investing"},{"text":"Active management"},{"text":"Financial markets"},{"text":"Retirement planning"},{"text":"Financial inclusion"},{"text":"FinTech"},{"text":"Digital wealth management"},{"text":"ESG investing"}]},{"type":"h","text":"Strong Quantitative Direction"},{"type":"flow","items":["Financial Markets","Statistics","Python","Portfolio Analytics"],"sep":"+"},{"type":"p","text":"can lead toward investment research and quantitative investment careers."},{"type":"h","text":"Future Skills — 2030+"},{"type":"p","text":"Wealth management is becoming increasingly digital."},{"type":"p","text":"Important future skills:"},{"type":"list","items":[{"text":"AI-assisted investment research"},{"text":"Portfolio analytics"},{"text":"Robo-advisory"},{"text":"Financial APIs"},{"text":"Personalised financial planning"},{"text":"Behavioural analytics"},{"text":"Risk analytics"},{"text":"Alternative data"},{"text":"ESG analytics"},{"text":"FinTech"},{"text":"Automated portfolio monitoring"}]},{"type":"h","text":"AI + Wealth Management"},{"type":"p","text":"AI can assist with:"