s"},{"text":"No-shows"},{"text":"Waiting time"},{"text":"Complaints"},{"text":"Patient satisfaction"}]},{"type":"p","text":"Tools:"},{"type":"h","text":"Excel / Power BI"},{"type":"h","text":"Project 2 — Patient Journey Mapping"},{"type":"p","text":"Map the patient journey:"},{"type":"flow","items":["Enquiry","Appointment","Registration","Consultation","Diagnostics","Billing","Pharmacy","Discharge / Follow-Up"]},{"type":"p","text":"Identify bottlenecks and recommend improvements."},{"type":"h","text":"Project 3 — Queue Management System"},{"type":"p","text":"Design a conceptual system for:"},{"type":"list","items":[{"text":"Token generation"},{"text":"Doctor availability"},{"text":"Patient queue"},{"text":"Priority cases"},{"text":"Waiting-time tracking"},{"text":"Notifications"}]},{"type":"h","text":"Project 4 — Patient Complaint Management System"},{"type":"p","text":"Build a prototype containing:"},{"type":"list","items":[{"text":"Complaint ID"},{"text":"Department"},{"text":"Category"},{"text":"Date"},{"text":"Priority"},{"text":"Assigned person"},{"text":"Status"},{"text":"Resolution time"},{"text":"Patient feedback"}]},{"type":"h","text":"Project 5 — Appointment Analytics"},{"type":"p","text":"Analyze:"},{"type":"list","items":[{"text":"Doctor utilization"},{"text":"Appointment demand"},{"text":"No-show rates"},{"text":"Peak hours"},{"text":"Cancellation rates"},{"text":"Waiting times"}]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"For this career, prioritize hospital operations exposure."},{"type":"h","text":"Best internship environments"},{"type":"list","items":[{"text":"Multi-specialty hospitals"},{"text":"Corporate hospitals"},{"text":"Medical college hospitals"},{"text":"Specialty hospitals"},{"text":"Day-care hospitals"},{"text":"Diagnostic networks"},{"text":"Healthcare service organizations"}]},{"type":"h","text":"Internship departments"},{"type":"p","text":"Try to rotate through:"},{"type":"list","items":[{"te