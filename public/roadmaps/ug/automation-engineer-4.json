,{"heading":"Year 2 — PLC + Industrial Control","kind":"other","blocks":[{"type":"p","text":"This is the most important stage for entering industrial automation."},{"type":"h","text":"PLC"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"PLC architecture"},{"text":"Digital/analog I/O"},{"text":"Ladder Logic"},{"text":"Function Block Diagram"},{"text":"Structured Text"},{"text":"Timers"},{"text":"Counters"},{"text":"Interlocks"},{"text":"PID control"},{"text":"PLC troubleshooting"}]},{"type":"p","text":"Common ecosystems include:"},{"type":"list","items":[{"text":"Siemens"},{"text":"Rockwell Automation / Allen-Bradley"},{"text":"Schneider Electric"},{"text":"Mitsubishi"},{"text":"Omron"}]},{"type":"p","text":"A student does not need to master every PLC platform. One major platform deeply + familiarity with others is a better strategy."},{"type":"h","text":"HMI"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Screen design"},{"text":"Alarms"},{"text":"Trends"},{"text":"User controls"},{"text":"Machine status"},{"text":"Industrial data visualization"}]},{"type":"p","text":"Example:"},{"type":"flow","items":["PLC","HMI","Operator","Command / Feedback","PLC"]}]},{"heading":"Year 2–3 — Motors + Drives + Control Systems","kind":"other","blocks":[{"type":"p","text":"Learn:"},{"type":"h","text":"Motors"},{"type":"list","items":[{"text":"Induction motors"},{"text":"Servo motors"},{"text":"Stepper motors"},{"text":"BLDC motors"}]},{"type":"h","text":"Drives"},{"type":"list","items":[{"text":"VFD"},{"text":"Servo drives"},{"text":"Motor controllers"}]},{"type":"h","text":"Control"},{"type":"list","items":[{"text":"Open-loop control"},{"text":"Closed-loop control"},{"text":"PID"},{"text":"Feedback systems"},{"text":"Motion control"},{"text":"Position control"},{"text":"Speed control"}]},{"type":"p","text":"Example:"},{"type":"flow","items":["Setpoint","Controller","Motor / Actuator","Machine","Sensor"]},{"type":"p","text":"└──────────→ Feedback"}]},{