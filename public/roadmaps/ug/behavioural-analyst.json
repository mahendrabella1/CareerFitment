xt":"Behavioural Research Internship"},{"text":"Strong research portfolio"},{"text":"AI/HCI awareness"}]},{"type":"h","text":"Best strategy"},{"type":"p","text":"Do not graduate as only:"},{"type":"h","text":"\"A psychology student who understands theories.\""},{"type":"p","text":"Graduate as:"},{"type":"p","text":"\"A psychology graduate who can measure behaviour, design research, analyse evidence, test interventions and translate behavioural findings into practical decisions.\""}]}]}