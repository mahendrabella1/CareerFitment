":"Research question formulation"},{"text":"Basic referencing"},{"text":"Academic writing"},{"text":"Evidence-based practice"}]},{"type":"note","label":"Target outcome","text":"Understand communication disorders while developing fundamental scientific literacy."}]},{"heading":"Year 2 — Clinical & Research Foundations","kind":"build","blocks":[{"type":"p","text":"Develop deeper knowledge of audiology and speech-language pathology."},{"type":"h","text":"Audiology"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Pure-tone audiometry"},{"text":"Speech audiometry"},{"text":"Tympanometry"},{"text":"Otoacoustic emissions"},{"text":"Auditory brainstem response"},{"text":"Hearing-aid technology"},{"text":"Cochlear implants"}]},{"type":"h","text":"Speech-language pathology"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Articulation disorders"},{"text":"Language disorders"},{"text":"Voice disorders"},{"text":"Fluency disorders"},{"text":"Neurogenic communication disorders"},{"text":"Pediatric communication"},{"text":"Dysphagia fundamentals"}]},{"type":"h","text":"Research development"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Research variables"},{"text":"Sampling"},{"text":"Study designs"},{"text":"Questionnaires"},{"text":"Clinical scales"},{"text":"Data collection"},{"text":"Research ethics"}]},{"type":"note","label":"Target outcome","text":"Understand how clinical observations can be converted into structured research questions."},{"type":"h","text":"Year 3 — Clinical Research Methods"},{"type":"p","text":"This is the critical transition from clinical education to research capability."},{"type":"h","text":"Research design"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Cross-sectional studies"},{"text":"Cohort studies"},{"text":"Case-control studies"},{"text":"Clinical trials"},{"text":"Observational studies"},{"text":"Diagnostic-accuracy studies"},{"text":"Systematic reviews"},{"text":"Meta-analysis fundamentals"}]},{"type":"h","text":"Biostatistics"},{"type":"p","text":"Develop skills in:"},{"type":"list","items":[{"text":"Descriptive statistics"},{"text":"Mean, median and standard deviation"},{"text":"Confidence intervals"},{"text":"Hypothesis testing"},{"text":"Correlation"},{"text":"Regression"},{"text":"t-tests"},{"text":"Chi-square"},{"text":"ANOVA fundamentals"},{"text":"Sensitivity and specificity"}]},{"type":"h","text":"Research software"},{"type":"p","text":"Learn at least one statistical environment:"},{"type":"list","items":[{"text":"R"},{"text":"Python"},{"text":"SPSS"},{"text":"Jamovi"}]},{"type":"p","text":"Also develop:"},{"type":"list","items":[{"text":"Excel"},{"text":"Data visualization"},{"text":"Reference-management software"},{"text":"Basic research databases"}]},{"type":"note","label":"Target outcome","text":"Design, collect and analyze data for a structured clinical research project."}]},{"heading":"Final Year — Dissertation & Clinical Research","kind":"other","blocks":[{"type":"p","text":"The final year should focus on research execution."},{"type":"h","text":"Research workflow"},{"type":"flow","items":["Research Problem","Literature Review","Research Question","Hypothesis / Objectives","Study Design","Ethics Approval","Participant Recruitment","Data Collection","Statistical Analysis","Results","Discussion","Research Paper / Dissertation"]},{"type":"h","text":"Practical research activities"},{"type":"p","text":"Gain experience in:"},{"type":"list","items":[{"text":"Participant recruitment"},{"text":"Informed consent"},{"text":"Clinical assessments"},{"text":"Data collection"},{"text":"Data cleaning"},{"text":"Statistical analysis"},{"text":"Research documentation"},{"text":"Literature review"},{"text":"Manuscript preparation"},{"text":"Conference presentations"}]},{"type":"note","label":"Target outcome","text":"Complete at least one well-designed research project that can be converted into a conference presentation, dissertation or publicat