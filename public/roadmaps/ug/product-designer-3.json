omics"},{"text":"Structural constraints"},{"text":"Cost"},{"text":"Safety"},{"text":"User behaviour"}]},{"type":"p","text":"The future profile is:"},{"type":"flow","items":["Product Designer","Material Specialist","CAD","Manufacturing","AI-assisted Ideation"],"sep":"+"}]},{"heading":"Study Abroad Directions","kind":"abroad","blocks":[{"type":"p","text":"Relevant programmes include:"},{"type":"list","items":[{"text":"Industrial Design"},{"text":"Product Design"},{"text":"Ceramic Design"},{"text":"Glass Design"},{"text":"Materials Design"},{"text":"Furniture Design"},{"text":"Sustainable Design"},{"text":"Design for Manufacturing"}]},{"type":"p","text":"Potential destinations include:"},{"type":"list","items":[{"text":"Italy"},{"text":"UK"},{"text":"Germany"},{"text":"Netherlands"},{"text":"Denmark"},{"text":"Sweden"},{"text":"Finland"},{"text":"USA"},{"text":"Canada"},{"text":"Australia"},{"text":"Japan"}]},{"type":"p","text":"For this career, students should evaluate programmes based on workshops, fabrication facilities, industry projects, manufacturing exposure and portfolio development."}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"flow","items":["B.Des Graduate","Product Design Intern","Junior Product Designer","Product Designer","Senior Product Designer","Lead Product Designer","Design Manager","Design Director"]},{"type":"p","text":"Alternative specialist route:"},{"type":"flow","items":["Ceramic/Glass Designer","Product Development Designer","Senior Product Designer","Material Innovation Designer","Design Lead"]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"h","text":"Design"},{"type":"list","items":[{"text":"Product sketching"},{"text":"Form development"},{"text":"Ergonomics"},{"text":"User research"},{"text":"Product systems"},{"text":"Design thinking"}]},{"type":"h","text":"Material"},{"type":"list","items":[{"text":"Ceramics"},{"text":"Glass"},{"text":"Wood"},{"text":"Metal"},{"text":"Plastics"},{"text":"Sustainable materials"}]},{"type":"h","text":"Technical"},{"type":"list","items":[{"text":"Rhino / SolidWorks / Fusion 360"},{"text":"AutoCAD"},{"text":"KeyShot"},{"text":"Blender"},{"text":"Adobe Creative Suite"}]},{"type":"h","text":"Manufacturing"},{"type":"list","items":[{"text":"Design for Manufacturing"},{"text":"Prototyping"},{"text":"Tooling awareness"},{"text":"Production processes"},{"text":"Tolerances"},{"text":"Quality considerations"}]},{"type":"h","text":"Future Skills"},{"type":"list","items":[{"text":"Circular design"},{"text":"Sustainable materials"},{"text":"AI-assisted design"},{"text":"Parametric modelling"},{"text":"Digital fabrication"},{"text":"3D printing"}]}]},{"heading":"Best Profile by Graduation","kind":"other","blocks":[{"type":"p","text":"A strong graduate profile should look like:"},{"type":"flow","items":["B.Des Ceramic & Glass Design","Product/Industrial Design Skills","CAD","3D Modelling","Rendering","Prototyping","Manufacturing Knowledge","Material Expertise","Sustainability","4–6 Strong Product Projects","Industry Internship"],"sep":"+"},{"type":"h","text":"Target progression"},{"type":"note","label":"Year 1","text":"Design fundamentals + ceramics/glass\nYear 2: Product development + ergonomics + prototyping\nYear 3: CAD + manufacturing + industrial design\nYear 4: Production-oriented projects + internship + professional portfolio\nAfter graduation: Junior Product Designer / Industrial Designer\n3–5 years: Product Designer\n5–8 years: Senior Product Designer / Product Design Lead\n8+ years: Design Manager / Design Director / Independent Consultant"},{"type":"note","label":"Key point","text":"The strongest graduate is not simply a ceramic or glass craft specialist. They can identify a user problem, design an attractive and functional product, select the right material, model it digitally, prototype it physically, understand how it will be manufactured, test it with users and refine it into a commercially viable product."}]}]}