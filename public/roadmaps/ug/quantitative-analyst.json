text":"Searching"},{"text":"Dynamic programming"},{"text":"Greedy algorithms"},{"text":"Complexity analysis"},{"text":"Practice competitive programming and algorithmic problem solving regularly."}]}]},{"heading":"Quantitative Research Workflow","kind":"other","blocks":[{"type":"p","text":"A quant should understand the complete research process:"},{"type":"flow","items":["Market Data","Data Cleaning","Feature Engineering","Hypothesis","Statistical Analysis","Model Development","Backtesting","Risk Analysis","Transaction Cost Analysis","Robustness Testing","Paper Trading","Production Strategy"]},{"type":"p","text":"A critical skill is knowing when a backtest is misleading."},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Overfitting"},{"text":"Look-ahead bias"},{"text":"Survivorship bias"},{"text":"Data leakage"},{"text":"Selection bias"},{"text":"Multiple testing"},{"text":"Regime changes"}]}]},{"heading":"Five Recommended UG Projects","kind":"other","blocks":[{"type":"h","text":"Project 1 — Algorithmic Trading Backtester"},{"type":"p","text":"Build a Python backtesting framework."},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Historical price data"},{"text":"Strategy rules"},{"text":"Entry/exit signals"},{"text":"Position sizing"},{"text":"Transaction costs"},{"text":"Portfolio value"},{"text":"Drawdown"},{"text":"Sharpe ratio"}]},{"type":"flow","items":["Python","statistics","finance."],"sep":"+","label":"Skills"},{"type":"h","text":"Project 2 — Portfolio Optimization Engine"},{"type":"p","text":"Build an optimizer using:"},{"type":"list","items":[{"text":"Expected returns"},{"text":"Covariance matrix"},{"text":"Risk constraints"},{"text":"Portfolio weights"}]},{"type":"p","text":"Implement:"},{"type":"list","items":[{"text":"Minimum-variance portfolio"},{"text":"Maximum-Sharpe portfolio"},{"text":"Efficient frontier"}]},{"type":"note","label":"Advanced extension","text":"compare classical optimization with robust optimization."},{"type":"h","text":"Project 3 — Options Pricing Model"},{"type":"p","text":"Implement:"},{"type":"list","items":[{"text":"Black-Scholes model"},{"text":"Monte Carlo pricing"},{"text":"Binomial tree"}]},{"type":"p","text":"Calculate:"},{"type":"list","items":[{"text":"Option price"},{"text":"Delta"},{"text":"Gamma"},{"text":"Vega"},{"text":"Theta"},{"text":"Rho"},{"text":"Create a visualization dashboard."}]},{"type":"h","text":"Project 4 — Financial Time-Series Prediction"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Returns"},{"text":"Volatility"},{"text":"Autocorrelation"},{"text":"Moving averages"},{"text":"ARIMA/GARCH models"},{"text":"Compare statistical models against machine-learning approaches."}]},{"type":"note","label":"Important","text":"evaluate models using proper out-of-sample testing, rather than claiming predictive performance from an in-sample fit."},{"type":"h","text":"Project 5 — Market Risk Analytics Platform"},{"type":"p","text":"Create a risk-analysis application calculating:"},{"type":"list","items":[{"text":"Value at Risk"},{"text":"Conditional VaR / Expected Shortfall"},{"text":"Maximum drawdown"},{"text":"Volatility"},{"text":"Beta"},{"text":"Correlation"},{"text":"Stress scenarios"}]},{"type":"flow","items":["Python","pandas","NumPy","SciPy","Power BI."],"sep":"+","label":"Stack"}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Quantitative internships are highly competitive, so begin preparing early."},{"type":"p","text":"Target:"},{"type":"h","text":"Banks"},{"type":"p","text":"Roles involving:"},{"type":"list","items":[{"text":"Quantitative research"},{"text":"Risk analytics"},{"text":"Model validation"},{"text":"Markets analytics"}]},{"type":"h","text":"Investment Firms"},{"type":"p","text":"Look for:"},{"type":"list","items":[{"text":"Quant research"},{"text":"Portfolio analytics"},{"text":"Systematic strategies"},{"text":"Data science"}]},{"type":"h","text":"Trading Firms"},{