astic processes"},{"text":"Time-series analysis"},{"text":"Regression"},{"text":"Statistical inference"},{"text":"Optimization"},{"text":"Numerical methods"},{"text":"Financial mathematics"},{"text":"Derivatives"},{"text":"Portfolio theory"},{"text":"Risk modelling"}]},{"type":"p","text":"Advanced programming:"},{"type":"list","items":[{"text":"Python"},{"text":"C++"},{"text":"SQL"},{"text":"Linux"},{"text":"Git"},{"text":"Begin building a quant research portfolio."}]}]},{"heading":"Core Mathematics","kind":"other","blocks":[{"type":"p","text":"A strong quant needs mathematics significantly beyond basic undergraduate arithmetic."},{"type":"h","text":"Linear Algebra"},{"type":"note","label":"Target","text":"Expert"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Vectors"},{"text":"Matrices"},{"text":"Eigenvalues/eigenvectors"},{"text":"Matrix decomposition"},{"text":"Positive-definite matrices"},{"text":"Principal Component Analysis"},{"text":"Numerical linear algebra"}]},{"type":"p","text":"Applications:"},{"type":"list","items":[{"text":"Portfolio optimization"},{"text":"Factor models"},{"text":"Risk models"},{"text":"Machine learning"}]},{"type":"h","text":"Calculus"},{"type":"note","label":"Target","text":"Advanced/Expert"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Multivariable calculus"},{"text":"Partial derivatives"},{"text":"Optimization"},{"text":"Taylor series"},{"text":"Numerical differentiation"},{"text":"Integration"}]},{"type":"p","text":"Applications:"},{"type":"list","items":[{"text":"Option pricing"},{"text":"Optimization"},{"text":"Sensitivity analysis"}]},{"type":"h","text":"Probability"},{"type":"note","label":"Target","text":"Expert"},{"type":"p","text":"Master:"},{"type":"list","items":[{"text":"Random variables"},{"text":"Probability distributions"},{"text":"Conditional probability"},{"text":"Bayes' theorem"},{"text":"Expectation"},{"text":"Variance"},{"text":"Covariance"},{"text":"Conditional expectation"},{"