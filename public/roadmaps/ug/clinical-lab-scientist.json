ype":"flow","items":["Sample Collection","Rejection Data","Reason Classification","Root-Cause Analysis","Corrective Action","Rejection Reduction"]},{"type":"p","text":"Possible categories:"},{"type":"list","items":[{"text":"Hemolysis"},{"text":"Insufficient volume"},{"text":"Wrong container"},{"text":"Improper labeling"},{"text":"Delayed transport"}]},{"type":"p","text":"Use synthetic or anonymized data."},{"type":"h","text":"Project 3 — PCR Workflow Simulation"},{"type":"p","text":"Create an educational molecular-diagnostics workflow:"},{"type":"flow","items":["Sample","Nucleic Acid Extraction","Quality Check","PCR Setup","Amplification","Result Analysis","Quality Control","Report"]},{"type":"h","text":"Project 4 — Hematology Data Analysis"},{"type":"p","text":"Use a synthetic CBC dataset to study:"},{"type":"list","items":[{"text":"Hemoglobin"},{"text":"RBC"},{"text":"WBC"},{"text":"Platelets"},{"text":"MCV"},{"text":"MCH"},{"text":"MCHC"}]},{"type":"p","text":"Focus on data quality, visualization, and educational pattern recognition rather than autonomous diagnosis."},{"type":"h","text":"Project 5 — Laboratory Turnaround-Time Analytics"},{"type":"p","text":"Build a dashboard tracking:"},{"type":"list","items":[{"text":"Test volume"},{"text":"Average TAT"},{"text":"Median TAT"},{"text":"Department"},{"text":"Shift"},{"text":"Sample type"},{"text":"Delayed reports"}]},{"type":"h","text":"Internship & Experience Strategy"},{"type":"h","text":"Year 2"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Sample handling"},{"text":"Microscopy"},{"text":"Basic testing"},{"text":"Biosafety"},{"text":"Documentation"}]},{"type":"h","text":"Year 3"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Biochemistry"},{"text":"Hematology"},{"text":"Microbiology"},{"text":"Immunology"},{"text":"Molecular diagnostics"}]},{"type":"h","text":"Final Internship"},{"type":"p","text":"Aim for exposure to:"},{"type":"list","items":[{"text":"Automated laborator