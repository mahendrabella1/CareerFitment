ons"},{"text":"Backups"},{"text":"Replication concepts"}]},{"type":"h","text":"Cloud databases"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Managed relational databases"},{"text":"Managed NoSQL"},{"text":"Object storage"},{"text":"Block storage"},{"text":"File storage"}]},{"type":"h","text":"Storage concepts"},{"type":"p","text":"Know the difference between:"},{"type":"h","text":"Object vs Block vs File storage"},{"type":"p","text":"This is a common cloud interview topic."}]},{"heading":"Security","kind":"other","blocks":[{"type":"p","text":"Cloud engineers need security fundamentals from the beginning."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"IAM"},{"text":"Least privilege"},{"text":"MFA"},{"text":"Encryption"},{"text":"Secrets management"},{"text":"Network segmentation"},{"text":"Security groups/firewalls"},{"text":"TLS/HTTPS"},{"text":"Key management"},{"text":"Logging"},{"text":"Audit trails"},{"text":"Backup/recovery"}]},{"type":"h","text":"Important principle"},{"type":"p","text":"Never put cloud credentials directly inside source code."},{"type":"p","text":"Use appropriate:"},{"type":"list","items":[{"text":"IAM roles"},{"text":"Managed identities"},{"text":"Secret managers"},{"text":"Environment/configuration mechanisms"}]}]},{"heading":"Git and software development workflow","kind":"other","blocks":[{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Git"},{"text":"GitHub/GitLab"},{"text":"Branches"},{"text":"Pull requests"},{"text":"Merge/rebase concepts"},{"text":"Tags"},{"text":"Releases"},{"text":".gitignore"}]},{"type":"p","text":"Understand the workflow:"},{"type":"flow","items":["Developer","Git","Pull Request","Code Review","CI","Build/Test","Deploy"]}]},{"heading":"Docker","kind":"other","blocks":[{"type":"p","text":"Docker is essential for modern DevOps/cloud roles."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Images"},{"text":"Containers"},{"text":"Dockerfile"},{"text":"V