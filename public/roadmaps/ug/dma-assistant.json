:"Relief operations"},{"text":"Climate adaptation"},{"text":"Emergency preparedness"}]},{"type":"h","text":"Infrastructure organizations"},{"type":"p","text":"Useful sectors:"},{"type":"list","items":[{"text":"Airports"},{"text":"Ports"},{"text":"Power companies"},{"text":"Railways"},{"text":"Construction"},{"text":"Hospitals"},{"text":"Industrial facilities"}]},{"type":"p","text":"These organizations need emergency preparedness and business-continuity planning."}]},{"heading":"Internship Titles to Search","kind":"internships","blocks":[{"type":"p","text":"Search for:"},{"type":"list","items":[{"text":"Disaster Management Intern"},{"text":"Disaster Risk Reduction Intern"},{"text":"Emergency Management Intern"},{"text":"Disaster Response Intern"},{"text":"Resilience Intern"},{"text":"Humanitarian Program Intern"},{"text":"GIS Disaster Management Intern"},{"text":"Climate Resilience Intern"},{"text":"Emergency Planning Intern"},{"text":"Risk Assessment Intern"}]}]},{"heading":"Strong Internship Project","kind":"internships","blocks":[{"type":"note","label":"Project","text":"Community Disaster Risk Assessment"},{"type":"p","text":"Select a local community or hypothetical study area."},{"type":"h","text":"Step 1 — Identify hazards"},{"type":"p","text":"For example:"},{"type":"list","items":[{"text":"Flood"},{"text":"Heatwave"},{"text":"Cyclone"},{"text":"Fire"}]},{"type":"h","text":"Step 2 — Map exposure"},{"type":"p","text":"Map:"},{"type":"list","items":[{"text":"Population"},{"text":"Schools"},{"text":"Hospitals"},{"text":"Roads"},{"text":"Critical infrastructure"}]},{"type":"h","text":"Step 3 — Assess vulnerability"},{"type":"p","text":"Consider:"},{"type":"list","items":[{"text":"Elderly population"},{"text":"Children"},{"text":"Low-income communities"},{"text":"Infrastructure quality"},{"text":"Accessibility"}]},{"type":"h","text":"Step 4 — Build a risk map"},{"type":"p","text":"Use:"},{"type":"flow","items":["GIS","hazard data","exposure","vulnerability"],"sep":"