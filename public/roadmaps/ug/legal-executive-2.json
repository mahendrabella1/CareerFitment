ndation"},{"type":"p","text":"+"},{"type":"p","text":"Legal Research"},{"type":"p","text":"+"},{"type":"p","text":"Legal Writing"},{"type":"p","text":"+"},{"type":"p","text":"Contract Law"},{"type":"p","text":"+"},{"type":"p","text":"Contract Drafting"},{"type":"p","text":"+"},{"type":"p","text":"Corporate Law"},{"type":"p","text":"+"},{"type":"p","text":"Compliance"},{"type":"p","text":"+"},{"type":"p","text":"Due Diligence"},{"type":"p","text":"+"},{"type":"p","text":"Litigation Coordination"},{"type":"p","text":"+"},{"type":"p","text":"Risk Identification"},{"type":"p","text":"+"},{"type":"p","text":"Negotiation"},{"type":"p","text":"+"},{"type":"p","text":"Business Understanding"},{"type":"p","text":"+"},{"type":"p","text":"Legal Technology"},{"type":"p","text":"+"},{"type":"p","text":"Excel / Analytics"},{"type":"p","text":"+"},{"type":"p","text":"AI-Assisted Legal Work"},{"type":"p","text":"+"},{"type":"p","text":"Professional Communication"},{"type":"p","text":"+"},{"type":"p","text":"Stakeholder Management"},{"type":"h","text":"Best Overall Positioning"},{"type":"flow","items":["3-Year LLB","Corporate/Legal Internship","Legal Research + Contract Drafting","Contract & Compliance Experience","Legal Executive","Senior Legal Executive","Legal Manager","Head of Legal / General Counsel"]},{"type":"p","text":"For the Legal Executive career, the strongest positioning is to combine the LLB with contract drafting, corporate law, compliance, due diligence, legal research, business understanding and legal technology. This gives the graduate flexibility to enter a law firm, corporate legal department, startup, financial institution, compliance team or legal-tech environment."}]}]}