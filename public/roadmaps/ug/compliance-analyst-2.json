e."},{"type":"h","text":"Year 2 — Banking & Insurance Law"},{"type":"p","text":"Develop financial-sector legal knowledge."},{"type":"h","text":"Banking"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Banking regulation"},{"text":"Banking contracts"},{"text":"Lending"},{"text":"Secured transactions"},{"text":"Recovery processes"},{"text":"Digital banking"},{"text":"Payment systems"},{"text":"Customer protection"},{"text":"Banking fraud"},{"text":"Financial-sector compliance"}]},{"type":"h","text":"Insurance"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Insurance contracts"},{"text":"Policy terms"},{"text":"Claims"},{"text":"Underwriting"},{"text":"Insurance intermediaries"},{"text":"Customer protection"},{"text":"Insurance distribution"},{"text":"Insurance regulation"},{"text":"Fraud"},{"text":"Regulatory compliance"}]},{"type":"h","text":"Year 3 — Compliance & Risk Management"},{"type":"p","text":"Move from theoretical law to practical compliance."},{"type":"h","text":"Learn"},{"type":"list","items":[{"text":"Regulatory compliance"},{"text":"Compliance frameworks"},{"text":"Internal controls"},{"text":"Risk assessment"},{"text":"Regulatory reporting"},{"text":"Compliance testing"},{"text":"Audit"},{"text":"KYC"},{"text":"AML"},{"text":"Customer due diligence"},{"text":"Sanctions screening"},{"text":"Transaction monitoring"},{"text":"Fraud risk"},{"text":"Consumer protection"}]},{"type":"h","text":"Develop this mindset"},{"type":"flow","items":["Law","Regulation","Business Requirement","Control","Evidence","Testing","Risk","Remediation"]}]},{"heading":"Final Year — Professional Compliance Practice","kind":"other","blocks":[{"type":"p","text":"Use the final year to develop job-ready capabilities."},{"type":"h","text":"Recommended activities"},{"type":"list","items":[{"text":"Bank compliance internship"},{"text":"Insurance compliance internship"},{"text":"FinTech compliance internship"},{"text":"Legal/compliance internship"},{"text":"A