t":"Financial ratios"},{"text":"Scenario analysis"},{"text":"Data cleaning"},{"text":"Charts"}]}]},{"heading":"Legal Technology","kind":"other","blocks":[{"type":"p","text":"Learn how technology can support insolvency work:"},{"type":"list","items":[{"text":"AI legal research"},{"text":"Document summarisation"},{"text":"Case-law classification"},{"text":"Contract review"},{"text":"Legal-document search"},{"text":"Case-management systems"},{"text":"Digital evidence organisation"},{"text":"Financial-data analysis"}]},{"type":"p","text":"AI should be used as an analytical assistant, with legal conclusions and filings verified against primary legal sources."}]},{"heading":"Projects During UG","kind":"build","blocks":[{"type":"h","text":"Project 1 — Distressed Company Analysis"},{"type":"p","text":"Select a hypothetical company and create:"},{"type":"list","items":[{"text":"Company profile"},{"text":"Industry analysis"},{"text":"Assets"},{"text":"Liabilities"},{"text":"Debt"},{"text":"Cash flow"},{"text":"Creditor exposure"},{"text":"Legal disputes"}]},{"type":"p","text":"Then determine the potential causes of distress."},{"type":"h","text":"Project 2 — Insolvency Case Study"},{"type":"p","text":"Choose a publicly documented insolvency case and create:"},{"type":"flow","items":["Company Background","Default","Proceedings","Creditors","Resolution Process","Resolution Plan / Liquidation","Final Outcome","Legal Lessons"]},{"type":"h","text":"Project 3 — Creditor Claims Analysis"},{"type":"p","text":"Create a hypothetical creditor database:"},{"type":"table","header":["Creditor","Type","Claim","Security","Status"],"rows":[[{"text":"Bank A"},{"text":"Financial"},{"text":"₹50 Cr"},{"text":"Secured"},{"text":"Verified"}],[{"text":"Vendor B"},{"text":"Operational"},{"text":"₹4 Cr"},{"text":"Unsecured"},{"text":"Pending"}],[{"text":"Bank C"},{"text":"Financial"},{"text":"₹20 Cr"},{"text":"Secured"},{"text":"Verified"}]]},{"type":"p","text":"This demonstrates practical analytical ability."}]},{"heading":"Project 4 — Resolution Plan Comparison","kind":"other","blocks":[{"type":"p","text":"Create two hypothetical resolution plans and compare:"},{"type":"list","items":[{"text":"Offered amount"},{"text":"Recovery percentage"},{"text":"Payment timeline"},{"text":"Creditor treatment"},{"text":"Employee impact"},{"text":"Operational viability"},{"text":"Funding"},{"text":"Implementation risks"}]}]},{"heading":"Project 5 — Insolvency Dashboard","kind":"other","blocks":[{"type":"p","text":"Build an Excel/Power BI dashboard containing:"},{"type":"p","text":"CASE PORTFOLIO"},{"type":"p","text":"│"},{"type":"p","text":"├── Active Cases"},{"type":"p","text":"├── Resolution"},{"type":"p","text":"├── Liquidation"},{"type":"p","text":"├── Claims"},{"type":"p","text":"├── Creditors"},{"type":"p","text":"├── Recovery"},{"type":"p","text":"└── Pending Proceedings"},{"type":"h","text":"Useful Metrics"},{"type":"list","items":[{"text":"Total claims"},{"text":"Verified claims"},{"text":"Total debt"},{"text":"Recovery amount"},{"text":"Recovery percentage"},{"text":"Number of creditors"},{"text":"Case duration"},{"text":"Resolution status"}]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"h","text":"Year 1"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"General law firms"},{"text":"Corporate legal teams"},{"text":"Legal research organisations"}]},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"Legal research"},{"text":"Case reading"},{"text":"Drafting"}]},{"type":"h","text":"Year 2"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Corporate law firms"},{"text":"Commercial litigation firms"},{"text":"Banking/legal teams"}]},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Corporate finance"},{"text":"Commercial contracts"},{"text":"Debt documentation"}]},{"type":"h","text":"Year 3"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Insolvency law firms"},{"text":"Restructuring teams"},{"text":"Insolvency professionals"},{"text":"Financial institutions"}]},{"type":"p","text":"Work on:"},{"type":"list","items":[{"text":"Insolvency cases"},{"text":"Claims"},{"text":"Case research"},{"text":"NCLT-related documentation"}]},{"type":"h","text":"Final Year"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Insolvency & restructuring practices"},{"text":"Big law firms"},{"text":"Resolution advisory firms"},{"text":"Financial institutions"},{"text":"Turnaround/restructuring teams"},{"text":"Insolvency professional firms"}]}]},{"heading":"Employer Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Employer Requirement","Target Level"],"rows":[[{"text":"Insolvency law"},{"text":"Advanced"}],[{"text":"Legal research"},{"text":"Advanced"}],[{"text":"Corporate law"},{"text":"Advanced"}],[{"text":"Financial analysis"},{"text":"Intermediate–Advanced"}],[{"text":"Excel"},{"text":"Advanced"}],[{"text":"Case analysis"},{"text":"Advanced"}],[{"text":"Due diligence"},{"text":"Intermediate–Advanced"}],[{"text":"Legal drafting"},{"text":"Advanced"}],[{"text":"NCLT/NCLAT procedure"},{"text":"Intermediate–Advanced"}],[{"text":"Resolution plans"},{"text":"Intermediate"}],[{"text":"Accounting"},{"text":"Intermediate"}],[{"text":"Credit analysis"},{"text":"Intermediate"}],[{"text":"Report writing"},{"text":"Advanced"}],[{"text":"Presentation"},{"text":"Intermediate–Advanced"}],[{"text":"LegalTech"},{"text":"Intermediate"}]]}]},{"heading":"Certifications & Additional Learning","kind":"certifications","blocks":[{"type":"p","text":"Useful areas include:"},{"type":"h","text":"Legal"},{"type":"list","items":[{"text":"Insolvency & Bankruptcy Law"},{"text":"Corporate Law"},{"text":"Restructuring"},{"text":"Commercial Litigation"},{"text":"Banking & Finance Law"}]},{"type":"h","text":"Finance"},{"type":"list","items":[{"text":"Financial statement analysis"},{"text":"Credit analysis"},{"text":"Corporate finance"},{"text":"Financial modelling"},{"text":"Valuation fundamentals"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Excel"},{"text":"Power BI"},{"text":"Data analytics"},{"text":"LegalTech"},{"text":"AI-assisted legal research"}]},{"type":"h","text":"Important Professional Caveat"},{"type":"p","text":"Students should distinguish between an Insolvency Analyst role and the statutory role of an Insolvency Professional. Becoming a practising insolvency professional involves separate regulatory eligibility, examinations, professional membership/registration and other requirements under the applicable framework."}]},{"heading":"PG Options","kind":"pg_india","blocks":[{"type":"h","text":"LL.M"},{"type":"p","text":"Relevant specialisations:"},{"type":"list","items":[{"text":"Insolvency & Bankruptcy Law"},{"text":"Corporate & Commercial Law"},{"text":"Business Law"},{"text":"Banking & Finance Law"},{"text":"Corporate Law"},{"text":"Commercial Law"}]},{"type":"h","text":"Other Options"},{"type":"list","items":[{"text":"MBA Finance"},{"text":"MBA Financial Management"},{"text":"Finance / Investment programs"},{"text":"Restructuring programs"},{"text":"Corporate finance certifications"}]},{"type":"flow","items":["For an analyst, combining LL.B","finance/accounting","insolvency experience can be particularly valuable."],"sep":"+"}]},{"heading":"Career Specialisations","kind":"other","blocks":[{"type":"h","text":"Insolvency & Restructuring"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Corporate distress"},{"text":"Debt restructuring"},{"text":"Resolution plans"},{"text":"Creditor negotiations"}]},{"type":"h","text":"Insolvency Litigation"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"NCLT"},{"text":"NCLAT"},{"text":"Insolvency disputes"},{"text":"Creditor rights"}]},{"type":"h","text":"Financial Creditor Advisory"},{"type":"p","text":"Work with:"},{"type":"list","items":[{"text":"Banks"},{"text":"NBFCs"},{"text":"Institutional lenders"},{"text":"Investment funds"}]},{"type":"h","text":"Resolution Advisory"},{"type":"p","text":"Analyse:"},{"type":"list","items":[{"text":"Distressed businesses"},{"text":"Resolution applicants"},{"text":"Business viability"},{"text":"Recovery value"}]},{"type":"h","text":"Liquidation"},{"type":"p","text":"Work on:"},{"type":"list","items":[{"text":"Asset identification"},{"text":"Asset valuation"},{"text":"Sale processes"},{"text":"Creditor claims"},{"text":"Distribution"}]},{"type":"h","text":"Forensic / Fraud Analysis"},{"type":"p","text":"Investigate:"},{"type":"list","items":[{"text":"Related-party transactions"},{"text":"Asset diversion"},{"text":"Suspicious transactions"},{"text":"Potential avoidance transactions"}]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"h","text":"Legal Route"},{"type":"flow","items":["Insolvency Intern","Insolvency Legal Analyst","Insolvency Associate","Senior Associate","Managing Associate","Partner / Practice Head"]},{"type":"h","text":"Advisory Route"},{"type":"flow","items":["Insolvency Analyst","Restructuring Analyst","Senior Analyst","Manager","Senior Manager","Director","Partner / Practice Leader"]},{"type":"h","text":"Financial Institution Route"},{"type":"flow","items":["Insolvency Analyst","Credit / Recovery Analyst","Restructuring Specialist","Senior Manager","Head – Stressed Assets / Recovery"]}]},{"heading":"Emerging Technologies","kind":"other","blocks":[{"type":"h","text":"AI for Insolvency"},{"type":"p","text":"Future insolvency analysts should understand:"},{"type":"list","items":[{"text":"AI document analysis"},{"text":"Case-law research"},{"text":"Financial anomaly detection"},{"text":"Contract analysis"},{"text":"Claims classification"},{"text":"Litigation analytics"},{"text":"Automated case chronologies"}]},{"type":"h","text":"Data Analytics"},{"type":"p","text":"Use data to identify:"},{"type":"list","items":[{"text":"Creditor patterns"},{"text":"Cash-flow problems"},{"text":"Related-party transactions"},{"text":"Unusual payments"},{"text":"Recovery trends"}]},{"type":"h","text":"Forensic Analytics"},{"type":"p","text":"Combining:"},{"type":"p","text":"Legal Knowledge"},{"type":"p","text":"+"},{"type":"p","text":"Accounting"},{"type":"p","text":"+"},{"type":"p","text":"Data Analytics"},{"type":"p","text":"+"},{"type":"p","text":"Forensic Investigation"},{"type":"p","text":"can create a strong specialist profile."}]},{"heading":"Target Profile at Graduation","kind":"other","blocks":[{"type":"p","text":"A strong Insolvency Analyst candidate should have:"},{"type":"h","text":"Legal"},{"type":"list","items":[{"text":"IBC fundamentals"},{"text":"Corporate law"},{"text":"Contract law"},{"text":"Banking & finance law"},{"text":"Commercial litigation"},{"text":"Insolvency case law"}]},{"type":"h","text":"Finance"},{"type":"list","items":[{"text":"Accounting"},{"text":"Financial statements"},{"text":"Credit analysis"},{"text":"Debt"},{"text":"Cash flow"},{"text":"Valuation basics"}]},{"type":"h","text":"Practical"},{"type":"list","items":[{"text":"Claims analysis"},{"text":"Legal due diligence"},{"text":"Case chronology"},{"text":"Resolution-plan analysis"},{"text":"Insolvency research"},{"text":"Report writing"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Advanced Excel"},{"text":"Power BI"},{"text":"Legal databases"},{"text":"AI legal research"},{"text":"Document management"}]},{"type":"h","text":"Portfolio"},{"type":"p","text":"At least:"},{"type":"list","items":[{"text":"2 insolvency case studies"},{"text":"1 distressed-company analysis"},{"text":"1 creditor claims analysis"},{"text":"1 resolution-plan comparison"},{"text":"1 insolvency dashboard"},{"text":"2 relevant internships"}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"p","text":"INSOLVENCY ANALYST"},{"type":"p","text":"│"},{"type":"p","text":"├── Insolvency Law"},{"type":"p","text":"│ ├── IBC"},{"type":"p","text":"│ ├── CIRP"},{"type":"p","text":"│ ├── Liquidation"},{"type":"p","text":"│ ├── Creditor Rights"},{"type":"p","text":"│ └── Resolution Plans"},{"type":"p","text":"│"},{"type":"p","text":"├── Corporate Law"},{"type":"p","text":"│ ├── Companies"},{"type":"p","text":"│ ├── Directors"},{"type":"p","text":"│ ├── Corporate Finance"},{"type":"p","text":"│ └── Governance"},{"type":"p","text":"│"},{"type":"p","text":"├── Finance"},{"type":"p","text":"│ ├── Accounting"},{"type":"p","text":"│ ├── Financial Statements"},{"type":"p","text":"│ ├── Credit Analysis"},{"type":"p","text":"│ ├── Cash Flow"},{"type":"p","text":"│ └── Valuation"},{"type":"p","text":"│"},{"type":"p","text":"├── Legal Analysis"},{"type":"p","text":"│ ├── Case Law"},{"type":"p","text":"│ ├── Due Diligence"},{"type":"p","text":"│ ├── Claims"},{"type":"p","text":"│ └── Regulatory Research"},{"type":"p","text":"│"},{"type":"p","text":"├── Restructuring"},{"type":"p","text":"│ ├── Distressed Assets"},{"type":"p","text":"│ ├── Debt Restructuring"},{"type":"p","text":"│ ├── Resolution"},{"type":"p","text":"│ └── Recovery"},{"type":"p","text":"│"},{"type":"p","text":"├── Technology"},{"type":"p","text":"│ ├── Excel"},{"type":"p","text":"│ ├── Power BI"},{"type":"p","text":"│ ├── LegalTech"},{"type":"p","text":"│ └── AI Analytics"},{"type":"p","text":"│"},{"type":"p","text":"└── Professional Skills"},{"type":"p","text":"├── Report Writing"},{"type":"p","text":"├── Communication"},{"type":"p","text":"├── Research"},{"type":"p","text":"├── Critical Thinking"},{"type":"p","text":"└── Stakeholder Management"}]},{"heading":"Best Overall Positioning","kind":"other","blocks":[{"type":"p","text":"The strongest positioning for this career is:"},{"type":"p","text":"“Legal-financial analyst specialising in insolvency, restructuring, distressed assets and creditor-side analysis.”"},{"type":"p","text":"For this career, law knowledge alone is not enough. The strongest candidates combine IBC knowledge + corporate law + accounting + financial analysis + legal research + Excel/data skills. This allows an Insolvency Analyst to move beyond simply reading cases and become capable of analysing the financial condition, legal position, creditor exposure and potential resolution strategy of a distressed business."}]}]}