pe":"p","text":"GIS"},{"type":"p","text":"+"},{"type":"p","text":"REMOTE SENSING"},{"type":"p","text":"+"},{"type":"p","text":"HYDROLOGY / FLOOD MODELLING"},{"type":"p","text":"+"},{"type":"p","text":"CLIMATE RISK"},{"type":"p","text":"+"},{"type":"p","text":"STATISTICS"},{"type":"p","text":"+"},{"type":"p","text":"PYTHON / SQL"},{"type":"p","text":"+"},{"type":"p","text":"HEC-RAS / HEC-HMS"},{"type":"p","text":"+"},{"type":"p","text":"GOOGLE EARTH ENGINE"},{"type":"p","text":"+"},{"type":"p","text":"POWER BI"},{"type":"p","text":"+"},{"type":"p","text":"MACHINE LEARNING"},{"type":"p","text":"+"},{"type":"p","text":"INFRASTRUCTURE RESILIENCE"},{"type":"p","text":"+"},{"type":"p","text":"EARLY WARNING"},{"type":"p","text":"+"},{"type":"p","text":"EMERGENCY MANAGEMENT"},{"type":"h","text":"Target Profile by Graduation"},{"type":"p","text":"By the end of B.Tech/B.E., the student should be able to:"},{"type":"list","items":[{"text":"Explain disaster-risk concepts"},{"text":"Distinguish hazard, exposure, vulnerability and risk"},{"text":"Assess multiple natural and technological hazards"},{"text":"Build GIS hazard maps"},{"text":"Perform spatial analysis"},{"text":"Analyze satellite imagery"},{"text":"Work with DEMs and geospatial datasets"},{"text":"Perform flood-risk analysis"},{"text":"Understand earthquake and landslide risk"},{"text":"Assess cyclone, drought and heatwave risk"},{"text":"Perform exposure analysis"},{"text":"Build vulnerability indicators"},{"text":"Conduct qualitative and quantitative risk assessments"},{"text":"Understand climate-risk scenarios"},{"text":"Model disaster losses at a basic level"},{"text":"Analyze critical infrastructure dependencies"},{"text":"Understand early-warning systems"},{"text":"Build disaster-risk dashboards"},{"text":"Use Python and SQL for risk analytics"},{"text":"Use HEC-RAS/HEC-HMS where relevant"},{"text":"Communicate risk to technical and non-technical stakeholders"},{"text":"Develop evidence-based disaster-risk-reduction recommendations"}]},{"type":"h","text":"Ideal Portfolio"},{"type":"p","text":"A strong portfolio should contain 5–7 multi-disciplinary projects."},{"type":"h","text":"1. Multi-Hazard Risk Map"},{"type":"p","text":"Combine:"},{"type":"flow","items":["Flood","Earthquake","Landslide","Cyclone"],"sep":"+"},{"type":"p","text":"with population and infrastructure."},{"type":"h","text":"2. Urban Flood Risk Model"},{"type":"flow","items":["Rainfall","Hydrological Model","Flood Simulation","Inundation Map","Population / Buildings","Vulnerability","Risk Map"]},{"type":"h","text":"3. Climate Risk Dashboard"},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Temperature"},{"text":"Rainfall"},{"text":"Extreme events"},{"text":"Drought"},{"text":"Flood"},{"text":"Heatwave"}]},{"type":"h","text":"4. Earthquake Vulnerability Assessment"},{"type":"p","text":"Map building types and estimate relative vulnerability."},{"type":"h","text":"5. Disaster Damage Assessment"},{"type":"p","text":"Use satellite/drone imagery to identify post-event changes."},{"type":"h","text":"6. Critical Infrastructure Risk Model"},{"type":"p","text":"Model cascading effects across:"},{"type":"flow","items":["Power","Telecom","Water","Healthcare","Transport"]},{"type":"h","text":"7. Disaster Digital Twin"},{"type":"p","text":"Combine:"},{"type":"flow","items":["GIS","hazard models","real-time data","exposure","risk analytics"],"sep":"+"},{"type":"h","text":"Best Overall Positioning"},{"type":"p","text":"A disaster risk engineering professional specializing in hazard assessment, GIS, remote sensing, vulnerability and exposure analysis, climate risk, disaster modelling and infrastructure resilience, with strong Python, statistical and geospatial capabilities to transform hazard data into actionable risk intelligence and disaster-risk-reduction strategies."},{"type":"h","text":"Strongest positioning"},{"type":"flow","items":["Disaster Risk","GIS","Remote Sensing","Climate","Data Analytics","Infrastructure Resilience"],"sep":"+"},{"type":"p","text":"The strongest progression is:"},{"type":"p","text":"B.Tech/B.E. Disaster Management Engineering → Disaster Risk Intern → Junior Disaster Risk Analyst → Disaster Risk Analyst → Senior Risk/Resilience Analyst → Disaster Risk Specialist → Risk/Resilience Lead or Climate & Disaster Risk Manager."}]}]}