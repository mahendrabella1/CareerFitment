agement"},{"text":"CAPA"},{"text":"Change control"},{"text":"Design controls"}]},{"type":"h","text":"📑 Documentation"},{"type":"list","items":[{"text":"Technical files"},{"text":"Regulatory summaries"},{"text":"Standards matrices"},{"text":"Gap assessments"},{"text":"Regulatory correspondence"}]},{"type":"h","text":"🌎 Global"},{"type":"list","items":[{"text":"India"},{"text":"US"},{"text":"EU"},{"text":"UK"},{"text":"Canada"},{"text":"Australia"}]},{"type":"h","text":"💻 Digital"},{"type":"list","items":[{"text":"Excel"},{"text":"Power BI"},{"text":"eQMS"},{"text":"RIMS"},{"text":"Document management systems"},{"text":"Basic data analysis"}]},{"type":"h","text":"🤖 Future"},{"type":"list","items":[{"text":"SaMD"},{"text":"AI/ML medical devices"},{"text":"Medical-device cybersecurity"},{"text":"Digital health"},{"text":"Regulatory automation"},{"text":"AI-assisted regulatory intelligence"}]},{"type":"h","text":"Ideal Graduate Profile"},{"type":"p","text":"By graduation, the student should be able to demonstrate:"},{"type":"p","text":"“I understand biomedical products and can assess their regulatory requirements, prepare structured technical documentation, support risk-management and quality processes, interpret applicable standards, contribute to regulatory submissions, and track compliance throughout the medical-device lifecycle.”"},{"type":"p","text":"For Biomedical Engineering → Regulatory Affairs Specialist, the strongest combination is:"},{"type":"flow","items":["Biomedical Engineering","Medical-Device Regulations","ISO 13485","ISO 14971","Technical Writing","Quality Systems","Global Regulatory Knowledge","Digital Health."],"sep":"+"}]}]}