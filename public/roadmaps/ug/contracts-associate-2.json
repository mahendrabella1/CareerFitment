xt":"Contract disputes"},{"text":"Disciplinary disputes"},{"text":"Eligibility disputes"},{"text":"Athlete disputes"},{"text":"Commercial disputes"},{"text":"Arbitration"}]}]},{"heading":"Final Year — Sports Contract Practice","kind":"other","blocks":[{"type":"p","text":"The final year should focus on practical contract skills."},{"type":"h","text":"Contract Lifecycle"},{"type":"flow","items":["Business Requirement","Contract Request","Drafting","Legal Review","Commercial Review","Negotiation","Approval","Execution","Obligation Tracking","Renewal / Termination"]},{"type":"h","text":"Commercial Questions"},{"type":"p","text":"Before reviewing a contract, understand:"},{"type":"list","items":[{"text":"Who are the parties?"},{"text":"What is the commercial objective?"},{"text":"What is being delivered?"},{"text":"How much is being paid?"},{"text":"Who owns the rights?"},{"text":"Who bears the risk?"},{"text":"What happens if performance fails?"},{"text":"How can the agreement be terminated?"}]}]},{"heading":"Important Contract Clauses","kind":"other","blocks":[{"type":"table","header":["Clause","Sports-Specific Consideration"],"rows":[[{"text":"Scope"},{"text":"Services or sporting obligations"}],[{"text":"Term"},{"text":"Season / event / campaign duration"}],[{"text":"Compensation"},{"text":"Salary, fee, bonus or sponsorship payment"}],[{"text":"Performance"},{"text":"Performance obligations"}],[{"text":"Exclusivity"},{"text":"Competing teams/brands"}],[{"text":"Image Rights"},{"text":"Use of athlete identity"}],[{"text":"IP"},{"text":"Content, logos and branding"}],[{"text":"Sponsorship"},{"text":"Brand obligations"}],[{"text":"Confidentiality"},{"text":"Sensitive team/athlete information"}],[{"text":"Morality"},{"text":"Conduct-related provisions"}],[{"text":"Termination"},{"text":"Grounds for ending agreement"}],[{"text":"Indemnity"},{"text":"Allocation of losses"}],[{"text":"Liability"},{"text":"Financial exposure"}],[{"text":"Dispute Resolution"},{"text":"Court/a