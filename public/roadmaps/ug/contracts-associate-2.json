"},{"text":"Branding"},{"text":"Social media"},{"text":"Exclusivity"},{"text":"IP"},{"text":"Termination"}]},{"type":"h","text":"Project 3 — Sports Contract Tracker"},{"type":"p","text":"Build an Excel database containing:"},{"type":"list","items":[{"text":"Contract ID"},{"text":"Athlete/organization"},{"text":"Contract type"},{"text":"Start date"},{"text":"Expiry"},{"text":"Value"},{"text":"Sponsor"},{"text":"Rights"},{"text":"Renewal"},{"text":"Risk"}]},{"type":"h","text":"Project 4 — Broadcasting Rights Analysis"},{"type":"p","text":"Prepare a case study comparing:"},{"type":"list","items":[{"text":"Television rights"},{"text":"Streaming rights"},{"text":"Digital rights"},{"text":"Territorial rights"},{"text":"Exclusivity"},{"text":"Licensing fees"}]},{"type":"h","text":"Project 5 — Sports Contract Risk Dashboard"},{"type":"p","text":"Build a Power BI dashboard showing:"},{"type":"flow","items":["Total Contracts","Contract Value","Expiring Contracts","High-Risk Contracts","Sponsorship Contracts","Media Contracts"]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"h","text":"Year 1"},{"type":"list","items":[{"text":"General law firm"},{"text":"Legal research"},{"text":"Sports organization"}]},{"type":"h","text":"Year 2"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Commercial law firm"},{"text":"Corporate legal department"},{"text":"Sports federation"},{"text":"Sports agency"}]},{"type":"h","text":"Year 3"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Sports club"},{"text":"League"},{"text":"Sports management company"},{"text":"Athlete management agency"},{"text":"Media/sports broadcasting company"}]},{"type":"h","text":"Final Year"},{"type":"p","text":"Ideal internships:"},{"type":"list","items":[{"text":"Sports legal team"},{"text":"Sports management company"},{"text":"Commercial contracts team"},{"text":"Entertainment/sports law firm"},{"text":"Sponsorship/legal department"},{"text":"Sports media com