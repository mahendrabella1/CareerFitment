,{"text":"Incident management"},{"text":"Disaster management"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"GPS/fleet systems"},{"text":"Computer-aided dispatch"},{"text":"Excel"},{"text":"Power BI"},{"text":"Healthcare information systems"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Communication under pressure"},{"text":"Crisis communication"},{"text":"Patient privacy"},{"text":"Healthcare quality"},{"text":"Incident reporting"}]}]},{"heading":"Higher Education","kind":"other","blocks":[{"type":"p","text":"Relevant postgraduate directions may include:"},{"type":"list","items":[{"text":"M.Sc Emergency & Trauma Care"},{"text":"Master's in Emergency Medical Services"},{"text":"Master's in Healthcare Administration"},{"text":"Master of Hospital Administration (MHA)"},{"text":"MBA Healthcare Management"},{"text":"Disaster Management"},{"text":"Public Health / Health Administration"}]},{"type":"h","text":"Management pathway"},{"type":"flow","items":["Ambulance Coordinator","EMS Experience","MHA / MBA Healthcare","EMS Operations Supervisor","Ambulance Operations Manager","Regional EMS Manager"]}]},{"heading":"Career Specializations","kind":"other","blocks":[{"type":"h","text":"1. EMS Dispatch"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Emergency calls"},{"text":"Dispatch"},{"text":"Resource allocation"},{"text":"Communication"}]},{"type":"h","text":"2. Ambulance Fleet Management"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Vehicle availability"},{"text":"Maintenance"},{"text":"GPS"},{"text":"Utilization"},{"text":"Fleet planning"}]},{"type":"h","text":"3. Hospital Transfer Coordination"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Inter-hospital transfers"},{"text":"Bed availability"},{"text":"ICU transfers"},{"text":"Specialized transport"}]},{"type":"h","text":"4. Disaster & Mass-Casualty Management"},{"type":"p","text":"Focus on:"},{"type":"list","items"