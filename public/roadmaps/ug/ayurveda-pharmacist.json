itional formulation concepts"}]},{"type":"h","text":"Pharmacy"},{"type":"list","items":[{"text":"Pharmaceutical calculations"},{"text":"Formulation preparation"},{"text":"Dispensing principles"},{"text":"Storage"}]},{"type":"h","text":"Manufacturing"},{"type":"list","items":[{"text":"GMP"},{"text":"Production workflow"},{"text":"Batch documentation"},{"text":"Packaging"}]},{"type":"h","text":"Quality"},{"type":"list","items":[{"text":"Raw-material testing"},{"text":"Finished-product testing"},{"text":"Microbiology fundamentals"},{"text":"Quality documentation"}]},{"type":"h","text":"Operations"},{"type":"list","items":[{"text":"Inventory management"},{"text":"Procurement"},{"text":"Warehouse management"},{"text":"Batch traceability"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Excel"},{"text":"ERP"},{"text":"LIMS awareness"},{"text":"Digital inventory"},{"text":"Basic data analytics"}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"p","text":"Ayurvedic Pharmacy Foundation"},{"type":"p","text":"+"},{"type":"p","text":"Pharmacognosy & Medicinal Plants"},{"type":"p","text":"+"},{"type":"p","text":"Formulation Science"},{"type":"p","text":"+"},{"type":"p","text":"Pharmaceutical Chemistry"},{"type":"p","text":"+"},{"type":"p","text":"Manufacturing"},{"type":"p","text":"+"},{"type":"p","text":"GMP"},{"type":"p","text":"+"},{"type":"p","text":"Quality Control"},{"type":"p","text":"+"},{"type":"p","text":"Quality Assurance"},{"type":"p","text":"+"},{"type":"p","text":"Documentation & SOPs"},{"type":"p","text":"+"},{"type":"p","text":"Inventory & Supply Chain"},{"type":"p","text":"+"},{"type":"p","text":"Regulatory Awareness"},{"type":"p","text":"+"},{"type":"p","text":"ERP / LIMS / Digital Pharmacy"},{"type":"p","text":"+"},{"type":"p","text":"Excel & Data Analytics"},{"type":"p","text":"+"},{"type":"p","text":"Research & Product Development"}]},{"heading":"Best Overall Positioning","kind":"other","blocks":[{"type":"flow