xt":"Energy-efficient Architecture"}]},{"type":"h","text":"Urban / Planning"},{"type":"list","items":[{"text":"Urban Design"},{"text":"Urban Planning"},{"text":"Landscape Architecture"},{"text":"Regional Planning"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Building Information Modeling"},{"text":"Computational Design"},{"text":"Digital Architecture"},{"text":"Construction Technology"}]},{"type":"h","text":"Management"},{"type":"list","items":[{"text":"Construction Management"},{"text":"Project Management"},{"text":"Real Estate Development"}]},{"type":"h","text":"Career Specializations"}]},{"heading":"Architectural Design","kind":"other","blocks":[{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Concept design"},{"text":"Building design"},{"text":"Design development"},{"text":"Presentation"}]}]},{"heading":"BIM Architecture","kind":"other","blocks":[{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Revit"},{"text":"BIM coordination"},{"text":"Digital documentation"},{"text":"Multidisciplinary models"},{"text":"This is a strong technology-oriented pathway."}]}]},{"heading":"Sustainable Architecture","kind":"other","blocks":[{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Passive design"},{"text":"Energy efficiency"},{"text":"Building performance"},{"text":"Sustainable materials"},{"text":"Climate-responsive architecture"}]}]},{"heading":"Computational Architecture","kind":"other","blocks":[{"type":"p","text":"Combine:"},{"type":"list","items":[{"text":"Architecture"},{"text":"+"},{"text":"Parametric Design"},{"text":"+"},{"text":"Grasshopper / Dynamo"},{"text":"+"},{"text":"Python"},{"text":"+"},{"text":"Optimization"}]}]},{"heading":"Urban Design","kind":"other","blocks":[{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Public spaces"},{"text":"Streets"},{"text":"Mobility"},{"text":"Density"},{"text":"Urban form"},{"text":"Community needs"}]}]},{"heading":"Conservation Architecture","kind":"other","blocks":[{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Heritage buildings"},{"text":"Documentation"},{"text":"Restoration"},{"text":"Adaptive reuse"},{"text":"Cultural context"}]}]},{"heading":"Architectural Project Management","kind":"other","blocks":[{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Client management"},{"text":"Scheduling"},{"text":"Budget"},{"text":"Consultants"},{"text":"Contractors"},{"text":"Construction coordination"}]},{"type":"h","text":"Career Progression"},{"type":"flow","items":["Architectural Trainee","Junior Architect","Architect","Senior Architect","Project Architect","Associate / Design Lead","Principal Architect","Studio Director / Practice Head"]},{"type":"p","text":"Specialist route:"},{"type":"flow","items":["BIM Architect","Senior BIM Architect","BIM Manager","BIM / Digital Design Lead","Digital Architecture Director"]},{"type":"p","text":"Practice route:"},{"type":"flow","items":["Architect","Project Lead","Associate","Principal","Own Architectural Practice"]},{"type":"p","text":"Independent practice requires meeting the applicable professional registration and regulatory requirements."},{"type":"h","text":"Emerging Technologies to Learn"},{"type":"p","text":"Architecture is increasingly influenced by:"},{"type":"list","items":[{"text":"Generative design"},{"text":"AI-assisted design"},{"text":"BIM automation"},{"text":"Digital twins"},{"text":"Parametric architecture"},{"text":"Computational design"},{"text":"Building performance simulation"},{"text":"Digital fabrication"},{"text":"3D printing"},{"text":"Robotic construction"},{"text":"AR/VR"},{"text":"GIS"},{"text":"Smart buildings"},{"text":"Building IoT"},{"text":"Carbon-aware design"}]},{"type":"h","text":"Digital Twin Architecture"},{"type":"p","text":"An emerging workflow is:"},{"type":"flow","items":["BIM Model","Building Data","Sensors / IoT","Digital Twin","Performance Monitoring","Optimization"]},{"type":"p","tex