"},{"text":"Attention to data accuracy"}]}]},{"heading":"Final Portfolio Target","kind":"other","blocks":[{"type":"p","text":"By graduation, the student should have:"},{"type":"list","items":[{"text":"1 Sales MIS dashboard"},{"text":"1 HR/Finance MIS dashboard"},{"text":"1 automated Power Query reporting system"},{"text":"1 SQL reporting project"},{"text":"1 enterprise MIS/BI capstone"},{"text":"Advanced Excel"},{"text":"Power Query"},{"text":"Power BI"},{"text":"SQL"},{"text":"Basic Python"},{"text":"Data-modelling knowledge"},{"text":"At least 1 analytics/MIS internship"},{"text":"Experience working with real or realistic business datasets"}]},{"type":"h","text":"Target Graduate Profile"},{"type":"flow","items":["BBA Business Analytics","Management","Statistics","Excel","MIS","Data Cleaning","Power Query","SQL","Data Modelling","Power BI","Business KPIs","Reporting Automation","Business Analytics","Internship","MIS Executive","Senior MIS Executive","MIS/Reporting Analyst","BI Analyst","Analytics Lead","BI/Analytics Manager"]}]}]}