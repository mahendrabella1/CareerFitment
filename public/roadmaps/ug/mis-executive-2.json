[{"type":"p","text":"Power Query is particularly valuable because MIS work often involves repetitive data preparation."},{"type":"p","text":"Learn to:"},{"type":"list","items":[{"text":"Import data"},{"text":"Combine multiple files"},{"text":"Append tables"},{"text":"Merge tables"},{"text":"Remove duplicates"},{"text":"Handle missing values"},{"text":"Change data types"},{"text":"Split/merge columns"},{"text":"Transform dates"},{"text":"Standardize categories"},{"text":"Unpivot data"},{"text":"Automate recurring data preparation"}]},{"type":"p","text":"Example workflow:"},{"type":"flow","items":["Monthly Excel Files","Power Query","Clean Data","Consolidated Dataset","Power BI Dashboard"]}]},{"heading":"SQL","kind":"other","blocks":[{"type":"p","text":"SQL should become a core technical skill."},{"type":"h","text":"Fundamentals"},{"type":"p","text":"SELECT"},{"type":"p","text":"FROM"},{"type":"p","text":"WHERE"},{"type":"p","text":"DISTINCT"},{"type":"p","text":"ORDER BY"},{"type":"p","text":"GROUP BY"},{"type":"p","text":"HAVING"},{"type":"p","text":"CASE"},{"type":"h","text":"Intermediate"},{"type":"p","text":"INNER JOIN"},{"type":"p","text":"LEFT JOIN"},{"type":"p","text":"RIGHT JOIN"},{"type":"p","text":"UNION"},{"type":"p","text":"Subqueries"},{"type":"p","text":"CTEs"},{"type":"p","text":"Views"},{"type":"h","text":"Advanced"},{"type":"p","text":"Window Functions"},{"type":"p","text":"ROW_NUMBER()"},{"type":"p","text":"RANK()"},{"type":"p","text":"DENSE_RANK()"},{"type":"p","text":"LAG()"},{"type":"p","text":"LEAD()"},{"type":"p","text":"PARTITION BY"},{"type":"p","text":"Also learn:"},{"type":"list","items":[{"text":"Primary keys"},{"text":"Foreign keys"},{"text":"Normalization concepts"},{"text":"Relational databases"},{"text":"Index basics"},{"text":"NULL handling"},{"text":"Date functions"}]}]},{"heading":"Power BI","kind":"other","blocks":[{"type":"p","text":"Power BI should become a major part of the student's toolkit."},{"type":"h","text":"Learn"},{"type":"list","items":[{"text":"Data import"},{"text":"Power Query"},{"text":"Data transformation"},{"text":"Relationships"},{"text":"Data modelling"},{"text":"Star schema"},{"text":"Fact tables"},{"text":"Dimension tables"},{"text":"Measures"},{"text":"Calculated columns"},{"text":"Filters"},{"text":"Slicers"},{"text":"Drill-through"},{"text":"Bookmarks"},{"text":"Dashboard design"}]},{"type":"h","text":"DAX"},{"type":"p","text":"Understand:"},{"type":"p","text":"CALCULATE()"},{"type":"p","text":"FILTER()"},{"type":"p","text":"SUMX()"},{"type":"p","text":"AVERAGEX()"},{"type":"p","text":"COUNTROWS()"},{"type":"p","text":"DISTINCTCOUNT()"},{"type":"p","text":"ALL()"},{"type":"p","text":"VALUES()"},{"type":"p","text":"Build reusable measures rather than calculating everything manually in spreadsheets."}]},{"heading":"Data Modelling","kind":"other","blocks":[{"type":"p","text":"A strong MIS professional should understand how business data is structured."},{"type":"h","text":"Example"},{"type":"h","text":"Sales Fact"},{"type":"list","items":[{"text":"Sales ID"},{"text":"Product ID"},{"text":"Customer ID"},{"text":"Date ID"},{"text":"Salesperson ID"},{"text":"Quantity"},{"text":"Revenue"}]},{"type":"h","text":"Dimensions"},{"type":"list","items":[{"text":"Product"},{"text":"Customer"},{"text":"Date"},{"text":"Salesperson"},{"text":"Geography"}]},{"type":"p","text":"This leads to a:"},{"type":"flow","items":["Fact + Dimensions","Star Schema","BI Dashboard"]},{"type":"p","text":"Understanding data modelling makes Power BI and SQL reporting considerably stronger."}]},{"heading":"Business KPIs","kind":"other","blocks":[{"type":"p","text":"An MIS Executive should understand the business behind the numbers."},{"type":"h","text":"Sales"},{"type":"list","items":[{"text":"Revenue"},{"text":"Units sold"},{"text":"Average order value"},{"text":"Conversion rate"},{"text":"Target achievement"},{"text":"Growth rate"}]},{"type":"h","text":"Finance"},{"type":"list","items":[{"text":"Revenue"},{"text":"COGS"},{"text":"Gross margin"},{"text":"Operating expenses"},{"text":"Profit"},{"text":"Receivables"},{"text":"Payables"}]},{"type":"h","text":"HR"},{"type":"list","items":[{"text":"Headcount"},{"text":"Attrition"},{"text":"Absenteeism"},{"text":"Hiring"},{"text":"Time to hire"},{"text":"Employee cost"}]},{"type":"h","text":"Operations"},{"type":"list","items":[{"text":"Productivity"},{"text":"Order cycle time"},{"text":"On-time delivery"},{"text":"Inventory turnover"},{"text":"Utilization"},{"text":"SLA compliance"}]}]},{"heading":"Data Cleaning & Validation","kind":"other","blocks":[{"type":"p","text":"MIS reports must be reliable."},{"type":"p","text":"Learn to identify:"},{"type":"list","items":[{"text":"Duplicate records"},{"text":"Missing values"},{"text":"Incorrect dates"},{"text":"Invalid categories"},{"text":"Inconsistent names"},{"text":"Incorrect totals"},{"text":"Outliers"},{"text":"Formatting errors"},{"text":"Duplicate transactions"},{"text":"Incorrect joins"}]},{"type":"p","text":"Use validation checks such as:"},{"type":"h","text":"Source Total = Processed Total = Report Total"},{"type":"p","text":"Build reconciliation into recurring reporting workflows."}]},{"heading":"MIS Automation","kind":"other","blocks":[{"type":"p","text":"Move from:"},{"type":"flow","items":["Manual Excel","Repeatable Process","Automated Reporting"]},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Power Query automation"},{"text":"Excel templates"},{"text":"Scheduled refresh concepts"},{"text":"Power BI refresh"},{"text":"SQL-based reporting"},{"text":"Dashboard automation"},{"text":"Basic VBA awareness"},{"text":"Python automation"}]},{"type":"p","text":"Python is useful for:"},{"type":"list","items":[{"text":"File processing"},{"text":"Data cleaning"},{"text":"Report generation"},{"text":"Repetitive tasks"},{"text":"Large datasets"}]},{"type":"p","text":"Useful libraries:"},{"type":"list","items":[{"text":"pandas"},{"text":"NumPy"},{"text":"matplot