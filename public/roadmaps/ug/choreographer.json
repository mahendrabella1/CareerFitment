{"title":"Career Roadmap · Choreographer","role":"Choreographer","summary":"A Choreographer creates, designs and directs movement, dance sequences and performance concepts for stage productions, films, television, music videos, live events, advertising, digital content and cultural performances.","facts":{"Current degree":"BA (Bachelor of Arts - General / Honours)","Course":"Dance / Theatre / Performing Arts"},"about":[],"intro":[],"horizons":[],"sections":[{"heading":"Overview","kind":"other","blocks":[{"type":"flow","items":["The career combines dance technique","movement composition","music","storytelling","directing","performer management","production skills."],"sep":"+"},{"type":"p","text":"Typical route:"},{"type":"flow","items":["BA Performing Arts","Dance training","Performance portfolio","Assistant Choreographer","Choreographer","Senior Choreographer","Creative Director / Movement Director"]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Period","Career Stage","Primary Focus"],"rows":[[{"text":"2026–2027"},{"text":"Foundation"},{"text":"Dance technique + performance"}],[{"text":"2027–2028"},{"text":"Skill Building"},{"text":"Choreography + movement composition"}],[{"text":"2028–2029"},{"text":"Portfolio Development"},{"text":"Performances + assistant work"}],[{"text":"2029–2031"},{"text":"Entry"},{"text":"Dancer / Assistant Choreographer"}],[{"text":"2031–2034"},{"text":"Professional"},{"text":"Independent Choreographer"}],[{"text":"2034–2038"},{"text":"Senior"},{"text":"Lead Choreographer / Performance Director"}],[{"text":"2038–2042"},{"text":"Leadership"},{"text":"Creative Director / Movement Director"}],[{"text":"2042–2046"},{"text":"Senior Creative"},{"text":"Artistic Director / Choreography Studio Founder"}]]}]},{"heading":"What to Build Each Year","kind":"build","blocks":[{"type":"h","text":"Year 1 — Dance Foundation"},{"type":"p","text":"Build strong technical foundations in the chosen discipline."},{"type":"h