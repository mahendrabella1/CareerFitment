"},{"text":"Free/paid"},{"text":"Year 1–2"},{"text":"Domain knowledge"}],[{"text":"Python for Finance"},{"text":"Free/paid"},{"text":"Year 2–3"},{"text":"Financial analytics"}],[{"text":"AWS Cloud certification"},{"text":"Paid exam;"},{"text":"Year 3"},{"text":"Cloud systems"}],[{"text":"Microsoft Azure certification"},{"text":"Paid exam;"},{"text":"Year 3"},{"text":"Cloud systems"}],[{"text":"Cybersecurity fundamentals"},{"text":"Free/paid"},{"text":"Year 2–3"},{"text":"Financial-system security"}],[{"text":"Financial Risk Management course"},{"text":"Paid/varies"},{"text":"Year 2–4"},{"text":"Risk domain"}],[{"text":"CFA Program"},{"text":"Paid; current fee: check the official site"},{"text":"Year 3+"},{"text":"Finance depth, not a developer certification"}]]},{"type":"p","text":"For technical cloud certifications, check AWS Certification and Microsoft Credentials.","url":"https://aws.amazon.com/certification/"},{"type":"flow","items":["Software engineering","financial-domain understanding","projects > certificates."],"sep":"+","label":"Priority"}]},{"heading":"Careers you can be hired as","kind":"careers","blocks":[{"type":"h","text":"First-job targets"},{"type":"list","items":[{"text":"FinTech Developer"},{"text":"Junior FinTech Developer"},{"text":"FinTech Software Engineer"},{"text":"Banking Software Developer"},{"text":"Payments Developer"},{"text":"Backend Developer – FinTech"},{"text":"Java Developer – Banking"},{"text":"Financial Technology Associate"},{"text":"Application Developer – Financial Services"},{"text":"Software Engineer – Payments"},{"text":"Software Engineer – Banking"},{"text":"FinTech Analyst"},{"text":"Financial Data Analyst"},{"text":"Risk Technology Analyst"},{"text":"Technology Analyst – Financial Services"}]},{"type":"h","text":"Adjacent roles"},{"type":"list","items":[{"text":"Backend Engineer"},{"text":"Full Stack Developer"},{"text":"Data Engineer"},{"text":"Financial Data Engineer"},{"text":"Fraud Analyst"},{"text":"Risk Analyst"},{