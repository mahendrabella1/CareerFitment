text":"Documentation"},{"text":"ICU handover"}]}]},{"heading":"Core Technical Skill Stack","kind":"other","blocks":[{"type":"table","header":["Skill Area","Key Competency"],"rows":[[{"text":"Cardiac Anatomy"},{"text":"Heart & vascular structures"}],[{"text":"Cardiac Surgery"},{"text":"Surgical workflow awareness"}],[{"text":"OT Technology"},{"text":"Operating-room equipment"}],[{"text":"Sterile Technique"},{"text":"Infection prevention"}],[{"text":"Instruments"},{"text":"Cardiac surgical instruments"}],[{"text":"Monitoring"},{"text":"ECG, BP, SpO₂, temperature"}],[{"text":"Emergency"},{"text":"Defibrillation & emergency readiness"}],[{"text":"Anaesthesia"},{"text":"Anaesthesia workflow support"}],[{"text":"Perfusion"},{"text":"CPB workflow awareness"}],[{"text":"Equipment"},{"text":"Surgical & monitoring devices"}],[{"text":"Documentation"},{"text":"OT records"}],[{"text":"Teamwork"},{"text":"Multidisciplinary coordination"}]]}]},{"heading":"Cardiac OT Workflow","kind":"other","blocks":[{"type":"flow","items":["Pre-Operative Verification","OT Preparation","Equipment Readiness","Instrument Set Preparation","Sterile Field Preparation","Patient Transfer","Positioning & Skin Preparation","Anaesthesia Support","Surgical Procedure","Instrument / Sponge Counts","Specimen Handling","Closure","ICU Handover","OT Cleaning & Turnover"]}]},{"heading":"Cardiac Surgical Instrument Knowledge","kind":"other","blocks":[{"type":"p","text":"A Cardiac OT Technologist should develop familiarity with instruments used in cardiothoracic procedures."},{"type":"h","text":"Categories"},{"type":"list","items":[{"text":"Cutting instruments"},{"text":"Grasping instruments"},{"text":"Retractors"},{"text":"Needle holders"},{"text":"Clamps"},{"text":"Suction instruments"},{"text":"Sternal instruments"},{"text":"Vascular instruments"},{"text":"Cardiac-specific instruments"}]},{"type":"h","text":"Example workflow"},{"type":"flow","items":["Procedure Planned","Instrument Set Identified","Sterile Set Prepared","Instrument Count","Surgical Use","Final Count","Decontamination","Sterilization","Storage"]},{"type":"p","text":"The exact instrument set depends on the procedure and hospital protocol."}]},{"heading":"Cardiopulmonary Bypass Awareness","kind":"other","blocks":[{"type":"list","items":[{"text":"Cardiac OT Technologists frequently work around the perfusion team."},{"text":"They should understand the basic concept of cardiopulmonary bypass (CPB)."}]},{"type":"h","text":"Simplified concept"},{"type":"flow","items":["Patient Venous Blood","Venous Cannulation","Reservoir","Pump","Oxygenator","Heat Exchange","Arterial Return","Patient"]},{"type":"p","text":"The Perfusionist, not the Cardiac OT Technologist, is the specialized professional responsible for operating and managing the cardiopulmonary bypass system."}]},{"heading":"Cardiac Monitoring","kind":"other","blocks":[{"type":"p","text":"The technologist should understand the purpose and setup of:"},{"type":"list","items":[{"text":"ECG"},{"text":"SpO₂"},{"text":"Non-invasive BP"},{"text":"Invasive arterial pressure"},{"text":"Temperature"},{"text":"Capnography"},{"text":"Central venous pressure concepts"},{"text":"Cardiac output monitoring concepts"}]},{"type":"h","text":"Monitoring workflow"},{"type":"flow","items":["Patient","Sensors / Lines","Monitor","Continuous Data","Abnormality Recognition","Clinical Team Alert"]},{"type":"p","text":"The technologist supports equipment preparation and monitoring workflow; clinical interpretation belongs to qualified clinicians."}]},{"heading":"Cardiac Anaesthesia Support","kind":"other","blocks":[{"type":"p","text":"Cardiac surgery requires specialized anaesthesia preparation."},{"type":"p","text":"The Cardiac OT Technologist may assist with:"},{"type":"list","items":[{"text":"Anaesthesia equipment setup"},{"text":"Monitoring equipment"},{"text":"Airway equipment readiness"},{"text":"Infusion-pump setup"},{"text":"Emergency equipment"},{"text":"Blood-management supplies"},{"text":"Patient positioning"}]},{"type":"h","text":"Cardiac OT readiness"},{"type":"list","items":[{"text":"Anaesthesia Workstation"},{"text":"+"},{"text":"Patient Monitor"},{"text":"+"},{"text":"Airway Equipment"},{"text":"+"},{"text":"Infusion Pumps"},{"text":"+"},{"text":"Defibrillator"},{"text":"+"},{"text":"Suction"},{"text":"+"}]},{"type":"flow","items":["Emergency Equipment","OT Ready"]},{"type":"p","text":"Medication selection and administration remain within the scope of authorized clinicians and trained personnel."}]},{"heading":"Defibrillator & Emergency Equipment","kind":"other","blocks":[{"type":"p","text":"Cardiac OT environments require immediate access to emergency equipment."},{"type":"p","text":"Students should understand:"},{"type":"list","items":[{"text":"Defibrillator"},{"text":"External pacing concepts"},{"text":"Emergency suction"},{"text":"Bag-mask ventilation"},{"text":"Emergency airway equipment"},{"text":"Resuscitation trolley"},{"text":"Emergency medications awareness"}]},{"type":"h","text":"Emergency workflow"},{"type":"flow","items":["Emergency Detected","Alert Surgical / Anaesthesia Team","Emergency Equipment Ready","Assist Resuscitation","Monitor","Document"]}]},{"heading":"Sterile Technique & Infection Control","kind":"other","blocks":[{"type":"p","text":"Cardiac surgery requires extremely strict infection-control practices."},{"type":"h","text":"Essential competencies"},{"type":"list","items":[{"text":"Surgical hand preparation"},{"text":"Sterile gowning/gloving"},{"text":"Sterile field maintenance"},{"text":"Instrument handling"},{"text":"Surgical-site preparation"},{"text":"Equipment decontamination"},{"text":"Sterilization workflow"},{"text":"Biomedical waste segregation"}]},{"type":"h","text":"Instrument cycle"},{"type":"flow","items":["Used Instruments","Safe Transport","Decontamination","Cleaning","Inspection","Packaging","Sterilization","Storage","Sterile Use"]}]},{"heading":"Surgical Counts","kind":"other","blocks":[{"type":"p","text":"Accurate counting is a critical patient-safety responsibility."},{"type":"p","text":"Depending on hospital protocol, counts may include:"},{"type":"list","items":[{"text":"Instruments"},{"text":"Sponges"},{"text":"Needles"},{"text":"Other relevant items"}]},{"type":"h","text":"Basic workflow"},{"type":"flow","items":["Initial Count","During Procedure","Closure Count","Final Count","Documentation"]},{"type":"p","text":"Any discrepancy should be immediately escalated according to institutional protocol."}]},{"heading":"Patient Positioning","kind":"other","blocks":[{"type":"p","text":"Cardiac surgery may require specialized positioning."},{"type":"p","text":"The technologist should understand:"},{"type":"list","items":[{"text":"Supine positioning"},{"text":"Pressure-point protection"},{"text":"Patient alignment"},{"text":"Padding"},{"text":"Secure transfer"},{"text":"Prevention of nerve/pressure injuries"}]},{"type":"h","text":"Safety principle"},{"type":"flow","items":["Position","Check Alignment","Protect Pressure Points","Secure Patient","Verify Monitoring Access","Document"]}]},{"heading":"Blood & Blood-Product Workflow Awareness","kind":"other","blocks":[{"type":"p","text":"Cardiac surgery may involve significant blood-management requirements."},{"type":"p","text":"The technologist should understand:"},{"type":"list","items":[{"text":"Blood-product identification"},{"text":"Storage principles"},{"text":"Transfusion-safety workflow"},{"text":"Documentation"},{"text":"Blood-warming equipment"},{"text":"Cell-salvage awareness"},{"text":"They should follow institutional protocols and work with authorized clinical/laboratory professionals."}]}]},{"heading":"Digital & Technology Skills","kind":"other","blocks":[{"type":"p","text":"Modern cardiac OTs use increasingly integrated technology."},{"type":"h","text":"Essential"},{"type":"list","items":[{"text":"Hospital Information Systems"},{"text":"EMR"},{"text":"OT management systems"},{"text":"Digital patient