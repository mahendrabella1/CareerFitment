rity"},{"type":"list","items":[{"text":"Basic Life Support"},{"text":"Advanced cardiac life-support exposure where appropriate"},{"text":"Infection control"},{"text":"Surgical asepsis"},{"text":"Patient safety"},{"text":"OT technology"},{"text":"Cardiac anatomy"}]},{"type":"h","text":"Advanced"},{"type":"list","items":[{"text":"Cardiac surgical technology"},{"text":"Cardiac anaesthesia support"},{"text":"Critical-care monitoring"},{"text":"Perfusion fundamentals"},{"text":"ECMO awareness"},{"text":"TEE equipment awareness"},{"text":"Cardiac emergency response"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Medical-device management"},{"text":"Equipment maintenance"},{"text":"OT information systems"},{"text":"Excel"},{"text":"Power BI"},{"text":"Certifications should complement recognized academic and supervised clinical training."}]}]},{"heading":"PG & Advanced Education","kind":"pg_india","blocks":[{"type":"p","text":"Depending on eligibility:"},{"type":"h","text":"Cardiac / Allied Health"},{"type":"list","items":[{"text":"M.Sc Cardiac Care Technology"},{"text":"M.Sc Operation Theatre Technology"},{"text":"M.Sc Anaesthesia Technology"},{"text":"Advanced cardiac technology programs"}]},{"type":"h","text":"Critical Care"},{"type":"list","items":[{"text":"Critical Care Technology"},{"text":"Cardiovascular technology"}]},{"type":"h","text":"Healthcare Management"},{"type":"list","items":[{"text":"MBA Healthcare Management"},{"text":"Hospital Administration"},{"text":"Healthcare Operations"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Health Informatics"},{"text":"Medical Device Technology"},{"text":"Healthcare Technology Management"}]},{"type":"note","label":"Important","text":"Perfusion technology should be treated as a separate specialist pathway requiring the appropriate recognized perfusion qualification rather than assuming that a Cardiac OT qualification automatically qualifies someone as a Perfusionist."}]},{"heading":"Career Specializations","kind":"other","blocks":[{"type":"h","text":"1. Cardiac Surgery OT Technologist"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"CABG"},{"text":"Valve surgery"},{"text":"Aortic surgery"},{"text":"Congenital cardiac procedures"}]},{"type":"h","text":"2. Cardiothoracic OT Technologist"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Cardiac surgery"},{"text":"Thoracic surgery"},{"text":"Chest procedures"},{"text":"Major vascular procedures"}]},{"type":"h","text":"3. Cardiac Anaesthesia OT Technologist"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Anaesthesia equipment"},{"text":"Advanced monitoring"},{"text":"Airway support"},{"text":"Cardiac anaesthesia workflow"}]},{"type":"h","text":"4. Pediatric Cardiac OT Technologist"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Congenital heart surgery"},{"text":"Pediatric equipment"},{"text":"Pediatric monitoring"},{"text":"Specialized surgical workflow"}]},{"type":"h","text":"5. Cardiac Device Applications Specialist"},{"type":"p","text":"Industry pathway involving:"},{"type":"list","items":[{"text":"Surgical devices"},{"text":"Monitoring equipment"},{"text":"Cardiac OT products"},{"text":"Clinical applications"},{"text":"Hospital training"}]},{"type":"h","text":"6. OT Coordinator"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Scheduling"},{"text":"Equipment"},{"text":"Consumables"},{"text":"Staff coordination"},{"text":"Quality and safety"},{"text":"Theatre efficiency"}]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"h","text":"0–2 Years"},{"type":"flow","items":["Recognized Qualification","Clinical Internship","Cardiac OT Trainee","Junior Cardiac OT Technologist"]},{"type":"h","text":"2–5 Years"},{"type":"flow","items":["Cardiac OT Technologist","Advanced Cardiac Surgery Exposure","Senior Cardiac OT Technologist"]},{"type":"h","text":"5–10 Years"},{"type":"flow","items":["Senior Technologist","