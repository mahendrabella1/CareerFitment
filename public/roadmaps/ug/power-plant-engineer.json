":"list","items":[{"text":"Digital power plants"},{"text":"Predictive maintenance"},{"text":"Smart grids"},{"text":"Renewable integration"},{"text":"Battery energy storage"},{"text":"Grid-scale power electronics"},{"text":"SCADA/DCS"},{"text":"Industrial cybersecurity"},{"text":"Digital twins"},{"text":"AI-based fault detection"},{"text":"Energy efficiency"},{"text":"Grid stability"}]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"h","text":"Government / PSU routes"},{"type":"table","header":["Route","Relevant area","Eligibility/pay","Link"],"rows":[[{"text":"NTPC"},{"text":"Power generation, plant operations, electrical maintenance"},{"text":"Check the official site"},{"text":"NTPC","url":"https://www.ntpc.co.in/"}],[{"text":"NHPC"},{"text":"Hydro power generation and plant engineering"},{"text":"Check the official site"},{"text":"NHPC","url":"https://www.nhpcindia.com/"}],[{"text":"POWERGRID"},{"text":"Transmission and grid engineering"},{"text":"Check the official site"},{"text":"POWERGRID","url":"https://www.powergrid.in/"}],[{"text":"BHEL"},{"text":"Power equipment, turbines, generators and engineering"},{"text":"Check the official site"},{"text":"BHEL","url":"https://www.bhel.com/"}],[{"text":"NPCIL"},{"text":"Nuclear power generation and engineering"},{"text":"Check the official site"},{"text":"NPCIL","url":"https://www.npcil.nic.in/"}],[{"text":"NLC India"},{"text":"Thermal/mining/energy operations"},{"text":"Check the official site"},{"text":"NLC India","url":"https://www.nlcindia.in/"}]]},{"type":"h","text":"Private-sector routes"},{"type":"list","items":[{"text":"Power-generation companies"},{"text":"Renewable-energy developers"},{"text":"EPC companies"},{"text":"Industrial automation companies"},{"text":"Electrical equipment manufacturers"},{"text":"Turbine/generator manufacturers"},{"text":"Energy-management companies"},{"text":"Power-system consulting firms"}]},{"type":"h","text":"Best internship progression"},{"type":"flow","items