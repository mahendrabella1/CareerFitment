{"title":"Career Roadmap: CAD Designer","role":"CAD Designer","summary":"Career Domain: Media, Communication, Arts & Design · Qualification Pathway: B.Des – Product / Industrial Design · Target Career: CAD Designer","facts":{"Current degree":"B.Des (Bachelor of Design)","Course":"Product / Industrial Design"},"about":[{"label":"About this roadmap","text":"This roadmap was drafted with AI assistance from OneGrasp's related roadmaps and is awaiting expert review. Check fees, dates, eligibility and exam patterns on the official websites before you rely on them."}],"intro":[],"horizons":[],"sections":[{"heading":"Career Overview","kind":"other","blocks":[{"type":"p","text":"A CAD Designer turns product ideas and sketches into precise 3D models and drawings that factories can make - from appliances and furniture to medical devices and consumer gadgets."},{"type":"h","text":"What a CAD Designer does"},{"type":"list","items":[{"text":"Build 3D models and assemblies from sketches and briefs"},{"text":"Prepare manufacturing drawings with dimensions and tolerances"},{"text":"Create renders and prototypes for reviews"},{"text":"Revise designs with engineers and manufacturers"}]},{"type":"p","text":"Where they work:"},{"type":"list","items":[{"text":"Product design studios"},{"text":"Consumer-goods and appliance makers"},{"text":"Furniture and lighting companies"},{"text":"Engineering and prototyping firms"}]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Career stage","Typical role"],"rows":[[{"text":"Entry-level"},{"text":"Junior CAD Designer"}],[{"text":"Early career"},{"text":"CAD Designer"}],[{"text":"Mid-level"},{"text":"Senior CAD Designer"}],[{"text":"Senior"},{"text":"Lead Designer"}],[{"text":"Leadership"},{"text":"Design Manager"}]]}]},{"heading":"Year-by-Year Learning Roadmap","kind":"build","blocks":[{"type":"h","text":"Year 1: Design foundations"},{"type":"list","items":[{"text":"Sketching, form and materials"},{"text":"Learn a first CAD tool (Fusion 360)"},{"text":"Model 10 everyday objects accurately"}]},{"type":"h","text":"Year 2: CAD depth"},{"type":"list","items":[{"text":"Learn SolidWorks or Rhino properly, with assemblies"},{"text":"Study manufacturing processes (moulding, sheet metal, CNC)"},{"text":"3D-print your own prototypes"}]},{"type":"h","text":"Year 3: Real products"},{"type":"list","items":[{"text":"Intern at a product studio or manufacturer"},{"text":"Learn rendering (KeyShot) and technical drawing standards"},{"text":"Design a product from brief to working prototype"}]},{"type":"h","text":"Year 4: Portfolio and placement"},{"type":"list","items":[{"text":"Final project with full CAD data and drawings"},{"text":"Build an online portfolio (Behance)"},{"text":"Earn a CAD certification and apply"}]}]},{"heading":"Essential Skills","kind":"build","blocks":[{"type":"table","header":["Skill","Type"],"rows":[[{"text":"3D CAD modelling"},{"text":"Technical"}],[{"text":"Technical drawings and tolerances"},{"text":"Technical"}],[{"text":"Design for manufacturing"},{"text":"Technical"}],[{"text":"Rendering and prototyping"},{"text":"Technical"}],[{"text":"Precision"},{"text":"Professional"}],[{"text":"Working with engineers"},{"text":"Professional"}],[{"text":"Taking feedback"},{"text":"Professional"}]]}]},{"heading":"Tools and Technologies to Learn","kind":"build","blocks":[{"type":"list","items":[{"text":"SolidWorks"},{"text":"Fusion 360"},{"text":"Rhino"},{"text":"KeyShot"},{"text":"3D printers"}]}]},{"heading":"Internships and Practical Experience","kind":"internships","blocks":[{"type":"list","items":[{"text":"Product design studios"},{"text":"Appliance or furniture makers"},{"text":"Prototyping labs"}]}]},{"heading":"Certifications and Additional Training","kind":"certifications","blocks":[{"type":"list","items":[{"text":"Certified SolidWorks Associate (CSWA)"},{"text":"Autodesk Certified Professional (Fusion 360)"}]},{"type":"note","label":"Before you enrol","text":"Check the current syllabus, fees and eligibility on the certifying body's official website."}]},{"heading":"Higher Education Options in India","kind":"pg_india","blocks":[{"type":"p","text":"Options after your degree:"},{"type":"list","items":[{"text":"M.Des Product / Industrial Design"},{"text":"M.Tech Product Design"}]},{"type":"p","text":"Entrance exams and tests to know:"},{"type":"list","items":[{"text":"CEED"},{"text":"NID DAT (M.Des)"}]}]},{"heading":"Study Abroad Options","kind":"abroad","blocks":[{"type":"list","items":[{"text":"MA / MSc Industrial Design (Europe, UK)"}]}]},{"heading":"Career Opportunities","kind":"careers","blocks":[{"type":"p","text":"Roles a CAD Designer can grow into or move across to:"},{"type":"list","items":[{"text":"Product Designer"},{"text":"Industrial Designer"},{"text":"Design Engineer"},{"text":"Prototyping Specialist"}]}]},{"heading":"Recommended Career Progression","kind":"growth","blocks":[{"type":"flow","items":["Junior CAD Designer","CAD Designer","Senior CAD Designer","Lead Designer","Design Manager"]}]}],"drafted":true}