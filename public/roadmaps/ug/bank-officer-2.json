"text":"Financial statement analysis"},{"text":"Financial ratios"},{"text":"Interest/EMI"},{"text":"Financial markets"},{"text":"Investment fundamentals"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Excel"},{"text":"Power BI"},{"text":"SQL"},{"text":"Digital banking"},{"text":"FinTech"},{"text":"Python basics"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Customer service"},{"text":"Communication"},{"text":"Negotiation"},{"text":"Problem solving"},{"text":"Numerical reasoning"},{"text":"Presentation"},{"text":"Leadership"}]}]},{"heading":"Final Portfolio Target","kind":"other","blocks":[{"type":"p","text":"By graduation, the student should ideally have:"},{"type":"list","items":[{"text":"1 banking operations project"},{"text":"1 credit-analysis project"},{"text":"1 Power BI banking dashboard"},{"text":"1 SQL banking analytics project"},{"text":"1 integrated banking capstone"},{"text":"Banking/finance internship"},{"text":"Strong quantitative aptitude"},{"text":"Banking awareness/current-affairs preparation"}]},{"type":"flow","items":["Excel","Power BI","SQL proficiency"],"sep":"+"},{"type":"list","items":[{"text":"Professional communication skills"},{"text":"Competitive banking exam preparation where applicable"}]},{"type":"h","text":"Target Graduate Profile"},{"type":"flow","items":["BBA Banking & Insurance","Banking Fundamentals","Accounting & Finance","Banking Operations","Credit & Lending","Risk & Compliance","Digital Banking","Excel","SQL","Power BI","Internship","Banking Exam/Recruitment Preparation","Banking Executive/Officer Entry","Senior Officer","Manager","Branch/Credit/Risk Leadership"]}]}]}