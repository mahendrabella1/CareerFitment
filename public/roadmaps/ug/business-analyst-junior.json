roject 2 — Digital Payment Failure Analysis"},{"type":"p","text":"Analyse a simulated payment dataset."},{"type":"p","text":"Identify:"},{"type":"list","items":[{"text":"Failed transactions"},{"text":"Failure reasons"},{"text":"Banks"},{"text":"Devices"},{"text":"Locations"},{"text":"Time periods"},{"text":"Transaction types"}]},{"type":"p","text":"Produce:"},{"type":"flow","items":["Problem","Root cause","Business impact","Proposed solution","KPI"]},{"type":"h","text":"Project 3 — FinTech Product Requirements"},{"type":"p","text":"Design a digital banking/payment product."},{"type":"p","text":"Create:"},{"type":"list","items":[{"text":"Business case"},{"text":"Stakeholder map"},{"text":"BRD"},{"text":"User personas"},{"text":"User stories"},{"text":"Use cases"},{"text":"Process flows"},{"text":"Acceptance criteria"},{"text":"Wireframes"},{"text":"KPI framework"}]},{"type":"p","text":"This is an excellent BA portfolio project."},{"type":"h","text":"Project 4 — Loan Application Process Improvement"},{"type":"p","text":"Map:"},{"type":"flow","items":["Customer application","KYC","credit assessment","approval","disbursement"]},{"type":"p","text":"Analyse:"},{"type":"list","items":[{"text":"Bottlenecks"},{"text":"Manual steps"},{"text":"Risk points"},{"text":"Customer experience"},{"text":"Automation opportunities"}]},{"type":"p","text":"Create an As-Is vs To-Be process."},{"type":"h","text":"Project 5 — Fraud Analytics Case Study"},{"type":"p","text":"Use a synthetic/public dataset."},{"type":"p","text":"Analyse:"},{"type":"list","items":[{"text":"Transaction patterns"},{"text":"Fraud indicators"},{"text":"Customer behaviour"},{"text":"False positives"},{"text":"Detection performance"}]},{"type":"p","text":"Do not use confidential financial/customer data."},{"type":"h","text":"Specialisation options"},{"type":"table","header":["Lane","Core stack","Senior role it leads to"],"rows":[[{"text":"FinTech BA"},{"text":"Banking, payments, SQL, requirements"},{"text":"Senior Fi