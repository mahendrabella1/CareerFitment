"text":"Advanced"}],[{"text":"Excel"},{"text":"Basics"},{"text":"Advanced"},{"text":"Automation"}],[{"text":"Power BI"},{"text":"—"},{"text":"Basics"},{"text":"Intermediate"},{"text":"Advanced"}],[{"text":"SQL"},{"text":"—"},{"text":"Basics"},{"text":"Intermediate"},{"text":"Practical"}],[{"text":"Python"},{"text":"—"},{"text":"Basics"},{"text":"pandas"},{"text":"Finance analytics"}],[{"text":"Communication"},{"text":"Strong"},{"text":"Professional"},{"text":"Customer-facing"}],[{"text":"Sales"},{"text":"Introduction"},{"text":"Products"},{"text":"Cross-selling"},{"text":"Relationship management"}],[{"text":"Compliance"},{"text":"Basics"},{"text":"KYC"},{"text":"AML/fraud"},{"text":"Risk"}],[{"text":"Digital Banking"},{"text":"Basics"},{"text":"Payments"},{"text":"FinTech"},{"text":"Digital banking"}]]}]},{"heading":"Practical Projects","kind":"other","blocks":[{"type":"p","text":"A B.Com student should build evidence of financial and banking knowledge."},{"type":"h","text":"Project 1 — Banking Operations Dashboard"},{"type":"p","text":"Create a Power BI dashboard showing:"},{"type":"list","items":[{"text":"Deposits"},{"text":"Withdrawals"},{"text":"Account openings"},{"text":"Transactions"},{"text":"Customer segments"},{"text":"Branch performance"},{"text":"Product usage"}]},{"type":"p","text":"Use synthetic or public data."},{"type":"h","text":"Project 2 — Loan EMI & Credit Analysis"},{"type":"p","text":"Build an Excel/Python model that calculates:"},{"type":"list","items":[{"text":"Loan amount"},{"text":"Interest rate"},{"text":"Tenure"},{"text":"EMI"},{"text":"Total interest"},{"text":"Loan repayment schedule"}]},{"type":"p","text":"Add:"},{"type":"list","items":[{"text":"Debt-to-income ratio"},{"text":"Credit-risk indicators"},{"text":"Scenario analysis"}]},{"type":"h","text":"Project 3 — Banking Customer Analysis"},{"type":"p","text":"Analyse a synthetic customer dataset."},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Age"},{"text":"Income"},{"text":"Account type"},{"text":"Transaction frequency"},{"text":"Product usage"},{"text":"Loan status"},{"text":"Customer retention"}]},{"type":"p","text":"Create a Power BI dashboard."},{"type":"h","text":"Project 4 — KYC/AML Case Study"},{"type":"p","text":"Create a simulated banking compliance workflow:"},{"type":"flow","items":["Customer onboarding","KYC verification","Transaction monitoring","Risk flag","Investigation","Resolution"]},{"type":"p","text":"Do not use real customer data."},{"type":"h","text":"Project 5 — Digital Banking Analysis"},{"type":"p","text":"Compare customer adoption of:"},{"type":"list","items":[{"text":"UPI"},{"text":"Mobile banking"},{"text":"Internet banking"},{"text":"Cards"},{"text":"Branch transactions"}]},{"type":"p","text":"Create a report identifying opportunities to improve digital adoption."}]},{"heading":"Important Banking Skills","kind":"other","blocks":[{"type":"table","header":["Skill","Importance"],"rows":[[{"text":"Banking Operations"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Accounting"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Customer Service"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Financial Products"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"KYC/AML"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Excel"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Communication"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Basic Credit Analysis"},{"text":"⭐⭐⭐⭐"}],[{"text":"Financial Analysis"},{"text":"⭐⭐⭐⭐"}],[{"text":"Power BI"},{"text":"⭐⭐⭐"}],[{"text":"SQL"},{"text":"⭐⭐⭐"}],[{"text":"Digital Banking"},{"text":"⭐⭐⭐⭐"}],[{"text":"Sales/Relationship Management"},{"text":"⭐⭐⭐⭐"}],[{"text":"Python"},{"text":"⭐⭐–⭐⭐⭐"}],[{"text":"FinTech"},{"text":"⭐⭐⭐⭐"}]]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Start internships during 2nd or 3rd year."},{"type":"h","text":"Target internships"},{"type":"list","items":[{"text":"Banking Operations Intern"},{"text":"Finance Intern"},{"text":"Banking Intern"},{"text":"Credit Analyst Intern"},{"text":"Financial Services Intern"},{"text":"KYC/AML Intern"},{"text":"FinTech Operations Intern"},{"text":"Relationship Management Intern"},{"text":"Investment Operations Intern"},{"text":"Risk Operations Intern"}]},{"type":"h","text":"Where to apply"},{"type":"list","items":[{"text":"Commercial banks"},{"text":"Private banks"},{"text":"Cooperative banks"},{"text":"NBFCs"},{"text":"FinTech companies"},{"text":"Payment companies"},{"text":"Financial-services companies"},{"text":"Wealth-management firms"},{"text":"Insurance companies"},{"text":"Loan-processing companies"}]},{"type":"p","text":"Try to obtain practical exposure to:"},{"type":"flow","items":["KYC","customer onboarding","banking operations","Excel","financial products","compliance."],"sep":"+"}]},{"heading":"Banking Exams & Certifications","kind":"certifications","blocks":[{"type":"p","text":"For students targeting Indian public-sector banking, examination preparation can be an important parallel track."},{"type":"p","text":"Common areas include:"},{"type":"list","items":[{"text":"Quantitative aptitude"},{"text":"Reasoning"},{"text":"English"},{"text":"General awareness"},{"text":"Banking awareness"},{"text":"Computer awareness"},{"text":"Current affairs"}]},{"type":"p","text":"Recruitment structures, eligibility and exam patterns vary by institution and change over time, so students should verify the latest official notification before preparing around a particular exam."},{"type":"h","text":"Useful additional learning"},{"type":"list","items":[{"text":"NISM certifications for relevant financial-services paths"},{"text":"Financial modelling"},{"text":"Advanced Excel"},{"text":"AML/KYC courses"},{"text":"Credit analysis"},{"text":"FinTech fundamentals"},{"text":"Banking operations"}]},{"type":"p","text":"A certification should complement practical skills rather than replace them."}]},{"heading":"Jobs You Can Be Hired For","kind":"careers","blocks":[{"type":"h","text":"Direct Entry"},{"type":"p","text":"A B.Com graduate can target:"},{"type":"list","items":[{"text":"Banking Associate"},{"text":"Banking Operations Associate"},{"text":"Bank Clerk"},{"text":"Customer Service Associate"},{"text":"Customer Service Executive"},{"text":"Banking Operations Executive"},{"text":"Branch Operations Executive"},{"text":"Banking Executive"},{"text":"Relationship Executive"},{"text":"Relationship Associate"},{"text":"Teller/Cashier"},{"text":"KYC Executive"},{"text":"KYC Analyst – Junior"},{"text":"Banking Back-Office Executive"},{"text":"Loan Processing Executive"},{"text":"Credit Operations Executive"},{"text":"Financial Services Associate"},{"text":"FinTech Operations Associate"},{"text":"Transaction Processing Associate"}]},{"type":"h","text":"With Additional Finance Skills"},{"type":"list","items":[{"text":"Junior Credit Analyst"},{"text":"Credit Operations Analyst"},{"text":"Financial Operations Analyst"},{"text":"Risk Operations Analyst"},{"text":"AML Analyst – Junior"},{"text":"Compliance Operations Associate"},{"text":"Treasury Operations Associate"},{"text":"Investment Operations Associate"}]}]},{"heading":"Public-Sector Banking Path","kind":"other","blocks":[{"type":"p","text":"For candidates interested in public-sector banks, the pathway is generally:"},{"type":"h","text":"B.Com"},{"type":"h","text":"Banking/Competitive Exam Preparation"},{"type":"h","text":"Relevant Recruitment Examination"},{"type":"h","text":"Selection Process"},{"type":"h","text":"Banking Role"},{"type":"h","text":"Officer/Senior Responsibilities"},{"type":"p","text":"The exact recruitment route depends on the institution and position. Do not assume that every “Banking Associate” position uses the same examination or eligibility criteria."}]},{"heading":"Private Banking Path","kind":"other","blocks":[{"type":"p","text":"A private-sector route can be more directly job-oriented:"},{"type":"h","text":"B.Com"},{"type":"h","text":"Banking Internship"},{"type":"h","text":"Customer Service / Banking Operations / Relationship Role"},{"type":"h","text":"Senior Associate / Officer"},{"type":"h","text":"Assistant Manager"},{"type":"h","text":"Branch Operations / Relationship Manager"},{"type":"h","text":"Branch Manager"},{"type":"h","text":"Regional / Business Leadership"},{"type":"p","text":"Private banking may also provide specialist paths into:"},{"type":"list","items":[{"text":"Credit"},{"text":"Wealth management"},{"text":"Risk"},{"text":"Compliance"},{"text":"Treasury"},{"text":"Digital banking"},{"text":"FinTech"},{"text":"Business analytics"}]}]},{"heading":"Postgraduate Options in India","kind":"pg_india","blocks":[{"type":"p","text":"A postgraduate degree is not mandatory for entering banking."},{"type":"h","text":"Strong options"},{"type":"table","header":["PG","Best For"],"rows":[[{"text":"M.Com"},{"text":"Banking/accounting/finance"}],[{"text":"MBA Finance"},{"text":"Corporate finance/credit/banking"}],[{"text":"MBA Banking & Financial Services"},{"text":"Banking"}],[{"text":"MBA Finance & Banking"},{"text":"Banking/finance"}],[{"text":"MBA Business Analytics"},{"text":"Banking analytics"}],[{"text":"MBA FinTech"},{"text":"Digital banking"}],[{"text":"M.Sc Finance"},{"text":"Finance/analytics"}],[{"text":"M.Sc Financial Economics"},{"text":"Financial analysis"}],[{"text":"CA/ACCA/CMA pathways"},{"text":"Accounting/finance specialist careers"}]]},{"type":"p","text":"For a student specifically targeting banking operations, experience and relevant recruitment preparation can be more valuable initially than pursuing a PG immediately."}]},{"heading":"Study Abroad","kind":"abroad","blocks":[{"type":"p","text":"Relevant master's programmes include:"},{"type":"list","items":[{"text":"MSc Banking and Finance"},{"text":"MSc Finance"},{"text":"MSc Financial Economics"},{"text":"MSc Financial Technology"},{"text":"MSc Risk Management"},{"text":"MSc Business Analytics"},{"text":"MSc Accounting & Finance"},{"text":"MSc International Banking"}]},{"type":"p","text":"Potential destinations:"},{"type":"list","items":[{"text":"UK"},{"text":"Ireland"},{"text":"Canada"},{"text":"Australia"},{"text":"Germany"},{"text":"Netherlands"},{"text":"Singapore"}]},{"type":"p","text":"International banking roles can have local regulatory, work-authorisation and qualification requirements, so these should be checked before selecting a programme."}]},{"heading":"Specialisation Options","kind":"other","blocks":[{"type":"p","text":"After gaining banking experience, the graduate can specialise in:"},{"type":"h","text":"Credit"},{"type":"flow","items":["Credit Associate","Credit Analyst","Senior Credit Analyst","Credit Manager"]},{"type":"h","text":"Risk"},{"type":"flow","items":["Risk Operations","Risk Analyst","Senior Risk Analyst","Risk Manager"]},{"type":"h","text":"Compliance"},{"type":"flow","items":["KYC/AML Associate","Compliance Analyst","Senior Compliance Analyst","Compliance Manager"]},{"type":"h","text":"Wealth Management"},{"type":"flow","items":["Relationship Associate","Relationship Manager","Wealth Manager"]},{"type":"h","text":"Banking Analytics"},{"type":"flow","items":["MIS/Reporting","Banking Data Analyst","Senior Analyst","Banking Analytics Manager"]},{"type":"h","text":"FinTech"},{"type":"flow","items":["Banking Operations","FinTech Operations","Product/Payments Analyst","FinTech Product Manager"]},{"type":"h","text":"Branch Banking"},{"type":"flow","items":["Banking Associate","Officer","Assistant Manager","Branch Manager","Regional Manager"]}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"Branch Banking Track"},{"type":"h","text":"Banking Associate"},{"type":"h","text":"Senior Banking Associate / Officer"},{"type":"h","text":"Assistant Manager"},{"type":"h","text":"Branch Operations Manager"},{"type":"h","text":"Branch Manager"},{"type":"h","text":"Regional Manager"},{"type":"h","text":"Senior Regional Leadership"},{"type":"h","text":"Specialist Track"},{"type":"h","text":"Banking Associate"},{"type":"h","text":"Specialist Associate"},{"type":"h","text":"Analyst"},{"type":"h","text":"Senior Analyst"},{"type":"h","text":"Manager"},{"type":"h","text":"Senior Manager"},{"type":"h","text":"Functional Head"}]},{"heading":"AI-Era Banking Skills","kind":"other","blocks":[{"type":"p","text":"Banking is rapidly becoming data-driven and digital."},{"type":"p","text":"Students should understand:"},{"type":"h","text":"AI applications"},{"type":"list","items":[{"text":"Fraud detection"},{"text":"Credit scoring"},{"text":"Customer segmentation"},{"text":"Transaction monitoring"},{"text":"Chatbots"},{"text":"Document processing"},{"text":"OCR/KYC automation"},{"text":"Financial forecasting"},{"text":"Personalised banking"},{"text":"AML alert prioritisation"}]},{"type":"h","text":"Human skills remain important"},{"type":"p","text":"AI does not remove the need for:"},{"type":"list","items":[{"text":"Customer communication"},{"text":"Financial judgement"},{"text":"Compliance judgement"},{"text":"Ethical decision-making"},{"text":"Fraud investigation"},{"text":"Relationship management"},{"text":"Exception handling"}]},{"type":"p","text":"The future banking professional should therefore combine:"},{"type":"flow","items":["Finance","Banking","Data","Technology","Compliance"],"sep":"+"}]},{"heading":"Future Career Opportunities: 2040–2046","kind":"other","blocks":[{"type":"p","text":"The traditional branch-only banking role is likely to continue shifting toward digitally enabled financial services."},{"type":"p","text":"Potential future roles include:"},{"type":"list","items":[{"text":"Digital Banking Specialist"},{"text":"Banking Data Analyst"},{"text":"AI Banking Operations Specialist"},{"text":"AI Fraud Analyst"},{"text":"Financial Crime Analytics Specialist"},{"text":"Digital Risk Analyst"},{"text":"AI-Assisted Credit Analyst"},{"text":"Banking Automation Specialist"},{"text":"FinTech Operations Manager"},{"text":"Digital Banking Product Manager"},{"text":"Financial AI Governance Specialist"}]},{"type":"p","text":"The strongest long-term profile will be someone who understands both financial services and technology."}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"h","text":"Core Commerce"},{"type":"flow","items":["Accounting","Economics","Finance","Business Law"],"sep":"+"},{"type":"h","text":"Banking"},{"type":"flow","items":["Banking Operations","Financial Products","Payments","Credit"],"sep":"+"},{"type":"h","text":"Compliance"},{"type":"flow","items":["KYC","AML","Fraud Prevention","Data Privacy"],"sep":"+"},{"type":"h","text":"Technology"},{"type":"flow","items":["Excel","Power BI","SQL","Basic Python"],"sep":"+"},{"type":"h","text":"Professional"},{"type":"flow","items":["Communication","Customer Service","Documentation","Negotiation"],"sep":"+"},{"type":"h","text":"Future"},{"type":"flow","items":["Digital Banking","FinTech","AI","Data Analytics"],"sep":"+"},{"type":"h","text":"Ideal Graduate Profile"},{"type":"p","text":"By graduation, the student should be able to:"},{"type":"list","items":[{"text":"Explain how commercial banking works."},{"text":"Understand major banking products."},{"text":"Handle basic customer/account operations."},{"text":"Understand KYC and AML fundamentals."},{"text":"Explain UPI, NEFT, RTGS and other payment mechanisms."},{"text":"Perform basic credit and loan analysis."},{"text":"Use advanced Excel."},{"text":"Build a banking dashboard in Power BI."},{"text":"Write basic SQL queries."},{"text":"Analyse customer and transaction data."},{"text":"Understand digital banking and FinTech."},{"text":"Communicate professionally with customers."},{"text":"Prepare for relevant banking recruitment examinations."},{"text":"Demonstrate practical banking knowledge through projects/internships."}]},{"type":"h","text":"Best Practical Path"},{"type":"flow","items":["B.Com General","Banking Fundamentals","Accounting & Finance","KYC/AML","Advanced Excel","Banking Operations","Credit Basics","Power BI + SQL","Banking/Finance Internship","Banking Associate / Banking Operations Associate","Senior Associate/Officer","Assistant Manager","Branch/Operations Manager"]},{"type":"note","label":"For stronger long-term employability","text":"add Excel + SQL + Power BI + FinTech + credit/risk/compliance knowledge. This allows a B.Com graduate to move beyond routine branch operations into banking analytics, credit, risk, compliance, digital banking and FinTech."}]}]}