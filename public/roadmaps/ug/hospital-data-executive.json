]},{"heading":"Data Quality Framework","kind":"other","blocks":[{"type":"p","text":"A professional should evaluate data across:"},{"type":"table","header":["Dimension","Question"],"rows":[[{"text":"Accuracy"},{"text":"Is the information correct?"}],[{"text":"Completeness"},{"text":"Are required fields populated?"}],[{"text":"Consistency"},{"text":"Do systems agree?"}],[{"text":"Timeliness"},{"text":"Is the data current?"}],[{"text":"Validity"},{"text":"Does it follow required formats?"}],[{"text":"Uniqueness"},{"text":"Are duplicates present?"}],[{"text":"Integrity"},{"text":"Are relationships between records maintained?"}]]}]},{"heading":"Hospital Dashboard Example","kind":"other","blocks":[{"type":"h","text":"A management dashboard might contain:"},{"type":"h","text":"Hospital Performance Dashboard"},{"type":"h","text":"Patient Volume"},{"type":"h","text":"├── OPD Visits"},{"type":"h","text":"├── Admissions"},{"type":"h","text":"├── Discharges"},{"type":"h","text":"└── Emergency Visits"},{"type":"h","text":"Capacity"},{"type":"h","text":"├── Bed Occupancy"},{"type":"h","text":"├── ICU Occupancy"},{"type":"h","text":"└── OT Utilization"},{"type":"h","text":"Efficiency"},{"type":"h","text":"├── Average Length of Stay"},{"type":"h","text":"├── Waiting Time"},{"type":"h","text":"└── Turnaround Time"},{"type":"h","text":"Quality"},{"type":"h","text":"├── Readmission Rate"},{"type":"h","text":"├── Patient Safety Events"},{"type":"h","text":"└── Infection Indicators"},{"type":"h","text":"Financial"},{"type":"h","text":"├── Revenue"},{"type":"h","text":"├── Claims"},{"type":"h","text":"└── Department Performance"}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"h","text":"Priority 1 — Medical Records"},{"type":"h","text":"Focus on:"},{"type":"list","items":[{"text":"Patient records"},{"text":"Data validation"},{"text":"Record completion"},{"text":"Coding"},{"text":"Retrieval"}]},{"type":"h","text":"Priority 2 — Hospital MIS"},{"type":"h","text":