cation"},{"text":"Infrastructure"},{"text":"Robotics"},{"text":"Smart cities"}]},{"type":"h","text":"Real-Time 3D"},{"type":"p","text":"Game engines will increasingly be used beyond games for:"},{"type":"list","items":[{"text":"Simulation"},{"text":"Training"},{"text":"Product design"},{"text":"Visualization"},{"text":"Virtual production"},{"text":"Industrial applications"}]},{"type":"h","text":"Multimodal Interaction"},{"type":"p","text":"Future spatial interfaces may combine:"},{"type":"flow","items":["Vision","Voice","Gesture","Touch","AI"],"sep":"+"},{"type":"p","text":"Therefore, the strongest future profile combines:"},{"type":"flow","items":["3D","UX","Programming","XR","Human-Computer Interaction","AI."],"sep":"+"}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"h","text":"3D"},{"type":"list","items":[{"text":"Blender"},{"text":"3D modelling"},{"text":"UV mapping"},{"text":"Materials"},{"text":"Texturing"},{"text":"Lighting"},{"text":"Animation"}]},{"type":"h","text":"Interaction"},{"type":"list","items":[{"text":"Spatial UX"},{"text":"Interaction design"},{"text":"Prototyping"},{"text":"User testing"},{"text":"Accessibility"},{"text":"Haptics"}]},{"type":"h","text":"XR"},{"type":"list","items":[{"text":"AR"},{"text":"VR"},{"text":"MR"},{"text":"OpenXR"},{"text":"AR Foundation"},{"text":"XR Interaction Toolkit"}]},{"type":"h","text":"Development"},{"type":"list","items":[{"text":"Unity"},{"text":"C#"},{"text":"Unreal fundamentals"},{"text":"C++ basics"}]},{"type":"h","text":"Web"},{"type":"list","items":[{"text":"JavaScript/TypeScript"},{"text":"Three.js"},{"text":"React Three Fiber"}]},{"type":"h","text":"Design"},{"type":"list","items":[{"text":"Figma"},{"text":"Photoshop"},{"text":"UX research"},{"text":"Visual design"}]}]},{"heading":"Final Portfolio Target","kind":"other","blocks":[{"type":"p","text":"By graduation, the student should ideally have:"},{"type":"list","items":[{"text":"3–5 interactive 3D/XR projects"},{"text"