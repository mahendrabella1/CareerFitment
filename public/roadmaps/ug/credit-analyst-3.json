{"title":"Credit Analyst Roadmap","role":"Credit Analyst","summary":"Move from basic financial analysis toward data-driven credit decisions.","facts":{"Current degree":"BBA / BMS / BBM – FinTech"},"about":[],"intro":[],"horizons":[],"sections":[{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Stage","Typical Roles"],"rows":[[{"text":"Entry"},{"text":"Credit Analyst Intern, Credit Operations Intern, Junior Credit Analyst"}],[{"text":"Early Career"},{"text":"Credit Analyst, Credit Underwriting Analyst, Credit Risk Analyst"}],[{"text":"Mid Career"},{"text":"Senior Credit Analyst, Credit Risk Specialist, Corporate Credit Analyst"}],[{"text":"Advanced"},{"text":"Credit Manager, Credit Risk Manager, Underwriting Manager"}],[{"text":"Leadership"},{"text":"Head of Credit, Chief Credit Officer, Chief Risk Officer"}]]}]},{"heading":"What to Build Each Year","kind":"build","blocks":[{"type":"h","text":"Year 1 — Finance & FinTech Foundation"},{"type":"p","text":"Build fundamentals in:"},{"type":"list","items":[{"text":"Financial Accounting"},{"text":"Business Economics"},{"text":"Business Mathematics"},{"text":"Statistics"},{"text":"Corporate Finance"},{"text":"Banking Fundamentals"},{"text":"Financial Markets"},{"text":"FinTech Fundamentals"},{"text":"Business Communication"}]},{"type":"h","text":"Accounting Skills"},{"type":"p","text":"Learn to understand:"},{"type":"list","items":[{"text":"Income Statement"},{"text":"Balance Sheet"},{"text":"Cash Flow Statement"},{"text":"Notes to accounts"},{"text":"Working capital"},{"text":"Debt"},{"text":"Equity"},{"text":"Revenue"},{"text":"Profitability"},{"text":"Cash generation"}]},{"type":"h","text":"Technology"},{"type":"p","text":"Start with:"},{"type":"list","items":[{"text":"Excel"},{"text":"PowerPoint"},{"text":"Google Sheets"},{"text":"Basic SQL"},{"text":"Basic financial data analysis"}]},{"type":"h","text":"Projects"},{"type":"list","items":[{"text":"Financial statement analysis"},{"text":"