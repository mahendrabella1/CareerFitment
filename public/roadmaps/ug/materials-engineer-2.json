:"Computational materials science"},{"text":"Additive manufacturing"},{"text":"Lightweight alloys"},{"text":"Hydrogen materials"},{"text":"Battery materials"},{"text":"Semiconductor materials"},{"text":"Advanced composites"},{"text":"Circular materials"},{"text":"Low-carbon metallurgy"}]},{"type":"p","text":"The future Materials Engineer will increasingly combine:"},{"type":"flow","items":["Materials Science","Manufacturing","Simulation","Data Science","AI."],"sep":"+"},{"type":"h","text":"Recommended Final Skill Stack"},{"type":"h","text":"🔬 Materials"},{"type":"list","items":[{"text":"Materials science"},{"text":"Physical metallurgy"},{"text":"Phase transformations"},{"text":"Ferrous/non-ferrous metallurgy"},{"text":"Polymers"},{"text":"Ceramics"},{"text":"Composites"}]},{"type":"h","text":"🧪 Characterisation"},{"type":"list","items":[{"text":"Metallography"},{"text":"SEM/EDS"},{"text":"XRD"},{"text":"FTIR"},{"text":"DSC/TGA"},{"text":"Mechanical testing"}]},{"type":"h","text":"⚙️ Manufacturing"},{"type":"list","items":[{"text":"Casting"},{"text":"Forging"},{"text":"Welding"},{"text":"Heat treatment"},{"text":"Machining"},{"text":"Additive manufacturing"}]},{"type":"h","text":"🛡️ Reliability"},{"type":"list","items":[{"text":"Failure analysis"},{"text":"Fracture mechanics"},{"text":"Fatigue"},{"text":"Creep"},{"text":"Corrosion"},{"text":"NDT"}]},{"type":"h","text":"💻 Digital"},{"type":"list","items":[{"text":"Python"},{"text":"MATLAB"},{"text":"Excel"},{"text":"CAD"},{"text":"ANSYS/Abaqus/COMSOL"},{"text":"Materials databases"},{"text":"Statistical analysis"}]},{"type":"h","text":"🤖 Future"},{"type":"list","items":[{"text":"Materials informatics"},{"text":"Machine learning"},{"text":"Computational materials science"},{"text":"AI-driven materials discovery"},{"text":"Digital twins"},{"text":"Automated experimentation"}]},{"type":"h","text":"Ideal Graduate Profile"},{"type":"p","text":"By graduation, the student should ideally be able to demonstrate:"},{"type":"p",