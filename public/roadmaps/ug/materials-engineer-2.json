":"Materials Science"},{"text":"Metallurgy"},{"text":"Advanced Materials"},{"text":"Aerospace Materials"},{"text":"Materials Characterisation"}]},{"type":"h","text":"🇨🇦 Canada"},{"type":"p","text":"Relevant areas:"},{"type":"list","items":[{"text":"Materials Engineering"},{"text":"Metallurgical Engineering"},{"text":"Mining & Materials"},{"text":"Advanced Materials"},{"text":"Energy Materials"}]},{"type":"h","text":"🇦🇺 Australia"},{"type":"p","text":"Relevant areas:"},{"type":"list","items":[{"text":"Materials Engineering"},{"text":"Metallurgy"},{"text":"Mining & Materials"},{"text":"Corrosion"},{"text":"Advanced manufacturing"}]},{"type":"h","text":"🇸🇬 Singapore"},{"type":"p","text":"Relevant areas:"},{"type":"list","items":[{"text":"Materials Science"},{"text":"Semiconductor materials"},{"text":"Advanced manufacturing"},{"text":"Nanomaterials"},{"text":"Energy materials"}]},{"type":"h","text":"International Application Pack"},{"type":"p","text":"Prepare:"},{"type":"h","text":"Academic"},{"type":"list","items":[{"text":"B.Tech degree"},{"text":"Transcripts"},{"text":"CV"},{"text":"SOP"},{"text":"Recommendation letters"},{"text":"English-language test where required"}]},{"type":"h","text":"Technical portfolio"},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Material-selection project"},{"text":"Metallography project"},{"text":"Heat-treatment study"},{"text":"Failure-analysis report"},{"text":"Characterisation project"},{"text":"Research internship"},{"text":"Advanced-materials project"}]},{"type":"p","text":"For research-oriented programmes, a research project + laboratory experience + strong technical recommendation can be more valuable than a long list of generic certificates."}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"p","text":"A typical industry pathway:"},{"type":"flow","items":["B.Tech Metallurgical & Materials Engineering","Materials / Metallurgy Intern","Graduate Materials Engineer","Materials Engineer","Senior M