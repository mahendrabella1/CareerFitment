act lifecycle management"},{"text":"Contract databases"},{"text":"Renewal tracking"},{"text":"Obligation tracking"},{"text":"Legal operations"}]},{"type":"p","text":"The student should graduate with the ability to take a contract from:"},{"type":"flow","items":["Request","Draft","Review","Negotiate","Approve","Sign","Manage","Renew/Terminate"]}]},{"heading":"Core Contract Skill Stack","kind":"other","blocks":[{"type":"table","header":["Skill","Target Level"],"rows":[[{"text":"Contract Law"},{"text":"Advanced"}],[{"text":"Contract Drafting"},{"text":"Advanced"}],[{"text":"Contract Review"},{"text":"Advanced"}],[{"text":"Contract Negotiation"},{"text":"Advanced"}],[{"text":"Media Law"},{"text":"Advanced"}],[{"text":"Entertainment Law"},{"text":"Advanced"}],[{"text":"Copyright"},{"text":"Advanced"}],[{"text":"Trademark"},{"text":"Intermediate–Advanced"}],[{"text":"Licensing"},{"text":"Advanced"}],[{"text":"Legal Research"},{"text":"Advanced"}],[{"text":"Legal Writing"},{"text":"Advanced"}],[{"text":"Risk Analysis"},{"text":"Advanced"}],[{"text":"Due Diligence"},{"text":"Intermediate–Advanced"}],[{"text":"Contract Management"},{"text":"Advanced"}],[{"text":"Commercial Awareness"},{"text":"Advanced"}],[{"text":"Technology Law"},{"text":"Intermediate"}],[{"text":"AI & Contracts"},{"text":"Intermediate"}]]}]},{"heading":"Contract Lifecycle","kind":"other","blocks":[{"type":"p","text":"A Contracts Associate should understand the entire lifecycle."},{"type":"flow","items":["Business Request","Requirement Gathering","Identify Contract Type","Draft / Select Template","Legal Review","Business Review","Negotiation","Redlining","Risk Approval","Execution / Signature","Contract Repository","Obligation Tracking","Renewal / Amendment","Expiry / Termination"]}]},{"heading":"Contract Drafting","kind":"other","blocks":[{"type":"p","text":"The student should learn how to structure a professional agreement."},{"type":"h","text":"Typical Structure"},{"type":"list","items":[{"text":"1. Par