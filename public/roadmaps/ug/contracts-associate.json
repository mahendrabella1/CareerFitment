s"},{"text":"Cancellation"},{"text":"Reputation-related provisions"}]}]},{"heading":"Contract Risk Analysis","kind":"other","blocks":[{"type":"p","text":"A Contracts Associate should be able to classify risk."},{"type":"table","header":["Risk","Example"],"rows":[[{"text":"IP Risk"},{"text":"Unclear ownership"}],[{"text":"Financial Risk"},{"text":"Unlimited payment exposure"}],[{"text":"Liability Risk"},{"text":"Broad indemnity"}],[{"text":"Operational Risk"},{"text":"Impossible delivery timelines"}],[{"text":"Regulatory Risk"},{"text":"Non-compliant content"}],[{"text":"Reputation Risk"},{"text":"Broad morality/reputation clause"}],[{"text":"Data Risk"},{"text":"Improper handling of personal data"}],[{"text":"Commercial Risk"},{"text":"Unfavorable exclusivity"}],[{"text":"Termination Risk"},{"text":"No practical exit mechanism"}]]}]},{"heading":"Clause-by-Clause Review","kind":"other","blocks":[{"type":"p","text":"A professional contract review should ask:"},{"type":"h","text":"Parties"},{"type":"p","text":"Who is legally bound?"},{"type":"h","text":"Scope"},{"type":"p","text":"What exactly must each party do?"},{"type":"h","text":"Payment"},{"type":"p","text":"How much? When? Under what conditions?"},{"type":"h","text":"Rights"},{"type":"p","text":"Who owns the IP?"},{"type":"h","text":"Licence"},{"type":"p","text":"What rights are being granted?"},{"type":"h","text":"Territory"},{"type":"p","text":"Where?"},{"type":"h","text":"Term"},{"type":"p","text":"For how long?"},{"type":"h","text":"Exclusivity"},{"type":"p","text":"Can the party work with others?"},{"type":"h","text":"Liability"},{"type":"p","text":"Who bears the risk?"},{"type":"h","text":"Indemnity"},{"type":"p","text":"Who compensates whom if something goes wrong?"},{"type":"h","text":"Termination"},{"type":"p","text":"When can the contract end?"},{"type":"h","text":"Dispute Resolution"},{"type":"p","text":"How will disputes be handled?"}]},{"heading":"Contract Negotiation","kind":"other","blocks":[{"typ