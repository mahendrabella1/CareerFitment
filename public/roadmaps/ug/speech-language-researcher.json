onetics"},{"text":"Phonology"},{"text":"Syntax"},{"text":"Semantics"},{"text":"Psycholinguistics"},{"text":"Sociolinguistics"}]},{"type":"h","text":"Speech science"},{"type":"list","items":[{"text":"IPA"},{"text":"Acoustic phonetics"},{"text":"Speech perception"},{"text":"Speech production"},{"text":"Prosody"},{"text":"Speech signal analysis"}]},{"type":"h","text":"Research"},{"type":"list","items":[{"text":"Experimental design"},{"text":"Statistics"},{"text":"Research methodology"},{"text":"Corpus construction"},{"text":"Academic writing"},{"text":"Research ethics"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Praat"},{"text":"ELAN"},{"text":"Python"},{"text":"R"},{"text":"NumPy/pandas"},{"text":"Signal processing"},{"text":"NLP"},{"text":"Machine learning"}]},{"type":"h","text":"Speech AI"},{"type":"list","items":[{"text":"ASR"},{"text":"TTS"},{"text":"Speech translation"},{"text":"Voice interfaces"},{"text":"Speech datasets"},{"text":"Model evaluation"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Scientific communication"},{"text":"Presentation"},{"text":"Literature review"},{"text":"Project management"},{"text":"Interdisciplinary collaboration"}]},{"type":"h","text":"Target progression"},{"type":"table","header":["Stage","Target"],"rows":[[{"text":"Year 1"},{"text":"Linguistics + phonetics foundations"}],[{"text":"Year 2"},{"text":"Speech science + statistics + research"}],[{"text":"Year 3"},{"text":"Python + speech technology + research project"}],[{"text":"Graduation"},{"text":"Research Assistant / Speech Research Intern"}],[{"text":"Years 1–3"},{"text":"Speech/Linguistics Researcher"}],[{"text":"Years 3–6"},{"text":"Senior Researcher / Computational Linguist"}],[{"text":"Years 6–10"},{"text":"Speech Scientist / Research Lead"}],[{"text":"10+ years"},{"text":"Principal Researcher / Research Director / Professor"}]]},{"type":"h","text":"Best employability combination"},{"type":"flow","items":["BA Linguistics","MA/MSc Linguistics/Speech Technology","phonetics","Praat","statistics","Python","NLP","speech processing","research publications/projects","Indian-language speech expertise"],"sep":"+"},{"type":"note","label":"Key principle","text":"A strong Speech-Language Researcher should combine deep linguistic understanding with experimental research and technical capability. The highest-value profile is not simply someone who understands language, but someone who can collect and analyse speech data, design rigorous experiments, evaluate speech technologies and translate linguistic insight into research or real-world language technology."}]}]}