s"},{"text":"Matter management"},{"text":"Legal analytics"},{"text":"Knowledge management"}]},{"type":"h","text":"Consulting"},{"type":"list","items":[{"text":"Requirements gathering"},{"text":"Process analysis"},{"text":"Solution evaluation"},{"text":"Presentation"},{"text":"Business-case development"},{"text":"Project management"}]},{"type":"h","text":"Portfolio"},{"type":"p","text":"At least:"},{"type":"list","items":[{"text":"1 contract-tech project"},{"text":"1 AI governance project"},{"text":"1 legal analytics dashboard"},{"text":"1 workflow automation project"},{"text":"1 legal technology case study"}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"list","items":[{"text":"LAW"},{"text":"├── Contract Law"},{"text":"├── Technology Law"},{"text":"├── Cyber Law"},{"text":"├── Privacy & Data Protection"},{"text":"├── Intellectual Property"},{"text":"└── AI Governance"},{"text":"LEGAL OPERATIONS"},{"text":"├── Workflow Design"},{"text":"├── CLM"},{"text":"├── Matter Management"},{"text":"├── Legal Analytics"},{"text":"└── Knowledge Management"},{"text":"TECHNOLOGY"},{"text":"├── AI / LLM Fundamentals"},{"text":"├── APIs"},{"text":"├── Cloud Fundamentals"},{"text":"├── Databases"},{"text":"└── Cybersecurity Fundamentals"},{"text":"DATA"},{"text":"├── Excel"},{"text":"├── Power BI"},{"text":"├── SQL"},{"text":"└── Data Visualization"},{"text":"AUTOMATION"},{"text":"├── Workflow Automation"},{"text":"├── RPA Concepts"},{"text":"├── No-Code / Low-Code"},{"text":"└── API Integration"},{"text":"CONSULTING"},{"text":"├── Requirements Gathering"},{"text":"├── Process Mapping"},{"text":"├── Technology Evaluation"},{"text":"├── Project Management"},{"text":"├── Client Communication"},{"text":"└── Change Management"}]}]},{"heading":"Best Overall Positioning","kind":"other","blocks":[{"type":"p","text":"The strongest positioning for this career is:"},{"type":"flow","items":["Integrated Law","Technology Law","Legal Operations","AI Governance","L