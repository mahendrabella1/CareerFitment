ext":"PYTHON / DATA ANALYTICS"},{"text":"+"},{"text":"GEOTECHNICAL MONITORING"}]},{"type":"h","text":"Target Profile by Graduation"},{"type":"p","text":"By the end of B.Tech/B.E., the student should be able to:"},{"type":"list","items":[{"text":"Interpret geological conditions from an engineering perspective"},{"text":"Classify soils and rocks"},{"text":"Understand soil and rock behaviour"},{"text":"Plan basic site investigations"},{"text":"Interpret borehole logs"},{"text":"Understand SPT/CPT results"},{"text":"Perform fundamental laboratory soil tests"},{"text":"Understand permeability and seepage"},{"text":"Apply effective-stress principles"},{"text":"Analyze shear strength"},{"text":"Understand consolidation and settlement"},{"text":"Perform basic bearing-capacity calculations"},{"text":"Understand pile foundations"},{"text":"Perform basic slope-stability analysis"},{"text":"Design concepts for retaining structures"},{"text":"Understand excavation-support systems"},{"text":"Assess basic liquefaction susceptibility"},{"text":"Understand rock-mass classification"},{"text":"Use GIS for geotechnical/geohazard mapping"},{"text":"Perform basic numerical modelling"},{"text":"Interpret geotechnical instrumentation"},{"text":"Analyze monitoring data"},{"text":"Prepare technical geotechnical reports"},{"text":"Understand construction-stage geotechnical risks"}]},{"type":"h","text":"Ideal Portfolio"},{"type":"p","text":"A strong graduate portfolio should contain 5–7 technically defensible projects."},{"type":"h","text":"1. Building Foundation Study"},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Borehole interpretation"},{"text":"Soil profile"},{"text":"Laboratory parameters"},{"text":"Bearing capacity"},{"text":"Settlement"},{"text":"Foundation recommendation"}]},{"type":"h","text":"2. Slope Stability Study"},{"type":"p","text":"Analyze:"},{"type":"flow","items":["Natural Slope","Geological Conditions","Groundwater","Soil/Rock Parameters","Limit Equilibrium","Factor of Safety","Stabilization"]},{"type":"h","text":"3. GIS Landslide Susceptibility Map"},{"type":"p","text":"Use:"},{"type":"list","items":[{"text":"DEM"},{"text":"Slope"},{"text":"Geology"},{"text":"Rainfall"},{"text":"Land use"},{"text":"Drainage"}]},{"type":"h","text":"4. Deep Excavation Model"},{"type":"p","text":"Use a numerical package to investigate:"},{"type":"list","items":[{"text":"Wall movement"},{"text":"Ground settlement"},{"text":"Excavation stages"},{"text":"Groundwater"}]},{"type":"h","text":"5. Geotechnical Laboratory Database"},{"type":"p","text":"Build a structured database containing:"},{"type":"list","items":[{"text":"Boreholes"},{"text":"Soil classifications"},{"text":"SPT values"},{"text":"Atterberg limits"},{"text":"Shear strength"},{"text":"Consolidation parameters"}]},{"type":"h","text":"6. Geotechnical Monitoring Dashboard"},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Settlement"},{"text":"Pore pressure"},{"text":"Lateral movement"},{"text":"Groundwater"}]},{"type":"h","text":"7. Digital Ground Model"},{"type":"list","items":[{"text":"Boreholes"},{"text":"+"},{"text":"Geology"},{"text":"+"},{"text":"Geophysics"},{"text":"+"}]},{"type":"flow","items":["Laboratory Tests","3D Ground Model","Engineering Parameters","Foundation / Slope / Tunnel Analysis"]},{"type":"h","text":"Best Overall Positioning"},{"type":"p","text":"A geological and geotechnical engineering professional who combines engineering geology, soil mechanics, rock mechanics, site investigation, foundation engineering, slope stability, geotechnical modelling, GIS and field instrumentation to characterize subsurface conditions and design safe, reliable and economical foundations and infrastructure systems."},{"type":"h","text":"Strongest positioning"},{"type":"flow","items":["Engineering Geology","Soil/Rock Mechanics","Site Investigation","Foundation/Slope Engineering","Numerical Modelling","GIS"],"sep":"+"},{"type":"p","text":"The strongest progression is:"},{"type":"p","text":"B.Tech/B.E. Geological / Applied Geology Engineering → Geotechnical Intern → Junior Geotechnical Engineer → Geotechnical Engineer → Senior Geotechnical Engineer → Principal Geotechnical Engineer → Geotechnical Technical Lead / Specialist."}]}]}