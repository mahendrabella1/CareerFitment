{"title":"Impact Consultant — Career Roadmap","role":"Impact Consultant","summary":"Career focus: An Impact Consultant helps organisations design and implement solutions that create measurable social, environmental, and economic impact. The role combines design thinking, sustainability, research, stakeholder engagement, programme strategy, impact measurement and systems thinking.","facts":{"Current degree":"B.Des (Bachelor of Design)","Course":"Design for Social Innovation / Sustainable Design"},"about":[],"intro":[],"horizons":[],"sections":[{"heading":"Career Overview","kind":"other","blocks":[{"type":"p","text":"An Impact Consultant works with companies, NGOs, governments, foundations, social enterprises and development organisations to solve complex social or environmental problems."},{"type":"h","text":"Typical Responsibilities"},{"type":"list","items":[{"text":"Identify social/environmental challenges"},{"text":"Conduct stakeholder and user research"},{"text":"Design impact programmes"},{"text":"Develop sustainability strategies"},{"text":"Facilitate workshops"},{"text":"Map systems and stakeholders"},{"text":"Evaluate programmes"},{"text":"Develop impact frameworks"},{"text":"Measure social/environmental outcomes"},{"text":"Prepare impact reports"},{"text":"Support ESG and sustainability initiatives"},{"text":"Develop recommendations for organisations"},{"text":"Coordinate with communities and implementation partners"}]},{"type":"h","text":"Core Position"},{"type":"flow","items":["Designer","Researcher","Strategist","Impact Measurement Professional"],"sep":"+"}]},{"heading":"Career Horizons — 2026–2046","kind":"horizons","blocks":[{"type":"table","header":["Period","Career Development"],"rows":[[{"text":"2026–2028"},{"text":"Design foundation + sustainability + research"}],[{"text":"2028–2030"},{"text":"Social-impact / sustainability internship"}],[{"text":"2030–2033"},{"text":"Junior Impact Consultant / Programme Associate"}],[{"text":"2033–2037"},{"text":"Impact Consultant / Sustainability Consultant"}],[{"text":"2037–2040"},{"text":"Senior Impact Consultant"}],[{"text":"2040–2043"},{"text":"Impact Strategy Lead / Engagement Manager"}],[{"text":"2043–2046"},{"text":"Impact Director / Sustainability Strategy Director"}]]}]},{"heading":"B.Des — Four-Year Development Plan","kind":"other","blocks":[{"type":"h","text":"Year 1 — Design + Social Context"},{"type":"h","text":"Learn"},{"type":"list","items":[{"text":"Design fundamentals"},{"text":"Human-centred design"},{"text":"Design research"},{"text":"Visual communication"},{"text":"Systems thinking fundamentals"},{"text":"Sustainability concepts"},{"text":"Social issues and development"},{"text":"Basic research methods"},{"text":"Communication and presentation"}]},{"type":"h","text":"Projects"},{"type":"list","items":[{"text":"Community-needs research"},{"text":"Sustainable product concept"},{"text":"Accessibility design project"},{"text":"Local environmental problem study"},{"text":"Social innovation concept"}]},{"type":"note","label":"Goal","text":"Understand that social-impact design requires understanding people, systems and context, not just visual design."}]},{"heading":"Year 2 — Research + Social Innovation","kind":"other","blocks":[{"type":"h","text":"Learn"},{"type":"list","items":[{"text":"Design thinking"},{"text":"User research"},{"text":"Qualitative research"},{"text":"Quantitative research"},{"text":"Stakeholder mapping"},{"text":"Journey mapping"},{"text":"Systems mapping"},{"text":"Co-design"},{"text":"Behavioural insights"},{"text":"Sustainability frameworks"}]},{"type":"h","text":"Research Methods"},{"type":"list","items":[{"text":"Interviews"},{"text":"Surveys"},{"text":"Observation"},{"text":"Focus groups"},{"text":"Ethnographic research"},{"text":"Desk research"},{"text":"Data analysis"}]},{"type":"h","text":"Projects"},{"type":"flow","items":["Community","Research","Problem Definition","Stakeholder Mapping","Intervention","Prototype","Testing"]}]},{"heading":"Year 3 — Impact Strategy","kind":"other","blocks":[{"type":"p","text":"Move from designing solutions to understanding whether those solutions actually create impact."},{"type":"h","text":"Learn"},{"type":"list","items":[{"text":"Theory of Change"},{"text":"Logic Models"},{"text":"Impact measurement"},{"text":"Social Return on Investment (SROI)"},{"text":"ESG fundamentals"},{"text":"SDGs"},{"text":"Sustainability reporting"},{"text":"Programme evaluation"},{"text":"Impact assessment"},{"text":"Policy research"},{"text":"Social entrepreneurship"}]},{"type":"h","text":"Example Project"},{"type":"h","text":"Rural Education Intervention"},{"type":"h","text":"Problem"},{"type":"p","text":"Low access to quality learning."},{"type":"h","text":"Research"},{"type":"flow","items":["Students","teachers","parents","institutions."],"sep":"+"},{"type":"h","text":"System Map"},{"type":"p","text":"Identify structural barriers."},{"type":"h","text":"Intervention"},{"type":"p","text":"Hybrid learning model."},{"type":"h","text":"Pilot"},{"type":"p","text":"Test with target community."},{"type":"h","text":"Measurement"},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Participation"},{"text":"Completion"},{"text":"Learning outcomes"},{"text":"Accessibility"},{"text":"Cost"},{"text":"Long-term outcomes"}]},{"type":"h","text":"Impact Report"},{"type":"p","text":"Determine whether the intervention actually worked."}]},{"heading":"Year 4 — Professional Impact Consulting","kind":"other","blocks":[{"type":"p","text":"Final year should combine design, strategy and measurable impact."},{"type":"h","text":"Build"},{"type":"list","items":[{"text":"Consulting methodology"},{"text":"Client presentations"},{"text":"Programme strategy"},{"text":"Impact measurement"},{"text":"Sustainability strategy"},{"text":"Research reports"},{"text":"Data visualisation"},{"text":"Stakeholder facilitation"},{"text":"Implementation planning"},{"text":"Monitoring & evaluation"}]},{"type":"h","text":"Major Project Ideas"},{"type":"h","text":"1. Sustainable Urban Mobility"},{"type":"p","text":"Design an intervention to improve sustainable transportation in a city."},{"type":"h","text":"2. Plastic-Waste Reduction"},{"type":"p","text":"Develop a community + business intervention and measure outcomes."},{"type":"h","text":"3. Rural Healthcare Access"},{"type":"p","text":"Research barriers and design a scalable service model."},{"type":"h","text":"4. Sustainable Agriculture"},{"type":"p","text":"Create an intervention connecting farmers, technology and sustainable practices."},{"type":"h","text":"5. Inclusive Education"},{"type":"p","text":"Design an education system supporting students with different learning needs."}]},{"heading":"Impact Consultant Specialisations","kind":"other","blocks":[{"type":"table","header":["Specialisation","Focus"],"rows":[[{"text":"Social Impact Consulting"},{"text":"Social development programmes"}],[{"text":"Sustainability Consulting"},{"text":"Environmental sustainability"}],[{"text":"ESG Consulting"},{"text":"Corporate environmental/social/governance"}],[{"text":"Impact Measurement"},{"text":"Measuring programme outcomes"}],[{"text":"Social Innovation"},{"text":"Designing new social solutions"}],[{"text":"Development Consulting"},{"text":"Development-sector projects"}],[{"text":"Climate Impact"},{"text":"Climate-related interventions"}],[{"text":"Public Policy"},{"text":"Government and policy challenges"}],[{"text":"CSR Strategy"},{"text":"Corporate social responsibility"}],[{"text":"Inclusive Design"},{"text":"Accessibility and inclusion"}],[{"text":"Circular Economy"},{"text":"Waste and resource systems"}],[{"text":"Social Enterprise Strategy"},{"text":"Scaling mission-driven organisations"}]]}]},{"heading":"Technology Stack","kind":"other","blocks":[{"type":"h","text":"Research"},{"type":"list","items":[{"text":"Miro"},{"text":"FigJam"},{"text":"Notion"},{"text":"Qualtrics"},{"text":"Google Forms"}]},{"type":"h","text":"Data"},{"type":"list","items":[{"text":"Excel"},{"text":"Power BI"},{"text":"Tableau"},{"text":"Python"},{"text":"R"}]},{"type":"h","text":"Design"},{"type":"list","items":[{"text":"Figma"},{"text":"Adobe Illustrator"},{"text":"Photoshop"},{"text":"InDesign"}]},{"type":"h","text":"Project Management"},{"type":"list","items":[{"text":"Notion"},{"text":"Jira"},{"text":"Asana"},{"text":"Trello"}]},{"type":"h","text":"Impact & Reporting"},{"type":"p","text":"Learn to work with:"},{"type":"list","items":[{"text":"ESG reporting systems"},{"text":"Impact dashboards"},{"text":"SDG frameworks"},{"text":"Sustainability reporting standards"},{"text":"Impact measurement frameworks"}]}]},{"heading":"Internship Roadmap","kind":"internships","blocks":[{"type":"h","text":"Year 1"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"NGOs"},{"text":"Community organisations"},{"text":"Social enterprises"},{"text":"Sustainability initiatives"}]},{"type":"p","text":"Focus on:"},{"type":"h","text":"Research + community engagement"},{"type":"h","text":"Year 2"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Social innovation labs"},{"text":"Design consultancies"},{"text":"Development organisations"},{"text":"Sustainability organisations"}]},{"type":"p","text":"Focus on:"},{"type":"h","text":"Research + design interventions"},{"type":"h","text":"Year 3"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Consulting firms"},{"text":"ESG teams"},{"text":"CSR organisations"},{"text":"Impact investment organisations"},{"text":"Development-sector consultancies"}]},{"type":"p","text":"Focus on:"},{"type":"h","text":"Strategy + measurement"},{"type":"h","text":"Year 4"},{"type":"p","text":"Target internships involving:"},{"type":"list","items":[{"text":"Impact assessment"},{"text":"Sustainability strategy"},{"text":"ESG"},{"text":"Programme evaluation"},{"text":"Social innovation"},{"text":"Development consulting"}]}]},{"heading":"Portfolio Requirements","kind":"