ital imaging"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"PACS"},{"text":"RIS"},{"text":"DICOM"},{"text":"EMR/HIS"},{"text":"Digital image transfer"},{"text":"Worklists"}]},{"type":"h","text":"Year 3 — CT/MRI Specialization"},{"type":"p","text":"The student develops deeper technical expertise."},{"type":"h","text":"CT"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"CT physics"},{"text":"Hounsfield units"},{"text":"CT protocols"},{"text":"Dose optimization"},{"text":"Contrast CT"},{"text":"CT angiography"},{"text":"3D reconstruction"},{"text":"CT artifacts"},{"text":"Emergency CT"}]},{"type":"h","text":"MRI"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"MRI physics"},{"text":"T1/T2 concepts"},{"text":"Pulse sequences"},{"text":"MRI safety"},{"text":"Patient screening"},{"text":"Contrast MRI"},{"text":"Artifacts"},{"text":"Diffusion"},{"text":"MRA/MRV"},{"text":"Advanced MRI workflows"}]}]},{"heading":"Final Year — Clinical & Operational Preparation","kind":"other","blocks":[{"type":"p","text":"The student should gain experience with:"},{"type":"list","items":[{"text":"CT"},{"text":"MRI"},{"text":"Emergency imaging"},{"text":"Contrast procedures"},{"text":"Patient positioning"},{"text":"PACS/RIS"},{"text":"Equipment troubleshooting"},{"text":"Quality assurance"},{"text":"Radiation safety"},{"text":"MRI safety"}]},{"type":"h","text":"Begin developing leadership skills"},{"type":"list","items":[{"text":"Team communication"},{"text":"Shift coordination"},{"text":"Task allocation"},{"text":"Incident reporting"},{"text":"Conflict management"},{"text":"Patient-flow management"},{"text":"Basic inventory management"}]}]},{"heading":"What an Imaging Supervisor Actually Does","kind":"other","blocks":[{"type":"p","text":"An Imaging Supervisor is responsible for making sure that the department functions safely and efficiently."},{"type":"h","text":"Daily responsibilities"},{"type":"flow","items":["Staff Allocation","Equipment Re