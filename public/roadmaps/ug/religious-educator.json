s"},{"text":"Philosophy of religion"},{"text":"Interfaith studies"}]},{"type":"h","text":"Digital"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"LMS platforms"},{"text":"Digital presentations"},{"text":"Video editing"},{"text":"Online teaching"},{"text":"Digital assessment"},{"text":"AI-assisted educational content creation"}]}]},{"heading":"Careers You Can Be Hired As","kind":"careers","blocks":[{"type":"h","text":"Entry-Level"},{"type":"list","items":[{"text":"Religious Education Assistant"},{"text":"Religious Educator"},{"text":"Faith Education Coordinator"},{"text":"Community Education Assistant"},{"text":"Youth Education Coordinator"},{"text":"Religious Studies Teaching Assistant"},{"text":"Educational Content Developer"},{"text":"Programme Assistant"}]},{"type":"h","text":"Mid-Level"},{"type":"list","items":[{"text":"Senior Religious Educator"},{"text":"Religious Education Coordinator"},{"text":"Youth Programme Coordinator"},{"text":"Curriculum Developer"},{"text":"Religious Studies Instructor"},{"text":"Community Education Manager"},{"text":"Interfaith Education Coordinator"}]},{"type":"h","text":"Advanced"},{"type":"list","items":[{"text":"Religious Education Director"},{"text":"Curriculum Director"},{"text":"Programme Director"},{"text":"Academic Coordinator"},{"text":"Religious Studies Faculty"},{"text":"Education Consultant"},{"text":"Interfaith Education Specialist"}]},{"type":"p","text":"Actual titles vary significantly by institution and religious tradition."}]},{"heading":"Interview Preparation","kind":"other","blocks":[{"type":"h","text":"Common Questions"},{"type":"list","items":[{"text":"How would you make religious education engaging for young learners?"},{"text":"How would you explain a complex theological concept to beginners?"},{"text":"How do you handle different beliefs within the same classroom?"},{"text":"What is the difference between religious education and religious instruction?"},{"text":"How would you encourage respectful discussion of religious differences?"},{"text":"How would you respond to a student's challenging question about faith?"},{"text":"How do you evaluate whether students understand a religious text?"},{"text":"How would you design a comparative religion lesson?"},{"text":"How do you maintain appropriate professional boundaries?"},{"text":"How can technology improve religious education?"}]},{"type":"h","text":"Strong Teaching Framework"},{"type":"flow","items":["Context","Explain","Compare","Discuss","Reflect","Assess"]}]},{"heading":"Postgraduate Study in India","kind":"pg_india","blocks":[{"type":"h","text":"Route A — MA Theology / Religious Studies"},{"type":"h","text":"BA → MA Theology / Religious Studies"},{"type":"p","text":"Potential areas:"},{"type":"list","items":[{"text":"Theology"},{"text":"Religious studies"},{"text":"Comparative religion"},{"text":"Philosophy of religion"},{"text":"Religious ethics"},{"text":"Sacred-text studies"},{"text":"Religion and society"}]},{"type":"h","text":"Route B — MA Education"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Curriculum development"},{"text":"Education administration"},{"text":"Teaching"},{"text":"Educational research"},{"text":"Academic leadership"}]},{"type":"h","text":"Route C — M.Ed. / Education Specialisation"},{"type":"p","text":"For students seeking education-focused careers, appropriate education qualifications can strengthen:"},{"type":"list","items":[{"text":"Pedagogy"},{"text":"Curriculum"},{"text":"Assessment"},{"text":"Educational leadership"}]},{"type":"p","text":"Eligibility depends on the specific programme."},{"type":"h","text":"Route D — Theology + Advanced Religious Formation"},{"type":"p","text":"Some faith traditions have their own pathways involving:"},{"type":"list","items":[{"text":"Advanced theological education"},{"text":"Seminary training"},{"text":"Ministerial formation"},{"text":"Denominational certification"},{"text":"Community leadership preparation"}]},{"ty