"},{"type":"p","text":"Evidence Analysis"},{"type":"h","text":"Professional"},{"type":"p","text":"Client Counselling"},{"type":"p","text":"+"},{"type":"p","text":"Negotiation"},{"type":"p","text":"+"},{"type":"p","text":"Settlement"},{"type":"p","text":"+"},{"type":"p","text":"Case Management"},{"type":"p","text":"+"},{"type":"p","text":"Professional Ethics"},{"type":"h","text":"Technology"},{"type":"p","text":"Legal Databases"},{"type":"p","text":"+"},{"type":"p","text":"E-Filing"},{"type":"p","text":"+"},{"type":"p","text":"Document Management"},{"type":"p","text":"+"},{"type":"p","text":"Legal AI"},{"type":"p","text":"+"},{"type":"p","text":"Digital Evidence"},{"type":"h","text":"Target Profile by Graduation"},{"type":"p","text":"By graduation, the student should ideally have:"},{"type":"list","items":[{"text":"Strong civil-law fundamentals"},{"text":"Strong constitutional-law understanding"},{"text":"Procedural-law knowledge"},{"text":"Legal research capability"},{"text":"Legal drafting experience"},{"text":"Evidence-analysis skills"},{"text":"Court observation and practical exposure"},{"text":"Client-interviewing skills"},{"text":"Negotiation fundamentals"},{"text":"Basic oral advocacy"},{"text":"Digital legal research skills"},{"text":"E-filing awareness"},{"text":"Responsible AI/legal-tech literacy"},{"text":"Multiple litigation internships"}]},{"type":"h","text":"Recommended Portfolio"},{"type":"p","text":"10+ Case Briefs"},{"type":"p","text":"+"},{"type":"p","text":"5+ Civil Law Research Notes"},{"type":"p","text":"+"},{"type":"p","text":"5+ Drafting Exercises"},{"type":"p","text":"+"},{"type":"p","text":"2+ Constitutional Case Analyses"},{"type":"p","text":"+"},{"type":"p","text":"1 Property / Contract Dispute Project"},{"type":"p","text":"+"},{"type":"p","text":"1 Mediation / ADR Project"},{"type":"p","text":"+"},{"type":"p","text":"1 Litigation Internship"},{"type":"p","text":"+"},{"type":"p","text":"1 Legal-Tech Project"},{"type":"h","text":"Best Overal