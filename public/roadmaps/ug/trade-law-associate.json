nt:"},{"type":"list","items":[{"text":"Product"},{"text":"Technical characteristics"},{"text":"Classification logic"},{"text":"Applicable tariff"},{"text":"Relevant regulatory requirements"}]},{"type":"h","text":"Project 3 — Anti-Dumping Case Study"},{"type":"p","text":"Analyze a published trade-remedy case."},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Product"},{"text":"Exporting country"},{"text":"Domestic industry"},{"text":"Alleged dumping"},{"text":"Injury"},{"text":"Investigation"},{"text":"Final decision"}]},{"type":"h","text":"Project 4 — International Contract"},{"type":"p","text":"Draft a hypothetical international sale agreement covering:"},{"type":"list","items":[{"text":"Parties"},{"text":"Goods"},{"text":"Price"},{"text":"Delivery"},{"text":"Payment"},{"text":"Risk"},{"text":"Insurance"},{"text":"Liability"},{"text":"Governing law"},{"text":"Arbitration"}]},{"type":"h","text":"Project 5 — Trade Policy Brief"},{"type":"p","text":"Write a 5–10 page policy brief:"},{"type":"flow","items":["Trade Issue","Economic Background","Legal Framework","Business Impact","Stakeholder Impact","Policy Options","Recommendation"]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Target organizations involved in cross-border commerce."},{"type":"h","text":"Best Internship Areas"},{"type":"list","items":[{"text":"International trade law firms"},{"text":"Customs advisory firms"},{"text":"Export-import companies"},{"text":"Multinational corporations"},{"text":"Government trade departments"},{"text":"Industry associations"},{"text":"Trade-policy think tanks"},{"text":"International organizations"},{"text":"Consulting firms"}]},{"type":"h","text":"Internship Titles"},{"type":"list","items":[{"text":"International Trade Law Intern"},{"text":"Customs Law Intern"},{"text":"Trade Policy Intern"},{"text":"International Law Intern"},{"text":"Import-Export Compliance Intern"},{"text":"Legal Research Intern"},{"text":"Trade Analy