nt"},{"type":"list","items":[{"text":"Programme management"},{"text":"Monitoring & evaluation"},{"text":"Data analysis"},{"text":"Policy"},{"text":"Research"},{"text":"Grant writing"}]},{"type":"h","text":"Specialisation Options"},{"type":"table","header":["Specialisation","Focus"],"rows":[[{"text":"Early Childhood Development"},{"text":"Children from birth to early school years"}],[{"text":"Child Protection"},{"text":"Safeguarding and vulnerable children"}],[{"text":"Early Intervention"},{"text":"Developmental support for children needing additional assistance"}],[{"text":"Community Child Development"},{"text":"Community-based child programmes"}],[{"text":"Parent & Family Support"},{"text":"Parenting and family interventions"}],[{"text":"Child Nutrition"},{"text":"Nutrition and healthy development"}],[{"text":"Inclusive Education"},{"text":"Support for diverse learning needs"}],[{"text":"Child Development Research"},{"text":"Research and programme evaluation"}],[{"text":"Public Child Development"},{"text":"Government and development programmes"}],[{"text":"NGO Programme Management"},{"text":"Child-focused social programmes"}]]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"h","text":"Year 1"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Preschools"},{"text":"Early-learning centres"},{"text":"Schools"},{"text":"Child-care centres"}]},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Observation"},{"text":"Classroom support"},{"text":"Child activities"},{"text":"Documentation"}]},{"type":"h","text":"Year 2"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Child-development NGOs"},{"text":"Early-intervention centres"},{"text":"Community programmes"},{"text":"Family-support organisations"}]},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Developmental assessment"},{"text":"Parent interaction"},{"text":"Programme implementation"}]},{"type":"h","text":"Year 3"},{"type":"p","text":"Target: