experience + activities"}],[{"text":"Hospitality Technology"},{"text":"PMS + digital systems + analytics"}]]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Hospitality students should prioritise hands-on hotel training."},{"type":"h","text":"Look for internships with"},{"type":"list","items":[{"text":"Business hotels"},{"text":"Luxury hotels"},{"text":"Resorts"},{"text":"International hotel chains"},{"text":"Boutique hotels"},{"text":"Airport hotels"},{"text":"Convention hotels"},{"text":"Serviced apartments"}]},{"type":"h","text":"Internship progression"},{"type":"h","text":"Year 1"},{"type":"p","text":"→ Hotel operations observation"},{"type":"h","text":"Year 2"},{"type":"p","text":"→ Front-office training"},{"type":"h","text":"Year 3"},{"type":"p","text":"→ Guest-service/reservations internship"},{"type":"h","text":"Final year"},{"type":"p","text":"→ Industrial training across multiple hotel departments"},{"type":"h","text":"Ideally gain exposure to"},{"type":"list","items":[{"text":"Reception"},{"text":"Reservations"},{"text":"Guest relations"},{"text":"Concierge"},{"text":"Telephone operations"},{"text":"PMS"},{"text":"Billing"},{"text":"Night audit"},{"text":"Complaint handling"}]},{"type":"p","text":"Cross-training in housekeeping and food & beverage is also valuable because front-office staff must coordinate with these departments constantly."}]},{"heading":"Certifications and learning","kind":"certifications","blocks":[{"type":"table","header":["Area","Priority"],"rows":[[{"text":"Front-office operations"},{"text":"★★★★★"}],[{"text":"Customer service"},{"text":"★★★★★"}],[{"text":"PMS"},{"text":"★★★★★"}],[{"text":"Communication"},{"text":"★★★★★"}],[{"text":"Hotel reservations"},{"text":"★★★★★"}],[{"text":"Excel"},{"text":"★★★★☆"}],[{"text":"Revenue management"},{"text":"★★★★☆"}],[{"text":"CRM"},{"text":"★★★★☆"}],[{"text":"Hospitality analytics"},{"text":"★★★☆☆"}],[{"text":"Digital marketing"},{"text":"★★★☆☆"}]]},{"type":"h","t