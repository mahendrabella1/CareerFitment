ary procedures"},{"text":"HR policies"}]},{"type":"h","text":"Practical Skills"},{"type":"list","items":[{"text":"Employment contract review"},{"text":"Policy drafting"},{"text":"Legal research"},{"text":"Workplace investigation"},{"text":"Compliance tracking"},{"text":"Legal advisory writing"},{"text":"Negotiation"}]},{"type":"h","text":"Digital Skills"},{"type":"list","items":[{"text":"Excel"},{"text":"Power BI basics"},{"text":"HRIS awareness"},{"text":"Contract management systems"},{"text":"Document management"},{"text":"AI-assisted legal research"}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"list","items":[{"text":"Integrated Law Degree"},{"text":"+"},{"text":"Labour & Employment Law"},{"text":"+"},{"text":"Contract Law"},{"text":"+"},{"text":"Industrial Relations"},{"text":"+"},{"text":"Employment Contract Drafting"},{"text":"+"},{"text":"HR Policy Review"},{"text":"+"},{"text":"Labour Compliance"},{"text":"+"},{"text":"Employee Relations"},{"text":"+"},{"text":"Workplace Investigations"},{"text":"+"},{"text":"POSH / Workplace Harassment Framework"},{"text":"+"},{"text":"Privacy & Employee Data"},{"text":"+"},{"text":"Legal Research"},{"text":"+"},{"text":"Negotiation & Mediation"},{"text":"+"},{"text":"HRIS / CLM Awareness"},{"text":"+"},{"text":"AI-Assisted Legal Research"},{"text":"+"},{"text":"Corporate HR / Legal Internship"}]}]},{"heading":"Best Overall Positioning","kind":"other","blocks":[{"type":"flow","items":["Integrated Law Degree","Labour & Employment Law","HR/Legal Internship","Employment Contracts + Labour Compliance","Employee Relations & Workplace Investigations","HR Legal Analyst / Employment Law Associate","HR Legal Advisor","Senior Employment Counsel","Employment Legal Leadership"]},{"type":"p","text":"The strongest candidate combines employment-law expertise with genuine HR understanding. A purely legal profile may understand the statute but struggle with real workplace processes; a purely HR profile may understand operations but lack legal depth."},{"type":"p","text":"The ideal positioning is:"},{"type":"flow","items":["Law","Labour & Employment Law","HR Operations","Compliance","Employment Contracts","Employee Relations","Workplace Investigations","Privacy","Negotiation","Legal Technology."],"sep":"+"}]}]}