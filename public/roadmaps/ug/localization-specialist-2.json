 localization project"},{"text":"Localization project-management experience"},{"text":"Excel/Power BI dashboard"},{"text":"Internship"},{"text":"Professional localization portfolio"}]},{"type":"h","text":"Target Graduate Profile"},{"type":"flow","items":["BA Linguistics","Linguistics Foundations","Phonetics/Phonology","Morphology","Syntax","Semantics","Pragmatics","Sociolinguistics","Translation","Cultural Adaptation","Localization","Terminology","CAT Tools","Translation Memory","Software/Web/App Localization","Localization QA","Transcreation","AI-Assisted Translation","MT Post-Editing","Project Management","Analytics","Internship","Localization Associate/Coordinator","Localization Specialist","Senior Specialist","Localization Lead/Manager","Globalization Leadership"]},{"type":"table","header":["ID","Level","Stream","Degree","Course","Career","Notes"],"rows":[[{"text":"1494"},{"text":"UG"},{"text":"Humanities & Social Sciences"},{"text":"BA (Bachelor of Arts – General / Honours)"},{"text":"Linguistics"},{"text":"NLP Data Annotator"},{"text":"—"}]]}]}]}