ype":"h","text":"Sleep"},{"type":"h","text":"Activity"},{"type":"h","text":"Stress"},{"type":"h","text":"Work habits"},{"type":"h","text":"Daily routine"},{"type":"h","text":"Wellness"},{"type":"h","text":"Stress perception"},{"type":"h","text":"Relaxation"},{"type":"h","text":"Mindfulness"},{"type":"h","text":"Motivation"},{"type":"h","text":"Adherence"},{"type":"h","text":"Medical safety"},{"type":"p","text":"Review relevant medical history and identify situations requiring physician or specialist clearance/referral."}]},{"heading":"Yoga Therapy Planning","kind":"other","blocks":[{"type":"p","text":"A therapeutic plan should be individualized."},{"type":"h","text":"Assessment"},{"type":"h","text":"Goal Setting"},{"type":"h","text":"Contraindication / Risk Screening"},{"type":"h","text":"Practice Selection"},{"type":"h","text":"Intensity & Duration"},{"type":"h","text":"Supervised Session"},{"type":"h","text":"Client Feedback"},{"type":"h","text":"Progress Monitoring"},{"type":"h","text":"Program Modification"},{"type":"p","text":"The same yoga practice should not automatically be prescribed to every client with the same condition."}]},{"heading":"Asana-Based Therapy","kind":"other","blocks":[{"type":"h","text":"Develop knowledge of:"},{"type":"h","text":"Standing postures"},{"type":"h","text":"Seated postures"},{"type":"h","text":"Supine postures"},{"type":"h","text":"Prone postures"},{"type":"h","text":"Balance practices"},{"type":"h","text":"Mobility practices"},{"type":"h","text":"Gentle strengthening"},{"type":"h","text":"Restorative practices"},{"type":"h","text":"Important variables include:"},{"type":"h","text":"Intensity"},{"type":"h","text":"Duration"},{"type":"h","text":"Repetition"},{"type":"h","text":"Breathing coordination"},{"type":"h","text":"Support"},{"type":"h","text":"Modification"},{"type":"h","text":"Progression"}]},{"heading":"Pranayama","kind":"other","blocks":[{"type":"h","text":"Understand:"},{"type":"h","text":"Basic breathing mechanics"},{"type":"h","text":"Diaphragmatic breathing"},{"type":"h","text":"Breath awareness"},{"type":"h","text":"Slow breathing"},{"type":"h","text":"Controlled breathing practices"},{"type":"h","text":"Relaxation-oriented breathing"},{"type":"p","text":"Therapists should understand contraindications and individual tolerance before introducing advanced breathing practices."}]},{"heading":"Meditation & Mindfulness","kind":"other","blocks":[{"type":"h","text":"Yoga therapy can incorporate:"},{"type":"h","text":"Mindfulness"},{"type":"h","text":"Meditation"},{"type":"h","text":"Body awareness"},{"type":"h","text":"Breath awareness"},{"type":"h","text":"Guided relaxation"},{"type":"h","text":"Yoga Nidra-style relaxation"},{"type":"h","text":"Stress-management practices"},{"type":"h","text":"Potential applications include general:"},{"type":"h","text":"Stress management"},{"type":"h","text":"Relaxation"},{"type":"h","text":"Sleep-support routines"},{"type":"h","text":"Emotional wellbeing"},{"type":"h","text":"Attention and self-awareness"},{"type":"p","text":"Serious mental-health conditions require appropriate clinical assessment and professional care."}]},{"heading":"Therapeutic Applications","kind":"other","blocks":[{"type":"p","text":"A Yoga Therapist may work with clients dealing with wellness or rehabilitation needs associated with areas such as:"},{"type":"h","text":"Stress"},{"type":"h","text":"Sedentary lifestyle"},{"type":"h","text":"Poor mobility"},{"type":"h","text":"Musculoskeletal discomfort"},{"type":"h","text":"Sleep difficulties"},{"type":"h","text":"Lifestyle-related health risks"},{"type":"h","text":"General fitness"},{"type":"h","text":"Balance and flexibility"},{"type":"h","text":"Workplace stress"},{"type":"p","text":"For diagnosed medical conditions, therapeutic yoga should be coordinated appropriately with the treating healthcare team."}]},{"heading":"Chronic Health & Lifestyle Management","kind":"other","blocks":[{"type":"p","text":"Yoga therapy programs can complement broader management strategies for lifestyle-related conditions."},{"type":"h","text":"The therapist's role may include:"},{"type":"h","text":"Supporting physical activity"},{"type":"h","text":"Improving adherence"},{"type":"h","text":"Stress management"},{"type":"h","text":"Relaxation"},{"type":"h","text":"Mobility"},{"type":"h","text":"Healthy routines"},{"type":"h","text":"Behaviour change"},{"type":"h","text":"Integrated model"},{"type":"h","text":"Medical Diagnosis / Care"},{"type":"h","text":"+"},{"type":"h","text":"Yoga Therapy"},{"type":"h","text":"+"},{"type":"h","text":"Lifestyle Modification"},{"type":"h","text":"+"},{"type":"h","text":"Nutrition / Exercise Support"},{"type":"h","text":"+"},{"type":"h","text":"Monitoring"},{"type":"h","text":"Integrated Health Management"},{"type":"p","text":"Yoga therapy should complement—not automatically replace—evidence-based medical treatment."}]},{"heading":"Yoga Therapy for Special Populations","kind":"other","blocks":[{"type":"h","text":"Develop appropriate modifications for:"},{"type":"h","text":"Older Adults"},{"type":"h","text":"Balance"},{"type":"h","text":"Mobility"},{"type":"h","text":"Gentle strengthening"},{"type":"h","text":"Fall-risk awareness"},{"type":"h","text":"Chair-based practices"},{"type":"h","text":"Children"},{"type":"h","text":"Age-appropriate movement"},{"type":"h","text":"Breathing awareness"},{"type":"h","text":"Attention"},{"type":"h","text":"Relaxation"},{"type":"h","text":"Play-based practices"},{"type":"h","text":"Working Professionals"},{"type":"h","text":"Desk mobility"},{"type":"h","text":"Postural awareness"},{"type":"h","text":"Stress management"},{"type":"h","text":"Breathing"},{"type":"h","text":"Short workplace routines"},{"type":"h","text":"Pregnant Clients"},{"type":"p","text":"Require specialized training and appropriate medical considerations. Pregnancy-specific yoga should be provided within appropriate professional scope and with necessary precautions."}]},