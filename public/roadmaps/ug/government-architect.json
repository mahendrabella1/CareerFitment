n","Quality Control"],"sep":"+"},{"type":"h","text":"Planning"},{"type":"flow","items":["Urban Planning","GIS","Public Infrastructure","Housing"],"sep":"+"},{"type":"h","text":"Digital"},{"type":"flow","items":["BIM","GIS","Excel","Power BI","Digital Project Management"],"sep":"+"},{"type":"h","text":"Future Skills"},{"type":"flow","items":["AI-assisted design","Digital Twins","Smart Buildings","Climate-Resilient Architecture"],"sep":"+"},{"type":"h","text":"Target Profile by Graduation"},{"type":"p","text":"A strong B.Arch graduate targeting Government Architect roles should be able to take a public project from:"},{"type":"flow","items":["Government Requirement","Site Analysis","Feasibility","Area Programming","Concept Design","Regulatory Analysis","Detailed Design","BIM / CAD","Working Drawings","BOQ / Estimation","Tender Documentation","Construction Coordination","Site Supervision","Quality Control","Project Handover"]},{"type":"p","text":"That is considerably stronger than having only a visually impressive architecture portfolio."},{"type":"h","text":"Ideal Portfolio"},{"type":"p","text":"Your portfolio should contain 6–8 strong projects, preferably including:"},{"type":"h","text":"Government Administrative Complex"},{"type":"h","text":"Public Hospital"},{"type":"h","text":"Government School / College"},{"type":"h","text":"Affordable Housing"},{"type":"h","text":"Public Infrastructure Project"},{"type":"h","text":"Heritage Adaptive Reuse"},{"type":"h","text":"Sustainable Government Building"},{"type":"h","text":"BIM-based Public Building"},{"type":"p","text":"For each project, show:"},{"type":"list","items":[{"text":"Site analysis"},{"text":"Context"},{"text":"Design brief"},{"text":"Concept"},{"text":"Site planning"},{"text":"Plans"},{"text":"Sections"},{"text":"Elevations"},{"text":"Construction details"},{"text":"Structural logic"},{"text":"Building services"},{"text":"Accessibility"},{"text":"Fire safety"},{"text":"Sustainability"},{"text":"BIM model"},{"text":"BOQ/estimation sample"},{"text":"Construction methodology"}]},{"type":"h","text":"Target Profile at Graduation"}]}]}