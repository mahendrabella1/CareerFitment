ogrammes"},{"text":"Rural development"},{"text":"Social protection"}]},{"type":"p","text":"For India-specific work, understand how NGOs/community organizations interact with:"},{"type":"flow","items":["Community","Local Government","District Administration","State Government","Central Government"]},{"type":"p","text":"Specific schemes, laws and programme guidelines should always be checked for their current version."}]},{"heading":"NGO & Social Impact Management","kind":"other","blocks":[{"type":"p","text":"Learn:"},{"type":"h","text":"Programme Management"},{"type":"list","items":[{"text":"Project planning"},{"text":"Activity planning"},{"text":"Budgeting"},{"text":"Resource allocation"},{"text":"Field coordination"},{"text":"Volunteer management"},{"text":"Vendor coordination"},{"text":"Reporting"}]},{"type":"h","text":"Monitoring & Evaluation"},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Inputs"},{"text":"Activities"},{"text":"Outputs"},{"text":"Outcomes"},{"text":"Impact"}]},{"type":"p","text":"Example:"},{"type":"flow","items":["100 students trained","80 complete programme","60 improve employability skills","35 obtain internships/jobs"]},{"type":"p","text":"This distinction between activity, output, outcome and impact is important for professional NGO work."}]},{"heading":"Data & Technology Skills","kind":"other","blocks":[{"type":"p","text":"A modern Community Organizer should not rely exclusively on fieldwork."},{"type":"h","text":"Essential"},{"type":"list","items":[{"text":"Microsoft Excel"},{"text":"Google Sheets"},{"text":"Microsoft Word"},{"text":"PowerPoint"},{"text":"Google Forms"},{"text":"KoboToolbox/ODK-type field data tools"}]},{"type":"h","text":"Useful"},{"type":"list","items":[{"text":"Power BI"},{"text":"SQL basics"},{"text":"GIS/QGIS"},{"text":"Basic statistics"},{"text":"Survey platforms"},{"text":"CRM/donor-management systems"}]},{"type":"h","text":"AI"},{"type":"p","text":"Learn responsible use of AI for:"},{"type":"list",