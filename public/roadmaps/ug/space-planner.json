},{"text":"Stores, malls and commercial spaces"}],[{"text":"Hospitality Planning"},{"text":"Hotels, restaurants and resorts"}],[{"text":"Healthcare Planning"},{"text":"Hospitals and healthcare facilities"}],[{"text":"Educational Planning"},{"text":"Schools and universities"}],[{"text":"Corporate Interiors"},{"text":"Large-scale workplace environments"}],[{"text":"Space Utilisation"},{"text":"Data-driven allocation of space"}],[{"text":"Sustainable Interiors"},{"text":"Energy/material/wellness-focused spaces"}],[{"text":"BIM & Digital Design"},{"text":"Revit/BIM-based planning"}]]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"h","text":"Year 1"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Interior design studios"},{"text":"Furniture companies"},{"text":"Small architecture practices"}]},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Site measurements"},{"text":"Drawings"},{"text":"Materials"},{"text":"Furniture layouts"}]},{"type":"h","text":"Year 2"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Interior design firms"},{"text":"Architecture firms"},{"text":"Residential design studios"}]},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"AutoCAD"},{"text":"Space planning"},{"text":"Site coordination"},{"text":"Construction drawings"}]},{"type":"h","text":"Year 3"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Commercial interior firms"},{"text":"Corporate workplace design"},{"text":"Hospitality design"},{"text":"Real-estate developers"}]},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Large floor plans"},{"text":"Revit/BIM"},{"text":"Workplace planning"},{"text":"Client presentations"}]},{"type":"h","text":"Year 4"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Architecture/interior design firms"},{"text":"Workplace strategy firms"},{"text":"Design consultancies"},{"text":"Commercial real-estate companies"}]},{"type":"p","text":"Aim to work on a complete project from brief to design documentation."}]},{"heading":"Certifications & Learning","kind":"certifications","blocks":[{"type":"h","text":"Design Software"},{"type":"list","items":[{"text":"AutoCAD"},{"text":"Revit"},{"text":"SketchUp"},{"text":"3ds Max"},{"text":"Rhino"},{"text":"Photoshop"},{"text":"Illustrator"},{"text":"InDesign"},{"text":"Enscape"},{"text":"Lumion"}]},{"type":"p","text":"Students do not need every software package. A strong combination is:"},{"type":"flow","items":["AutoCAD","Revit","SketchUp","one rendering tool","Adobe tools."],"sep":"+"},{"type":"h","text":"Technical"},{"type":"list","items":[{"text":"BIM fundamentals"},{"text":"Interior construction"},{"text":"Building services"},{"text":"Lighting"},{"text":"Acoustics"},{"text":"Furniture systems"},{"text":"Material specification"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Project management"},{"text":"Cost estimation"},{"text":"BOQ"},{"text":"Client management"},{"text":"Design presentation"},{"text":"Sustainable design"}]}]},{"heading":"Careers You Can Be Hired As","kind":"careers","blocks":[{"type":"h","text":"Entry-Level"},{"type":"list","items":[{"text":"Space Planning Intern"},{"text":"Junior Space Planner"},{"text":"Interior Design Intern"},{"text":"Junior Interior Designer"},{"text":"Design Assistant"},{"text":"CAD Designer"},{"text":"Interior Design Assistant"},{"text":"Drafting Assistant"},{"text":"Furniture Layout Designer"},{"text":"Design Coordinator"}]},{"type":"h","text":"After Experience"},{"type":"list","items":[{"text":"Space Planner"},{"text":"Interior Designer"},{"text":"Senior Space Planner"},{"text":"Workplace Designer"},{"text":"Interior Design Executive"},{"text":"BIM Interior Designer"},{"text":"Design Coordinator"},{"text":"Workplace Planning Specialist"},{"text":"Retail Space Planner"},{"text":"Hospitality Space Planner"}]},{"type":"h","text":"Advanced"},{"type":"list","items":[{"text":"Senior Space Planner"},{"text":"Workplace Strategist"},{"text":"Interior Design Lead"},{"text":"BIM Design Specialist"},{"text":"Workplace Design Manager"},{"text":"Design Manager"},{"text":"Interior Project Manager"},{"text":"Design Consultant"},{"text":"Design Director"}]},{"type":"h","text":"What Employers Usually Test"},{"type":"p","text":"Employers commonly assess:"},{"type":"list","items":[{"text":"Space-planning ability"},{"text":"Floor-plan interpretation"},{"text":"AutoCAD"},{"text":"Revit/BIM"},{"text":"Furniture layouts"},{"text":"Ergonomics"},{"text":"Circulation"},{"text":"Design principles"},{"text":"Materials knowledge"},{"text":"Building standards"},{"text":"Visualisation"},{"text":"Design presentation"},{"text":"Problem solving"},{"text":"Client communication"},{"text":"Portfolio quality"}]},{"type":"h","text":"Practical Scenario"},{"type":"p","text":"A company gives you a 20,000 sq. ft. office floor and asks you to create a workplace layout."},{"type":"p","text":"You should:"},{"type":"list","items":[{"text":"Understand the client brief."},{"text":"Identify required departments."},{"text":"Estimate occupancy."},{"text":"Allocate functional zones."},{"text":"Separate public, collaborative and private areas."},{"text":"Plan circulation."},{"text":"Position meeting rooms and support spaces."},{"text":"Consider natural light and ventilation."},{"text":"Coordinate furniture and workstation sizes."},{"text":"Consider accessibility and fire/life-safety requirements."},{"text":"Prepare the CAD/BIM plan."},{"text":"Calculate area utilisation."},{"text":"Present alternative layouts."},{"text":"Refine the selected option."}]},{"type":"p","text":"A strong space planner optimises function, user experience, compliance and efficient use of area, not simply visual appearance."},{"type":"h","text":"Government / Public-Sector Route"},{"type":"p","text":"Possible environments include:"},{"type":"list","items":[{"text":"Public infrastructure projects"},{"text":"Government offices"},{"text":"Public-sector organisations"},{"text":"Housing projects"},{"text":"Urban development projects"},{"text":"Educational facilities"},{"text":"Healthcare facilities"},{"text":"Tourism infrastructure"},{"text":"Cultural institutions"}]},{"type":"p","text":"A typical route can be:"},{"type":"flow","items":["B.Sc Interior Design","Design Internship","Junior Designer/Planner","Space Planner","Project/Design Specialist"]},{"type":"p","text":"Specific government design posts may require particular qualifications, recognised professional degrees, examinations or experience, so eligibility must be checked against each recruitment notification."}]},{"heading":"Postgraduate Study in India","kind":"pg_india","blocks":[{"type":"h","text":"Relevant PG Options"},{"type":"list","items":[{"text":"M.Des Interior Design"},{"text":"M.Des Interior Architecture"},{"text":"M.Des Spatial Design"},{"text":"M.Arch Interior Design — where eligibility permits"},{"text":"M.Des Industrial/Spatial Design"},{"text":"MBA Real Estate"},{"text":"MBA Project Management"},{"text":"MBA Construction Management"},{"text":"PG Diploma in Interior Design"},{"text":"PG Diploma in BIM"},{"text":"Sustainable Design programs"}]},{"type":"h","text":"Best Choice by Goal"},{"type":"table","header":["Goal","Recommended PG"],"rows":[[{"text":"Advanced interior design"},{"text":"M.Des Interior Design"}],[{"text":"Spatial design"},{"text":"M.Des Spatial Design"}],[{"text":"BIM/digital construction"},{"text":"BIM-focused PG"}],[{"text":"Workplace strategy"},{"text":"M.Des + workplace specialisation"}],[{"text":"Real estate"},{"text":"MBA Real Estate"}],[{"text":"Design management"},{"text":"MBA/PG in Project Management"}],[{"text":"Academic/research career"},{"text":"M.Des → PhD"}]]},{"type":"p","text":"A PG is not mandatory for becoming a Space Planner. A strong portfolio plus CAD/BIM skills and relevant experience can be more important for entry-level private-sector employment."}]},{"heading":"Study Abroad","kind":"abroad","blocks":[{"type":"p","text":"Strong destinations include:"},{"type":"list","items":[{"text":"UK"},{"text":"USA"},{"text":"Canada"},{"text":"Australia"},{"text":"Italy"},{"text":"Germany"},{"text":"Netherlands"},{"text":"France"},{"text":"Singapore"},{"text":"UAE"},{"text":"New Zealand"}]},{"type":"p","text":"Possible programs:"},{"type":"list","items":[{"text":"Interior Architecture"},{"text":"Spatial Design"},{"text":"Interior Design"},{"text":"Workplace Design"},{"text":"Architectural Design"},{"text":"Environmental Design"},{"text":"Sustainable Design"},{"text":"Design Management"},{"text":"BIM and Digital Construction"}]},{"type":"p","text":"For international employment, students should understand local building codes, accessibility standards, fire regulations, construction practices and professional licensing requirements."}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"table","header":["Experience","Typical Position"],"rows":[[{"text":"0–1 year"},{"text":"Design Intern / Junior Space Planner"}],[{"text":"1–3 years"},{"text":"Space Planner / Interior Designer"}],[{"text":"3–6 years"},{"text":"Senior Space Planner"}],[{"text":"6–10 years"},{"text":"Workplace Strategist / Design Lead"}],[{"text":"10–15 years"},{"text":"Design Manager"}],[{"text":"15+ years"},{"text":"Design Director / Workplace Strategy Director"}]]},{"type":"h","text":"Research Opportunities"},{"type":"p","text":"Potential research areas include:"},{"type":"list","items":[{"text":"Workplace behaviour"},{"text":"Space utilisation"},{"text":"Human-centred design"},{"text":"Universal design"},{"text":"Sustainable interiors"},{"text":"Biophilic design"},{"text":"Indoor environmental quality"},{"text":"Workplace productivity"},{"text":"Ergonomics"},{"text":"Healthcare space planning"},{"text":"Smart workplaces"},{"text":"Flexible offices"},{"text":"Modular interiors"},{"text":"Circular materials"},{"text":"Low-carbon interiors"},{"text":"AI-assisted space planning"},{"text":"Generative design"},{"text":"Virtual reality in interior design"}]},{"type":"h","text":"Future Skills — 2030+"},{"type":"p","text":"Space planning is likely to become increasingly data-driven and technology-assisted."},{"type":"p","text":"Important future skills:"},{"type":"list","items":[{"text":"BIM"},{"text":"Digital twins"},{"text":"Generative design"},{"text":"AI-assisted layouts"},{"text":"Parametric design"},{"text":"Space utilisation analytics"},{"text":"IoT-enabled workplaces"},{"text":"Occupancy analytics"},{"text":"VR/AR"},{"text":"Computational design"},{"text":"Sustainable materials"},{"text":"Circular design"},{"text":"Smart building systems"},{"text":"Workplace data analysis"}]},{"type":"h","text":"2040–2046 Outlook"},{"type":"p","text":"AI will increasingly generate alternative layouts, analyse occupancy and optimise space utilisation. However, professionals will remain important for:"},{"type":"list","items":[{"text":"Understanding human behaviour"},{"text":"Client requirements"},{"text":"Design judgement"},{"text":"Regulatory interpretation"},{"text":"Accessibility"},{"text":"Safety"},{"text":"Construction coordination"},{"text":"Material selection"},{"text":"User experience"},{"text":"Stakeholder management"}]},{"type":"p","text":"The strongest space planners will therefore combine interior design + architecture fundamentals + BIM + data + AI + human-centred design."},{"type":"h","text":"Final Skill Stack"},{"type":"h","text":"Space Planning"},{"type":"list","items":[{"text":"Interior Design"},{"text":"Ergonomics"},{"text":"AutoCAD"},{"text":"Revit/BIM"},{"text":"SketchUp"},{"text":"3D Visualisation"},{"text":"Construction Documentation"},{"text":"Building Standards"},{"text":"Materials & Finishes"},{"text":"Lighting & Building Services"},{"text":"Accessibility"},{"text":"Workplace Strategy"},{"text":"Sustainability"},{"text":"Client Communication"},{"text":"Project Management"},{"text":"Space Utilisation Analytics"},{"text":"AI/Generative Design"}]},{"type":"h","text":"Target Profile"},{"type":"flow","items":["B.Sc Interior Design Graduate","Junior Space Planner","Space Planner","Senior Space Planner","Workplace Strategist / Design Lead","Design Manager","Design Director"]},{"type":"p","text":"The strongest career profile is not simply a person who can create attractive interiors, but a professional who can translate user requirements into efficient, compliant, technically documented and measurable spatial solutions."}]}]}