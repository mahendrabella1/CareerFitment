xt":"Design Manager"},{"text":"Lead design teams"}],[{"text":"8"},{"text":"Design Director/Head"},{"text":"Organisation-wide design strategy"}]]},{"type":"h","text":"Specialist Career Routes"},{"type":"h","text":"Route A — Clinical UX"},{"type":"flow","items":["UX Designer","Clinical UX Designer","Senior Clinical Designer","Clinical Design Lead"]},{"type":"h","text":"Focus on:"},{"type":"list","items":[{"text":"EHR/EMR"},{"text":"Physician workflows"},{"text":"Nursing workflows"},{"text":"Clinical dashboards"},{"text":"Clinical decision support"}]},{"type":"h","text":"Route B — Patient Experience"},{"type":"flow","items":["UX Designer","Patient Experience Designer","Senior Product Designer","Patient Experience Lead"]},{"type":"h","text":"Focus on:"},{"type":"list","items":[{"text":"Patient portals"},{"text":"Appointment booking"},{"text":"Telemedicine"},{"text":"Medication management"},{"text":"Health education"}]},{"type":"h","text":"Route C — Medical Device UX"},{"type":"flow","items":["UX Designer","Medical Device UX Designer","Human Factors Specialist","Senior Human Factors/UX Lead"]},{"type":"h","text":"Focus on:"},{"type":"list","items":[{"text":"Device interfaces"},{"text":"Human factors"},{"text":"Usability engineering"},{"text":"Error prevention"},{"text":"Safety-critical interaction"}]},{"type":"p","text":"This route requires deeper familiarity with applicable medical-device regulations and usability standards."},{"type":"h","text":"Route D — Healthcare AI UX"},{"type":"flow","items":["Healthcare UX Designer","AI Product Designer","Senior AI/Healthcare Product Designer","AI Design Lead"]},{"type":"h","text":"Focus on:"},{"type":"list","items":[{"text":"Clinical AI"},{"text":"Patient AI assistants"},{"text":"Decision-support interfaces"},{"text":"Explainability"},{"text":"Human-AI interaction"},{"text":"Uncertainty communication"},{"text":"AI safety"}]},{"type":"h","text":"AI and Future of Healthcare UX"},{"type":"p","text":"AI will significantly change hea