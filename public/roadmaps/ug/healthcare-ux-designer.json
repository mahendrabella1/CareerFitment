text":"Miro"},{"text":"Prototyping tools"}]},{"type":"h","text":"Healthcare"},{"type":"h","text":"Develop knowledge of:"},{"type":"list","items":[{"text":"Healthcare terminology"},{"text":"Clinical workflows"},{"text":"EHR/EMR"},{"text":"Health information systems"},{"text":"Healthcare interoperability"},{"text":"Accessibility"},{"text":"Privacy and security principles"}]},{"type":"h","text":"Useful standards/concepts"},{"type":"h","text":"Become familiar with:"},{"type":"list","items":[{"text":"WCAG"},{"text":"Human factors"},{"text":"Usability engineering"},{"text":"Medical-device usability concepts"},{"text":"HL7/FHIR"},{"text":"DICOM"}]},{"type":"p","text":"Where a role involves regulated medical devices or clinical software, verify the current regulatory and standards requirements for the relevant market."}]},{"heading":"Careers You Can Be Hired As","kind":"careers","blocks":[{"type":"h","text":"Entry-level"},{"type":"list","items":[{"text":"UX Design Intern"},{"text":"Healthcare UX Intern"},{"text":"Product Design Intern"},{"text":"Junior UX Designer"},{"text":"Junior Product Designer"},{"text":"UX Research Assistant"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Healthcare UX Designer"},{"text":"Product Designer"},{"text":"Healthcare Product Designer"},{"text":"UX Researcher"},{"text":"Interaction Designer"},{"text":"Service Designer"},{"text":"Medical Device UX Designer"}]},{"type":"h","text":"Senior"},{"type":"list","items":[{"text":"Senior Healthcare UX Designer"},{"text":"Senior Product Designer"},{"text":"Lead UX Designer"},{"text":"Lead Product Designer"},{"text":"Staff Product Designer"}]},{"type":"h","text":"Leadership"},{"type":"list","items":[{"text":"Design Manager"},{"text":"Healthcare Design Manager"},{"text":"Head of Product Design"},{"text":"UX Director"},{"text":"Design Director"}]},{"type":"h","text":"Interview / Portfolio Review Questions"},{"type":"list","items":[{"text":"How would you design a patient appointment system?"},{"text":"How would you research the needs of doctors and patients simultaneously?"},{"text":"What is the difference between UX for healthcare and ordinary consumer apps?"},{"text":"How would you reduce errors in a medication interface?"},{"text":"How would you design an accessible healthcare application?"},{"text":"How would you handle conflicting requirements from doctors and patients?"},{"text":"What is a service blueprint?"},{"text":"How would you design a clinical dashboard?"},{"text":"How would you prioritise information on a patient's screen?"},{"text":"What is FHIR and why might a UX designer care about it?"},{"text":"How would you conduct usability testing in a hospital environment?"},{"text":"How would you protect sensitive information in a healthcare interface?"},{"text":"How would you design for elderly or low-digital-literacy users?"},{"text":"Explain one healthcare workflow you redesigned."},{"text":"How would you validate that a healthcare design is actually safer and more usable?"}]}]},{"heading":"Postgraduate Study in India","kind":"pg_india","blocks":[{"type":"p","text":"Relevant postgraduate directions include:"},{"type":"h","text":"Design"},{"type":"list","items":[{"text":"M.Des Interaction Design"},{"text":"M.Des UX Design"},{"text":"M.Des Service Design"},{"text":"M.Des Product Design"},{"text":"M.Des Human-Centred Design"}]},{"type":"h","text":"Healthcare + Design"},{"type":"list","items":[{"text":"Medical/Healthcare Design"},{"text":"Healthcare Service Design"},{"text":"Human Factors"},{"text":"Medical Device Design"},{"text":"Healthcare Innovation"}]},{"type":"h","text":"Technology"},{"type":"p","text":"For students wanting stronger technical depth:"},{"type":"list","items":[{"text":"Human-Computer Interaction"},{"text":"Health Informatics"},{"text":"Biomedical Engineering"},{"text":"Healthcare Technology"}]},{"type":"h","text":"Management"},{"type":"h","text":"After professional experience:"},{"type":"list","items":[{"text":"MBA Hea