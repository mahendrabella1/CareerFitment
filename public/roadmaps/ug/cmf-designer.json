:"Senior CMF Designer"},{"text":"CMF Strategist"},{"text":"CMF Lead"},{"text":"CMF Design Manager"},{"text":"Design Manager"},{"text":"Creative Design Lead"}]}]},{"heading":"Interview Preparation","kind":"other","blocks":[{"type":"h","text":"Technical Questions"},{"type":"p","text":"Prepare for:"},{"type":"list","items":[{"text":"What does CMF mean?"},{"text":"Difference between color, material and finish"},{"text":"How do you select materials for a vehicle?"},{"text":"How does lighting affect perceived color?"},{"text":"What is metamerism?"},{"text":"What is color consistency?"},{"text":"What is surface texture?"},{"text":"How do gloss and matte finishes change perception?"},{"text":"What makes a material suitable for automotive interiors?"},{"text":"How do you balance aesthetics and manufacturing?"},{"text":"How can CMF improve perceived product quality?"},{"text":"What are sustainable alternatives to conventional automotive materials?"}]},{"type":"h","text":"Design Challenge"},{"type":"p","text":"You may receive:"},{"type":"p","text":"\"Create a CMF direction for a premium electric SUV.\""},{"type":"p","text":"A strong answer should demonstrate:"},{"type":"flow","items":["Research","Concept","Color","Material","Finish","Visualization","Manufacturing feasibility"]}]},{"heading":"Portfolio Structure","kind":"other","blocks":[{"type":"p","text":"A CMF portfolio should be highly visual."},{"type":"h","text":"Project 1 — CMF Trend Study"},{"type":"p","text":"Show:"},{"type":"list","items":[{"text":"Research"},{"text":"Moodboards"},{"text":"Trends"},{"text":"Color directions"},{"text":"Material references"}]},{"type":"h","text":"Project 2 — Automotive Interior CMF"},{"type":"p","text":"Show:"},{"type":"list","items":[{"text":"Dashboard"},{"text":"Seats"},{"text":"Door panels"},{"text":"Console"},{"text":"Trim"},{"text":"Material combinations"}]},{"type":"h","text":"Project 3 — Automotive Exterior CMF"},{"type":"p","text":"Show:"},{"type":"list","items":[{"text":"Body colors"},{"text":"Wheel finishes"},{"text":"Exterior trim"},{"text":"Lighting integration"}]},{"type":"h","text":"Project 4 — Sustainable EV CMF"},{"type":"p","text":"Show:"},{"type":"list","items":[{"text":"Recycled materials"},{"text":"Bio-materials"},{"text":"Low-impact finishes"},{"text":"Circular design"}]},{"type":"h","text":"Project 5 — Material Innovation"},{"type":"p","text":"Experiment with an unconventional material and investigate its potential automotive application."}]},{"heading":"High-Value Specialist Routes","kind":"other","blocks":[{"type":"h","text":"Route A — Automotive CMF Specialist"},{"type":"flow","items":["B.Des","CMF Internship","Junior CMF Designer","CMF Designer","Senior CMF Designer","CMF Lead"]},{"type":"p","text":"Best direct route."},{"type":"h","text":"Route B — Sustainable CMF"},{"type":"flow","items":["B.Des","Materials Research","Sustainable Materials","EV CMF","Material Innovation"]},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Bio-materials"},{"text":"Recycled materials"},{"text":"Circularity"},{"text":"Low-carbon materials"}]},{"type":"h","text":"Route C — Luxury CMF"},{"type":"flow","items":["B.Des","Interior CMF","Premium Materials","Luxury Automotive","CMF Strategist"]},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Craftsmanship"},{"text":"Leather alternatives"},{"text":"Metal"},{"text":"Wood"},{"text":"Textile"},{"text":"Decorative detailing"}]},{"type":"h","text":"Route D — Material Innovation"},{"type":"flow","items":["B.Des","Material Research","Experimental Materials","Automotive R&D","Material Innovation Lead"]},{"type":"p","text":"This route combines design with material science and manufacturing."}]},{"heading":"CMF Design Workflow","kind":"other","blocks":[{"type":"p","text":"A professional project can follow:"},{"type":"h","text":"Brief"},{"type":"h","text":"Brand & Customer Research"},{"type":"h","text":"Market Analysis"},{"type":"h","text":"Trend Forecasting"},{"type":"h","text":"CMF Concept"},{"type":"h","text":"Color Development"},{"type":"h","text":"Material Exploration"},{"type":"h","text":"Finish Development"},{"type":"h","text":"Digital Visualization"},{"type":"h","text":"Physical Samples"},{"type":"h","text":"Prototype"},{"type":"h","text":"Supplier Validation"},{"type":"h","text":"Engineering Validation"},{"type":"h","text":"Production"},{"type":"p","text":"Understanding the transition from design concept to manufacturable material is a major differentiator."}]},{"heading":"Portfolio Projects to Build Before Graduation","kind":"other","blocks":[{"type":"table","header":["Project","Main Skill"],"rows":[[{"text":"Premium EV CMF"},{"text":"Automotive CMF"}],[{"text":"Sustainable EV Interior"},{"text":"Sustainability"}],[{"text":"Luxury SUV Interior"},{"text":"Premium materials"}],[{"text":"Sportscar Exterior CMF"},{"text":"Performance design"}],[{"text":"Urban Mobility CMF"},{"text":"Cost-conscious design"}],[{"text":"Motorcycle CMF"},{"text":"Two-wheeler design"}],[{"text":"Future Autonomous Vehicle"},{"text":"Future mobility"}],[{"text":"Bio-material Experiment"},{"text":"Material innovation"}],[{"text":"Automotive Textile Collection"},{"text":"Textile/material design"}],[{"text":"Digital CMF Configurator"},{"text":"Digital visualization"}]]}]},{"heading":"AI and Future of CMF Design","kind":"other","blocks":[{"type":"p","text":"AI will increasingly support:"},{"type":"list","items":[{"text":"Color exploration"},{"text":"Material concept generation"},{"text":"Trend analysis"},{"text":"Image synthesis"},{"text":"Rapid visualization"},{"text":"Generative design"},{"text":"Customer preference analysis"},{"text":"Design variant generation"},{"text":"Virtual prototyping"},{"text":"Material discovery"}]},{"type":"p","text":"But CMF designers still need to understand physical materials and manufacturing."},{"type":"p","text":"AI can generate a visually attractive material that may be:"},{"type":"list","items":[{"text":"impossible to man