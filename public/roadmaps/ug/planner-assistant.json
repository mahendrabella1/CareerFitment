clude:"},{"type":"list","items":[{"text":"Urban Planning"},{"text":"Regional Planning"},{"text":"Spatial Planning"},{"text":"Environmental Planning"},{"text":"Transport Planning"},{"text":"Urban Analytics"},{"text":"GIS & Geospatial Science"},{"text":"Smart Cities"},{"text":"Sustainable Development"},{"text":"Climate Adaptation"},{"text":"Disaster Risk Management"},{"text":"Regional Development"},{"text":"Housing & Community Development"},{"text":"Environmental Management"}]}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"0–2 years"},{"type":"h","text":"Planning Intern → Planner Assistant / Planning Assistant"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"GIS"},{"text":"Field surveys"},{"text":"Data preparation"},{"text":"Maps"},{"text":"Reports"},{"text":"Planning documentation"}]},{"type":"h","text":"2–5 years"},{"type":"h","text":"Planning Assistant → Planning Analyst / GIS Analyst"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Independent analysis"},{"text":"Spatial modelling"},{"text":"Planning reports"},{"text":"Client projects"},{"text":"Data visualisation"}]},{"type":"h","text":"5–8 years"},{"type":"h","text":"Senior Planning Analyst / Specialist"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Project ownership"},{"text":"Stakeholder coordination"},{"text":"Technical leadership"},{"text":"Planning strategy"}]},{"type":"h","text":"8–12+ years"},{"type":"h","text":"Planning Manager / Planning Consultant / Specialist"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Major planning projects"},{"text":"Team leadership"},{"text":"Policy"},{"text":"Infrastructure"},{"text":"Urban/regional strategy"}]},{"type":"h","text":"2040–2046 Career Evolution"},{"type":"p","text":"Planning will increasingly become data-driven, geospatial, climate-aware, and AI-assisted."},{"type":"h","text":"Emerging roles"},{"type":"list","items":[{"text":"AI Urban Planning Specialist"},{"text":"Urban Data Scientist"},{"text":"Geospatial Data Scientist"},{"text":"Smart City Data Specialist"},{"text":"Digital Twin Planning Specialist"},{"text":"Climate Resilience Planner"},{"text":"Urban Mobility Data Analyst"},{"text":"AI Environmental Planning Specialist"},{"text":"Spatial AI Specialist"},{"text":"Urban Simulation Analyst"},{"text":"Geospatial Planning Consultant"}]},{"type":"h","text":"AI applications"},{"type":"p","text":"AI and spatial computing can support:"},{"type":"list","items":[{"text":"Urban growth prediction"},{"text":"Land-use classification"},{"text":"Traffic forecasting"},{"text":"Infrastructure-demand prediction"},{"text":"Climate-risk mapping"},{"text":"Flood-risk modelling"},{"text":"Housing-demand analysis"},{"text":"Public-facility optimisation"},{"text":"Urban digital twins"},{"text":"Scenario modelling"}]},{"type":"p","text":"The planner will still be responsible for context, policy interpretation, stakeholder interests, ethics, trade-offs, and final planning decisions."},{"type":"h","text":"Recommended Final Skill Stack"},{"type":"h","text":"Geography"},{"type":"flow","items":["Human Geography","Physical Geography","Urban Geography","Environmental Geography"],"sep":"+"},{"type":"h","text":"Planning"},{"type":"flow","items":["Land Use","Urban Planning","Regional Planning","Infrastructure","Transport","Environment"],"sep":"+"},{"type":"h","text":"Geospatial"},{"type":"flow","items":["QGIS","ArcGIS","Remote Sensing","Google Earth Engine","PostGIS"],"sep":"+"},{"type":"h","text":"Data"},{"type":"flow","items":["Statistics","Excel","Power BI","SQL","Python","GeoPandas"],"sep":"+"},{"type":"h","text":"Technical"},{"type":"flow","items":["AutoCAD","SketchUp","Web GIS","Spatial Databases"],"sep":"+"},{"type":"h","text":"Future"},{"type":"flow","items":["AI","Spatial AI","Digital Twins","Urban Analytics","Climate Modelling"],"sep":"+"},{"type":"h","text":"Professional"},{"type":"flow","items":["Fieldwork","Report Writing","Stakeholder Management","Project Coordination"],"sep":"+"},{"type":"h","text":"Target Progression"},{"type":"h","text":"BA Geography & Environmental Planning"},{"type":"h","text":"GIS / Planning Intern"},{"type":"h","text":"Planner Assistant"},{"type":"h","text":"Planning Assistant / GIS Assistant"},{"type":"h","text":"Planning Analyst / GIS Analyst"},{"type":"h","text":"Senior Planning Analyst / Geospatial Planning Specialist"},{"type":"h","text":"Planning Manager / Urban or Environmental Planning Specialist"},{"type":"h","text":"Planning Consultant / Planning Director"},{"type":"h","text":"Best overall strategy"},{"type":"p","text":"BA Geography & Environmental Planning + strong GIS + remote sensing + planning fundamentals + spatial data analytics + AutoCAD + fieldwork + environmental/climate knowledge is the strongest employability combination."},{"type":"p","text":"For this career, the portfolio should contain GIS maps, land-use analyses, accessibility studies, environmental-risk maps, urban-growth analyses, planning reports, field-survey outputs, and at least one complete planning project. This makes the graduate useful to planning and geospatial teams from the beginning rather than relying only on the BA qualification."}]}]}