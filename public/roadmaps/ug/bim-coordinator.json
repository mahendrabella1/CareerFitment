"text":"Model completeness"},{"text":"Duplicate elements"},{"text":"Unconnected elements"},{"text":"Missing parameters"},{"text":"Incorrect families"},{"text":"Level consistency"},{"text":"Model warnings"},{"text":"Geometry issues"},{"text":"Required information fields"}]}]},{"heading":"BIM Automation","kind":"other","blocks":[{"type":"p","text":"This is becoming an important differentiator."},{"type":"h","text":"Dynamo"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Visual programming"},{"text":"Repetitive task automation"},{"text":"Parameter management"},{"text":"Model cleanup"},{"text":"Data extraction"}]},{"type":"h","text":"Python"},{"type":"p","text":"Use Python for:"},{"type":"list","items":[{"text":"BIM data analysis"},{"text":"Automated reporting"},{"text":"Model validation"},{"text":"Quantity extraction"},{"text":"Issue analysis"}]},{"type":"p","text":"Explore:"},{"type":"list","items":[{"text":"Revit API concepts"},{"text":"Autodesk Platform Services"},{"text":"IFC-based workflows"},{"text":"BIM data processing"}]}]},{"heading":"Five Recommended UG Projects","kind":"other","blocks":[{"type":"h","text":"Project 1 — Multidisciplinary BIM Coordination"},{"type":"p","text":"Create a complete building model involving:"},{"type":"list","items":[{"text":"Architecture"},{"text":"Structure"},{"text":"HVAC"},{"text":"Plumbing"},{"text":"Electrical"}]},{"type":"p","text":"Federate the models and perform clash detection."},{"type":"p","text":"Deliver:"},{"type":"list","items":[{"text":"Clash report"},{"text":"Coordination report"},{"text":"Resolved model"}]},{"type":"h","text":"Project 2 — 4D Construction Simulation"},{"type":"p","text":"Create a building model and connect it to a construction schedule."},{"type":"p","text":"Demonstrate:"},{"type":"flow","items":["Foundation","Structure","MEP","Finishes"]},{"type":"p","text":"using a 4D simulation."},{"type":"h","text":"Project 3 — 5D BIM Cost Model"},{"type":"p","text":"Build a BIM model and extract:"},{"type":"list","items":[{"text":"Concrete quantities"},{"text":"Steel"},{"text":"Walls"},{"text":"Doors/windows"},{"text":"MEP quantities"}]},{"type":"p","text":"Connect the quantities to a cost database."},{"type":"h","text":"Project 4 — Automated BIM Quality Checker"},{"type":"p","text":"Create a Dynamo/Python workflow to identify:"},{"type":"list","items":[{"text":"Missing parameters"},{"text":"Incorrect naming"},{"text":"Duplicate elements"},{"text":"Incomplete data"},{"text":"Model inconsistencies"}]},{"type":"p","text":"Generate an automated report."},{"type":"h","text":"Project 5 — Smart Infrastructure Digital Twin"},{"type":"p","text":"Create a BIM model of a:"},{"type":"list","items":[{"text":"Building"},{"text":"Metro station"},{"text":"Road"},{"text":"Hospital"},{"text":"Campus"}]},{"type":"p","text":"Add asset information and demonstrate how BIM can support:"},{"type":"list","items":[{"text":"Maintenance"},{"text":"Energy monitoring"},{"text":"Asset management"},{"text":"Lifecycle planning"}]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"h","text":"Year 2"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Architectural firms"},{"text":"Civil engineering consultancies"},{"text":"BIM modelling companies"},{"text":"Construction companies"}]},{"type":"h","text":"Year 3"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"BIM coordination teams"},{"text":"EPC companies"},{"text":"Infrastructure projects"},{"text":"MEP consultants"},{"text":"Structural consultants"}]},{"type":"h","text":"Year 4"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"BIM coordination"},{"text":"Digital construction"},{"text":"BIM implementation"},{"text":"4D/5D BIM"},{"text":"Infrastructure digital engineering"}]},{"type":"p","text":"Ideal progression:"},{"type":"flow","items":["BIM Modelling Internship","Multidisciplinary BIM Internship","BIM Coordination Internship","BIM Engineer","BIM Coordinator"]}]},{"head