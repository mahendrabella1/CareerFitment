s & Additional Learning","kind":"certifications","blocks":[{"type":"h","text":"High Priority"},{"type":"list","items":[{"text":"Basic Life Support"},{"text":"First aid"},{"text":"Geriatric care"},{"text":"Dementia care"},{"text":"Fall prevention"},{"text":"Infection control"},{"text":"Patient handling and transfers"}]},{"type":"h","text":"Specialized"},{"type":"list","items":[{"text":"Palliative-care fundamentals"},{"text":"Alzheimer's/dementia care"},{"text":"Disability support"},{"text":"Rehabilitation support"},{"text":"Mental-health first aid"},{"text":"Nutrition for older adults"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Home-healthcare software"},{"text":"EMR/EHR"},{"text":"Remote patient monitoring"},{"text":"Excel"},{"text":"Digital care documentation"},{"text":"Certifications should complement practical training and should not be represented as substitutes for regulated clinical qualifications."}]}]},{"heading":"PG & Advanced Education","kind":"pg_india","blocks":[{"type":"p","text":"Depending on the student's underlying qualification:"},{"type":"h","text":"Geriatric / Healthcare"},{"type":"list","items":[{"text":"Geriatric care programs"},{"text":"Gerontology"},{"text":"Geriatric healthcare"},{"text":"Public Health"},{"text":"Community Health"}]},{"type":"h","text":"Nursing"},{"type":"p","text":"Students with the required nursing qualification may pursue:"},{"type":"list","items":[{"text":"M.Sc Nursing"},{"text":"Geriatric/Community/Mental Health Nursing where available and eligible"}]},{"type":"h","text":"Healthcare Management"},{"type":"list","items":[{"text":"MBA Healthcare Management"},{"text":"Hospital Administration"},{"text":"Healthcare Operations"}]},{"type":"h","text":"Public Health"},{"type":"list","items":[{"text":"MPH"},{"text":"Gerontology"},{"text":"Community Health"},{"text":"Health Services Management"}]}]},{"heading":"Career Specializations","kind":"other","blocks":[{"type":"h","text":"1. Home Geriatric Caregiver"},