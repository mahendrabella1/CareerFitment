","blocks":[{"type":"table","header":["Area","Skills to Develop"],"rows":[[{"text":"Cell Biology"},{"text":"Cell growth, metabolism, viability"}],[{"text":"Microbiology"},{"text":"Culture, contamination control"}],[{"text":"Biochemistry"},{"text":"Proteins, enzymes, metabolites"}],[{"text":"Molecular Biology"},{"text":"DNA/RNA, recombinant technology"}],[{"text":"Upstream Processing"},{"text":"Cell culture, fermentation, media"}],[{"text":"Downstream Processing"},{"text":"Harvesting, filtration, purification"}],[{"text":"Bioreactors"},{"text":"Parameters, monitoring, operation"}],[{"text":"Fermentation"},{"text":"Batch, fed-batch fundamentals"}],[{"text":"Chromatography"},{"text":"Purification fundamentals"}],[{"text":"Filtration"},{"text":"Depth and membrane filtration"}],[{"text":"Process Control"},{"text":"pH, DO, temperature, agitation"}],[{"text":"GMP"},{"text":"Manufacturing compliance"}],[{"text":"Documentation"},{"text":"Batch records, SOPs, deviations"}],[{"text":"Data Analysis"},{"text":"Process trends and statistics"}]]}]},{"heading":"Upstream Processing","kind":"other","blocks":[{"type":"p","text":"Upstream processing is a core area for the role."},{"type":"p","text":"Learn:"},{"type":"h","text":"Cell Culture"},{"type":"list","items":[{"text":"Cell lines"},{"text":"Cell viability"},{"text":"Cell density"},{"text":"Growth curves"},{"text":"Media preparation"},{"text":"Nutrient requirements"},{"text":"Aseptic handling"}]},{"type":"h","text":"Microbial Fermentation"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Inoculum preparation"},{"text":"Batch fermentation"},{"text":"Fed-batch fermentation"},{"text":"Growth kinetics"},{"text":"Oxygen transfer"},{"text":"Nutrient feeding"},{"text":"Product formation"}]},{"type":"h","text":"Key Parameters"},{"type":"p","text":"Monitor:"},{"type":"list","items":[{"text":"Temperature"},{"text":"pH"},{"text":"Dissolved oxygen"},{"text":"Agitation"},{"text":"Pressure"},{"text":"Gas flow"},{"text":"Cell 