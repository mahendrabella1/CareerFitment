ramme"},{"type":"p","text":"Develop a competency checklist for:"},{"type":"list","items":[{"text":"Medication administration"},{"text":"IV therapy"},{"text":"Wound care"},{"text":"Patient assessment"}]},{"type":"h","text":"Project 3 — OSCE-Based Assessment"},{"type":"p","text":"Design an OSCE framework with stations covering common nursing procedures."},{"type":"h","text":"Project 4 — Medication-Safety Teaching Module"},{"type":"p","text":"Create a student training programme covering:"},{"type":"list","items":[{"text":"Medication rights"},{"text":"Error prevention"},{"text":"High-risk medications"},{"text":"Documentation"}]},{"type":"h","text":"Project 5 — Infection-Control Training"},{"type":"p","text":"Develop and evaluate a student programme on:"},{"type":"list","items":[{"text":"Hand hygiene"},{"text":"PPE"},{"text":"Aseptic technique"},{"text":"Isolation precautions"}]},{"type":"h","text":"Project 6 — Digital Nursing Education"},{"type":"p","text":"Develop an online learning module with:"},{"type":"list","items":[{"text":"Videos"},{"text":"Quizzes"},{"text":"Case scenarios"},{"text":"Skills checklists"},{"text":"Competency assessment"}]}]},{"heading":"Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Skill","Importance","Graduation Target"],"rows":[[{"text":"Clinical nursing"},{"text":"★★★★★"},{"text":"Advanced"}],[{"text":"Nursing education"},{"text":"★★★★★"},{"text":"Advanced"}],[{"text":"Clinical teaching"},{"text":"★★★★★"},{"text":"Advanced"}],[{"text":"Student supervision"},{"text":"★★★★★"},{"text":"Strong"}],[{"text":"Skills demonstration"},{"text":"★★★★★"},{"text":"Advanced"}],[{"text":"Assessment"},{"text":"★★★★★"},{"text":"Strong"}],[{"text":"Feedback"},{"text":"★★★★★"},{"text":"Advanced"}],[{"text":"Communication"},{"text":"★★★★★"},{"text":"Advanced"}],[{"text":"Simulation"},{"text":"★★★★☆"},{"text":"Strong"}],[{"text":"Lesson planning"},{"text":"★★★★★"},{"text":"Strong"}],[{"text":"Curriculum implementation"},{"text":"★★★★☆"},{"text":