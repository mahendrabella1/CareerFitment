e":"p","text":"Competency Assessment"},{"type":"h","text":"Digital"},{"type":"p","text":"PowerPoint"},{"type":"p","text":"+"},{"type":"p","text":"Excel"},{"type":"p","text":"+"},{"type":"p","text":"LMS"},{"type":"p","text":"+"},{"type":"p","text":"Digital Assessment"},{"type":"p","text":"+"},{"type":"p","text":"Simulation Technology"},{"type":"p","text":"+"},{"type":"p","text":"Learning Analytics"},{"type":"h","text":"Professional"},{"type":"p","text":"Communication"},{"type":"p","text":"+"},{"type":"p","text":"Leadership"},{"type":"p","text":"+"},{"type":"p","text":"Research"},{"type":"p","text":"+"},{"type":"p","text":"Evidence-Based Practice"},{"type":"p","text":"+"},{"type":"p","text":"Academic Writing"}]},{"heading":"Target Profile by Graduation","kind":"other","blocks":[{"type":"p","text":"By completion of the Post-Basic B.Sc Nursing pathway, the candidate should ideally have:"},{"type":"list","items":[{"text":"Strong clinical nursing competence"},{"text":"Prior professional nursing experience"},{"text":"Strong teaching fundamentals"},{"text":"Clinical supervision experience"},{"text":"Skills-lab teaching ability"},{"text":"Lesson-planning capability"},{"text":"Student assessment skills"},{"text":"OSCE/competency-assessment knowledge"},{"text":"Effective feedback and mentoring skills"},{"text":"Simulation exposure"},{"text":"Digital teaching capability"},{"text":"Basic research and biostatistics knowledge"},{"text":"Evidence-based practice skills"},{"text":"Strong documentation and communication"}]},{"type":"h","text":"Ideal Portfolio"},{"type":"p","text":"Nursing Qualification"},{"type":"p","text":"+"},{"type":"p","text":"Clinical Experience"},{"type":"p","text":"+"},{"type":"p","text":"Post-Basic B.Sc Nursing"},{"type":"p","text":"+"},{"type":"p","text":"Clinical Teaching Exposure"},{"type":"p","text":"+"},{"type":"p","text":"Skills-Lab Demonstration"},{"type":"p","text":"+"},{"type":"p","text":"Student Assessment"},{"type":"p","text":"+"},{"type":"p","text":"Simulation Project"},{"type":"p","text":"+"},{"type":"p","text":"OSCE / Competency Framework"},{"type":"p","text":"+"},{"type":"flow","items":["Research / Education Project","Clinical Instructor","Senior Clinical Instructor","Nursing Educator / Faculty","Academic Leadership"]},{"type":"h","text":"Best Overall Positioning"},{"type":"flow","items":["Nursing qualification + clinical experience","Post-Basic B.Sc Nursing","clinical teaching exposure","skills-lab/simulation competence","Clinical Instructor","Senior Clinical Instructor/Nursing Educator","M.Sc Nursing","faculty and nursing-education leadership"]},{"type":"p","text":"For ID 2041, the strongest differentiator is clinical credibility combined with teaching ability. The candidate should not position themselves simply as a nurse who can teach; they should develop into an educator who can demonstrate procedures, supervise students safely, assess competency, provide evidence-based feedback, use simulation effectively, and connect classroom knowledge to real clinical practice."}]}]}