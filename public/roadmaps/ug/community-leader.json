awareness"}]},{"type":"h","text":"Practical project"},{"type":"p","text":"Conduct a small:"},{"type":"h","text":"Community Needs Assessment"},{"type":"p","text":"For example, study a local community's needs around:"},{"type":"list","items":[{"text":"Education"},{"text":"Employment"},{"text":"Youth development"},{"text":"Digital literacy"},{"text":"Financial awareness"},{"text":"Elderly support"}]},{"type":"p","text":"Use ethical research and informed participation."}]},{"heading":"Year 2 — Community Development","kind":"other","blocks":[{"type":"p","text":"Move from understanding communities to working with them."},{"type":"h","text":"Learn"},{"type":"list","items":[{"text":"Community development"},{"text":"Social work fundamentals"},{"text":"Development economics"},{"text":"Sociology"},{"text":"Social research"},{"text":"NGO management"},{"text":"Volunteer management"},{"text":"Project planning"},{"text":"Fundraising"},{"text":"Communication campaigns"},{"text":"Conflict resolution"}]},{"type":"h","text":"Technology"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Excel"},{"text":"Google Forms"},{"text":"Google Sheets"},{"text":"Canva"},{"text":"PowerPoint"},{"text":"Basic data visualisation"}]},{"type":"h","text":"Practical project"},{"type":"p","text":"Create a:"},{"type":"h","text":"Community Programme Plan"},{"type":"p","text":"Example:"},{"type":"p","text":"Youth Digital Literacy Programme"},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Problem statement"},{"text":"Target community"},{"text":"Objectives"},{"text":"Activities"},{"text":"Timeline"},{"text":"Budget"},{"text":"Volunteers"},{"text":"Partners"},{"text":"Measurement indicators"},{"text":"Expected outcomes"}]}]},{"heading":"Year 3 — Leadership + Programme Management","kind":"other","blocks":[{"type":"p","text":"The student should develop the ability to lead projects rather than simply participate in them."},{"type":"h","text":"Learn"},{"type":"list","items":[{"text":"L