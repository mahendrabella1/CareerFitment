},{"text":"Mobilisation, engagement, participation"}],[{"text":"Leadership"},{"text":"Team management, facilitation"}],[{"text":"Communication"},{"text":"Public speaking, writing, presentations"}],[{"text":"Development"},{"text":"Community development, social impact"}],[{"text":"Project Management"},{"text":"Planning, budgeting, execution"}],[{"text":"Research"},{"text":"Surveys, interviews, needs assessment"}],[{"text":"M&E"},{"text":"Indicators, outcomes, reporting"}],[{"text":"Fundraising"},{"text":"Donor communication, proposals"}],[{"text":"Digital"},{"text":"Excel, Google Workspace, Canva"}],[{"text":"Analytics"},{"text":"Power BI, basic SQL"}],[{"text":"Conflict"},{"text":"Mediation, dialogue, negotiation"}]]}]},{"heading":"Internships & Volunteering","kind":"internships","blocks":[{"type":"p","text":"For community leadership, volunteering is often as important as formal internships."},{"type":"h","text":"Target organisations"},{"type":"list","items":[{"text":"NGOs"},{"text":"Faith-based charities"},{"text":"Community organisations"},{"text":"Youth organisations"},{"text":"Educational NGOs"},{"text":"Social-service organisations"},{"text":"Humanitarian organisations"},{"text":"CSR foundations"},{"text":"Non-profit institutions"},{"text":"Community development projects"}]},{"type":"h","text":"Useful positions"},{"type":"list","items":[{"text":"Community Outreach Intern"},{"text":"Programme Intern"},{"text":"NGO Intern"},{"text":"Volunteer Coordinator Intern"},{"text":"Community Development Intern"},{"text":"Social Impact Intern"},{"text":"Youth Programme Intern"},{"text":"Project Intern"},{"text":"Field Coordinator Intern"},{"text":"Programme Assistant"}]},{"type":"h","text":"Ideal experience"},{"type":"h","text":"Year 1"},{"type":"p","text":"Volunteer"},{"type":"h","text":"Year 2"},{"type":"p","text":"Community/NGO internship"},{"type":"h","text":"Year 3"},{"type":"p","text":"Lead a community project"},{"type":"h","text":"Final year"},{"type":"p","text":"Programme/community-development internship"}]},{"heading":"Practical Projects","kind":"other","blocks":[{"type":"h","text":"Project 1 — Community Needs Assessment"},{"type":"p","text":"Conduct a structured assessment covering:"},{"type":"list","items":[{"text":"Demographics"},{"text":"Education"},{"text":"Employment"},{"text":"Access to services"},{"text":"Digital access"},{"text":"Major community concerns"}]},{"type":"p","text":"Produce:"},{"type":"list","items":[{"text":"Survey"},{"text":"Data analysis"},{"text":"Findings"},{"text":"Recommendations"}]},{"type":"h","text":"Project 2 — Youth Development Programme"},{"type":"p","text":"Design and execute a programme around:"},{"type":"list","items":[{"text":"Career awareness"},{"text":"Digital skills"},{"text":"Financial literacy"},{"text":"Entrepreneurship"},{"text":"Employability"}]},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Participants"},{"text":"Attendance"},{"text":"Completion"},{"text":"Learning outcomes"},{"text":"Feedback"}]},{"type":"h","text":"Project 3 — Community Education Campaign"},{"type":"p","text":"Example:"},{"type":"h","text":"Digital Literacy for Senior Citizens"},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"Programme objectives"},{"text":"Training material"},{"text":"Volunteer plan"},{"text":"Sessions"},{"text":"Feedback form"},{"text":"Outcome report"}]},{"type":"h","text":"Project 4 — Interfaith/Community Dialogue"},{"type":"p","text":"Where appropriate and with respect for participants, organise a dialogue around:"},{"type":"list","items":[{"text":"Community service"},{"text":"Social responsibility"},{"text":"Peace"},{"text":"Ethics"},{"text":"Humanitarian action"}]},{"type":"p","text":"The focus should be constructive dialogue rather than persuasion or religious competition."},{"type":"h","text":"Project 5 — Community Impact Dashboard"},{"type":"p","text":"Use Power BI to track:"},{"type":"list","items":[{"text":"Participants"},{"text":"Programmes"},{"text":"Attendance"},{"text":"Volunteer hours"},{"text":"Funds"},{"text":"Beneficiaries"},{"text":"Outcomes"}]},{"type":"p","text":"This creates a modern community leadership + data profile."}]},{"heading":"Certifications & Additional Learning","kind":"certifications","blocks":[{"type":"p","text":"Certifications are useful, but actual community leadership experience should remain the priority."},{"type":"h","text":"Useful areas"},{"type":"list","items":[{"text":"Community Development"},{"text":"NGO Management"},{"text":"Project Management"},{"text":"Monitoring & Evaluation"},{"text":"Social Impact"},{"text":"Fundraising"},{"text":"Grant Writing"},{"text":"Volunteer Management"},{"text":"Conflict Resolution"},{"text":"Mediation"},{"text":"Counselling basics"},{"text":"Public Speaking"},{"text":"Leadership"},{"text":"Social Research"},{"text":"Data Analytics"}]},{"type":"h","text":"Strong technical combination"},{"type":"flow","items":["Excel","Power BI","Project Management","M&E"],"sep":"+"}]},{"heading":"Jobs You Can Be Hired For","kind":"careers","blocks":[{"type":"p","text":"The student should not search only for Community Leader."},{"type":"h","text":"Direct-entry roles"},{"type":"list","items":[{"text":"Community Coordinator"},{"text":"Community Outreach Executive"},{"text":"Community Programme Assistant"},{"text":"Programme Assistant"},{"text":"Programme Coordinator"},{"text":"NGO Programme Executive"},{"text":"Community Development Associate"},{"text":"Field Coordinator"},{"text":"Social Impact Associate"},{"text":"Volunteer Coordinator"},{"text":"Youth Programme Coordinator"},{"text":"Outreach Coordinator"},{"text":"Community Engagement Executive"},{"text":"Project Coordinator"},{"text":"Social Development Associate"}]},{"type":"h","text":"Faith-based organisations"},{"type":"p","text":"Depending on the organisation:"},{"type":"list","items":[{"text":"Community Ministry Coordinator"},{"text":"Outreach Coordinator"},{"text":"Youth Programme Coordinator"},{"text":"Social-Service Coordinator"},{"text":"Community Programme Officer"},{"text":"Volunteer Coordinator"}]},{"type":"p","text":"Formal religious leadership titles may require separate faith-specific qualifications or recognition."}]},{"heading":"Employer-Ready Skill Stack","kind":"other","blocks":[{"type":"p","text":"A strong graduate should be able to demonstrate:"},{"type":"h","text":"Community"},{"type":"list","items":[{"text":"Community mobilisation"},{"text":"Needs assessment"},{"text":"Stakeholder engagement"},{"text":"Volunteer coordination"}]},{"type":"h","text":"Programme management"},{"type":"list","items":[{"text":"Project planning"},{"text":"Budgeting"},{"text":"Scheduling"},{"text":"Implementation"},{"text":"Monitoring"}]},{"type":"h","text":"Research"},{"type":"list","items":[{"text":"Surveys"},{"text":"Interviews"},{"text":"Focus groups"},{"text":"Data analysis"},{"text":"Report writing"}]},{"type":"h","text":"Social impact"},{"type":"list","items":[{"text":"Theory of Change"},{"text":"Logic models"},{"text":"Outcome indicators"},{"text":"Monitoring & evaluation"}]},{"type":"h","text":"Communication"},{"type":"list","items":[{"text":"Public speaking"},{"text":"Facilitation"},{"text":"Conflict management"},{"text":"Proposal writing"},{"text":"Donor communication"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Excel"},{"text":"Power BI"},{"text":"Google Workspace"},{"text":"Canva"},{"text":"Basic CRM/database skills"}]}]},{"heading":"Postgraduate Options","kind":"pg_india","blocks":[{"type":"p","text":"A PG can help the student transition into professional development-sector or leadership roles."},{"type":"table","header":["PG Programme","Best For"],"rows":[[{"text":"MA Social Work"},{"text":"Community and social services"}],[{"text":"MA Sociology"},{"text":"Community/social research"}],[{"text":"MA Development Studies"},{"text":"Development sector"}],[{"text":"MA Rural Development"},{"text":"Rural/community development"}],[{"text":"MA Public Policy"},{"text":"Policy and advocacy"}],[{"text":"MA Public Administration"},{"text":"Government/community administration"}],[{"text":"MA Theology"},{"text":"Advanced theological/religious studies"}],[{"text":"MA Religious Studies"},{"text":"Religion and society"}],[{"text":"MA Peace & Conflict Studies"},{"text":"Dialogue/conflict resolution"}],[{"text":"MBA Social Impact"},{"text":"Social enterprise/impact management"}],[{"text":"MBA NGO Management"},{"text":"Non-profit management"}],[{"text":"MA/PG Diploma Development Management"},{"text":"Programme management"}],[{"text":"MSc Social Data/Analytics"},{"text":"Evidence-based community programmes"}]]},{"type":"h","text":"Strong pathways"},{"type":"flow","items":["BA Theology","MA Social Work","Community Programme Management"]},{"type":"p","text":"or"},{"type":"flow","items":["BA Theology","MA Development Studies","NGO Programme Management"]},{"type":"p","text":"or"},{"type":"flow","items":["BA Theology","MA Theology/Religious Studies","Faith-based Community Leadership"]}]},{"heading":"Religious Leadership vs Community Leadership","kind":"other","blocks":[{"type":"p","text":"This distinction is especially important for this career."},{"type":"h","text":"Community leadership"},{"type":"p","text":"Can involve:"},{"type":"list","items":[{"text":"Social programmes"},{"text":"Education"},{"text":"Youth work"},{"text":"Community development"},{"text":"NGO projects"},{"text":"Volunteer management"},{"text":"Social impact"}]},{"type":"p","text":"A BA can provide a foundation, supplemented by practical experience."},{"type":"h","text":"Formal religious leadership"},{"type":"p","text":"Depending on the faith tradition, formal roles may require:"},{"type":"list","items":[{"text":"Theological education"},{"text":"Seminary/institutional training"},{"text":"Ordination"},{"text":"Denominational recognition"},{"text":"Religious authority"},{"text":"Additional formation/training"}]},{"type":"p","text":"These requirements are tradition- and institution-specific."},{"type":"p","text":"Therefore:"},{"type":"p","text":"BA Theology/Religious Studies → Community Leader is a reasonable career pathway, but it should not be presented as automatic qualification for formal clergy or religious-office positions."}]},{"heading":"Study Abroad","kind":"abroad","blocks":[{"type":"p","text":"Relevant international study areas include:"},{"type":"list","items":[{"text":"Community Development"},{"text":"Development Studies"},{"text":"Social Work"},{"text":"Non-Profit Management"},{"text":"Public Policy"},{"text":"Peace & Conflict Studies"},{"text":"Religious Studies"},{"text":"Theology"},{"text":"Humanitarian Studies"},{"text":"Social Impact"}]},{"type":"p","text":"Potential destinations:"},{"type":"list","items":[{"text":"UK"},{"text":"USA"},{"text":"Canada"},{"text":"Australia"},{"text":"Netherlands"},{"text":"Germany"},{"text":"Ireland"}]},{"type":"p","text":"For community-development careers, evaluate:"},{"type":"list","items":[{"text":"Fieldwork opportunities"},{"text":"NGO partnerships"},{"text":"Community placements"},{"text":"Programme management curriculum"},{"text":"Research opportunities"},{"text":"Professional recognition"},{"text":"Post-study work rights"}]}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"p","text":"A realistic development-sector pathway could be:"},{"type":"flow","items":["Volunteer","Programme Assistant / Community Outreach Executive","Community Coordinator","Community Programme Officer","Senior Programme Officer","Programme Manager","Community Development Manager","Head of Programmes / Community Development Director"]},{"type":"h","text":"Faith-based pathway"},{"type":"flow","items":["Volunteer","Community/Outreach Coordinator","Community Programme Manager","Regional Programme Leader","Community/Ministry Leadership"]},{"type":"p","text":"Formal religious leadership titles depend on the relevant faith institution's requirements."}]},{"heading":"Specialisation