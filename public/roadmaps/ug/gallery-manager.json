{"title":"Career Roadmap: Gallery Manager","role":"Gallery Manager","summary":"Career Domain: Media, Communication, Arts & Design · Qualification Pathway: BFA – Painting · Target Career: Gallery Manager","facts":{"Current degree":"BFA (Bachelor of Fine Arts)","Course":"Painting"},"about":[{"label":"About this roadmap","text":"This roadmap was drafted with AI assistance from OneGrasp's related roadmaps and is awaiting expert review. Check fees, dates, eligibility and exam patterns on the official websites before you rely on them."}],"intro":[],"horizons":[],"sections":[{"heading":"Career Overview","kind":"other","blocks":[{"type":"p","text":"A Gallery Manager runs the business side of an art gallery: artists, exhibitions, sales, clients, staff and budgets."},{"type":"h","text":"What a Gallery Manager does"},{"type":"list","items":[{"text":"Plan the exhibition calendar with artists"},{"text":"Build relationships with collectors and sell work"},{"text":"Manage staff, budgets and logistics"},{"text":"Handle marketing, events and art fairs"}]},{"type":"p","text":"Where they work:"},{"type":"list","items":[{"text":"Commercial art galleries"},{"text":"Art fairs"},{"text":"Auction houses"},{"text":"Art-advisory firms"}]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Career stage","Typical role"],"rows":[[{"text":"Entry-level"},{"text":"Gallery Assistant"}],[{"text":"Early career"},{"text":"Associate"}],[{"text":"Mid-level"},{"text":"Gallery Manager"}],[{"text":"Senior"},{"text":"Director"}],[{"text":"Leadership"},{"text":"Gallery owner"}]]}]},{"heading":"Year-by-Year Learning Roadmap","kind":"build","blocks":[{"type":"h","text":"Year 1: Art foundations"},{"type":"list","items":[{"text":"Study art and art history"},{"text":"Visit galleries and note how they work"},{"text":"Learn basic accounting"}]},{"type":"h","text":"Year 2: Art business"},{"type":"list","items":[{"text":"Learn art marketing, pricing and sales"},{"text":"Volunteer at gallery openings"},{"text":"Learn social media and email marketing"}]},{"type":"h","text":"Year 3: Gallery experience"},{"type":"list","items":[{"text":"Intern at a gallery or art fair"},{"text":"Help run a student exhibition with sales"},{"text":"Learn logistics and insurance of artworks"}]},{"type":"h","text":"Year 4: Prepare to manage"},{"type":"list","items":[{"text":"Run a full exhibition project"},{"text":"Build a contact list of artists and buyers"},{"text":"Apply for gallery assistant roles"}]}]},{"heading":"Essential Skills","kind":"build","blocks":[{"type":"table","header":["Skill","Type"],"rows":[[{"text":"Art sales"},{"text":"Technical"}],[{"text":"Exhibition logistics"},{"text":"Technical"}],[{"text":"Budgeting"},{"text":"Technical"}],[{"text":"Art marketing"},{"text":"Technical"}],[{"text":"Relationship-building"},{"text":"Professional"}],[{"text":"Professional presentation"},{"text":"Professional"}],[{"text":"Negotiation"},{"text":"Professional"}]]}]},{"heading":"Tools and Technologies to Learn","kind":"build","blocks":[{"type":"list","items":[{"text":"Gallery management software (Artlogic and similar)"},{"text":"Excel"},{"text":"Instagram and email marketing"}]}]},{"heading":"Internships and Practical Experience","kind":"internships","blocks":[{"type":"list","items":[{"text":"Galleries"},{"text":"Art fairs"},{"text":"Auction houses"}]}]},{"heading":"Certifications and Additional Training","kind":"certifications","blocks":[{"type":"list","items":[{"text":"Art-business short courses (e.g. Sotheby's Institute online)"}]},{"type":"note","label":"Before you enrol","text":"Check the current syllabus, fees and eligibility on the certifying body's official website."}]},{"heading":"Higher Education Options in India","kind":"pg_india","blocks":[{"type":"p","text":"Options after your degree:"},{"type":"list","items":[{"text":"MBA Arts Management"},{"text":"MA Arts Management"}]},{"type":"p","text":"Entrance exams and tests to know:"},{"type":"list","items":[{"