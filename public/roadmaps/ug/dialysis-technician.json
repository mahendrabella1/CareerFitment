tion"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Hand hygiene"},{"text":"PPE"},{"text":"Aseptic technique"},{"text":"Dialysis-station disinfection"},{"text":"Bloodborne pathogen precautions"},{"text":"Equipment cleaning"},{"text":"Safe waste disposal"}]},{"type":"note","label":"Target outcome","text":"Become capable of supporting dialysis treatment safely under appropriate clinical supervision."}]},{"heading":"Final Year — Advanced Dialysis & Internship","kind":"internships","blocks":[{"type":"h","text":"Clinical exposure"},{"type":"p","text":"Gain experience in:"},{"type":"list","items":[{"text":"Hemodialysis unit"},{"text":"ICU dialysis"},{"text":"Emergency dialysis"},{"text":"Chronic dialysis care"},{"text":"Dialysis access management"},{"text":"Water-treatment plant"},{"text":"Equipment maintenance"},{"text":"Infection-control systems"},{"text":"Peritoneal dialysis awareness"},{"text":"Renal transplant-unit exposure where available"}]},{"type":"h","text":"Clinical workflow"},{"type":"flow","items":["Patient Identification","Pre-Dialysis Assessment","Weight & Vital Signs","Machine & Water-System Checks","Dialyzer / Circuit Preparation","Vascular Access Preparation","Dialysis Treatment","Continuous Monitoring","Treatment Completion","Post-Dialysis Assessment","Documentation & Equipment Disinfection"]}]},{"heading":"Career Process Flow","kind":"other","blocks":[{"type":"flow","items":["10+2 / Equivalent","UG Dialysis Technology Program","Medical + Renal Sciences","Dialysis Machine Technology","Hemodialysis Procedures","Clinical Hospital Training","Dialysis Centre Internship","Dialysis Technician","Senior Dialysis Technician","Lead / Chief Dialysis Technologist","Dialysis Unit / Renal-Care Operations"]}]},{"heading":"Core Skill-Gap Analysis","kind":"other","blocks":[{"type":"table","header":["Skill Area","Beginner","Job-Ready Target"],"rows":[[{"text":"Renal Anatomy"},{"text":"Basic"},{"text":"Strong"}],[{"text":"Renal Physiology"},{"text":"Ba