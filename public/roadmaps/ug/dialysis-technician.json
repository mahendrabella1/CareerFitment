","text":"+"},{"type":"p","text":"Patient Monitoring"},{"type":"p","text":"+"},{"type":"p","text":"Infection Control"},{"type":"p","text":"+"},{"type":"p","text":"Water Treatment"},{"type":"p","text":"+"},{"type":"p","text":"Emergency Dialysis"},{"type":"p","text":"+"},{"type":"p","text":"Equipment Troubleshooting"},{"type":"p","text":"+"},{"type":"p","text":"Digital Dialysis Systems"},{"type":"p","text":"+"},{"type":"p","text":"AI / Data Analytics Awareness"}]},{"heading":"Suggested 4-Year Development Plan","kind":"other","blocks":[{"type":"table","header":["Year","Primary Goal","Key Skills"],"rows":[[{"text":"Year 1"},{"text":"Build medical foundation"},{"text":"Anatomy, physiology, microbiology, renal sciences"}],[{"text":"Year 2"},{"text":"Master dialysis fundamentals"},{"text":"Dialysis principles, machines, circuits, water systems"}],[{"text":"Year 3"},{"text":"Develop clinical competence"},{"text":"Patient monitoring, complications, infection control"}],[{"text":"Year 4"},{"text":"Become job-ready"},{"text":"Clinical internship, ICU exposure, equipment troubleshooting"}],[{"text":"Post-Graduation"},{"text":"Specialize"},{"text":"Critical care, equipment, water quality, QA or management"}]]}]},{"heading":"Graduation Profile","kind":"other","blocks":[{"type":"p","text":"By graduation, the student should demonstrate:"},{"type":"h","text":"Clinical Competence"},{"type":"list","items":[{"text":"Understand renal physiology"},{"text":"Prepare dialysis equipment"},{"text":"Support hemodialysis procedures"},{"text":"Monitor treatment parameters"},{"text":"Record patient observations"},{"text":"Recognize and escalate complications"}]},{"type":"h","text":"Technical Competence"},{"type":"list","items":[{"text":"Operate dialysis machines within training and institutional scope"},{"text":"Understand dialysis circuits"},{"text":"Recognize machine alarms"},{"text":"Perform routine equipment checks"},{"text":"Understand water-treatment systems"}]},{"type":"h","text":"Safety C