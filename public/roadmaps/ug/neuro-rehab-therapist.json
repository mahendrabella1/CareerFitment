alysis"},{"type":"p","text":"+"},{"type":"p","text":"Balance Rehabilitation"},{"type":"p","text":"+"},{"type":"p","text":"Stroke Rehabilitation"},{"type":"p","text":"+"},{"type":"p","text":"Pediatric Rehabilitation"},{"type":"p","text":"+"},{"type":"p","text":"Functional Training"},{"type":"p","text":"+"},{"type":"p","text":"Assistive Technology"},{"type":"p","text":"+"},{"type":"p","text":"Clinical Documentation"},{"type":"p","text":"+"},{"type":"p","text":"Rehabilitation Technology"},{"type":"p","text":"+"},{"type":"p","text":"Evidence-Based Practice"},{"type":"p","text":"+"},{"type":"p","text":"AI & Digital Rehabilitation Awareness"}]},{"heading":"Target Profile by Graduation","kind":"other","blocks":[{"type":"p","text":"A strong graduate should demonstrate:"},{"type":"list","items":[{"text":"Strong anatomy and physiology knowledge"},{"text":"Strong neurological-system fundamentals"},{"text":"Understanding of neuroplasticity and motor learning"},{"text":"Neurological assessment skills"},{"text":"Therapeutic-exercise competency"},{"text":"Gait and balance assessment knowledge"},{"text":"Stroke-rehabilitation exposure"},{"text":"Pediatric rehabilitation exposure"},{"text":"Spinal-rehabilitation awareness"},{"text":"Assistive-device familiarity"},{"text":"Patient and caregiver communication"},{"text":"Multidisciplinary teamwork"},{"text":"Clinical documentation"},{"text":"Evidence-based practice"},{"text":"Rehabilitation technology awareness"}]},{"type":"h","text":"Recommended portfolio"},{"type":"p","text":"Build a Neuro-Rehabilitation Clinical Portfolio containing:"},{"type":"list","items":[{"text":"Neuro-rehabilitation internship record"},{"text":"Stroke rehabilitation case study"},{"text":"Pediatric rehabilitation case study"},{"text":"Gait-analysis project"},{"text":"Balance-assessment project"},{"text":"Neuroplasticity presentation"},{"text":"Rehabilitation outcome-measurement project"},{"text":"Assistive-technology project"},{"text":"Digital/AI rehabilitation