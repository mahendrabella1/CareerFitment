":"Centre of gravity"},{"text":"Metacentric height"},{"text":"Stability"},{"text":"Hydrostatic curves"}]},{"type":"h","text":"Ship structures"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Hull structures"},{"text":"Frames"},{"text":"Beams"},{"text":"Stiffeners"},{"text":"Plates"},{"text":"Bulkheads"},{"text":"Welding"},{"text":"Structural connections"}]},{"type":"h","text":"Marine environment"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Waves"},{"text":"Tides"},{"text":"Currents"},{"text":"Wind"},{"text":"Marine loads"},{"text":"Seawater effects"}]},{"type":"h","text":"Fluid mechanics"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Drag"},{"text":"Lift"},{"text":"Pressure"},{"text":"Flow"},{"text":"Wave mechanics"},{"text":"Hydrodynamic forces"}]},{"type":"h","text":"Year 3 — Offshore Engineering Specialisation"},{"type":"p","text":"Now move from ship structures to offshore structures."},{"type":"h","text":"Offshore structures"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Fixed platforms"},{"text":"Jacket structures"},{"text":"Jack-up structures"},{"text":"Floating platforms"},{"text":"Semi-submersibles"},{"text":"Spar platforms"},{"text":"FPSOs"},{"text":"Offshore wind foundations"},{"text":"Subsea structures"}]},{"type":"h","text":"Offshore loads"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Wave loads"},{"text":"Wind loads"},{"text":"Current loads"},{"text":"Gravity loads"},{"text":"Environmental loads"},{"text":"Seismic loads"},{"text":"Accidental loads"}]},{"type":"h","text":"Structural analysis"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Linear static analysis"},{"text":"Nonlinear analysis"},{"text":"Buckling"},{"text":"Fatigue"},{"text":"Dynamic analysis"},{"text":"Modal analysis"},{"text":"Vibration"}]}]},{"heading":"Finite Element Analysis","kind":"other","blocks":[{"type":"p","text":"FEA is one of the most important technical skills f