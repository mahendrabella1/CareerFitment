:"Dentistry + Technology"}]]}]},{"heading":"Certifications & Additional Learning","kind":"certifications","blocks":[{"type":"h","text":"Useful areas include:"},{"type":"h","text":"BLS"},{"type":"h","text":"Infection control"},{"type":"h","text":"Dental radiography"},{"type":"h","text":"Digital dentistry"},{"type":"h","text":"CAD/CAM"},{"type":"h","text":"Dental photography"},{"type":"h","text":"Practice management"},{"type":"h","text":"Implantology fundamentals"},{"type":"h","text":"Endodontic workshops"},{"type":"h","text":"Restorative dentistry workshops"},{"type":"h","text":"Pediatric dentistry"},{"type":"p","text":"Short courses should supplement, not substitute for recognized professional dental education and scope of practice."}]},{"heading":"PG Options","kind":"pg_india","blocks":[{"type":"p","text":"After BDS, students may pursue postgraduate dental specialization through the applicable current admission framework."},{"type":"h","text":"Common MDS directions include:"},{"type":"h","text":"Prosthodontics"},{"type":"h","text":"Conservative Dentistry & Endodontics"},{"type":"h","text":"Periodontology"},{"type":"h","text":"Oral & Maxillofacial Surgery"},{"type":"h","text":"Orthodontics & Dentofacial Orthopedics"},{"type":"h","text":"Pediatric & Preventive Dentistry"},{"type":"h","text":"Oral Medicine & Radiology"},{"type":"h","text":"Oral Pathology"},{"type":"h","text":"Public Health Dentistry"},{"type":"p","text":"The current entrance/admission requirements should be checked against the official applicable framework."}]},{"heading":"Career Specializations","kind":"other","blocks":[{"type":"h","text":"General Dental Practitioner"},{"type":"p","text":"Broad patient care."},{"type":"h","text":"Restorative Dentist"},{"type":"p","text":"Focus on restoration of damaged teeth."},{"type":"h","text":"Endodontic Specialist"},{"type":"p","text":"Root-canal and pulp-related care."},{"type":"h","text":"Prosthodontic Specialist"},{"type":"p","text":"Replacement and restorati