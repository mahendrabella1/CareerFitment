"},{"text":"Sample two-day eco-tourism itinerary"}]},{"type":"h","text":"Final-year project ideas"},{"type":"list","items":[{"text":"Eco-tourism Potential of a Local Wildlife Landscape"},{"text":"Bird Diversity and Eco-tourism Opportunities in a Wetland"},{"text":"Sustainable Tourism Model for a Forest Region"},{"text":"Community-Based Eco-tourism Development Plan"},{"text":"Visitor Impact Assessment of a Natural Tourism Site"},{"text":"Eco-tourism and Biodiversity Conservation"},{"text":"Interpretation Guide for a National Park"},{"text":"Climate Change and Nature Tourism"}]},{"type":"h","text":"Specialisation options"},{"type":"table","header":["Specialisation","Skills","Potential careers"],"rows":[[{"text":"Wildlife"},{"text":"Species identification, tracking"},{"text":"Wildlife Guide"}],[{"text":"Birding"},{"text":"Ornithology, bird calls"},{"text":"Birding Guide"}],[{"text":"Conservation"},{"text":"Ecology, conservation"},{"text":"Conservation Guide"}],[{"text":"Forests"},{"text":"Forest ecology"},{"text":"Forest Nature Guide"}],[{"text":"Marine"},{"text":"Marine biology"},{"text":"Marine Eco-guide"}],[{"text":"Adventure"},{"text":"Trekking, safety"},{"text":"Nature Adventure Guide"}],[{"text":"Community Tourism"},{"text":"Community engagement"},{"text":"Community Tourism Officer"}],[{"text":"Environmental Education"},{"text":"Teaching, interpretation"},{"text":"Nature Educator"}],[{"text":"Sustainable Tourism"},{"text":"Sustainability, tourism"},{"text":"Sustainable Tourism Executive"}],[{"text":"Digital Eco-tourism"},{"text":"GIS, photography, media"},{"text":"Eco-tourism Content Specialist"}]]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"National parks"},{"text":"Wildlife sanctuaries"},{"text":"Biosphere reserves"},{"text":"Forest departments"},{"text":"Eco-tourism organisations"},{"text":"Nature resorts"},{"text":"Wildlife lodges"},{"text":"Conservation NGOs"},{"text":"Environmenta