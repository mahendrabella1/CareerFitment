":"Eco-tourism Coordinator"},{"text":"Nature Educator"},{"text":"Environmental Interpretation Assistant"}]},{"type":"h","text":"Adjacent roles"},{"type":"list","items":[{"text":"Conservation Project Assistant"},{"text":"Biodiversity Field Assistant"},{"text":"Wildlife Research Assistant"},{"text":"Environmental Education Officer"},{"text":"Sustainable Tourism Executive"},{"text":"Community Tourism Coordinator"},{"text":"Destination Management Executive"},{"text":"Eco-tourism Operations Executive"}]},{"type":"h","text":"Long-term roles"},{"type":"list","items":[{"text":"Senior Eco-tourism Guide"},{"text":"Eco-tourism Programme Manager"},{"text":"Conservation Tourism Manager"},{"text":"Sustainable Tourism Manager"},{"text":"Nature Interpretation Manager"},{"text":"Eco-tourism Operations Head"},{"text":"Eco-tourism Entrepreneur"}]}]},{"heading":"Postgraduate study in India","kind":"pg_india","blocks":[{"type":"table","header":["PG option","Best for"],"rows":[[{"text":"MSc Ecology"},{"text":"Ecology expertise"}],[{"text":"MSc Environmental Science"},{"text":"Environmental careers"}],[{"text":"MSc Wildlife Science"},{"text":"Wildlife specialisation"}],[{"text":"MSc Biodiversity/Conservation"},{"text":"Conservation"}],[{"text":"MA/MSc Tourism Management"},{"text":"Tourism operations"}],[{"text":"MBA Tourism & Hospitality"},{"text":"Tourism management"}],[{"text":"MA Sustainable Development"},{"text":"Sustainability"}],[{"text":"MSc Forestry"},{"text":"Forest ecosystems"}],[{"text":"PG Diploma in Wildlife Management"},{"text":"Field wildlife work"}],[{"text":"PG Diploma in Eco-tourism"},{"text":"Eco-tourism specialisation"}]]},{"type":"h","text":"Recommended route"},{"type":"p","text":"For a field-oriented career:"},{"type":"flow","items":["BA Environmental Studies/Ecology","Wildlife/Ecology/Eco-tourism specialisation","Field internship","Eco-tourism/Nature Guide"]},{"type":"p","text":"For management:"},{"type":"flow","items":["BA","Master's in Tourism/Sustainable Tourism/