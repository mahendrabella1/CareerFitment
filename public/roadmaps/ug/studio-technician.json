":"Wi-Fi"},{"text":"Network storage"},{"text":"NAS"},{"text":"File sharing"},{"text":"Basic network troubleshooting"}]},{"type":"p","text":"For audio/video:"},{"type":"list","items":[{"text":"Dante concepts"},{"text":"NDI"},{"text":"AES67 concepts"}]},{"type":"p","text":"You do not need to become a network engineer, but should understand how studio devices communicate."}]},{"heading":"Equipment Maintenance","kind":"other","blocks":[{"type":"p","text":"Learn preventive maintenance for:"},{"type":"h","text":"Cameras"},{"type":"list","items":[{"text":"Sensor care"},{"text":"Lens cleaning"},{"text":"Battery maintenance"},{"text":"Firmware"},{"text":"Storage media"}]},{"type":"h","text":"Audio"},{"type":"list","items":[{"text":"Cable testing"},{"text":"Connector inspection"},{"text":"Microphone maintenance"},{"text":"Interface troubleshooting"}]},{"type":"h","text":"Lighting"},{"type":"list","items":[{"text":"Lamp/LED inspection"},{"text":"Cooling"},{"text":"Power cables"},{"text":"Stands and mounts"}]},{"type":"h","text":"Studio"},{"type":"list","items":[{"text":"Power management"},{"text":"Equipment labeling"},{"text":"Inventory"},{"text":"Backup systems"}]},{"type":"p","text":"Maintain equipment logs with:"},{"type":"list","items":[{"text":"Asset ID"},{"text":"Equipment name"},{"text":"Serial number"},{"text":"Purchase date"},{"text":"Condition"},{"text":"Service history"},{"text":"Fault history"}]}]},{"heading":"Technical Troubleshooting","kind":"other","blocks":[{"type":"p","text":"Develop a structured troubleshooting process:"},{"type":"flow","items":["Identify symptom","Check power","Check connections","Check signal path","Isolate component","Test known-good equipment","Fix/replace","Verify","Document"]},{"type":"p","text":"Common problems:"},{"type":"list","items":[{"text":"No audio"},{"text":"Hum/buzz"},{"text":"Distortion"},{"text":"Clipping"},{"text":"Noise"},{"text":"Microphone failure"},{"text":"Camera not detected"},{"text":"No video signal"},{"text":"HDMI/