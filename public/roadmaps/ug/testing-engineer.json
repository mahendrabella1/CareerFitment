":"Programming"},{"text":"Systems"}]},{"type":"h","text":"M.Sc Computer Science"},{"type":"p","text":"Useful for deeper CS knowledge."},{"type":"h","text":"M.Tech Software Engineering"},{"type":"p","text":"Useful for advanced software engineering pathways where eligibility permits."},{"type":"h","text":"MBA"},{"type":"p","text":"Useful later for:"},{"type":"list","items":[{"text":"QA management"},{"text":"Product management"},{"text":"Engineering management"}]},{"type":"p","text":"For a testing career, however:"},{"type":"flow","items":["BCA","strong automation","experience"],"sep":"+"},{"type":"p","text":"can often be more career-efficient than immediately pursuing another general degree."}]},{"heading":"Study abroad","kind":"abroad","blocks":[{"type":"p","text":"Relevant master's programmes include:"},{"type":"list","items":[{"text":"Software Engineering"},{"text":"Computer Science"},{"text":"Information Technology"},{"text":"Software Quality Engineering"},{"text":"Cybersecurity"},{"text":"Data/AI"},{"text":"DevOps/Cloud Computing"}]},{"type":"p","text":"A student interested in test automation can also transition toward:"},{"type":"h","text":"SDET → Software Engineer"},{"type":"p","text":"because strong automation engineers increasingly write production-quality code."}]},{"heading":"Career specialisations","kind":"other","blocks":[{"type":"p","text":"After 2–4 years, choose a direction."},{"type":"h","text":"Automation Engineer"},{"type":"flow","items":["Selenium/Playwright","Java/Python/TypeScript","frameworks"],"sep":"+"},{"type":"h","text":"SDET"},{"type":"flow","items":["Testing","software engineering","CI/CD"],"sep":"+"},{"type":"h","text":"Performance Engineer"},{"type":"flow","items":["JMeter/k6","distributed systems","observability"],"sep":"+"},{"type":"h","text":"API Test Engineer"},{"type":"flow","items":["REST","SQL","automation","microservices"],"sep":"+"},{"type":"h","text":"Mobile QA"},{"type":"flow","items":["Android/iOS","Appium","mobile testing"],