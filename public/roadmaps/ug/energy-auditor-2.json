:"Year 3 — Energy Auditing & Renewable Energy","kind":"other","blocks":[{"type":"p","text":"This is the critical transition toward the target career."},{"type":"h","text":"Energy Auditing"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Preliminary energy audit"},{"text":"Detailed energy audit"},{"text":"Energy balance"},{"text":"Energy baseline"},{"text":"Energy performance indicators"},{"text":"Energy conservation measures"},{"text":"Measurement and verification"}]},{"type":"h","text":"Audit Process"},{"type":"flow","items":["Data Collection","Energy Consumption Analysis","Site Survey","Measurements","Energy Balance","Identify Losses","Energy Conservation Measures","Savings Calculation","Investment Analysis","Implementation Plan"]}]},{"heading":"Year 4 — Advanced Energy Analytics & Industry Application","kind":"other","blocks":[{"type":"p","text":"Focus on turning engineering observations into financially viable recommendations."},{"type":"h","text":"Learn"},{"type":"list","items":[{"text":"Energy modeling"},{"text":"Energy benchmarking"},{"text":"Life-cycle costing"},{"text":"Payback period"},{"text":"NPV"},{"text":"IRR"},{"text":"ROI"},{"text":"Carbon reduction calculations"},{"text":"Measurement & verification"},{"text":"Energy management systems"}]},{"type":"h","text":"Energy Management"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"ISO 50001"},{"text":"Energy performance indicators"},{"text":"Energy management systems"},{"text":"Energy policy"},{"text":"Continuous improvement"}]}]},{"heading":"Energy Audit Areas","kind":"other","blocks":[{"type":"p","text":"A capable energy auditor should understand multiple systems."},{"type":"table","header":["System","What to Evaluate"],"rows":[[{"text":"Motors"},{"text":"Efficiency, loading, VFD opportunities"}],[{"text":"Pumps"},{"text":"Head, flow, efficiency"}],[{"text":"Compressors"},{"text":"Pressure, leakage, loading"}],[{"text":"Boilers"},{"text":"Efficiency, excess air, heat loss"}]