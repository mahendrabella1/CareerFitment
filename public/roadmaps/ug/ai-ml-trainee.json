ce LLMs"},{"text":"Cloud AI APIs"}]},{"type":"p","text":"The priority should remain understanding the underlying concepts, rather than simply calling an API."}]},{"heading":"Year 4 — Deployment & MLOps","kind":"other","blocks":[{"type":"p","text":"A model sitting inside a notebook is not a production AI system."},{"type":"p","text":"Learn:"},{"type":"h","text":"APIs"},{"type":"list","items":[{"text":"FastAPI"},{"text":"REST"},{"text":"JSON"},{"text":"Authentication"}]},{"type":"h","text":"Containers"},{"type":"list","items":[{"text":"Docker"},{"text":"Docker Compose"}]},{"type":"h","text":"Cloud"},{"type":"p","text":"Learn one major cloud platform:"},{"type":"list","items":[{"text":"AWS"},{"text":"Azure"},{"text":"Google Cloud"}]},{"type":"h","text":"MLOps fundamentals"},{"type":"list","items":[{"text":"Model versioning"},{"text":"Data versioning"},{"text":"Experiment tracking"},{"text":"Model registry"},{"text":"CI/CD"},{"text":"Monitoring"},{"text":"Logging"},{"text":"Model drift"}]},{"type":"p","text":"Useful tools include:"},{"type":"list","items":[{"text":"MLflow"},{"text":"GitHub Actions"},{"text":"Docker"},{"text":"Kubernetes fundamentals"}]}]},{"heading":"AI/ML Portfolio Projects","kind":"other","blocks":[{"type":"p","text":"Build 4–6 serious projects."},{"type":"h","text":"Project 1 — Classical ML"},{"type":"h","text":"Customer Churn Prediction"},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Data cleaning"},{"text":"Feature engineering"},{"text":"Model comparison"},{"text":"Evaluation"},{"text":"Explainability"}]},{"type":"h","text":"Project 2 — Computer Vision"},{"type":"h","text":"Image Classification System"},{"type":"p","text":"Use:"},{"type":"list","items":[{"text":"CNN"},{"text":"Transfer learning"},{"text":"OpenCV"},{"text":"PyTorch/TensorFlow"}]},{"type":"h","text":"Project 3 — NLP"},{"type":"h","text":"Text Classification / Sentiment Analysis"},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Text preprocessing"},{"