,[{"text":"Analytics"},{"text":"Excel, Power BI, SQL"}],[{"text":"Sales"},{"text":"Consultative selling and negotiation"}]]},{"type":"p","text":"Certification requirements can change, particularly for regulated financial activities, so students should verify current eligibility and examination requirements before enrolling."},{"type":"flow","items":["financial-product knowledge","communication","sales performance","compliance awareness > collecting certificates."],"sep":"+","label":"Priority"}]},{"heading":"Careers you can be hired as","kind":"careers","blocks":[{"type":"h","text":"Direct roles"},{"type":"list","items":[{"text":"Relationship Executive"},{"text":"Relationship Officer"},{"text":"Banking Executive"},{"text":"Customer Relationship Executive"},{"text":"Sales Executive – Banking"},{"text":"Insurance Relationship Executive"},{"text":"Bancassurance Executive"},{"text":"Financial Services Executive"},{"text":"Customer Service Officer"},{"text":"Branch Operations Executive"}]},{"type":"h","text":"After experience"},{"type":"list","items":[{"text":"Relationship Manager"},{"text":"Senior Relationship Manager"},{"text":"Priority Relationship Manager"},{"text":"Wealth Relationship Manager"},{"text":"Corporate Relationship Manager"},{"text":"Credit Relationship Manager"},{"text":"Insurance Sales Manager"},{"text":"Bancassurance Manager"}]},{"type":"h","text":"Long-term"},{"type":"list","items":[{"text":"Branch Manager"},{"text":"Wealth Manager"},{"text":"Corporate Banking Manager"},{"text":"Regional Sales Manager"},{"text":"Area Business Manager"},{"text":"Cluster Head"},{"text":"Regional Head"},{"text":"Business Head"},{"text":"Head of Wealth Management"},{"text":"Head of Retail Banking"}]}]},{"heading":"Postgraduate study in India","kind":"pg_india","blocks":[{"type":"table","header":["PG route","Best for"],"rows":[[{"text":"MBA Finance"},{"text":"Banking, finance and relationship management"}],[{"text":"MBA Banking & Financial Services"},{"text":"Banking leadership"}],[{"text":"MBA Insurance"},{"text":"Insurance management"}],[{"text":"MBA Marketing"},{"text":"Financial-services sales"}],[{"text":"MBA Business Analytics"},{"text":"Data-driven banking"}],[{"text":"M.Com Finance/Banking"},{"text":"Academic + finance pathway"}],[{"text":"PGDM Banking & Finance"},{"text":"Industry-focused banking career"}],[{"text":"MBA Wealth Management"},{"text":"Wealth/private banking"}]]},{"type":"h","text":"Recommended route"},{"type":"p","text":"For mainstream banking:"},{"type":"flow","items":["BBA Banking & Insurance","Relationship Executive","Relationship Manager","Branch Manager","Regional/Business Head"]},{"type":"p","text":"For wealth:"},{"type":"flow","items":["BBA","Relationship Executive","Wealth RM","Senior Wealth Manager","Private Banking/Wealth Head"]},{"type":"p","text":"For corporate banking:"},{"type":"flow","items":["BBA","Banking/RM role","Credit experience","Corporate RM","Corporate Banking Manager"]}]},{"heading":"Study abroad","kind":"abroad","blocks":[{"type":"table","header":["Country","Useful master's areas"],"rows":[[{"text":"🇬🇧 UK"},{"text":"Banking & Finance, Finance, Financial Services"}],[{"text":"🇺🇸 USA"},{"text":"Finance, Financial Management, Business Analytics"}],[{"text":"🇨🇦 Canada"},{"text":"Finance, Financial Services, Business Analytics"}],[{"text":"🇦🇺 Australia"},{"text":"Banking & Finance, Financial Planning"}],[{"text":"🇸🇬 Singapore"},{"text":"Finance, Banking, FinTech"}],[{"text":"🇮🇪 Ireland"},{"text":"Finance, FinTech, Financial Services"}],[{"text":"🇩🇪 Germany"},{"text":"Finance, Financial Economics, FinTech"}],[{"text":"🇳🇱 Netherlands"},{"text":"Finance, Financial Economics, Business Analytics"}]]},{"type":"p","text":"For international careers, add financial analysis, FinTech, data analytics, risk management and regulatory knowledge rather than relying only on relationship-management skills."}]},{"heading":"Career progression","kind":"growth","blocks":[{"type":"h","text":"Retail banking pathway"},{"type":"flow","items":["Relationship Executive","Relationship Officer","Relationship Manager","Senior Relationship Manager","Branch Manager","Cluster/Area Manager","Regional Head","Retail Banking Head"]},{"type":"h","text":"Wealth management pathway"},{"type":"flow","items":["Relationship Executive","Wealth Executive","Wealth Relationship Manager","Senior Wealth Manager","Private Banker","Wealth Management Head"]},{"type":"h","text":"Corporate banking pathway"},{"type":"flow","items":["Relationship Executive","Corporate Banking Executive","Corporate Relationship Manager","Senior Corporate RM","Corporate Banking Manager","Regional Corporate Banking Head"]},{"type":"h","text":"Insurance pathway"},{"type":"flow","items":["Insurance Relationship Executive","Insurance Relationship Manager","Senior Manager","Branch/Regional Sales Manager","Regional Business Head"]},{"type":"note","label":"Emerging specialisations","text":"2030–2040"},{"type":"h","text":"1. Digital Relationship Management"},{"type":"p","text":"Customers increasingly interact through:"},{"type":"list","items":[{"text":"Mobile banking"},{"text":"Video banking"},{"text":"Chat"},{"text":"AI assistants"},{"text":"Digital onboarding"},{"text":"Remote advisory"}]},{"type":"p","text":"Relationship professionals will manage customers across digital + human channels."},{"type":"h","text":"2. AI-Powered Relationship Management"},{"type":"p","text":"AI can help identify:"},{"type":"list","items":[{"text":"Customer needs"},{"text":"Churn risk"},{"text":"Cross-selling opportunities"},{"text":"Product suitability signals"},{"text":"Spending patterns"},{"text":"Renewal opportunities"}]},{"type":"p","text":"The human relationship professional remains responsible for trust, explanation, judgement and customer interaction."},{"type":"h","text":"3. Wealth Technology"},{"type":"p","text":"Combines:"},{"type":"flow","items":["Relationship management","investments","analytics","AI"],"sep":"+"},{"type":"p","text":"This is particularly valuable for high-net-worth and affluent customer segments."},{"type":"h","text":"4. Bancassurance Analytics"},{"type":"p","text":"Banking customer data can help identify relevant insurance needs, subject to suitability, privacy and regulatory requirements."},{"type":"h","text":"5. Financial Inclusion"},{"type":"p","text":"Growing opportunities exist around:"},{"type":"list","items":[{"text":"Digital lending"},{"text":"Microfinance"},{"text":"Rural banking"},{"text":"MSME finance"},{"text":"Digital payments"},{"text":"Financial literacy"},{"text":"Inclusive insurance"}]},{"type":"note","label":"2040–2046","text":"How the role evolves"},{"type":"p","text":"The traditional Relationship Executive will face increasing automation in:"},{"type":"list","items":[{"text":"Basic account servicing"},{"text":"Routine customer queries"},{"text":"Lead scoring"},{"text":"Product recommendations"},{"text":"Appointment scheduling"},{"text":"Customer segmentation"},{"text":"Follow-up reminders"}]},{"type":"p","text":"Human value will increasingly come from:"},{"type":"list","items":[{"text":"Complex financial needs"},{"text":"High-value relationships"},{"text":"Trust building"},{"text":"Negotiation"},{"text":"Financial education"},{"text":"Wealth conversations"},{"text":"Business relationships"},{"text":"Complaint resolution"},{"text":"Ethical judgement"},{"text":"Regulatory responsibility"}]},{"type":"p","text":"The career therefore evolves from:"},{"type":"h","text":"\"Sell financial products.\""},{"type":"p","text":"toward:"},{"type":"p","text":"\"Understand the customer's financial situation and build a trusted, compliant long-term relationship.\""},{"type":"h","text":"Recommended final skill stack"},{"type":"h","text":"Banking"},{"type":"list","items":[{"text":"Retail banking"},{"text":"Loans"},{"text":"Deposits"},{"text":"Credit cards"},{"text":"Digital banking"},{"text":"Branch operations"}]},{"type":"h","text":"Insurance"},{"type":"list","items":[{"text":"Life insurance"},{"text":"General insurance"},{"text":"Health insurance"},{"text":"Underwriting basics"},{"text":"Claims"},{"text":"Renewals"}]},{"type":"h","text":"Finance"},{"type":"list","items":[{"text":"Financial statements"},{"text":"Financial markets"},{"text":"Mutual funds"},{"text":"Investments"},{"text":"Credit analysis"},{"text":"Financial planning"}]},{"type":"h","text":"Relationship management"},{"type":"list","items":[{"text":"Communication"},{"text":"Consultative selling"},{"text":"Negotiation"},{"text":"Customer retention"},{"text":"Cross-selling"},{"text":"Complaint management"},{"text":"CRM"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Advanced Excel"},{"text":"CRM"},{"text":"Power BI"},{"text":"SQL basics"},{"text":"Digital banking platforms"},{"text":"AI-assisted CRM"}]},{"type":"h","text":"Compliance"},{"type":"list","items":[{"text":"KYC"},{"text":"AML"},{"text":"Customer suitability"},{"text":"Data privacy"},{"text":"Financial-services regulations"},{"text":"Ethical sales"}]},{"type":"h","text":"Target progression"},{"type":"flow","items":["Banking","Insurance","Finance Fundamentals"],"sep":"+","label":"Year 1"},{"type":"flow","items":["CRM","Sales","Financial Products","Excel"],"sep":"+","label":"Year 2"},{"type":"flow","items":["Credit","Investments","Wealth","Analytics"],"sep":"+","label":"Year 3"},{"type":"note","label":"Final Year","text":"Banking/Insurance Internship + Customer Analytics Project"},{"type":"note","label":"0–2 years","text":"Relationship Executive / Banking Executive"},{"type":"note","label":"3–5 years","text":"Relationship Manager / Senior RM"},{"type":"note","label":"5–8 years","text":"Branch Manager / Wealth Manager / Corporate RM"},{"type":"note","label":"8–15 years","text":"Regional Head / Business Head / Banking Leadership"},{"type":"h","text":"Best employability combination"},{"type":"flow","items":["BBA Banking & Insurance","strong communication","financial-product knowledge","sales","CRM","Excel/Power BI","credit fundamentals","compliance awareness","internship."],"sep":"+"},{"type":"note","label":"Key principle","text":"A high-performing Relationship Executive should not be merely a salesperson. The strongest professionals understand customer needs, recommend appropriate financial products, maintain regulatory discipline, use data to identify opportunities, and build relationships that generate long-term customer value."}]}]}