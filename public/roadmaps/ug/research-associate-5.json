"text":"RNA-seq"},{"text":"Differential expression"}]},{"type":"h","text":"Research methodology"},{"type":"p","text":"Expect questions about:"},{"type":"list","items":[{"text":"Hypothesis formulation"},{"text":"Experimental controls"},{"text":"Biological vs technical replicates"},{"text":"Statistical testing"},{"text":"Bias"},{"text":"Reproducibility"}]}]},{"heading":"Postgraduate study in India","kind":"pg_india","blocks":[{"type":"p","text":"For a sustained research career, postgraduate study is strongly recommended."},{"type":"h","text":"M.Sc Biotechnology"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Molecular biology"},{"text":"Genetic engineering"},{"text":"Biotechnology"},{"text":"R&D"}]},{"type":"h","text":"M.Sc Molecular Biology"},{"type":"p","text":"Strong for:"},{"type":"list","items":[{"text":"Molecular research"},{"text":"Cell biology"},{"text":"Disease biology"}]},{"type":"h","text":"M.Sc Genomics / Genetics"},{"type":"p","text":"Strong for:"},{"type":"list","items":[{"text":"Genomic research"},{"text":"Genomic medicine"},{"text":"Bioinformatics"}]},{"type":"h","text":"M.Sc Bioinformatics"},{"type":"p","text":"Excellent for:"},{"type":"list","items":[{"text":"Computational biology"},{"text":"NGS"},{"text":"Genomics"},{"text":"Data analysis"}]},{"type":"h","text":"M.Sc Biochemistry"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Protein research"},{"text":"Molecular biology"},{"text":"Drug discovery"}]},{"type":"h","text":"M.Sc Microbiology"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Microbial genomics"},{"text":"Pathogen research"},{"text":"Biotechnology"}]}]},{"heading":"Study abroad","kind":"abroad","blocks":[{"type":"p","text":"Relevant master's programmes include:"},{"type":"list","items":[{"text":"Molecular Biology"},{"text":"Biotechnology"},{"text":"Genomics"},{"text":"Bioinformatics"},{"text":"Biomedical Sciences"},{"text":"Molecular Medicine"},{"text":"Computational Biology"},