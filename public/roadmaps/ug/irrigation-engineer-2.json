ater depletion"},{"text":"Agricultural adaptation"}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"h","text":"Core Engineering"},{"type":"flow","items":["Fluid Mechanics","Hydraulics","Hydrology","Irrigation","Hydraulic Structures","Groundwater"],"sep":"+"},{"type":"h","text":"Design"},{"type":"flow","items":["AutoCAD","Civil 3D","Canal Design","Hydraulic Structure Design"],"sep":"+"},{"type":"h","text":"Modelling"},{"type":"flow","items":["HEC-RAS","HEC-HMS","EPANET","MATLAB"],"sep":"+"},{"type":"h","text":"GIS & Remote Sensing"},{"type":"flow","items":["QGIS","ArcGIS","Google Earth Engine","Satellite Data"],"sep":"+"},{"type":"h","text":"Programming & Analytics"},{"type":"flow","items":["Python","NumPy","pandas","SciPy","Statistics","Power BI"],"sep":"+"},{"type":"h","text":"Modern Water Engineering"},{"type":"flow","items":["IoT","Smart Irrigation","AI/ML","Digital Twins","Climate-Resilient Water Management"],"sep":"+"},{"type":"h","text":"Professional"},{"type":"flow","items":["Project Management","Technical Documentation","Cost Estimation","Environmental Compliance","Stakeholder Coordination"],"sep":"+"}]},{"heading":"Target Profile by Graduation","kind":"other","blocks":[{"type":"p","text":"By the end of B.Tech, the student should be able to:"},{"type":"list","items":[{"text":"Perform hydrological calculations"},{"text":"Design basic irrigation systems"},{"text":"Analyse open-channel flow"},{"text":"Design preliminary canal sections"},{"text":"Understand hydraulic structures"},{"text":"Perform watershed analysis"},{"text":"Use HEC-RAS and HEC-HMS"},{"text":"Build GIS-based water-resource maps"},{"text":"Analyse satellite data"},{"text":"Use AutoCAD/Civil 3D"},{"text":"Perform water-demand calculations"},{"text":"Build irrigation dashboards"},{"text":"Apply Python to water-resource datasets"},{"text":"Understand groundwater systems"},{"text":"Develop a smart-irrigation prototype"},{"text":"Present engineering reports profession