":"LOTO"},{"text":"Confined spaces"},{"text":"Working at height"}]},{"type":"h","text":"Incident investigation"},{"type":"p","text":"Understand:"},{"type":"flow","items":["Incident","Evidence","Immediate Cause","Root Cause","Corrective Action","Preventive Action","Verification"]},{"type":"h","text":"Interview questions"},{"type":"p","text":"Prepare for:"},{"type":"list","items":[{"text":"What is the difference between a hazard and a risk?"},{"text":"Explain HIRA."},{"text":"What is the hierarchy of controls?"},{"text":"How would you investigate an accident?"},{"text":"What is a near miss?"},{"text":"Why is PPE considered the last line of defence?"},{"text":"Explain ISO 45001."},{"text":"Explain ISO 14001."},{"text":"How would you handle a chemical spill?"},{"text":"How would you improve safety compliance among workers?"}]}]},{"heading":"Postgraduate Study in India","kind":"pg_india","blocks":[{"type":"p","text":"Possible postgraduate directions:"},{"type":"h","text":"Environmental"},{"type":"list","items":[{"text":"M.Sc. Environmental Science"},{"text":"M.Sc. Environmental Management"},{"text":"M.Sc. Environmental Technology"},{"text":"M.Tech Environmental Engineering"}]},{"type":"h","text":"Safety"},{"type":"list","items":[{"text":"Industrial Safety"},{"text":"Occupational Health & Safety"},{"text":"Safety Management"},{"text":"Fire & Safety Management"}]},{"type":"h","text":"Management"},{"type":"p","text":"Later-career options:"},{"type":"list","items":[{"text":"MBA Operations"},{"text":"MBA Sustainability"},{"text":"MBA Environmental Management"},{"text":"General Management"}]},{"type":"p","text":"For a B.Sc. graduate, check the exact eligibility of each programme because engineering and science postgraduate programmes can have different entry requirements."}]},{"heading":"Government / Regulatory Route","kind":"other","blocks":[{"type":"p","text":"Potential areas include:"},{"type":"list","items":[{"text":"Environmental regulation"},{"text":"Pollution control"},{"text":"Occupational safety"},{"text":"Government industrial safety"},{"text":"Environmental monitoring"},{"text":"Public-sector manufacturing"},{"text":"Municipal/environmental management"},{"text":"Research"}]},{"type":"p","text":"Monitor opportunities involving:"},{"type":"list","items":[{"text":"State Pollution Control Boards"},{"text":"Central environmental organisations"},{"text":"Government laboratories"},{"text":"Public-sector enterprises"},{"text":"Research institutions"},{"text":"State government departments"}]},{"type":"p","text":"Exact eligibility varies by recruitment notification."}]},{"heading":"Environmental Compliance Route","kind":"other","blocks":[{"type":"p","text":"An EHS professional can develop into an environmental compliance specialist."},{"type":"h","text":"Build expertise in:"},{"type":"list","items":[{"text":"Environmental permits"},{"text":"Consent requirements"},{"text":"Waste records"},{"text":"Emission monitoring"},{"text":"Effluent monitoring"},{"text":"Environmental audits"},{"text":"Compliance reporting"},{"text":"Environmental management systems"}]},{"type":"p","text":"Learn to maintain a legal and compliance register for the facility."},{"type":"p","text":"The critical skill is not memorising laws; it is being able to determine:"},{"type":"flow","items":["Requirement","Applicability","Evidence","Compliance Status","Corrective Action"]}]},{"heading":"Study Abroad","kind":"abroad","blocks":[{"type":"p","text":"Relevant master's programmes:"},{"type":"list","items":[{"text":"Environmental Management"},{"text":"Environmental Science"},{"text":"Occupational Health & Safety"},{"text":"Environmental Health"},{"text":"Industrial Safety"},{"text":"Sustainability"},{"text":"Environmental Engineering"},{"text":"Risk Management"}]},{"type":"h","text":"Potential destinations"},{"type":"table","header":["Country","Relevant Strength"],"rows":[[{"text":"UK"},{"text":"HSE, environmental management, occupational safety"}],[{"text":"Australia"},{"