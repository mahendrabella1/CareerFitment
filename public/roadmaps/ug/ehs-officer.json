s":[{"text":"Production"},{"text":"Material handling"},{"text":"Storage"},{"text":"Maintenance"},{"text":"Utilities"},{"text":"Waste management"}]},{"type":"h","text":"Step 2 — Identify hazards"},{"type":"p","text":"Examples:"},{"type":"list","items":[{"text":"Chemical"},{"text":"Electrical"},{"text":"Mechanical"},{"text":"Fire"},{"text":"Noise"},{"text":"Ergonomic"},{"text":"Biological"},{"text":"Environmental"}]},{"type":"h","text":"Step 3 — Risk assessment"},{"type":"p","text":"Create a matrix containing:"},{"type":"flow","items":["Hazard","Likelihood","Severity","Risk Rating","Existing Controls","Additional Controls"]},{"type":"h","text":"Step 4 — Recommend controls"},{"type":"p","text":"Use the hierarchy:"},{"type":"flow","items":["Elimination","Substitution","Engineering Controls","Administrative Controls","PPE"]},{"type":"h","text":"Step 5 — Final report"},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Site observations"},{"text":"Risk register"},{"text":"Corrective actions"},{"text":"Priority ranking"},{"text":"Emergency recommendations"},{"text":"Environmental observations"}]},{"type":"p","text":"This is a strong portfolio project for an EHS interview."}]},{"heading":"Certifications & Learning","kind":"certifications","blocks":[{"type":"p","text":"Certifications can materially strengthen an entry-level EHS profile."},{"type":"h","text":"Management systems"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"ISO 14001 — Environmental Management Systems"},{"text":"ISO 45001 — Occupational Health & Safety Management Systems"}]},{"type":"h","text":"Safety"},{"type":"p","text":"Develop knowledge of:"},{"type":"list","items":[{"text":"HIRA"},{"text":"JSA/JHA"},{"text":"Incident investigation"},{"text":"Fire safety"},{"text":"First aid"},{"text":"Emergency response"},{"text":"Permit-to-work"},{"text":"LOTO"},{"text":"Confined-space safety"},{"text":"Work-at-height safety"}]},{"type":"h","text":"Professional certifications"},{"type":"p",