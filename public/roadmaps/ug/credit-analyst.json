{"text":"SQL"},{"text":"Advanced Excel"},{"text":"Financial modelling"},{"text":"Basic Python"}]},{"type":"p","text":"Build a structured credit memo:"},{"type":"flow","items":["Company","Industry","Financials","Risks","Repayment Capacity","Security","Credit Recommendation"]},{"type":"h","text":"Final year — Credit portfolio projects"},{"type":"h","text":"Project 1 — Corporate Credit Assessment"},{"type":"p","text":"Choose a listed company and analyse:"},{"type":"list","items":[{"text":"Revenue"},{"text":"EBITDA"},{"text":"Net profit"},{"text":"Debt"},{"text":"Cash flow"},{"text":"Working capital"},{"text":"Interest coverage"},{"text":"Debt-equity"},{"text":"DSCR"},{"text":"Liquidity"}]},{"type":"p","text":"Conclude:"},{"type":"h","text":"Approve / Reject / Approve with Conditions"},{"type":"p","text":"and explain why."},{"type":"h","text":"Project 2 — SME Credit Scoring Model"},{"type":"p","text":"Create a dataset containing:"},{"type":"list","items":[{"text":"Revenue"},{"text":"Profit"},{"text":"Existing debt"},{"text":"Cash flow"},{"text":"Credit history"},{"text":"Debt service"},{"text":"Business age"},{"text":"Industry"},{"text":"Collateral"}]},{"type":"p","text":"Build a basic credit-score model using:"},{"type":"flow","items":["Excel","SQL","Python"]},{"type":"p","text":"Keep it as an educational model rather than presenting it as a production lending decision system."},{"type":"h","text":"Project 3 — Credit Risk Dashboard"},{"type":"p","text":"Use Power BI to track:"},{"type":"list","items":[{"text":"Loan portfolio"},{"text":"Approval rate"},{"text":"Default rate"},{"text":"Delinquency"},{"text":"NPA/non-performing exposure"},{"text":"Risk categories"},{"text":"Sector concentration"},{"text":"Borrower concentration"},{"text":"Outstanding exposure"},{"text":"Recovery rate"}]},{"type":"p","text":"This gives you a strong combination of finance + analytics."},{"type":"h","text":"Specialisation options"},{"type":"table","header":["Specialisation","Key skills"],"ro