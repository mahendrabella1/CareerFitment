,{"text":"Research"},{"text":"Field reporting"},{"text":"Sports desk"}]},{"type":"h","text":"Digital Sports Platforms"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Sports content"},{"text":"Social media"},{"text":"Data journalism"},{"text":"Video"}]},{"type":"h","text":"Sports Organisations"},{"type":"p","text":"Intern with:"},{"type":"list","items":[{"text":"Sports federations"},{"text":"Leagues"},{"text":"Clubs"},{"text":"Academies"},{"text":"University sports departments"}]},{"type":"p","text":"This provides an alternative perspective from the sports-industry side."}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"type":"p","text":"Possible starting positions include:"},{"type":"list","items":[{"text":"Sports Reporter"},{"text":"Sports Writer"},{"text":"Junior Sports Journalist"},{"text":"Digital Sports Journalist"},{"text":"Sports Content Writer"},{"text":"Sports Researcher"},{"text":"Sports Desk Assistant"},{"text":"Sports Correspondent — Junior"},{"text":"Sports Social Media Executive"},{"text":"Sports Video Journalist"},{"text":"Sports Podcast Producer"},{"text":"Sports Data Journalist"},{"text":"Sports Content Producer"},{"text":"Editorial Assistant"}]},{"type":"h","text":"Specialisation Options"},{"type":"h","text":"1. Cricket Journalism"},{"type":"p","text":"Particularly relevant in India."},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Match reporting"},{"text":"Player analysis"},{"text":"Statistics"},{"text":"Interviews"},{"text":"Domestic cricket"},{"text":"International cricket"}]},{"type":"h","text":"2. Football Journalism"},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"Tactical analysis"},{"text":"Player statistics"},{"text":"League coverage"},{"text":"Transfer reporting"},{"text":"Club analysis"}]},{"type":"h","text":"3. Sports Data Journalism"},{"type":"p","text":"Combine:"},{"type":"flow","items":["Sports","Statistics","Programming","Journalism"],"sep":"+"},{"type":"p","text":"Work with:"},{"type":"list","items":[{"text":"Performance data"},{"text":"Player metrics"},{"text":"Match statistics"},{"text":"Visualisation"}]},{"type":"p","text":"This is one of the strongest future-oriented specialisations."},{"type":"h","text":"4. Sports Business Journalism"},{"type":"p","text":"Cover:"},{"type":"list","items":[{"text":"Sponsorship"},{"text":"Broadcasting"},{"text":"Sports marketing"},{"text":"Athlete contracts"},{"text":"League economics"},{"text":"Sports startups"},{"text":"Franchise business"}]},{"type":"p","text":"Requires additional business and finance knowledge."},{"type":"h","text":"5. Investigative Sports Journalism"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Governance"},{"text":"Doping"},{"text":"Corruption"},{"text":"Sports administration"},{"text":"Funding"},{"text":"Athlete welfare"}]},{"type":"p","text":"Requires exceptional verification and ethical reporting."},{"type":"h","text":"6. Sports Broadcasting"},{"type":"p","text":"Combine:"},{"type":"flow","items":["Sports Knowledge","Journalism","Presentation","Video"],"sep":"+"},{"type":"p","text":"Potential roles:"},{"type":"list","items":[{"text":"Sports Presenter"},{"text":"Sports Anchor"},{"text":"Field Reporter"},{"text":"Match Analyst"}]},{"type":"h","text":"Employer Skill Matrix"},{"type":"table","header":["Employer Type","Key Skills"],"rows":[[{"text":"Newspapers"},{"text":"Reporting + writing"}],[{"text":"Sports Websites"},{"text":"Digital journalism + SEO"}],[{"text":"TV Networks"},{"text":"Reporting + video + presentation"}],[{"text":"Radio"},{"text":"Audio + communication"}],[{"text":"Sports Streaming Platforms"},{"text":"Video + digital journalism"}],[{"text":"Sports Leagues"},{"text":"Content + communications"}],[{"text":"Sports Clubs"},{"text":"Media + communications"}],[{"text":"Sports Federations"},{"text":"Reporting + sports administration"}],[{"text":"News Agencies"},{"text":"Fast reporting + verification"}],[{"text":"Magazines"},{"t