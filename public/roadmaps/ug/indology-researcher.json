ect Assistant"},{"text":"Manuscript Documentation Assistant"},{"text":"Archive Assistant"},{"text":"Museum Research Assistant"},{"text":"Cultural Research Assistant"},{"text":"Digital Humanities Assistant"},{"text":"Heritage Research Assistant"},{"text":"Research Intern"},{"text":"Documentation Associate"},{"text":"Academic Project Assistant"},{"text":"Language Research Assistant"},{"text":"Content Researcher"},{"text":"Cultural Programme Assistant"}]},{"type":"p","text":"The title Indology Researcher is more realistically reached through postgraduate research training and specialization."}]},{"heading":"Postgraduate Study in India","kind":"pg_india","blocks":[{"type":"p","text":"For a serious research career, postgraduate study is strongly recommended."},{"type":"h","text":"Core"},{"type":"list","items":[{"text":"MA Indology"},{"text":"MA Sanskrit"},{"text":"MA Vedic Studies"},{"text":"MA Indian Philosophy"},{"text":"MA Ancient Indian History"},{"text":"MA History"},{"text":"MA Archaeology"},{"text":"MA Museology/Heritage Studies"}]},{"type":"h","text":"Specialized"},{"type":"list","items":[{"text":"Manuscriptology"},{"text":"Epigraphy"},{"text":"Buddhist Studies"},{"text":"Jain Studies"},{"text":"Comparative Philosophy"},{"text":"Yoga Studies"},{"text":"Indian Intellectual History"},{"text":"Cultural Studies"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Digital Humanities"},{"text":"Computational Linguistics"},{"text":"Sanskrit Computational Linguistics"},{"text":"Digital Archiving"}]},{"type":"p","text":"Then:"},{"type":"flow","items":["MA","Research Project","MPhil where applicable/available","PhD"]},{"type":"p","text":"Current doctoral structures and eligibility should be checked with the institution and applicable regulations."}]},{"heading":"Study Abroad","kind":"abroad","blocks":[{"type":"p","text":"Relevant programmes include:"},{"type":"list","items":[{"text":"South Asian Studies"},{"text":"Indology"},{"text":"Sanskrit Studies"},{"t