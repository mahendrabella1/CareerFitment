nd APIs"},{"text":"Authentication"},{"text":"AI assistant"},{"text":"Analytics"},{"text":"Accessibility"},{"text":"Automated testing"},{"text":"Production deployment"},{"text":"This demonstrates both UX thinking and engineering capability."}]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"UI/UX Engineer Intern"},{"text":"UX Engineering Intern"},{"text":"Frontend Developer Intern"},{"text":"Product Design Intern"},{"text":"UI Developer Intern"},{"text":"Design Technology Intern"},{"text":"Product Engineering Intern"},{"text":"Design Systems Intern"}]},{"type":"h","text":"Portfolio should contain"},{"type":"p","text":"3–5 strong case studies, not 20 small designs."},{"type":"p","text":"Each case study should show:"},{"type":"flow","items":["Problem","Research","User Insights","User Flow","Wireframes","Design Decisions","Prototype","Implementation","Testing","Final Product"]},{"type":"p","text":"The student should provide both:"},{"type":"h","text":"Figma → Design"},{"type":"p","text":"and"},{"type":"h","text":"GitHub/Live URL → Engineering"}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"type":"table","header":["Role","Fit"],"rows":[[{"text":"UI/UX Engineer"},{"text":"★★★★★"}],[{"text":"UX Engineer"},{"text":"★★★★★"}],[{"text":"UI Engineer"},{"text":"★★★★★"}],[{"text":"Frontend Developer"},{"text":"★★★★★"}],[{"text":"Frontend Engineer"},{"text":"★★★★★"}],[{"text":"Design Technologist"},{"text":"★★★★★"}],[{"text":"Product Designer"},{"text":"★★★★☆"}],[{"text":"UI Developer"},{"text":"★★★★★"}],[{"text":"Design Systems Engineer"},{"text":"★★★★☆"}],[{"text":"Interaction Designer"},{"text":"★★★★☆"}],[{"text":"Accessibility Engineer"},{"text":"★★★★☆"}],[{"text":"Product Engineer"},{"text":"★★★★☆"}]]}]},{"heading":"Employer Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Employer Type","Important Skills"],"rows":[[{"text":"Product Companies"},{"text":"