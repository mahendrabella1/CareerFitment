{"title":"Career Roadmap: Restoration Assistant","role":"Restoration Assistant","summary":"Career Domain: Media, Communication, Arts & Design · Qualification Pathway: BFA – Sculpture · Target Career: Restoration Assistant","facts":{"Current degree":"BFA (Bachelor of Fine Arts)","Course":"Sculpture"},"about":[{"label":"About this roadmap","text":"This roadmap was drafted with AI assistance from OneGrasp's related roadmaps and is awaiting expert review. Check fees, dates, eligibility and exam patterns on the official websites before you rely on them."}],"intro":[],"horizons":[],"sections":[{"heading":"Career Overview","kind":"other","blocks":[{"type":"p","text":"A Restoration Assistant helps conservators clean, repair and protect artworks, sculptures and heritage objects using careful scientific and craft methods."},{"type":"h","text":"What a Restoration Assistant does"},{"type":"list","items":[{"text":"Document an object's condition with photos and notes"},{"text":"Clean and stabilise objects under supervision"},{"text":"Prepare materials and maintain the lab"},{"text":"Monitor storage and display conditions"}]},{"type":"p","text":"Where they work:"},{"type":"list","items":[{"text":"Museum conservation labs"},{"text":"Conservation institutes and INTACH"},{"text":"Archaeology departments"},{"text":"Private conservation studios"}]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Career stage","Typical role"],"rows":[[{"text":"Entry-level"},{"text":"Restoration Assistant"}],[{"text":"Early career"},{"text":"Conservation Assistant"}],[{"text":"Mid-level"},{"text":"Conservator"}],[{"text":"Senior"},{"text":"Senior Conservator"}],[{"text":"Leadership"},{"text":"Head of Conservation"}]]}]},{"heading":"Year-by-Year Learning Roadmap","kind":"build","blocks":[{"type":"h","text":"Year 1: Foundations"},{"type":"list","items":[{"text":"Sculpture and material basics"},{"text":"Study art history"},{"text":"Learn careful documentation"}]},{"type":"h","text":"Year 2: Materials science"},{"type":"list","items":[{"text":"Learn chemistry of stone, metal, wood and pigments"},{"text":"Visit a museum conservation lab"},{"text":"Take a conservation workshop"}]},{"type":"h","text":"Year 3: Lab experience"},{"type":"list","items":[{"text":"Intern at a conservation lab"},{"text":"Learn condition reporting"},{"text":"Practise on non-valuable objects"}]},{"type":"h","text":"Year 4: Prepare for a conservation career"},{"type":"list","items":[{"text":"Project documenting and treating a sample object"},{"text":"Build a documentation portfolio"},{"text":"Apply for MA Conservation"}]}]},{"heading":"Essential Skills","kind":"build","blocks":[{"type":"table","header":["Skill","Type"],"rows":[[{"text":"Condition documentation"},{"text":"Technical"}],[{"text":"Cleaning and stabilisation"},{"text":"Technical"}],[{"text":"Material science"},{"text":"Technical"}],[{"text":"Preventive conservation"},{"text":"Technical"}],[{"text":"Patience"},{"text":"Professional"}],[{"text":"Steady hands"},{"text":"Professional"}],[{"text":"Ethics and care"},{"text":"Professional"}]]}]},{"heading":"Tools and Technologies to Learn","kind":"build","blocks":[{"type":"list","items":[{"text":"Microscopes and lab tools"},{"text":"Photography"},{"text":"Condition-report templates"}]}]},{"heading":"Internships and Practical Experience","kind":"internships","blocks":[{"type":"list","items":[{"text":"Museum conservation labs"},{"text":"NRLC Lucknow"},{"text":"INTACH conservation centres"}]}]},{"heading":"Certifications and Additional Training","kind":"certifications","blocks":[{"type":"list","items":[{"text":"Conservation workshops (NRLC, INTACH)"}]},{"type":"note","label":"Before you enrol","text":"Check the current syllabus, fees and eligibility on the certifying body's official website."}]},{"heading":"Higher Education Options in India","kind":"pg_india","blocks":[{"type":"p","text":"Options after your degree:"},{"type":"list","items":[{"text":"MA Conser