on"},{"text":"Map hospitals"},{"text":"Establish travel/accessibility criteria"},{"text":"Conduct network or proximity analysis"},{"text":"Identify underserved populations"},{"text":"Consider road/transport constraints"},{"text":"Produce priority areas"}]},{"type":"h","text":"Planning"},{"type":"p","text":"How would you evaluate a proposed development site?"},{"type":"p","text":"Consider:"},{"type":"list","items":[{"text":"Accessibility"},{"text":"Existing land use"},{"text":"Population"},{"text":"Infrastructure"},{"text":"Environmental constraints"},{"text":"Transport"},{"text":"Utilities"},{"text":"Risk"},{"text":"Planning regulations"},{"text":"Community impact"}]},{"type":"h","text":"Data"},{"type":"p","text":"Employers may test:"},{"type":"list","items":[{"text":"Excel"},{"text":"GIS"},{"text":"Spatial reasoning"},{"text":"Maps"},{"text":"Data interpretation"},{"text":"Basic statistics"},{"text":"Dashboard creation"}]}]},{"heading":"Postgraduate Study in India","kind":"pg_india","blocks":[{"type":"p","text":"For progression beyond planning-support roles, postgraduate specialisation is highly valuable."},{"type":"h","text":"Master of Urban Planning / Urban & Regional Planning"},{"type":"p","text":"Best for:"},{"type":"list","items":[{"text":"Urban planning"},{"text":"Regional planning"},{"text":"Development planning"},{"text":"Professional planning careers"}]},{"type":"h","text":"Master of Geography"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"GIS"},{"text":"Urban geography"},{"text":"Regional development"},{"text":"Research"}]},{"type":"h","text":"MSc/MA GIS & Remote Sensing"},{"type":"p","text":"Excellent for:"},{"type":"list","items":[{"text":"Geospatial analysis"},{"text":"Spatial data"},{"text":"Remote sensing"},{"text":"GIS careers"}]},{"type":"h","text":"Master of Regional Planning"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Regional development"},{"text":"Rural-urban systems"},{"text":"Infrastructure planning"}]},{"type":"h","text":"Environmental Planning/Management"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Sustainability"},{"text":"Environmental planning"},{"text":"Climate resilience"},{"text":"Environmental assessment"}]},{"type":"h","text":"Transport Planning"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Mobility"},{"text":"Public transport"},{"text":"Transport modelling"},{"text":"Accessibility analysis"}]},{"type":"h","text":"Urban Design"},{"type":"p","text":"A possible direction for students with the required design background, but professional architectural/urban-design eligibility varies by programme."}]},{"heading":"Study Abroad","kind":"abroad","blocks":[{"type":"p","text":"Relevant postgraduate areas include:"},{"type":"list","items":[{"text":"Urban Planning"},{"text":"Regional Planning"},{"text":"Spatial Planning"},{"text":"GIS"},{"text":"Geospatial Science"},{"text":"Urban Analytics"},{"text":"Transport Planning"},{"text":"Environmental Planning"},{"text":"Smart Cities"},{"text":"Sustainable Development"},{"text":"Urban Design"},{"text":"Infrastructure Planning"}]},{"type":"h","text":"Strong combinations"},{"type":"h","text":"Geography + GIS"},{"type":"p","text":"→ Geospatial Analyst"},{"type":"h","text":"Geography + Urban Planning"},{"type":"p","text":"→ Urban/Regional Planning"},{"type":"h","text":"Geography + Data Science"},{"type":"p","text":"→ Urban Data Analyst"},{"type":"h","text":"Geography + Transport"},{"type":"p","text":"→ Transport Planning"},{"type":"h","text":"Geography + Climate Science"},{"type":"p","text":"→ Climate Resilience Planning"},{"type":"h","text":"Geography + Smart Cities"},{"type":"p","text":"→ Urban Technology/Smart City Analytics"}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"0–2 Years"},{"type":"h","text":"Planning Assistant / GIS Assistant"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Mapping"},{"text":"Data"},{"text":"Surveys"},{"text":"Documentation"}]},{"type":"h","text":"2–5 Years"},{"type":"h","text":"Planning Analyst / GIS Analyst"},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"Spatial analysis"},{"text":"Planning research"},{"text":"Data interpretation"},{"text":"Project responsibility"}]},{"type":"h","text":"5–8 Years"},{"type":"h","text":"Senior Planning Analyst / Planning Specialist"},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"Planning projects"},{"text":"Stakeholder coordination"},{"text":"Advanced GIS"},{"text":"Project leadership"}]},{"type":"h","text":"8–12 Years"},{"type":"h","text":"Planning Manager / Urban Development Specialist"},{"type":"p","text":"Own:"},{"type":"list","items":[{"text":"Major projects"},{"text":"Teams"},{"text":"Client/government coordination"},{"text":"Strategic planning"}]},{"type":"h","text":"12+ Years"},{"type":"h","text":"Planning Director / Urban Development Consultant / Specialist"},{"type":"p","text":"Possible paths:"},{"type":"list","items":[{"text":"Urban planning"},{"text":"Regional development"},{"text":"Infrastructure"},{"text":"Smart cities"},{"text":"GIS consulting"},{"text":"Sustainable development"}]},{"type":"h","text":"2040–2046 Career Evolution"},{"type":"p","text":"Planning will increasingly become data-driven, geospatial and AI-assisted."},{"type":"h","text":"Traditional planning"},{"type":"flow","items":["Survey","Map","Analyse","Plan","Report"]},{"type":"h","text":"Emerging planning"},{"type":"flow","items":["Real-Time Spatial Data","AI/Simulation","Scenario Modelling","Stakeholder Input","Adaptive Planning"]},{"type":"h","text":"Emerging roles"},{"type":"list","items":[{"text":"Urban Data Analyst"},{"text":"AI Urban Planning Specialist"},{"text":"Smart City Data Specialist"},{"text":"Geospatial Data Scientist"},{"text":"Digital Twin Planning Specialist"},{"text":"Climate Resilience Planner"},{"text":"Mobility Analytics Specialist"},{"text":"Urban AI Analyst"},{"text":"Spatial Intelligence Specialist"}]},{"type":"h","text":"AI & technology applications"},{"type":"p","text":"Future planning teams will increasingly use:"},{"type":"list","items":[{"text":"AI-based land-use analysis"},{"text":"Satellite-image classification"},{"text":"Urban digital twins"},{"text":"Traffic prediction"},{"text":"Population modelling"},{"text":"Infrastructure-demand forecasting"},{"text":"Climate-risk modelling"},{"text":"Urban heat analysis"},{"text":"3D city models"},{"text":"Real-time mobility data"}]},{"type":"p","text":"AI should support planning analysis rather than replace professional judgement, statutory review, stakeholder participation and public-interest decision-making."},{"type":"h","text":"Recommended Final Skill Stack"},{"type":"h","text":"Geography"},{"type":"list","items":[{"text":"Human geography"},{"text":"Urban geography"},{"text":"Economic geography"},{"text":"Population geography"},{"text":"Regional geography"},{"text":"Environmental geography"}]},{"type":"h","text":"Planning"},{"type":"list","items":[{"text":"Urban planning"},{"text":"Regional planning"},{"text":"Land-use planning"},{"text":"Transport fundamentals"},{"text":"Infrastructure"},{"text":"Housing"},{"text":"Sustainable development"}]},{"type":"h","text":"GIS"},{"type":"list","items":[{"text":"QGIS"},{"text":"ArcGIS"},{"text":"Cartography"},{"text":"Spatial analysis"},{"text":"Georeferencing"},{"text":"Spatial databases"}]},{"type":"h","text":"Remote Sensing"},{"type":"list","items":[{"text":"Sentinel"},{"text":"Landsat"},{"text":"Land-use/land-cover classification"},{"text":"NDVI"},{"text":"Change detection"},{"text":"Google Earth Engine"}]},{"type":"h","text":"Data"},{"type":"list","items":[{"text":"Excel"},{"text":"Power BI"},{"text":"Statistics"},{"text":"SQL"},{"text":"Python"},{"text":"GeoPandas"},{"text":"PostGIS"}]},{"type":"h","text":"Design & Visualisation"},{"type":"list","items":[{"text":"AutoCAD"},{"text":"SketchUp"},{"text":"3D visualisation"},{"text":"Professional map design"}]},{"type":"h","text":"AI & Future Technology"},{"type":"list","items":[{"text":"Geospatial AI"},{"text":"Computer vision"},{"text":"Urban analytics"},{"text":"Digital twins"},{"text":"Spatial forecasting"},{"text":"AI-assisted planning"}]},{"type":"h","text":"Target Progression"},{"type":"flow","items":["BA Geography","GIS + Spatial Analysis","Urban/Regional Planning Knowledge","Planning/GIS Internship","Planning Assistant / GIS Assistant","Planning Analyst / GIS Analyst","Relevant PG in Urban/Regional Planning, GIS or Specialisation","Urban/Regional Planning Specialist","Senior Planner / Planning Manager","Planning Director / Urban Development Consultant"]},{"type":"h","text":"Best overall strategy"},{"type":"p","text":"For a Geography graduate targeting Planning Assistant, the strongest combination is:"},{"type":"flow","items":["BA Geography","GIS","remote sensing","spatial analysis","planning fundamentals","statistics/data analytics","planning internship."],"sep":"+"},{"type":"p","text":"The key differentiator is becoming capable of turning geographic and demographic data into useful planning evidence. For long-term progression into professional planning roles, add a recognised postgraduate planning qualification where required, while developing GIS, urban analytics and AI capabilities for the future."}]}]}