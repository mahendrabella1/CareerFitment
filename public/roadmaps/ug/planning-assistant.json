nal inequality"},{"text":"Environmental sustainability"}]},{"type":"h","text":"Develop basic quantitative skills"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Percentages"},{"text":"Ratios"},{"text":"Descriptive statistics"},{"text":"Population calculations"},{"text":"Growth rates"},{"text":"Data interpretation"},{"text":"Graphs and charts"}]},{"type":"h","text":"Year-1 project"},{"type":"h","text":"Geographic Profile of a City/Region"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Population"},{"text":"Land use"},{"text":"Settlements"},{"text":"Transport"},{"text":"Employment"},{"text":"Public facilities"},{"text":"Environmental conditions"},{"text":"Development challenges"}]},{"type":"h","text":"Year 2 — GIS & Spatial Analysis"},{"type":"p","text":"This should become one of the student's strongest technical areas."},{"type":"h","text":"Learn GIS"},{"type":"p","text":"Start with:"},{"type":"list","items":[{"text":"QGIS"},{"text":"ArcGIS concepts"},{"text":"Coordinate systems"},{"text":"Projections"},{"text":"Georeferencing"},{"text":"Digitisation"},{"text":"Spatial layers"},{"text":"Attribute tables"},{"text":"Symbology"},{"text":"Map layouts"}]},{"type":"h","text":"Spatial analysis"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Buffering"},{"text":"Overlay analysis"},{"text":"Proximity analysis"},{"text":"Spatial queries"},{"text":"Network concepts"},{"text":"Site suitability"},{"text":"Accessibility analysis"},{"text":"Hotspot analysis"}]},{"type":"h","text":"Remote sensing"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Satellite imagery"},{"text":"Raster/vector data"},{"text":"Landsat"},{"text":"Sentinel"},{"text":"Land-use/land-cover classification"},{"text":"NDVI"},{"text":"Change detection"},{"text":"Image interpretation"}]},{"type":"h","text":"Year-2 project"},{"type":"h","text":"GIS-Based Urban Land-Use Mapping"},{"type":"p","text":"Create:"},{"type":"list","items":[{"text":"Base map"},{"text":"Road network"},{"text":"Buildings"},{"text":"Land-use layers"},{"text":"Public facilities"},{"text":"Green spaces"},{"text":"Water bodies"},{"text":"Population information"}]},{"type":"p","text":"Then identify:"},{"type":"list","items":[{"text":"Development gaps"},{"text":"High-density areas"},{"text":"Underserved locations"}]},{"type":"h","text":"Year 3 — Planning & Data Analysis"},{"type":"p","text":"Now combine Geography with planning."},{"type":"h","text":"Learn"},{"type":"list","items":[{"text":"Urban planning fundamentals"},{"text":"Regional planning"},{"text":"Rural planning"},{"text":"Land-use planning"},{"text":"Transport planning fundamentals"},{"text":"Housing"},{"text":"Infrastructure planning"},{"text":"Environmental planning"},{"text":"Disaster-risk planning"},{"text":"Sustainable development"}]},{"type":"h","text":"Planning data"},{"type":"p","text":"Analyse:"},{"type":"list","items":[{"text":"Census data"},{"text":"Population projections"},{"text":"Household data"},{"text":"Land-use data"},{"text":"Transport data"},{"text":"Infrastructure data"},{"text":"Economic indicators"},{"text":"Environmental indicators"}]},{"type":"h","text":"Data tools"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Advanced Excel"},{"text":"Power BI"},{"text":"SQL basics"},{"text":"Python basics"},{"text":"GeoPandas"},{"text":"Rasterio"},{"text":"Shapely"},{"text":"PostGIS concepts"}]},{"type":"h","text":"Planning documentation"},{"type":"p","text":"Learn to prepare:"},{"type":"list","items":[{"text":"Maps"},{"text":"Tables"},{"text":"Site-analysis reports"},{"text":"Planning briefs"},{"text":"Spatial dashboards"},{"text":"Survey reports"},{"text":"Presentation decks"}]},{"type":"h","text":"Year-3 project"},{"type":"h","text":"GIS-Based Urban Accessibility & Public Facility Analysis"},{"type":"p","text":"Analyse accessibility to:"},{"type":"list","items":[{"text":"Schools"},{"text":"Hospitals"},{"text":"Public transport"},{"text":"Parks"},{"text":"Government services"}]},{"type":"p","text":"Identify underserved areas and propose evidence-based planning improvements."},{"type":"h","text":"Year 4 — Professional Planning Support"},{"type":"p","text":"For a 4-year Honours pathway, develop advanced planning and project skills."},{"type":"h","text":"Learn"},{"type":"list","items":[{"text":"Development plans"},{"text":"Master plans"},{"text":"Zoning concepts"},{"text":"Land-use planning"},{"text":"Development controls"},{"text":"Infrastructure planning"},{"text":"Transport planning"},{"text":"Environmental impact concepts"},{"text":"Disaster resilience"},{"text":"Stakeholder consultation"},{"text":"Planning reports"}]},{"type":"h","text":"CAD & visualisation"},{"type":"p","text":"Learn the fundamentals of:"},{"type":"list","items":[{"text":"AutoCAD"},{"text":"SketchUp"},{"text":"3D visualisation"},{"text":"Map layouts"},{"text":"Presentation graphics"}]},{"type":"p","text":"For planning-oriented careers, GIS should remain the stronger technical priority."},{"type":"h","text":"Planning workflow"},{"type":"p","text":"Understand:"},{"type":"h","text":"Data Collection"},{"type":"h","text":"Existing-Condition Analysis"},{"type":"h","text":"Problem Identification"},{"type":"h","text":"Spatial Analysis"},{"type":"h","text":"Scenario Development"},{"type":"h","text":"Stakeholder Consultation"},{"type":"h","text":"Planning Proposal"},{"type":"h","text":"Implementation"},{"type":"h","text":"Monitoring"},{"type":"h","text":"Final-Year Project"},{"type":"h","text":"Recommended project"},{"type":"h","text":"GIS-Based Sustainable Urban Development Planning Framework"},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Population analysis"},{"text":"Existing land-use map"},{"text":"Transport analysis"},{"text":"Public-facility accessibility"},{"text":"Environmental constraints"},{"text":"Development opportunities"},{"text":"Infrastructure gaps"},{"text":"GIS analysis"},{"text":"Planning recommendations"}]},{"type":"h","text":"Alternative projects"},{"type":"list","items":[{"text":"Transit accessibility analysis"},{"text":"Urban sprawl mapping"},{"text":"Affordable-housing suitability analysis"},{"text":"Green-space accessibility study"},{"text":"Rural service-centre planning"},{"text":"Flood-risk-informed development planning"},{"text":"GIS-based school/hospital location analysis"},{"text":"Urban heat-island mapping"},{"text":"Regional development disparity analysis"}]},{"type":"h","text":"4-Year Honours / Research Variant"},{"type":"p","text":"The additional year can be used for deeper study in:"},{"type":"h","text":"Urban Geography"},{"type":"list","items":[{"text":"Urbanisation"},{"text":"Metropolitan growth"},{"text":"Informal settlements"},{"text":"Housing"},{"text":"Urban inequality"}]},{"type":"h","text":"Regional Planning"},{"type":"list","items":[{"text":"Regional development"},{"text":"Rural-urban linkages"},{"text":"Infrastructure"},{"text":"Economic geography"}]},{"type":"h","text":"GIS & Spatial Science"},{"type":"list","items":[{"text":"Advanced GIS"},{"text":"Remote sensing"},{"text":"Spatial statistics"},{"text":"Web GIS"},{"text":"Geospatial databases"}]},{"type":"h","text":"Environmental Planning"},{"type":"list","items":[{"text":"Climate resilience"},{"text":"Environmental risk"},{"text":"Ecosystem services"},{"text":"Sustainable development"}]},{"type":"h","text":"Specialisation Options"},{"type":"table","header":["Specialisation","Core Skills","Potential Roles"],"rows":[[{"text":"Urban Planning Support"},{"text":"GIS + urban geography"},{"text":"Planning Assistant"}],[{"text":"Regional Planning"},{"text":"Spatial + economic analysis"},{"text":"Regional Planning Assistant"}],[{"text":"Transport Planning"},{"text":"GIS + mobility data"},{"text":"Transport Planning Analyst"}],[{"text":"Environmental Planning"},{"text":"GIS + environment"},{"text":"Environmental Planning Assistant"}],[{"text":"Housing Planning"},{"text":"Demography + GIS"},{"text":"Housing Research/Pl