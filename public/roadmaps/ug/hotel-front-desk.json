stomer experience"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"PMS"},{"text":"CRM"},{"text":"Excel"},{"text":"Power BI"},{"text":"Digital booking platforms"},{"text":"Hotel technology"}]},{"type":"h","text":"Communication"},{"type":"list","items":[{"text":"English"},{"text":"Professional writing"},{"text":"Telephone etiquette"},{"text":"Public speaking"},{"text":"Cross-cultural communication"}]},{"type":"h","text":"Management"},{"type":"list","items":[{"text":"Team coordination"},{"text":"Staff scheduling"},{"text":"Training"},{"text":"Conflict resolution"},{"text":"Performance management"}]},{"type":"h","text":"Future Skills"},{"type":"list","items":[{"text":"AI-assisted hospitality"},{"text":"Data analytics"},{"text":"Smart hotels"},{"text":"Digital guest experience"},{"text":"Sustainability"}]},{"type":"h","text":"Target Profile"},{"type":"flow","items":["BA Tourism & Hospitality Studies","Hotel/Front Office Internship","Front Desk Executive","Senior Front Office Associate","Front Office Supervisor","Assistant Front Office Manager","Front Office Manager","Rooms Division/Hotel Operations Manager","General Manager"]},{"type":"note","label":"Best immediate priority","text":"gain real hotel front-office experience and become proficient in PMS + reservations + guest handling + English communication + Excel, rather than relying only on classroom hospitality theory."}]}]}