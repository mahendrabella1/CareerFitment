r Data"},{"type":"p","text":"+"},{"type":"p","text":"Tracking Data"},{"type":"p","text":"+"},{"type":"p","text":"Video Data"},{"type":"p","text":"+"},{"type":"flow","items":["Sensor Data","Sports Analytics","Performance Insights"]},{"type":"h","text":"Year 4 — Industry & Decision Analytics"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Predictive modelling"},{"text":"Scouting analytics"},{"text":"Player evaluation"},{"text":"Match strategy"},{"text":"Injury-risk analytics"},{"text":"Real-time analytics"},{"text":"Sports dashboards"},{"text":"Data storytelling"},{"text":"Sports business analytics"}]},{"type":"p","text":"Complete an internship with a sports-tech company, team, academy, federation, or analytics organization."}]},{"heading":"Core Sports Analytics Knowledge","kind":"other","blocks":[{"type":"h","text":"Performance Metrics"},{"type":"p","text":"Understand metrics such as:"},{"type":"list","items":[{"text":"Player efficiency"},{"text":"Scoring rate"},{"text":"Accuracy"},{"text":"Possession"},{"text":"Passing efficiency"},{"text":"Shot quality"},{"text":"Expected goals"},{"text":"Expected runs"},{"text":"Expected points"},{"text":"Win probability"},{"text":"Performance consistency"}]},{"type":"p","text":"Metrics vary significantly by sport."}]},{"heading":"Cricket Analytics","kind":"other","blocks":[{"type":"p","text":"Since cricket is particularly data-rich, learn:"},{"type":"h","text":"Batting"},{"type":"list","items":[{"text":"Strike rate"},{"text":"Boundary percentage"},{"text":"Dot-ball percentage"},{"text":"Runs per phase"},{"text":"Runs against bowling types"},{"text":"Performance by venue"},{"text":"Performance against specific bowlers"}]},{"type":"h","text":"Bowling"},{"type":"list","items":[{"text":"Economy rate"},{"text":"Bowling strike rate"},{"text":"Dot-ball percentage"},{"text":"Wicket probability"},{"text":"Pitch/venue performance"},{"text":"Phase-wise performance"}]},{"type":"h","text":"Fielding"},{"type":"list","items":[{"text":"Catch probability"},{"text":"Run-out probability"},{"text":"Fielding efficiency"},{"text":"Throwing accuracy"}]},{"type":"h","text":"Match Analytics"},{"type":"flow","items":["Historical Matches","Player & Match Data","Feature Engineering","Performance Model","Match Prediction / Strategy"]}]},{"heading":"Football Analytics","kind":"other","blocks":[{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Expected goals (xG)"},{"text":"Expected assists (xA)"},{"text":"Progressive passes"},{"text":"Progressive carries"},{"text":"Possession"},{"text":"Pressing metrics"},{"text":"Passing networks"},{"text":"Shot maps"},{"text":"Player positioning"},{"text":"Expected threat"}]},{"type":"p","text":"Visualize:"},{"type":"list","items":[{"text":"Heatmaps"},{"text":"Passing networks"},{"text":"Shot maps"},{"text":"Player movement"}]}]},{"heading":"Basketball Analytics","kind":"other","blocks":[{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Points per possession"},{"text":"True shooting percentage"},{"text":"Usage rate"},{"text":"Rebound percentage"},{"text":"Assist rate"},{"text":"Turnover rate"},{"text":"Shot-location analytics"},{"text":"Lineup efficiency"}]}]},{"heading":"Tennis Analytics","kind":"other","blocks":[{"type":"p","text":"Analyze:"},{"type":"list","items":[{"text":"First-serve percentage"},{"text":"Serve speed"},{"text":"Break-point conversion"},{"text":"Rally length"},{"text":"Unforced errors"},{"text":"Winners"},{"text":"Court-position data"},{"text":"Serve placement"}]}]},{"heading":"Data Science Skills","kind":"other","blocks":[{"type":"h","text":"Python"},{"type":"p","text":"Master:"},{"type":"list","items":[{"text":"pandas"},{"text":"NumPy"},{"text":"matplotlib"},{"text":"seaborn"},{"text":"SciPy"},{"text":"scikit-learn"}]},{"type":"h","text":"SQL"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"SELECT"},{"text":"JOIN"},{"text":"GROUP BY"},{"text":"Window functions"},{"text":"CTEs"},{"text":"Aggregations"