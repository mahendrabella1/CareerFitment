text":"Delivery operations"},{"text":"Customer experience"},{"text":"Digital marketing"},{"text":"Social media"},{"text":"E-commerce"},{"text":"Financial planning"}]},{"type":"p","text":"Learn business metrics:"},{"type":"list","items":[{"text":"Food cost %"},{"text":"Labour cost %"},{"text":"Gross margin"},{"text":"Contribution margin"},{"text":"Average order value"},{"text":"Customer acquisition cost"},{"text":"Repeat purchase rate"},{"text":"Break-even point"},{"text":"Inventory turnover"}]},{"type":"h","text":"Honours/research route"},{"type":"p","text":"A strong project could involve:"},{"type":"list","items":[{"text":"Developing a functional food product"},{"text":"Low-sugar bakery formulation"},{"text":"Gluten-free product development"},{"text":"Plant-based desserts"},{"text":"Shelf-life optimisation"},{"text":"Sustainable packaging"},{"text":"Food-waste reduction"},{"text":"Fermented foods"},{"text":"Local ingredient-based product development"}]},{"type":"h","text":"Core skill stack"},{"type":"table","header":["Area","Skills"],"rows":[[{"text":"Culinary"},{"text":"Cooking, baking, pastry, presentation"}],[{"text":"Food science"},{"text":"Food chemistry, ingredients, shelf life"}],[{"text":"Product"},{"text":"Recipe development, standardisation"}],[{"text":"Food safety"},{"text":"HACCP, hygiene, allergen control"}],[{"text":"Operations"},{"text":"Procurement, inventory, production"}],[{"text":"Finance"},{"text":"Costing, margins, cash flow"}],[{"text":"Marketing"},{"text":"Branding, social media, digital marketing"}],[{"text":"Sales"},{"text":"Customer acquisition, upselling"}],[{"text":"Technology"},{"text":"POS, inventory systems, e-commerce"}],[{"text":"Leadership"},{"text":"Hiring, training, team management"}]]},{"type":"h","text":"Specialisation options"},{"type":"table","header":["Specialisation","Key skills","Business opportunity"],"rows":[[{"text":"Artisan Bakery"},{"text":"Bread, pastry, fermentation"},{"text":"Bakery brand"}],[{"text":"Premium Desse