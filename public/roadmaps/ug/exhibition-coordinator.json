tist relations"},{"text":"Art handling"},{"text":"Installation"},{"text":"Gallery programming"}]},{"type":"h","text":"3. Heritage Exhibitions"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Archaeology"},{"text":"Architecture"},{"text":"Local history"},{"text":"Cultural heritage"},{"text":"Community heritage"}]},{"type":"h","text":"4. Digital Exhibitions"},{"type":"p","text":"Combine:"},{"type":"flow","items":["Museology","Heritage","Digital Media","UX"],"sep":"+"},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"Virtual exhibitions"},{"text":"Digital archives"},{"text":"Interactive displays"},{"text":"3D heritage"},{"text":"AR/VR experiences"}]},{"type":"h","text":"5. Exhibition Production"},{"type":"p","text":"Focus more heavily on:"},{"type":"list","items":[{"text":"Fabrication"},{"text":"Vendors"},{"text":"Installation"},{"text":"Lighting"},{"text":"AV"},{"text":"Logistics"},{"text":"Budget"},{"text":"Project management"}]},{"type":"p","text":"This is one of the most directly aligned routes for an Exhibition Coordinator."},{"type":"h","text":"Employer Skill Matrix"},{"type":"table","header":["Employer Type","Key Skills"],"rows":[[{"text":"Museums"},{"text":"Collections + exhibitions + interpretation"}],[{"text":"Art Galleries"},{"text":"Art handling + exhibitions + artist coordination"}],[{"text":"Heritage Institutions"},{"text":"Heritage + research + documentation"}],[{"text":"Exhibition Companies"},{"text":"Project management + production + vendors"}],[{"text":"Cultural Foundations"},{"text":"Programme management + outreach"}],[{"text":"Archives"},{"text":"Documentation + digitisation"}],[{"text":"Universities"},{"text":"Museum programmes + exhibitions + research"}],[{"text":"Government Cultural Institutions"},{"text":"Administration + heritage + exhibitions"}],[{"text":"Tourism Organisations"},{"text":"Heritage interpretation + visitor experience"}],[{"text":"Digital Heritage Companies"},{"text":"Digital exhibitions + 3D/AR/V