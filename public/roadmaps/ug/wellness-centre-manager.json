l Tools & Technology","kind":"other","blocks":[{"type":"h","text":"Essential"},{"type":"h","text":"Productivity"},{"type":"h","text":"Microsoft Excel"},{"type":"h","text":"Google Sheets"},{"type":"h","text":"Microsoft Word"},{"type":"h","text":"PowerPoint"},{"type":"h","text":"Google Workspace"},{"type":"h","text":"Management"},{"type":"h","text":"CRM systems"},{"type":"h","text":"Appointment scheduling platforms"},{"type":"h","text":"Membership management software"},{"type":"h","text":"Billing/POS systems"},{"type":"h","text":"Inventory management systems"},{"type":"h","text":"Analytics"},{"type":"h","text":"Excel dashboards"},{"type":"h","text":"Power BI"},{"type":"h","text":"Google Analytics"},{"type":"h","text":"Customer feedback analytics"},{"type":"h","text":"Marketing"},{"type":"h","text":"Canva"},{"type":"h","text":"Meta Business Suite"},{"type":"h","text":"Instagram"},{"type":"h","text":"YouTube"},{"type":"h","text":"Email marketing platforms"}]},{"heading":"AI Skills for Wellness Management","kind":"other","blocks":[{"type":"p","text":"AI is increasingly useful for the administrative and business side of wellness centres."},{"type":"h","text":"Students should learn:"},{"type":"h","text":"AI-assisted content creation"},{"type":"h","text":"Customer-service chatbots"},{"type":"h","text":"Appointment automation"},{"type":"h","text":"CRM automation"},{"type":"h","text":"Customer feedback analysis"},{"type":"h","text":"Demand forecasting"},{"type":"h","text":"Revenue forecasting"},{"type":"h","text":"Personalized wellness-program administration"},{"type":"h","text":"Marketing analytics"},{"type":"h","text":"Document automation"},{"type":"h","text":"Business intelligence"},{"type":"h","text":"Example"},{"type":"h","text":"Customer Data"},{"type":"h","text":"CRM"},{"type":"h","text":"AI Analytics"},{"type":"h","text":"Customer Behaviour Insights"},{"type":"h","text":"Retention Prediction"},{"type":"h","text":"Personalized Wellness Offers"},{"type":"h","text":"Improved Customer Experience"},{"type":"p","text":"AI should support qualified professionals rather than independently making clinical diagnoses or treatment decisions."}]},{"heading":"Recommended UG Projects","kind":"other","blocks":[{"type":"h","text":"Project 1 — Wellness Centre Management Dashboard"},{"type":"h","text":"Build a dashboard tracking:"},{"type":"h","text":"Daily visitors"},{"type":"h","text":"Appointments"},{"type":"h","text":"Revenue"},{"type":"h","text":"Memberships"},{"type":"h","text":"Cancellation rate"},{"type":"h","text":"Customer retention"},{"type":"h","text":"Practitioner utilisation"},{"type":"h","text":"Service popularity"},{"type":"note","label":"Tools","text":"Excel / Power BI"},{"type":"h","text":"Project 2 — Digital Wellness Booking System"},{"type":"h","text":"Create a prototype for:"},{"type":"h","text":"Online appointment booking"},{"type":"h","text":"Practitioner selection"},{"type":"h","text":"Service selection"},{"type":"h","text":"Payment"},{"type":"h","text":"Appointment reminders"},{"type":"h","text":"Feedback"},{"type":"h","text":"Project 3 — Wellness Retreat Management Plan"},{"type":"p","text":"Design a 3-day or 7-day wellness retreat."},{"type":"h","text":"Include:"},{"type":"h","text":"Daily schedule"},{"type":"h","text":"Yoga sessions"},{"type":"h","text":"Nutrition sessions"},{"type":"h","text":"Wellness activities"},{"type":"h","text":"Practitioner allocation"},{"type":"h","text":"Accommodation coordination"},{"type":"h","text":"Safety procedures"},{"type":"h","text":"Budget"},{"type":"h","text":"Customer feedback system"},{"type":"h","text":"Project 4 — Customer Satisfaction Analytics"},{"type":"h","text":"Collect anonymized feedback and analyse:"},{"type":"h","text":"Satisfaction"},{"type":"h","text":"Service quality"},{"type":"h","text":"Waiting time"},{"type":"h","text":"Staff behaviour"},{"type":"h","text":"Facility quality"},{"type":"h","text":"Repeat-visit intention"},{"type":"p","text":"Create a Power BI dashboar