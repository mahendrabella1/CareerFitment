rnship experience"}],[{"text":"Team management"},{"text":"Leadership projects"}],[{"text":"Client handling"},{"text":"Communication experience"}],[{"text":"Scheduling"},{"text":"Digital booking project"}],[{"text":"Financial management"},{"text":"Excel budgeting"}],[{"text":"Analytics"},{"text":"Power BI dashboard"}],[{"text":"Marketing"},{"text":"Social media campaign"}],[{"text":"Customer retention"},{"text":"CRM knowledge"}],[{"text":"Quality management"},{"text":"SOP project"}],[{"text":"Technology"},{"text":"Digital wellness tools"}],[{"text":"AI"},{"text":"AI-assisted operations"}],[{"text":"Leadership"},{"text":"Team/project management"}]]}]},{"heading":"Certifications & Additional Learning","kind":"certifications","blocks":[{"type":"p","text":"Useful complementary learning areas include:"},{"type":"h","text":"Wellness"},{"type":"h","text":"Yoga instruction/therapy training from recognized institutions"},{"type":"h","text":"Nutrition and lifestyle education"},{"type":"h","text":"Wellness coaching"},{"type":"h","text":"Stress-management programs"},{"type":"h","text":"Management"},{"type":"h","text":"Healthcare management"},{"type":"h","text":"Hospital/wellness administration"},{"type":"h","text":"Operations management"},{"type":"h","text":"Project management"},{"type":"h","text":"Technology"},{"type":"h","text":"Advanced Excel"},{"type":"h","text":"Power BI"},{"type":"h","text":"CRM"},{"type":"h","text":"Digital marketing"},{"type":"h","text":"Data analytics"},{"type":"h","text":"AI productivity tools"},{"type":"h","text":"Safety"},{"type":"h","text":"Basic Life Support where relevant"},{"type":"h","text":"First aid"},{"type":"h","text":"Infection prevention"},{"type":"h","text":"Occupational safety"},{"type":"p","text":"Certifications should be selected based on recognition, practical relevance and the scope of the role, rather than collecting large numbers of generic certificates."}]},{"heading":"PG Options","kind":"pg_india","blocks":[{"type":"p","text":"A 