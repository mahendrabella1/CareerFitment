 / QA Executive"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Plant operations"},{"text":"Testing"},{"text":"Documentation"},{"text":"SOPs"},{"text":"Food safety"}]},{"type":"h","text":"2–5 years"},{"type":"h","text":"Dairy Technologist / Senior Executive / Process Specialist"},{"type":"p","text":"Take ownership of:"},{"type":"list","items":[{"text":"Production lines"},{"text":"Quality problems"},{"text":"Process improvement"},{"text":"Yield"},{"text":"New product trials"}]},{"type":"h","text":"5–8 years"},{"type":"h","text":"Senior Technologist / Assistant Manager"},{"type":"p","text":"Lead:"},{"type":"list","items":[{"text":"Teams"},{"text":"Production processes"},{"text":"Audits"},{"text":"Improvement projects"},{"text":"Product development"}]},{"type":"h","text":"8–12 years"},{"type":"h","text":"Manager / Plant Technical Manager / QA Manager / R&D Manager"},{"type":"p","text":"Responsibilities:"},{"type":"list","items":[{"text":"Plant performance"},{"text":"Food safety"},{"text":"Cost optimisation"},{"text":"Compliance"},{"text":"New products"},{"text":"Technical strategy"}]},{"type":"h","text":"12+ years"},{"type":"p","text":"Possible positions:"},{"type":"flow","items":["Plant Head","Technical Director","Operations Director","Business/Technical Leadership"]}]},{"heading":"Technical specialist route","kind":"other","blocks":[{"type":"p","text":"For students who dislike management:"},{"type":"flow","items":["Dairy Technologist","Senior Technologist","Process Specialist","Principal Technologist","Technical Expert"]},{"type":"p","text":"Specialise deeply in:"},{"type":"list","items":[{"text":"UHT processing"},{"text":"Fermentation"},{"text":"Dairy powders"},{"text":"Cheese technology"},{"text":"Dairy microbiology"},{"text":"Food safety"},{"text":"Process optimisation"},{"text":"Dairy engineering"},{"text":"Product development"}]}]},{"heading":"Management route","kind":"other","blocks":[{"type":"flow","items":["Dairy Technologist","Production Exec