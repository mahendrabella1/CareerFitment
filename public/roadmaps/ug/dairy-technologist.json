:"Material balance"},{"text":"Energy balance"},{"text":"Equipment utilisation"},{"text":"Production losses"},{"text":"Waste management"}]},{"type":"h","text":"Quality systems"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"GMP"},{"text":"GHP"},{"text":"HACCP"},{"text":"Food safety"},{"text":"Traceability"},{"text":"Sampling"},{"text":"Corrective and preventive actions"},{"text":"Root-cause analysis"},{"text":"SOP development"},{"text":"Documentation"}]}]},{"heading":"Year 4 — Specialise","kind":"other","blocks":[{"type":"p","text":"Choose one primary career track rather than trying to master everything."},{"type":"table","header":["Specialisation","Focus"],"rows":[[{"text":"Dairy Production"},{"text":"Plant operations, process optimisation, production planning"}],[{"text":"Quality Assurance"},{"text":"HACCP, GMP, testing, audits, food safety"}],[{"text":"Quality Control"},{"text":"Laboratory analysis, microbiology, chemical testing"}],[{"text":"Dairy R&D"},{"text":"New products, formulation, trials, shelf-life"}],[{"text":"Dairy Engineering"},{"text":"Processing equipment, utilities, refrigeration, automation"}],[{"text":"Packaging Technology"},{"text":"Packaging materials, filling, sealing, shelf-life"}],[{"text":"Dairy Microbiology"},{"text":"Microbial testing, fermentation, contamination control"}],[{"text":"Food Safety"},{"text":"HACCP, regulatory compliance, food safety systems"}],[{"text":"Dairy Analytics"},{"text":"Production data, quality data, process optimisation"}]]}]},{"heading":"Step 2 — Internships","kind":"internships","blocks":[{"type":"p","text":"A dairy technologist should prioritise physical plant exposure over generic internships."},{"type":"h","text":"Best internship environments"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Dairy processing plants"},{"text":"Milk cooperatives"},{"text":"Food-processing companies"},{"text":"Dairy-product manufacturers"},{"text":"Quality-control laboratories"},{"text":"Food-test