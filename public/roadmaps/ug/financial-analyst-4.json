{"title":"Career roadmap — Financial Analyst","role":"Financial Analyst","summary":"A Financial Analyst analyses financial statements, budgets, forecasts, investments, business performance, and financial data to support management and investment decisions.","facts":{"Current degree":"BBA / BMS / BBM (Bachelor of Business Administration / Management Studies)","Course":"BBA – Finance"},"about":[],"intro":[],"horizons":[],"sections":[{"heading":"Overview","kind":"other","blocks":[{"type":"p","text":"For a BBA Finance graduate, the strongest route is:"},{"type":"flow","items":["Finance fundamentals","accounting","Excel","financial modelling","Power BI/SQL","business analysis","valuation"],"sep":"+"}]},{"heading":"Career horizons","kind":"horizons","blocks":[{"type":"table","header":["Period","Career focus"],"rows":[[{"text":"2026–2030"},{"text":"Financial Analyst / FP&A Analyst / Finance Associate; build accounting, Excel, modelling and reporting skills"}],[{"text":"2030–2035"},{"text":"Senior Financial Analyst / FP&A Specialist / Investment Analyst; specialise in corporate finance, equity research or risk"}],[{"text":"2035–2040"},{"text":"Finance Manager / FP&A Manager / Finance Business Partner"}],[{"text":"2040–2046"},{"text":"Finance Director / Head of FP&A / Investment Director / CFO track"}]]}]},{"heading":"What to build each year","kind":"build","blocks":[{"type":"h","text":"Year 1 — Finance foundations"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Financial accounting"},{"text":"Cost accounting"},{"text":"Business economics"},{"text":"Corporate finance"},{"text":"Business statistics"},{"text":"Financial markets"},{"text":"Management principles"},{"text":"Business mathematics"},{"text":"Time value of money"},{"text":"Financial ratios"}]},{"type":"p","text":"Master Excel:"},{"type":"list","items":[{"text":"XLOOKUP"},{"text":"INDEX/MATCH"},{"text":"SUMIFS/COUNTIFS"},{"text":"Pivot tables"},{"text":"Conditional formatting"},{"text":"Charts"},{"text":"Data cleaning"},{"text":"Scenario analysis"}]},{"type":"note","label":"Project","text":"Analyse the annual reports of 3 companies and compare:"},{"type":"list","items":[{"text":"Revenue"},{"text":"EBITDA"},{"text":"EBIT"},{"text":"Net profit"},{"text":"Debt"},{"text":"Cash flow"},{"text":"ROE"},{"text":"ROCE"},{"text":"Current ratio"},{"text":"Debt-equity ratio"}]},{"type":"h","text":"Year 2 — Financial analysis & modelling"},{"type":"p","text":"Learn:"},{"type":"h","text":"Financial statement analysis"},{"type":"list","items":[{"text":"Income statement"},{"text":"Balance sheet"},{"text":"Cash-flow statement"},{"text":"Working capital"},{"text":"Revenue analysis"},{"text":"Margin analysis"},{"text":"Cash-flow quality"}]},{"type":"h","text":"Financial modelling"},{"type":"list","items":[{"text":"Revenue forecasting"},{"text":"Cost forecasting"},{"text":"Working-capital modelling"},{"text":"Capex"},{"text":"Depreciation"},{"text":"Debt schedules"},{"text":"Three-statement modelling"},{"text":"Scenario analysis"}]},{"type":"h","text":"Valuation"},{"type":"list","items":[{"text":"DCF"},{"text":"Comparable companies"},{"text":"Precedent transactions"},{"text":"Enterprise Value"},{"text":"Equity Value"},{"text":"P/E"},{"text":"EV/EBITDA"},{"text":"EV/Sales"}]},{"type":"note","label":"Project","text":"Build a complete 3-statement financial model for a public company."},{"type":"h","text":"Year 3 — Business analytics + specialisation"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"FP&A"},{"text":"Budgeting"},{"text":"Forecasting"},{"text":"Variance analysis"},{"text":"Management reporting"},{"text":"Financial planning"},{"text":"Business performance analysis"},{"text":"Investment analysis"},{"text":"Risk analysis"}]},{"type":"p","text":"Add technology:"},{"type":"h","text":"Data"},{"type":"list","items":[{"text":"SQL"},{"text":"Power BI"},{"text":"Power Query"},{"text":"Python/pandas basics"}]},{"type":"h","text":"ERP"},{"type":"list","items":[{"text":"SA