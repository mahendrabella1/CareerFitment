:"Risk modelling, controls"},{"text":"Risk Analyst"}],[{"text":"Treasury"},{"text":"Cash, liquidity, FX"},{"text":"Treasury Analyst"}],[{"text":"Business Finance"},{"text":"KPIs + strategy"},{"text":"Finance Business Analyst"}],[{"text":"Financial Data Analytics"},{"text":"SQL, BI, Python"},{"text":"Finance Data Analyst"}],[{"text":"Investment Management"},{"text":"Portfolio analysis"},{"text":"Investment Analyst"}]]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Corporate finance departments"},{"text":"Banks"},{"text":"NBFCs"},{"text":"Investment banks"},{"text":"Asset management companies"},{"text":"Brokerage/research firms"},{"text":"FinTech companies"},{"text":"Big Four firms"},{"text":"Consulting companies"},{"text":"Startups"},{"text":"GCC finance teams"},{"text":"Credit-rating companies"}]},{"type":"h","text":"Best internship roles"},{"type":"list","items":[{"text":"Finance Intern"},{"text":"Financial Analyst Intern"},{"text":"FP&A Intern"},{"text":"Investment Analyst Intern"},{"text":"Equity Research Intern"},{"text":"Credit Analyst Intern"},{"text":"Corporate Finance Intern"},{"text":"Business Finance Intern"},{"text":"Treasury Intern"},{"text":"Risk Analyst Intern"}]},{"type":"h","text":"What to learn"},{"type":"p","text":"Try to work with real financial processes:"},{"type":"flow","items":["Data","Analysis","Forecast","Variance","Insight","Management decision"]},{"type":"p","text":"Don't spend the entire internship only preparing spreadsheets without understanding the business decision behind them."}]},{"heading":"Certifications and learning","kind":"certifications","blocks":[{"type":"table","header":["Certification","Best for"],"rows":[[{"text":"CFA"},{"text":"Investment analysis / equity research"}],[{"text":"FRM"},{"text":"Risk management"}],[{"text":"CMA"},{"text":"Management accounting / corporate finance"}],[{"text":"CA"},{"text":"Accounting, audit, taxation and finance"}],[{