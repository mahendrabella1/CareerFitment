c exposure"},{"text":"Consequence zones"},{"text":"Emergency response"}]},{"type":"h","text":"Option 3 — AI + Safety"},{"type":"h","text":"Computer-Vision-Based Industrial PPE Detection"},{"type":"p","text":"Use:"},{"type":"list","items":[{"text":"Python"},{"text":"OpenCV"},{"text":"Machine learning/deep learning"}]},{"type":"p","text":"Detect:"},{"type":"list","items":[{"text":"Helmet"},{"text":"Safety vest"},{"text":"Safety shoes"},{"text":"Restricted-area entry"}]},{"type":"h","text":"Option 4 — Process Safety Analytics"},{"type":"h","text":"Predictive Safety Monitoring for Chemical Processes"},{"type":"p","text":"Combine:"},{"type":"flow","items":["Process data","anomaly detection","risk indicators"],"sep":"+"},{"type":"h","text":"4-Year Honours / Advanced Path"},{"type":"p","text":"Useful advanced areas:"},{"type":"table","header":["Specialisation","Future role"],"rows":[[{"text":"Process Safety"},{"text":"Process Safety Engineer"}],[{"text":"Industrial Safety"},{"text":"Safety Engineer"}],[{"text":"Fire & Safety"},{"text":"Fire/Safety Engineer"}],[{"text":"Environmental Safety"},{"text":"EHS Engineer"}],[{"text":"Risk Engineering"},{"text":"Risk Engineer"}],[{"text":"Chemical Process Safety"},{"text":"Process Safety Specialist"}],[{"text":"Industrial Hygiene"},{"text":"Industrial Hygienist"}],[{"text":"Safety Analytics"},{"text":"Safety Data Analyst"}],[{"text":"Functional Safety"},{"text":"Functional Safety Engineer"}],[{"text":"Emergency Management"},{"text":"Emergency Response Specialist"}]]},{"type":"h","text":"Specialisation options"},{"type":"table","header":["Lane","Core stack","Senior role"],"rows":[[{"text":"Process Safety"},{"text":"HAZOP + LOPA + PSM"},{"text":"Process Safety Manager"}],[{"text":"Industrial Safety"},{"text":"HSE + inspections + compliance"},{"text":"HSE Manager"}],[{"text":"Chemical Safety"},{"text":"Hazardous materials + risk"},{"text":"Chemical Safety Manager"}],[{"text":"Fire Safety"},{"text":"Fire protection + emergency response"},{"text":"Fire & Safety Manager"}],[{"text":"Risk Engineering"},{"text":"QRA + FTA + ETA"},{"text":"Risk Manager"}],[{"text":"Environmental HSE"},{"text":"Environmental + occupational safety"},{"text":"EHS Manager"}],[{"text":"Safety Analytics"},{"text":"Python + Power BI + safety data"},{"text":"Safety Analytics Lead"}],[{"text":"Functional Safety"},{"text":"SIS + safety lifecycle"},{"text":"Functional Safety Specialist"}]]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"h","text":"Best industries"},{"type":"h","text":"Chemical & process industries"},{"type":"list","items":[{"text":"Petrochemicals"},{"text":"Refineries"},{"text":"Fertilizers"},{"text":"Pharmaceuticals"},{"text":"Specialty chemicals"},{"text":"Paints"},{"text":"Polymers"},{"text":"Industrial gases"}]},{"type":"h","text":"Other industries"},{"type":"list","items":[{"text":"Power generation"},{"text":"Steel"},{"text":"Cement"},{"text":"Mining"},{"text":"Food processing"},{"text":"Oil & gas"},{"text":"Manufacturing"},{"text":"Energy"}]},{"type":"h","text":"Government / public-sector exposure"},{"type":"p","text":"Relevant organizations can include:"},{"type":"list","items":[{"text":"Oil & gas PSUs"},{"text":"Chemical/fertilizer PSUs"},{"text":"Petroleum/refinery organizations"},{"text":"Government industrial-safety departments"},{"text":"Research laboratories"},{"text":"Public-sector manufacturing facilities"}]},{"type":"h","text":"Strong internship evidence"},{"type":"p","text":"Instead of only collecting a certificate, produce:"},{"type":"list","items":[{"text":"HAZOP worksheet"},{"text":"Risk assessment"},{"text":"Safety inspection report"},{"text":"Incident investigation report"},{"text":"Emergency-response plan"},{"text":"Chemical inventory"},{"text":"PPE assessment"},{"text":"Safety audit checklist"},{"text":"Safety KPI dashboard"}]}]},{"heading":"Certifications and learning","kind":"certifications","blocks":[{"type":"table","header":["Area","Recommended learning"],"rows":[[