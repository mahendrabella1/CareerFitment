text":"4. Flat-Pack Furniture"},{"type":"p","text":"Design a product optimised for:"},{"type":"list","items":[{"text":"Easy transportation"},{"text":"Minimal packaging"},{"text":"Simple assembly"},{"text":"Efficient material usage"},{"text":"Low manufacturing cost"}]},{"type":"h","text":"Specialisation options"},{"type":"table","header":["Specialisation","Focus"],"rows":[[{"text":"Residential Furniture"},{"text":"Home furniture"}],[{"text":"Office Furniture"},{"text":"Workspaces and commercial environments"}],[{"text":"Hospitality Furniture"},{"text":"Hotels, restaurants and resorts"}],[{"text":"Luxury Furniture"},{"text":"Premium and collectible products"}],[{"text":"Ergonomic Furniture"},{"text":"Human comfort and productivity"}],[{"text":"Sustainable Furniture"},{"text":"Circular and low-impact products"}],[{"text":"Outdoor Furniture"},{"text":"Weather-resistant products"}],[{"text":"Children's Furniture"},{"text":"Safe, ergonomic products"}],[{"text":"Healthcare Furniture"},{"text":"Hospitals and care environments"}],[{"text":"Smart Furniture"},{"text":"Technology-integrated products"}],[{"text":"Custom Furniture"},{"text":"Bespoke/high-end furniture"}],[{"text":"Modular Furniture"},{"text":"Flexible and reconfigurable systems"}]]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Furniture manufacturers"},{"text":"Furniture design studios"},{"text":"Interior design firms"},{"text":"Architecture studios"},{"text":"Product design consultancies"},{"text":"Home décor brands"},{"text":"Office furniture companies"},{"text":"Luxury furniture brands"},{"text":"Hospitality design companies"},{"text":"Manufacturing companies"},{"text":"D2C furniture brands"}]},{"type":"h","text":"Target internship roles"},{"type":"list","items":[{"text":"Furniture Design Intern"},{"text":"Product Design Intern"},{"text":"Industrial Design Intern"},{"text":"Furniture R&D Intern"},{"text":"CAD Design Intern"},{"text":"I