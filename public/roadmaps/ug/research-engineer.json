{"text":"Microcontrollers"},{"text":"Embedded systems"}]},{"type":"h","text":"Neuroscience foundations"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Neuron structure"},{"text":"Action potentials"},{"text":"Synapses"},{"text":"Brain anatomy"},{"text":"Motor cortex"},{"text":"Sensory systems"},{"text":"Neural communication"}]}]},{"heading":"Year 2 — Biomedical Signals & Systems","kind":"other","blocks":[{"type":"p","text":"This is the foundation for BCI research."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Biomedical instrumentation"},{"text":"Biosignal acquisition"},{"text":"Signal conditioning"},{"text":"Noise"},{"text":"Sampling"},{"text":"Filtering"},{"text":"Analog-to-digital conversion"}]},{"type":"h","text":"Important biosignals"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"EEG"},{"text":"ECG"},{"text":"EMG"},{"text":"EOG"},{"text":"ECoG concepts"},{"text":"Neural spike signals"},{"text":"For a BCI specialization, EEG should be a primary focus at undergraduate level because it is non-invasive and widely used in research."}]}]},{"heading":"Year 2–3 — Digital Signal Processing","kind":"other","blocks":[{"type":"p","text":"Master:"},{"type":"list","items":[{"text":"Sampling theorem"},{"text":"Fourier Transform"},{"text":"FFT"},{"text":"Digital filters"},{"text":"FIR filters"},{"text":"IIR filters"},{"text":"Band-pass filtering"},{"text":"Notch filtering"},{"text":"Spectral analysis"},{"text":"Time-frequency analysis"},{"text":"Wavelets"}]},{"type":"p","text":"EEG frequency bands:"},{"type":"table","header":["Band","Approximate Range"],"rows":[[{"text":"Delta"},{"text":"~0.5–4 Hz"}],[{"text":"Theta"},{"text":"~4–8 Hz"}],[{"text":"Alpha"},{"text":"~8–13 Hz"}],[{"text":"Beta"},{"text":"~13–30 Hz"}],[{"text":"Gamma"},{"text":"~30 Hz and above"}]]},{"type":"p","text":"These ranges are approximate and their interpretation depends on experimental context."}]},{"heading":"Year 3 — EEG Processing","kind":"other",