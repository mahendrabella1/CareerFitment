[{"text":"CNNs"},{"text":"RNNs"},{"text":"LSTMs"},{"text":"Transformers"},{"text":"Autoencoders"}]},{"type":"h","text":"BCI-specific processing"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Common Spatial Patterns (CSP)"},{"text":"Spatial filtering"},{"text":"Frequency-domain features"},{"text":"Time-domain features"},{"text":"Riemannian methods"}]},{"type":"p","text":"Pipeline:"},{"type":"flow","items":["EEG","Preprocessing","Artifact Removal","Feature Extraction","Feature Selection","ML / Deep Learning","Classification","BCI Command"]}]},{"heading":"Year 4 — Real-Time BCI Systems","kind":"other","blocks":[{"type":"p","text":"The student should learn how to move from offline research to real-time systems."},{"type":"p","text":"Architecture:"},{"type":"flow","items":["EEG Device","Data Stream","Signal Processing","Feature Extraction","ML Model","Real-Time Prediction","Application"]},{"type":"p","text":"Applications can include:"},{"type":"list","items":[{"text":"Cursor control"},{"text":"Virtual keyboard"},{"text":"Assistive interfaces"},{"text":"Neurofeedback"},{"text":"Robotic control"},{"text":"Smart-home control"},{"text":"Rehabilitation research"}]}]},{"heading":"Embedded & Hardware Skills","kind":"other","blocks":[{"type":"p","text":"A research engineer should understand the hardware layer."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Microcontrollers"},{"text":"ADC"},{"text":"DAC"},{"text":"BLE"},{"text":"USB"},{"text":"Serial communication"},{"text":"Embedded Linux"},{"text":"Real-time data acquisition"}]},{"type":"p","text":"For advanced research, understand concepts behind:"},{"type":"list","items":[{"text":"EEG amplifiers"},{"text":"electrode systems"},{"text":"dry/wet electrodes"},{"text":"wireless acquisition"},{"text":"signal synchronization"}]},{"type":"p","text":"Do not attempt to design or connect experimental neural hardware to humans without appropriate laboratory supervision, electrical safety, ethics approval, and applicable institutional protocols."}]},{"heading":"Neuro-Robotics","kind":"other","blocks":[{"type":"p","text":"A powerful specialization combines BCI with robotics."},{"type":"flow","items":["Brain Signal","BCI","Intent Recognition","Robot Command","Robotic System","Feedback"]},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Robotics"},{"text":"ROS 2"},{"text":"Robot control"},{"text":"Human-robot interaction"},{"text":"Assistive robotics"}]},{"type":"p","text":"Possible applications:"},{"type":"list","items":[{"text":"Robotic arms"},{"text":"Wheelchairs"},{"text":"Rehabilitation robots"},{"text":"Prosthetic control"}]}]},{"heading":"Major Projects","kind":"other","blocks":[{"type":"h","text":"Project 1 — EEG Signal Analysis"},{"type":"p","text":"Use a public EEG dataset and build:"},{"type":"flow","items":["Raw EEG","Filtering","Artifact Processing","Spectral Analysis","Feature Extraction","Visualization"]},{"type":"p","text":"Analyze:"},{"type":"list","items":[{"text":"frequency bands"},{"text":"channel activity"},{"text":"spectral power"},{"text":"event-related patterns"}]},{"type":"h","text":"Project 2 — Motor Imagery BCI"},{"type":"p","text":"Build a research prototype that classifies imagined left/right hand movement."},{"type":"flow","items":["EEG Dataset","Preprocessing","CSP / Feature Extraction","LDA / SVM","Left vs Right Classification"]},{"type":"p","text":"Use public datasets initially rather than collecting human data independently."},{"type":"h","text":"Project 3 — P300 BCI"},{"type":"p","text":"Build a simulated P300 speller using publicly available data."},{"type":"flow","items":["Visual Stimulus","EEG","P300 Detection","Classification","Character Selection"]},{"type":"h","text":"Project 4 — Real-Time Neurofeedback"},{"type":"p","text":"Create a non-clinical prototype that:"},{"type":"list","items":[{"text":"receives EEG data"},{"text":"extracts selected features"},{"text":"calculates a signal metric"},{"text":"displays feedbac