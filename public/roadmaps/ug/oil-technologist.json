 & FMCG Companies"},{"type":"p","text":"Useful departments:"},{"type":"list","items":[{"text":"Product development"},{"text":"Quality assurance"},{"text":"R&D"},{"text":"Process engineering"},{"text":"Food safety"}]},{"type":"h","text":"Oilseed Processing Plants"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Crushing"},{"text":"Expelling"},{"text":"Solvent extraction"},{"text":"Meal processing"},{"text":"Oil recovery"}]},{"type":"h","text":"Testing Laboratories"},{"type":"p","text":"Gain exposure to:"},{"type":"list","items":[{"text":"Oil chemistry"},{"text":"Chromatography"},{"text":"Oxidation testing"},{"text":"Quality-control procedures"}]},{"type":"h","text":"Internship Progression"},{"type":"p","text":"Year 1"},{"type":"flow","items":["Food Chemistry / QC Exposure","Year 2"]},{"type":"flow","items":["Oilseed Processing Internship","Year 3"]},{"type":"flow","items":["Edible-Oil Refining / Analytical Internship","Year 4"]},{"type":"flow","items":["Process Optimization / R&D Internship","Graduation"]},{"type":"p","text":"Oil Technologist / Process Trainee"}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"type":"p","text":"Possible roles include:"},{"type":"list","items":[{"text":"Oil Technologist"},{"text":"Junior Oil Technologist"},{"text":"Oil Processing Technologist"},{"text":"Edible Oil Technologist"},{"text":"Oil Processing Engineer"},{"text":"Process Engineer — Edible Oils"},{"text":"Production Engineer"},{"text":"Production Executive"},{"text":"Oil Refinery Technologist"},{"text":"Refining Process Engineer"},{"text":"Quality Control Executive"},{"text":"Quality Assurance Executive"},{"text":"Food Technologist"},{"text":"Food Processing Executive"},{"text":"R&D Executive — Edible Oils"},{"text":"Product Development Executive"},{"text":"Laboratory Analyst — Edible Oils"},{"text":"Process Development Associate"},{"text":"Technical Executive"},{"text":"Oil Quality Analyst"},{"text":"Food Safety Executive"},{"text":"Proces