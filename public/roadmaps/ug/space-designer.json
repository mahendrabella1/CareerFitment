"Principal Designer / Studio Founder"]},{"type":"h","text":"Experience Design Path"},{"type":"flow","items":["B.Arch","Spatial Design Intern","Experience Designer","Senior Experience Designer","Experience Design Lead","Creative Director","Experience Design Studio Founder"]}]},{"heading":"Emerging Technologies","kind":"other","blocks":[{"type":"h","text":"AI-Assisted Spatial Design"},{"type":"p","text":"AI can assist with:"},{"type":"list","items":[{"text":"Concept generation"},{"text":"Layout alternatives"},{"text":"Material exploration"},{"text":"Visualization"},{"text":"Mood boards"},{"text":"User-persona analysis"},{"text":"Design iteration"},{"text":"The designer remains responsible for function, safety, accessibility, constructability, and design quality."}]},{"type":"h","text":"VR / AR"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Client walkthroughs"},{"text":"Design reviews"},{"text":"User testing"},{"text":"Interior visualization"},{"text":"Immersive presentations"}]},{"type":"h","text":"Digital Twins"},{"type":"p","text":"Interior spaces can increasingly connect:"},{"type":"flow","items":["BIM","IoT","Sensors","Building Data"],"sep":"+"},{"type":"p","text":"to understand how spaces are actually used."},{"type":"h","text":"Computational Design"},{"type":"p","text":"Grasshopper and parametric workflows can generate spatial options based on:"},{"type":"list","items":[{"text":"Occupancy"},{"text":"Circulation"},{"text":"Daylight"},{"text":"Furniture"},{"text":"Area requirements"},{"text":"Environmental performance"}]},{"type":"h","text":"Digital Fabrication"},{"type":"p","text":"Learn about:"},{"type":"list","items":[{"text":"CNC"},{"text":"Laser cutting"},{"text":"3D printing"},{"text":"Robotic fabrication"},{"text":"Custom furniture"},{"text":"Parametric components"}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"list","items":[{"text":"B.Arch"},{"text":"+"},{"text":"Spatial Design"},{"text":"+"},{"tex