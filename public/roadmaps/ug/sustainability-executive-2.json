":"p","text":"Learn:"},{"type":"list","items":[{"text":"Sustainable procurement"},{"text":"Supplier assessment"},{"text":"Supplier ESG"},{"text":"Responsible sourcing"},{"text":"Traceability"},{"text":"Scope 3 emissions"},{"text":"Sustainable logistics"},{"text":"Packaging"},{"text":"Supplier audits"}]},{"type":"p","text":"Example workflow:"},{"type":"flow","items":["Supplier","Material","Production","Transport","Distribution","Customer","End of Life"]}]},{"heading":"Sustainability Reporting","kind":"other","blocks":[{"type":"p","text":"Learn how to prepare:"},{"type":"list","items":[{"text":"Sustainability reports"},{"text":"ESG reports"},{"text":"Environmental reports"},{"text":"KPI dashboards"},{"text":"Carbon inventories"},{"text":"Sustainability presentations"},{"text":"Management reports"}]},{"type":"p","text":"A professional report should contain:"},{"type":"list","items":[{"text":"Scope"},{"text":"Methodology"},{"text":"Data"},{"text":"KPIs"},{"text":"Performance"},{"text":"Risks"},{"text":"Initiatives"},{"text":"Targets"},{"text":"Progress"},{"text":"Limitations"}]},{"type":"p","text":"Never present estimated sustainability data as verified data."}]},{"heading":"Sustainability Analytics","kind":"other","blocks":[{"type":"h","text":"Excel"},{"type":"p","text":"Master:"},{"type":"list","items":[{"text":"XLOOKUP"},{"text":"SUMIFS"},{"text":"COUNTIFS"},{"text":"IF"},{"text":"PivotTables"},{"text":"Power Query"},{"text":"Charts"},{"text":"Data cleaning"}]},{"type":"h","text":"Power BI"},{"type":"p","text":"Build:"},{"type":"list","items":[{"text":"Energy dashboard"},{"text":"Carbon dashboard"},{"text":"Water dashboard"},{"text":"Waste dashboard"},{"text":"ESG KPI dashboard"}]},{"type":"h","text":"SQL"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"SELECT"},{"text":"WHERE"},{"text":"GROUP BY"},{"text":"JOIN"},{"text":"CASE"},{"text":"CTEs"},{"text":"Window functions"}]},{"type":"h","text":"Python"},{"type":"p","text":"Optional but valuable for:"},