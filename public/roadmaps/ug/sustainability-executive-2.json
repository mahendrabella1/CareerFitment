ata"},{"text":"Excel, Google Sheets"}],[{"text":"Analytics"},{"text":"Power BI"}],[{"text":"Database"},{"text":"SQL"}],[{"text":"Programming"},{"text":"Python — optional"}],[{"text":"GIS"},{"text":"QGIS"}],[{"text":"Project Management"},{"text":"Trello, Asana, Notion"}],[{"text":"Reporting"},{"text":"PowerPoint, Excel, BI tools"}],[{"text":"Carbon"},{"text":"GHG accounting/calculation tools"}],[{"text":"Research"},{"text":"Sustainability databases and public datasets"}]]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Corporate sustainability teams"},{"text":"ESG consulting firms"},{"text":"Environmental consulting firms"},{"text":"Renewable-energy companies"},{"text":"Sustainability departments"},{"text":"CSR teams"},{"text":"ESG data providers"},{"text":"Sustainability reporting firms"},{"text":"Climate organizations"},{"text":"Environmental NGOs"},{"text":"Circular-economy companies"},{"text":"Sustainable supply-chain teams"},{"text":"Energy companies"},{"text":"Manufacturing organizations"},{"text":"FMCG companies"},{"text":"IT/GCC sustainability teams"}]},{"type":"p","text":"Prioritize internships involving:"},{"type":"flow","items":["ESG data","sustainability reporting","environmental metrics","analytics."],"sep":"+"}]},{"heading":"Certifications & Additional Learning","kind":"certifications","blocks":[{"type":"p","text":"Useful supplementary learning:"},{"type":"list","items":[{"text":"ESG Fundamentals"},{"text":"Sustainability Management"},{"text":"GHG Accounting"},{"text":"Carbon Management"},{"text":"Climate Risk"},{"text":"Sustainability Reporting"},{"text":"Circular Economy"},{"text":"Environmental Management"},{"text":"Life-Cycle Assessment"},{"text":"Sustainable Supply Chain"},{"text":"Renewable Energy"},{"text":"Energy Management"},{"text":"GIS"},{"text":"Excel"},{"text":"Power BI"},{"text":"Data Analytics"},{"text":"Project Management"}]},{"type":"p","text":"For professional ES