nce"},{"text":"Bank reconciliation"},{"text":"Adjustments"},{"text":"Depreciation"},{"text":"Provisions"},{"text":"Accruals"},{"text":"Consolidation basics"},{"text":"Financial statement preparation"}]},{"type":"h","text":"Audit"},{"type":"list","items":[{"text":"Audit planning"},{"text":"Internal controls"},{"text":"Risk assessment"},{"text":"Audit evidence"},{"text":"Vouching"},{"text":"Verification"},{"text":"Substantive testing"},{"text":"Analytical procedures"},{"text":"Working papers"},{"text":"Audit documentation"},{"text":"Sampling"},{"text":"Audit reporting"}]},{"type":"h","text":"Tax"},{"type":"list","items":[{"text":"Income-tax fundamentals"},{"text":"GST"},{"text":"TDS/TCS"},{"text":"Tax computation"},{"text":"Tax returns"},{"text":"Tax reconciliation"},{"text":"Tax documentation"},{"text":"Tax compliance"}]},{"type":"h","text":"Professional technology"},{"type":"list","items":[{"text":"Advanced Excel"},{"text":"Power Query"},{"text":"Power BI"},{"text":"TallyPrime"},{"text":"ERP systems"},{"text":"SAP finance basics"},{"text":"SQL fundamentals"},{"text":"Data analytics"},{"text":"Audit analytics"},{"text":"AI-assisted accounting workflows"}]},{"type":"h","text":"Portfolio target"},{"type":"p","text":"Build 6 practical projects:"},{"type":"list","items":[{"text":"Complete accounting-cycle project"},{"text":"Corporate financial-statement analysis"},{"text":"GST reconciliation case"},{"text":"Income-tax computation case"},{"text":"Internal-control and audit case"},{"text":"Financial-ratio and business-performance analysis"}]},{"type":"p","text":"For each project maintain:"},{"type":"flow","items":["Problem","Accounting/tax/audit treatment","Working papers","Calculations","Findings","Professional conclusion"]},{"type":"h","text":"Specialisation"},{"type":"table","header":["Lane","Core stack","Learn from","Senior role it leads to"],"rows":[[{"text":"Statutory Audit"},{"text":"Audit + financial reporting"},{"text":"Assurance engagements"},{"text":"Audit Manag