 include:"},{"type":"list","items":[{"text":"GitHub Actions"},{"text":"Jenkins"},{"text":"GitLab CI/CD"}]}]},{"heading":"Projects to Build","kind":"other","blocks":[{"type":"p","text":"Projects are extremely important for this career."},{"type":"h","text":"Project 1 — Student Management System"},{"type":"p","text":"Build:"},{"type":"list","items":[{"text":"Login"},{"text":"Student registration"},{"text":"CRUD"},{"text":"Search"},{"text":"Database"},{"text":"REST API"},{"text":"Role-based access"}]},{"type":"p","text":"Technology:"},{"type":"flow","items":["Java/Python","SQL","REST API"],"sep":"+"},{"type":"h","text":"Project 2 — E-Commerce Backend"},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"User authentication"},{"text":"Products"},{"text":"Cart"},{"text":"Orders"},{"text":"Payments simulation"},{"text":"Search"},{"text":"Pagination"},{"text":"Database"}]},{"type":"p","text":"This demonstrates backend development."},{"type":"h","text":"Project 3 — Task Management Application"},{"type":"p","text":"Features:"},{"type":"list","items":[{"text":"User registration"},{"text":"Create tasks"},{"text":"Assign tasks"},{"text":"Status"},{"text":"Deadlines"},{"text":"Notifications"},{"text":"Dashboard"}]},{"type":"p","text":"Add:"},{"type":"list","items":[{"text":"JWT authentication"},{"text":"PostgreSQL"},{"text":"REST API"},{"text":"Docker"}]},{"type":"h","text":"Project 4 — Full-Stack Application"},{"type":"p","text":"Build:"},{"type":"flow","items":["Frontend","Backend","Database","Authentication","Deployment"],"sep":"+"},{"type":"p","text":"Example:"},{"type":"h","text":"Job Application Tracker"},{"type":"p","text":"Features:"},{"type":"list","items":[{"text":"Add job"},{"text":"Company"},{"text":"Status"},{"text":"Interview date"},{"text":"Resume"},{"text":"Notes"},{"text":"Analytics dashboard"}]},{"type":"h","text":"Project 5 — AI-Integrated Application"},{"type":"p","text":"Modern programmers should understand how to integrate AI into applications."