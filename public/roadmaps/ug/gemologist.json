"},{"text":"Specific gravity"},{"text":"Refractive index"},{"text":"Birefringence"},{"text":"Pleochroism"},{"text":"Dispersion"},{"text":"Lustre"},{"text":"Transparency"},{"text":"Cleavage"},{"text":"Fracture"}]},{"type":"h","text":"Optical properties"},{"type":"p","text":"Learn to work with:"},{"type":"list","items":[{"text":"Refractometer"},{"text":"Polariscope"},{"text":"Dichroscope"},{"text":"Spectroscope"},{"text":"Loupe"},{"text":"Microscope"},{"text":"Hydrostatic/other suitable specific-gravity methods"}]},{"type":"h","text":"Identification process"},{"type":"p","text":"Develop a systematic workflow:"},{"type":"flow","items":["Visual Observation","Colour / Transparency","Lustre / Surface Features","Loupe Examination","Optical Testing","Microscopic Examination","Reference Comparison","Identification"]},{"type":"h","text":"Year-2 project"},{"type":"p","text":"Create an Unknown Gemstone Identification Portfolio."},{"type":"p","text":"Document:"},{"type":"list","items":[{"text":"Observations"},{"text":"Test results"},{"text":"Microscopic features"},{"text":"Identification reasoning"},{"text":"Possible alternatives"},{"text":"Final conclusion"}]},{"type":"h","text":"Year 3 — Advanced Gemmology"},{"type":"p","text":"Develop professional-level gemstone knowledge."},{"type":"h","text":"Natural vs synthetic"},{"type":"p","text":"Learn to distinguish:"},{"type":"list","items":[{"text":"Natural gemstones"},{"text":"Synthetic gemstones"},{"text":"Simulants"},{"text":"Composite materials"},{"text":"Treated gemstones"}]},{"type":"h","text":"Treatments"},{"type":"p","text":"Study common treatments such as:"},{"type":"list","items":[{"text":"Heat treatment"},{"text":"Fracture filling"},{"text":"Diffusion"},{"text":"Irradiation"},{"text":"Dyeing"},{"text":"Impregnation"},{"text":"Coating"}]},{"type":"p","text":"The exact treatment possibilities vary significantly by gemstone."},{"type":"h","text":"Diamond fundamentals"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"t