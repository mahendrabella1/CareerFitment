restructuring"},{"text":"Share transfers"},{"text":"Capital restructuring"}]},{"type":"h","text":"M&A Support Workflow"},{"type":"flow","items":["Transaction Proposal","Legal / Corporate Due Diligence","Regulatory Analysis","Board Approval","Shareholder / Regulatory Process","Documentation","Filings / Approvals","Closing","Post-Transaction Compliance"]},{"type":"h","text":"Due Diligence"},{"type":"p","text":"Learn how to review:"},{"type":"list","items":[{"text":"Corporate structure"},{"text":"Shareholding"},{"text":"Directors"},{"text":"Material contracts"},{"text":"Litigation"},{"text":"Regulatory compliance"},{"text":"Charges"},{"text":"Intellectual property"},{"text":"Licenses"},{"text":"Related-party transactions"},{"text":"Statutory filings"}]},{"type":"h","text":"Due Diligence Workflow"},{"type":"flow","items":["Document Collection","Data Room Organization","Legal Review","Compliance Review","Risk Identification","Materiality Assessment","Due Diligence Report","Remediation / Transaction Decision"]},{"type":"h","text":"Corporate Documentation"},{"type":"p","text":"Build strong drafting ability for:"},{"type":"list","items":[{"text":"Board resolutions"},{"text":"Shareholder resolutions"},{"text":"Meeting notices"},{"text":"Minutes"},{"text":"Notices to regulators"},{"text":"Compliance reports"},{"text":"Corporate policies"},{"text":"Governance documents"},{"text":"Agreements and supporting corporate documents"}]},{"type":"p","text":"Learn professional drafting principles:"},{"type":"flow","items":["clear","precise","legally supported","internally consistent","properly documented"],"sep":"+"},{"type":"h","text":"Technology Skills"},{"type":"p","text":"Modern CS professionals increasingly work with digital compliance systems."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Excel"},{"text":"Advanced spreadsheets"},{"text":"Document management"},{"text":"Compliance-management software"},{"text":"Digital signatures"},{"text":"E-filing systems"},{"tex