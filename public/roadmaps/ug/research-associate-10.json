":"table","header":["Period","Primary Objective"],"rows":[[{"text":"Year 1"},{"text":"Genetics + molecular biology foundations"}],[{"text":"Year 2"},{"text":"Molecular laboratory techniques"}],[{"text":"Year 3"},{"text":"Research methods + statistics + bioinformatics"}],[{"text":"Year 4"},{"text":"Genomics/clinical research specialization"}],[{"text":"Internship"},{"text":"Work in a real research laboratory"}],[{"text":"0–2 Years"},{"text":"Research assistant/project associate experience"}],[{"text":"2–5 Years"},{"text":"Research Associate / specialized research role"}],[{"text":"5+ Years"},{"text":"Scientist / research leadership"}]]},{"type":"h","text":"Graduation Profile"},{"type":"p","text":"By graduation, the student should ideally be able to:"},{"type":"list","items":[{"text":"Explain fundamental genetic mechanisms"},{"text":"Understand molecular biology workflows"},{"text":"Perform or understand basic molecular laboratory techniques"},{"text":"Understand PCR and sequencing workflows"},{"text":"Interpret basic genetic and genomic data"},{"text":"Conduct structured literature reviews"},{"text":"Formulate research questions"},{"text":"Design basic research studies"},{"text":"Apply fundamental biostatistics"},{"text":"Use R or Python for basic biological-data analysis"},{"text":"Work with genomic databases"},{"text":"Perform basic sequence analysis"},{"text":"Maintain accurate research documentation"},{"text":"Understand research ethics"},{"text":"Prepare scientific reports"},{"text":"Present research findings"},{"text":"Work effectively in multidisciplinary research teams"}]},{"type":"h","text":"Best Overall Positioning"},{"type":"flow","items":["Medical Biotechnology","Genetics","Molecular Research","Bioinformatics","Genomics"],"sep":"+","label":"Best positioning"},{"type":"p","text":"This combination provides a strong foundation for research assistant and research associate roles, while creating pathways into genomics, molecular diagnostics, clinical research,