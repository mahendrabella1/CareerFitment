or"]},{"type":"h","text":"Urban Data Path"},{"type":"flow","items":["B.Plan","GIS / Data Intern","Urban Data Analyst","Urban Analytics Specialist","Senior Urban Data Scientist","Urban Intelligence Lead","Urban Analytics Director"]},{"type":"h","text":"Policy Path"},{"type":"flow","items":["B.Plan","Policy Research Intern","Policy Analyst","Urban Policy Researcher","Senior Policy Analyst","Urban Strategy Lead","Urban Policy Director"]}]},{"heading":"Emerging Technologies","kind":"other","blocks":[{"type":"h","text":"AI for Urban Research"},{"type":"p","text":"AI can support:"},{"type":"list","items":[{"text":"Urban-growth prediction"},{"text":"Land-use classification"},{"text":"Transport prediction"},{"text":"Document analysis"},{"text":"Policy research"},{"text":"Satellite-image analysis"},{"text":"Scenario modelling"}]},{"type":"h","text":"Geospatial AI"},{"type":"p","text":"The combination of:"},{"type":"flow","items":["GIS","Satellite Data","Machine Learning"],"sep":"+"},{"type":"p","text":"can identify:"},{"type":"list","items":[{"text":"Urban expansion"},{"text":"Informal settlements"},{"text":"Green-space loss"},{"text":"Infrastructure gaps"},{"text":"Environmental risks"}]},{"type":"h","text":"Urban Digital Twins"},{"type":"p","text":"Researchers can combine:"},{"type":"flow","items":["GIS","BIM","IoT","Real-Time Data"],"sep":"+"},{"type":"p","text":"to simulate:"},{"type":"list","items":[{"text":"Mobility"},{"text":"Energy"},{"text":"Population"},{"text":"Infrastructure"},{"text":"Climate"},{"text":"Development scenarios"}]},{"type":"h","text":"Big Urban Data"},{"type":"p","text":"Future research increasingly uses:"},{"type":"list","items":[{"text":"Mobility data"},{"text":"Satellite imagery"},{"text":"Social datasets"},{"text":"Sensor networks"},{"text":"Property datasets"},{"text":"OpenStreetMap"},{"text":"Demographic datasets"},{"text":"The researcher will increasingly need to combine traditional field research with computational analysis."}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"list","items":[{"text":"B.Plan"},{"text":"+"},{"text":"Urban & Regional Planning"},{"text":"+"},{"text":"Research Methodology"},{"text":"+"},{"text":"Statistics"},{"text":"+"},{"text":"GIS"},{"text":"+"},{"text":"Spatial Analysis"},{"text":"+"},{"text":"Urban Economics"},{"text":"+"},{"text":"Housing / Transport / Environment"},{"text":"+"},{"text":"QGIS / ArcGIS"},{"text":"+"},{"text":"Remote Sensing"},{"text":"+"},{"text":"Python"},{"text":"+"},{"text":"GeoPandas"},{"text":"+"},{"text":"SQL"},{"text":"+"},{"text":"Power BI"},{"text":"+"},{"text":"Data Visualization"},{"text":"+"},{"text":"Survey Design"},{"text":"+"},{"text":"Qualitative Research"},{"text":"+"},{"text":"Quantitative Research"},{"text":"+"},{"text":"Academic Writing"},{"text":"+"},{"text":"Policy Analysis"},{"text":"+"},{"text":"Urban Data Science"}]}]},{"heading":"Target Profile by Graduation","kind":"other","blocks":[{"type":"p","text":"A strong Urban Researcher should be able to execute:"},{"type":"flow","items":["Research Problem","Literature Review","Research Question","Research Design","Data Collection","Survey / Fieldwork","GIS & Statistical Analysis","Interpretation","Findings","Policy / Planning Implications","Research Paper","Presentation / Policy Brief"]},{"type":"p","text":"By graduation, target:"},{"type":"h","text":"3–5 substantial research projects"},{"type":"list","items":[{"text":"At least one GIS-based research study"},{"text":"One statistical/quantitative research project"},{"text":"One field-survey project"},{"text":"One housing/transport/environment study"},{"text":"One research paper or conference-quality report"},{"text":"At least one research internship"}]}]},{"heading":"Best Overall Positioning","kind":"other","blocks":[{"type":"p","text":"The strongest profile is:"},{"type":"flow","items":["B.Plan","Urban Research","GIS","Statistics","Python","Spatial Analytics","Policy Analysis"],"sep":"+"},{"type":"p","t