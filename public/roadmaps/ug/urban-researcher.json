},{"text":"Transport data"},{"text":"Land-use data"},{"text":"Environmental sensors"},{"text":"Public datasets"},{"text":"Survey datasets"}]}]},{"heading":"Qualitative Research","kind":"other","blocks":[{"type":"p","text":"Urban research isn't only about numbers."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Semi-structured interviews"},{"text":"Focus groups"},{"text":"Stakeholder interviews"},{"text":"Observation"},{"text":"Ethnographic methods"},{"text":"Content analysis"},{"text":"Thematic analysis"}]},{"type":"p","text":"Useful tools include:"},{"type":"list","items":[{"text":"NVivo"},{"text":"ATLAS.ti"},{"text":"Excel"},{"text":"Python"}]},{"type":"p","text":"A strong researcher can combine:"},{"type":"h","text":"What the data says + Why people experience it that way"}]},{"heading":"Five Recommended UG Projects","kind":"other","blocks":[{"type":"h","text":"Project 1 — Affordable Housing Research"},{"type":"p","text":"Study housing affordability in a city."},{"type":"p","text":"Analyze:"},{"type":"list","items":[{"text":"Household income"},{"text":"Rent"},{"text":"Housing prices"},{"text":"Commute distance"},{"text":"Housing supply"},{"text":"Public transport access"}]},{"type":"p","text":"Produce:"},{"type":"flow","items":["Research Paper","GIS Maps","Policy Recommendations"],"sep":"+"},{"type":"h","text":"Project 2 — Public Transport Accessibility"},{"type":"p","text":"Select a city and study accessibility to:"},{"type":"list","items":[{"text":"Metro stations"},{"text":"Bus stops"},{"text":"Employment centres"},{"text":"Schools"},{"text":"Hospitals"},{"text":"Use GIS/network analysis to identify underserved areas."}]},{"type":"h","text":"Project 3 — Urban Heat Research"},{"type":"p","text":"Combine:"},{"type":"list","items":[{"text":"Satellite imagery"},{"text":"Land-surface temperature"},{"text":"Vegetation"},{"text":"Built-up density"},{"text":"Study the relationship between urban form and heat."},{"text":"Develop climate-policy recommendations."}]},{"type":"h","text":"Project 4 — Informal Settlement Study"},{"type":"p","text":"Conduct a structured study of an informal settlement covering:"},{"type":"list","items":[{"text":"Housing"},{"text":"Infrastructure"},{"text":"Water"},{"text":"Sanitation"},{"text":"Mobility"},{"text":"Employment"},{"text":"Public services"}]},{"type":"flow","items":["Combine field surveys","GIS","interviews."],"sep":"+"},{"type":"h","text":"Project 5 — Urban Growth Research"},{"type":"p","text":"Use historical satellite imagery to analyze:"},{"type":"flow","items":["2005","2015","2025","Current"]},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Built-up expansion"},{"text":"Agricultural conversion"},{"text":"Road development"},{"text":"Population growth"},{"text":"Green-space loss"},{"text":"Then develop a future urban-growth scenario."}]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Target organizations where research is a core activity."},{"type":"h","text":"Urban Research Institutions"},{"type":"p","text":"Work on:"},{"type":"list","items":[{"text":"Urban datasets"},{"text":"Policy research"},{"text":"City studies"},{"text":"Publications"}]},{"type":"h","text":"Planning Consultancies"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Urban studies"},{"text":"Surveys"},{"text":"GIS"},{"text":"Planning reports"}]},{"type":"h","text":"Government Departments"},{"type":"p","text":"Gain exposure to:"},{"type":"list","items":[{"text":"Census/planning data"},{"text":"Development plans"},{"text":"Housing policies"},{"text":"Transport policies"}]},{"type":"h","text":"Universities & Research Labs"},{"type":"p","text":"Work on:"},{"type":"list","items":[{"text":"Research projects"},{"text":"Literature reviews"},{"text":"Field studies"},{"text":"Data analysis"}]},{"type":"h","text":"NGOs / Development Organizations"},{"type":"p","text":"Excellent for:"},{"type":"list","items":[{"text":"Housing"},{"text":"Poverty"},{"tex