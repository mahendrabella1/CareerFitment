istical inference"},{"text":"Spatial statistics"},{"text":"Remote sensing"},{"text":"Transportation data"},{"text":"Housing data"},{"text":"Environmental datasets"},{"text":"Policy analysis"},{"text":"Learn Python for data analysis."}]},{"type":"p","text":"Useful libraries:"},{"type":"list","items":[{"text":"pandas"},{"text":"NumPy"},{"text":"Matplotlib"},{"text":"GeoPandas"},{"text":"Shapely"},{"text":"Statsmodels"}]},{"type":"h","text":"Year 4 — Applied Research"},{"type":"p","text":"Work on:"},{"type":"list","items":[{"text":"Policy research"},{"text":"Urban case studies"},{"text":"Large datasets"},{"text":"Field surveys"},{"text":"Stakeholder interviews"},{"text":"Qualitative research"},{"text":"Quantitative research"},{"text":"Spatial modelling"},{"text":"Research publications"}]},{"type":"p","text":"Learn to communicate findings through:"},{"type":"list","items":[{"text":"Research papers"},{"text":"Policy briefs"},{"text":"Dashboards"},{"text":"Maps"},{"text":"Presentations"}]},{"type":"h","text":"Year 5 — Research Specialization"},{"type":"p","text":"Choose one primary specialization:"},{"type":"h","text":"Housing"},{"type":"list","items":[{"text":"Affordable housing"},{"text":"Rental housing"},{"text":"Informal settlements"},{"text":"Housing policy"}]},{"type":"h","text":"Transport"},{"type":"list","items":[{"text":"Public transport"},{"text":"Mobility"},{"text":"TOD"},{"text":"Accessibility"},{"text":"Traffic"}]},{"type":"h","text":"Environment"},{"type":"list","items":[{"text":"Urban heat"},{"text":"Air pollution"},{"text":"Water"},{"text":"Green infrastructure"},{"text":"Climate resilience"}]}]},{"heading":"Core Research Skills","kind":"other","blocks":[{"type":"h","text":"A. Research Methodology"},{"type":"p","text":"Master:"},{"type":"list","items":[{"text":"Research design"},{"text":"Literature review"},{"text":"Research questions"},{"text":"Hypothesis formulation"},{"text":"Sampling"},{"text":"Surveys"},{"text":"Interviews"},{"text":"Case studies"},{"