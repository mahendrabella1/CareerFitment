p","text":"The strongest long-term profile is:"},{"type":"flow","items":["B.Sc Agricultural Science","M.Sc Seed Science & Technology","seed-testing experience","plant genetics","laboratory skills","quality systems","modern molecular/data tools."],"sep":"+"},{"type":"table","header":["ID","Level","Category","Degree","Course","Target Career"],"rows":[[{"text":"756"},{"text":"UG"},{"text":"Science"},{"text":"B.Sc (Bachelor of Science – General / Honours)"},{"text":"Agricultural Science (B.Sc General)"},{"text":"Agronomy Assistant"}]]}]}]}