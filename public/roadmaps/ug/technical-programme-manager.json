"text":"Team capacity"},{"text":"Deliverables"},{"text":"Overall programme health"}]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"During B.Tech, target internships such as:"},{"type":"h","text":"Technical"},{"type":"list","items":[{"text":"Systems Engineering Intern"},{"text":"Software Engineering Intern"},{"text":"Cloud Engineering Intern"},{"text":"Data Engineering Intern"},{"text":"DevOps Intern"},{"text":"Product Engineering Intern"}]},{"type":"h","text":"Delivery"},{"type":"list","items":[{"text":"Technical Project Intern"},{"text":"Project Coordinator Intern"},{"text":"PMO Intern"},{"text":"Product Operations Intern"},{"text":"Engineering Operations Intern"}]},{"type":"p","text":"The best strategy is:"},{"type":"p","text":"Build engineering credibility first → move toward technical delivery leadership."}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"type":"p","text":"Strong first jobs include:"},{"type":"list","items":[{"text":"Systems Engineer"},{"text":"Software Engineer"},{"text":"Cloud Engineer"},{"text":"DevOps Engineer"},{"text":"Data Engineer"},{"text":"Product Engineer"},{"text":"Systems Analyst"},{"text":"Technical Analyst"},{"text":"Associate Technical Project Manager"},{"text":"Project Coordinator"},{"text":"PMO Analyst"},{"text":"Engineering Operations Analyst"}]},{"type":"p","text":"After gaining technical and delivery experience:"},{"type":"h","text":"Technical Project Manager → Technical Programme Manager"}]},{"heading":"Employer Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Employer Type","Important Skills"],"rows":[[{"text":"Product companies"},{"text":"Systems, software, product thinking"}],[{"text":"IT services"},{"text":"Delivery, Agile, stakeholder management"}],[{"text":"Cloud companies"},{"text":"Cloud architecture, programme execution"}],[{"text":"Automotive"},{"text":"Systems engineering, hardware/software integration"}],[{"text":"Aerospace"},{"text":"Requirements, V&V, risk, systems engineering"}],[{"text":"FinTech"},{"text":"Software, security, compliance"}],[{"text":"Telecom"},{"text":"Networks, cloud, programme management"}],[{"text":"AI companies"},{"text":"Data/ML lifecycle, infrastructure, delivery"}],[{"text":"Semiconductor"},{"text":"Hardware/software dependencies, NPI"}],[{"text":"Consulting"},{"text":"Problem solving, communication, programme governance"}]]}]},{"heading":"Certifications & Learning","kind":"certifications","blocks":[{"type":"p","text":"Useful certifications can include:"},{"type":"h","text":"Programme / Project Management"},{"type":"list","items":[{"text":"PMP — generally more relevant after gaining required professional experience"},{"text":"CAPM — suitable earlier in a career"},{"text":"PRINCE2"},{"text":"PMI-ACP"}]},{"type":"h","text":"Agile"},{"type":"list","items":[{"text":"Scrum certifications"},{"text":"SAFe certifications where relevant"}]},{"type":"h","text":"Technical"},{"type":"list","items":[{"text":"AWS certifications"},{"text":"Microsoft Azure certifications"},{"text":"Google Cloud certifications"},{"text":"Kubernetes certifications"}]},{"type":"h","text":"Quality / Process"},{"type":"list","items":[{"text":"Six Sigma Green Belt"}]},{"type":"p","text":"Certifications should support actual delivery experience, rather than replace it."}]},{"heading":"Higher Education Options","kind":"other","blocks":[{"type":"p","text":"M.Tech / M.E."},{"type":"p","text":"Possible areas:"},{"type":"list","items":[{"text":"Systems Engineering"},{"text":"Software Engineering"},{"text":"Computer Science"},{"text":"AI/ML"},{"text":"Data Engineering"},{"text":"Embedded Systems"},{"text":"Industrial Engineering"}]},{"type":"h","text":"MBA"},{"type":"p","text":"Useful for moving toward senior programme/product leadership:"},{"type":"list","items":[{"text":"Technology Management"},{"text":"Operations"},{"text":"Product Management"},{"text":"Strategy"},{"text":"Business Analytics"}]},{"type":"h","t