ensing Skills"},{"type":"h","text":"+"},{"type":"h","text":"Patient Counselling"},{"type":"h","text":"+"},{"type":"h","text":"Medication Safety"},{"type":"h","text":"+"},{"type":"h","text":"Hospital/Community Internship"},{"type":"h","text":"+"},{"type":"h","text":"Industry Exposure"},{"type":"h","text":"+"},{"type":"h","text":"Excel / Power BI"},{"type":"h","text":"+"},{"type":"h","text":"Digital Pharmacy Skills"},{"type":"h","text":"+"},{"type":"h","text":"Regulatory Awareness"},{"type":"h","text":"+"},{"type":"h","text":"AI Literacy"}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"table","header":["Category","Recommended Skills"],"rows":[[{"text":"Pharmaceutical"},{"text":"Pharmaceutics, pharmacology, medicinal chemistry"}],[{"text":"Clinical"},{"text":"Medication safety, counselling, drug interactions"}],[{"text":"Pharmacy"},{"text":"Dispensing, inventory, storage, documentation"}],[{"text":"Hospital"},{"text":"Medication distribution, reconciliation, safety"}],[{"text":"Industry"},{"text":"GMP, QA/QC, SOPs"}],[{"text":"Regulatory"},{"text":"Pharmacy and pharmaceutical regulations"}],[{"text":"Research"},{"text":"Research methodology, biostatistics"}],[{"text":"Data"},{"text":"Excel + Power BI"}],[{"text":"Digital"},{"text":"Pharmacy/ERP/QMS/LIMS systems"}],[{"text":"Communication"},{"text":"Patient and healthcare-team communication"}],[{"text":"Safety"},{"text":"ADRs, medication errors, risk management"}],[{"text":"AI"},{"text":"AI-assisted pharmacy and research workflows"}],[{"text":"Career"},{"text":"Registration + practical training + specialization"}]]}]},{"heading":"Best Overall Positioning","kind":"other","blocks":[{"type":"flow","items":["B.Pharm","Professional Registration","Hospital/Community Exposure","Medication Safety","Patient Counselling","Pharmaceutical Industry Awareness","Excel/Power BI","Pharmacovigilance/Clinical Research","Digital Pharmacy","AI Literacy"],"sep":"+"},{"type":"p","text":"This creates a well-roun