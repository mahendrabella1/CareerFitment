ext":"shifts"}]},{"type":"p","text":"Verify every operation."},{"type":"h","text":"Project 2 — UART Controller"},{"type":"h","text":"Build:"},{"type":"flow","items":["CPU/Logic","UART TX/RX","Serial Interface"]},{"type":"h","text":"Include:"},{"type":"list","items":[{"text":"baud-rate generation"},{"text":"transmit"},{"text":"receive"},{"text":"error handling"}]},{"type":"h","text":"Project 3 — FIFO"},{"type":"h","text":"Implement:"},{"type":"list","items":[{"text":"synchronous/asynchronous FIFO"},{"text":"full/empty detection"},{"text":"read/write pointers"},{"text":"overflow/underflow protection"}]},{"type":"p","text":"This introduces important hardware-design concepts."}]},{"heading":"Advanced Capstone","kind":"other","blocks":[{"type":"p","text":"Build a RISC-V-based SoC."},{"type":"h","text":"Possible architecture:"},{"type":"h","text":"┌─────────────┐"},{"type":"h","text":"│ RISC-V CPU │"},{"type":"h","text":"└──────┬──────┘"},{"type":"h","text":"│"},{"type":"h","text":"┌────────┼────────┐"},{"type":"h","text":"↓ ↓ ↓"},{"type":"h","text":"RAM UART GPIO"},{"type":"h","text":"│ │ │"},{"type":"h","text":"└────────┼────────┘"},{"type":"h","text":"Bus System"},{"type":"h","text":"FPGA"},{"type":"h","text":"Add:"},{"type":"list","items":[{"text":"pipeline"},{"text":"interrupt controller"},{"text":"timer"},{"text":"UART"},{"text":"memory"},{"text":"GPIO"},{"text":"basic cache"},{"text":"verification environment"}]},{"type":"h","text":"Then document:"},{"type":"list","items":[{"text":"architecture"},{"text":"RTL"},{"text":"simulation"},{"text":"synthesis results"},{"text":"timing"},{"text":"FPGA implementation"}]}]},{"heading":"EDA Tool Knowledge","kind":"other","blocks":[{"type":"p","text":"Industry uses specialized EDA tools."},{"type":"p","text":"Depending on your specialization, learn concepts around:"},{"type":"h","text":"RTL Design"},{"type":"list","items":[{"text":"simulation"},{"text":"synthesis"},{"text":"linting"}]},{"type":"h","text":"Verification"},{"type"