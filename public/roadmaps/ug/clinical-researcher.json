ics"},{"type":"h","text":"Informed consent"},{"type":"h","text":"Clinical documentation"},{"type":"h","text":"Data management"},{"type":"h","text":"Biostatistics"},{"type":"h","text":"Start targeting internships with:"},{"type":"h","text":"Research hospitals"},{"type":"h","text":"Universities"},{"type":"h","text":"CROs"},{"type":"h","text":"Clinical research departments"},{"type":"h","text":"Public-health institutions"},{"type":"h","text":"Research organizations"},{"type":"h","text":"Final Year — Research Professional Readiness"},{"type":"h","text":"Develop specialization in:"},{"type":"flow","items":["Clinical Research","Biostatistics","Epidemiology","Research Ethics","Clinical Data","Scientific Writing"],"sep":"+"},{"type":"h","text":"Complete:"},{"type":"h","text":"Research internship"},{"type":"h","text":"Clinical research project"},{"type":"h","text":"Statistical analysis project"},{"type":"h","text":"Research protocol"},{"type":"h","text":"Literature review"},{"type":"h","text":"Scientific poster/presentation"},{"type":"h","text":"Research paper or manuscript draft"},{"type":"h","text":"Internship / Clinical Training"},{"type":"p","text":"During BHMS clinical training, use the opportunity to understand:"},{"type":"h","text":"Patient history"},{"type":"h","text":"Clinical documentation"},{"type":"h","text":"Case records"},{"type":"h","text":"Follow-up"},{"type":"h","text":"Outcome measurement"},{"type":"h","text":"Research data collection"},{"type":"h","text":"Clinical terminology"},{"type":"h","text":"Healthcare workflows"},{"type":"p","text":"This clinical exposure becomes valuable when transitioning into research roles."},{"type":"h","text":"Core Skills"},{"type":"table","header":["Skill Area","Skills to Develop"],"rows":[[{"text":"Research Methodology"},{"text":"Study design and research protocols"}],[{"text":"Clinical Research"},{"text":"Trial operations and documentation"}],[{"text":"Biostatistics"},{"text":"Statistical analysis and interpretation"}],[{"t