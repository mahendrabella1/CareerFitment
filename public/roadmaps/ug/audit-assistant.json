d-asset testing"},{"text":"Inventory checks"},{"text":"Ratio analysis"}]},{"type":"p","text":"Produce:"},{"type":"flow","items":["Audit Working Papers","Exceptions","Findings","Management Recommendations"]},{"type":"h","text":"Project 2 — Internal Control Review"},{"type":"p","text":"Map:"},{"type":"flow","items":["Process","Risk","Control","Test","Exception","Recommendation"]},{"type":"p","text":"Cover:"},{"type":"list","items":[{"text":"Procure-to-pay"},{"text":"Order-to-cash"},{"text":"Payroll"},{"text":"Inventory"},{"text":"Cash management"}]},{"type":"h","text":"Project 3 — Audit Analytics Dashboard"},{"type":"p","text":"Use:"},{"type":"h","text":"Excel/Power BI + accounting dataset"},{"type":"p","text":"Analyse:"},{"type":"list","items":[{"text":"Duplicate payments"},{"text":"Unusual transactions"},{"text":"High-value transactions"},{"text":"Weekend transactions"},{"text":"Round-number transactions"},{"text":"Ageing receivables"},{"text":"Vendor concentration"},{"text":"Expense anomalies"}]},{"type":"p","text":"This becomes a strong portfolio piece for modern audit roles."},{"type":"h","text":"Specialisation options"},{"type":"table","header":["Specialisation","Key skills"],"rows":[[{"text":"Statutory Audit"},{"text":"Financial statements, audit standards, documentation"}],[{"text":"Internal Audit"},{"text":"Controls, risk, process improvement"}],[{"text":"Tax Audit"},{"text":"Taxation, GST, income tax"}],[{"text":"Forensic Audit"},{"text":"Fraud detection, investigation, analytics"}],[{"text":"IT Audit"},{"text":"IT controls, cybersecurity, systems"}],[{"text":"Compliance Audit"},{"text":"Regulations, policies, controls"}],[{"text":"Risk Advisory"},{"text":"Enterprise risk, controls, governance"}],[{"text":"ESG Assurance"},{"text":"Sustainability reporting, data assurance"}],[{"text":"Audit Analytics"},{"text":"Excel, SQL, Power BI, Python"}],[{"text":"GRC"},{"text":"Governance, Risk & Compliance"}]]}]},{"heading":"Internships","kind":"internships","blocks":[