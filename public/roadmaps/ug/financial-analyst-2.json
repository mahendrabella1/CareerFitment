inance"},{"type":"flow","items":["Accounting","Corporate Finance","Financial Statement Analysis"],"sep":"+"},{"type":"h","text":"Modelling"},{"type":"flow","items":["Advanced Excel","Three-Statement Modelling","DCF","Forecasting"],"sep":"+"},{"type":"h","text":"Analytics"},{"type":"flow","items":["SQL","Power BI","Python/pandas"],"sep":"+"},{"type":"h","text":"Business"},{"type":"flow","items":["Industry Analysis","KPI Analysis","Business Communication"],"sep":"+"},{"type":"h","text":"Investment"},{"type":"flow","items":["Valuation","Financial Markets","Risk"],"sep":"+"},{"type":"h","text":"Future"},{"type":"flow","items":["AI","Financial Automation","Data Engineering Fundamentals"],"sep":"+"},{"type":"h","text":"Ideal Graduate Profile"},{"type":"p","text":"By graduation, the student should be able to:"},{"type":"list","items":[{"text":"Read and analyse financial statements."},{"text":"Build a three-statement financial model."},{"text":"Prepare budgets and forecasts."},{"text":"Perform variance analysis."},{"text":"Build DCF and comparable-company valuation models."},{"text":"Use advanced Excel confidently."},{"text":"Build financial dashboards in Power BI."},{"text":"Query financial data using SQL."},{"text":"Use Python/pandas for basic financial analytics."},{"text":"Explain business KPIs to non-finance stakeholders."},{"text":"Analyse companies and industries."},{"text":"Complete a finance internship."},{"text":"Present a professional financial-analysis report."},{"text":"Use AI tools responsibly for research and modelling support."}]},{"type":"h","text":"Best Practical Path"},{"type":"flow","items":["B.Com Accounting & Finance","Accounting + Corporate Finance","Advanced Excel","Financial Statement Analysis","Financial Modelling","DCF & Valuation","Power BI","SQL","Python/pandas","Finance Internship","Junior Financial Analyst","Financial Analyst","Senior Financial Analyst","Finance/FP&A Manager","Finance Director/CFO Track"]},{"type":"flow","items":["Accounting",