ariance"},{"text":"Business-unit performance"},{"text":"Monthly trends"}]},{"type":"h","text":"Project 4 — Financial Ratio Analysis"},{"type":"p","text":"Analyse 3–5 companies from the same industry."},{"type":"p","text":"Compare:"},{"type":"list","items":[{"text":"Revenue growth"},{"text":"Margins"},{"text":"ROE"},{"text":"ROA"},{"text":"Debt"},{"text":"Liquidity"},{"text":"Cash flow"},{"text":"Valuation multiples"}]},{"type":"p","text":"Prepare an investment/business-performance report."},{"type":"h","text":"Project 5 — Automated Finance Dashboard"},{"type":"p","text":"Use:"},{"type":"flow","items":["Python","SQL","Power BI"],"sep":"+"},{"type":"p","text":"Build a pipeline:"},{"type":"flow","items":["Financial Data","SQL","Python Cleaning","KPI Calculations","Power BI Dashboard"]},{"type":"p","text":"This provides a strong differentiator for a B.Com graduate."}]},{"heading":"Important Skills","kind":"other","blocks":[{"type":"table","header":["Skill","Importance"],"rows":[[{"text":"Financial Analysis"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Accounting"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Excel"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Financial Modelling"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Corporate Finance"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Financial Statements"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Forecasting"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Valuation"},{"text":"⭐⭐⭐⭐"}],[{"text":"Power BI"},{"text":"⭐⭐⭐⭐"}],[{"text":"Business Communication"},{"text":"⭐⭐⭐⭐"}],[{"text":"SQL"},{"text":"⭐⭐⭐⭐"}],[{"text":"Economics"},{"text":"⭐⭐⭐⭐"}],[{"text":"Python"},{"text":"⭐⭐⭐"}],[{"text":"Statistics"},{"text":"⭐⭐⭐"}],[{"text":"Industry Research"},{"text":"⭐⭐⭐⭐"}]]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Start looking for internships from 2nd year, with stronger finance internships in 3rd year."},{"type":"h","text":"Target internships"},{"type":"list","items":[{"text":"Financial Analyst Intern"},{"text":"Finance Intern"},{"text":"FP&A Intern"},{"text":"Investment Research Intern"},{"text":"E