bt servicing"},{"text":"Risk assessment"},{"text":"Loan underwriting"}]},{"type":"p","text":"Progression:"},{"type":"flow","items":["Credit Analyst","Senior Credit Analyst","Credit Manager"]},{"type":"h","text":"Corporate Finance"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Capital budgeting"},{"text":"M&A"},{"text":"Treasury"},{"text":"Funding"},{"text":"Valuation"},{"text":"Strategic finance"}]},{"type":"h","text":"Financial Data Analytics"},{"type":"p","text":"Combine:"},{"type":"flow","items":["Finance","SQL","Power BI","Python"],"sep":"+"},{"type":"p","text":"Potential roles:"},{"type":"list","items":[{"text":"Financial Data Analyst"},{"text":"Finance BI Analyst"},{"text":"Business Analyst"},{"text":"Finance Analytics Analyst"},{"text":"FP&A Data Analyst"}]},{"type":"p","text":"This is one of the strongest AI-era combinations for a commerce graduate."}]},{"heading":"Postgraduate Options in India","kind":"pg_india","blocks":[{"type":"p","text":"A postgraduate degree is not mandatory for an entry-level Financial Analyst role."},{"type":"h","text":"Relevant options"},{"type":"table","header":["PG / Qualification","Best For"],"rows":[[{"text":"MBA Finance"},{"text":"Corporate finance, FP&A, banking"}],[{"text":"MBA Business Analytics"},{"text":"Finance + analytics"}],[{"text":"M.Com Finance"},{"text":"Accounting/finance"}],[{"text":"M.Sc Finance"},{"text":"Financial analysis"}],[{"text":"M.Sc Financial Economics"},{"text":"Finance/economics"}],[{"text":"MBA FinTech"},{"text":"Digital finance"}],[{"text":"CFA"},{"text":"Investment analysis"}],[{"text":"FRM"},{"text":"Risk management"}],[{"text":"CMA"},{"text":"Management accounting/corporate finance"}],[{"text":"ACCA"},{"text":"Accounting/reporting/international finance"}],[{"text":"CA"},{"text":"Accounting, audit, tax, high-level finance"}]]},{"type":"p","text":"For investment-oriented careers, CFA can be particularly relevant. For corporate finance and FP&A, MBA Finance + strong modelling experience can be useful."}]},{"heading":"Study Abroad","kind":"abroad","blocks":[{"type":"p","text":"Relevant master's programmes include:"},{"type":"list","items":[{"text":"MSc Finance"},{"text":"MSc Financial Analysis"},{"text":"MSc Financial Economics"},{"text":"MSc Accounting & Finance"},{"text":"MSc Investment Management"},{"text":"MSc Business Analytics"},{"text":"MSc Financial Engineering"},{"text":"MSc FinTech"},{"text":"MSc Risk Management"}]},{"type":"p","text":"Potential destinations:"},{"type":"list","items":[{"text":"UK"},{"text":"USA"},{"text":"Canada"},{"text":"Ireland"},{"text":"Australia"},{"text":"Germany"},{"text":"Netherlands"},{"text":"Singapore"}]},{"type":"p","text":"For highly quantitative finance programmes, stronger mathematics, statistics and programming preparation may be required."}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"Corporate Finance / FP&A"},{"type":"h","text":"Finance Intern"},{"type":"h","text":"Junior Financial Analyst"},{"type":"h","text":"Financial Analyst"},{"type":"h","text":"Senior Financial Analyst"},{"type":"h","text":"Finance Manager / FP&A Manager"},{"type":"h","text":"Senior Finance Manager"},{"type":"h","text":"Finance Director"},{"type":"h","text":"VP Finance / CFO"},{"type":"h","text":"Investment Analysis"},{"type":"h","text":"Research Intern"},{"type":"h","text":"Research Associate"},{"type":"h","text":"Investment Analyst"},{"type":"h","text":"Senior Analyst"},{"type":"h","text":"Portfolio/Research Manager"},{"type":"h","text":"Investment Director"},{"type":"h","text":"Financial Analytics"},{"type":"h","text":"Finance Data Analyst"},{"type":"h","text":"Senior Financial Data Analyst"},{"type":"h","text":"Finance Analytics Manager"},{"type":"h","text":"Head of Finance Analytics"},{"type":"h","text":"Finance Transformation / Analytics Director"}]},{"heading":"AI-Era Financial Analyst","kind":"other","blocks":[{"type":"p","text":"AI will automate many repetitive finance tasks:"},{