:"},{"type":"h","text":"Classroom communication"},{"type":"list","items":[{"text":"Clear explanation"},{"text":"Storytelling"},{"text":"Questioning"},{"text":"Active listening"},{"text":"Demonstration"},{"text":"Feedback"}]},{"type":"h","text":"Professional communication"},{"type":"list","items":[{"text":"Parent meetings"},{"text":"Teacher collaboration"},{"text":"School administration"},{"text":"Student mentoring"},{"text":"Community interaction"}]},{"type":"h","text":"Communication principle"},{"type":"flow","items":["Explain","Ask","Listen","Check understanding","Adapt"]}]},{"heading":"Projects During Integrated Teacher Education","kind":"other","blocks":[{"type":"h","text":"Project 1 — Digital Lesson Portfolio"},{"type":"p","text":"Create 20–30 lessons for the intended teaching subject."},{"type":"p","text":"Each lesson should include:"},{"type":"list","items":[{"text":"Learning objectives"},{"text":"Teaching strategy"},{"text":"Activity"},{"text":"Assessment"},{"text":"Differentiation"},{"text":"Homework/extension"}]},{"type":"h","text":"Project 2 — Student Learning Dashboard"},{"type":"p","text":"Using synthetic data, build an Excel/Power BI dashboard covering:"},{"type":"list","items":[{"text":"Attendance"},{"text":"Assessment scores"},{"text":"Topic performance"},{"text":"Learning gaps"},{"text":"Remedial progress"}]},{"type":"h","text":"Project 3 — Teaching-Learning Material Portfolio"},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"Infographics"},{"text":"Worksheets"},{"text":"Concept maps"},{"text":"Flashcards"},{"text":"Interactive presentations"},{"text":"Subject-specific activities"}]},{"type":"h","text":"Project 4 — Action Research"},{"type":"p","text":"Example:"},{"type":"h","text":"“Effect of activity-based learning on student participation in science.”"},{"type":"flow","items":["Problem","Research Question","Baseline Assessment","Teaching Intervention","Post-Assessment","Analysis","Conclusion"]},{"type":"h","text":"Project 5 — Incl