,{"text":"Manual/automatic modes"},{"text":"PID fundamentals"}]},{"type":"h","text":"Project 3 — Robotic Pick-and-Place Cell"},{"type":"p","text":"Integrate:"},{"type":"list","items":[{"text":"Industrial/simulated robot"},{"text":"PLC"},{"text":"Sensors"},{"text":"Conveyor"},{"text":"End-effector"},{"text":"HMI"}]},{"type":"p","text":"Sequence:"},{"type":"flow","items":["Part Detection","Robot Request","Pick","Move","Place","Confirmation","Next Cycle"]}]},{"heading":"Advanced Capstone Project","kind":"other","blocks":[{"type":"h","text":"Smart Automated Manufacturing Cell"},{"type":"p","text":"Build a complete simulated or physical production cell."},{"type":"h","text":"System"},{"type":"flow","items":["Conveyor","Vision Inspection","Robot","CNC/Process Station","Quality Inspection","Sorting","Dashboard"]},{"type":"p","text":"Integrate:"},{"type":"list","items":[{"text":"PLC"},{"text":"HMI"},{"text":"SCADA"},{"text":"Robot"},{"text":"Sensors"},{"text":"Machine vision"},{"text":"Industrial communication"},{"text":"Safety logic"},{"text":"Production database"},{"text":"OEE dashboard"}]},{"type":"h","text":"Deliverables"},{"type":"list","items":[{"text":"System architecture"},{"text":"Electrical/control diagram"},{"text":"PLC program"},{"text":"HMI screens"},{"text":"Robot program"},{"text":"Communication configuration"},{"text":"Safety design"},{"text":"Production dashboard"},{"text":"Fault-handling logic"},{"text":"Performance analysis"}]},{"type":"p","text":"This demonstrates actual automation-system integration, which is the central competency for this career."}]},{"heading":"Choose a Specialization","kind":"other","blocks":[{"type":"table","header":["Specialization","Additional Skills","Potential Roles"],"rows":[[{"text":"PLC Automation"},{"text":"PLC, HMI, SCADA"},{"text":"PLC/Automation Engineer"}],[{"text":"Industrial Robotics"},{"text":"Robot programming, PLC integration"},{"text":"Robotics Automation Engineer"}],[{"text":"Process Automation"},{"text":"DCS, in