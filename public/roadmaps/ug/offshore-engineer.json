,{"text":"Environmental protection"},{"text":"Incident investigation"}]},{"type":"p","text":"Understand concepts related to:"},{"type":"list","items":[{"text":"HAZID"},{"text":"HAZOP"},{"text":"Bow-tie analysis"},{"text":"ALARP"},{"text":"Emergency Response Plans"},{"text":"Safety Management Systems"}]}]},{"heading":"Offshore Engineering Software & Digital Tools","kind":"other","blocks":[{"type":"h","text":"Engineering"},{"type":"list","items":[{"text":"AutoCAD"},{"text":"SolidWorks"},{"text":"ANSYS"},{"text":"MATLAB"},{"text":"EES"}]},{"type":"h","text":"Maintenance & Operations"},{"type":"list","items":[{"text":"SAP PM"},{"text":"IBM Maximo"},{"text":"CMMS platforms"},{"text":"Asset Management Systems"}]},{"type":"h","text":"Data & Analytics"},{"type":"list","items":[{"text":"Excel"},{"text":"Power BI"},{"text":"Python"},{"text":"SQL"}]},{"type":"h","text":"Offshore/Marine Tools"},{"type":"p","text":"Depending on specialization:"},{"type":"list","items":[{"text":"OrcaFlex"},{"text":"DNV software"},{"text":"MOSES"},{"text":"ANSYS AQWA"},{"text":"Marine/offshore simulation tools"}]},{"type":"p","text":"The exact software stack varies considerably by employer and engineering discipline."}]},{"heading":"Projects to Build","kind":"other","blocks":[{"type":"h","text":"Project 1 — Offshore Equipment Reliability Analysis"},{"type":"p","text":"Select a pump, compressor or marine engine and analyze:"},{"type":"list","items":[{"text":"Failure modes"},{"text":"Causes"},{"text":"Effects"},{"text":"Maintenance requirements"},{"text":"Criticality"},{"text":"MTBF"},{"text":"MTTR"},{"text":"Preventive maintenance strategy"}]},{"type":"note","label":"Output","text":"Reliability engineering report."},{"type":"h","text":"Project 2 — Offshore Machinery Condition Monitoring"},{"type":"p","text":"Develop a system using sensor/data inputs to monitor:"},{"type":"list","items":[{"text":"Temperature"},{"text":"Pressure"},{"text":"Vibration"},{"text":"RPM"},{"text":"Energy consumption"}]},{"type":"p","text":"Use:"},{"type":"h","text":"Python + Excel/Power BI"},{"type":"p","text":"to identify abnormal operating conditions."},{"type":"h","text":"Project 3 — Offshore HSE Risk Assessment"},{"type":"p","text":"Perform a risk assessment for an offshore activity such as:"},{"type":"list","items":[{"text":"Pump maintenance"},{"text":"Crane operation"},{"text":"Fuel transfer"},{"text":"Confined-space entry"},{"text":"High-pressure equipment maintenance"}]},{"type":"p","text":"Create:"},{"type":"flow","items":["Hazard","Risk","Control","Residual Risk","Emergency Action"]}]},{"heading":"Advanced Capstone Project","kind":"other","blocks":[{"type":"h","text":"Smart Offshore Asset Monitoring & Maintenance System"},{"type":"p","text":"Build an integrated digital system for offshore machinery."},{"type":"h","text":"Components"},{"type":"h","text":"Sensors/Data"},{"type":"h","text":"Equipment Monitoring"},{"type":"h","text":"Condition Analysis"},{"type":"h","text":"Failure Prediction"},{"type":"h","text":"Maintenance Alert"},{"type":"h","text":"Maintenance Planning"},{"type":"h","text":"Performance Dashboard"},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Equipment health score"},{"text":"Vibration trends"},{"text":"Temperature trends"},{"text":"Failure prediction"},{"text":"Maintenance history"},{"text":"Spare-parts requirements"},{"text":"Asset criticality"},{"text":"Power consumption"}]},{"type":"flow","items":["This creates a strong combination of Marine Engineering","Reliability","IoT","Data Analytics."],"sep":"+"}]},{"heading":"Specialization Choices","kind":"other","blocks":[{"type":"table","header":["Specialization","Main Focus"],"rows":[[{"text":"Offshore Mechanical Engineering"},{"text":"Machinery and mechanical systems"}],[{"text":"Marine Machinery"},{"text":"Engines, pumps, compressors and auxiliaries"}],[{"text":"Offshore Maintenance"},{"text":"Maintenance and asset reliability"}],[{"text":"Reliability Engineering"},{"text":"Failure prevention and equipment performance"}],[{"text":"Offshore HSE"},{"text":"Safety and risk management"}],[{"text":"Offshore Production"},{"text":"Production facilities and process systems"}],[{"text":"FPSO Engineering"},{"text":"Floating production facilities"}],[{"text":"Offshore Utilities"},{"text":"Power, HVAC, water and support systems"}],[{"text":"Subsea Engineering"},{"text":"Subsea equipment and infrastructure"}],[{"text":"Offshore Structural Engineering"},{"text":"Platforms and structural systems"}],[{"text":"Drilling Engineering"},{"text":"Drilling systems and operations"}],[{"text":"Offshore Energy"},{"text":"Offshore wind and emerging energy systems"}],[{"text":"Digital Offshore Engineering"},{"text":"IoT, AI, digital twins and analytics"}]]}]},{"heading":"Internship Roadmap","kind":"internships","blocks":[{"type":"p","text":"Target internships with:"},{"type":"list","items":[{"text":"Offshore oil & gas companies"},{"text":"Marine engineering companies"},{"text":"Shipyards"},{"text":"Offshore drilling companies"},{"text":"FPSO operators"},{"text":"Offshore EPC companies"},{"text":"Marine equipment manufacturers"},{"text":"Power-generation companies"},{"text":"Offshore maintenance companies"},{"text":"Classification/survey organizations"},{"text":"Offshore renewable-energy companies"}]},{"type":"p","text":"Try to obtain exposure to:"},{"type":"list","items":[{"text":"Machinery maintenance"},{"text":"Equipment inspection"},{"text":"Preventive maintenance"},{"text":"Condition monitoring"},{"text":"HSE"},{"text":"Reliability"},{"text":"Technical documentation"},{"text":"Asset management"}]}]},{"heading":"Certifications & Professional Learning","kind":"certifications","blocks":[{"type":"p","text":"Useful supplementary certifications include:"},{"type":"list","items":[{"text":"NEBOSH"},{"text":"IOSH"},{"text":"HSE fundamentals"},{"text":"Industrial safety"},{"text":"Risk assessment"},{"text":"HAZOP"},{"text":"HAZID"},{"text":"FMEA"},{"text":"Reliability engineering"},{"text":"Vibration analysis"},{"text":"Condition monitoring"},{"text":"NDT fundamentals"},{"text":"SAP PM"},{"text":"IBM Maximo"},{"text":"Advanced Excel"},{"text":"Power BI"}]},{"type":"p","text":"For offshore deployments, employers may also require specific offshore safety, medical fitness and survival training, depending on country, facility and job."},{"type":"p","text":"These requirements should be checked against the employer and destination before enrollment."}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"type":"p","text":"After graduation, possible roles include:"},{"type":"list","items":[{"text":"Offshore Engineer"},{"text":"Junior Offshore Engineer"},{"text":"Marine Engineer"},{"text":"Marine Maintenance Engineer"},{"text":"Mechanical Engineer"},{"text":"Offshore Maintenance Engineer"},{"text":"Reliability Engineer"},{"text":"Equipment Engineer"},{"text":"Rotating Equipment Engineer"},{"text":"Maintenance Planner"},{"text":"Asset Management Engineer"},{"text":"HSE Engineer"},{"text":"Offshore Operations Engineer"},{"text":"Field Service Engineer"},{"text":"Marine Technical Superintendent — typically after relevant experience"}]}]},{"heading":"Postgraduate Study in India","kind":"pg_india","blocks":[{"type":"p","text":"Relevant options include:"},{"type":"h","text":"Engineering"},{"type":"list","items":[{"text":"M.Tech Marine Engineering"},{"text":"M.Tech Ocean Engineering"},{"text":"M.Tech Offshore Engineering"},{"text":"M.Tech Mechanical Engineering"},{"text":"M.Tech Energy Engineering"},{"text":"M.Tech Industrial Engineering"},{"text":"M.Tech Reliability Engineering"}]},{"type":"h","text":"Management"},{"type":"p","text":"After gaining industry experience:"},{"type":"list","items":[{"text":"MBA Operations"},{"text":"MBA Supply Chain Management"},{"text":"MBA Energy Management"},{"text":"MBA Project Management"}]},{"type":"p","text":"For a Marine Engineering graduate targeting offshore machinery, Mechanical/Offshore/Ocean Engine