shore HSE risk assessment"},{"text":"Smart offshore asset monitoring capstone"},{"text":"Marine/offshore industry internship"},{"text":"Advanced Excel + Power BI"},{"text":"Basic Python/SQL"},{"text":"Maintenance/reliability knowledge"},{"text":"Strong HSE fundamentals"},{"text":"Understanding of offshore machinery and operations"}]},{"type":"h","text":"Target Graduate Profile"},{"type":"flow","items":["B.Tech Marine Engineering","Marine Machinery","Offshore Systems","Maintenance & Reliability","HSE","Offshore Operations","Digital Asset Management","Offshore Engineer","Senior/Lead Offshore Engineer","Engineering/Asset Management Leadership"]},{"type":"table","header":["253","UG","Engineering & Technology","B.Tech / B.E. (Bachelor of Technology / Engineering)","Naval Architecture & Ship Building","Naval Architect",""],"rows":[]}]}]}