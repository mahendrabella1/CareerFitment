":"p","text":"Explore ecosystems from:"},{"type":"list","items":[{"text":"Siemens"},{"text":"Schneider Electric"},{"text":"Rockwell Automation"},{"text":"ABB"}]}]},{"heading":"Renewable Energy","kind":"other","blocks":[{"type":"p","text":"A useful modern specialization is renewable-energy engineering."},{"type":"h","text":"Solar"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"PV modules"},{"text":"string sizing"},{"text":"inverters"},{"text":"DC/AC protection"},{"text":"grounding"},{"text":"grid connection"}]},{"type":"h","text":"Wind"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"generators"},{"text":"power conversion"},{"text":"grid integration"}]},{"type":"h","text":"Energy Storage"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"batteries"},{"text":"BMS"},{"text":"inverters"},{"text":"energy-management systems"}]}]},{"heading":"EV & Electrification","kind":"other","blocks":[{"type":"p","text":"Electric vehicles create opportunities for electrical engineers."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"EV motors"},{"text":"motor drives"},{"text":"battery systems"},{"text":"BMS concepts"},{"text":"DC fast charging"},{"text":"AC charging"},{"text":"charging infrastructure"},{"text":"power electronics"},{"text":"thermal considerations"}]},{"type":"p","text":"Possible specialization:"},{"type":"h","text":"Electrical Engineer → EV Systems Engineer"}]},{"heading":"Projects to Build","kind":"other","blocks":[{"type":"h","text":"Project 1 — Three-Phase Power Analysis"},{"type":"p","text":"Build a simulation that calculates:"},{"type":"list","items":[{"text":"voltage"},{"text":"current"},{"text":"real power"},{"text":"reactive power"},{"text":"apparent power"},{"text":"power factor"}]},{"type":"p","text":"Test different loads and power-factor conditions."},{"type":"h","text":"Project 2 — Motor Control"},{"type":"p","text":"Build a simulated or hardware-based:"},{"type":"flow","items":["Three-Phase Motor","Starter","Protection","Control"]},{"type":"p","text":"Explore:"},{"type":"list","items":[{"text":"DOL"},{"text":"star-delta"},{"text":"VFD control"}]},{"type":"h","text":"Project 3 — Solar PV System"},{"type":"p","text":"Design a small grid-connected solar system."},{"type":"p","text":"Calculate:"},{"type":"list","items":[{"text":"required capacity"},{"text":"panel configuration"},{"text":"inverter size"},{"text":"cable size"},{"text":"protection"},{"text":"estimated energy generation"}]}]},{"heading":"Advanced Capstone","kind":"other","blocks":[{"type":"p","text":"Build a Smart Microgrid / Energy Management System."},{"type":"p","text":"Example architecture:"},{"type":"flow","items":["Solar PV ─────┐","Battery ──→ Energy Management System","Grid ───────→ Distribution","Industrial / EV Loads"]},{"type":"p","text":"Add:"},{"type":"list","items":[{"text":"load forecasting"},{"text":"battery management"},{"text":"solar generation monitoring"},{"text":"grid import/export"},{"text":"power-quality monitoring"},{"text":"automatic load management"},{"text":"dashboard"}]},{"type":"p","text":"Optional:"},{"type":"h","text":"Python/ML → Load Forecasting"},{"type":"p","text":"This combines traditional electrical engineering with modern digital skills."}]},{"heading":"Software & Tools","kind":"other","blocks":[{"type":"h","text":"Essential"},{"type":"list","items":[{"text":"MATLAB/Simulink"},{"text":"AutoCAD"},{"text":"Excel"},{"text":"LTspice"},{"text":"Python"}]},{"type":"h","text":"Power Systems"},{"type":"p","text":"Explore:"},{"type":"list","items":[{"text":"ETAP"},{"text":"DIgSILENT PowerFactory"},{"text":"PSCAD"}]},{"type":"h","text":"Automation"},{"type":"p","text":"Explore:"},{"type":"list","items":[{"text":"Siemens TIA Portal"},{"text":"Rockwell Studio 5000"},{"text":"Schneider EcoStruxure"}]},{"type":"h","text":"Electrical Design"},{"type":"p","text":"Explore:"},{"type":"list","items":[{"text":"AutoCAD Electrical"},{"text":"EPLAN"},{"text":"Revit MEP"}]}]},{"head