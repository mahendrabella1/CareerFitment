":"flow","items":["Revenue","Costs","EBITDA","EBIT","Taxes","Net Income","Cash Flow","Balance Sheet","Valuation"]}]},{"heading":"Valuation","kind":"other","blocks":[{"type":"p","text":"Learn:"},{"type":"h","text":"DCF"},{"type":"flow","items":["Revenue forecast","EBIT","Tax","NOPAT","D&A","Capex","Working Capital","Free Cash Flow","Discounting","Enterprise Value","Equity Value"]},{"type":"h","text":"Comparable companies"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"P/E"},{"text":"EV/EBITDA"},{"text":"EV/Sales"},{"text":"P/B"},{"text":"PEG"}]},{"type":"h","text":"Precedent transactions"},{"type":"p","text":"Understand how acquisition multiples are used."},{"type":"h","text":"Valuation sensitivity"},{"type":"p","text":"Test:"},{"type":"list","items":[{"text":"Revenue growth"},{"text":"EBITDA margin"},{"text":"WACC"},{"text":"Terminal growth"},{"text":"Exit multiple"}]}]},{"heading":"Financial markets","kind":"other","blocks":[{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Equity markets"},{"text":"Bonds"},{"text":"Mutual funds"},{"text":"ETFs"},{"text":"Derivatives"},{"text":"Commodities"},{"text":"Foreign exchange"},{"text":"Interest-rate markets"},{"text":"Money markets"},{"text":"Primary vs secondary markets"},{"text":"IPOs"},{"text":"Corporate bonds"},{"text":"Government securities"}]},{"type":"p","text":"For India, understand the roles of:"},{"type":"list","items":[{"text":"RBI"},{"text":"SEBI"},{"text":"Stock exchanges"},{"text":"Depositories"},{"text":"Mutual-fund industry"},{"text":"Banks"},{"text":"NBFCs"},{"text":"Insurance companies"}]},{"type":"p","text":"RBI","url":"https://www.rbi.org.in/"},{"type":"p","text":"SEBI","url":"https://www.sebi.gov.in/"}]},{"heading":"Data analytics","kind":"other","blocks":[{"type":"h","text":"Excel"},{"type":"p","text":"Required."},{"type":"h","text":"Power BI"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Financial dashboards"},{"text":"Budget vs actual"},{"text":