:"Customer Success Intern"}]},{"type":"h","text":"Strong Internship Project"},{"type":"h","text":"Customer Discovery → Business Growth Project"},{"type":"p","text":"Choose a real business problem."},{"type":"h","text":"Step 1 — Customer research"},{"type":"p","text":"Interview potential customers."},{"type":"p","text":"Collect:"},{"type":"list","items":[{"text":"Problems"},{"text":"Current solutions"},{"text":"Spending"},{"text":"Pain points"},{"text":"Buying process"},{"text":"Decision makers"}]},{"type":"h","text":"Step 2 — Define ICP"},{"type":"p","text":"Identify:"},{"type":"list","items":[{"text":"Industry"},{"text":"Company size"},{"text":"Geography"},{"text":"Customer type"},{"text":"Buying role"}]},{"type":"h","text":"Step 3 — Value proposition"},{"type":"p","text":"Define:"},{"type":"h","text":"Customer problem"},{"type":"flow","items":["Solution","Business benefit"]},{"type":"h","text":"Step 4 — Build sales pipeline"},{"type":"p","text":"Create:"},{"type":"list","items":[{"text":"100 target accounts"},{"text":"Contact database"},{"text":"Outreach sequence"},{"text":"CRM pipeline"}]},{"type":"h","text":"Step 5 — Measure"},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Outreach"},{"text":"Responses"},{"text":"Meetings"},{"text":"Qualified leads"},{"text":"Proposals"},{"text":"Conversions"}]},{"type":"h","text":"Step 6 — Improve"},{"type":"p","text":"Analyse where prospects drop out."},{"type":"flow","items":["This demonstrates design thinking","sales","analytics","business development."],"sep":"+"}]},{"heading":"Certifications and Learning","kind":"certifications","blocks":[{"type":"p","text":"Useful areas include:"},{"type":"h","text":"Sales"},{"type":"list","items":[{"text":"B2B sales"},{"text":"Consultative selling"},{"text":"Account management"},{"text":"Negotiation"}]},{"type":"h","text":"Business Development"},{"type":"list","items":[{"text":"Business strategy"},{"text":"Partnerships"},{"text":"Market research"},{"text":"Go-to-market str