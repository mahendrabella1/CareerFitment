 you respond to a customer saying the price is too high?"}]},{"type":"h","text":"Customer Discovery"},{"type":"list","items":[{"text":"How would you identify a customer's real problem?"},{"text":"What questions would you ask during a discovery call?"},{"text":"How would you validate a business idea?"},{"text":"How would you identify an ideal customer profile?"}]},{"type":"h","text":"Strategy"},{"type":"list","items":[{"text":"How would you enter a new market?"},{"text":"How would you evaluate a potential business partner?"},{"text":"How would you create a go-to-market strategy?"},{"text":"How would you compete against an established company?"}]},{"type":"h","text":"Analytics"},{"type":"list","items":[{"text":"Which sales KPIs would you track?"},{"text":"What is conversion rate?"},{"text":"What is CAC?"},{"text":"How would you improve a low-performing sales funnel?"},{"text":"How would you forecast sales?"}]},{"type":"h","text":"Innovation"},{"type":"list","items":[{"text":"How would design thinking improve business development?"}]}]},{"heading":"Postgraduate Study in India","kind":"pg_india","blocks":[{"type":"p","text":"Relevant options include:"},{"type":"h","text":"MBA"},{"type":"list","items":[{"text":"MBA Marketing"},{"text":"MBA Sales & Marketing"},{"text":"MBA Entrepreneurship"},{"text":"MBA Strategy"},{"text":"MBA Business Analytics"},{"text":"MBA International Business"}]},{"type":"h","text":"Other options"},{"type":"list","items":[{"text":"PGDM Marketing"},{"text":"PGDM Entrepreneurship"},{"text":"PGDM Business Development"},{"text":"PGDM International Business"}]},{"type":"p","text":"An MBA becomes more valuable when targeting strategic BD, enterprise sales, consulting, partnerships, or senior management."},{"type":"h","text":"Government / Public-Sector Route"},{"type":"p","text":"Relevant areas can include:"},{"type":"list","items":[{"text":"Public-sector business development"},{"text":"Government enterprise marketing"},{"text":"Institutional partnership