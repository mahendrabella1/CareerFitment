t":"Clinical Research Fundamentals"},{"text":"Advanced"}],[{"text":"Clinical Trial Operations"},{"text":"Advanced"}],[{"text":"GCP Principles"},{"text":"Advanced"}],[{"text":"Research Ethics"},{"text":"Advanced"}],[{"text":"Protocol Understanding"},{"text":"Advanced"}],[{"text":"Informed Consent Workflow"},{"text":"Advanced"}],[{"text":"Clinical Documentation"},{"text":"Advanced"}],[{"text":"Participant Coordination"},{"text":"Advanced"}],[{"text":"EDC Systems"},{"text":"Advanced"}],[{"text":"Data Management"},{"text":"Intermediate–Advanced"}],[{"text":"Pharmacovigilance Awareness"},{"text":"Intermediate–Advanced"}],[{"text":"Medical Terminology"},{"text":"Advanced"}],[{"text":"Excel"},{"text":"Advanced"}],[{"text":"Statistics"},{"text":"Intermediate–Advanced"}],[{"text":"Scientific Writing"},{"text":"Advanced"}],[{"text":"Communication"},{"text":"Advanced"}],[{"text":"Project Coordination"},{"text":"Advanced"}]]}]},{"heading":"Clinical Trial Workflow","kind":"other","blocks":[{"type":"p","text":"A CRC should understand the complete study lifecycle:"},{"type":"flow","items":["Study Protocol","Ethics / Regulatory Approval","Site Activation","Participant Identification","Screening","Informed Consent","Enrollment","Study Visits","Data Collection","Safety Reporting","Follow-Up","Database Completion","Study Close-Out"]}]},{"heading":"Informed Consent","kind":"other","blocks":[{"type":"p","text":"Understand the principles of:"},{"type":"list","items":[{"text":"Voluntary participation"},{"text":"Participant understanding"},{"text":"Risks and benefits"},{"text":"Alternatives"},{"text":"Confidentiality"},{"text":"Right to withdraw"},{"text":"Documentation"}]},{"type":"p","text":"A CRC may support the consent process according to the study's delegation and institutional requirements, but consent should be obtained by appropriately authorized study personnel."}]},{"heading":"Protocol Compliance","kind":"other","blocks":[{"type":"p","text":"Learn to identify:"},{"type":"list","