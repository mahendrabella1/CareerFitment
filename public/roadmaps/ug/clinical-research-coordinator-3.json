ng to applicable GCP and institutional requirements."}]},{"heading":"Safety & Adverse Events","kind":"other","blocks":[{"type":"p","text":"Understand the difference between:"},{"type":"list","items":[{"text":"Adverse Event"},{"text":"Serious Adverse Event"},{"text":"Adverse Drug Reaction"},{"text":"Suspected unexpected serious adverse reaction concepts"}]},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Identification"},{"text":"Documentation"},{"text":"Initial assessment workflow"},{"text":"Reporting timelines"},{"text":"Escalation"},{"text":"Follow-up information"}]},{"type":"p","text":"The CRC supports documentation and escalation according to protocol; medical causality and clinical management remain with qualified investigators/clinicians."}]},{"heading":"Statistics & Research Skills","kind":"other","blocks":[{"type":"p","text":"Develop practical knowledge of:"},{"type":"h","text":"Statistics"},{"type":"list","items":[{"text":"Mean"},{"text":"Median"},{"text":"Standard deviation"},{"text":"Variance"},{"text":"Confidence intervals"},{"text":"p-values"},{"text":"Correlation"},{"text":"Basic regression"},{"text":"Sample size concepts"}]},{"type":"h","text":"Research"},{"type":"list","items":[{"text":"Literature review"},{"text":"PubMed searching"},{"text":"Evidence appraisal"},{"text":"Research question formulation"},{"text":"Data collection"},{"text":"Scientific writing"}]},{"type":"h","text":"Tools"},{"type":"list","items":[{"text":"Excel"},{"text":"SPSS or similar statistical software"},{"text":"R basics"},{"text":"Power BI"},{"text":"Reference managers"}]}]},{"heading":"Projects During UG","kind":"build","blocks":[{"type":"h","text":"Project 1 — Clinical Trial Management Dashboard"},{"type":"p","text":"Create a dashboard tracking:"},{"type":"list","items":[{"text":"Patients screened"},{"text":"Eligible participants"},{"text":"Enrolled participants"},{"text":"Screen failures"},{"text":"Visit completion"},{"text":"Protocol deviations"},{"text":"Dropouts"},{"text":"Adverse events"}]},{"type":"p","text":"Tools:"},{"type":"h","text":"Excel / Power BI"},{"type":"h","text":"Project 2 — Clinical Trial Workflow"},{"type":"p","text":"Design a complete trial workflow:"},{"type":"flow","items":["Protocol","Ethics Approval","Site Activation","Screening","Consent","Enrollment","Study Visits","Data Entry","Safety Reporting","Close-Out"]},{"type":"h","text":"Project 3 — Research Data Management System"},{"type":"p","text":"Build a simulated database containing:"},{"type":"list","items":[{"text":"Participant ID"},{"text":"Visit"},{"text":"Study arm"},{"text":"Assessment"},{"text":"Laboratory data"},{"text":"Adverse events"},{"text":"Follow-up"},{"text":"Status"}]},{"type":"p","text":"Use anonymized/synthetic data only."},{"type":"h","text":"Project 4 — Literature Review"},{"type":"p","text":"Choose a clinical research topic and perform:"},{"type":"list","items":[{"text":"Literature search"},{"text":"Article screening"},{"text":"Evidence extraction"},{"text":"Reference management"},{"text":"Structured review"}]},{"type":"h","text":"Project 5 — Protocol Deviation Tracker"},{"type":"p","text":"Create a tracker containing:"},{"type":"table","header":["Participant","Visit","Deviation","Impact","Corrective Action","Status"],"rows":[]},{"type":"p","text":"This demonstrates practical study-coordination thinking."}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"For this career, prioritize actual clinical research exposure."},{"type":"h","text":"Best internship environments"},{"type":"list","items":[{"text":"Clinical research departments"},{"text":"Medical colleges"},{"text":"Academic research centres"},{"text":"CROs"},{"text":"Pharmaceutical companies"},{"text":"Biotechnology companies"},{"text":"Contract research sites"},{"text":"Clinical trial units"},{"text":"Research hospitals"},{"text":"Pharmacovigilance organizations"}]},{"type":"h","text":"Internship roles"},{"type":"p","text":"Look for:"},{"type":"list","items":[{"text":"Clinical Research Intern"},{"text":"Clinical Trial Coordinator Intern"},{"text":"Research Assistant"},{"text":"Clinical Data Intern"},{"text":"Pharmacovigilance Intern"},{"text":"Clinical Operations Intern"}]}]},{"heading":"Employer Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Employer","High-Value Skills"],"rows":[[{"text":"CRO"},{"text":"Trial Coordination + Documentation"}],[{"text":"Pharmaceutical Company"},{"text":"Clinical Operations"}],[{"text":"Biotechnology Company"},{"text":"Research + Clinical Trials"}],[{"text":"Research Hospital"},{"text":"Participant Coordination"}],[{"text":"Academic Medical Centre"},{"text":"Research + Data"}],[{"text":"Clinical Trial Site"},{"text":"Site Operations"}],[{"text":"Pharmacovigilance Company"},{"text":"Safety Documentation"}],[{"text":"Clinical Data Company"},{"text":"EDC + Data Quality"}],[{"text":"Regulatory Consulting"},{"text":"Documentation + Compliance"}],[{"text":"Healthcare Research Organization"},{"text":"Research + Scientific Writing"}]]}]},{"heading":"Certifications & Additional Learning","kind":"certifications","blocks":[{"type":"p","text":"High-value learning areas include:"},{"type":"list","items":[{"text":"Good Clinical Practice"},{"text":"Clinical trial fundamentals"},{"text":"Research ethics"},{"text":"Human-subject protection"},{"text":"Clinical data management"},{"text":"Pharmacovigilance"},{"text":"Medical terminology"},{"text":"Clinical research regulations"},{"text":"Biostatistics"},{"text":"Scientific writing"}]},{"type":"p","text":"A recognized GCP course is particularly useful for entry-level clinical research roles."},{"type":"p","text":"Always verify that training reflects the current applicable GCP framework and employer requirements."}]},{"heading":"PG Options","kind":"pg_india","blocks":[{"type":"h","text":"Clinical Research"},{"type":"list","items":[{"text":"M.Sc Clinical Research"},{"text":"Master's in Clinical Research"},{"text":"Cl