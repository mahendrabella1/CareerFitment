"},{"text":"Excursions"},{"text":"Corrective actions"}]},{"type":"flow","items":["Microbiology","statistics","QA."],"sep":"+","label":"Skills"},{"type":"h","text":"Project 3 — CAPA Management System"},{"type":"p","text":"Create a simulated CAPA workflow:"},{"type":"flow","items":["Deviation","Investigation","Root Cause","Corrective Action","Preventive Action","Effectiveness","Closure"]},{"type":"p","text":"Build an Excel/Power BI tracker."},{"type":"flow","items":["QMS","RCA","CAPA","data analytics."],"sep":"+","label":"Skills"},{"type":"h","text":"Project 4 — Cleanroom Contamination Risk Assessment"},{"type":"p","text":"Develop a risk assessment for a hypothetical sterile manufacturing facility."},{"type":"p","text":"Evaluate:"},{"type":"list","items":[{"text":"Personnel"},{"text":"Air"},{"text":"Equipment"},{"text":"Materials"},{"text":"Cleaning"},{"text":"Water"},{"text":"Surface contamination"}]},{"type":"p","text":"Use FMEA to rank risks."},{"type":"h","text":"Project 5 — Pharma QA Quality Dashboard"},{"type":"p","text":"Build an integrated QA dashboard covering:"},{"type":"list","items":[{"text":"Deviations"},{"text":"CAPA"},{"text":"OOS"},{"text":"Complaints"},{"text":"Audit observations"},{"text":"Change controls"},{"text":"Training compliance"},{"text":"Environmental monitoring"}]},{"type":"note","label":"Tools","text":"Excel + Power BI."}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"During B.Sc, target internships in:"},{"type":"h","text":"Pharmaceutical Companies"},{"type":"list","items":[{"text":"QA"},{"text":"QC"},{"text":"Microbiology"},{"text":"Production"},{"text":"Validation"}]},{"type":"h","text":"Biopharmaceutical Companies"},{"type":"list","items":[{"text":"Quality systems"},{"text":"Sterility assurance"},{"text":"Manufacturing quality"},{"text":"Microbiology"}]},{"type":"h","text":"Testing Laboratories"},{"type":"list","items":[{"text":"Pharmaceutical testing"},{"text":"Microbial testing"},{"text":"Water 