dering"},{"text":"Building services"},{"text":"Interior detailing"}]},{"type":"h","text":"Semester 5"},{"type":"list","items":[{"text":"Advanced spatial design"},{"text":"Retail interiors"},{"text":"Sustainable interiors"},{"text":"Accessibility"},{"text":"Acoustics"},{"text":"HVAC/electrical/plumbing awareness"},{"text":"Cost estimation"},{"text":"Project management"}]},{"type":"h","text":"Semester 6"},{"type":"list","items":[{"text":"BIM fundamentals"},{"text":"Revit/Archicad"},{"text":"Advanced visualization"},{"text":"Construction documentation"},{"text":"Material sourcing"},{"text":"Vendor coordination"},{"text":"Building codes and regulations awareness"},{"text":"Industry project"}]},{"type":"h","text":"Semester 7"},{"type":"list","items":[{"text":"Professional internship"},{"text":"Client interaction"},{"text":"Site visits"},{"text":"Design development"},{"text":"Working drawings"},{"text":"BOQ/costing"},{"text":"Project coordination"},{"text":"Portfolio development"}]},{"type":"h","text":"Semester 8"},{"type":"list","items":[{"text":"Major interior design project"},{"text":"Detailed construction documentation"},{"text":"3D visualization"},{"text":"Material specification"},{"text":"Costing"},{"text":"Presentation"},{"text":"Final portfolio"},{"text":"Professional practice"}]}]},{"heading":"Design Fundamentals","kind":"other","blocks":[{"type":"p","text":"Master:"},{"type":"list","items":[{"text":"Balance"},{"text":"Proportion"},{"text":"Scale"},{"text":"Rhythm"},{"text":"Contrast"},{"text":"Repetition"},{"text":"Hierarchy"},{"text":"Alignment"},{"text":"Symmetry/asymmetry"},{"text":"Positive and negative space"},{"text":"Visual flow"},{"text":"Composition"},{"text":"Human-centred design"}]},{"type":"p","text":"Interior design should solve functional and human problems, not simply create attractive rooms."}]},{"heading":"Space Planning","kind":"other","blocks":[{"type":"p","text":"Learn to translate requirements into efficient spatial layouts."},{"type":"p","t