otocols"},{"text":"Suspicious traffic"},{"text":"Communication timeline"}]},{"type":"p","text":"Use:"},{"type":"h","text":"Wireshark + Python"},{"type":"p","text":"Output:"},{"type":"h","text":"Network Forensic Investigation Report"},{"type":"h","text":"Project 3 — Automated Log Analysis"},{"type":"p","text":"Build a Python application that:"},{"type":"list","items":[{"text":"Reads system logs"},{"text":"Extracts timestamps"},{"text":"Identifies failed logins"},{"text":"Groups events"},{"text":"Creates timelines"},{"text":"Generates a summary"}]}]},{"heading":"Advanced Capstone Project","kind":"other","blocks":[{"type":"h","text":"Digital Forensic Investigation & Evidence Management Platform"},{"type":"p","text":"Create a controlled forensic-analysis platform containing:"},{"type":"h","text":"Evidence Management"},{"type":"list","items":[{"text":"Case ID"},{"text":"Evidence ID"},{"text":"Evidence source"},{"text":"Acquisition details"},{"text":"Hash values"},{"text":"Chain-of-custody records"}]},{"type":"h","text":"Analysis"},{"type":"list","items":[{"text":"File analysis"},{"text":"Metadata extraction"},{"text":"Timeline generation"},{"text":"Log analysis"},{"text":"Browser artifact analysis"},{"text":"Network evidence"},{"text":"Keyword searching"}]},{"type":"h","text":"Reporting"},{"type":"list","items":[{"text":"Investigation timeline"},{"text":"Evidence summary"},{"text":"Findings"},{"text":"Hash verification"},{"text":"Analyst notes"},{"text":"Final forensic report"}]},{"type":"p","text":"This demonstrates:"},{"type":"flow","items":["Forensics","Cybersecurity","Programming","Evidence Management"],"sep":"+"}]},{"heading":"Specialization Choices","kind":"other","blocks":[{"type":"table","header":["Specialization","Focus"],"rows":[[{"text":"Computer Forensics"},{"text":"Computers and storage media"}],[{"text":"Mobile Forensics"},{"text":"Smartphones and mobile devices"}],[{"text":"Network Forensics"},{"text":"Network traffic and logs"}],[{"text":"Cloud Forensics"