buildup"},{"text":"Polar pattern"}]}]},{"heading":"DAW Skills","kind":"other","blocks":[{"type":"p","text":"Become comfortable with one DAW."},{"type":"h","text":"Basic skills"},{"type":"list","items":[{"text":"Session setup"},{"text":"Track creation"},{"text":"Recording"},{"text":"Editing"},{"text":"Comping"},{"text":"Audio fades"},{"text":"Noise cleanup"},{"text":"Routing"},{"text":"Automation"},{"text":"Plug-ins"},{"text":"Exporting"}]},{"type":"h","text":"Intermediate"},{"type":"list","items":[{"text":"EQ"},{"text":"Compression"},{"text":"Reverb"},{"text":"Delay"},{"text":"Limiting"},{"text":"Bus processing"},{"text":"Automation"},{"text":"Sidechain"}]}]},{"heading":"Basic Mixing","kind":"other","blocks":[{"type":"p","text":"A Sound Assistant progressing toward Audio Engineer should understand:"},{"type":"h","text":"EQ"},{"type":"p","text":"Used to shape frequency balance."},{"type":"h","text":"Compression"},{"type":"p","text":"Controls dynamic range."},{"type":"h","text":"Reverb"},{"type":"p","text":"Creates spatial characteristics."},{"type":"h","text":"Delay"},{"type":"p","text":"Creates repeated or time-based effects."},{"type":"h","text":"Panning"},{"type":"p","text":"Positions sounds in the stereo field."},{"type":"h","text":"Limiting"},{"type":"p","text":"Controls peaks and overall loudness."},{"type":"h","text":"Basic mix workflow"},{"type":"flow","items":["Clean Tracks","Gain Staging","Balance","Panning","EQ","Compression","Effects","Automation","Master Check"]}]},{"heading":"Acoustics","kind":"other","blocks":[{"type":"p","text":"Understand basic room acoustics."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Reflection"},{"text":"Absorption"},{"text":"Diffusion"},{"text":"Reverberation"},{"text":"Standing waves"},{"text":"Room modes"},{"text":"Acoustic treatment"},{"text":"Isolation"}]},{"type":"p","text":"For example, a recording room with excessive reflections can make vocals sound distant or unclear."}]},{"heading":"Music-Specific Advantage","kind":"other","blocks":[{"type":"p","text":"A BPA student has an advantage over someone learning audio technology without a musical background."},{"type":"p","text":"Use the music background to develop:"},{"type":"list","items":[{"text":"Strong pitch recognition"},{"text":"Rhythmic accuracy"},{"text":"Instrument identification"},{"text":"Musical arrangement awareness"},{"text":"Performance sensitivity"},{"text":"Ensemble awareness"},{"text":"Critical listening"}]},{"type":"p","text":"The objective is to combine:"},{"type":"p","text":"musician's ear + technician's workflow."}]},{"heading":"Projects During UG","kind":"build","blocks":[{"type":"h","text":"Project 1 — Vocal Recording"},{"type":"p","text":"Record and produce a vocal performance."},{"type":"p","text":"Document:"},{"type":"list","items":[{"text":"Microphone"},{"text":"Placement"},{"text":"Interface"},{"text":"Gain"},{"text":"Room"},{"text":"DAW"},{"text":"Editing"},{"text":"Mixing"}]},{"type":"h","text":"Project 2 — Instrument Recording"},{"type":"p","text":"Record an instrument such as:"},{"type":"list","items":[{"text":"Guitar"},{"text":"Keyboard"},{"text":"Violin"},{"text":"Flute"},{"text":"Percussion"}]},{"type":"p","text":"Experiment with microphone placement and compare results."},{"type":"h","text":"Project 3 — Live Sound Setup"},{"type":"p","text":"Create a small live-event setup."},{"type":"p","text":"Document:"},{"type":"flow","items":["Inputs","Stage Box","Mixer","FOH","Monitors","PA"]},{"type":"p","text":"Create a channel list and stage plot."},{"type":"h","text":"Project 4 — Podcast Production"},{"type":"p","text":"Produce a 15–30 minute podcast."},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Recording"},{"text":"Editing"},{"text":"Noise reduction"},{"text":"EQ"},{"text":"Compression"},{"text":"Music"},{"text":"Loudness management"},{"text":"Export"}]},{"type":"h","text":"Project 5 — Live Recording"},{"type":"p","text":"Record a college music performance and produce a final audio mix."},{"type":"p","text":"This is particularly valuable because it demonstrates real-world workflow under event conditions."}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Target:"},{"type":"h","text":"Recording studios"},{"type":"list","items":[{"text":"Studio Assistant"},{"text":"Recording Intern"},{"text":"Music Production Intern"}]},{"type":"h","text":"Live events"},{"type":"list","items":[{"text":"Concert companies"},{"text":"Event-production companies"},{"text":"Cultural organizations"}]},{"type":"h","text":"Film / Video"},{"type":"list","items":[{"text":"Production audio teams"},{"text":"Post-production studios"},{"text":"Media production houses"}]},{"type":"h","text":"Television"},{"type":"list","items":[{"text":"Broadcast production"},{"text":"Studio audio teams"}]},{"type":"h","text":"Theatre"},{"type":"list","items":[{"text":"Theatre sound"},{"text":"Stage productions"}]},{"type":"h","text":"Educational institutions"},{"type":"list","items":[{"text":"Campus studios"},{"text":"Performing-arts production teams"}]}]},{"heading":"Ideal Internship Progression","kind":"internships","blocks":[{"type":"flow","items":["College Performance","Audio Equipment Practice","Live Sound Volunteer","Studio / Event Internship","Sound Assistant","Assistant Engineer"]},{"type":"p","text":"Students should actively volunteer for college concerts, cultural festivals, theatre productions, and recording projects because they provide valuable hands-on experience."}]},{"heading":"Equipment Knowledge","kind":"other","blocks":[{"type":"p","text":"A Sound Assistant should become familiar with:"},{"type":"h","text":"Inputs"},{"type":"list","items":[{"text":"Dynamic microphones"},{"text":"Condenser microphones"},{"text":"DI boxes"},{"text":"Wireless systems"}]},{"type":"h","text":"Processing"},{"type":"list","items":[{"text":"Mixers"},{"text":"Preamps"},{"text":"Equalizers"},{"text":"Compressors"},{"text":"Effects processors"}]},{"