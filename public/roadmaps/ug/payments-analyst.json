periods"},{"text":"Geographic anomalies"},{"text":"Unusual merchant behaviour"},{"text":"Repeated failed attempts"},{"text":"Velocity patterns"}]},{"type":"p","text":"Use:"},{"type":"flow","items":["Python","SQL","Power BI"],"sep":"+"},{"type":"p","text":"Do not present a simple rule as a production fraud system; describe it as an analytical prototype."}]},{"heading":"Project 5 — Payment API Integration","kind":"other","blocks":[{"type":"p","text":"Build a small demo application using a sandbox/test environment."},{"type":"p","text":"Demonstrate:"},{"type":"flow","items":["Customer","Checkout","Payment Request","Payment Response","Transaction Database"]},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"REST APIs"},{"text":"JSON"},{"text":"HTTP methods"},{"text":"Webhooks"},{"text":"Authentication"},{"text":"Error handling"}]},{"type":"p","text":"This gives you a valuable bridge between FinTech and software technology."}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Target:"},{"type":"h","text":"FinTech"},{"type":"list","items":[{"text":"Payments Intern"},{"text":"FinTech Operations Intern"},{"text":"Risk Intern"},{"text":"Transaction Monitoring Intern"},{"text":"Data Analyst Intern"}]},{"type":"h","text":"Banks"},{"type":"list","items":[{"text":"Digital Banking Intern"},{"text":"Payments Operations Intern"},{"text":"Banking Operations Intern"},{"text":"Transaction Operations Intern"}]},{"type":"h","text":"E-commerce"},{"type":"list","items":[{"text":"Payments Operations"},{"text":"Checkout Analytics"},{"text":"Fraud Analytics"},{"text":"Revenue Operations"}]},{"type":"h","text":"Payment companies"},{"type":"p","text":"Look for:"},{"type":"list","items":[{"text":"Payment gateway companies"},{"text":"Payment processors"},{"text":"Digital-wallet companies"},{"text":"Merchant platforms"},{"text":"Banking technology companies"}]}]},{"heading":"Certifications & Learning","kind":"certifications","blocks":[{"type":"p","text":"Pri