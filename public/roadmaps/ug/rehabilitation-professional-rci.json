r"},{"text":"Disability Program Specialist"},{"text":"Vocational Rehabilitation Specialist"},{"text":"Teacher Educator"},{"text":"Rehabilitation Researcher"},{"text":"NGO Program Lead"},{"text":"Disability Services Administrator"}]}]},{"heading":"Emerging Technologies","kind":"other","blocks":[{"type":"h","text":"AI-Assisted Special Education"},{"type":"p","text":"AI can support:"},{"type":"list","items":[{"text":"Personalized learning"},{"text":"Adaptive worksheets"},{"text":"Content simplification"},{"text":"Speech/text assistance"},{"text":"Progress analytics"},{"text":"Individualized learning resources"},{"text":"Human oversight is essential, particularly for decisions affecting disability services and educational accommodations."}]},{"type":"h","text":"Assistive AI"},{"type":"p","text":"Emerging tools include:"},{"type":"list","items":[{"text":"Speech-to-text"},{"text":"Text-to-speech"},{"text":"Real-time captioning"},{"text":"Computer vision"},{"text":"Predictive text"},{"text":"Communication assistance"}]},{"type":"h","text":"Tele-Rehabilitation"},{"type":"p","text":"Digital platforms can support:"},{"type":"list","items":[{"text":"Remote family training"},{"text":"Follow-up"},{"text":"Education"},{"text":"Progress monitoring"},{"text":"Specialist consultation"}]},{"type":"h","text":"Digital Accessibility"},{"type":"p","text":"Professionals increasingly need knowledge of:"},{"type":"list","items":[{"text":"Accessible documents"},{"text":"Screen readers"},{"text":"Captioning"},{"text":"Keyboard navigation"},{"text":"Accessible websites"},{"text":"Alternative formats"}]}]},{"heading":"Target Profile at Graduation","kind":"other","blocks":[{"type":"p","text":"A strong rehabilitation professional should ideally demonstrate:"},{"type":"h","text":"Disability & Education"},{"type":"list","items":[{"text":"Disability awareness"},{"text":"Special education principles"},{"text":"Inclusive education"},{"text":"Individualized planning"}]},{"type":"h","text":"Assessment"},{"type":"list","items":[{"text":"Functional observation"},{"text":"Educational assessment"},{"text":"Progress monitoring"},{"text":"Strength-based assessment"}]},{"type":"h","text":"Intervention"},{"type":"list","items":[{"text":"Special teaching"},{"text":"Life-skills development"},{"text":"Behaviour support"},{"text":"Communication support"}]},{"type":"h","text":"Rehabilitation"},{"type":"list","items":[{"text":"Family engagement"},{"text":"Assistive technology"},{"text":"Vocational preparation"},{"text":"Community rehabilitation"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Ethical practice"},{"text":"Disability rights"},{"text":"Confidentiality"},{"text":"Multidisciplinary teamwork"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Digital documentation"},{"text":"Excel"},{"text":"Power BI"},{"text":"Accessibility tools"},{"text":"Assistive technology"}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"list","items":[{"text":"RCI-Recognized Professional Education"},{"text":"+"},{"text":"Disability Studies"},{"text":"+"},{"text":"Educational / Functional Assessment"},{"text":"+"},{"text":"Individualized Planning"},{"text":"+"},{"text":"Special Education"},{"text":"+"},{"text":"Inclusive Education"},{"text":"+"},{"text":"Positive Behaviour Support"},{"text":"+"},{"text":"Communication & AAC"},{"text":"+"},{"text":"Assistive Technology"},{"text":"+"},{"text":"Family-Centred Practice"},{"text":"+"},{"text":"Vocational / Transition Support"},{"text":"+"},{"text":"Community-Based Rehabilitation"},{"text":"+"},{"text":"Documentation & M&E"},{"text":"+"},{"text":"Digital Accessibility"},{"text":"+"},{"text":"Research & Evidence-Based Practice"}]}]},{"heading":"Best Overall Positioning","kind":"other","blocks":[{"type":"flow","items":["RCI-Recognized Special Education/Rehabilitation Qualification","Required RCI Registration","Supervised Field Training","Entry-Level Rehabilitation Role","Specialized Experience","Senior Rehabilitation Professional","Coordinator/Specialist","Program Leadership"]},{"type":"p","text":"For maximum employability, the strongest profile is recognized professional qualification + disability-specific expertise + functional assessment + individualized planning + inclusive education + assistive technology + family engagement + vocational/transition skills + digital accessibility + multidisciplinary teamwork."},{"type":"note","label":"Critical career-fitment note","text":"Because the row specifically says “Rehabilitation Professional (RCI)”, the database should treat this as a regulated professional pathway. RCI registration is tied to specific recognized qualifications/professional categories; therefore, students should not be told that any generic B.Ed automatically makes them an RCI-registered rehabilitation professional. The exact RCI-recognized program and registration category should be selected according to the student's intended specialization and the current RCI framework."}]}]}