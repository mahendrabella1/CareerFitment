e"},{"text":"Academic progress"},{"text":"Communication improvement"},{"text":"Behavioural outcomes"},{"text":"Family participation"}]},{"type":"h","text":"Progress workflow"},{"type":"flow","items":["Baseline","Intervention","Measurement","Progress Analysis","Modify Intervention","Reassess"]}]},{"heading":"Projects During UG","kind":"build","blocks":[{"type":"h","text":"Project 1 — Individualized Education Plan Portfolio"},{"type":"p","text":"Create a series of fictional cases with:"},{"type":"list","items":[{"text":"Functional profile"},{"text":"Strengths"},{"text":"Needs"},{"text":"Goals"},{"text":"Intervention"},{"text":"Progress measures"},{"text":"Use synthetic/student-safe data."}]},{"type":"h","text":"Project 2 — Assistive Technology Directory"},{"type":"p","text":"Create a structured database of:"},{"type":"list","items":[{"text":"Disability/need"},{"text":"Functional barrier"},{"text":"Assistive technology"},{"text":"Cost category"},{"text":"Training requirement"},{"text":"Accessibility features"}]},{"type":"h","text":"Project 3 — Inclusive Classroom Audit"},{"type":"p","text":"Assess a simulated school for:"},{"type":"list","items":[{"text":"Physical accessibility"},{"text":"Digital accessibility"},{"text":"Classroom participation"},{"text":"Learning materials"},{"text":"Assessment accommodations"},{"text":"Communication access"}]},{"type":"h","text":"Project 4 — Progress Monitoring Dashboard"},{"type":"p","text":"Build a Power BI/Excel dashboard showing:"},{"type":"list","items":[{"text":"Students"},{"text":"Goals"},{"text":"Baseline"},{"text":"Current level"},{"text":"Progress"},{"text":"Intervention status"},{"text":"Use fictional data."}]},{"type":"h","text":"Project 5 — Transition Plan"},{"type":"p","text":"Create a transition plan for a fictional adolescent covering:"},{"type":"flow","items":["Strengths","Interests","Education Goals","Life Skills","Vocational Skills","Workplace Exposure","Employment Support"]}]},{"heading":"Internship Strategy","kin