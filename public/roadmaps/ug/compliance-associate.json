ansaction monitoring"}],[{"text":"Consulting"},{"text":"Audit, controls, risk, compliance"}],[{"text":"Big Four"},{"text":"Audit, forensic, controls, regulatory"}],[{"text":"Manufacturing"},{"text":"Internal controls, audit, corporate compliance"}],[{"text":"E-commerce"},{"text":"Payments, fraud, data analysis"}],[{"text":"Listed Companies"},{"text":"Governance, audit, compliance"}],[{"text":"Financial Services"},{"text":"AML, regulatory reporting, risk"}]]}]},{"heading":"Certifications & Professional Qualifications","kind":"certifications","blocks":[{"type":"p","text":"Useful options depend on the intended specialisation."},{"type":"h","text":"Compliance / AML"},{"type":"list","items":[{"text":"AML certifications"},{"text":"KYC certifications"},{"text":"Financial crime certifications"},{"text":"Regulatory compliance programs"}]},{"type":"h","text":"Audit"},{"type":"list","items":[{"text":"Internal audit certifications"},{"text":"CIA"},{"text":"CA pathway"}]},{"type":"h","text":"Risk"},{"type":"list","items":[{"text":"FRM"},{"text":"Risk-management certifications"}]},{"type":"h","text":"Forensic Accounting"},{"type":"list","items":[{"text":"CFE"},{"text":"Forensic accounting programs"},{"text":"CA/CMA with forensic specialisation"}]},{"type":"h","text":"Company Law / Governance"},{"type":"list","items":[{"text":"CS through ICSI"}]},{"type":"p","text":"The student should select qualifications according to the desired long-term route rather than collecting unrelated certificates."}]},{"heading":"PG Study Options","kind":"pg_india","blocks":[{"type":"p","text":"A PG degree is not mandatory for entry-level compliance positions."},{"type":"p","text":"Useful options include:"},{"type":"h","text":"M.Com"},{"type":"list","items":[{"text":"Accounting"},{"text":"Auditing"},{"text":"Finance"},{"text":"Corporate Governance"}]},{"type":"h","text":"MBA"},{"type":"list","items":[{"text":"Risk Management"},{"text":"Finance"},{"text":"Compliance"},{"text":"Business Analytics"}]},{"t