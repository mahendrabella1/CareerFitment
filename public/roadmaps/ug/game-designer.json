 roles"},{"type":"table","header":["Role","Alignment"],"rows":[[{"text":"Game Design Intern"},{"text":"Excellent"}],[{"text":"Junior Game Designer"},{"text":"Excellent"}],[{"text":"Associate Game Designer"},{"text":"Excellent"}],[{"text":"Game Design Trainee"},{"text":"Excellent"}],[{"text":"Level Designer"},{"text":"Excellent"}],[{"text":"Junior Level Designer"},{"text":"Excellent"}],[{"text":"Systems Design Associate"},{"text":"Very Good"}],[{"text":"Game UX Designer"},{"text":"Very Good"}],[{"text":"Narrative Design Assistant"},{"text":"Good"}],[{"text":"Technical Game Designer"},{"text":"Good–Very Good"}],[{"text":"Content Designer"},{"text":"Very Good"}],[{"text":"Game Balancing Analyst"},{"text":"Good"}],[{"text":"Game QA / Design QA"},{"text":"Useful entry route"}]]},{"type":"h","text":"Important"},{"type":"p","text":"Some studios hire entry-level designers into Level Design, Content Design or Game QA before moving them into broader Game Designer roles."},{"type":"p","text":"Do not search only for the exact title “Game Designer.”"}]},{"heading":"After 2–5 Years","kind":"other","blocks":[{"type":"p","text":"Potential roles:"},{"type":"list","items":[{"text":"Game Designer"},{"text":"Systems Designer"},{"text":"Level Designer"},{"text":"Combat Designer"},{"text":"Narrative Designer"},{"text":"Game UX Designer"},{"text":"Economy Designer"},{"text":"Technical Game Designer"},{"text":"Live Operations Designer"},{"text":"Monetisation Designer"}]}]},{"heading":"Senior Career","kind":"other","blocks":[{"type":"p","text":"With experience:"},{"type":"list","items":[{"text":"Senior Game Designer"},{"text":"Senior Systems Designer"},{"text":"Senior Level Designer"},{"text":"Lead Game Designer"},{"text":"Lead Systems Designer"},{"text":"Lead Level Designer"},{"text":"Design Director"},{"text":"Game Design Director"},{"text":"Creative Director"}]},{"type":"p","text":"A Creative Director is generally a later-career role requiring substantial production, leadership and creative experience."}]},{"heading":"Specialisation Paths","kind":"other","blocks":[{"type":"h","text":"A. Systems Designer"},{"type":"p","text":"Best for students who enjoy:"},{"type":"list","items":[{"text":"Logic"},{"text":"Numbers"},{"text":"Mechanics"},{"text":"Balancing"},{"text":"Complex systems"}]},{"type":"p","text":"Skills:"},{"type":"flow","items":["Math","Excel","Game Logic","Economy","Programming"],"sep":"+"},{"type":"h","text":"B. Level Designer"},{"type":"p","text":"Best for:"},{"type":"list","items":[{"text":"Spatial thinking"},{"text":"Architecture"},{"text":"Gameplay"},{"text":"Environment"},{"text":"Pacing"}]},{"type":"p","text":"Skills:"},{"type":"flow","items":["Level Editor","Blockout","Encounter Design","Player Flow"],"sep":"+"},{"type":"h","text":"C. Narrative Designer"},{"type":"p","text":"Best for:"},{"type":"list","items":[{"text":"Storytelling"},{"text":"Writing"},{"text":"Characters"},{"text":"Worldbuilding"}]},{"type":"p","text":"Skills:"},{"type":"flow","items":["Writing","Interactive Narrative","Dialogue Systems","Quest Design"],"sep":"+"},{"type":"h","text":"D. Combat Designer"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Weapons"},{"text":"Abilities"},{"text":"Enemies"},{"text":"Bosses"},{"text":"Combat balance"}]},{"type":"p","text":"Useful for action/RPG/shooter studios."},{"type":"h","text":"E. Game UX Designer"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Onboarding"},{"text":"HUD"},{"text":"Menus"},{"text":"Controls"},{"text":"Accessibility"},{"text":"Player feedback"}]},{"type":"p","text":"This combines:"},{"type":"flow","items":["Game Design","UX Research","Interaction Design"],"sep":"+"},{"type":"h","text":"F. Technical Game Designer"},{"type":"p","text":"One of the strongest hybrid profiles."},{"type":"p","text":"Combines:"},{"type":"flow","items":["Game Design","Scripting","Game Engine","Tools"],"sep":"+"},{"type":"p","text":"Useful skills:"},{"type":"list","items":[{"text":"C#"},{"text":"Blu