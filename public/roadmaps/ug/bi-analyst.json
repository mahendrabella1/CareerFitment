Revenue"},{"text":"Profit"},{"text":"Sales growth"},{"text":"Region"},{"text":"Product performance"},{"text":"Customer segments"},{"text":"Monthly trends"}]},{"type":"flow","items":["SQL","Power BI","DAX"],"sep":"+","label":"Tools"},{"type":"h","text":"Project 2 — Customer Analytics Dashboard"},{"type":"p","text":"Analyze:"},{"type":"list","items":[{"text":"Customer acquisition"},{"text":"Retention"},{"text":"Churn"},{"text":"Customer lifetime value"},{"text":"Purchase frequency"},{"text":"Cohort performance"},{"text":"Build interactive customer dashboards."}]},{"type":"h","text":"Project 3 — HR Analytics BI System"},{"type":"p","text":"Create a dashboard covering:"},{"type":"list","items":[{"text":"Employee headcount"},{"text":"Attrition"},{"text":"Department performance"},{"text":"Hiring"},{"text":"Compensation"},{"text":"Employee tenure"},{"text":"Absence"},{"text":"Include drill-down and department-level filtering."}]},{"type":"h","text":"Project 4 — Supply Chain Intelligence Dashboard"},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Inventory"},{"text":"Orders"},{"text":"Suppliers"},{"text":"Delivery times"},{"text":"Stock-outs"},{"text":"Procurement costs"},{"text":"Warehouse performance"},{"text":"Add alerts and KPI thresholds."}]},{"type":"h","text":"Project 5 — End-to-End BI Data Warehouse"},{"type":"p","text":"Build a small BI system:"},{"type":"flow","items":["CSV / API / Database","ETL / Power Query / Python","Data Warehouse","Star Schema","Power BI Dataset","DAX Measures","Executive Dashboard"]},{"type":"p","text":"This is an excellent portfolio project because it demonstrates the complete BI lifecycle."}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Technology companies"},{"text":"SaaS companies"},{"text":"FinTech"},{"text":"E-commerce"},{"text":"Consulting"},{"text":"Banking"},{"text":"Healthcare"},{"text":"Retail"},{"text":"Manufacturing"},{"text":"Logistics"},{"text":"EdTech"}]},{"type":"h","text":"Best Internship Roles"},{"type":"list","items":[{"text":"BI Analyst Intern"},{"text":"Data Analyst Intern"},{"text":"Business Analyst Intern"},{"text":"Reporting Analyst"},{"text":"BI Developer Intern"},{"text":"Analytics Intern"},{"text":"Data Visualization Intern"},{"text":"MIS Analyst"}]},{"type":"p","text":"Prioritize internships where you work with:"},{"type":"flow","items":["SQL","dashboards","business KPIs","real organizational data"],"sep":"+"}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"type":"p","text":"After B.Sc:"},{"type":"list","items":[{"text":"BI Analyst"},{"text":"Junior BI Analyst"},{"text":"Data Analyst"},{"text":"Reporting Analyst"},{"text":"Business Analyst"},{"text":"MIS Analyst"},{"text":"Dashboard Developer"},{"text":"Analytics Analyst"}]},{"type":"p","text":"With experience:"},{"type":"list","items":[{"text":"Senior BI Analyst"},{"text":"BI Developer"},{"text":"Analytics Engineer"},{"text":"BI Consultant"},{"text":"Analytics Specialist"},{"text":"BI Architect"},{"text":"Analytics Lead"}]}]},{"heading":"Employer Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Industry","High-Value BI Skills"],"rows":[[{"text":"Technology/SaaS"},{"text":"Product analytics, SQL, Power BI, experimentation"}],[{"text":"FinTech"},{"text":"Financial KPIs, risk analytics, SQL"}],[{"text":"E-commerce"},{"text":"Sales, customer, marketing analytics"}],[{"text":"Banking"},{"text":"Risk, operations, customer analytics"}],[{"text":"Healthcare"},{"text":"Healthcare KPIs, reporting, data governance"}],[{"text":"Manufacturing"},{"text":"Supply chain, quality, operations BI"}],[{"text":"Retail"},{"text":"Inventory, sales, customer analytics"}],[{"text":"Consulting"},{"text":"Power BI, SQL, Excel, storytelling"}]]}]},{"heading":"Certifications & Learning","kind":"certifications","blocks":[{"type":"h","text":"High-Value Certifications"},{"type":"p","text":"Consider:"},{"type":"list","it