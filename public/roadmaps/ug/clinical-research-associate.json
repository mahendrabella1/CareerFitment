ional formatting"},{"text":"Charts"},{"text":"Data validation"},{"text":"Power Query"}]},{"type":"h","text":"SQL"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Clinical datasets"},{"text":"Data validation"},{"text":"Trial metrics"},{"text":"Query management"}]},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"SELECT"},{"text":"JOIN"},{"text":"GROUP BY"},{"text":"CASE"},{"text":"CTEs"},{"text":"Window functions"}]},{"type":"h","text":"Python/R"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Clinical data analysis"},{"text":"Statistical analysis"},{"text":"Visualization"},{"text":"Automation"}]},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"pandas"},{"text":"NumPy"},{"text":"SciPy"},{"text":"statsmodels"},{"text":"Matplotlib"},{"text":"R"},{"text":"RStudio"}]}]},{"heading":"Clinical Research Technology","kind":"other","blocks":[{"type":"p","text":"Become familiar with the concepts behind:"},{"type":"list","items":[{"text":"EDC systems"},{"text":"CTMS"},{"text":"eTMF"},{"text":"EDC/clinical databases"},{"text":"Safety databases"},{"text":"Randomization systems"},{"text":"Electronic consent"},{"text":"Electronic source documents"}]},{"type":"p","text":"Examples of platforms encountered in industry may include:"},{"type":"list","items":[{"text":"Medidata"},{"text":"Oracle Clinical"},{"text":"Veeva"},{"text":"TrialMaster"},{"text":"REDCap"}]},{"type":"p","text":"The exact systems depend on the sponsor/CRO."}]},{"heading":"Projects to Build","kind":"other","blocks":[{"type":"h","text":"Project 1 — Clinical Trial Protocol Analysis"},{"type":"p","text":"Select a publicly available clinical-trial protocol/registry record and create:"},{"type":"list","items":[{"text":"Study objective"},{"text":"Study design"},{"text":"Population"},{"text":"Inclusion/exclusion criteria"},{"text":"Intervention"},{"text":"Comparator"},{"text":"Endpoints"},{"text":"Visit schedule"},{"text":"Safety measures"}]},{"type":"note","