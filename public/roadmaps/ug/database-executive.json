:"User management"},{"text":"Security"},{"text":"Monitoring"},{"text":"Performance tuning"}]},{"type":"h","text":"Cloud"},{"type":"list","items":[{"text":"AWS/Azure/GCP"},{"text":"Managed databases"},{"text":"IAM"},{"text":"Networking"},{"text":"Monitoring"}]},{"type":"h","text":"Data"},{"type":"list","items":[{"text":"ETL/ELT"},{"text":"Data warehousing"},{"text":"Data quality"},{"text":"Power BI"},{"text":"SQL analytics"}]},{"type":"h","text":"Advanced"},{"type":"list","items":[{"text":"Replication"},{"text":"High availability"},{"text":"Distributed databases"},{"text":"Automation"},{"text":"Vector databases"},{"text":"AI data infrastructure"}]},{"type":"h","text":"Target Progression"},{"type":"table","header":["Stage","Target"],"rows":[[{"text":"Year 1"},{"text":"SQL + DBMS + data modelling"}],[{"text":"Year 2"},{"text":"Advanced SQL + database programming"}],[{"text":"Year 3"},{"text":"DBA + Linux + backup + security + performance"}],[{"text":"Year 4"},{"text":"Cloud + automation + monitoring + internship"}],[{"text":"0–2 years after UG"},{"text":"Database Executive / Junior DBA"}],[{"text":"2–5 years"},{"text":"DBA / Database Engineer"}],[{"text":"5–8 years"},{"text":"Senior DBA / Senior Database Engineer"}],[{"text":"8–12 years"},{"text":"Lead DBA / Database Architect"}],[{"text":"12–16 years"},{"text":"Principal Engineer / Data Platform Lead"}],[{"text":"16+ years"},{"text":"Data Architect / Head of Data Platform"}]]},{"type":"h","text":"Best Profile by Graduation"},{"type":"flow","items":["BCA","strong SQL","DBMS","PostgreSQL/MySQL","data modelling","Python/Java","Linux","backup/recovery","database security","performance tuning","Git","cloud database","Power BI","automation","2–3 database projects","internship."],"sep":"+"},{"type":"p","text":"This profile makes the graduate employable as a Database Executive while keeping strong progression routes toward DBA, Database Engineer, Cloud Database Engineer, Data Engineer and Data Platform Architect."},{"type":"p