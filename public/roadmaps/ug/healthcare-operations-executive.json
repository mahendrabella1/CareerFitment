:"Medical terminology fundamentals"}]},{"type":"h","text":"Quality"},{"type":"list","items":[{"text":"NABH-related training"},{"text":"Quality management"},{"text":"Lean Six Sigma"}]},{"type":"h","text":"Analytics"},{"type":"list","items":[{"text":"Advanced Excel"},{"text":"Power BI"},{"text":"SQL"},{"text":"Healthcare analytics"}]},{"type":"h","text":"Management"},{"type":"list","items":[{"text":"Project management"},{"text":"Process improvement"},{"text":"Supply-chain fundamentals"}]},{"type":"p","text":"Certifications should supplement hospital exposure and operational experience."}]},{"heading":"PG Study Options","kind":"pg_india","blocks":[{"type":"p","text":"A postgraduate degree is not mandatory for entry-level healthcare operations roles, but it becomes valuable for management progression."},{"type":"h","text":"MBA"},{"type":"p","text":"Strong choices:"},{"type":"list","items":[{"text":"Hospital Management"},{"text":"Healthcare Management"},{"text":"Healthcare Administration"},{"text":"Operations Management"},{"text":"Business Analytics"}]},{"type":"h","text":"Master's"},{"type":"list","items":[{"text":"Master of Hospital Administration (MHA)"},{"text":"Master of Public Health (MPH)"},{"text":"MSc Healthcare Management"},{"text":"MSc Healthcare Administration"},{"text":"MSc Health Informatics"}]},{"type":"p","text":"Which Is Best?"},{"type":"p","text":"For hospital operations:"},{"type":"h","text":"MBA/MHA Hospital or Healthcare Administration"},{"type":"p","text":"For healthcare data:"},{"type":"h","text":"Healthcare Analytics / Health Informatics"},{"type":"p","text":"For public-health systems:"},{"type":"h","text":"MPH"},{"type":"h","text":"AI & Digital Healthcare"},{"type":"p","text":"Healthcare operations is becoming increasingly data-driven."},{"type":"h","text":"AI Applications"},{"type":"p","text":"AI can support:"},{"type":"list","items":[{"text":"Patient scheduling"},{"text":"Demand forecasting"},{"text":"Bed allocation"},{"text":"Staffing optimisa