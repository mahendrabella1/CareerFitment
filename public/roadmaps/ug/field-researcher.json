y entry"},{"text":"Rapport building"},{"text":"Participatory research"},{"text":"Focus-group facilitation"},{"text":"Interview transcription"},{"text":"Coding qualitative data"},{"text":"Field-note management"}]},{"type":"h","text":"Analysis"},{"type":"p","text":"Use:"},{"type":"list","items":[{"text":"Excel"},{"text":"Power BI"},{"text":"R/Python"},{"text":"QGIS"},{"text":"NVivo or equivalent qualitative-analysis tools"}]},{"type":"h","text":"Final project"},{"type":"h","text":"Participatory Community Development & Regional Research Study"},{"type":"p","text":"Structure:"},{"type":"flow","items":["Research Question","Literature Review","Community Engagement","Field Data Collection","Qualitative + Quantitative Analysis","GIS / Spatial Analysis","Findings","Community / Policy Recommendations"]},{"type":"h","text":"Final-Year Project Ideas"},{"type":"list","items":[{"text":"Tribal Livelihoods & Socioeconomic Change"},{"text":"Education Access in Tribal Communities"},{"text":"Healthcare Access in Remote Communities"},{"text":"Indigenous Knowledge & Climate Adaptation"},{"text":"Migration and Changing Rural Communities"},{"text":"Digital Inclusion in Tribal Regions"},{"text":"Women and Livelihoods in Indigenous Communities"},{"text":"Forest-Based Livelihoods & Sustainability"},{"text":"GIS Mapping of Public-Service Accessibility"},{"text":"Participatory Community Development Assessment"},{"text":"Regional Language and Cultural Preservation"},{"text":"Impact Assessment of a Community Development Programme"}]},{"type":"p","text":"A particularly strong project is:"},{"type":"h","text":"GIS & Data-Driven Tribal Community Development Assessment"},{"type":"p","text":"Combine:"},{"type":"list","items":[{"text":"Household/community survey"},{"text":"GIS mapping"},{"text":"Public-service accessibility"},{"text":"Education/health indicators"},{"text":"Livelihood analysis"},{"text":"Community perspectives"},{"text":"Policy recommendations"}]},{"type":"h","text":"4-Year Honours / A