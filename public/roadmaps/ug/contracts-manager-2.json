text":"Who owns pre-existing IP?"},{"text":"Who owns newly created IP?"},{"text":"Licensing rights"},{"text":"Usage restrictions"},{"text":"Open-source considerations"}]},{"type":"h","text":"Termination"},{"type":"p","text":"Review:"},{"type":"list","items":[{"text":"Termination for convenience"},{"text":"Termination for cause"},{"text":"Notice periods"},{"text":"Cure periods"},{"text":"Post-termination obligations"}]}]},{"heading":"Negotiation Skills","kind":"other","blocks":[{"type":"p","text":"A Contracts Manager should not negotiate only from a legal perspective."},{"type":"p","text":"Understand:"},{"type":"h","text":"Legal Risk"},{"type":"p","text":"Is this clause legally acceptable?"},{"type":"h","text":"Commercial Risk"},{"type":"p","text":"Could this clause create financial exposure?"},{"type":"h","text":"Operational Risk"},{"type":"p","text":"Can the company actually comply with this obligation?"},{"type":"h","text":"Business Objective"},{"type":"p","text":"Does the contract support what the business is trying to achieve?"},{"type":"h","text":"Negotiation"},{"type":"flow","items":["Company Objective","Identify Must-Have Terms","Identify Flexible Terms","Identify High-Risk Clauses","Prepare Negotiation Position","Counterparty Discussion","Compromise / Escalation","Final Contract"]}]},{"heading":"Contract Lifecycle Management","kind":"other","blocks":[{"type":"p","text":"Modern contracts teams increasingly use Contract Lifecycle Management (CLM) systems."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Contract intake"},{"text":"Template management"},{"text":"Approval workflows"},{"text":"Version control"},{"text":"E-signatures"},{"text":"Repository management"},{"text":"Obligation tracking"},{"text":"Renewal alerts"},{"text":"Contract reporting"},{"text":"Audit trails"}]},{"type":"h","text":"CLM Workflow"},{"type":"flow","items":["Request","Template","Draft","Review","Approval","Negotiation","E-Signature","Repository","Obligation Monitoring","