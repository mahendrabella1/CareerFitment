"},{"text":"AR/VR performance"},{"text":"Digital performance"},{"text":"AI-assisted creative tools"},{"text":"Virtual production"}]},{"type":"h","text":"Business"},{"type":"list","items":[{"text":"Freelancing"},{"text":"Negotiation"},{"text":"Personal finance"},{"text":"Copyright/IP awareness"},{"text":"Portfolio management"}]},{"type":"h","text":"Target progression"},{"type":"table","header":["Stage","Target"],"rows":[[{"text":"Year 1"},{"text":"Fundamental performance technique"}],[{"text":"Year 2"},{"text":"Advanced technique + productions"}],[{"text":"Year 3"},{"text":"Specialisation + professional portfolio"}],[{"text":"Graduation"},{"text":"Auditions + professional performances"}],[{"text":"Years 1–3"},{"text":"Build credits, repertoire and network"}],[{"text":"Years 3–6"},{"text":"Established professional performer"}],[{"text":"Years 6–10"},{"text":"Lead performer / choreographer / specialist"}],[{"text":"10+ years"},{"text":"Artistic Director / Independent Artist / Creative Entrepreneur"}]]},{"type":"h","text":"Best employability combination"},{"type":"flow","items":["BA Performing Arts","intensive discipline-specific training","extensive live-performance experience","professional showreel","audition skills","networking","camera/digital skills","physical conditioning","personal brand"],"sep":"+"},{"type":"note","label":"Key principle","text":"A performing-arts career is fundamentally portfolio- and performance-driven. The degree provides structure and artistic foundations, but professional growth comes from skill, stage experience, performance credits, visibility, relationships and continuous artistic development."}]}]}