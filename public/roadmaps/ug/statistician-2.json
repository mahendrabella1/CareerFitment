ng theory"},{"text":"Official statistics"},{"text":"Statistical inference"},{"text":"Government recruitment pathways"}]},{"type":"h","text":"Path 4 — Financial Statistics"},{"type":"flow","items":["Mathematics","Probability + Statistics","Time Series + Risk","Financial Analytics","Risk / Quantitative Role"]},{"type":"p","text":"Add:"},{"type":"list","items":[{"text":"Probability"},{"text":"Stochastic processes"},{"text":"Time series"},{"text":"Financial mathematics"},{"text":"Econometrics"},{"text":"Python"}]},{"type":"h","text":"Path 5 — Statistical Research"},{"type":"flow","items":["B.Sc","M.Sc / M.Stat","Research","PhD","Research Statistician","Statistical Scientist"]}]},{"heading":"Emerging Technologies","kind":"other","blocks":[{"type":"h","text":"AI + Statistics"},{"type":"p","text":"AI does not eliminate the need for statistics. Instead, statistical thinking becomes increasingly important for:"},{"type":"list","items":[{"text":"Model evaluation"},{"text":"Uncertainty estimation"},{"text":"Experiment design"},{"text":"Causal inference"},{"text":"Bias detection"},{"text":"A/B testing"},{"text":"Probabilistic modelling"}]},{"type":"h","text":"Modern workflow"},{"type":"flow","items":["Raw Data","Statistical Exploration","Feature Engineering","Statistical Model / ML Model","Validation","Uncertainty Analysis","Interpretation","Decision"]},{"type":"h","text":"Other emerging areas"},{"type":"list","items":[{"text":"Causal AI"},{"text":"Bayesian AI"},{"text":"Probabilistic machine learning"},{"text":"Automated experimentation"},{"text":"Synthetic data"},{"text":"Privacy-preserving statistics"},{"text":"High-dimensional inference"},{"text":"Statistical genetics"},{"text":"AI model evaluation"}]}]},{"heading":"Recommended Skill Stack","kind":"other","blocks":[{"type":"h","text":"Minimum employability stack"},{"type":"list","items":[{"text":"B.Sc Mathematics"},{"text":"+"},{"text":"Probability"},{"text":"+"},{"text":"Statistics"},{"text":"+"},{"text":"Regression"},{"te