:"Digital Theatre Artist"},{"text":"Immersive Theatre Performer"},{"text":"Virtual Production Performer"},{"text":"Motion-Capture Performer"},{"text":"Performance Technology Artist"},{"text":"Interactive Theatre Director"},{"text":"Digital Dramaturg"},{"text":"AI-Assisted Performance Designer"},{"text":"XR Theatre Producer"},{"text":"Multimodal Storytelling Artist"}]},{"type":"h","text":"Technology areas to explore"},{"type":"list","items":[{"text":"Projection mapping"},{"text":"Virtual production"},{"text":"Motion capture"},{"text":"Extended Reality (XR)"},{"text":"Interactive installations"},{"text":"Spatial audio"},{"text":"Digital scenography"},{"text":"Real-time visual effects"},{"text":"AI-assisted dramaturgy"},{"text":"Digital audience engagement"}]},{"type":"p","text":"AI can assist with:"},{"type":"list","items":[{"text":"Script ideation"},{"text":"Character research"},{"text":"Visual concept development"},{"text":"Translation"},{"text":"Rehearsal documentation"},{"text":"Audience analysis"},{"text":"Promotional content"}]},{"type":"p","text":"But performers should protect human authorship, artistic identity, consent and intellectual-property rights, particularly when AI is used to reproduce a person's voice, face or performance."},{"type":"h","text":"Recommended Final Skill Stack"},{"type":"h","text":"Performance"},{"type":"list","items":[{"text":"Acting"},{"text":"Voice"},{"text":"Movement"},{"text":"Improvisation"},{"text":"Character development"},{"text":"Scene work"},{"text":"Stage presence"}]},{"type":"h","text":"Theatre"},{"type":"list","items":[{"text":"Theatre history"},{"text":"Dramaturgy"},{"text":"Script analysis"},{"text":"Direction fundamentals"},{"text":"Stagecraft"},{"text":"Production"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Audition skills"},{"text":"Self-tape"},{"text":"Networking"},{"text":"Portfolio management"},{"text":"Collaboration"},{"text":"Rehearsal discipline"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Video editing"},{"text":"Photography"},{"text":"Social media"},{"text":"Digital marketing"},{"text":"Basic audio"},{"text":"Digital performance tools"}]},{"type":"h","text":"Future Technology"},{"type":"list","items":[{"text":"XR"},{"text":"Motion capture"},{"text":"Virtual production"},{"text":"Projection mapping"},{"text":"Interactive media"},{"text":"AI-assisted creative workflows"}]},{"type":"h","text":"Business"},{"type":"list","items":[{"text":"Freelancing"},{"text":"Contract awareness"},{"text":"Budgeting"},{"text":"Arts management"},{"text":"Grant/proposal writing"},{"text":"Audience development"}]},{"type":"h","text":"Target Progression"},{"type":"flow","items":["BA Dance/Theatre/Performing Arts","Acting + Voice + Movement Training","Student & Independent Theatre Productions","Performance Portfolio + Showreel","Theatre Artist / Ensemble Performer","Professional Theatre Artist","Lead Performer / Theatre Practitioner","Director / Creative Professional","Artistic Director / Theatre Company Founder"]},{"type":"h","text":"Best overall strategy"},{"type":"p","text":"For a Performing Arts graduate targeting Theatre Artist, the strongest route is:"},{"type":"flow","items":["BA Performing Arts","intensive acting/voice/movement practice","regular theatre productions","professional showreel","networking","festival/production experience."],"sep":"+"},{"type":"p","text":"Unlike many conventional careers, performance credits, practical ability, artistic range and professional relationships are central to employability. For long-term resilience, combine traditional theatre craft with digital performance, immersive theatre, virtual production and multimedia storytelling."}]}]}