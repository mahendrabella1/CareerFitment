egree:"},{"type":"list","items":[{"text":"LLB (useful)"},{"text":"MBA (optional)"}]},{"type":"p","text":"Entrance exams and tests to know:"},{"type":"list","items":[{"text":"CSEET, CS Executive, CS Professional"}]}]},{"heading":"Study Abroad Options","kind":"abroad","blocks":[{"type":"list","items":[{"text":"Chartered Governance Institute (UK) routes"}]}]},{"heading":"Career Opportunities","kind":"careers","blocks":[{"type":"p","text":"Roles a Corporate Governance Manager can grow into or move across to:"},{"type":"list","items":[{"text":"Company Secretary"},{"text":"Compliance Officer"},{"text":"Legal Manager"},{"text":"Registrar & Transfer Agent"}]}]},{"heading":"Recommended Career Progression","kind":"growth","blocks":[{"type":"flow","items":["Assistant Company Secretary","Company Secretary","Governance Manager","Head of Governance","Chief Compliance Officer"]}]}],"drafted":true}