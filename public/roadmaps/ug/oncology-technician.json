ext":"Advanced Qualification"},{"type":"h","text":"Clinical Research"},{"type":"h","text":"Research Coordinator"},{"type":"h","text":"Clinical Research Professional"},{"type":"h","text":"Or:"},{"type":"h","text":"Radiotherapy Technology"},{"type":"h","text":"Equipment / Applications Training"},{"type":"h","text":"Clinical Applications Specialist"},{"type":"h","text":"Senior Applications Specialist"},{"type":"h","text":"Oncology Technology Manager"}]},{"heading":"Emerging Technologies","kind":"other","blocks":[{"type":"h","text":"AI in Radiation Oncology"},{"type":"h","text":"AI is increasingly relevant to:"},{"type":"list","items":[{"text":"Image segmentation"},{"text":"Treatment planning"},{"text":"Image registration"},{"text":"Quality assurance"},{"text":"Workflow optimization"},{"text":"Treatment monitoring"}]},{"type":"h","text":"Adaptive Radiotherapy"},{"type":"p","text":"Treatment can potentially be adapted according to anatomical changes during a treatment course."},{"type":"h","text":"MR-Guided Radiotherapy"},{"type":"p","text":"Combines MRI imaging with radiation treatment for improved soft-tissue visualization in selected systems."},{"type":"h","text":"Automated Patient Positioning"},{"type":"p","text":"Computer vision and surface-guided systems can assist with patient setup and motion monitoring."},{"type":"h","text":"Surface-Guided Radiation Therapy"},{"type":"p","text":"Optical systems can monitor patient position without relying exclusively on traditional imaging."},{"type":"h","text":"Data-Driven Oncology"},{"type":"p","text":"Future technicians increasingly need familiarity with:"},{"type":"list","items":[{"text":"Treatment databases"},{"text":"Digital workflows"},{"text":"Analytics"},{"text":"AI systems"},{"text":"Remote equipment monitoring"}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"h","text":"Anatomy & Physiology"},{"type":"h","text":"+"},{"type":"h","text":"Oncology"},{"type":"h","text":"+"},{"type":"h","text":"Radiation Physics"},{"type":"h","text":"+"},{"type":"h","text":"Radiobiology"},{"type":"h","text":"+"},{"type":"h","text":"Radiation Safety"},{"type":"h","text":"+"},{"type":"h","text":"Radiotherapy Equipment"},{"type":"h","text":"+"},{"type":"h","text":"CT Simulation"},{"type":"h","text":"+"},{"type":"h","text":"Patient Positioning"},{"type":"h","text":"+"},{"type":"h","text":"IGRT"},{"type":"h","text":"+"},{"type":"h","text":"Brachytherapy Fundamentals"},{"type":"h","text":"+"},{"type":"h","text":"Quality & Safety"},{"type":"h","text":"+"},{"type":"h","text":"Patient Communication"},{"type":"h","text":"+"},{"type":"h","text":"Clinical Documentation"},{"type":"h","text":"+"},{"type":"h","text":"Digital Imaging"},{"type":"h","text":"+"},{"type":"h","text":"AI / Data Fundamentals"}]},{"heading":"Target Profile by Graduation","kind":"other","blocks":[{"type":"h","text":"A strong graduate should demonstrate:"},{"type":"h","text":"Clinical"},{"type":"list","items":[{"text":"Understanding of cancer and radiotherapy"},{"text":"Basic patient-care skills"},{"text":"Patient positioning"},{"text":"Immobilization principles"},{"text":"Symptom recognition and escalation"}]},{"type":"h","text":"Technical"},{"type":"list","items":[{"text":"Radiotherapy equipment fundamentals"},{"text":"LINAC workflow"},{"text":"CT simulation"},{"text":"IGRT fundamentals"},{"text":"Brachytherapy workflow"},{"text":"Equipment safety"}]},{"type":"h","text":"Safety"},{"type":"list","items":[{"text":"Radiation protection"},{"text":"Controlled-area procedures"},{"text":"Emergency procedures"},{"text":"Safety interlocks"},{"text":"Incident reporting"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Treatment-management systems"},{"text":"Medical imaging"},{"text":"DICOM fundamentals"},{"text":"Electronic documentation"},{"text":"Basic data analysis"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Accuracy"},{"text":"Patient confidentiality"},{"text":"Teamwork"},{"text":"Communication"},{"text":"SOP compliance"},{"text":"Safety-first decision-making"}]}]},{"heading":"Best Overall Positioning","kind":"other","blocks":[{"type":"p","text":"A safety-focused oncology technology professional with strong radiotherapy fundamentals, patient-positioning skills, radiation-safety awareness, treatment-equipment knowledge, clinical documentation ability, and growing expertise in image-guided and digitally enabled cancer treatment."},{"type":"p","text":"For long-term growth, the strongest profile combines radiotherapy technology + radiation safety + oncology knowledge + advanced treatment techniques + digital imaging + quality assurance."}]}]}