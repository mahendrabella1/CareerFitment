"},{"text":"Patient safety"}]},{"type":"h","text":"OT Technology"},{"type":"list","items":[{"text":"Surgical instrumentation"},{"text":"Anaesthesia equipment"},{"text":"Patient monitoring"},{"text":"Electrosurgical equipment"},{"text":"Laparoscopic systems"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Clinical documentation"},{"text":"Healthcare communication"},{"text":"Quality management"},{"text":"Biomedical equipment safety"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Excel"},{"text":"Healthcare information systems"},{"text":"Data analytics"},{"text":"Smart-hospital technologies"}]}]},{"heading":"PG Options","kind":"pg_india","blocks":[{"type":"p","text":"Possible higher-study directions include:"},{"type":"list","items":[{"text":"M.Sc Operation Theatre Technology"},{"text":"M.Sc Anaesthesia Technology"},{"text":"Master's in Allied Health Sciences"},{"text":"Healthcare Management"},{"text":"Hospital Administration"},{"text":"Public Health"},{"text":"Clinical Research"},{"text":"Healthcare Quality Management"},{"text":"Health Informatics"}]},{"type":"h","text":"Management Path"},{"type":"flow","items":["OT Technology","Clinical Experience","Healthcare Management","OT Operations Coordinator","Perioperative Services Manager"]},{"type":"h","text":"Career Specializations"},{"type":"h","text":"1. General Surgery OT"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Instrumentation"},{"text":"Surgical workflow"},{"text":"Aseptic technique"}]},{"type":"h","text":"2. Orthopaedic OT"},{"type":"p","text":"Develop expertise in:"},{"type":"list","items":[{"text":"Orthopaedic sets"},{"text":"Implants"},{"text":"Power instruments"},{"text":"Arthroscopy"}]},{"type":"h","text":"3. Cardiothoracic OT"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Highly specialized instruments"},{"text":"Advanced monitoring"},{"text":"Complex surgical workflow"}]},{"type":"h","text":"4. Neurosurgery OT"},{"type":"p"