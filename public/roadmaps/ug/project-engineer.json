ward","kind":"growth","blocks":[{"type":"h","text":"Career progression:"},{"type":"flow","items":["B.Tech Electrical Engineering student","Electrical/Project Intern","Graduate Electrical Engineer","Junior Project Engineer","Project Engineer","Senior Project Engineer","Project Lead / Project Manager","Senior Project Manager / Engineering Manager","Programme Manager / Project Director"]},{"type":"h","text":"PhD routes"},{"type":"list","items":[{"text":"Electrical Engineering"},{"text":"Power Systems"},{"text":"Energy Systems"},{"text":"Renewable Energy"},{"text":"Power Electronics"},{"text":"Smart Grids"},{"text":"Infrastructure Engineering"},{"text":"Construction Engineering & Management"},{"text":"Engineering Project Management"},{"text":"Industrial Engineering"},{"text":"Systems Engineering"},{"text":"Sustainable Energy Systems"}]},{"type":"h","text":"2040–2046"},{"type":"p","text":"Long-term development can move toward Project Manager, Engineering Manager, Programme Manager, Project Director or technical project leadership. For major infrastructure and EPC projects, strengthen commercial awareness, contracts, procurement, risk management, stakeholder management and multidisciplinary engineering coordination alongside electrical expertise."}]}]}