":"Public realm"},{"text":"Streetscapes"},{"text":"Urban planning"},{"text":"Mobility"},{"text":"Open-space networks"}]},{"type":"h","text":"Environmental Consultancies"},{"type":"p","text":"Gain exposure to:"},{"type":"list","items":[{"text":"Ecological assessment"},{"text":"Environmental planning"},{"text":"Restoration"},{"text":"Biodiversity"}]},{"type":"h","text":"GIS / Planning Firms"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Spatial analysis"},{"text":"Mapping"},{"text":"Site suitability"},{"text":"Land-use planning"}]},{"type":"h","text":"Government / Urban Development Projects"},{"type":"p","text":"Where available, gain exposure to:"},{"type":"list","items":[{"text":"Parks"},{"text":"Public spaces"},{"text":"Urban forestry"},{"text":"Streetscape development"},{"text":"Water-sensitive infrastructure"}]}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"type":"p","text":"After B.Arch, possible roles include:"},{"type":"list","items":[{"text":"Landscape Architect"},{"text":"Junior Landscape Architect"},{"text":"Landscape Designer"},{"text":"Landscape Planning Assistant"},{"text":"Site Landscape Designer"},{"text":"Urban Landscape Designer"},{"text":"Public Realm Designer"},{"text":"Landscape Visualization Designer"},{"text":"Landscape BIM/CAD Designer"},{"text":"Urban Design Assistant"},{"text":"Landscape Project Coordinator"},{"text":"Ecological Landscape Designer"}]},{"type":"p","text":"For specialized professional landscape-architecture practice, the graduate should separately verify the current Indian professional education, registration, and practice requirements applicable to the intended role."}]},{"heading":"Employer Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Employer Type","Important Skills"],"rows":[[{"text":"Landscape Architecture Firm"},{"text":"Landscape design + planting + CAD"}],[{"text":"Urban Design Firm"},{"text":"Public realm + GIS + urban design"}],[{"text":"Architecture Firm"}