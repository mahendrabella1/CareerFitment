":"Advanced Specializations"},{"type":"list","items":[{"text":"Ecological Restoration"},{"text":"Climate Resilience"},{"text":"Sustainable Urbanism"},{"text":"Green Infrastructure"},{"text":"Water-Sensitive Urban Design"},{"text":"Environmental Planning"},{"text":"Urban Ecology"}]}]},{"heading":"Career Specializations","kind":"other","blocks":[{"type":"h","text":"1. Urban Landscape Architect"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Parks"},{"text":"Streetscapes"},{"text":"Public plazas"},{"text":"Urban open spaces"}]},{"type":"h","text":"2. Ecological Landscape Architect"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Restoration"},{"text":"Biodiversity"},{"text":"Native landscapes"},{"text":"Habitat creation"}]},{"type":"h","text":"3. Landscape Urbanist"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Landscape + urban planning"},{"text":"Infrastructure"},{"text":"Public realm"},{"text":"Urban systems"}]},{"type":"h","text":"4. Climate-Resilient Landscape Specialist"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Heat"},{"text":"Flooding"},{"text":"Drought"},{"text":"Climate adaptation"},{"text":"Nature-based solutions"}]},{"type":"h","text":"5. Hospitality Landscape Architect"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Resorts"},{"text":"Hotels"},{"text":"Wellness spaces"},{"text":"Golf/resort landscapes"}]},{"type":"h","text":"6. Green Infrastructure Specialist"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Bioswales"},{"text":"Rain gardens"},{"text":"Urban forests"},{"text":"Stormwater systems"},{"text":"Permeable landscapes"}]},{"type":"h","text":"7. GIS / Landscape Analytics Specialist"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Spatial analysis"},{"text":"Environmental mapping"},{"text":"Site suitability"},{"text":"Landscape planning"}]}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"Design Path"},{"ty