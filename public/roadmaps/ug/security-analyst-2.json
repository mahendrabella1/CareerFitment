{"title":"Security Analyst Roadmap","role":"Security Analyst","summary":"Use intentionally vulnerable systems and authorised labs for practice.","facts":{"Current degree":"BCA – Cyber Security / Ethical Hacking"},"about":[],"intro":[],"horizons":[],"sections":[{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"flow","items":["BCA","Cybersecurity Intern","SOC Analyst / Junior Security Analyst","Security Analyst","Senior Security Analyst","Security Engineer / Incident Response Specialist","Security Lead","Security Manager / SOC Manager"]},{"type":"p","text":"Potential sectors:"},{"type":"list","items":[{"text":"Cybersecurity companies"},{"text":"IT services"},{"text":"SaaS"},{"text":"Banking and FinTech"},{"text":"E-commerce"},{"text":"Healthcare"},{"text":"Telecom"},{"text":"Cloud companies"},{"text":"Government"},{"text":"Defence"},{"text":"Consulting"},{"text":"Managed Security Service Providers (MSSPs)"},{"text":"Critical infrastructure"}]}]},{"heading":"What to Build Each Year","kind":"build","blocks":[{"type":"table","header":["Year","Core Learning","Practical Skills"],"rows":[[{"text":"Year 1"},{"text":"Programming, networking, OS, cybersecurity fundamentals"},{"text":"Linux, networking, Python, command line"}],[{"text":"Year 2"},{"text":"Ethical hacking, system security, cryptography"},{"text":"Vulnerability scanning, packet analysis, web-security labs"}],[{"text":"Year 3"},{"text":"SOC, SIEM, incident response, threat intelligence"},{"text":"Log analysis, detection, investigation, security monitoring"}],[{"text":"Year 4"},{"text":"Cloud security, security engineering, advanced defence"},{"text":"Incident-response projects, detection engineering, security automation"}]]},{"type":"h","text":"Year 1 — Computing & Security Foundation"},{"type":"p","text":"Master:"},{"type":"h","text":"Networking"},{"type":"list","items":[{"text":"OSI model"},{"text":"TCP/IP"},{"text":"IPv4/IPv6"},{"text":"DNS"},{"text":"DHCP"},{"text":"HTTP/HTTPS"},{"text":"TCP/UDP