nich"},{"text":"DAAD + university funding"},{"text":"German/English requirements"}],[{"text":"Spain"},{"text":"University of Barcelona, Complutense University of Madrid"},{"text":"University scholarships"},{"text":"Spanish/English requirements"}],[{"text":"Japan"},{"text":"University of Tokyo, Kyoto University"},{"text":"MEXT + university scholarships"},{"text":"Japanese/English + programme requirements"}],[{"text":"South Korea"},{"text":"Seoul National University, Yonsei University"},{"text":"GKS + university scholarships"},{"text":"Korean/English + programme requirements"}],[{"text":"China"},{"text":"Peking University, Tsinghua University"},{"text":"Chinese Government Scholarship"},{"text":"HSK/English + programme requirements"}],[{"text":"UK"},{"text":"University of Edinburgh, University of Leeds"},{"text":"Chevening + university scholarships"},{"text":"Programme requirements"}]]},{"type":"p","text":"For this career, studying in the country where the target language is primarily spoken can provide major advantages in immersion, cultural understanding and advanced proficiency."},{"type":"h","text":"Application pack"},{"type":"list","items":[{"text":"BA transcript"},{"text":"Foreign-language proficiency certificate"},{"text":"Teaching portfolio"},{"text":"SOP"},{"text":"Recommendation letters"},{"text":"CV"},{"text":"Writing/translation samples"},{"text":"Teaching experience"},{"text":"English-language test if required"},{"text":"Scholarship application"}]}]},{"heading":"Going forward","kind":"growth","blocks":[{"type":"h","text":"Career progression"},{"type":"flow","items":["Language Trainer","Senior Language Trainer","Academic Coordinator","Language Training Manager","Head of Language Training"]},{"type":"p","text":"Alternative:"},{"type":"flow","items":["Language Trainer","Curriculum Designer","Senior Curriculum Designer","Language Learning Product Manager"]},{"type":"p","text":"Another route:"},{"type":"flow","items":["Language Trainer","Translator/Localization Specialist","Senior Localization Specialist","Localization Manager"]},{"type":"h","text":"Entrepreneurship"},{"type":"p","text":"With experience, a language professional can establish:"},{"type":"list","items":[{"text":"Foreign-language training institute"},{"text":"Online language academy"},{"text":"Corporate language-training service"},{"text":"Language tutoring platform"},{"text":"Translation/localisation agency"},{"text":"Language-learning content business"},{"text":"Exam-preparation academy"}]},{"type":"h","text":"2040–2046"},{"type":"p","text":"The strongest senior profile will combine advanced multilingual proficiency, teaching expertise, curriculum design, technology and AI-enabled learning. Experienced trainers can move from classroom teaching into academic leadership, curriculum design, corporate training, language-learning products, consulting or their own language-education business."}]}]}