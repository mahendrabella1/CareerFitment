hics"},{"type":"p","text":"This is critical for social research involving people."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Informed consent"},{"text":"Confidentiality"},{"text":"Anonymisation"},{"text":"Voluntary participation"},{"text":"Protection of vulnerable populations"},{"text":"Ethical interviewing"},{"text":"Data security"},{"text":"Researcher positionality"},{"text":"Avoiding researcher bias"},{"text":"Responsible publication"},{"text":"Institutional ethics procedures"}]},{"type":"p","text":"Never collect sensitive personal information simply because it is technically possible to do so."},{"type":"h","text":"Specialisation"},{"type":"table","header":["Lane","Core stack","Learn from","Senior role it leads to"],"rows":[[{"text":"Social Anthropology"},{"text":"Culture + ethnography + fieldwork"},{"text":"Anthropology research"},{"text":"Senior Social Researcher"}],[{"text":"Development Research"},{"text":"Communities + livelihoods + evaluation"},{"text":"Development organisations"},{"text":"Development Research Lead"}],[{"text":"Public Health Research"},{"text":"Anthropology + health + epidemiology"},{"text":"Public-health institutes"},{"text":"Social/Health Researcher"}],[{"text":"Tribal Studies"},{"text":"Indigenous communities + ethnography"},{"text":"Field research"},{"text":"Tribal Research Specialist"}],[{"text":"Gender Research"},{"text":"Gender + social structures + qualitative methods"},{"text":"Development research"},{"text":"Gender Research Specialist"}],[{"text":"Migration Research"},{"text":"Migration + demography + surveys"},{"text":"Population studies"},{"text":"Migration Researcher"}],[{"text":"Policy Research"},{"text":"Research + economics + policy"},{"text":"Think tanks"},{"text":"Policy Researcher"}],[{"text":"Market/Social Research"},{"text":"Surveys + consumer behaviour + statistics"},{"text":"Research firms"},{"text":"Social/Market Research Lead"}],[{"text":"GIS & Spatial Research"},{"text":"Anthropology + GIS + sp