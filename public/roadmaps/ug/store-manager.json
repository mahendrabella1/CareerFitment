":"Cost price"},{"text":"Selling price"},{"text":"Markup"},{"text":"Gross margin"},{"text":"Markdown"},{"text":"Discount"},{"text":"Promotional pricing"},{"text":"Bundle pricing"},{"text":"Clearance sales"}]},{"type":"p","text":"Important distinction:"},{"type":"h","text":"Markup ≠ Margin"},{"type":"p","text":"For example, if an item costs ₹100 and sells for ₹125:"},{"type":"list","items":[{"text":"Markup = 25%"},{"text":"Gross margin = 20%"}]},{"type":"p","text":"Understanding this distinction is important for store profitability."}]},{"heading":"Store Profitability","kind":"other","blocks":[{"type":"p","text":"A Store Manager should understand the store's financial performance."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Revenue"},{"text":"COGS"},{"text":"Gross profit"},{"text":"Rent"},{"text":"Utilities"},{"text":"Staff costs"},{"text":"Marketing costs"},{"text":"Operating expenses"},{"text":"Store contribution"},{"text":"Shrinkage"},{"text":"Profitability"}]},{"type":"p","text":"Basic structure:"},{"type":"h","text":"Revenue − COGS = Gross Profit"},{"type":"h","text":"Gross Profit − Operating Expenses = Operating Contribution/Profit"},{"type":"p","text":"The exact accounting treatment varies by organization."}]},{"heading":"Workforce Management","kind":"other","blocks":[{"type":"p","text":"Store Managers manage frontline teams."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Workforce planning"},{"text":"Shift scheduling"},{"text":"Attendance"},{"text":"Staff allocation"},{"text":"Productivity"},{"text":"Training"},{"text":"Performance reviews"},{"text":"Target allocation"},{"text":"Incentives"},{"text":"Employee engagement"},{"text":"Conflict management"}]},{"type":"h","text":"Staff Scheduling"},{"type":"p","text":"Consider:"},{"type":"list","items":[{"text":"Store traffic"},{"text":"Peak hours"},{"text":"Weekends"},{"text":"Holidays"},{"text":"Promotions"},{"text":"Staff availability"},{"text":"Required skill mix"}]},{"type"