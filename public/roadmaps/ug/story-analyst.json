ation options"},{"type":"h","text":"Feature Films"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"90–150 minute structures"},{"text":"Character arcs"},{"text":"Genre expectations"},{"text":"Commercial storytelling"}]},{"type":"h","text":"Television/Web Series"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Episode structure"},{"text":"Season arcs"},{"text":"Character continuity"},{"text":"Episode hooks"},{"text":"Cliffhangers"}]},{"type":"h","text":"Animation"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Visual storytelling"},{"text":"Age groups"},{"text":"Character-driven narratives"},{"text":"World-building"}]},{"type":"h","text":"Adaptation"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Book-to-screen adaptation"},{"text":"Rights"},{"text":"Adaptation choices"},{"text":"Narrative compression"}]},{"type":"h","text":"Regional/International Content"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Cultural context"},{"text":"Local storytelling traditions"},{"text":"Translation"},{"text":"Localization"},{"text":"Cross-cultural narratives"}]},{"type":"h","text":"Project"},{"type":"h","text":"Streaming Series Development Analysis"},{"type":"p","text":"Evaluate an existing series for:"},{"type":"list","items":[{"text":"Season premise"},{"text":"Episode structure"},{"text":"Character arcs"},{"text":"Audience"},{"text":"Genre"},{"text":"Pacing"},{"text":"Retention potential"}]},{"type":"h","text":"Year 4 — Professional Story Development"},{"type":"p","text":"For a 4-year Honours programme, move toward professional development work."},{"type":"h","text":"Advanced story analysis"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Comparative script analysis"},{"text":"Story development notes"},{"text":"Character diagnostics"},{"text":"Narrative restructuring"},{"text":"Audience testing"},{"text":"Adaptation analysis"},{"text":"Franchise/world-building analysis"}]},{"type":"