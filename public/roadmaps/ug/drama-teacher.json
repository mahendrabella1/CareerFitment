ingapore"}]},{"type":"p","text":"Potential programmes:"},{"type":"list","items":[{"text":"MA Theatre"},{"text":"MFA Acting"},{"text":"MA Drama Education"},{"text":"MA Applied Theatre"},{"text":"MA Theatre Education"},{"text":"MA Performing Arts"},{"text":"MA Arts Education"},{"text":"MFA Directing"}]},{"type":"p","text":"Applied Theatre is particularly relevant for students interested in using theatre in education, community development and social programmes."}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"Education Route"},{"type":"flow","items":["BA Performing Arts","Drama/Teaching Internship","Drama Teacher","Senior Drama Teacher","Performing Arts Coordinator","Head of Performing Arts","Performing Arts Director"]},{"type":"h","text":"Theatre-Education Route"},{"type":"flow","items":["BA Performing Arts","Theatre Education Assistant","Theatre Educator","Drama Programme Coordinator","Theatre Education Specialist","Theatre Education Director"]},{"type":"h","text":"Academic Route"},{"type":"flow","items":["BA","MA/MFA","NET/SET where applicable","PhD","Assistant Professor","Associate Professor","Professor / Researcher"]},{"type":"h","text":"Research Opportunities"},{"type":"p","text":"Possible research areas include:"},{"type":"list","items":[{"text":"Theatre-based learning"},{"text":"Drama and student confidence"},{"text":"Theatre and communication skills"},{"text":"Improvisation in education"},{"text":"Performing arts and creativity"},{"text":"Theatre for social change"},{"text":"Inclusive theatre education"},{"text":"Children's theatre"},{"text":"Arts-based assessment"},{"text":"Theatre and emotional development"},{"text":"Digital theatre education"},{"text":"AI-assisted theatre education"},{"text":"Virtual performance environments"}]},{"type":"h","text":"Future Skills — 2030+"},{"type":"p","text":"The role will increasingly combine performing arts, education and technology."},{"type":"h","text":"Emerging Skills"},{"type":"list","