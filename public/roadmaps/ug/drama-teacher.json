":"Production planning"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Video editing"},{"text":"Digital storytelling"},{"text":"LMS"},{"text":"Presentation design"},{"text":"AI-assisted content creation"},{"text":"XR/virtual theatre fundamentals"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Communication"},{"text":"Leadership"},{"text":"Facilitation"},{"text":"Collaboration"},{"text":"Research"},{"text":"Project management"}]},{"type":"h","text":"Target Profile"},{"type":"flow","items":["BA Performing Arts","Drama/Teaching Internship","Drama Teacher","Senior Drama Teacher","Performing Arts Coordinator","Head of Performing Arts","Performing Arts Director"]},{"type":"p","text":"For formal school teaching, add the required teacher-training/eligibility qualification; for university teaching and research, plan for MA/MFA + relevant eligibility + PhD."}]}]}