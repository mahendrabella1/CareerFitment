{"title":"Drama Teacher Roadmap","role":"Drama Teacher","summary":"","facts":{"Current degree":"BA (Bachelor of Arts – General / Honours)"},"about":[],"intro":[],"horizons":[],"sections":[{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Stage","Typical Role"],"rows":[[{"text":"UG"},{"text":"Performing Arts Student"}],[{"text":"Internship"},{"text":"Theatre/Drama Teaching Intern"}],[{"text":"Entry"},{"text":"Drama Teacher / Theatre Instructor"}],[{"text":"Early Career"},{"text":"Senior Drama Teacher / Theatre Facilitator"}],[{"text":"Mid Career"},{"text":"Performing Arts Coordinator / Theatre Director"}],[{"text":"Senior"},{"text":"Head of Performing Arts"}],[{"text":"Leadership"},{"text":"Performing Arts Director / Arts Education Head"}],[{"text":"Advanced"},{"text":"Theatre Educator / Professor / Researcher"}]]}]},{"heading":"What to Build Each Year","kind":"build","blocks":[{"type":"h","text":"Year 1 — Performing Arts Foundation"},{"type":"h","text":"Academic"},{"type":"list","items":[{"text":"Theatre history"},{"text":"Indian and Western drama"},{"text":"Acting fundamentals"},{"text":"Voice and speech"},{"text":"Movement and body expression"},{"text":"Introduction to dance"},{"text":"Performance studies"},{"text":"Communication skills"},{"text":"Basics of educational psychology"}]},{"type":"h","text":"Skills"},{"type":"list","items":[{"text":"Stage presence"},{"text":"Improvisation"},{"text":"Storytelling"},{"text":"Voice modulation"},{"text":"Public speaking"},{"text":"Basic script reading"},{"text":"Group facilitation"}]},{"type":"note","label":"Practical project","text":"Conduct a short drama workshop for school students and document the lesson plan, activities and outcomes."},{"type":"h","text":"Year 2 — Acting + Teaching Skills"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Acting techniques"},{"text":"Character development"},{"text":"Theatre games"},{"text":"Improvisational theatre"},{"text":"Script analysis"},{"text":"Stage direction"},{"text":"Costume and makeup basics"},{"text":"Stage design"},{"text":"Theatre production"},{"text":"Child/adolescent development"},{"text":"Classroom management"},{"text":"Lesson planning"}]},{"type":"p","text":"Build competence in:"},{"type":"list","items":[{"text":"Canva"},{"text":"PowerPoint"},{"text":"Video editing"},{"text":"Basic audio recording"},{"text":"Digital classroom tools"}]},{"type":"note","label":"Project","text":"Create a 10-session drama curriculum for students aged 10–16."},{"type":"h","text":"Year 3 — Drama Pedagogy"},{"type":"p","text":"Focus on the combination of theatre + education."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Drama pedagogy"},{"text":"Theatre-in-education"},{"text":"Experiential learning"},{"text":"Project-based learning"},{"text":"Inclusive theatre"},{"text":"Assessment of performing arts"},{"text":"Facilitation techniques"},{"text":"Scriptwriting"},{"text":"Directing"},{"text":"Production management"},{"text":"Theatre for social development"}]},{"type":"note","label":"Practical project","text":"Produce a complete student theatre production from script selection through performance."},{"type":"h","text":"Year 4 — Professional Drama Education"},{"type":"p","text":"Develop advanced capability in:"},{"type":"list","items":[{"text":"Curriculum design"},{"text":"Performing-arts programme development"},{"text":"Theatre direction"},{"text":"Advanced acting"},{"text":"Stage production"},{"text":"Arts administration"},{"text":"Digital theatre"},{"text":"Theatre documentation"},{"text":"Inclusive and accessible performing arts"},{"text":"Educational technology"},{"text":"AI-assisted content creation"}]},{"type":"note","label":"Final project","text":"Design and deliver a semester-long Drama Education Programme including curriculum, lesson plans, student assessments and final production."},{"type":"h","text":"4-Year Honours / Advanced Track"},{"type":"table","header":["Year","Academic F