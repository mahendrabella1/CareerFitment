ompanies"},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"GIS"},{"text":"Spatial analytics"},{"text":"Remote sensing"},{"text":"Urban data"}]},{"type":"h","text":"Real Estate / Infrastructure Companies"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Land development"},{"text":"Feasibility"},{"text":"Infrastructure"},{"text":"Development regulations"}]}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"type":"p","text":"After B.Plan, possible roles include:"},{"type":"list","items":[{"text":"Urban Planner"},{"text":"Junior Urban Planner"},{"text":"Assistant Planner"},{"text":"Town Planner"},{"text":"Development Planner"},{"text":"Land-Use Planner"},{"text":"Regional Planning Assistant"},{"text":"GIS Planner"},{"text":"Urban Research Analyst"},{"text":"Transport Planning Assistant"},{"text":"Housing Planner"},{"text":"Infrastructure Planning Analyst"},{"text":"Urban Design Assistant"},{"text":"Smart City Analyst"},{"text":"Urban Data Analyst"},{"text":"Planning Consultant"}]}]},{"heading":"Employer Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Employer Type","Important Skills"],"rows":[[{"text":"Urban Planning Consultancy"},{"text":"Planning + GIS + report writing"}],[{"text":"Government Planning Agency"},{"text":"Regulations + planning + policy"}],[{"text":"Municipal Corporation"},{"text":"Land use + infrastructure + public services"}],[{"text":"Transport Consultancy"},{"text":"Mobility + GIS + transport modelling"}],[{"text":"Real Estate Developer"},{"text":"Land planning + feasibility + regulations"}],[{"text":"Infrastructure Consultancy"},{"text":"Infrastructure + GIS + planning"}],[{"text":"GIS Company"},{"text":"Spatial analysis + data"}],[{"text":"Smart City / Urban Tech"},{"text":"GIS + Python + data analytics"}],[{"text":"Research Organization"},{"text":"Planning + statistics + research"}],[{"text":"International Development Organization"},{"text":"Urban development + policy + stak