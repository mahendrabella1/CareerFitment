st"},{"type":"h","text":"Field Veterinary Services"},{"type":"h","text":"Senior Veterinary / Administrative Role"},{"type":"h","text":"Possible responsibilities include:"},{"type":"h","text":"Livestock disease control"},{"type":"h","text":"Vaccination programmes"},{"type":"h","text":"Veterinary clinical services"},{"type":"h","text":"Animal-health camps"},{"type":"h","text":"Disease surveillance"},{"type":"h","text":"Farmer education"},{"type":"h","text":"Food safety"},{"type":"h","text":"Zoonotic disease control"},{"type":"h","text":"Government livestock programmes"},{"type":"p","text":"Exact post titles and eligibility vary by state and recruiting authority."}]},{"heading":"Entrepreneurship Opportunities","kind":"other","blocks":[{"type":"p","text":"Veterinary graduates can eventually explore:"},{"type":"h","text":"Clinical"},{"type":"h","text":"Veterinary clinic"},{"type":"h","text":"Pet hospital"},{"type":"h","text":"Mobile veterinary service"},{"type":"h","text":"Preventive-care practice"},{"type":"h","text":"Animal Services"},{"type":"h","text":"Pet wellness services"},{"type":"h","text":"Animal rehabilitation"},{"type":"h","text":"Pet nutrition advisory services"},{"type":"h","text":"Animal-care businesses"},{"type":"h","text":"Livestock"},{"type":"h","text":"Dairy consultancy"},{"type":"h","text":"Herd-health services"},{"type":"h","text":"Poultry health consultancy"},{"type":"h","text":"Livestock management services"},{"type":"h","text":"Technology"},{"type":"h","text":"Veterinary telehealth platforms"},{"type":"h","text":"Pet health applications"},{"type":"h","text":"Animal-health analytics"},{"type":"h","text":"Livestock monitoring systems"},{"type":"p","text":"Business operations must comply with applicable veterinary, professional, animal-welfare, medicine, and local regulatory requirements."}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"h","text":"0–2 Years"},{"type":"h","text":"Veterinary intern"},{"type":"h","text":"Junior vete