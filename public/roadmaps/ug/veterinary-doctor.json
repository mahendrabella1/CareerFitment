"},{"type":"h","text":"Nutrition"},{"type":"h","text":"Disease surveillance"},{"type":"h","text":"Production management"},{"type":"h","text":"Wildlife"},{"type":"p","text":"Requires additional specialized training and institutional exposure."}]},{"heading":"Diagnostic Skill Stack","kind":"other","blocks":[{"type":"p","text":"Veterinary doctors should understand the purpose and limitations of diagnostic investigations."},{"type":"h","text":"Laboratory"},{"type":"h","text":"CBC"},{"type":"h","text":"Blood biochemistry"},{"type":"h","text":"Urinalysis"},{"type":"h","text":"Faecal examination"},{"type":"h","text":"Cytology"},{"type":"h","text":"Microbiology"},{"type":"h","text":"Parasitology"},{"type":"h","text":"Imaging"},{"type":"h","text":"Radiography"},{"type":"h","text":"Ultrasonography"},{"type":"h","text":"Advanced imaging where available"},{"type":"h","text":"Diagnostic Reasoning"},{"type":"h","text":"Clinical Signs"},{"type":"h","text":"+"},{"type":"h","text":"History"},{"type":"h","text":"+"},{"type":"h","text":"Physical Examination"},{"type":"h","text":"Differential Diagnoses"},{"type":"h","text":"Diagnostic Tests"},{"type":"h","text":"Evidence Integration"},{"type":"h","text":"Working / Confirmed Diagnosis"}]},{"heading":"Veterinary Public Health","kind":"other","blocks":[{"type":"p","text":"Veterinarians play a major role in One Health, connecting animal, human and environmental health."},{"type":"h","text":"Key Areas"},{"type":"h","text":"Zoonotic diseases"},{"type":"h","text":"Rabies prevention and control"},{"type":"h","text":"Food safety"},{"type":"h","text":"Meat inspection"},{"type":"h","text":"Milk hygiene"},{"type":"h","text":"Disease surveillance"},{"type":"h","text":"Outbreak investigation"},{"type":"h","text":"Antimicrobial stewardship"},{"type":"h","text":"Environmental health"},{"type":"h","text":"One Health Model"},{"type":"h","text":"HUMAN HEALTH"},{"type":"h","text":"▲"},{"type":"h","text":"│"},{"type":"h","text":"│"},{"type":"h","text":"ANI