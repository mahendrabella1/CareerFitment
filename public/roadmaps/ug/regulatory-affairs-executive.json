"},{"text":"Regulatory framework knowledge"}],[{"text":"Regulatory Documentation"},{"text":"Accurate submission documents"}],[{"text":"Dossier Preparation"},{"text":"Structured regulatory submissions"}],[{"text":"Quality"},{"text":"GMP/QA understanding"}],[{"text":"Drug Development"},{"text":"Product lifecycle knowledge"}],[{"text":"Clinical Research"},{"text":"Trial/regulatory awareness"}],[{"text":"Labeling"},{"text":"Label/package compliance"}],[{"text":"Regulatory Intelligence"},{"text":"Tracking regulatory changes"}],[{"text":"Communication"},{"text":"Professional correspondence"}],[{"text":"Project Management"},{"text":"Submission coordination"}],[{"text":"Data Management"},{"text":"Regulatory tracking"}],[{"text":"Technical Writing"},{"text":"Clear regulatory documents"}],[{"text":"Digital Tools"},{"text":"Excel/document systems"}],[{"text":"Global Regulations"},{"text":"International market awareness"}]]}]},{"heading":"Regulatory Affairs Workflow","kind":"other","blocks":[{"type":"p","text":"A regulatory professional should understand the entire product lifecycle."},{"type":"h","text":"Drug Development"},{"type":"h","text":"Preclinical Development"},{"type":"h","text":"Clinical Development"},{"type":"h","text":"Regulatory Strategy"},{"type":"h","text":"Dossier Preparation"},{"type":"h","text":"Submission"},{"type":"h","text":"Regulatory Review"},{"type":"h","text":"Questions / Deficiencies"},{"type":"h","text":"Response Preparation"},{"type":"h","text":"Approval"},{"type":"h","text":"Commercialization"},{"type":"h","text":"Post-Marketing Changes"},{"type":"h","text":"Renewal / Lifecycle Management"}]},{"heading":"Regulatory Dossier Knowledge","kind":"other","blocks":[{"type":"p","text":"Learn how regulatory information is organized."},{"type":"p","text":"A major international framework is the Common Technical Document (CTD) structure."},{"type":"h","text":"Typical modules include:"},{"type":"table","header":["Module","Broad Content"],"rows":[[{"text":"Module 1"},{"text":"Regional administrative information"}],[{"text":"Module 2"},{"text":"Summaries and overviews"}],[{"text":"Module 3"},{"text":"Quality / CMC"}],[{"text":"Module 4"},{"text":"Nonclinical information"}],[{"text":"Module 5"},{"text":"Clinical information"}]]},{"type":"p","text":"The exact submission structure and requirements depend on the country, product category and regulatory pathway."}]},{"heading":"Quality / CMC Knowledge","kind":"other","blocks":[{"type":"p","text":"One of the most valuable skills is understanding Chemistry, Manufacturing and Controls (CMC)."},{"type":"h","text":"Learn:"},{"type":"h","text":"Active pharmaceutical ingredient"},{"type":"h","text":"Excipients"},{"type":"h","text":"Manufacturing process"},{"type":"h","text":"Specifications"},{"type":"h","text":"Analytical methods"},{"type":"h","text":"Validation"},{"type":"h","text":"Stability"},{"type":"h","text":"Packaging"},{"type":"h","text":"Batch information"},{"type":"h","text":"Quality control"},{"type":"h","text":"Quality assurance"},{"type":"h","text":"Understand the relationship:"},{"type":"h","text":"R&D"},{"type":"h","text":"Formulation"},{"type":"h","text":"Manufacturing"},{"type":"h","text":"Quality Control"},{"type":"h","text":"Quality Assurance"},{"type":"h","text":"Regulatory Affairs"},{"type":"h","text":"Regulatory Submission"}]},{"heading":"Drug Development Knowledge","kind":"other","blocks":[{"type":"h","text":"Understand the lifecycle:"},{"type":"h","text":"Discovery"},{"type":"h","text":"Target identification"},{"type":"h","text":"Lead development"},{"type":"h","text":"Preclinical research"},{"type":"h","text":"Preclinical"},{"type":"h","text":"Pharmacology"},{"type":"h","text":"Toxicology"},{"type":"h","text":"Animal studies"},{"type":"h","text":"Clinical"},{"type":"h","text":"Phase I"},{"type":"h","text":"Phase II"},{"type":"h","text":"Phase III"},{"type":"h","text":"Post-marketing studies"},{"type":"h","text":"Regulatory"},{"type":"h","text":"Submission"},{"typ