"},{"text":"Observation"},{"text":"Exit tickets"}]},{"type":"h","text":"Summative assessment"},{"type":"p","text":"Used to evaluate learning:"},{"type":"list","items":[{"text":"Term examinations"},{"text":"Unit tests"},{"text":"Projects"},{"text":"Final examinations"}]},{"type":"h","text":"Assessment cycle"},{"type":"flow","items":["Teach","Assess","Analyze","Identify Learning Gaps","Remediate","Reassess"]}]},{"heading":"Student Performance Analytics","kind":"other","blocks":[{"type":"p","text":"Modern teachers can use data to identify learning gaps."},{"type":"h","text":"Useful metrics"},{"type":"list","items":[{"text":"Attendance"},{"text":"Test scores"},{"text":"Assignment completion"},{"text":"Topic-wise performance"},{"text":"Learning progress"},{"text":"Remedial outcomes"}]},{"type":"h","text":"Example"},{"type":"flow","items":["Student Scores","Topic Analysis","Weak Concepts","Remedial Teaching","Retest","Progress Tracking"]},{"type":"h","text":"Digital tools"},{"type":"list","items":[{"text":"Excel"},{"text":"Google Sheets"},{"text":"Power BI"},{"text":"Learning Management Systems"}]}]},{"heading":"Educational Technology","kind":"other","blocks":[{"type":"p","text":"A modern government teacher should be comfortable with digital teaching."},{"type":"h","text":"Essential tools"},{"type":"list","items":[{"text":"PowerPoint"},{"text":"Google Workspace"},{"text":"Microsoft Office"},{"text":"Digital whiteboards"},{"text":"Online quizzes"},{"text":"Video-conferencing platforms"},{"text":"Learning-management systems"}]},{"type":"h","text":"AI-assisted teaching"},{"type":"p","text":"Teachers can use AI responsibly for:"},{"type":"list","items":[{"text":"Lesson-plan ideas"},{"text":"Question generation"},{"text":"Differentiated worksheets"},{"text":"Quiz creation"},{"text":"Content summarization"},{"text":"Rubric drafting"},{"text":"Learning-resource creation"},{"text":"However, teachers should verify AI-generated content, especially factual and curriculum-related material."}]}]},{"heading":"Inclusive Education","kind":"other","blocks":[{"type":"p","text":"A government teacher should understand how to support learners with different needs."},{"type":"h","text":"Areas"},{"type":"list","items":[{"text":"Learning difficulties"},{"text":"Disability inclusion"},{"text":"Language differences"},{"text":"Socioeconomic barriers"},{"text":"Neurodiversity"},{"text":"Different learning levels"}]},{"type":"h","text":"Differentiated teaching"},{"type":"flow","items":["Same Learning Objective","Different Learning Support","Different Activities","Different Practice Levels","Common Assessment Goal"]}]},{"heading":"Communication Skills","kind":"other","blocks":[{"type":"h","text":"Teacher communication"},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"Public speaking"},{"text":"Explanation"},{"text":"Questioning"},{"text":"Active listening"},{"text":"Feedback"},{"text":"Conflict resolution"},{"text":"Parent communication"}]},{"type":"h","text":"Professional communication"},{"type":"p","text":"Teachers may interact with:"},{"type":"list","items":[{"text":"Students"},{"text":"Parents"},{"text":"Head teachers"},{"text":"School administrators"},{"text":"Other teachers"},{"text":"Education officers"},{"text":"Community stakeholders"}]}]},{"heading":"TET Preparation Strategy","kind":"other","blocks":[{"type":"p","text":"A candidate should prepare according to the exact TET notification and paper applicable to the intended teaching level."},{"type":"h","text":"Common preparation areas"},{"type":"list","items":[{"text":"Child development and pedagogy"},{"text":"Language"},{"text":"Subject knowledge"},{"text":"Teaching methodology"},{"text":"Educational psychology"},{"text":"Inclusive education"}]},{"type":"h","text":"Preparation workflow"},{"type":"flow","items":["Identify Target Teaching Level","Check Current Eligibility","Download Official Syllabus","Build Subject-Wise Plan","Study Concepts","Solve Previous Papers","Mock Tests","Analyze