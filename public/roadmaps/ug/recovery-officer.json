"},{"type":"list","items":[{"text":"Insolvency & Bankruptcy"},{"text":"Financial Regulation"},{"text":"Risk Management"},{"text":"Compliance"}]}]},{"heading":"Career Specializations","kind":"other","blocks":[{"type":"h","text":"1. Loan Recovery"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Retail loans"},{"text":"Business loans"},{"text":"Corporate debt"}]},{"type":"h","text":"2. Legal Recovery"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Notices"},{"text":"Litigation"},{"text":"Tribunal proceedings"},{"text":"Enforcement"}]},{"type":"h","text":"3. Secured Recovery"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Property"},{"text":"Vehicles"},{"text":"Security interests"}]},{"type":"h","text":"4. Insolvency"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Corporate insolvency"},{"text":"Resolution"},{"text":"Liquidation"}]},{"type":"h","text":"5. Credit Legal"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Loan documentation"},{"text":"Security"},{"text":"Legal due diligence"}]},{"type":"h","text":"6. Insurance Recovery"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Claims"},{"text":"Subrogation"},{"text":"Disputes"}]},{"type":"h","text":"7. Recovery Analytics"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Portfolio analytics"},{"text":"Default prediction"},{"text":"Recovery optimization"}]}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"flow","items":["Legal / Banking Intern","Legal Recovery Executive","Recovery Officer","Senior Recovery Officer","Recovery Manager","Senior Recovery Manager","Regional Recovery Head","Head – Collections / Recovery","Credit / Risk / Recovery Leadership"]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"h","text":"0–2 Years"},{"type":"p","text":"Build:"},{"type":"list","items":[{"text":"Banking law"},{"text":"Loan documentation"},{"text":"Recovery procedures"},{"text":"Finance fundamentals"},{"text":"Negotiation"}]},{"type":"h","text":"2–5 Years"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Legal Recovery Executive"},{"text":"Recovery Officer"},{"text":"Banking Legal Executive"},{"text":"Collections Legal Specialist"}]},{"type":"h","text":"5–10 Years"},{"type":"p","text":"Progress toward:"},{"type":"list","items":[{"text":"Senior Recovery Officer"},{"text":"Recovery Manager"},{"text":"Legal Recovery Manager"},{"text":"Credit Recovery Specialist"}]},{"type":"h","text":"10+ Years"},{"type":"p","text":"Potential leadership:"},{"type":"list","items":[{"text":"Regional Recovery Head"},{"text":"National Recovery Manager"},{"text":"Head – Collections"},{"text":"Head – Recovery"},{"text":"Credit & Risk Leadership"}]}]},{"heading":"Target Profile at Graduation","kind":"other","blocks":[{"type":"p","text":"A strong candidate should have:"},{"type":"h","text":"Legal Knowledge"},{"type":"list","items":[{"text":"Banking law"},{"text":"Contract law"},{"text":"Recovery law"},{"text":"SARFAESI framework"},{"text":"Debt-recovery framework"},{"text":"Insolvency law"},{"text":"Consumer law"},{"text":"Insurance law fundamentals"}]},{"type":"h","text":"Finance Knowledge"},{"type":"list","items":[{"text":"Loans"},{"text":"Interest"},{"text":"EMI"},{"text":"Credit"},{"text":"Collateral"},{"text":"Financial statements"},{"text":"Default"}]},{"type":"h","text":"Practical Skills"},{"type":"list","items":[{"text":"Loan-document review"},{"text":"Recovery documentation"},{"text":"Legal research"},{"text":"Negotiation"},{"text":"Case tracking"},{"text":"Compliance"}]},{"type":"h","text":"Portfolio"},{"type":"p","text":"Ideally:"},{"type":"list","items":[{"text":"Loan recovery case study"},{"text":"Loan documentation audit"},{"text":"SARFAESI case analysis"},{"text":"IBC case study"},{"text":"Recovery dashboard"},{"text":"Mock settlement negotiation"},{"text":"2+ banking/recovery internships"}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"p","text":"Integrated Law Degree"},{"type":"p","text":"+"},{"type":"p","text":"Banking Law"},{"type":"p","text":"+"},{"type":"p","text":"Recovery Law"},{"type":"p","text":"+"},{"type":"p","text":"Contract Law"},{"type":"p","text":"+"},{"type":"p","text":"SARFAESI Awareness"},{"type":"p","text":"+"},{"type":"p","text":"Debt Recovery"},{"type":"p","text":"+"},{"type":"p","text":"Insolvency & Bankruptcy"},{"type":"p","text":"+"},{"type":"p","text":"Loan Documentation"},{"type":"p","text":"+"},{"type":"p","text":"Credit Fundamentals"},{"type":"p","text":"+"},{"type":"p","text":"Negotiation"},{"type":"p","text":"+"},{"type":"p","text":"Legal Research"},{"type":"p","text":"+"},{"type":"p","text":"Compliance"},{"type":"p","text":"+"},{"type":"p","text":"Recovery Analytics"},{"type":"p","text":"+"},{"type":"p","text":"Excel / Power BI"},{"type":"p","text":"+"},{"type":"p","text":"Banking Technology"},{"type":"p","text":"+"},{"type":"p","text":"Professional Borrower Communication"},{"type":"p","text":"+"},{"type":"p","text":"Banking / Recovery Internship"}]},{"heading":"Best Overall Positioning","kind":"other","blocks":[{"type":"flow","items":["Integrated Law Degree","Banking & Financial Law","Recovery/Banking Internship","Loan Documentation + Recovery Law","Legal Recovery Executive","Recovery Officer","Senior Recovery Officer","Recovery Manager","Regional/National Recovery Leadership"]},{"type":"p","text":"The strongest candidate combines legal knowledge with financial and operational understanding. A Recovery Officer should be able to understand the loan, verify the contractual and security documents, identify the applicable recovery mechanism, communicate professionally with borrowers, coordinate with legal teams, track cases and payments, and ensure that recovery activity remains within applicable law and institutional policy."},{"type":"h","text":"Core formula:"},{"type":"flow","items":["Banking Law","Recovery Law","Finance","Loan Documentation","Negotiation","Compliance","Recovery Analytics = Strong Recovery Officer Profile"],"sep":"+"}]}]}