ming"},{"type":"p","text":"+"},{"type":"p","text":"Fusing / Slumping / Casting"},{"type":"p","text":"+"},{"type":"p","text":"Coldworking"},{"type":"p","text":"+"},{"type":"p","text":"Colour & Surface Design"},{"type":"p","text":"+"},{"type":"p","text":"Material Research"},{"type":"p","text":"+"},{"type":"p","text":"Rhino / Blender"},{"type":"p","text":"+"},{"type":"p","text":"Digital Fabrication"},{"type":"p","text":"+"},{"type":"p","text":"Sustainable Material Practice"},{"type":"p","text":"+"},{"type":"p","text":"Portfolio Documentation"},{"type":"p","text":"+"},{"type":"p","text":"Studio Experience"},{"type":"p","text":"+"},{"type":"p","text":"Entrepreneurship"},{"type":"p","text":"+"},{"type":"p","text":"AI-Assisted Concept Development"}]},{"heading":"Target Progression","kind":"growth","blocks":[{"type":"h","text":"Year 1"},{"type":"h","text":"Material Explorer"},{"type":"p","text":"Understand design fundamentals, sculpture and glass as a material."},{"type":"h","text":"Year 2"},{"type":"h","text":"Glass Craft Practitioner"},{"type":"p","text":"Develop competence in forming, kiln processes and finishing."},{"type":"h","text":"Year 3"},{"type":"h","text":"Glass Designer"},{"type":"p","text":"Create sophisticated objects, collections and installations."},{"type":"h","text":"Year 4"},{"type":"h","text":"Emerging Glass Artist"},{"type":"p","text":"Develop a distinct artistic identity and professional portfolio."},{"type":"h","text":"0–3 Years After Graduation"},{"type":"h","text":"Studio Artist / Glass Designer"},{"type":"p","text":"Build technical depth, commissions and professional networks."},{"type":"h","text":"5–10 Years"},{"type":"h","text":"Established Glass Artist / Studio Lead"},{"type":"p","text":"Develop signature work, exhibitions, collaborations and commercial opportunities."},{"type":"h","text":"Long-Term"},{"type":"h","text":"Independent Artist / Studio Founder / International Glass Artist / Educator"}]},{"heading":"Best Profile by Graduation","kind":"other","blocks":[{"type":"p","text":"A strong graduate should ideally have:"},{"type":"list","items":[{"text":"🔥 Strong glassworking fundamentals"},{"text":"🏺 Excellent understanding of form and sculpture"},{"text":"🧪 Material experimentation experience"},{"text":"🛠️ Kiln and coldworking skills"},{"text":"🎨 Strong drawing and visual development"},{"text":"💻 Basic CAD/3D modelling capability"},{"text":"♻️ Understanding of sustainable glass practice"},{"text":"🏛️ At least one architectural/installation project"},{"text":"🧩 A coherent personal collection"},{"text":"📸 Professional artwork documentation"},{"text":"💼 Studio internship/apprenticeship experience"},{"text":"📁 A polished portfolio"},{"text":"🧠 Understanding of pricing, commissions and studio business"}]},{"type":"note","label":"Best career strategy","text":"Graduate not simply as someone who can make glass objects, but as a material-led designer and artist who understands glass technically, develops a distinctive creative language, can work with architects/designers/clients, and can turn experimental ideas into professionally produced artworks and products."}]}]}