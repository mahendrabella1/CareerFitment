:"Luxury products"}]},{"type":"flow","items":["This route combines design","manufacturing","commercial thinking."],"sep":"+"},{"type":"h","text":"F. Experimental / Contemporary Glass Artist"},{"type":"p","text":"Combines glass with:"},{"type":"list","items":[{"text":"Digital fabrication"},{"text":"Projection"},{"text":"Electronics"},{"text":"Light"},{"text":"Sound"},{"text":"Installation"},{"text":"Mixed media"}]}]},{"heading":"Essential Skill Stack","kind":"other","blocks":[{"type":"h","text":"Artistic"},{"type":"list","items":[{"text":"Drawing"},{"text":"Sculpture"},{"text":"Composition"},{"text":"Colour"},{"text":"Visual storytelling"},{"text":"Art history"}]},{"type":"h","text":"Glass"},{"type":"list","items":[{"text":"Kiln forming"},{"text":"Fusing"},{"text":"Slumping"},{"text":"Casting"},{"text":"Hot glass"},{"text":"Coldworking"},{"text":"Polishing"},{"text":"Engraving"},{"text":"Sandblasting"}]},{"type":"h","text":"Technical"},{"type":"list","items":[{"text":"Annealing"},{"text":"Thermal behaviour"},{"text":"Mould making"},{"text":"Glass compatibility"},{"text":"Kiln programming"},{"text":"Material testing"},{"text":"Structural stability"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Rhino"},{"text":"Blender"},{"text":"AutoCAD"},{"text":"Illustrator"},{"text":"Photoshop"},{"text":"Digital fabrication"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Portfolio development"},{"text":"Exhibition planning"},{"text":"Art documentation"},{"text":"Pricing"},{"text":"Commission management"},{"text":"Client communication"},{"text":"Studio management"}]}]},{"heading":"Internships & Apprenticeships","kind":"internships","blocks":[{"type":"p","text":"For glass careers, hands-on studio experience is exceptionally valuable."},{"type":"h","text":"Target opportunities"},{"type":"list","items":[{"text":"Glass studios"},{"text":"Art studios"},{"text":"Craft workshops"},{"text":"Design studios"},{"text":"Lighting companies"},{"text":"A