":[{"text":"Recognized Perfusion Technology qualification"},{"text":"Applicable professional registration/eligibility"},{"text":"BLS/CPR"},{"text":"Infection prevention"},{"text":"Patient safety"},{"text":"Perfusion safety protocols"}]},{"type":"h","text":"Tier 2 — Specialized"},{"type":"p","text":"Develop training in:"},{"type":"list","items":[{"text":"Cardiopulmonary bypass"},{"text":"Advanced perfusion"},{"text":"Blood conservation"},{"text":"Cardioplegia"},{"text":"Pediatric perfusion"},{"text":"Perfusion monitoring"},{"text":"ECMO fundamentals"}]},{"type":"h","text":"Tier 3 — Advanced"},{"type":"list","items":[{"text":"ECMO specialist training"},{"text":"Advanced critical care"},{"text":"Mechanical circulatory support"},{"text":"Clinical research"},{"text":"Healthcare quality"},{"text":"Perfusion education"}]},{"type":"p","text":"The appropriate certification pathway depends on the jurisdiction and institution."}]},{"heading":"PG Options","kind":"pg_india","blocks":[{"type":"p","text":"Potential postgraduate directions include:"},{"type":"h","text":"Perfusion"},{"type":"list","items":[{"text":"M.Sc Perfusion Technology"},{"text":"Advanced Perfusion Technology"},{"text":"Cardiovascular Perfusion programs"}]},{"type":"h","text":"Cardiovascular Sciences"},{"type":"list","items":[{"text":"Cardiovascular technology"},{"text":"Cardiovascular sciences"},{"text":"Cardiac care"}]},{"type":"h","text":"Critical Care"},{"type":"list","items":[{"text":"Critical-care technology"},{"text":"ECMO-related advanced training"}]},{"type":"h","text":"Management"},{"type":"p","text":"For leadership:"},{"type":"list","items":[{"text":"MBA Healthcare Management"},{"text":"Master of Hospital Administration"},{"text":"Healthcare Operations"}]},{"type":"h","text":"Research"},{"type":"list","items":[{"text":"Clinical Research"},{"text":"Biomedical Sciences"},{"text":"Cardiovascular Research"}]}]},{"heading":"Career Specializations","kind":"other","blocks":[{"type":"h","text":"Adult Cardiac