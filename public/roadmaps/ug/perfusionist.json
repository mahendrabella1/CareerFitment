ood conservation"},{"text":"Advanced monitoring"},{"text":"Perfusion emergencies"},{"text":"ECMO fundamentals"}]},{"type":"h","text":"Operating-Room Workflow"},{"type":"flow","items":["Preoperative Assessment","Equipment & Circuit Preparation","Prime & Safety Checks","Patient Monitoring","Cannulation","Initiation of CPB","Maintain Perfusion","Physiological Monitoring","Weaning From CPB","Circuit Management","Post-CPB Documentation"]}]},{"heading":"Cardiopulmonary Bypass Competencies","kind":"other","blocks":[{"type":"p","text":"A developing perfusionist should understand:"},{"type":"h","text":"Pump Management"},{"type":"list","items":[{"text":"Flow management"},{"text":"Venous drainage"},{"text":"Arterial return"},{"text":"Reservoir levels"},{"text":"Pump safety"}]},{"type":"h","text":"Oxygenation"},{"type":"list","items":[{"text":"Oxygenator function"},{"text":"Gas flow"},{"text":"Oxygen delivery"},{"text":"CO₂ removal"},{"text":"Blood-gas monitoring"}]},{"type":"h","text":"Temperature"},{"type":"list","items":[{"text":"Cooling"},{"text":"Rewarming"},{"text":"Temperature monitoring"},{"text":"Heat-exchanger management"}]},{"type":"h","text":"Fluid & Blood Management"},{"type":"list","items":[{"text":"Hemodilution"},{"text":"Hemoconcentration"},{"text":"Blood conservation"},{"text":"Cell salvage"},{"text":"Fluid balance"}]}]},{"heading":"Anticoagulation & Coagulation","kind":"other","blocks":[{"type":"p","text":"Perfusion requires strong understanding of coagulation physiology."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Heparin principles"},{"text":"Anticoagulation monitoring"},{"text":"ACT concepts"},{"text":"Protamine principles"},{"text":"Coagulation pathways"},{"text":"Bleeding risk"},{"text":"Transfusion principles"}]},{"type":"p","text":"The perfusionist must follow the cardiac surgical team's protocols and applicable institutional standards for anticoagulation management."}]},{"heading":"Blood Gas & Acid-Base Management","kind":"other","b