t":"Profit"},{"text":"Finance"},{"text":"Business models"},{"text":"Corporate structures"},{"text":"Commercial risk"}]}]},{"heading":"Target Profile at Graduation","kind":"other","blocks":[{"type":"p","text":"By graduation, a strong candidate should have:"},{"type":"h","text":"Academic"},{"type":"list","items":[{"text":"Strong understanding of core laws"},{"text":"Ability to read statutes"},{"text":"Ability to interpret judgments"},{"text":"Understanding of legal procedure"}]},{"type":"h","text":"Practical"},{"type":"list","items":[{"text":"Multiple internships"},{"text":"Moot-court experience"},{"text":"Legal drafting practice"},{"text":"Case-analysis portfolio"},{"text":"Court exposure"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Legal research ability"},{"text":"Client communication"},{"text":"Negotiation"},{"text":"Professional ethics"},{"text":"Time management"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Legal databases"},{"text":"E-filing awareness"},{"text":"Document management"},{"text":"Legal AI literacy"},{"text":"Digital research"}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"p","text":"3-Year LL.B."},{"type":"p","text":"+"},{"type":"flow","items":["Constitutional","Civil","Criminal","Commercial Law"],"sep":"+"},{"type":"p","text":"+"},{"type":"p","text":"Legal Research"},{"type":"p","text":"+"},{"type":"p","text":"Case Analysis"},{"type":"p","text":"+"},{"type":"p","text":"Legal Writing"},{"type":"p","text":"+"},{"type":"p","text":"Legal Drafting"},{"type":"p","text":"+"},{"type":"p","text":"Court Procedure"},{"type":"p","text":"+"},{"type":"p","text":"Advocacy & Oral Arguments"},{"type":"p","text":"+"},{"type":"p","text":"Negotiation & ADR"},{"type":"p","text":"+"},{"type":"p","text":"Professional Ethics"},{"type":"p","text":"+"},{"type":"p","text":"Client Management"},{"type":"p","text":"+"},{"type":"p","text":"Legal Databases"},{"type":"p","text":"+"},{"type":"p","text":"Digital Legal Practice"},{"type":"p","text":"+"},{"type":"p","text":"AI-Assisted Legal Research"},{"type":"p","text":"+"},{"type":"p","text":"Specialization"},{"type":"p","text":"+"},{"type":"p","text":"Internships"},{"type":"p","text":"+"},{"type":"p","text":"Professional Portfolio"}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"h","text":"0–2 Years"},{"type":"list","items":[{"text":"Legal Intern"},{"text":"Junior Advocate"},{"text":"Legal Associate"},{"text":"Litigation Associate"},{"text":"Legal Researcher"}]},{"type":"h","text":"3–5 Years"},{"type":"list","items":[{"text":"Advocate"},{"text":"Senior Legal Associate"},{"text":"Specialist Advocate"},{"text":"Corporate Legal Associate"},{"text":"Arbitration Associate"},{"text":"Legal Consultant"}]},{"type":"h","text":"5–10+ Years"},{"type":"list","items":[{"text":"Senior Advocate, subject to applicable professional criteria"},{"text":"Law Firm Partner"},{"text":"Independent Practitioner"},{"text":"Legal Consultant"},{"text":"Arbitrator/Mediator pathway"},{"text":"Legal-Tech Entrepreneur"},{"text":"Corporate Legal Leadership"},{"text":"Legal Academic/Researcher"}]}]},{"heading":"Best Overall Positioning","kind":"other","blocks":[{"type":"p","text":"The strongest profile is not simply:"},{"type":"h","text":"LL.B. Graduate"},{"type":"p","text":"but:"},{"type":"flow","items":["Advocate","Strong Legal Researcher","Skilled Legal Drafter","Courtroom/Negotiation Professional","Domain Specialist","Legal-Tech/AI Literate Professional"],"sep":"+"},{"type":"p","text":"For an LLB (3-year) General student, the most important strategic decision is to choose a practice area early, build relevant internships around it, and graduate with demonstrable drafting, research and practical legal skills rather than relying only on academic marks or certificates."}]}]}