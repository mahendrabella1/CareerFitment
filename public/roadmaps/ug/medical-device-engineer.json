"},{"text":"Financial documents"}]},{"type":"flow","items":["A portfolio showing problem","requirements","prototype","testing","risk","results is especially useful"]}]},{"heading":"Career progression","kind":"growth","blocks":[{"type":"h","text":"Product-development route"},{"type":"flow","items":["Biomedical Engineering Student","Medical Device Intern","Junior Medical Device Engineer","Medical Device Engineer","Senior Medical Device Engineer","Lead Device Engineer","Principal Engineer","R&D Engineering Manager"]},{"type":"h","text":"Quality/regulatory route"},{"type":"flow","items":["Graduate Engineer","Quality/Regulatory Associate","Quality Engineer","Senior Quality/Regulatory Engineer","Regulatory/Quality Manager","Quality & Regulatory Director"]},{"type":"h","text":"Systems route"},{"type":"flow","items":["Biomedical Engineer","Systems Engineer","Senior Systems Engineer","Lead Systems Engineer","Principal Systems Engineer"]},{"type":"h","text":"Research / PhD directions"},{"type":"p","text":"Strong research areas include:"},{"type":"list","items":[{"text":"Wearable medical devices"},{"text":"Biosensors"},{"text":"Implantable devices"},{"text":"Medical robotics"},{"text":"Surgical robotics"},{"text":"Medical imaging"},{"text":"Biomedical signal processing"},{"text":"Neural interfaces"},{"text":"Prosthetics"},{"text":"Rehabilitation technology"},{"text":"Biomaterials"},{"text":"Tissue engineering"},{"text":"Smart implants"},{"text":"AI-assisted diagnostics"},{"text":"Point-of-care diagnostics"},{"text":"Digital health"},{"text":"Bioelectronics"},{"text":"Microfluidic devices"},{"text":"Lab-on-a-chip systems"}]},{"type":"h","text":"2040–2046 career evolution"},{"type":"p","text":"Medical devices are increasingly becoming connected, intelligent, miniaturized, and personalized."},{"type":"h","text":"Traditional"},{"type":"flow","items":["Sensor","Device","Display"]},{"type":"h","text":"Emerging"},{"type":"flow","items":["Sensor","Edge AI","Connected device","Cloud an