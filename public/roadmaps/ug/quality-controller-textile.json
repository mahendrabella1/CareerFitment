xt":"Shift-wise defects"}]},{"type":"h","text":"Project 4 — Root-cause analysis"},{"type":"p","text":"Select a textile defect such as:"},{"type":"h","text":"Uneven GSM"},{"type":"p","text":"Then perform:"},{"type":"flow","items":["Problem definition","Data collection","Fishbone","5 Whys","Root cause","Corrective action","Verification"]},{"type":"h","text":"Project 5 — Supplier quality scorecard"},{"type":"p","text":"Evaluate suppliers using:"},{"type":"list","items":[{"text":"Raw-material quality"},{"text":"Defect rate"},{"text":"Delivery performance"},{"text":"Specification compliance"},{"text":"Rejection rate"},{"text":"Corrective-action response"}]},{"type":"p","text":"Create a supplier ranking."},{"type":"h","text":"Project 6 — Predictive quality project"},{"type":"p","text":"Later use Python/ML to predict the probability of a quality defect based on variables such as:"},{"type":"list","items":[{"text":"Machine settings"},{"text":"Raw material"},{"text":"Process temperature"},{"text":"Speed"},{"text":"Humidity"},{"text":"Production batch"}]},{"type":"p","text":"Use synthetic or authorised industrial data."},{"type":"h","text":"Specialisation options"},{"type":"table","header":["Lane","Core stack","Learn from","Senior role it leads to"],"rows":[[{"text":"Textile Testing"},{"text":"Testing + standards + lab methods"},{"text":"Textile labs + standards"},{"text":"Textile Testing Specialist"}],[{"text":"Spinning Quality"},{"text":"Fibre + yarn + SPC"},{"text":"Textile production"},{"text":"Spinning Quality Manager"}],[{"text":"Weaving Quality"},{"text":"Fabric + loom defects + SPC"},{"text":"Weaving industry"},{"text":"Weaving Quality Manager"}],[{"text":"Knitting Quality"},{"text":"Knit structures + defects + testing"},{"text":"Knitting industry"},{"text":"Knitting Quality Specialist"}],[{"text":"Dyeing & Finishing Quality"},{"text":"Colour + chemistry + testing"},{"text":"Processing industry"},{"text":"Processing Quality Manager"}],[{"text":"Garment Quality"},{"tex