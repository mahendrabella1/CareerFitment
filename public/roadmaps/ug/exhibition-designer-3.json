{"title":"Career Roadmap: Exhibition Designer","role":"Exhibition Designer","summary":"Career Domain: Architecture, Construction & Built Environment · Qualification Pathway: B.Des – Exhibition / Retail / Spatial Design · Target Career: Exhibition Designer","facts":{"Current degree":"B.Des (Bachelor of Design)","Course":"Exhibition / Retail / Spatial Design"},"about":[{"label":"About this roadmap","text":"This roadmap was drafted with AI assistance from OneGrasp's related roadmaps and is awaiting expert review. Check fees, dates, eligibility and exam patterns on the official websites before you rely on them."}],"intro":[],"horizons":[],"sections":[{"heading":"Career Overview","kind":"other","blocks":[{"type":"p","text":"An Exhibition Designer plans spaces that tell a story - museum galleries, trade-fair stalls, brand experiences and retail displays - combining layout, graphics, lighting and interactive elements."},{"type":"h","text":"What a Exhibition Designer does"},{"type":"list","items":[{"text":"Plan exhibition layouts and visitor flow"},{"text":"Design displays, graphics, lighting and interactives"},{"text":"Make 3D models, drawings and budgets"},{"text":"Coordinate fabricators and installation"}]},{"type":"p","text":"Where they work:"},{"type":"list","items":[{"text":"Museum and exhibition design studios"},{"text":"Event and trade-fair companies"},{"text":"Retail and experiential design agencies"},{"text":"Museums"}]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Career stage","Typical role"],"rows":[[{"text":"Entry-level"},{"text":"Junior Designer"}],[{"text":"Early career"},{"text":"Exhibition Designer"}],[{"text":"Mid-level"},{"text":"Senior Designer"}],[{"text":"Senior"},{"text":"Design Lead"}],[{"text":"Leadership"},{"text":"Studio Head"}]]}]},{"heading":"Year-by-Year Learning Roadmap","kind":"build","blocks":[{"type":"h","text":"Year 1: Space and design basics"},{"type":"list","items":[{"text":"Drawing, model-making and spatial design"},{"text":"Visit museums and trade fairs and sketch layouts"},{"text":"Learn SketchUp"}]},{"type":"h","text":"Year 2: Exhibition craft"},{"type":"list","items":[{"text":"Study visitor flow, lighting and graphics"},{"text":"Learn AutoCAD and rendering"},{"text":"Design a small exhibition for a college event"}]},{"type":"h","text":"Year 3: Industry experience"},{"type":"list","items":[{"text":"Intern with an exhibition or retail design firm"},{"text":"Learn materials, fabrication and costing"},{"text":"Design a trade-fair stall to budget"}]},{"type":"h","text":"Year 4: Portfolio"},{"type":"list","items":[{"text":"Final project: a full museum or brand exhibition"},{"text":"Show drawings, renders and a model"},{"text":"Apply to studios and museums"}]}]},{"heading":"Essential Skills","kind":"build","blocks":[{"type":"table","header":["Skill","Type"],"rows":[[{"text":"Spatial planning"},{"text":"Technical"}],[{"text":"3D modelling and rendering"},{"text":"Technical"}],[{"text":"Lighting and graphics"},{"text":"Technical"}],[{"text":"Fabrication and costing"},{"text":"Technical"}],[{"text":"Storytelling"},{"text":"Professional"}],[{"text":"Coordination"},{"text":"Professional"}],[{"text":"Deadline management"},{"text":"Professional"}]]}]},{"heading":"Tools and Technologies to Learn","kind":"build","blocks":[{"type":"list","items":[{"text":"SketchUp"},{"text":"AutoCAD"},{"text":"Rhino"},{"text":"Enscape / V-Ray"},{"text":"Illustrator"}]}]},{"heading":"Internships and Practical Experience","kind":"internships","blocks":[{"type":"list","items":[{"text":"Exhibition design studios"},{"text":"Event companies"},{"text":"Museums"}]}]},{"heading":"Certifications and Additional Training","kind":"certifications","blocks":[{"type":"list","items":[{"text":"Autodesk Certified User (AutoCAD)"},{"text":"Lighting design workshops"}]},{"type":"note","label":"Before you enrol","text":"Check the current syllabus, fees and eligibility on the certifying body's official website."}]},{"heading":"Higher Education Options in India","kind":"pg_india","blocks":[{"type":"p","text":"Options after your degree:"},{"type":"list","items":[{"text":"M.Des Exhibition Design"},{"text":"MA Museology"}]},{"type":"p","text":"Entrance exams and tests to know:"},{"type":"list","items":[{"text":"NID DAT (M.Des)"},{"text":"CEED"}]}]},{"heading":"Study Abroad Options","kind":"abroad","blocks":[{"type":"list","items":[{"text":"MA Narrative Environments / Exhibition Design (UK, Europe)"}]}]},{"heading":"Career Opportunities","kind":"careers","blocks":[{"type":"p","text":"Roles a Exhibition Designer can grow into or move across to:"},{"type":"list","items":[{"text":"Retail Designer"},{"text":"Set Designer"},{"text":"Interior Designer"},{"text":"Museum Designer"}]}]},{"heading":"Recommended Career Progression","kind":"growth","blocks":[{"type":"flow","items":["Junior Designer","Exhibition Designer","Senior Designer","Design Lead","Studio Head"]}]}],"drafted":true}