,{"text":"Valuation Analyst"},{"text":"Transaction Advisory Analyst"},{"text":"Investment Research Analyst"},{"text":"Corporate Development Analyst"},{"text":"Equity Research Analyst"}]},{"type":"h","text":"Adjacent roles"},{"type":"list","items":[{"text":"Private Equity Analyst"},{"text":"Venture Capital Analyst"},{"text":"Financial Due Diligence Analyst"},{"text":"Restructuring Analyst"},{"text":"Transaction Services Analyst"},{"text":"Strategy Analyst"}]},{"type":"h","text":"Long-term"},{"type":"list","items":[{"text":"Investment Banking Associate"},{"text":"Senior Associate"},{"text":"Vice President"},{"text":"Director"},{"text":"Managing Director"},{"text":"Investment Banking Head"}]}]},{"heading":"Postgraduate study in India","kind":"pg_india","blocks":[{"type":"p","text":"Because IPM already integrates undergraduate management education with an MBA, another immediate general MBA is normally unnecessary."},{"type":"p","text":"Better options after IPM include:"},{"type":"table","header":["Qualification","Best for"],"rows":[[{"text":"CFA"},{"text":"Investment banking + investment analysis"}],[{"text":"CA"},{"text":"Accounting + transaction expertise"}],[{"text":"FRM"},{"text":"Risk/financial markets"}],[{"text":"M.Sc Finance"},{"text":"Quantitative finance"}],[{"text":"M.Sc Financial Economics"},{"text":"Economics + finance"}],[{"text":"Specialised finance programmes"},{"text":"Advanced finance"}]]},{"type":"h","text":"Recommended route"},{"type":"flow","items":["IPM","Investment Banking Internship","Analyst","Associate","VP","Director","MD"]},{"type":"p","text":"If targeting highly competitive firms, focus on brand-name internships, transaction exposure, networking and technical finance preparation."}]},{"heading":"Study abroad","kind":"abroad","blocks":[{"type":"table","header":["Country","Useful master's areas"],"rows":[[{"text":"🇺🇸 USA"},{"text":"Finance, Financial Economics"}],[{"text":"🇬🇧 UK"},{"text":"Finance, Investment Banking, Financial Economics"}],[{