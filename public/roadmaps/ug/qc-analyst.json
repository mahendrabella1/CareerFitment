lude:"},{"type":"p","text":"NCBI\nEMBL-EBI\nUniProt","url":"https://www.ncbi.nlm.nih.gov/"},{"type":"p","text":"This combination creates a strong profile:"},{"type":"flow","items":["Molecular Biology","QC","Bioinformatics"],"sep":"+"}]},{"heading":"Medical biotechnology knowledge","kind":"other","blocks":[{"type":"p","text":"Understand the basic applications of molecular biotechnology in:"},{"type":"list","items":[{"text":"Molecular diagnostics"},{"text":"Infectious disease testing"},{"text":"Genetic testing"},{"text":"Cancer biomarkers"},{"text":"Pharmacogenomics"},{"text":"Personalized medicine"},{"text":"Vaccine development"},{"text":"Biopharmaceuticals"},{"text":"Cell and gene therapy"},{"text":"Companion diagnostics"}]},{"type":"p","text":"The student should understand the difference between:"},{"type":"flow","items":["Research experiment","diagnostic assay","regulated QC test"]},{"type":"p","text":"because the level of validation, documentation and quality control differs."}]},{"heading":"Specialisation options","kind":"other","blocks":[{"type":"table","header":["Lane","Core stack","Learn","Senior direction"],"rows":[[{"text":"Molecular QC"},{"text":"PCR + DNA/RNA + electrophoresis"},{"text":"Molecular laboratory"},{"text":"QC Specialist"}],[{"text":"Genomics QC"},{"text":"NGS + sequencing QC + bioinformatics"},{"text":"NGS workflows"},{"text":"Genomics QC Specialist"}],[{"text":"Diagnostic QC"},{"text":"Molecular diagnostics + assay validation"},{"text":"Diagnostic laboratory"},{"text":"Diagnostic QC Lead"}],[{"text":"Microbiology QC"},{"text":"Microbiology + contamination control"},{"text":"GMP/GLP"},{"text":"Microbiology QC Specialist"}],[{"text":"Biopharma QC"},{"text":"Analytical testing + GMP"},{"text":"Pharmaceutical QC"},{"text":"QC Scientist"}],[{"text":"Bioassay QC"},{"text":"Cell biology + assay validation"},{"text":"Cell-based assays"},{"text":"Bioassay Scientist"}],[{"text":"Molecular Diagnostics"},{"text":"qPCR + assay development"},{"text":"Diag