ts"},{"text":"Breach"},{"text":"Termination"},{"text":"Damages"},{"text":"Force majeure"},{"text":"Confidentiality"},{"text":"Dispute resolution"}]}]},{"heading":"Commercial Contract Review","kind":"other","blocks":[{"type":"p","text":"Learn to identify:"},{"type":"h","text":"Commercial Terms"},{"type":"list","items":[{"text":"Price"},{"text":"Payment"},{"text":"Deliverables"},{"text":"Milestones"},{"text":"Service levels"},{"text":"Term"},{"text":"Renewal"}]},{"type":"h","text":"Legal Terms"},{"type":"list","items":[{"text":"Liability"},{"text":"Indemnity"},{"text":"Warranty"},{"text":"Confidentiality"},{"text":"Intellectual property"},{"text":"Data protection"},{"text":"Termination"},{"text":"Dispute resolution"},{"text":"Governing law"}]},{"type":"h","text":"Contract-review framework"},{"type":"flow","items":["Business Objective","Scope of Work","Commercial Terms","Legal Obligations","Risk Allocation","Liability","Termination","Dispute Resolution","Approval","Execution"]}]},{"heading":"Contract Drafting","kind":"other","blocks":[{"type":"p","text":"Practice drafting:"},{"type":"list","items":[{"text":"Non-disclosure agreements"},{"text":"Vendor agreements"},{"text":"Service agreements"},{"text":"Employment agreements"},{"text":"Consultancy agreements"},{"text":"SaaS agreements"},{"text":"Licensing agreements"},{"text":"Partnership agreements"},{"text":"Memoranda of Understanding"},{"text":"Master service agreements"},{"text":"Statements of Work"},{"text":"The objective is to create contracts that are clear, enforceable, commercially practical and aligned with the organization's risk appetite."}]}]},{"heading":"Contract Negotiation","kind":"other","blocks":[{"type":"p","text":"A Legal Manager frequently negotiates with:"},{"type":"list","items":[{"text":"Vendors"},{"text":"Customers"},{"text":"Partners"},{"text":"Consultants"},{"text":"Technology providers"},{"text":"Landlords"},{"text":"Service providers"}]},{"type":"p","text":"Develop:"},{"type":"list","items":[