":"CAPA"},{"text":"Medium–High"}],[{"text":"Auditing"},{"text":"Medium"}],[{"text":"Stability"},{"text":"Medium–High"}],[{"text":"Analytical techniques"},{"text":"Medium"}],[{"text":"Excel"},{"text":"Medium–High"}],[{"text":"Communication"},{"text":"High"}],[{"text":"Technical reporting"},{"text":"High"}]]}]},{"heading":"Certifications & Additional Learning","kind":"certifications","blocks":[{"type":"p","text":"Useful areas include:"},{"type":"h","text":"Quality"},{"type":"list","items":[{"text":"GMP"},{"text":"GLP"},{"text":"Quality Management Systems"},{"text":"Good Documentation Practices"},{"text":"Deviation & CAPA"},{"text":"Change Control"},{"text":"Root Cause Analysis"},{"text":"Internal Auditing"}]},{"type":"h","text":"Herbal-specific"},{"type":"list","items":[{"text":"Herbal drug standardization"},{"text":"Pharmacognosy"},{"text":"Herbal quality control"},{"text":"Botanical authentication"},{"text":"Phytochemical analysis"},{"text":"Herbal stability testing"}]},{"type":"h","text":"Analytical"},{"type":"list","items":[{"text":"HPLC fundamentals"},{"text":"HPTLC"},{"text":"UV-Visible spectroscopy"},{"text":"Chromatographic data interpretation"}]},{"type":"p","text":"Certifications are useful, but hands-on GMP and documentation experience is more valuable for entry-level QA hiring."}]},{"heading":"Higher Education Options","kind":"other","blocks":[{"type":"h","text":"M.Pharm — Pharmacognosy / Herbal Drug Technology"},{"type":"p","text":"A strong choice for advanced herbal-product specialization."},{"type":"p","text":"Potential areas:"},{"type":"list","items":[{"text":"Herbal drug standardization"},{"text":"Phytochemistry"},{"text":"Natural products"},{"text":"Herbal formulation"},{"text":"Quality control"},{"text":"Pharmacognosy research"}]},{"type":"h","text":"M.Pharm — Quality Assurance"},{"type":"p","text":"Useful for moving toward broader pharmaceutical QA and quality-system roles."},{"type":"h","text":"M.Pharm — Pharmaceutics"},{"type":"p","text":"Useful 