":"p","text":"LIMS"},{"type":"p","text":"+"},{"type":"p","text":"QMS"},{"type":"p","text":"+"},{"type":"p","text":"ERP"},{"type":"p","text":"+"},{"type":"p","text":"Quality Data Analytics"}]},{"heading":"Target Profile by Graduation","kind":"other","blocks":[{"type":"p","text":"By graduation, the student should ideally have:"},{"type":"list","items":[{"text":"Strong pharmacognosy knowledge"},{"text":"Understanding of herbal raw materials"},{"text":"Knowledge of herbal product manufacturing"},{"text":"Strong GMP fundamentals"},{"text":"Good documentation practices"},{"text":"Batch-record review skills"},{"text":"SOP-writing experience"},{"text":"Basic deviation/CAPA knowledge"},{"text":"Understanding of stability studies"},{"text":"Awareness of HPLC/HPTLC"},{"text":"Knowledge of microbial and contamination risks"},{"text":"Strong Excel skills"},{"text":"One herbal QA-focused project"},{"text":"One relevant industry internship"}]},{"type":"h","text":"Ideal portfolio"},{"type":"p","text":"B.Pharm"},{"type":"p","text":"+"},{"type":"p","text":"Herbal/Pharmacognosy Knowledge"},{"type":"p","text":"+"},{"type":"p","text":"GMP Training"},{"type":"p","text":"+"},{"type":"p","text":"Herbal QA Internship"},{"type":"p","text":"+"},{"type":"p","text":"QA Documentation Skills"},{"type":"p","text":"+"},{"type":"p","text":"CAPA/Deviation Basics"},{"type":"p","text":"+"},{"type":"p","text":"Raw-Material Evaluation"},{"type":"p","text":"+"},{"type":"p","text":"Quality Project"},{"type":"p","text":"+"},{"type":"flow","items":["Excel/QMS/LIMS Awareness","Herbal QA Trainee / QA Executive"]},{"type":"h","text":"Best Overall Positioning"},{"type":"flow","items":["B.Pharm","Herbal/Pharmacognosy exposure","GMP & QA training","Herbal manufacturing/QA internship","Herbal QA Executive","Senior QA Executive","Quality Systems / Herbal Quality Specialist","QA Manager"]},{"type":"p","text":"For a candidate specifically targeting Herbal QA Officer, the highest-value combination is pharmacognosy + he