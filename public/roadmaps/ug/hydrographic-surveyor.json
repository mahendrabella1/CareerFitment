"},{"text":"Rock"},{"text":"Mud"},{"text":"Gravel"},{"text":"Mixed seabed"}]},{"type":"h","text":"Object Detection"},{"type":"p","text":"Detect:"},{"type":"list","items":[{"text":"Wrecks"},{"text":"Pipelines"},{"text":"Debris"},{"text":"Other seabed features"}]},{"type":"h","text":"Quality Control"},{"type":"p","text":"Detect:"},{"type":"list","items":[{"text":"Outliers"},{"text":"Systematic errors"},{"text":"Sensor anomalies"},{"text":"AI should support, not replace, professional survey QA/QC and required validation."}]},{"type":"h","text":"USV & AUV Hydrography"},{"type":"p","text":"Modern hydrographic surveys increasingly use:"},{"type":"h","text":"USVs"},{"type":"p","text":"Uncrewed Surface Vessels."},{"type":"h","text":"AUVs"},{"type":"p","text":"Autonomous Underwater Vehicles."},{"type":"p","text":"Benefits can include:"},{"type":"list","items":[{"text":"Reduced personnel exposure"},{"text":"Access to difficult areas"},{"text":"High survey efficiency"},{"text":"Persistent operations"}]},{"type":"p","text":"Architecture:"},{"type":"list","items":[{"text":"GNSS / INS"},{"text":"+"},{"text":"Sonar"},{"text":"+"},{"text":"Autonomy"},{"text":"+"}]},{"type":"flow","items":["Mission Planning","USV / AUV","Bathymetric Survey","Automated Processing","Hydrographic Product"]},{"type":"h","text":"Final-Year Project Ideas"}]},{"heading":"Multibeam Bathymetric Survey","kind":"other","blocks":[{"type":"p","text":"Create a complete workflow:"},{"type":"flow","items":["Acquisition","Processing","QA/QC","DTM"]}]},{"heading":"Coastal Bathymetry & Shoreline Mapping","kind":"other","blocks":[{"type":"p","text":"Combine:"},{"type":"list","items":[{"text":"Bathymetry"},{"text":"GNSS"},{"text":"Satellite imagery"},{"text":"GIS"}]}]},{"heading":"Dredging Volume Calculation","kind":"other","blocks":[{"type":"p","text":"Compare:"},{"type":"h","text":"Before vs After"},{"type":"p","text":"to estimate dredged material."}]},{"heading":"Seabed Classification","kind":"other","blocks":[{"type