]},{"type":"h","text":"Finance"},{"type":"list","items":[{"text":"Revenue"},{"text":"Cost"},{"text":"Gross margin"},{"text":"Net profit"},{"text":"Budget"},{"text":"Variance"}]},{"type":"h","text":"Operations"},{"type":"list","items":[{"text":"Productivity"},{"text":"Capacity"},{"text":"SLA"},{"text":"Turnaround time"},{"text":"Efficiency"}]},{"type":"h","text":"HR"},{"type":"list","items":[{"text":"Headcount"},{"text":"Attrition"},{"text":"Absenteeism"},{"text":"Recruitment"}]},{"type":"h","text":"E-Commerce"},{"type":"list","items":[{"text":"Traffic"},{"text":"Conversion rate"},{"text":"Orders"},{"text":"AOV"},{"text":"Customer acquisition"},{"text":"Retention"}]}]},{"heading":"KPI & Reporting Concepts","kind":"other","blocks":[{"type":"p","text":"Learn how to create meaningful KPIs."},{"type":"p","text":"For example:"},{"type":"h","text":"Sales achievement"},{"type":"h","text":"Actual Sales ÷ Target Sales × 100"},{"type":"h","text":"Conversion rate"},{"type":"h","text":"Conversions ÷ Leads × 100"},{"type":"h","text":"Employee attrition"},{"type":"h","text":"Employees leaving ÷ Average employees × 100"},{"type":"h","text":"Budget variance"},{"type":"h","text":"Actual − Budget"},{"type":"p","text":"The MIS professional should understand not only how to calculate the KPI but also what action it should trigger."}]},{"heading":"Year-by-Year Development Plan","kind":"build","blocks":[{"type":"h","text":"Year 1"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Excel"},{"text":"Statistics basics"},{"text":"Data cleaning"},{"text":"Business fundamentals"},{"text":"Presentation skills"}]},{"type":"h","text":"Project"},{"type":"h","text":"Sales MIS Report"},{"type":"p","text":"Create:"},{"type":"list","items":[{"text":"Raw data"},{"text":"Cleaned data"},{"text":"Pivot tables"},{"text":"KPI calculations"},{"text":"Management summary"}]},{"type":"h","text":"Year 2"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"SQL"},{"text":"Power Query"},{"text":"Power BI"},{"text":"Data modelling"}]},{"type":"h","text":"Project"},{"type":"h","text":"Business Performance Dashboard"},{"type":"p","text":"Connect:"},{"type":"h","text":"SQL → Power BI"},{"type":"p","text":"Build:"},{"type":"list","items":[{"text":"Revenue dashboard"},{"text":"Sales dashboard"},{"text":"Target tracking"},{"text":"Regional analysis"}]},{"type":"h","text":"Year 3"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Advanced Power BI"},{"text":"DAX"},{"text":"Python"},{"text":"Automation"},{"text":"Financial/business analytics"}]},{"type":"h","text":"Project"},{"type":"h","text":"Automated MIS Reporting System"},{"type":"p","text":"Architecture:"},{"type":"flow","items":["Database / Excel / API","Data Cleaning","Python / Power Query","Data Model","Power BI","Management Dashboard"]},{"type":"h","text":"Year 4"},{"type":"p","text":"Develop an enterprise-style portfolio."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Advanced SQL"},{"text":"Advanced DAX"},{"text":"Data modelling"},{"text":"Automation"},{"text":"BI architecture"},{"text":"FinTech analytics"}]},{"type":"h","text":"Capstone"},{"type":"h","text":"Financial Operations MIS Dashboard"},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Revenue"},{"text":"Expenses"},{"text":"Transactions"},{"text":"Customers"},{"text":"Profitability"},{"text":"Budget variance"},{"text":"Risk indicators"},{"text":"Trend analysis"}]}]},{"heading":"Four-Year Skill Plan","kind":"other","blocks":[{"type":"table","header":["Skill","Year 1","Year 2","Year 3","Year 4"],"rows":[[{"text":"Excel"},{"text":"★★★★★"}],[{"text":"Data Cleaning"},{"text":"★★★"},{"text":"★★★★"},{"text":"★★★★★"}],[{"text":"SQL"},{"text":"★"},{"text":"★★★"},{"text":"★★★★★"}],[{"text":"Power BI"},{"text":"★"},{"text":"★★★"},{"text":"★★★★★"}],[{"text":"Power Query"},{"text":"★"},{"text":"★★★"},{"text":"★★★★★"}],[{"text":"DAX"},{"text":"—"},{"text":"★"},{"text":"★★★★"},{"text":"★★★★★"}],[{"text":"Statistics"},{"text":"★★"},{"text":"★★★"},{"text":"★★★★"}],[{"text":"Business Analysis"},{"text":"★"},{"text":"★★"},{"text":"★★★★"},{"text":"★★★★★"}],[{"text":"Python"},{"text":"—"},{"text":"★"},{"text":"★★★"},{"text":"★★★★"}],[{"text":"Automation"},{"text":"—"},{"text":"★"},{"text":"★★★"},{"text":"★★★★★"}],[{"text":"Presentation"},{"text":"★★★"},{"text":"★★★★"},{"text":"★★★★★"}],[{"text":"FinTech"},{"text":"—"},{"text":"★"},{"text":"★★★"},{"text":"★★★★★"}]]}]},{"heading":"Practical Projects","kind":"other","blocks":[{"type":"h","text":"Project 1 — Sales MIS Dashboard"},{"type":"p","text":"Build a dashboard showing:"},{"type":"list","items":[{"text":"Sales"},{"text":"Targets"},{"text":"Achievement"},{"text":"Region"},{"text":"Product"},{"text":"Salesperson"},{"text":"Monthly trend"}]},{"type":"p","text":"Tools:"},{"type":"h","text":"Excel + Power BI"},{"type":"h","text":"Project 2 — Employee MIS"},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Employee count"},{"text":"Department"},{"text":"Attendance"},{"text":"Attrition"},{"text":"Hiring"},{"text":"Salary ranges"},{"text":"Performance"}]},{"type":"p","text":"Use:"},{"type":"h","text":"SQL + Power BI"},{"type":"h","text":"Project 3 — Inventory MIS"},{"type":"p","text":"Analyse:"},{"type":"list","items":[{"text":"Opening stock"},{"text":"Purchases"},{"text":"Sales"},{"text":"Closing stock"},{"text":"Stock turnover"},{"text":"Slow-moving inventory"},{"text":"Reorder levels"}]},{"type":"h","text":"Project 4 — FinTech Transaction Dashboard"},{"type":"p","text":"Because the degree includes FinTech, create a project analysing:"},{"type":"list","items":[{"text":"Transactions"},{"text":"Transaction value"},{"text":"Success/failure"},{"text":"Customer segments"},{"text":"Payment methods"},{"text":"Daily/monthly trends"},{"text":"Suspicious transaction indicators"}]},{"type":"p","text":"Do not use real private financial information; use synthetic or public datasets."},{"type":"h","text":"Project 5 — Automated MIS Report"},{"type":"p","text":"Create a Python process that:"},{"type":"list","items":[{"text":"Reads raw files"},{"text":"Cleans data"},{"text":"Validates records"},{"text":"Generates summary tables"},{"text":"Creates reports"},{"text":"Saves outputs automatically"}]},{"type":"p","text":"This demonstrates that you can automate MIS work instead of manually repeating it."}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"MIS Intern"},{"text":"Business Analyst Intern"},{"text":"Data Analyst Intern"},{"text":"Business Intelligence Intern"},{"text":"Reporting Analyst Intern"},{"text":"Operations Analyst Intern"},{"text":"Finance Analyst Intern"},{"text":"FinTech Analyst Intern"}]},{"type":"p","text":"Look for internships involving:"},{"type":"list","items":[{"text":"Excel"},{"text":"SQL"},{"text":"Power BI"},{"text":"Reporting"},{"text":"Dashboard development"},{"text":"Data cleaning"},{"text":"KPI tracking"}]}]},{"heading":"Certifications & Learning","kind":"certifications","blocks":[{"type":"h","text":"Highest-value skills"},{"type":"h","text":"Advanced Excel"},{"type":"h","text":"Power BI"},{"type":"h","text":"SQL"},{"type":"h","text":"Power Query"},{"type":"h","text":"DAX"},{"type":"h","text":"Additional"},{"type":"list","items":[{"text":"Business analytics"},{"text":"Statistics"},{"text":"Python"},{"text":"Financial analytics"},{"text":"Data visualisation"}]},{"type":"h","text":"Cloud/data"},{"type":"p","text":"Later learn:"},{"type":"list","items":[{"text":"Azure/AWS basics"},{"text":"Cloud databases"},{"text":"Data warehouses"}]},{"type":"p","text":"Certifications can help, but a portfolio of real dashboards and automated reports is usually more valuable for entry-level hiring."}]},{"heading":"Jobs You Can Target After BCA","kind":"careers","blocks":[{"type":"h","text":"Direct-entry roles"},{"type":"table","header":["Job Title","Focus"],"rows":[[{"text":"MIS Executive"},{"text":"Business reporting"}