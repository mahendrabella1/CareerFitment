{"title":"Career Roadmap: Actuary","role":"Actuary","summary":"Career Domain: Science, Mathematics & Research · Qualification Pathway: Professional Certifications - CA / CS / CMA / ACCA / CFA / CPA-India – CFA / FRM / Actuarial (IAI) · Target Career: Actuary","facts":{"Current degree":"Professional Certifications - CA / CS / CMA / ACCA / CFA / CPA-India","Course":"CFA / FRM / Actuarial (IAI)"},"about":[{"label":"About this roadmap","text":"This roadmap was drafted with AI assistance from OneGrasp's related roadmaps and is awaiting expert review. Check fees, dates, eligibility and exam patterns on the official websites before you rely on them."}],"intro":[],"horizons":[],"sections":[{"heading":"Career Overview","kind":"other","blocks":[{"type":"p","text":"An Actuary uses maths, statistics and finance to price insurance and pensions and to measure long-term financial risk. Fellowship of the Institute of Actuaries of India (IAI) is the professional qualification."},{"type":"h","text":"What a Actuary does"},{"type":"list","items":[{"text":"Price insurance and pension products"},{"text":"Calculate reserves and solvency"},{"text":"Model risks with data"},{"text":"Advise on product design and regulation"}]},{"type":"p","text":"Where they work:"},{"type":"list","items":[{"text":"Life and general insurers"},{"text":"Reinsurers"},{"text":"Actuarial consultancies"},{"text":"Pension funds and banks"}]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Career stage","Typical role"],"rows":[[{"text":"Entry-level"},{"text":"Actuarial Analyst"}],[{"text":"Early career"},{"text":"Associate Actuary"}],[{"text":"Mid-level"},{"text":"Fellow / Actuary"}],[{"text":"Senior"},{"text":"Appointed Actuary"}],[{"text":"Leadership"},{"text":"Chief Actuary"}]]}]},{"heading":"Year-by-Year Learning Roadmap","kind":"build","blocks":[{"type":"h","text":"Entry: Start the route"},{"type":"list","items":[{"text":"Clear IAI's ACET entrance"},{"text":"Strengthen probability and statistics"},{"text":"Learn Excel and R / Python"}]},{"type":"h","text":"Core subjects: Build the base"},{"type":"list","items":[{"text":"Clear core subjects (CS, CM, CB series)"},{"text":"Intern with an insurer or consultancy"},{"text":"Learn actuarial modelling"}]},{"type":"h","text":"Specialist and fellowship: Qualify"},{"type":"list","items":[{"text":"Clear specialist subjects"},{"text":"Work as an actuarial analyst"},{"text":"Progress to Associate and then Fellow"}]},{"type":"note","label":"Note","text":"Qualifying usually takes several years of exams alongside work."}]},{"heading":"Essential Skills","kind":"build","blocks":[{"type":"table","header":["Skill","Type"],"rows":[[{"text":"Probability and statistics"},{"text":"Technical"}],[{"text":"Actuarial modelling"},{"text":"Technical"}],[{"text":"Insurance and pension maths"},{"text":"Technical"}],[{"text":"R / Python / Excel"},{"text":"Technical"}],[{"text":"Persistence"},{"text":"Professional"}],[{"text":"Analytical thinking"},{"text":"Professional"}],[{"text":"Explaining numbers"},{"text":"Professional"}]]}]},{"heading":"Tools and Technologies to Learn","kind":"build","blocks":[{"type":"list","items":[{"text":"Excel"},{"text":"R / Python"},{"text":"Prophet / actuarial software"}]}]},{"heading":"Internships and Practical Experience","kind":"internships","blocks":[{"type":"list","items":[{"text":"Insurers' actuarial teams"},{"text":"Actuarial consultancies"}]}]},{"heading":"Certifications and Additional Training","kind":"certifications","blocks":[{"type":"list","items":[{"text":"IAI (Institute of Actuaries of India) exams"},{"text":"IFoA (UK) / SOA (US) as alternatives"}]},{"type":"note","label":"Before you enrol","text":"Check the current syllabus, fees and eligibility on the certifying body's official website."}]},{"heading":"Higher Education Options in India","kind":"pg_india","blocks":[{"type":"p","text":"Options after your degree:"},{"type":"list","items":[{"text":"M.Sc Actuarial Science / Statistics (optional)"}]},{"type":"p","text":"Entrance exams and tests to know:"},{"type":"list","items":[{"text":"IAI ACET and IAI papers"}]}]},{"heading":"Study Abroad Options","kind":"abroad","blocks":[{"type":"list","items":[{"text":"Actuarial roles in the UK, US, Australia via IFoA / SOA"}]}]},{"heading":"Career Opportunities","kind":"careers","blocks":[{"type":"p","text":"Roles a Actuary can grow into or move across to:"},{"type":"list","items":[{"text":"Risk Manager"},{"text":"Data Scientist"},{"text":"Insurance Underwriter"},{"text":"Quantitative Analyst"}]}]},{"heading":"Recommended Career Progression","kind":"growth","blocks":[{"type":"flow","items":["Actuarial Analyst","Associate Actuary","Fellow / Actuary","Appointed Actuary","Chief Actuary"]}]}],"drafted":true}