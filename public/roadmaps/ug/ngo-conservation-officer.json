 Sem 2"},{"text":"NGO/field internship"},{"text":"Conservation organisation"},{"text":"Internship report"},{"text":"Field experience"}],[{"text":"Year 4 Sem 1"},{"text":"Specialisation + project management"},{"text":"Mentor + conservation organisation"},{"text":"Conservation project"},{"text":"Professional capability"}],[{"text":"Year 4 Sem 2"},{"text":"Dissertation + job/PG preparation"},{"text":"Faculty/NGO mentor"},{"text":"Dissertation + portfolio"},{"text":"Employability"}]]}]},{"heading":"Ecology foundation","kind":"build","blocks":[{"type":"p","text":"Master:"},{"type":"list","items":[{"text":"Ecology"},{"text":"Population ecology"},{"text":"Community ecology"},{"text":"Ecosystem ecology"},{"text":"Landscape ecology"},{"text":"Behavioural ecology"},{"text":"Conservation biology"},{"text":"Evolution"},{"text":"Biogeography"},{"text":"Biodiversity"},{"text":"Ecological interactions"},{"text":"Food webs"},{"text":"Trophic levels"},{"text":"Ecological succession"},{"text":"Ecosystem services"}]},{"type":"p","text":"Understand:"},{"type":"flow","items":["Species","Population","Community","Ecosystem","Landscape"]}]},{"heading":"Wildlife biology","kind":"other","blocks":[{"type":"p","text":"Develop knowledge of:"},{"type":"list","items":[{"text":"Mammalogy"},{"text":"Ornithology"},{"text":"Herpetology"},{"text":"Entomology"},{"text":"Aquatic ecology"},{"text":"Animal behaviour"},{"text":"Wildlife physiology"},{"text":"Wildlife genetics"},{"text":"Reproductive biology"},{"text":"Migration"},{"text":"Population dynamics"},{"text":"Predator-prey relationships"}]},{"type":"p","text":"Build strong species identification skills."},{"type":"p","text":"Learn to identify:"},{"type":"list","items":[{"text":"Mammals"},{"text":"Birds"},{"text":"Reptiles"},{"text":"Amphibians"},{"text":"Butterflies"},{"text":"Plants"},{"text":"Common invasive species"}]}]},{"heading":"Field survey techniques","kind":"other","blocks":[{"type":"p","text":"This is one of the most important skills f