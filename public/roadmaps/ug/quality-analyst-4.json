":"Color"},{"text":"Odor"},{"text":"pH"},{"text":"Viscosity"},{"text":"Specific gravity"},{"text":"Stability"},{"text":"Packaging"},{"text":"Microbial quality"}]},{"type":"p","text":"The objective is to understand how a finished product is evaluated against specifications."},{"type":"h","text":"Project 2 — Cream Formulation Stability Study"},{"type":"p","text":"Develop a laboratory-scale cosmetic cream and evaluate its stability."},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Appearance"},{"text":"pH"},{"text":"Viscosity"},{"text":"Phase separation"},{"text":"Odor"},{"text":"Texture"},{"text":"Packaging compatibility"}]},{"type":"p","text":"Document observations at predefined intervals."},{"type":"h","text":"Project 3 — Shampoo Quality Analysis"},{"type":"p","text":"Evaluate a shampoo formulation for parameters such as:"},{"type":"list","items":[{"text":"pH"},{"text":"Viscosity"},{"text":"Foaming characteristics"},{"text":"Appearance"},{"text":"Odor"},{"text":"Stability"},{"text":"Microbial quality"}]},{"type":"h","text":"Project 4 — Raw-Material Quality Database"},{"type":"p","text":"Create a database containing:"},{"type":"table","header":["Raw Material","Function","Quality Parameters","Testing Method","Storage"],"rows":[[{"text":"Glycerin"},{"text":"Humectant"},{"text":"Purity/identity"},{"text":"Appropriate analytical test"},{"text":"Controlled storage"}],[{"text":"Surfactant"},{"text":"Cleansing"},{"text":"Identity/purity"},{"text":"Appropriate test"},{"text":"As specified"}],[{"text":"Preservative"},{"text":"Preservation"},{"text":"Assay/identity"},{"text":"Analytical testing"},{"text":"As specified"}],[{"text":"Botanical extract"},{"text":"Active/functional ingredient"},{"text":"Identity/marker"},{"text":"Chromatographic/chemical testing"},{"text":"As specified"}]]},{"type":"h","text":"Project 5 — Cosmetic Stability & Packaging Compatibility"},{"type":"p","text":"Compare different packaging materials for a cosmetic formulation."},{"type":"p",