MP"},{"type":"p","text":"+"},{"type":"p","text":"Regulatory Affairs"},{"type":"p","text":"+"},{"type":"p","text":"Excel / Statistics"},{"type":"p","text":"+"},{"type":"p","text":"Digital Quality Systems"},{"type":"p","text":"+"},{"type":"p","text":"AI-Assisted Quality Analytics"}]},{"heading":"Suggested 4-Year Development Plan","kind":"other","blocks":[{"type":"table","header":["Year","Primary Goal","Key Outcomes"],"rows":[[{"text":"Year 1"},{"text":"Pharmaceutical foundation"},{"text":"Chemistry, anatomy, physiology, laboratory skills"}],[{"text":"Year 2"},{"text":"Cosmetic ingredients"},{"text":"Cosmetic chemistry, pharmacognosy, microbiology"}],[{"text":"Year 3"},{"text":"Formulation + QC"},{"text":"Cosmetic formulation, analytical testing, stability"}],[{"text":"Year 4"},{"text":"Industrial quality"},{"text":"GMP, QA, QC, regulatory knowledge, internship"}],[{"text":"Graduation"},{"text":"Entry into industry"},{"text":"Quality Analyst / QC Analyst"}],[{"text":"1–3 Years"},{"text":"Specialization"},{"text":"Analytical QC / QA / stability"}],[{"text":"3–6 Years"},{"text":"Senior responsibility"},{"text":"Senior Analyst / QA Executive / Specialist"}],[{"text":"6+ Years"},{"text":"Leadership"},{"text":"QC/QA Manager / Head of Quality"}]]}]},{"heading":"Graduation Profile","kind":"other","blocks":[{"type":"p","text":"By graduation, the student should ideally have:"},{"type":"h","text":"Scientific Knowledge"},{"type":"list","items":[{"text":"Cosmetic chemistry"},{"text":"Pharmaceutical chemistry"},{"text":"Analytical chemistry"},{"text":"Pharmacognosy"},{"text":"Microbiology"},{"text":"Cosmetic formulation"}]},{"type":"h","text":"Quality Skills"},{"type":"list","items":[{"text":"Raw-material testing"},{"text":"Finished-product testing"},{"text":"Stability testing"},{"text":"Specification management"},{"text":"Sampling"},{"text":"Laboratory documentation"},{"text":"OOS investigation fundamentals"}]},{"type":"h","text":"Instrumentation"},{"type":"list","items":[{"text":