der studies"},{"text":"Community development"},{"text":"Social policy"},{"text":"Sustainable development"}]},{"type":"h","text":"CSR"},{"type":"list","items":[{"text":"CSR strategy"},{"text":"Programme management"},{"text":"NGO partnerships"},{"text":"CSR budgeting"},{"text":"CSR governance"},{"text":"Impact measurement"}]},{"type":"h","text":"M&E"},{"type":"list","items":[{"text":"Theory of Change"},{"text":"Logical Framework"},{"text":"KPI design"},{"text":"Baseline/endline"},{"text":"Impact evaluation"}]},{"type":"h","text":"Corporate"},{"type":"list","items":[{"text":"Excel"},{"text":"PowerPoint"},{"text":"Power BI"},{"text":"Budgeting"},{"text":"Business communication"},{"text":"Stakeholder management"}]},{"type":"h","text":"ESG"},{"type":"list","items":[{"text":"ESG fundamentals"},{"text":"Sustainability"},{"text":"Social impact"},{"text":"Sustainability reporting"}]},{"type":"h","text":"Modern"},{"type":"list","items":[{"text":"GIS"},{"text":"Data analytics"},{"text":"AI-assisted reporting"},{"text":"Digital programme management"},{"text":"Impact dashboards"}]},{"type":"h","text":"Target progression"},{"type":"table","header":["Stage","Target"],"rows":[[{"text":"Year 1"},{"text":"Social development + CSR foundations"}],[{"text":"Year 2"},{"text":"Programme management + M&E + data"}],[{"text":"Year 3"},{"text":"CSR specialisation + field experience"}],[{"text":"Graduation"},{"text":"CSR/Programme Associate"}],[{"text":"Years 1–3"},{"text":"CSR Executive / Programme Officer"}],[{"text":"Years 3–6"},{"text":"CSR Manager / Impact Specialist"}],[{"text":"Years 6–10"},{"text":"Senior CSR Manager / Social Impact Lead"}],[{"text":"10+ years"},{"text":"Head of CSR / Director – Social Impact"}]]},{"type":"h","text":"Best employability combination"},{"type":"flow","items":["BA Rural Development/Gender Studies","CSR internship","programme management","M&E","Excel/Power BI","NGO partnerships","CSR governance","impact measurement","ESG knowledge","strong field experience"],"sep":"+"},{"type":"note","label":"Key principle","text":"A strong CSR Executive is not simply someone who organises social initiatives. The strongest professional can understand community needs, select and manage credible implementation partners, control budgets, measure outcomes, communicate impact to corporate stakeholders and connect social programmes with long-term, measurable impact."}]}]}