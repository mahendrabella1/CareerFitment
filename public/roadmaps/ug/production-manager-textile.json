:"Learning only theory"}],[{"text":"Year 3"},{"text":"Production engineering"},{"text":"Industrial engineering, quality, production planning"},{"text":"Factory project"},{"text":"No manufacturing exposure"}],[{"text":"Year 4"},{"text":"Plant-management capability"},{"text":"Lean, ERP, automation, analytics, safety"},{"text":"Internship + capstone"},{"text":"Weak operational skills"}]]}]},{"heading":"Semester-by-Semester Roadmap","kind":"build","blocks":[{"type":"h","text":"Semester 1"},{"type":"list","items":[{"text":"Engineering Mathematics"},{"text":"Engineering Physics"},{"text":"Engineering Chemistry"},{"text":"Engineering Drawing"},{"text":"Computer Programming"},{"text":"Introduction to Textile Engineering"}]},{"type":"h","text":"Semester 2"},{"type":"list","items":[{"text":"Textile Fibre Science"},{"text":"Yarn Manufacturing Fundamentals"},{"text":"Textile Materials"},{"text":"Engineering Mechanics"},{"text":"Statistics"},{"text":"Workshop/Manufacturing Practice"}]},{"type":"h","text":"Semester 3"},{"type":"list","items":[{"text":"Spinning Technology"},{"text":"Yarn Formation"},{"text":"Textile Machinery"},{"text":"Textile Testing"},{"text":"Fabric Manufacturing"},{"text":"Instrumentation fundamentals"}]},{"type":"h","text":"Semester 4"},{"type":"list","items":[{"text":"Weaving Technology"},{"text":"Knitting Technology"},{"text":"Fabric Structure"},{"text":"Textile Chemical Processing"},{"text":"Dyeing fundamentals"},{"text":"Industrial engineering fundamentals"}]},{"type":"h","text":"Semester 5"},{"type":"list","items":[{"text":"Textile Production Planning"},{"text":"Quality Management"},{"text":"Industrial Engineering"},{"text":"Work Study"},{"text":"Operations Research"},{"text":"Maintenance Management"},{"text":"Supply Chain Management"}]},{"type":"h","text":"Semester 6"},{"type":"list","items":[{"text":"Apparel/Textile Manufacturing"},{"text":"Lean Manufacturing"},{"text":"Six Sigma"},{"text":"ERP"},{"text":"Production Costing"},{"text":"Automation"},{"t