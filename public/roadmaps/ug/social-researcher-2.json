{"text":"Interview transcripts"},{"text":"Policy documents"},{"text":"Social-media text"}]},{"type":"h","text":"Qualitative research assistance"},{"type":"p","text":"AI can assist with:"},{"type":"list","items":[{"text":"Transcription"},{"text":"Initial coding"},{"text":"Theme identification"},{"text":"Document organisation"}]},{"type":"p","text":"Human researchers must still validate interpretations."},{"type":"h","text":"Survey analytics"},{"type":"p","text":"AI can help identify:"},{"type":"list","items":[{"text":"Response patterns"},{"text":"Anomalies"},{"text":"Segments"},{"text":"Relationships"},{"text":"Emerging themes"}]},{"type":"h","text":"Synthetic data"},{"type":"p","text":"Synthetic datasets can be useful for experimentation and training, but they should not be treated as a replacement for appropriately collected real-world evidence."},{"type":"h","text":"Ethical considerations"},{"type":"p","text":"Social researchers must understand:"},{"type":"list","items":[{"text":"Informed consent"},{"text":"Privacy"},{"text":"Anonymisation"},{"text":"Data security"},{"text":"Algorithmic bias"},{"text":"Sampling bias"},{"text":"Research integrity"},{"text":"Responsible AI"}]},{"type":"h","text":"Recommended Final Skill Stack"},{"type":"h","text":"Sociology"},{"type":"flow","items":["Social Theory","Indian Society","Social Institutions","Social Change"],"sep":"+"},{"type":"h","text":"Research"},{"type":"flow","items":["Research Design","Survey Methodology","Interviews","Ethnography","Mixed Methods"],"sep":"+"},{"type":"h","text":"Statistics"},{"type":"flow","items":["Descriptive Statistics","Inferential Statistics","Regression","Sampling"],"sep":"+"},{"type":"h","text":"Technology"},{"type":"flow","items":["Excel","SPSS/R","Power BI","SQL","Basic Python"],"sep":"+"},{"type":"h","text":"Professional"},{"type":"flow","items":["Academic Writing","Report Writing","Presentation","Fieldwork","Stakeholder Communication"],"sep":"+"},{"type":"h","text":"Emerging"},{"type":"flow","items":["AI-Assisted Research","Text Analysis","Digital Research","GIS"],"sep":"+"}]},{"heading":"Target Progression","kind":"growth","blocks":[{"type":"table","header":["Stage","Target Position"],"rows":[[{"text":"BA Year 1"},{"text":"Sociology + research foundation"}],[{"text":"BA Year 2"},{"text":"Research/data intern"}],[{"text":"BA Year 3"},{"text":"Social research/project intern"}],[{"text":"After BA"},{"text":"Research Assistant / Field Research Associate"}],[{"text":"2–4 years"},{"text":"Research Associate / Social Researcher"}],[{"text":"4–7 years"},{"text":"Senior Researcher / Research Analyst"}],[{"text":"7–12 years"},{"text":"Research Manager / Senior Social Scientist"}],[{"text":"12–20 years"},{"text":"Research Lead / Principal Researcher / Policy Advisor"}],[{"text":"Long term"},{"text":"Research Director / Academic / Policy Research Specialist"}]]},{"type":"h","text":"Best Overall Positioning"},{"type":"p","text":"For Social Researcher, the strongest career profile is:"},{"type":"flow","items":["BA Sociology","Research Methodology","Statistics","Fieldwork","Qualitative Research","Data Analytics","Academic Writing"],"sep":"+"},{"type":"p","text":"The most practical entry pathway is:"},{"type":"flow","items":["BA Sociology","Research Internship","Research Assistant/Field Research Associate","Social Researcher/Research Analyst","Senior Researcher","Research Lead"]},{"type":"p","text":"For stronger long-term opportunities, adding SPSS/R, Python, SQL, Power BI, GIS and programme evaluation can transform a traditional sociology profile into a modern social research and data professional, opening opportunities across research institutes, think tanks, NGOs, government programmes, consulting, social-impact organisations and market research."}]}]}