":[{"text":"Computer Science"},{"text":"Software Engineering"},{"text":"AI"},{"text":"Data Engineering"},{"text":"Computer Systems"},{"text":"Computational Mathematics"}]},{"type":"h","text":"MBA"},{"type":"p","text":"Useful later for:"},{"type":"list","items":[{"text":"Product Management"},{"text":"Technology Management"},{"text":"Engineering Management"},{"text":"Entrepreneurship"},{"text":"An MBA is generally not required to become a strong Software Engineer."}]}]},{"heading":"Career Specializations","kind":"other","blocks":[{"type":"h","text":"1. Backend Engineer"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"APIs"},{"text":"Databases"},{"text":"Distributed systems"},{"text":"Scalability"},{"text":"Security"}]},{"type":"h","text":"2. Full-Stack Engineer"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Frontend"},{"text":"Backend"},{"text":"APIs"},{"text":"Databases"},{"text":"Deployment"}]},{"type":"h","text":"3. Platform Engineer"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Developer infrastructure"},{"text":"CI/CD"},{"text":"Cloud"},{"text":"Internal platforms"},{"text":"Automation"}]},{"type":"h","text":"4. Data Engineer"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Data pipelines"},{"text":"SQL"},{"text":"Distributed processing"},{"text":"Data warehouses"},{"text":"Cloud"}]},{"type":"h","text":"5. AI/ML Engineer"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Machine learning"},{"text":"Python"},{"text":"Data"},{"text":"Model deployment"},{"text":"AI systems"}]},{"type":"h","text":"6. Systems Engineer"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Operating systems"},{"text":"Networking"},{"text":"Performance"},{"text":"Distributed systems"},{"text":"Low-level programming"}]}]},{"heading":"Mathematics & Computing Advantage","kind":"other","blocks":[{"type":"p","text":"Students from this specialization should exploit their mathematical background instead of b