owth","blocks":[{"type":"h","text":"Career progression"},{"type":"flow","items":["Video Editing Intern","Junior Video Editor","Video Editor","Senior Video Editor","Lead Editor","Post-Production Supervisor","Post-Production Head"]},{"type":"p","text":"Film route:"},{"type":"flow","items":["Assistant Editor","Film Editor","Senior Film Editor","Supervising Editor","Post-Production Director"]},{"type":"p","text":"Creative route:"},{"type":"flow","items":["Video Editor","Senior Editor","Creative Lead","Creative Director","Content/Studio Director"]},{"type":"p","text":"Freelance route:"},{"type":"flow","items":["Junior Editor","Freelance Editor","Specialist Editor","Boutique Post-Production Studio","Production Company"]},{"type":"h","text":"Strong research/specialisation areas"},{"type":"p","text":"For students interested in the academic/technology side:"},{"type":"list","items":[{"text":"Computational Video Editing"},{"text":"AI-Assisted Video Production"},{"text":"Computer Vision"},{"text":"Visual Storytelling"},{"text":"Film Studies"},{"text":"Digital Cinema"},{"text":"Virtual Production"},{"text":"Immersive Media"},{"text":"VR/AR Storytelling"},{"text":"Human-Computer Interaction"},{"text":"Digital Media Production"},{"text":"Generative Media"},{"text":"Video Compression"},{"text":"Media Archiving"}]},{"type":"h","text":"2040–2046"},{"type":"p","text":"The strongest future video professionals will combine editorial judgement, storytelling, motion graphics, colour, sound and AI-assisted workflows. Editors who can also understand audience analytics, branded content, virtual production and emerging generative-media technologies will have broader opportunities than editors focused only on traditional cutting."}]}]}