":"Excel"},{"text":"Power BI"},{"text":"Solar monitoring platforms"}]},{"type":"h","text":"Energy storage"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Lead-acid batteries"},{"text":"Lithium-ion batteries"},{"text":"LiFePO₄"},{"text":"Battery management systems"},{"text":"State of charge"},{"text":"Depth of discharge"},{"text":"Battery sizing"},{"text":"Hybrid inverters"},{"text":"Solar-plus-storage"},{"text":"Backup systems"},{"text":"Battery safety"}]},{"type":"h","text":"Specialisation"},{"type":"table","header":["Lane","Core stack","Learn from","Senior role it leads to"],"rows":[[{"text":"Rooftop Solar"},{"text":"PV + electrical + installation"},{"text":"EPC projects"},{"text":"Rooftop Solar Supervisor"}],[{"text":"Utility-Scale Solar"},{"text":"PV + high-voltage + SCADA"},{"text":"Solar farms"},{"text":"Solar Site Engineer"}],[{"text":"Solar O&M"},{"text":"Diagnostics + monitoring"},{"text":"O&M companies"},{"text":"O&M Engineer"}],[{"text":"Solar Design"},{"text":"PVsyst + AutoCAD + electrical design"},{"text":"EPC design teams"},{"text":"Solar Design Engineer"}],[{"text":"Solar + Storage"},{"text":"PV + batteries + power electronics"},{"text":"Storage projects"},{"text":"Energy Storage Specialist"}],[{"text":"Solar Commissioning"},{"text":"Testing + protection + grid systems"},{"text":"EPC/commissioning teams"},{"text":"Commissioning Engineer"}],[{"text":"Solar Monitoring"},{"text":"SCADA + IoT + data"},{"text":"Digital O&M"},{"text":"Solar Performance Analyst"}],[{"text":"Solar Entrepreneurship"},{"text":"Installation + sales + project management"},{"text":"EPC/business projects"},{"text":"Solar EPC Business Owner"}]]},{"type":"h","text":"Evolve and stay relevant, 2035–2046"},{"type":"p","text":"Do not remain limited to basic panel installation. Progress toward solar design, commissioning, energy storage, smart monitoring, SCADA, predictive maintenance and renewable-energy project management. AI and IoT will increasingly be used for fault detection, yield forecasting and predictive O&M."}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"h","text":"Government and training pathways"},{"type":"table","header":["Organisation","Relevant exposure"],"rows":[[{"text":"National Institute of Solar Energy (NISE)","url":"https://nise.res.in/"},{"text":"Solar-energy technology and training"}],[{"text":"Ministry of New and Renewable Energy (MNRE)","url":"https://mnre.gov.in/"},{"text":"Renewable-energy programmes and policy"}],[{"text":"Solar Energy Corporation of India (SECI)","url":"https://www.seci.co.in/"},{"text":"Utility-scale renewable projects"}],[{"text":"National Power Training Institute (NPTI)","url":"https://www.npti.gov.in/"},{"text":"Power-sector technical training"}],[{"text":"State renewable-energy agencies"},{"text":"Solar implementation and field projects"}],[{"text":"Solar EPC companies"},{"text":"Installation, commissioning and O&M"}]]},{"type":"h","text":"Private employers to monitor"},{"type":"list","items":[{"text":"Tata Power Solar","url":"https://www.tatapowersolar.com/"},{"text":"Adani Green Energy","url":"https://www.adanigreenenergy.com/"},{"text":"Waaree Energies","url":"https://waaree.com/"},{"text":"Vikram Solar","url":"https://www.vikramsolar.com/"},{"text":"RenewSys","url":"https://www.renewsysworld.com/"},{"text":"Solar EPC companies"},{"text":"Solar installation contractors"},{"text":"Solar O&M providers"},{"text":"Renewable-energy startups"}]},{"type":"h","text":"Best internship evidence"},{"type":"p","text":"Complete at least one real PV installation + perform commissioning/testing + maintain an O&M logbook + document the project with drawings, calculations and photographs."}]},{"heading":"Certifications in demand","kind":"certifications","blocks":[{"type":"table","header":["Certification/course","Cost","When","Why it helps"],"rows":[[{"text":"Solar PV Installation training"},{"text":"Provider-dependent;"},{"text":"Year 2–3"},{"text":"Practical installation"}],[{"text":"Solar PV Design"},{"text":"Paid; current fee: check the official site"},{"text":"Year 3"},{"text":"Design capability"}],[{"text":"PVsyst training"},{"text":"Provider-dependent"},{"text":"Year 3"},{"text":"Solar system modelling"}],[{"text":"Electrical Safety"},{"text":"Provider-dependent"},{"text":"Year 2–3"},{"text":"Safe field work"}],[{"text":"Work-at-Height Safety"},{"text":"Provider-dependent"},{"text":"Year 2–4"},{"text":"Rooftop safety"}],[{"text":"AutoCAD"},{"text":"Free/paid learning; certification fee: check the official site"},{"text":"Year 2–3"},{"text":"Technical drawings"}],[{"text":"Power BI"},{"text":"Free learning; exam fee: check the official site"},{"text":"Year 3–4"},{"text":"Performance dashboards"}],[{"text":"Battery/energy-storage training"},{"text":"Provider-dependent"},{"text":"Year 3–4"},{"text":"Solar-plus-storage"}]]},{"type":"p","text":"For broader renewable-energy learning, use NPTEL and official MNRE/NISE training programmes.","url":"https://nptel.ac.in/"}]},{"heading":"Careers you can be hired as","kind":"careers","blocks":[{"type":"h","text":"First-job titles"},{"type":"list","items":[{"text":"Solar Technician"},{"text":"Solar PV Technician"},{"text":"Solar Installation Technician"},{"text":"Solar O&M Technician"},{"text":"Solar Electrical Technician"},{"text":"Solar Field Technician"},{"text":"PV Installation Technician"},{"text":"Solar Maintenance Technician"},{"text":"Solar Commissioning Technician"},{"text":"Solar Service Technician"},{"text":"Renewable Energy Technician"},{"text":"Solar Site Technician"},{"text":"Solar Monitoring Technician"}]},{"type":"h","text":"With additional experience"},{"type":"list","items":[{"text":"Solar Site Supervisor"},{"text":"Solar O&M Engineer"},{"text":"Solar Design Engineer"},{"text":"Solar Commissioning Engineer"},{"text":"Solar Project Engineer"},{"text":"Solar Performance Analyst"},{"text":"Solar Quality Engineer"},{"text":"Renewable Energy Engineer"},{"text":"Solar Project Co