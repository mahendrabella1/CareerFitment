,"items":[{"text":"Professional judgment"},{"text":"Risk assessment"},{"text":"Complex accounting"},{"text":"Materiality decisions"},{"text":"Evidence evaluation"},{"text":"Professional skepticism"},{"text":"Client communication"},{"text":"Audit conclusions"}]},{"type":"p","text":"The future profile is therefore:"},{"type":"flow","items":["Auditor","Accounting Professional","Data Analyst","Technology/Controls Specialist"],"sep":"+"}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"h","text":"Accounting"},{"type":"list","items":[{"text":"Financial accounting"},{"text":"Corporate accounting"},{"text":"Cost accounting"},{"text":"Financial reporting"}]},{"type":"h","text":"Audit"},{"type":"list","items":[{"text":"Audit planning"},{"text":"Risk assessment"},{"text":"Materiality"},{"text":"Assertions"},{"text":"Audit evidence"},{"text":"Substantive testing"},{"text":"Internal controls"},{"text":"Sampling"},{"text":"Audit documentation"}]},{"type":"h","text":"Tax"},{"type":"list","items":[{"text":"Income tax fundamentals"},{"text":"GST"},{"text":"TDS"},{"text":"Tax reconciliation"}]},{"type":"h","text":"Compliance"},{"type":"list","items":[{"text":"Corporate law"},{"text":"Governance"},{"text":"Regulatory compliance"},{"text":"Professional ethics"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Advanced Excel"},{"text":"Power Query"},{"text":"Power BI"},{"text":"SQL"},{"text":"Python basics"},{"text":"ERP/SAP"},{"text":"Audit analytics"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Professional skepticism"},{"text":"Analytical thinking"},{"text":"Documentation"},{"text":"Communication"},{"text":"Client handling"},{"text":"Professional judgment"}]},{"type":"h","text":"Final Portfolio Target"},{"type":"p","text":"By graduation, the student should have:"},{"type":"list","items":[{"text":"Strong accounting fundamentals"},{"text":"Strong auditing fundamentals"},{"text":"GST and income-tax knowledge"},{"text":"Internal-control knowledge"},{"text":"Audit analytics skills"},{"text":"Advanced Excel"},{"text":"Power BI"},{"text":"Basic SQL"},{"text":"ERP exposure"},{"text":"2–3 audit case studies"},{"text":"Internal-control assessment project"},{"text":"Audit analytics dashboard"},{"text":"At least one relevant audit/finance internship or prescribed professional training exposure"},{"text":"Clear CA/CMA/CS pathway selection"}]},{"type":"h","text":"Target Graduate Profile"},{"type":"flow","items":["B.Com Accounting & Taxation","Financial Accounting","Auditing","Taxation","Corporate Law","Internal Controls","Risk Assessment","Audit Procedures","Excel","Audit Analytics","ERP","Professional Qualification (CA/CMA/CS as chosen)","Practical Training/Internship","Audit Associate","Senior Audit Associate","Audit Senior","Audit Manager","Senior Manager / Partner"]},{"type":"note","label":"Best-fit clusters","text":"Audit & Assurance, Accounting, Taxation, Internal Audit, Risk & Compliance, Financial Reporting, Forensic Audit, IT Audit & Audit Analytics."},{"type":"table","header":["ID","Level","Stream","Degree","Course / Specialisation","Career"],"rows":[[{"text":"1164"},{"text":"UG"},{"text":"Commerce"},{"text":"B.Com (Bachelor of Commerce)"},{"text":"B.Com – Accounting & Taxation (Integrated with CA/CMA/CS)"},{"text":"Cost Accountant Trainee"}]]}]}]}