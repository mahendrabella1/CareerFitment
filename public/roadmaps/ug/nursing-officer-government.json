itize:"},{"type":"list","items":[{"text":"Emergency nursing"},{"text":"Critical care"},{"text":"ICU fundamentals"},{"text":"Infection control"},{"text":"Emergency response"},{"text":"Trauma care"},{"text":"Patient safety"},{"text":"Clinical documentation"}]},{"type":"h","text":"Government Recruitment Preparation"},{"type":"p","text":"Depending on the recruitment body, prepare for:"},{"type":"list","items":[{"text":"Nursing fundamentals"},{"text":"Medical-Surgical Nursing"},{"text":"Community Health Nursing"},{"text":"Pharmacology"},{"text":"Anatomy & physiology"},{"text":"Pediatric nursing"},{"text":"Obstetric nursing"},{"text":"Mental health nursing"},{"text":"Nursing research"},{"text":"General aptitude"},{"text":"General awareness/current affairs where applicable"}]}]},{"heading":"Nursing Officer Career Flow","kind":"other","blocks":[{"type":"flow","items":["B.Sc Nursing","Clinical Training","Internship","Professional Registration","Government Recruitment Examination","Nursing Officer / Staff Nurse","Senior Nursing Responsibilities","Ward In-Charge / Senior Nursing Officer","Nursing Administration","Nursing Superintendent / Leadership"]}]},{"heading":"Core Skill-Gap Analysis","kind":"other","blocks":[{"type":"table","header":["Skill Area","Importance","Target Level"],"rows":[[{"text":"Nursing Fundamentals"},{"text":"⭐⭐⭐⭐⭐"},{"text":"Advanced"}],[{"text":"Anatomy & Physiology"},{"text":"⭐⭐⭐⭐⭐"},{"text":"Advanced"}],[{"text":"Medical-Surgical Nursing"},{"text":"⭐⭐⭐⭐⭐"},{"text":"Advanced"}],[{"text":"Pharmacology"},{"text":"⭐⭐⭐⭐⭐"},{"text":"Advanced"}],[{"text":"Patient Assessment"},{"text":"⭐⭐⭐⭐⭐"},{"text":"Advanced"}],[{"text":"Medication Administration"},{"text":"⭐⭐⭐⭐⭐"},{"text":"Advanced"}],[{"text":"Infection Control"},{"text":"⭐⭐⭐⭐⭐"},{"text":"Advanced"}],[{"text":"Emergency Nursing"},{"text":"⭐⭐⭐⭐⭐"},{"text":"Advanced"}],[{"text":"Community Health Nursing"},{"text":"⭐⭐⭐⭐⭐"},{"text":"Advanced"}],[{"text":"Pediatric Nursing"},{"text":"⭐⭐⭐⭐"},{"text":"Advanced"}