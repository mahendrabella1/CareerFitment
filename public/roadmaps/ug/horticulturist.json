":"list","items":[{"text":"Horticultural science"},{"text":"Plant science"},{"text":"Crop science"},{"text":"Controlled-environment agriculture"},{"text":"Plant breeding"},{"text":"Agricultural technology"}]},{"type":"p","text":"For international study, verify current university eligibility, program availability, fees, scholarships and visa requirements before applying."}]},{"heading":"Career Specialisations","kind":"other","blocks":[{"type":"h","text":"Path A — Commercial Horticulture"},{"type":"flow","items":["B.Sc Botany","Horticulture Trainee","Crop Specialist","Farm Manager","Horticulture Operations Head"]},{"type":"h","text":"Path B — Nursery Management"},{"type":"flow","items":["Botany","Nursery Executive","Nursery Supervisor","Nursery Manager","Nursery Operations Head"]},{"type":"h","text":"Path C — Protected Cultivation"},{"type":"flow","items":["Botany","Greenhouse Executive","Protected Cultivation Specialist","Greenhouse Manager","Controlled-Environment Agriculture Manager"]},{"type":"h","text":"Path D — Floriculture"},{"type":"flow","items":["Botany","Floriculture Executive","Flower Production Specialist","Floriculture Manager","Export/Production Manager"]},{"type":"h","text":"Path E — Research"},{"type":"flow","items":["Botany","Research Assistant","M.Sc.","Research Associate","PhD","Scientist/Professor"]},{"type":"h","text":"Path F — Precision Horticulture"},{"type":"flow","items":["Botany","Horticulture Specialist","Precision Agriculture/Horticulture Analyst","Smart Farming Specialist","Digital Agriculture Manager"]}]},{"heading":"Future Horticulture — 2030–2040","kind":"other","blocks":[{"type":"p","text":"Horticulture is moving toward increasingly controlled, data-driven and resource-efficient production."},{"type":"p","text":"Important technologies include:"},{"type":"list","items":[{"text":"Precision horticulture"},{"text":"Smart irrigation"},{"text":"Automated fertigation"},{"text":"Greenhouse automation"},{"text":"Controlled-environment agricult