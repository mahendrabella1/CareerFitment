ership"},{"text":"Director"}]]}]},{"heading":"Year-by-Year Learning Roadmap","kind":"build","blocks":[{"type":"h","text":"Year 1: Basics"},{"type":"list","items":[{"text":"Animal science"},{"text":"Livestock types and breeds"},{"text":"Visit a veterinary dispensary"}]},{"type":"h","text":"Year 2: Livestock management"},{"type":"list","items":[{"text":"Animal nutrition and breeding"},{"text":"Common diseases and vaccination"},{"text":"Fodder production"}]},{"type":"h","text":"Year 3: Extension"},{"type":"list","items":[{"text":"Intern with a livestock project"},{"text":"Run a farmer awareness session"},{"text":"Learn livestock schemes"}]},{"type":"h","text":"Year 4: Exams and placement"},{"type":"list","items":[{"text":"RAWE / ELP in livestock"},{"text":"Check your state's eligibility and prepare for exams"},{"text":"Apply to dairy and livestock projects"}]}]},{"heading":"Essential Skills","kind":"build","blocks":[{"type":"table","header":["Skill","Type"],"rows":[[{"text":"Livestock management"},{"text":"Technical"}],[{"text":"Breeding and nutrition"},{"text":"Technical"}],[{"text":"Disease prevention"},{"text":"Technical"}],[{"text":"Scheme implementation"},{"text":"Technical"}],[{"text":"Farmer communication"},{"text":"Professional"}],[{"text":"Field work"},{"text":"Professional"}],[{"text":"Organisation"},{"text":"Professional"}]]}]},{"heading":"Tools and Technologies to Learn","kind":"build","blocks":[{"type":"list","items":[{"text":"INAPH and livestock data apps"},{"text":"Excel"}]}]},{"heading":"Internships and Practical Experience","kind":"internships","blocks":[{"type":"list","items":[{"text":"State animal husbandry departments"},{"text":"Dairy cooperatives"},{"text":"Livestock NGOs"}]}]},{"heading":"Certifications and Additional Training","kind":"certifications","blocks":[{"type":"list","items":[{"text":"Artificial insemination training (where eligible)"},{"text":"Livestock management courses"}]},{"type":"note","label":"Before you enrol","text":"Check the cu