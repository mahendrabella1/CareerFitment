"},{"text":"Critical-care monitoring"},{"text":"Emergency response"},{"text":"Operating-room management"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Anaesthesia information systems"},{"text":"Biomedical equipment management"},{"text":"Excel"},{"text":"Power BI"},{"text":"Medical-device technology"},{"text":"Certifications should supplement—not replace—the recognized qualification and supervised clinical training required for the role."}]}]},{"heading":"PG & Advanced Education","kind":"pg_india","blocks":[{"type":"p","text":"Depending on eligibility:"},{"type":"h","text":"Anaesthesia / Allied Health"},{"type":"list","items":[{"text":"M.Sc Anaesthesia Technology"},{"text":"Advanced Anaesthesia Technology"},{"text":"Critical Care-related postgraduate programs"},{"text":"Operation Theatre Technology-related postgraduate programs"}]},{"type":"h","text":"Critical Care"},{"type":"list","items":[{"text":"Critical Care Technology"},{"text":"Respiratory/critical-care related programs where eligible"}]},{"type":"h","text":"Management"},{"type":"list","items":[{"text":"MBA Healthcare Management"},{"text":"Hospital Administration"},{"text":"Healthcare Operations"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Health Informatics"},{"text":"Biomedical Technology"},{"text":"Medical Device Management"}]}]},{"heading":"Career Specializations","kind":"other","blocks":[{"type":"h","text":"1. General Anaesthesia Technologist"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"General surgery"},{"text":"Orthopaedics"},{"text":"ENT"},{"text":"Gynecology"},{"text":"Urology"},{"text":"General OT"}]},{"type":"h","text":"2. Cardiac Anaesthesia Technologist"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Cardiac surgery"},{"text":"Advanced monitoring"},{"text":"Cardiac anaesthesia equipment"},{"text":"Critical-care workflow"}]},{"type":"h","text":"3. Neuro-Anaesthesia Technologist"},{"type":"p","text":"Focus:"},{"type":