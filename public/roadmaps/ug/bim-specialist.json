ct parameters"},{"text":"View templates"},{"text":"Filters"},{"text":"Worksets"},{"text":"Design options"},{"text":"Linked models"},{"text":"Phasing"},{"text":"Detail components"},{"text":"Annotation standards"},{"text":"Schedules"},{"text":"Material takeoffs"},{"text":"Sheet management"},{"text":"Project templates"}]},{"type":"h","text":"BIM Documentation"},{"type":"p","text":"Produce:"},{"type":"list","items":[{"text":"GA drawings"},{"text":"Floor plans"},{"text":"Sections"},{"text":"Elevations"},{"text":"Construction details"},{"text":"Door/window schedules"},{"text":"Room schedules"},{"text":"Finish schedules"},{"text":"Material schedules"},{"text":"Sheet sets"}]},{"type":"h","text":"Coordination"},{"type":"p","text":"Start learning:"},{"type":"list","items":[{"text":"Architectural model coordination"},{"text":"Structural model coordination"},{"text":"MEP model coordination"},{"text":"Linked models"},{"text":"Coordinates"},{"text":"Model federation"},{"text":"Clash detection"}]},{"type":"h","text":"Year 4 — BIM Specialization"},{"type":"p","text":"The final year should focus heavily on professional BIM workflows."}]},{"heading":"BIM Coordination","kind":"other","blocks":[{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Federated models"},{"text":"Architectural coordination"},{"text":"Structural coordination"},{"text":"MEP coordination"},{"text":"Clash detection"},{"text":"Clash classification"},{"text":"Issue tracking"},{"text":"Model review"},{"text":"Coordination meetings"}]},{"type":"p","text":"Tools can include:"},{"type":"list","items":[{"text":"Revit"},{"text":"Navisworks"},{"text":"Solibri or similar model-checking platforms"}]}]},{"heading":"BIM Standards","kind":"other","blocks":[{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"BIM Execution Plans"},{"text":"Naming conventions"},{"text":"Model organization"},{"text":"File structures"},{"text":"Project templates"},{"text":"Model sharing"},{"text":"Revision management"},{"te