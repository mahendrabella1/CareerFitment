treatment"},{"type":"h","text":"Evidence hierarchy"},{"type":"h","text":"Health Claim"},{"type":"h","text":"Scientific Literature"},{"type":"h","text":"Evidence Quality"},{"type":"h","text":"Risk–Benefit Assessment"},{"type":"h","text":"Appropriate Communication"},{"type":"h","text":"Avoid unsupported statements such as:"},{"type":"h","text":"Guaranteed cure"},{"type":"h","text":"Permanent treatment"},{"type":"h","text":"Disease reversal without evidence"},{"type":"h","text":"\"No side effects\""},{"type":"h","text":"Replacing prescribed treatment"}]},{"heading":"Projects During BHMS","kind":"other","blocks":[{"type":"h","text":"Project 1 — Personal Wellness Assessment Framework"},{"type":"h","text":"Create a structured assessment covering:"},{"type":"h","text":"Sleep"},{"type":"h","text":"Physical activity"},{"type":"h","text":"Diet"},{"type":"h","text":"Stress"},{"type":"h","text":"Work habits"},{"type":"h","text":"Social wellbeing"},{"type":"h","text":"Digital habits"},{"type":"h","text":"Project 2 — Corporate Wellness Program"},{"type":"h","text":"Design a 12-week program with:"},{"type":"h","text":"Employee assessment"},{"type":"h","text":"Wellness goals"},{"type":"h","text":"Workshops"},{"type":"h","text":"Activity challenges"},{"type":"h","text":"Progress measurement"},{"type":"h","text":"Feedback"},{"type":"h","text":"Project 3 — Sleep-Wellness Study"},{"type":"h","text":"Study:"},{"type":"h","text":"Sleep duration"},{"type":"h","text":"Screen exposure"},{"type":"h","text":"Stress"},{"type":"h","text":"Physical activity"},{"type":"h","text":"Productivity"},{"type":"p","text":"Use appropriate survey methodology and basic statistics."},{"type":"h","text":"Project 4 — Wellness Dashboard"},{"type":"h","text":"Create a dashboard tracking:"},{"type":"h","text":"Participation"},{"type":"h","text":"Activity"},{"type":"h","text":"Sleep"},{"type":"h","text":"Wellness goals"},{"type":"h","text":"Program completion"},{"type":"h","text":"Survey outcomes"},{"type":"h","te