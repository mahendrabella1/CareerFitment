"},{"type":"list","items":[{"text":"Moot courts"},{"text":"Arbitration moots"},{"text":"Negotiation competitions"},{"text":"Mediation competitions"},{"text":"Client counselling"},{"text":"Legal research competitions"}]},{"type":"h","text":"Particularly useful"},{"type":"p","text":"International commercial arbitration moot competitions can provide exposure to:"},{"type":"list","items":[{"text":"Complex facts"},{"text":"Arbitration procedure"},{"text":"Contract interpretation"},{"text":"International legal research"},{"text":"Written submissions"},{"text":"Oral advocacy"}]}]},{"heading":"Projects During LL.B.","kind":"other","blocks":[{"type":"h","text":"Project 1 — Sports Arbitration Case Study"},{"type":"p","text":"Select a publicly available sports dispute and analyze:"},{"type":"list","items":[{"text":"Facts"},{"text":"Contract"},{"text":"Dispute"},{"text":"Applicable rules"},{"text":"Arguments"},{"text":"Decision"},{"text":"Legal implications"}]},{"type":"h","text":"Project 2 — Sports Contract Review"},{"type":"p","text":"Create a fictional athlete contract and identify:"},{"type":"list","items":[{"text":"Risky clauses"},{"text":"Termination provisions"},{"text":"Compensation"},{"text":"Exclusivity"},{"text":"Dispute-resolution mechanism"}]},{"type":"h","text":"Project 3 — Arbitration Clause Comparison"},{"type":"p","text":"Compare arbitration clauses with respect to:"},{"type":"list","items":[{"text":"Seat"},{"text":"Venue"},{"text":"Governing law"},{"text":"Institution"},{"text":"Number of arbitrators"},{"text":"Appointment procedure"},{"text":"Language"}]},{"type":"h","text":"Project 4 — Arbitration Case File"},{"type":"p","text":"Build a complete fictional case file containing:"},{"type":"flow","items":["Statement of Facts","Issues","Contract","Evidence","Statement of Claim","Statement of Defence","Written Submissions","Draft Award"]},{"type":"p","text":"This can become a strong portfolio project."}]},{"heading":"Internship Strategy","kind":"internships","blo