s"}]},{"type":"h","text":"Execution"},{"type":"p","text":"Prepare for:"},{"type":"list","items":[{"text":"engineering delays"},{"text":"scope changes"},{"text":"conflicting priorities"},{"text":"product bugs"},{"text":"stakeholder disagreements"}]},{"type":"h","text":"Behavioral"},{"type":"p","text":"Prepare examples showing:"},{"type":"list","items":[{"text":"leadership"},{"text":"ownership"},{"text":"communication"},{"text":"failure"},{"text":"problem solving"},{"text":"teamwork"}]},{"type":"p","text":"Use structured storytelling such as:"},{"type":"flow","items":["Situation","Task","Action","Result","Learning"]}]},{"heading":"Postgraduate Study in India","kind":"pg_india","blocks":[{"type":"p","text":"A postgraduate degree is not mandatory for product management."},{"type":"p","text":"Relevant options include:"},{"type":"table","header":["PG Route","Use"],"rows":[[{"text":"MBA"},{"text":"Product/business leadership"}],[{"text":"MBA in Product Management"},{"text":"Product specialization"}],[{"text":"MBA in Marketing"},{"text":"Consumer/growth products"}],[{"text":"MBA in Business Analytics"},{"text":"Data-driven product roles"}],[{"text":"M.Tech CSE"},{"text":"Technical product management"}],[{"text":"MS CSE"},{"text":"Technical product roles"}],[{"text":"M.Des / HCI"},{"text":"UX/product design direction"}]]},{"type":"h","text":"Entrance Routes"},{"type":"p","text":"Depending on the program:"},{"type":"list","items":[{"text":"CAT"},{"text":"XAT"},{"text":"GMAT"},{"text":"institute-specific examinations"},{"text":"GATE for relevant technical PG programs"}]},{"type":"p","text":"IIM CAT Official Website\nGATE Official Website","url":"https://iimcat.ac.in/"},{"type":"p","text":"Admission requirements vary by institution and year."}]},{"heading":"Study Abroad","kind":"abroad","blocks":[{"type":"p","text":"Relevant master's/MBA areas include:"},{"type":"list","items":[{"text":"Product Management"},{"text":"Business Analytics"},{"text":"Technology Management"},{"text":