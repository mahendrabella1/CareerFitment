"items":["Transactions","Tax Classification","Invoice Review","Input / Output Reconciliation","Compliance Checklist","Exception Report"]},{"type":"p","text":"Use current rules only when performing a real compliance exercise."},{"type":"h","text":"Project 3 — Compliance Risk Register"},{"type":"p","text":"Create a risk register with:"},{"type":"list","items":[{"text":"Compliance obligation"},{"text":"Risk"},{"text":"Probability"},{"text":"Impact"},{"text":"Risk score"},{"text":"Existing control"},{"text":"Responsible owner"},{"text":"Corrective action"}]},{"type":"h","text":"Project 4 — Corporate Compliance Dashboard"},{"type":"p","text":"Build an Excel/Power BI dashboard containing:"},{"type":"list","items":[{"text":"Open compliance items"},{"text":"Upcoming deadlines"},{"text":"Overdue items"},{"text":"High-risk items"},{"text":"Department"},{"text":"Responsible owner"},{"text":"Completion rate"}]},{"type":"h","text":"Project 5 — Regulatory Change Tracker"},{"type":"p","text":"Create a system that tracks:"},{"type":"list","items":[{"text":"Regulation"},{"text":"Date"},{"text":"Change"},{"text":"Affected department"},{"text":"Business impact"},{"text":"Required action"},{"text":"Implementation status"}]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"h","text":"Best Internship Environments"},{"type":"table","header":["Environment","Exposure"],"rows":[[{"text":"Tax Advisory Firm"},{"text":"Very High"}],[{"text":"Corporate Legal Department"},{"text":"Very High"}],[{"text":"Big Accounting/Consulting Firm"},{"text":"Very High"}],[{"text":"Compliance Team"},{"text":"Very High"}],[{"text":"Bank / Financial Institution"},{"text":"High"}],[{"text":"Insurance Company"},{"text":"High"}],[{"text":"Corporate Finance Department"},{"text":"High"}],[{"text":"Law Firm – Tax Practice"},{"text":"Very High"}],[{"text":"Regulatory Consulting"},{"text":"High"}],[{"text":"Startup Legal/Compliance Team"},{"text":"High"}]]},{"type":"h","text":"Internship Progres