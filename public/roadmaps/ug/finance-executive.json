s"},{"text":"Payables"},{"text":"Budget vs actual"}]},{"type":"h","text":"SQL"},{"type":"p","text":"Basic SQL becomes useful when finance teams work with large ERP/data systems."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"SELECT"},{"text":"WHERE"},{"text":"GROUP BY"},{"text":"JOIN"},{"text":"CASE"},{"text":"Aggregations"},{"text":"Subqueries"}]},{"type":"p","text":"Example:"},{"type":"flow","items":["ERP database","SQL","Financial dataset","Power BI","Management dashboard"]},{"type":"h","text":"Finance Automation"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Power Query"},{"text":"Power Automate"},{"text":"Excel automation"},{"text":"RPA fundamentals"},{"text":"Automated reporting"},{"text":"Workflow automation"}]},{"type":"p","text":"Example:"},{"type":"flow","items":["Bank statement","automated import","reconciliation","exception report","finance dashboard"]},{"type":"p","text":"The goal is to reduce repetitive manual work."},{"type":"h","text":"Specialisation Options"},{"type":"table","header":["Specialisation","Additional Skills"],"rows":[[{"text":"Accounting"},{"text":"Financial accounting, ERP, taxation"}],[{"text":"FP&A"},{"text":"Forecasting, budgeting, modelling"}],[{"text":"Financial Analysis"},{"text":"Valuation, ratios, modelling"}],[{"text":"Corporate Finance"},{"text":"Capital structure, investments, strategy"}],[{"text":"Treasury"},{"text":"Cash, liquidity, FX, banking"}],[{"text":"Tax"},{"text":"GST, direct tax, compliance"}],[{"text":"Audit"},{"text":"Internal controls, audit procedures"}],[{"text":"Management Accounting"},{"text":"Costing, budgets, performance"}],[{"text":"Investment Analysis"},{"text":"Markets, valuation, research"}],[{"text":"Finance Analytics"},{"text":"SQL, Power BI, Python"}],[{"text":"FinTech"},{"text":"Data, APIs, financial technology"}]]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Corporate finance departments"},{"text":"Accounting firms"},{"text":"CA firms"},{"text":"Banks"},{"text":"NBFCs"},{"text":"Insurance companies"},{"text":"FinTech companies"},{"text":"Investment firms"},{"text":"Shared-service centres"},{"text":"Startups"},{"text":"Manufacturing companies"},{"text":"Consulting firms"}]},{"type":"h","text":"Internship Roles"},{"type":"p","text":"Search for:"},{"type":"list","items":[{"text":"Finance Intern"},{"text":"Accounts Intern"},{"text":"Financial Analyst Intern"},{"text":"FP&A Intern"},{"text":"Accounting Intern"},{"text":"Finance Operations Intern"},{"text":"MIS Finance Intern"},{"text":"Audit Intern"},{"text":"Tax Intern"}]},{"type":"h","text":"Strong Internship Project"},{"type":"h","text":"Financial Planning & Analysis Dashboard"},{"type":"p","text":"Take a realistic company's financial data and build:"},{"type":"h","text":"Step 1 — Historical Data"},{"type":"p","text":"Collect:"},{"type":"list","items":[{"text":"Revenue"},{"text":"COGS"},{"text":"Operating expenses"},{"text":"Payroll"},{"text":"Working capital"},{"text":"Cash flow"}]},{"type":"h","text":"Step 2 — Financial Model"},{"type":"p","text":"Create:"},{"type":"h","text":"3-year forecast → Base/Best/Worst cases"},{"type":"h","text":"Step 3 — Variance Analysis"},{"type":"p","text":"Compare:"},{"type":"h","text":"Budget vs Actual"},{"type":"h","text":"Step 4 — Dashboard"},{"type":"p","text":"Build a Power BI dashboard showing:"},{"type":"list","items":[{"text":"Revenue"},{"text":"Gross profit"},{"text":"EBITDA"},{"text":"Net profit"},{"text":"Expenses"},{"text":"Cash flow"},{"text":"Receivables"},{"text":"Budget variance"}]},{"type":"h","text":"Step 5 — Management Report"},{"type":"p","text":"Write a short report explaining:"},{"type":"list","items":[{"text":"What changed"},{"text":"Why it changed"},{"text":"Major risks"},{"text":"Recommended actions"}]},{"type":"flow","items":["This demonstrates finance","accounting","analytics","business communication."],"sep":"+"}]},{"heading":"Certifications and Learning","kind":"certifications","blocks":[{"type":"p","text":"Useful qualifications depend on the desired specialisation."},{"type":"h","text":"Accounting / Finance"},{"type":"list","items":[{"text":"Tally/ERP training"},{"text":"Advanced Excel"},{"text":"Financial modelling"}]},{"type":"h","text":"Professional Finance"},{"type":"p","text":"Consider:"},{"type":"list","items":[{"text":"CA"},{"text":"CMA"},{"text":"CFA"},{"text":"ACCA"}]},{"type":"p","text":"The best choice depends on whether the student wants:"},{"type":"list","items":[{"text":"Accounting/audit/tax → CA/ACCA"},{"text":"Cost/management accounting → CMA"},{"text":"Investment/portfolio/valuation → CFA"}]},{"type":"p","text":"Professional qualification eligibility, exam structures and current requirements should be verified with the respective official bodies."},{"type":"h","text":"Analytics"},{"type":"list","items":[{"text":"Power BI"},{"text":"SQL"},{"text":"Financial analytics"},{"text":"Python for finance"}]}]},{"heading":"Careers You Can Be Hired As","kind":"careers","blocks":[{"type":"h","text":"Entry-Level"},{"type":"list","items":[{"text":"Finance Executive"},{"text":"Accounts Executive"},{"text":"Finance Operations Executive"},{"text":"Accounts Payable Executive"},{"text":"Accounts Receivable Executive"},{"text":"Junior Financial Analyst"},{"text":"Finance Associate"},{"text":"MIS Executive"},{"text":"Audit Associate"},{"text":"Tax Associate"}]},{"type":"h","text":"With Experience"},{"type":"list","items":[{"text":"Financial Analyst"},{"text":"FP&A Analyst"},{"text":"Senior Finance Executive"},{"text":"Senior Financial Analyst"},{"text":"Treasury Analyst"},{"text":"Management Accountant"},{"text":"Finance Business Partner"}]},{"type":"h","text":"Leadership"},{"type":"list","items":[{"text":"Finance Manager"},{"text":"FP&A Manager"},{"text":"Finance Controller"},{"text":"Treasury Manager"},{"text":"Head of Finance"},{"text":"CFO"}]},{"type":"h","text":"Interview Questions"},{"type":"p","te