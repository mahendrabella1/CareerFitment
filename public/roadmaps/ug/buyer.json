ships"}]}]},{"heading":"International Sourcing Route","kind":"other","blocks":[{"type":"p","text":"Another pathway is:"},{"type":"h","text":"Buyer"},{"type":"flow","items":["Sourcing Executive","Sourcing Manager","International Sourcing Manager","Head of Sourcing"]},{"type":"p","text":"This route develops expertise in:"},{"type":"list","items":[{"text":"Global suppliers"},{"text":"Import/export"},{"text":"Incoterms"},{"text":"International logistics"},{"text":"Quality control"},{"text":"Currency effects"},{"text":"International negotiations"},{"text":"Supplier diversification"}]}]},{"heading":"E-Commerce Buying Route","kind":"other","blocks":[{"type":"p","text":"Online retail creates a highly data-driven buying role."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Online assortment"},{"text":"Search trends"},{"text":"Conversion rate"},{"text":"Product-page performance"},{"text":"Digital merchandising"},{"text":"Dynamic pricing"},{"text":"Promotions"},{"text":"Customer reviews"},{"text":"Marketplace analytics"},{"text":"Digital demand forecasting"}]},{"type":"p","text":"A future e-commerce buyer may make decisions using:"},{"type":"flow","items":["Customer data","search behaviour","sales history","AI demand forecasts."],"sep":"+"}]},{"heading":"AI and Future of Buying","kind":"other","blocks":[{"type":"p","text":"AI will increasingly support:"},{"type":"list","items":[{"text":"Demand forecasting"},{"text":"Trend detection"},{"text":"Product recommendations"},{"text":"Supplier evaluation"},{"text":"Pricing optimisation"},{"text":"Inventory optimisation"},{"text":"Automated purchase suggestions"},{"text":"Customer-demand prediction"},{"text":"Assortment planning"},{"text":"Markdown optimisation"}]},{"type":"h","text":"Traditional buyer"},{"type":"flow","items":["Historical sales","Manual analysis","Product selection","Supplier negotiation"]},{"type":"h","text":"AI-enabled buyer"},{"type":"flow","items":["Customer data","AI demand prediction","Automated 