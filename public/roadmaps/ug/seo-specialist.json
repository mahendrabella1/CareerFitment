eting"},{"text":"E-commerce"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"HTML/CSS"},{"text":"JavaScript fundamentals"},{"text":"Python"},{"text":"SQL"},{"text":"Power BI"}]},{"type":"p","text":"Certifications can support an entry-level resume, but measurable SEO projects and real website results are generally more valuable."}]},{"heading":"Jobs You Can Target","kind":"careers","blocks":[{"type":"h","text":"Direct-entry roles"},{"type":"table","header":["Role","Focus"],"rows":[[{"text":"SEO Specialist"},{"text":"Search optimisation"}],[{"text":"SEO Executive"},{"text":"SEO implementation"}],[{"text":"SEO Analyst"},{"text":"Data & SEO analysis"}],[{"text":"Junior SEO Specialist"},{"text":"SEO execution"}],[{"text":"Technical SEO Executive"},{"text":"Technical optimisation"}],[{"text":"Technical SEO Analyst"},{"text":"Technical audits"}],[{"text":"SEO Content Executive"},{"text":"Content optimisation"}],[{"text":"E-Commerce SEO Executive"},{"text":"Product/category SEO"}],[{"text":"Local SEO Executive"},{"text":"Local search"}],[{"text":"Organic Growth Associate"},{"text":"Organic acquisition"}],[{"text":"Digital Marketing Executive"},{"text":"Broader digital marketing"}],[{"text":"Search Marketing Analyst"},{"text":"Search data"}],[{"text":"Content Marketing Associate"},{"text":"Content + SEO"}]]}]},{"heading":"Employer-Ready Skill Stack","kind":"other","blocks":[{"type":"p","text":"A strong entry-level SEO candidate should have:"},{"type":"h","text":"SEO"},{"type":"flow","items":["Keyword Research","On-Page","Technical SEO","Content SEO"],"sep":"+"},{"type":"h","text":"Technology"},{"type":"flow","items":["HTML","CSS","JavaScript basics"],"sep":"+"},{"type":"h","text":"Analytics"},{"type":"flow","items":["Search Console","Google Analytics","Excel"],"sep":"+"},{"type":"h","text":"Data"},{"type":"flow","items":["Power BI","SQL","basic Python"],"sep":"+"},{"type":"h","text":"E-Commerce"},{"type":"flow","items":["Product SEO","Category SEO","Conv