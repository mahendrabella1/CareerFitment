eful for:"},{"type":"list","items":[{"text":"Restaurants"},{"text":"Clinics"},{"text":"Hotels"},{"text":"Education"},{"text":"Local services"},{"text":"Retail"},{"text":"Real estate"}]}]},{"heading":"Content SEO","kind":"other","blocks":[{"type":"p","text":"Learn how to create content based on:"},{"type":"list","items":[{"text":"Search intent"},{"text":"User needs"},{"text":"Topic coverage"},{"text":"Original research"},{"text":"Expert information"},{"text":"Helpful structure"},{"text":"Internal linking"},{"text":"Content updates"}]},{"type":"p","text":"Understand the difference between:"},{"type":"h","text":"Content written for search engines"},{"type":"p","text":"and"},{"type":"p","text":"Content designed to genuinely satisfy users arriving from search."},{"type":"p","text":"The second is the stronger long-term strategy."}]},{"heading":"AI-Era SEO","kind":"other","blocks":[{"type":"p","text":"AI is changing search behaviour and content production."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"AI-assisted keyword clustering"},{"text":"Content research"},{"text":"SERP analysis"},{"text":"Content briefs"},{"text":"Automated reporting"},{"text":"NLP"},{"text":"Entity extraction"},{"text":"Semantic analysis"},{"text":"AI search visibility"},{"text":"AI-generated summaries"},{"text":"Search answer systems"}]},{"type":"p","text":"But avoid producing large volumes of generic AI content without editorial quality control."},{"type":"p","text":"The future SEO professional needs to combine:"},{"type":"flow","items":["AI productivity","original expertise","data","technical SEO","editorial judgement"],"sep":"+"}]},{"heading":"Year-by-Year Development Plan","kind":"build","blocks":[{"type":"h","text":"Year 1"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Digital marketing"},{"text":"Search fundamentals"},{"text":"Keyword research"},{"text":"Content fundamentals"},{"text":"HTML"},{"text":"Analytics basics"}]},{"type":"h","text":"Project"},{"type":"p","text":"Create a small website and perform:"},{"type":"list","items":[{"text":"Keyword research"},{"text":"On-page optimisation"},{"text":"Internal linking"},{"text":"Search Console setup"},{"text":"Analytics setup"}]},{"type":"h","text":"Year 2"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Technical SEO"},{"text":"Site architecture"},{"text":"Crawling/indexing"},{"text":"Page performance"},{"text":"Schema"},{"text":"Local SEO"}]},{"type":"h","text":"Project"},{"type":"p","text":"Perform a complete technical audit of a website."},{"type":"p","text":"Deliver:"},{"type":"list","items":[{"text":"20–30 technical issues"},{"text":"Severity classification"},{"text":"Recommended fixes"},{"text":"Before/after measurements"}]},{"type":"h","text":"Year 3"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"E-commerce SEO"},{"text":"Advanced analytics"},{"text":"Competitor analysis"},{"text":"Content strategy"},{"text":"Link acquisition"},{"text":"Python/automation"}]},{"type":"h","text":"Project"},{"type":"p","text":"Create an:"},{"type":"h","text":"E-Commerce SEO Growth Plan"},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Keyword clusters"},{"text":"Category strategy"},{"text":"Product-page optimisation"},{"text":"Internal linking"},{"text":"Technical audit"},{"text":"Content calendar"},{"text":"KPI dashboard"}]},{"type":"h","text":"Year 4"},{"type":"p","text":"Develop a complete SEO portfolio."},{"type":"p","text":"Build:"},{"type":"h","text":"SEO Performance Dashboard"},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Organic clicks"},{"text":"Impressions"},{"text":"CTR"},{"text":"Ranking trends"},{"text":"Organic landing pages"},{"text":"Conversions"},{"text":"Revenue"},{"text":"Technical issues"},{"text":"Content performance"}]}]},{"heading":"Four-Year Skill Plan","kind":"other","blocks":[{"type":"table","header":["Skill","Year 1","Year 2","Year 3","Year 4"],"rows":[[{"text":"SEO Fundamentals"},{"text":"★★