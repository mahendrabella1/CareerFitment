{"title":"Career Roadmap · Claims Executive","role":"Claims Executive","summary":"A Claims Executive handles insurance claims from registration through assessment, documentation, verification, settlement or rejection.","facts":{"Current degree":"B.Com (Bachelor of Commerce)","Course":"B.Com – Banking & Insurance"},"about":[{"label":"Alignment","text":"Very Strong"},{"label":"Typical Entry Level","text":"Claims Executive / Claims Associate / Claims Processor / Claims Analyst – Junior"}],"intro":[],"horizons":[],"sections":[{"heading":"Career Overview","kind":"other","blocks":[{"type":"p","text":"A Claims Executive handles insurance claims from registration through assessment, documentation, verification, settlement or rejection."},{"type":"p","text":"The role sits at the intersection of:"},{"type":"flow","items":["Insurance","Finance","Documentation","Customer Service","Risk","Compliance","Data"],"sep":"+"},{"type":"p","text":"B.Com Banking & Insurance is therefore a directly relevant undergraduate pathway."},{"type":"p","text":"A Claims Executive may work in:"},{"type":"list","items":[{"text":"Life insurance"},{"text":"Health insurance"},{"text":"Motor insurance"},{"text":"Property insurance"},{"text":"Travel insurance"},{"text":"Marine insurance"},{"text":"Corporate insurance"},{"text":"General insurance"},{"text":"Third-party administrator (TPA) operations"}]}]},{"heading":"Career Horizon","kind":"horizons","blocks":[{"type":"table","header":["Stage","Typical Role","Main Focus"],"rows":[[{"text":"Year 1"},{"text":"Insurance Intern"},{"text":"Insurance fundamentals"}],[{"text":"Year 2"},{"text":"Claims Intern"},{"text":"Documentation & claims process"}],[{"text":"Year 3"},{"text":"Insurance Operations Intern"},{"text":"Claims assessment"}],[{"text":"Graduation"},{"text":"Claims Executive / Associate"},{"text":"Claims processing"}],[{"text":"2–4 Years"},{"text":"Claims Analyst / Senior Executive"},{"text":"Investigation & assessment"}],[{"text":"4–7 Years"},{"text":