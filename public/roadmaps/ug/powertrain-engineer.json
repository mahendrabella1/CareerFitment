es"},{"type":"table","header":["Organisation / route","Relevant exposure"],"rows":[[{"text":"PM Internship Scheme"},{"text":"Automotive, manufacturing and engineering opportunities depending on participating companies"}],[{"text":"ARAI"},{"text":"Automotive testing, certification, powertrain and vehicle engineering exposure"}],[{"text":"CSIR laboratories"},{"text":"Automotive, combustion, materials or propulsion research where relevant"}],[{"text":"DRDO"},{"text":"Propulsion, engines, controls and automotive/defence mobility systems where relevant"}],[{"text":"ISRO"},{"text":"Propulsion, thermal systems and control engineering where relevant"}],[{"text":"Government automotive research/testing facilities"},{"text":"Vehicle and powertrain testing"}]]},{"type":"p","text":"Official starting points:"},{"type":"p","text":"PM Internship Scheme\nDRDO\nISRO Careers","url":"https://pminternship.mca.gov.in/"},{"type":"p","text":"Availability and eligibility vary by year."},{"type":"h","text":"Private / Industry Routes"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Automotive OEMs"},{"text":"EV manufacturers"},{"text":"Powertrain suppliers"},{"text":"Transmission manufacturers"},{"text":"Automotive component companies"},{"text":"Battery companies"},{"text":"Motor/inverter companies"},{"text":"Automotive software companies"},{"text":"Testing and validation organisations"},{"text":"Engineering R&D companies"}]},{"type":"p","text":"Companies worth investigating include:"},{"type":"list","items":[{"text":"Tata Motors"},{"text":"Mahindra & Mahindra"},{"text":"Maruti Suzuki India"},{"text":"Hyundai Motor India"},{"text":"Bosch"},{"text":"ZF"},{"text":"BorgWarner"},{"text":"Dana"},{"text":"Cummins"}]},{"type":"p","text":"Prioritise internships involving engine testing, transmission development, EV powertrains, motor testing, calibration, vehicle testing or powertrain simulation."}]},{"heading":"Certifications in Demand","kind":"certifications","blocks":[{"type":"tabl