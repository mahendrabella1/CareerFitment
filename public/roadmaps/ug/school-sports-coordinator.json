},{"text":"Cones"},{"text":"Training equipment"},{"text":"Safety equipment"},{"text":"First-aid resources"},{"text":"Timing equipment"}]},{"type":"h","text":"Equipment Workflow"},{"type":"flow","items":["Requirement","Procurement","Inventory Entry","Issue to Team / Coach","Usage","Inspection","Maintenance","Replacement"]},{"type":"p","text":"Digital inventory management can significantly improve accountability."}]},{"heading":"Student Talent Identification","kind":"other","blocks":[{"type":"p","text":"A School Sports Coordinator can help identify promising athletes using multiple indicators."},{"type":"h","text":"Physical"},{"type":"list","items":[{"text":"Speed"},{"text":"Agility"},{"text":"Endurance"},{"text":"Strength"},{"text":"Coordination"},{"text":"Flexibility"}]},{"type":"h","text":"Technical"},{"type":"list","items":[{"text":"Sport-specific skills"},{"text":"Ball control"},{"text":"Tactical awareness"},{"text":"Technique"},{"text":"Decision-making"}]},{"type":"h","text":"Behavioral"},{"type":"list","items":[{"text":"Discipline"},{"text":"Coachability"},{"text":"Teamwork"},{"text":"Commitment"},{"text":"Resilience"},{"text":"Leadership"},{"text":"A good system should avoid selecting students based solely on one test or subjective observation."}]}]},{"heading":"Sports Performance Dashboard","kind":"other","blocks":[{"type":"p","text":"Excel or Power BI can be used to track:"},{"type":"table","header":["Metric","Example"],"rows":[[{"text":"Student"},{"text":"Student A"}],[{"text":"Sport"},{"text":"Athletics"}],[{"text":"Event"},{"text":"100 m"}],[{"text":"Baseline"},{"text":"14.2 sec"}],[{"text":"Current"},{"text":"13.8 sec"}],[{"text":"Improvement"},{"text":"2.8%"}],[{"text":"Attendance"},{"text":"92%"}],[{"text":"Competition"},{"text":"District Level"}],[{"text":"Result"},{"text":"2nd"}],[{"text":"Coach Rating"},{"text":"Strong"}]]},{"type":"p","text":"A simple dashboard could provide:"},{"type":"flow","items":["Participation","Attendance","Fitness","Skill Performance","Competition Results","Progress Trend"]}]},{"heading":"Technology Stack","kind":"other","blocks":[{"type":"h","text":"Productivity"},{"type":"list","items":[{"text":"Microsoft Excel"},{"text":"Google Sheets"},{"text":"Microsoft Word"},{"text":"PowerPoint"},{"text":"Google Workspace"}]},{"type":"h","text":"Communication"},{"type":"list","items":[{"text":"Email"},{"text":"School communication platforms"},{"text":"WhatsApp/approved school communication systems"},{"text":"Microsoft Teams"}]},{"type":"h","text":"Data"},{"type":"list","items":[{"text":"Excel dashboards"},{"text":"Power BI"},{"text":"Google Forms"},{"text":"Online registration systems"}]},{"type":"h","text":"Sports Technology"},{"type":"p","text":"Depending on the institution:"},{"type":"list","items":[{"text":"Digital timing systems"},{"text":"Performance-tracking platforms"},{"text":"Video analysis"},{"text":"GPS-based athlete tracking"},{"text":"Fitness monitoring systems"}]}]},{"heading":"AI in School Sports","kind":"other","blocks":[{"type":"p","text":"AI can support sports administration and performance analysis."},{"type":"h","text":"Possible Applications"},{"type":"list","items":[{"text":"Automated performance analysis"},{"text":"Video-based technique analysis"},{"text":"Training-load monitoring"},{"text":"Competition analytics"},{"text":"Injury-risk monitoring systems"},{"text":"Personalized fitness planning"},{"text":"Automated sports reports"},{"text":"Student participation analytics"}]},{"type":"p","text":"Example:"},{"type":"flow","items":["Student Performance Data","Fitness + Attendance + Competition Data","Analytics / AI","Performance Pattern","Coach Review","Training Adjustment"]},{"type":"p","text":"AI should remain a decision-support tool. Student health, training load, injury and participation decisions should involve appropriately qualified professionals."}]},{"heading":"Projects During UG","kind":"build","blocks":[{"type":"h","text":"Project 1 — Annual School Sports Calenda