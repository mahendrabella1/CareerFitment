AR"},{"text":"HISAT2"},{"text":"Samtools"},{"text":"BCFtools"},{"text":"GATK"}]},{"type":"h","text":"Transcriptomics"},{"type":"list","items":[{"text":"RNA-seq"},{"text":"DESeq2"},{"text":"edgeR"},{"text":"Salmon"},{"text":"kallisto"}]},{"type":"h","text":"Protein/structure"},{"type":"list","items":[{"text":"BLASTp"},{"text":"PDB"},{"text":"AlphaFold concepts"},{"text":"PyMOL"},{"text":"UCSF ChimeraX"},{"text":"Molecular docking fundamentals"}]},{"type":"h","text":"Databases"},{"type":"list","items":[{"text":"NCBI","url":"https://www.ncbi.nlm.nih.gov/"},{"text":"UniProt","url":"https://www.uniprot.org/"},{"text":"EMBL-EBI","url":"https://www.ebi.ac.uk/"},{"text":"Protein Data Bank","url":"https://www.rcsb.org/"},{"text":"Ensembl","url":"https://www.ensembl.org/"}]},{"type":"h","text":"Research workflow to master"},{"type":"p","text":"A good Research Associate should be able to independently execute:"},{"type":"flow","items":["Raw Data","QC","Preprocessing","Alignment/Mapping","Quantification","Statistical Analysis","Visualisation","Biological Interpretation"]},{"type":"p","text":"For example:"},{"type":"flow","items":["FASTQ","FastQC","trimming","alignment","BAM processing","variant/expression analysis","statistical interpretation","report"]},{"type":"p","text":"Learn reproducibility from the beginning:"},{"type":"list","items":[{"text":"Git"},{"text":"README files"},{"text":"Environment management"},{"text":"Workflow documentation"},{"text":"Version control"},{"text":"Data provenance"},{"text":"Reproducible notebooks"}]},{"type":"p","text":"Useful tools:"},{"type":"list","items":[{"text":"GitHub","url":"https://github.com/"},{"text":"GitHub Docs","url":"https://docs.github.com/"},{"text":"Galaxy","url":"https://galaxyproject.org/"}]},{"type":"h","text":"Four-year honours variant"},{"type":"p","text":"If an honours/specialisation pathway is available, combine:"},{"type":"flow","items":["Bioinformatics","Genomics","Statistics","Machine Learning","Cloud Computing"],"s