},{"text":"Applied economic analysis"}]]},{"type":"h","text":"Particularly strong route"},{"type":"p","text":"For someone wanting Data Analyst rather than purely academic economics:"},{"type":"flow","items":["BA Economics","Analytics Internship","Data Analyst"]},{"type":"p","text":"or for deeper quantitative roles:"},{"type":"flow","items":["BA Economics","MA/MSc Economics/Data Science/Statistics","Data/Economic Analyst"]},{"type":"p","text":"For research:"},{"type":"flow","items":["BA","MA/MSc","NET/JRF or equivalent","PhD","Research/Economic Analytics"]}]},{"heading":"Study abroad","kind":"abroad","blocks":[{"type":"table","header":["Country","Example universities","Scholarship route","Gate to check"],"rows":[[{"text":"USA"},{"text":"University of Chicago, University of Michigan, New York University"},{"text":"University funding/Fulbright-type routes"},{"text":"Quantitative prerequisites + English"}],[{"text":"UK"},{"text":"LSE, University of Warwick, University of Manchester"},{"text":"Chevening + university scholarships"},{"text":"Quantitative prerequisites"}],[{"text":"Germany"},{"text":"University of Mannheim, LMU Munich, Heidelberg University"},{"text":"DAAD + university funding"},{"text":"Programme/language requirements"}],[{"text":"Canada"},{"text":"University of Toronto, UBC, McGill"},{"text":"University funding"},{"text":"Statistics/mathematics prerequisites"}],[{"text":"Australia"},{"text":"University of Melbourne, Australian National University, Monash"},{"text":"University scholarships"},{"text":"Programme requirements"}],[{"text":"Singapore"},{"text":"NUS, NTU, SMU"},{"text":"University scholarships"},{"text":"Quantitative/programme requirements"}]]},{"type":"h","text":"Application pack"},{"type":"list","items":[{"text":"BA transcript"},{"text":"Strong statistics/econometrics coursework"},{"text":"Data-analysis portfolio"},{"text":"SQL/Python projects"},{"text":"Statement of Purpose"},{"text":"Recommendations"},{"text":"CV"},{"text":"GRE/GMAT if requi