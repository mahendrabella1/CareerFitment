and paid options"},{"text":"Year 2"},{"text":"Database analysis"}],[{"text":"Python for Data Analysis"},{"text":"Free and paid options"},{"text":"Year 2"},{"text":"Analytical programming"}],[{"text":"Google Analytics learning"},{"text":"Free learning resources"},{"text":"Year 2–3"},{"text":"Web/business analytics"}],[{"text":"Tableau training"},{"text":"Free/paid options"},{"text":"Year 2–3"},{"text":"Data visualisation"}],[{"text":"Econometrics course"},{"text":"University/NPTEL/online"},{"text":"Year 2–3"},{"text":"Economics-specific analytics"}],[{"text":"Cloud data fundamentals"},{"text":"Free/paid options"},{"text":"Year 3"},{"text":"Modern data environments"}]]},{"type":"p","text":"Do not collect certificates without projects. SQL + Python + Power BI + statistics + portfolio should be the priority."}]},{"heading":"Careers you can be hired as","kind":"careers","blocks":[{"type":"h","text":"Strong first-job targets"},{"type":"list","items":[{"text":"Data Analyst"},{"text":"Junior Data Analyst"},{"text":"Data Analyst Intern"},{"text":"Business Data Analyst"},{"text":"Business Analyst"},{"text":"Reporting Analyst"},{"text":"BI Analyst"},{"text":"Operations Analyst"},{"text":"Research Analyst"},{"text":"Economic Research Analyst"},{"text":"Economic Analyst"},{"text":"Financial Data Analyst"},{"text":"Marketing Analyst"},{"text":"Product Analyst"},{"text":"Risk Analyst"},{"text":"Policy Analyst"},{"text":"Quantitative Research Assistant"},{"text":"Data Quality Analyst"},{"text":"MIS Analyst"},{"text":"Analytics Associate"}]},{"type":"h","text":"Career progression"},{"type":"flow","items":["Data Analyst","Senior Data Analyst","Analytics Lead","Analytics Manager","Head of Analytics"]},{"type":"p","text":"Alternative:"},{"type":"flow","items":["Economics Graduate","Economic/Data Analyst","Senior Economic Analyst","Economic Research Lead"]},{"type":"table","header":["Role","Key skills","Proof of capability"],"rows":[[{"text":"Data Analyst"},{"text":"SQL + Python + BI"},