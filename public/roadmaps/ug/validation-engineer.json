rmaceutical ingredients"},{"text":"Excipients"},{"text":"Manufacturing processes"},{"text":"Drug stability"},{"text":"Basic pharmacology"},{"text":"Pharmaceutical chemistry"}]},{"type":"h","text":"Manufacturing Fundamentals"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Batch manufacturing"},{"text":"Continuous manufacturing concepts"},{"text":"Mixing"},{"text":"Granulation"},{"text":"Drying"},{"text":"Compression"},{"text":"Coating"},{"text":"Filling"},{"text":"Packaging"}]},{"type":"h","text":"Year 2 — Pharmaceutical Manufacturing"},{"type":"h","text":"Process Engineering"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Mass balance"},{"text":"Energy balance"},{"text":"Process flow diagrams"},{"text":"Piping and instrumentation diagrams"},{"text":"Equipment sizing concepts"},{"text":"Process parameters"},{"text":"Critical process parameters"}]},{"type":"p","text":"Understand the relationship:"},{"type":"flow","items":["Raw Material","Manufacturing Process","Critical Process Parameters","Critical Quality Attributes","Finished Product"]},{"type":"h","text":"Equipment"},{"type":"p","text":"Learn the operating principles of:"},{"type":"list","items":[{"text":"Reactors"},{"text":"Mixers"},{"text":"Granulators"},{"text":"Fluid-bed dryers"},{"text":"Tablet presses"},{"text":"Coating machines"},{"text":"Filling machines"},{"text":"Sterilizers"},{"text":"Autoclaves"},{"text":"HVAC systems"},{"text":"Water systems"}]},{"type":"h","text":"Utilities"},{"type":"p","text":"Understand pharmaceutical utilities such as:"},{"type":"list","items":[{"text":"HVAC"},{"text":"Purified water"},{"text":"Water-for-injection concepts"},{"text":"Compressed air"},{"text":"Nitrogen"},{"text":"Steam"},{"text":"Electrical systems"},{"text":"Clean utilities"}]},{"type":"h","text":"Instrumentation"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Temperature sensors"},{"text":"Pressure sensors"},{"text":"Flow meters"},{"text":"Level sensors"},{"text":"pH measurement"},{"text":"Conductivity"},{"text":"Humidity"},{"text":"Differential pressure"}]},{"type":"p","text":"Understand:"},{"type":"flow","items":["Process","Sensor","Measurement","Controller","Actuator","Process"]},{"type":"h","text":"Year 2–3 — GMP & Quality Systems"},{"type":"h","text":"Good Manufacturing Practice"},{"type":"p","text":"Develop strong understanding of:"},{"type":"list","items":[{"text":"GMP principles"},{"text":"SOPs"},{"text":"Documentation"},{"text":"Batch records"},{"text":"Change control"},{"text":"Deviations"},{"text":"CAPA"},{"text":"OOS/OOT concepts"},{"text":"Training"},{"text":"Data integrity"}]},{"type":"h","text":"ALCOA+ Data Integrity"},{"type":"p","text":"Understand principles such as:"},{"type":"list","items":[{"text":"Attributable"},{"text":"Legible"},{"text":"Contemporaneous"},{"text":"Original"},{"text":"Accurate"}]},{"type":"p","text":"Plus broader expectations around:"},{"type":"list","items":[{"text":"Complete"},{"text":"Consistent"},{"text":"Enduring"},{"text":"Available"}]},{"type":"p","text":"Validation engineers frequently work with evidence that must be traceable and reliable."},{"type":"h","text":"Quality Risk Management"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Risk identification"},{"text":"Risk assessment"},{"text":"Risk control"},{"text":"Risk review"}]},{"type":"p","text":"Understand tools such as:"},{"type":"list","items":[{"text":"FMEA"},{"text":"Risk ranking"},{"text":"HACCP concepts"},{"text":"Fault-tree analysis"}]},{"type":"h","text":"Year 3 — Qualification"},{"type":"h","text":"User Requirement Specification"},{"type":"p","text":"Understand the role of:"},{"type":"h","text":"URS — User Requirements Specification"},{"type":"p","text":"It defines what the system/equipment is expected to do."},{"type":"h","text":"Design Qualification"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Design requirements"},{"text":"Design review"},{"text":"Specification verification"},{"text":"Compliance with intended use"}]},{"type":"h","text":"Installation Qualification"},{"type":"p","text":"IQ verifies that equipment/system installation meets approved specifications."},{"type":"p","text":"Typical evidence includes:"},{"type":"list","items":[{"text":"Equipment identification"},{"text":"Components"},{"text":"Installation checks"},{"text":"Utilities"},{"text":"Materials"},{"text":"Calibration"},{"text":"Documentation"}]},{"type":"h","text":"Operational Qualification"},{"type":"p","text":"OQ verifies that equipment/system operates as intended across defined operating ranges."},{"type":"p","text":"Examples:"},{"type":"list","items":[{"text":"Temperature"},{"text":"Pressure"},{"text":"Speed"},{"text":"Flow"},{"text":"Alarms"},{"text":"Interlocks"}]},{"type":"h","text":"Performance Qualification"},{"type":"p","text":"PQ verifies that the system/process performs consistently under actual or simulated production conditions as defined by the validation strategy."},{"type":"h","text":"Qualification Lifecycle"},{"type":"flow","items":["URS","Design Qualification","Factory / Site Acceptance Testing","Installation Qualification","Operational Qualification","Performance Qualification","Continued Verification"]},{"type":"p","text":"Not every project follows an identical sequence; the qualification strategy should be risk-based and aligned with applicable procedures and regulations."},{"type":"h","text":"Year 3 — Process Validation"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Process design"},{"text":"Process qualification"},{"text":"Continued process verification"},{"text":"Critical Process Parameters"},{"text":"Critical Quality Attributes"},{"text":"Sampling plans"},{"text":"Acceptance criteria"},{"text":"Statistical evaluation"}]},{"type":"h","text":"CPP & CQA"},{"type":"h","text":"Critical Process Parameters"},{"type":"p","text":"Examples:"},{"type":"list","items":[{"text":"Temperature"},{"text":"Pressure"},{"text":"Mixing speed"},{"text":"Time"},{"text":"Flow rate"},{"text":"Humidity"}]},{"type":"h","text":"Critical Quality Attributes"},{"type":"p","text":"Examples:"},{"type":"list","items":[{"text":"Assay"},{"text":"Content uniformity"},{"text":"Dissolution"},{"text":"Particle size"},{"text":"Sterility where applicable"},{"text":"Moisture"}]},{"type":"p","text":"Understand:"},{"type":"flow","items":["Process Parameter","Manufacturing Process","Product Characteristic","Quality Attribute"]},{"type":"h","text":"Cleaning Validation"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Cleaning procedures"},{"text":"Worst-case selection"},{"text":"Residue limits"},{"text":"Sampling methods"},{"text":"Swab sampling"},{"text":"Rinse sampling"},{"text":"Recovery studies"},{"text":"Acceptance criteria"},{"text":"Cleaning verification"}]},{"type":"p","text":"Understand why cleaning validation is critical for preventing:"},{"type":"list","items":[{"text":"Cross-contamination"},{"text":"Product carryover"},{"text":"Microbial contamination"}]},{"type":"h","text":"Computerized System Validation"},{"type":"p","text":"Modern pharmaceutical manufacturing uses computerized systems extensively."},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"CSV principles"},{"text":"User requirements"},{"text":"Functional specifications"},{"text":"Risk assessment"},{"text":"Test scripts"},{"text":"Traceability"},{"text":"Access controls"},{"text":"Audit trails"},{"text":"Electronic records"},{"text":"Data integrity"}]},{"type":"p","text":"Systems may include:"},{"type":"list","items":[{"text":"LIMS"},{"text":"MES"},{"text":"SCADA"},{"text":"ERP"},{"text":"Laboratory systems"},{"text":"Manufacturing control systems"}]},{"type":"h","text":"Year 4 — Automation & Validation Engineering"},{"type":"h","text":"Process Control"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Feedback control"},{"text":"PID control"},{"text":"PLC"},{"text":"SCADA"},{"text":"HMI"},{"text":"Sensors"},{"text":"Actuators"}]},{"type":"p","text":"Understand how automation systems interact with validated manufacturing processes."},{"type":"h","text":"HVAC Validation"},{"type":"p","text":"Develop awareness of:"},{"type":"list","items":[{"text":"Temperature"},{"text":"Relative humidity"},{"text":"Differential pressure"},{"text":"Air changes"},{"text":"Airflow"},{"text":"HEPA filtration"},{"text":"Cleanroom classification"}]},{"type":"h","text":"Water System Validation"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Water purification"},{"text":"Storage"},{"text":"Distribution"},{"text":"Sampling"},{"text":"Microbiological monitoring"},{"text":"Chemical monitoring"},{"text":"Sanitization"}]},{"type":"h","text":"Sterilization Validation"},{"type":"p","text":"For applicable pharmaceutical operations, understand:"},{"type":"list","items":[{"text":"Autoclave cycles"},{"text":"Temperature"},{"text":"Pressure"},{"text":"Biological indicators"},{"text":"Chemical indicators"},{"text":"Load configuration"},{"text":"Cycle qualification"}]},{"type":"h","text":"Validation Documentation"},{"type":"p","text":"Develop strong technical-writing skills."},{"type":"p","text":"Learn to prepare/review:"},{"type":"list","items":[{"text":"Validation plans"},{"text":"Protocols"},{"text":"Test scripts"},{"text":"Reports"},{"text":"Traceability matrices"},{"text":"Risk assessments"},{"text":"SOPs"},{"text":"Deviations"},{"text":"Change controls"},{"text":"Qualification reports"}]},{"type":"p","text":"A validation engineer should be capable of defending why the test was performed, what evidence was collected and whether acceptance criteria were met."},{"type":"h","text":"Final-Year Projects"}]},{"heading":"Equipment Qualification Simulation","kind":"other","blocks":[{"type":"p","text":"Create a complete simulated qualification package for a pharmaceutical manufacturing machine."},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"URS"},{"text":"Risk assessment"},{