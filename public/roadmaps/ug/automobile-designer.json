:"8–12 Years"},{"type":"h","text":"Lead Designer / Design Manager"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Design direction"},{"text":"Team leadership"},{"text":"Product strategy"}]},{"type":"h","text":"12+ Years"},{"type":"h","text":"Design Director / Chief Designer / Design Studio Head"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Brand design language"},{"text":"Product portfolio"},{"text":"Long-term mobility vision"}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"p","text":"By graduation, target:"},{"type":"h","text":"Design"},{"type":"list","items":[{"text":"Automotive sketching"},{"text":"Perspective"},{"text":"Form development"},{"text":"Design research"},{"text":"Visual storytelling"}]},{"type":"h","text":"Automotive"},{"type":"list","items":[{"text":"Vehicle architecture"},{"text":"Ergonomics"},{"text":"Automotive proportions"},{"text":"EV fundamentals"},{"text":"Manufacturing awareness"}]},{"type":"h","text":"3D"},{"type":"list","items":[{"text":"Alias / Rhino / Blender"},{"text":"Digital sculpting"},{"text":"Automotive surfacing"}]},{"type":"h","text":"Visualisation"},{"type":"list","items":[{"text":"KeyShot"},{"text":"Photoshop"},{"text":"Illustrator"},{"text":"Animation/video"}]},{"type":"h","text":"Experience"},{"type":"list","items":[{"text":"Automotive UX"},{"text":"HMI"},{"text":"CMF"},{"text":"Sustainable materials"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Presentation"},{"text":"Design critique"},{"text":"Portfolio development"},{"text":"Team collaboration"},{"text":"Design documentation"}]},{"type":"h","text":"AI"},{"type":"list","items":[{"text":"Generative concept exploration"},{"text":"AI-assisted visualisation"},{"text":"Procedural modelling"},{"text":"AI-supported research"}]}]},{"heading":"Target Progression","kind":"growth","blocks":[{"type":"h","text":"Year 1"},{"type":"flow","items":["Design fundamentals","sketching","perspective"],"s