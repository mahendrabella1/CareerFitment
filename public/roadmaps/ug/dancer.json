ntent"},{"text":"Cultural explanations"},{"text":"Choreography"},{"text":"Collaborations"}]},{"type":"p","text":"The objective should be to build an artist identity, not simply chase views."}]},{"heading":"Projects During UG","kind":"build","blocks":[{"type":"h","text":"Project 1 — Solo Performance Portfolio"},{"type":"p","text":"Create a professionally recorded solo performance."},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Full performance"},{"text":"Short highlights"},{"text":"Artist introduction"},{"text":"Repertoire information"}]},{"type":"h","text":"Project 2 — Repertoire Documentation"},{"type":"p","text":"Document a set of traditional compositions."},{"type":"p","text":"For each:"},{"type":"list","items":[{"text":"Name"},{"text":"Tradition"},{"text":"Composer/source where appropriate"},{"text":"Tala"},{"text":"Musical form"},{"text":"Narrative"},{"text":"Performance notes"}]},{"type":"p","text":"This develops both artistic and research skills."},{"type":"h","text":"Project 3 — Original Choreography"},{"type":"p","text":"Create an original short piece while respecting the principles and conventions of the chosen tradition."},{"type":"p","text":"Document:"},{"type":"list","items":[{"text":"Concept"},{"text":"Music"},{"text":"Movement"},{"text":"Formation"},{"text":"Costume"},{"text":"Lighting"},{"text":"Performance"}]},{"type":"h","text":"Project 4 — Dance Education Series"},{"type":"p","text":"Create 10 short educational videos explaining:"},{"type":"list","items":[{"text":"Mudras"},{"text":"Rhythm"},{"text":"Basic movements"},{"text":"Historical context"},{"text":"Musical concepts"},{"text":"Repertoire"}]},{"type":"h","text":"Project 5 — Dance Documentary"},{"type":"p","text":"Create a short documentary about:"},{"type":"list","items":[{"text":"A dance tradition"},{"text":"A local artist"},{"text":"A cultural institution"},{"text":"A performance tradition"}]},{"type":"flow","items":["This combines dance","research","media skills."],"sep":"+"}]},{"heading":"Internship / Apprenticeship Strategy","kind":"internships","blocks":[{"type":"p","text":"For performance careers, traditional internships are less important than serious artistic training and performance exposure."},{"type":"p","text":"Target:"},{"type":"h","text":"Dance institutions"},{"type":"list","items":[{"text":"Classical dance academies"},{"text":"Universities"},{"text":"Cultural organizations"},{"text":"Performing-arts schools"}]},{"type":"h","text":"Performance organizations"},{"type":"list","items":[{"text":"Dance companies"},{"text":"Theatre groups"},{"text":"Festival organizations"}]},{"type":"h","text":"Professional artists"},{"type":"p","text":"Seek opportunities to assist or train under experienced:"},{"type":"list","items":[{"text":"Gurus"},{"text":"Choreographers"},{"text":"Dance directors"},{"text":"Performing artists"}]},{"type":"h","text":"Performance opportunities"},{"type":"p","text":"Participate in:"},{"type":"list","items":[{"text":"Cultural festivals"},{"text":"University productions"},{"text":"National/international dance festivals"},{"text":"Competitions where appropriate"},{"text":"Theatre productions"},{"text":"Cultural programs"}]}]},{"heading":"Building Professional Experience","kind":"other","blocks":[{"type":"p","text":"A strong performance CV can include:"},{"type":"flow","items":["Training","Repertoire","Performances","Festivals","Collaborations","Workshops","Choreography","Teaching","Awards / Recognition"]},{"type":"p","text":"The student should document every significant professional performance."}]},{"heading":"Employer / Industry Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Industry Requirement","Priority"],"rows":[[{"text":"Dance Technique"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Repertoire"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Rhythm"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Abhinaya"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Musicality"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Performance"},{"text":"⭐⭐⭐⭐⭐"}],[{"text":"Rehearsal Discipline"