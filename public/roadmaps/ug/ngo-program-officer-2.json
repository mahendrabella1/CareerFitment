"},{"text":"Inclusive programmes"}],[{"text":"Behaviour Change Communication"},{"text":"Community interventions"}],[{"text":"First Aid"},{"text":"Field preparedness"}]]},{"type":"p","text":"Certification fees and recognition should be: check the official site before enrolment."}]},{"heading":"Careers you can be hired as","kind":"careers","blocks":[{"type":"h","text":"Realistic first-job titles"},{"type":"list","items":[{"text":"Program Associate"},{"text":"Programme Associate"},{"text":"Program Assistant"},{"text":"Project Assistant"},{"text":"Project Associate"},{"text":"NGO Program Coordinator"},{"text":"Programme Coordinator"},{"text":"Program Officer"},{"text":"Project Officer"},{"text":"Community Programme Officer"},{"text":"Child Development Program Associate"},{"text":"Early Childhood Programme Associate"},{"text":"Education Programme Associate"},{"text":"Field Coordinator"},{"text":"Community Mobilisation Officer"},{"text":"Monitoring & Evaluation Assistant"},{"text":"M&E Associate"},{"text":"Research Assistant"},{"text":"Development Associate"},{"text":"CSR Program Associate"},{"text":"Social Impact Associate"},{"text":"Program Implementation Associate"}]},{"type":"h","text":"Role-to-skill mapping"},{"type":"table","header":["Role","Stack the posting asks for","Where the student proves it"],"rows":[[{"text":"Program Associate"},{"text":"Coordination + documentation"},{"text":"NGO internship"}],[{"text":"Program Officer"},{"text":"Implementation + M&E"},{"text":"Programme project"}],[{"text":"Project Assistant"},{"text":"Field + reporting"},{"text":"Community project"}],[{"text":"M&E Associate"},{"text":"Data + indicators"},{"text":"M&E dashboard"}],[{"text":"Field Coordinator"},{"text":"Community engagement"},{"text":"Field internship"}],[{"text":"ECD Programme Associate"},{"text":"Child development + programme skills"},{"text":"ECD project"}],[{"text":"Research Assistant"},{"text":"Research + data"},{"text":"Dissertation"}],[{"text":"CSR Associate"},{"text