ure"},{"text":"Load"},{"text":"Movement cycles"}]},{"type":"p","text":"Use:"},{"type":"list","items":[{"text":"CAD"},{"text":"MATLAB/Simulink"},{"text":"ROS 2"},{"text":"Python"},{"text":"Sensors"}]},{"type":"h","text":"3. Smart Manufacturing Line Digital Twin"},{"type":"p","text":"Build a virtual production line containing:"},{"type":"list","items":[{"text":"Conveyor"},{"text":"Sensors"},{"text":"Motors"},{"text":"Robotic arm"},{"text":"PLC"},{"text":"HMI"}]},{"type":"p","text":"Monitor:"},{"type":"list","items":[{"text":"Production rate"},{"text":"Downtime"},{"text":"Energy consumption"},{"text":"Equipment status"}]},{"type":"p","text":"Then create an optimisation model."},{"type":"h","text":"4. Predictive Maintenance Digital Twin"},{"type":"p","text":"Create a twin for a pump or rotating machine."},{"type":"p","text":"Inputs:"},{"type":"list","items":[{"text":"Vibration"},{"text":"Temperature"},{"text":"Pressure"},{"text":"RPM"}]},{"type":"p","text":"Outputs:"},{"type":"list","items":[{"text":"Health score"},{"text":"Fault probability"},{"text":"Remaining useful life estimate"}]},{"type":"h","text":"5. EV Battery Digital Twin"},{"type":"p","text":"Build a digital model of an EV battery pack."},{"type":"p","text":"Monitor:"},{"type":"list","items":[{"text":"Voltage"},{"text":"Current"},{"text":"Temperature"},{"text":"State of Charge"},{"text":"State of Health"}]},{"type":"p","text":"Then create a predictive model for battery degradation."},{"type":"h","text":"Internship Strategy"},{"type":"p","text":"Target internships such as:"},{"type":"h","text":"Manufacturing"},{"type":"list","items":[{"text":"Smart Manufacturing Intern"},{"text":"Digital Manufacturing Intern"},{"text":"Industry 4.0 Intern"},{"text":"Manufacturing Automation Intern"},{"text":"Production Engineering Intern"}]},{"type":"h","text":"Digital Twin"},{"type":"list","items":[{"text":"Digital Twin Engineering Intern"},{"text":"Simulation Intern"},{"text":"Digital Engineering Intern"},{"text":"Virtual C