Temperature"},{"text":"Voltage"},{"text":"Current"},{"text":"Acceleration"},{"text":"Orientation"},{"text":"and transmits the data to a ground application."}]},{"type":"note","label":"Tools","text":"Embedded C/C++ + Python."},{"type":"h","text":"Project 4 — UAV Autopilot Simulation"},{"type":"p","text":"Develop a simulated flight-control system."},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Position"},{"text":"Velocity"},{"text":"Orientation"},{"text":"PID control"},{"text":"Navigation"},{"text":"Sensor fusion"},{"text":"Use simulation rather than attempting uncontrolled real-world flight testing."}]},{"type":"h","text":"Project 5 — Avionics Health Monitoring"},{"type":"p","text":"Develop a system that detects abnormal telemetry."},{"type":"flow","items":["Telemetry","Data Validation","Threshold / Statistical Analysis","Anomaly Detection","Fault Classification","Alert","Maintenance / Recovery Action"]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Target internships in:"},{"type":"h","text":"Space Research"},{"type":"list","items":[{"text":"Spacecraft electronics"},{"text":"Avionics"},{"text":"Embedded systems"},{"text":"Satellite systems"},{"text":"Telemetry"},{"text":"Ground systems"}]},{"type":"h","text":"Aerospace"},{"type":"list","items":[{"text":"Aircraft electronics"},{"text":"Flight-control systems"},{"text":"Navigation"},{"text":"Communication"},{"text":"Testing"}]},{"type":"h","text":"Defense Technology"},{"type":"list","items":[{"text":"Embedded systems"},{"text":"Radar/electronics"},{"text":"Navigation"},{"text":"Secure communications"},{"text":"Guidance systems"}]},{"type":"h","text":"Electronics Industry"},{"type":"list","items":[{"text":"Embedded systems"},{"text":"FPGA"},{"text":"PCB design"},{"text":"Hardware validation"},{"text":"Firmware"}]},{"type":"h","text":"Research"},{"type":"p","text":"Look for projects involving:"},{"type":"list","items":[{"text":"GNC"},{"text":"Control systems"},{"t