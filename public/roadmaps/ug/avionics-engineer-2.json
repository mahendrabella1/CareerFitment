":"Spacecraft systems"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Attitude determination"},{"text":"Attitude control"},{"text":"Guidance"},{"text":"Navigation"},{"text":"Telemetry and telecommand"},{"text":"On-board data handling"},{"text":"Electrical power systems"},{"text":"Thermal considerations"},{"text":"Payload interfaces"}]},{"type":"h","text":"Guidance, Navigation & Control"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Coordinate systems"},{"text":"State estimation"},{"text":"Kalman-filter fundamentals"},{"text":"Sensor fusion"},{"text":"Trajectory basics"},{"text":"Attitude estimation"},{"text":"Control algorithms"}]},{"type":"h","text":"Reliability"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Fault-tree analysis"},{"text":"FMEA/FMECA"},{"text":"Redundancy"},{"text":"Failure modes"},{"text":"Fault tolerance"},{"text":"Reliability engineering"},{"text":"Environmental testing"}]}]},{"heading":"Core Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Skill Area","Target Level"],"rows":[[{"text":"Electronics"},{"text":"Advanced"}],[{"text":"Digital Electronics"},{"text":"Advanced"}],[{"text":"Embedded Systems"},{"text":"Advanced"}],[{"text":"C/C++"},{"text":"Advanced"}],[{"text":"Python"},{"text":"Intermediate–Advanced"}],[{"text":"Microcontrollers"},{"text":"Advanced"}],[{"text":"RTOS"},{"text":"Advanced"}],[{"text":"Control Systems"},{"text":"Advanced"}],[{"text":"Signals & Systems"},{"text":"Advanced"}],[{"text":"Communication Systems"},{"text":"Advanced"}],[{"text":"Sensors"},{"text":"Advanced"}],[{"text":"Instrumentation"},{"text":"Advanced"}],[{"text":"Flight Computers"},{"text":"Intermediate–Advanced"}],[{"text":"Telemetry & Telecommand"},{"text":"Advanced"}],[{"text":"Navigation"},{"text":"Intermediate–Advanced"}],[{"text":"GNC"},{"text":"Intermediate–Advanced"}],[{"text":"RF Fundamentals"},{"text":"Intermediate"}],[{"text":"PCB Design"},{"text":"Intermediate–Advanced"}],[{"text