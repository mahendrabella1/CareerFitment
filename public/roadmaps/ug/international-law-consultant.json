","blocks":[{"type":"h","text":"1. International Trade Consultant"},{"type":"p","text":"Focuses on cross-border trade regulation."},{"type":"h","text":"2. International Arbitration Associate"},{"type":"p","text":"Works on international commercial disputes."},{"type":"h","text":"3. Investment Law Specialist"},{"type":"p","text":"Focuses on foreign investment and investment disputes."},{"type":"h","text":"4. International Business Lawyer"},{"type":"p","text":"Handles cross-border corporate transactions."},{"type":"h","text":"5. Human Rights Legal Advisor"},{"type":"p","text":"Works on international rights frameworks."},{"type":"h","text":"6. Treaty / Public International Law Researcher"},{"type":"p","text":"Researches treaties and state obligations."},{"type":"h","text":"7. International Compliance Consultant"},{"type":"p","text":"Handles multinational regulatory requirements."},{"type":"h","text":"8. Maritime Law Specialist"},{"type":"p","text":"Works on shipping and maritime disputes."},{"type":"h","text":"9. International Environmental Law Specialist"},{"type":"p","text":"Focuses on climate and environmental agreements."},{"type":"h","text":"10. International Policy Advisor"},{"type":"p","text":"Combines law with international relations and public policy."}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Experience","Typical Role"],"rows":[[{"text":"0–2 years"},{"text":"Research Intern / Legal Intern"}],[{"text":"1–3 years"},{"text":"Junior International Law Associate"}],[{"text":"3–6 years"},{"text":"International Law Consultant / Associate"}],[{"text":"5–9 years"},{"text":"Senior Consultant / Specialist"}],[{"text":"8–12 years"},{"text":"International Legal / Policy Manager"}],[{"text":"10+ years"},{"text":"International Counsel / Partner / Policy Director"}]]},{"type":"p","text":"Progression depends strongly on specialization, jurisdiction, professional qualification and international experience."}]},{"heading":"Target Profi