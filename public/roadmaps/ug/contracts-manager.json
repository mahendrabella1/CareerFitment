ager"},{"text":"Commercial Manager"},{"text":"Claims Manager"},{"text":"Senior Commercial Manager"},{"text":"Head of Contracts"},{"text":"Commercial Director"}]},{"type":"h","text":"Employer Assessment Areas"},{"type":"h","text":"Technical"},{"type":"p","text":"Expect questions on:"},{"type":"list","items":[{"text":"BOQ"},{"text":"Tendering"},{"text":"Contract types"},{"text":"Variations"},{"text":"EOT"},{"text":"Liquidated damages"},{"text":"Retention"},{"text":"Performance guarantees"},{"text":"Payment terms"},{"text":"Claims"},{"text":"Subcontracting"},{"text":"Procurement"}]},{"type":"h","text":"Contract Scenario"},{"type":"p","text":"For example:"},{"type":"p","text":"The contractor claims that a client variation caused a 45-day delay. How would you evaluate the claim?"},{"type":"p","text":"A good candidate should consider:"},{"type":"flow","items":["Contract clause","Notice","Cause","Evidence","Programme impact","Critical path","Cost impact","Entitlement","Assessment","Resolution"]},{"type":"p","text":"That logical chain is central to professional contract administration."}]},{"heading":"Postgraduate Study in India","kind":"pg_india","blocks":[{"type":"table","header":["PG option","Best for"],"rows":[[{"text":"M.Tech Construction Management"},{"text":"Construction management + contracts"}],[{"text":"M.Tech Construction Technology"},{"text":"Technical construction route"}],[{"text":"M.Tech Infrastructure Engineering & Management"},{"text":"Infrastructure projects"}],[{"text":"M.Tech Project Management"},{"text":"Project/commercial management"}],[{"text":"M.Tech/PG Construction Management"},{"text":"Contracts + project management"}],[{"text":"MBA Project Management"},{"text":"Management progression"}],[{"text":"MBA Finance/Operations"},{"text":"Commercial/management route"}],[{"text":"LL.M. Construction Law"},{"text":"Legal-contract specialisation"}],[{"text":"PG Diploma in Quantity Surveying"},{"text":"Commercial/measurement route"}]]},{"type":"h","text":"Stron