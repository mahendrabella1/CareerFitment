lected according to the desired specialization."},{"type":"h","text":"M.Pharm / relevant pharmaceutical PG"},{"type":"p","text":"Possible directions:"},{"type":"list","items":[{"text":"Clinical Pharmacy"},{"text":"Pharmacy Practice"},{"text":"Pharmacology"},{"text":"Pharmaceutical sciences"}]},{"type":"h","text":"M.Sc / PG in Clinical Research"},{"type":"p","text":"Useful for deeper specialization in:"},{"type":"list","items":[{"text":"Clinical trial management"},{"text":"Clinical research"},{"text":"Biostatistics"},{"text":"Regulatory research"}]},{"type":"h","text":"PG in Pharmacovigilance"},{"type":"p","text":"Good option for a combined:"},{"type":"p","text":"Clinical Research + Drug Safety pathway."},{"type":"h","text":"MBA — Healthcare / Pharmaceutical Management"},{"type":"p","text":"Better suited later for:"},{"type":"list","items":[{"text":"Clinical operations management"},{"text":"Project management"},{"text":"Healthcare business"},{"text":"Pharmaceutical management"}]}]},{"heading":"Career Specializations","kind":"other","blocks":[{"type":"h","text":"1. Clinical Operations"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Site management"},{"text":"Monitoring"},{"text":"Recruitment"},{"text":"Trial execution"}]},{"type":"h","text":"2. Clinical Data Management"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"EDC"},{"text":"Data cleaning"},{"text":"Queries"},{"text":"Database management"}]},{"type":"h","text":"3. Pharmacovigilance"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Drug safety"},{"text":"Case processing"},{"text":"Signal detection"},{"text":"Aggregate reporting"}]},{"type":"h","text":"4. Regulatory Affairs"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Regulatory submissions"},{"text":"Health-authority interactions"},{"text":"Clinical documentation"}]},{"type":"h","text":"5. Study Start-Up"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Site feasibility"