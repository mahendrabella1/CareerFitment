","items":[{"text":"Computer Science"},{"text":"Data Engineering"},{"text":"Data Science"},{"text":"Artificial Intelligence"},{"text":"Distributed Systems"},{"text":"Cloud Computing"}]},{"type":"h","text":"Master's"},{"type":"list","items":[{"text":"MSc Data Engineering"},{"text":"MSc Data Science"},{"text":"MSc Computer Science"},{"text":"MSc Big Data Analytics"},{"text":"MSc Artificial Intelligence"}]},{"type":"h","text":"Management"},{"type":"list","items":[{"text":"MBA Business Analytics"},{"text":"MBA Technology Management"},{"text":"For most industry Data Engineering roles, strong engineering experience can substitute for a master's degree."}]}]},{"heading":"Career Specializations","kind":"other","blocks":[{"type":"h","text":"1. Cloud Data Engineering"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"AWS/Azure/GCP"},{"text":"Cloud storage"},{"text":"Data warehouses"},{"text":"Data pipelines"},{"text":"Cloud architecture"}]},{"type":"h","text":"2. Big Data Engineering"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Spark"},{"text":"Kafka"},{"text":"Distributed computing"},{"text":"Large-scale processing"}]},{"type":"h","text":"3. Analytics Engineering"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"SQL"},{"text":"Data modeling"},{"text":"Transformation"},{"text":"BI"},{"text":"dbt-style workflows"}]},{"type":"h","text":"4. Data Platform Engineering"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Infrastructure"},{"text":"Scalability"},{"text":"Reliability"},{"text":"Developer platforms"},{"text":"Data services"}]},{"type":"h","text":"5. Streaming Data Engineering"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Kafka"},{"text":"Event-driven architecture"},{"text":"Real-time processing"},{"text":"Stream analytics"}]},{"type":"h","text":"6. ML Data Engineering"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"ML pipelines"},{"text":"Feature engineering"},{