:[{"text":"Functional vision assessment"},{"text":"Low-vision aids"},{"text":"Rehabilitation"},{"text":"Patient counselling"}]},{"type":"h","text":"Clinical Optometrist"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Comprehensive eye examinations"},{"text":"Refraction"},{"text":"Ocular health screening"},{"text":"Referral and co-management"}]}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"Clinical Path"},{"type":"flow","items":["Optometrist","Senior Optometrist","Specialist Optometrist","Lead Optometrist","Clinical Coordinator","Clinical Head / Practice Director"]},{"type":"h","text":"Academic Path"},{"type":"flow","items":["B.Optom","M.Optom / MSc","Clinical Teaching / Research","Senior Academic / Research Role","PhD","Academic / Research Leadership"]},{"type":"h","text":"Entrepreneurship Path"},{"type":"flow","items":["B.Optom","Clinical Experience","Practice Management Skills","Optometry Clinic / Optical Practice","Specialized Eye-Care Practice","Multi-location Practice"]}]},{"heading":"Emerging Technologies","kind":"other","blocks":[{"type":"h","text":"AI in Eye Care"},{"type":"p","text":"Increasingly relevant areas include:"},{"type":"list","items":[{"text":"AI-assisted retinal image analysis"},{"text":"Automated diabetic-retinopathy screening"},{"text":"AI-assisted glaucoma risk assessment"},{"text":"Automated refraction"},{"text":"Computerized vision screening"}]},{"type":"h","text":"Digital Eye Care"},{"type":"list","items":[{"text":"Tele-optometry"},{"text":"Remote screening"},{"text":"Digital patient records"},{"text":"Cloud-based clinical systems"},{"text":"Remote follow-up"}]},{"type":"h","text":"Advanced Diagnostics"},{"type":"list","items":[{"text":"Optical Coherence Tomography (OCT)"},{"text":"Corneal topography"},{"text":"Digital retinal photography"},{"text":"Automated visual fields"},{"text":"Wavefront aberrometry"}]},{"type":"h","text":"Myopia Technology"},{"type":"list","items":[{"text":"Digit