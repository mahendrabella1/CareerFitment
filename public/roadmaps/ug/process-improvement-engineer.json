","blocks":[{"type":"p","text":"Understand important operational KPIs."},{"type":"h","text":"OEE"},{"type":"p","text":"Overall Equipment Effectiveness combines:"},{"type":"h","text":"Availability × Performance × Quality"},{"type":"p","text":"Also understand:"},{"type":"list","items":[{"text":"Throughput"},{"text":"Cycle time"},{"text":"Takt time"},{"text":"Capacity utilization"},{"text":"Downtime"},{"text":"Changeover time"},{"text":"Scrap rate"},{"text":"First-pass yield"},{"text":"Overall productivity"}]},{"type":"h","text":"Takt Time"},{"type":"h","text":"Takt Time = Available Production Time / Customer Demand"},{"type":"h","text":"Cycle Time"},{"type":"p","text":"The actual time required to complete a process or production step."},{"type":"p","text":"A Process Improvement Engineer should understand the difference between takt time, cycle time and lead time."}]},{"heading":"Quality Engineering","kind":"other","blocks":[{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Quality control"},{"text":"Statistical Process Control"},{"text":"Process capability"},{"text":"Inspection systems"},{"text":"Defect analysis"},{"text":"Root-cause analysis"},{"text":"Corrective actions"},{"text":"Preventive actions"},{"text":"FMEA"},{"text":"Quality improvement"}]},{"type":"p","text":"Understand:"},{"type":"flow","items":["Defect","Data Collection","Pareto Analysis","Root Cause","Corrective Action","Validation","Standardization"]}]},{"heading":"Year 4 — Advanced Process Improvement","kind":"other","blocks":[{"type":"p","text":"Focus on applying everything to real-world projects."},{"type":"h","text":"Learn"},{"type":"list","items":[{"text":"Advanced Lean"},{"text":"Six Sigma"},{"text":"Process simulation"},{"text":"Optimization"},{"text":"Digital manufacturing"},{"text":"Industrial IoT"},{"text":"Automation"},{"text":"Operational analytics"},{"text":"Change management"},{"text":"Project management"}]},{"type":"p","text":"Also develop the ability to present improvement p