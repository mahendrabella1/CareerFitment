":"p","text":"Tools:"},{"type":"list","items":[{"text":"QGIS"},{"text":"Google Earth Engine"},{"text":"Python"},{"text":"Rasterio"},{"text":"GDAL"},{"text":"GeoPandas"}]},{"type":"h","text":"Infrastructure GIS"},{"type":"p","text":"Develop the ability to map and analyse infrastructure systems."},{"type":"h","text":"Infrastructure datasets"},{"type":"list","items":[{"text":"Roads"},{"text":"Railways"},{"text":"Metro"},{"text":"Airports"},{"text":"Ports"},{"text":"Water pipelines"},{"text":"Sewerage"},{"text":"Drainage"},{"text":"Electricity"},{"text":"Solid-waste facilities"},{"text":"Schools"},{"text":"Hospitals"},{"text":"Fire stations"},{"text":"Police stations"},{"text":"Public housing"},{"text":"Industrial areas"}]},{"type":"h","text":"Infrastructure workflow"},{"type":"flow","items":["Infrastructure Inventory","GIS Database","Condition / Capacity Data","Population & Demand","Spatial Gap Analysis","Accessibility Analysis","Priority Areas","Infrastructure Investment Plan"]},{"type":"h","text":"Year 3 — Programming & Spatial Data"},{"type":"p","text":"A modern GIS Planner should not depend entirely on desktop GIS software."},{"type":"h","text":"Python"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Python fundamentals"},{"text":"NumPy"},{"text":"pandas"},{"text":"GeoPandas"},{"text":"Shapely"},{"text":"Rasterio"},{"text":"Matplotlib"},{"text":"Folium"},{"text":"NetworkX"}]},{"type":"h","text":"Example workflow"},{"type":"flow","items":["GIS Data","Python","Clean Data","Spatial Join","Calculate Indicators","Spatial Analysis","Visualization","Planning Dashboard"]},{"type":"h","text":"SQL & Spatial Databases"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"SQL"},{"text":"PostgreSQL"},{"text":"PostGIS"}]},{"type":"p","text":"Important concepts:"},{"type":"list","items":[{"text":"SELECT"},{"text":"JOIN"},{"text":"GROUP BY"},{"text":"Aggregation"},{"text":"Spatial queries"},{"text":"Geometry"},{"text":"Spatial indexes"},{"text":"Distance q