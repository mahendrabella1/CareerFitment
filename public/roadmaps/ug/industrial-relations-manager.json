tion"},{"text":"Confirmation"},{"text":"Working hours"},{"text":"Leave"},{"text":"Compensation"},{"text":"Termination"},{"text":"Misconduct"},{"text":"Disciplinary action"},{"text":"Grievances"}]},{"type":"h","text":"Year 3 — Industrial Relations"},{"type":"p","text":"Focus on:"},{"type":"h","text":"Trade Unions"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Trade-union structures"},{"text":"Union recognition"},{"text":"Union-management relationships"},{"text":"Union negotiations"},{"text":"Collective representation"}]},{"type":"h","text":"Collective Bargaining"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Negotiation preparation"},{"text":"Wage discussions"},{"text":"Working-condition negotiations"},{"text":"Productivity agreements"},{"text":"Settlement drafting"},{"text":"Grievance escalation"}]},{"type":"h","text":"Industrial Disputes"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Dispute identification"},{"text":"Conciliation"},{"text":"Labour authorities"},{"text":"Arbitration concepts"},{"text":"Adjudication"},{"text":"Settlements"},{"text":"Industrial actions"}]},{"type":"h","text":"Year 4 — Employment & Workforce Management"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Employment contracts"},{"text":"Workplace discipline"},{"text":"Domestic enquiries"},{"text":"Termination"},{"text":"Retrenchment concepts"},{"text":"Layoff concepts"},{"text":"Employee benefits"},{"text":"Social security"},{"text":"Workplace safety"},{"text":"Sexual-harassment compliance"},{"text":"Equality and non-discrimination"},{"text":"Employee grievances"}]},{"type":"p","text":"India's labour-law framework has undergone significant consolidation through labour codes, but implementation and applicable rules can depend on the relevant government and notification status. Students should therefore study the current applicable central and state framework, not rely exclusively on older textbook classifications."}]