":"build","blocks":[{"type":"h","text":"Project 1 — Cinema YouTube Channel"},{"type":"p","text":"Create a channel focused on:"},{"type":"list","items":[{"text":"Reviews"},{"text":"Film analysis"},{"text":"Interviews"},{"text":"Cinema history"},{"text":"Industry trends"}]},{"type":"p","text":"Produce at least 10–20 well-edited videos."},{"type":"h","text":"Project 2 — Short Documentary"},{"type":"p","text":"Produce a 5–15 minute documentary on:"},{"type":"list","items":[{"text":"Local cinema culture"},{"text":"Independent filmmakers"},{"text":"Theatre culture"},{"text":"Film communities"},{"text":"Regional cinema"}]},{"type":"h","text":"Project 3 — Actor/Director Interview"},{"type":"p","text":"Create a professional:"},{"type":"list","items":[{"text":"Interview plan"},{"text":"Question bank"},{"text":"Multi-camera/video setup"},{"text":"Edited interview"},{"text":"Short-form clips"}]},{"type":"h","text":"Project 4 — Film Video Essay"},{"type":"p","text":"Analyze:"},{"type":"list","items":[{"text":"Cinematography"},{"text":"Editing"},{"text":"Sound"},{"text":"Narrative"},{"text":"Character development"}]},{"type":"h","text":"Project 5 — Content Analytics Dashboard"},{"type":"p","text":"Use Excel or Power BI to track:"},{"type":"list","items":[{"text":"Video views"},{"text":"Watch time"},{"text":"Retention"},{"text":"Engagement"},{"text":"Subscriber growth"}]}]},{"heading":"Portfolio Strategy","kind":"other","blocks":[{"type":"p","text":"A strong portfolio should contain:"},{"type":"p","text":"1 Documentary"},{"type":"p","text":"+"},{"type":"p","text":"2–3 Film Analysis Videos"},{"type":"p","text":"+"},{"type":"p","text":"3–5 Short-Form Videos"},{"type":"p","text":"+"},{"type":"p","text":"1 Professional Interview"},{"type":"p","text":"+"},{"type":"p","text":"1 Video Essay"},{"type":"p","text":"+"},{"type":"p","text":"1 Branded Content Project"},{"type":"p","text":"+"},{"type":"p","text":"1 Content Strategy Case Study"},{"type":"p","text":"Create a simple portfolio webs