 Characters"},{"type":"p","text":"Create:"},{"type":"list","items":[{"text":"Main character"},{"text":"Villain"},{"text":"Supporting characters"},{"text":"NPCs"},{"text":"Costume variations"}]},{"type":"h","text":"Step 3 — World"},{"type":"p","text":"Create:"},{"type":"list","items":[{"text":"Major location"},{"text":"Interior"},{"text":"Exterior"},{"text":"Landmark"},{"text":"Environmental storytelling"}]},{"type":"h","text":"Step 4 — Props"},{"type":"p","text":"Design:"},{"type":"list","items":[{"text":"Weapons"},{"text":"Vehicles"},{"text":"Tools"},{"text":"Technology"}]},{"type":"h","text":"Step 5 — Keyframes"},{"type":"p","text":"Create 3–5 cinematic illustrations showing the world in action."},{"type":"p","text":"This demonstrates design consistency rather than isolated illustrations."}]},{"heading":"Certifications & Learning","kind":"certifications","blocks":[{"type":"p","text":"For Concept Art, portfolio quality is usually more important than collecting certificates."},{"type":"h","text":"Digital art"},{"type":"p","text":"Master one primary workflow:"},{"type":"list","items":[{"text":"Photoshop"},{"text":"Krita"},{"text":"Procreate"}]},{"type":"h","text":"3D"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Blender"}]},{"type":"p","text":"Then optionally explore:"},{"type":"list","items":[{"text":"ZBrush"},{"text":"Maya"},{"text":"Substance 3D"},{"text":"Unreal Engine"}]},{"type":"h","text":"Animation/Game tools"},{"type":"p","text":"Useful knowledge:"},{"type":"list","items":[{"text":"Unreal Engine"},{"text":"Unity"},{"text":"Substance Painter"},{"text":"Blender"}]},{"type":"h","text":"Traditional skills"},{"type":"p","text":"Continue practising:"},{"type":"list","items":[{"text":"Life drawing"},{"text":"Anatomy"},{"text":"Perspective"},{"text":"Environment sketching"},{"text":"Colour studies"},{"text":"Composition"}]}]},{"heading":"Careers You Can Be Hired As","kind":"careers","blocks":[{"type":"h","text":"Entry-level"},{"type":"list","items"