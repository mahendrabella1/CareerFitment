,{"type":"flow","items":["Brief","Exploration","Iteration","Design Decisions","Final Concept"]},{"type":"p","text":"Avoid showing only polished final images without explaining the design process."}]},{"heading":"Postgraduate Study in India","kind":"pg_india","blocks":[{"type":"p","text":"A Master's is not mandatory for becoming a Concept Artist."},{"type":"p","text":"Potential postgraduate areas include:"},{"type":"h","text":"M.Des Animation/Game Design"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Game art"},{"text":"Character design"},{"text":"Environment design"},{"text":"Game development"}]},{"type":"h","text":"M.Des Animation"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Visual development"},{"text":"Character design"},{"text":"Storyboarding"},{"text":"Animation"}]},{"type":"h","text":"M.Des Interaction/Digital Design"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Digital experiences"},{"text":"Interactive media"},{"text":"Game interfaces"}]},{"type":"h","text":"MFA / Fine Arts"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Advanced drawing"},{"text":"Painting"},{"text":"Illustration"},{"text":"Art practice"}]},{"type":"h","text":"VFX / Digital Production"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Film concept art"},{"text":"VFX pre-production"},{"text":"Virtual production"}]}]},{"heading":"High-Value Specialist Routes","kind":"other","blocks":[{"type":"h","text":"Route A — Character Concept Artist"},{"type":"p","text":"Build:"},{"type":"flow","items":["Drawing","Anatomy","Costume","Character Storytelling","Digital Painting"],"sep":"+"},{"type":"p","text":"Portfolio should show:"},{"type":"list","items":[{"text":"Silhouettes"},{"text":"Explorations"},{"text":"Turnarounds"},{"text":"Expressions"},{"text":"Costumes"},{"text":"Final key art"}]},{"type":"h","text":"Route B — Environment Concept Artist"},{"type":"p","text":"Build:"},{"type":"flow","ite