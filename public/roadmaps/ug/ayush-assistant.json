"},{"text":"Treatment-room preparation"},{"text":"Patient safety"}]},{"type":"h","text":"Therapy Support"},{"type":"list","items":[{"text":"Panchakarma procedure assistance"},{"text":"Equipment handling"},{"text":"Hygiene"},{"text":"Post-treatment support"}]},{"type":"h","text":"Operations"},{"type":"list","items":[{"text":"Appointments"},{"text":"Patient records"},{"text":"Inventory"},{"text":"Documentation"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Excel"},{"text":"EMR/HIS"},{"text":"Digital appointment systems"},{"text":"Basic analytics"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Communication"},{"text":"Confidentiality"},{"text":"Ethics"},{"text":"Teamwork"},{"text":"Escalation awareness"}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"p","text":"AYUSH Healthcare Foundation"},{"type":"p","text":"+"},{"type":"p","text":"Ayurveda Fundamentals"},{"type":"p","text":"+"},{"type":"p","text":"Panchakarma / Therapy Support"},{"type":"p","text":"+"},{"type":"p","text":"Patient-Care Skills"},{"type":"p","text":"+"},{"type":"p","text":"Basic Clinical Observation"},{"type":"p","text":"+"},{"type":"p","text":"First Aid & BLS"},{"type":"p","text":"+"},{"type":"p","text":"Infection Prevention"},{"type":"p","text":"+"},{"type":"p","text":"Treatment-Room Management"},{"type":"p","text":"+"},{"type":"p","text":"Documentation"},{"type":"p","text":"+"},{"type":"p","text":"Inventory Management"},{"type":"p","text":"+"},{"type":"p","text":"EMR / HIS"},{"type":"p","text":"+"},{"type":"p","text":"Excel & Healthcare Analytics"},{"type":"p","text":"+"},{"type":"p","text":"Patient Communication"},{"type":"p","text":"+"},{"type":"p","text":"Healthcare Operations"}]},{"heading":"Best Overall Positioning","kind":"other","blocks":[{"type":"flow","items":["Relevant Recognized Qualification","AYUSH/Ayurveda Fundamentals","Supervised Clinical/Therapy Training","AYUSH Internship","AYUSH Assistant","Panchakarma/Therapy Specialization","Senior Assistant","Patient-Care/Operations Coordinator","AYUSH Centre Management"]},{"type":"p","text":"For the strongest employability profile, combine AYUSH knowledge + supervised therapy-support skills + patient safety + infection control + documentation + digital healthcare + inventory management + patient communication + healthcare operations."},{"type":"note","label":"Career-fitment mapping note","text":"“AYUSH Assistant” is a broad occupational label rather than one universally standardized professional qualification. For this database, it is best treated as an AYUSH support/assistant pathway, while clearly separating it from regulated physician roles such as BAMS/BSMS/BUMS/BHMS practitioners and from specialized pharmacy roles such as Ayurveda Pharmacist. Exact eligibility should always follow the qualification and recruitment requirements of the specific AYUSH institution or employer."}]}]}