"}]},{"type":"h","text":"Option 5 — MBA Food / Operations Management"},{"type":"p","text":"Useful later for:"},{"type":"list","items":[{"text":"Production management"},{"text":"Quality management"},{"text":"Operations leadership"}]}]},{"heading":"Study Abroad","kind":"abroad","blocks":[{"type":"p","text":"Relevant postgraduate areas include:"},{"type":"list","items":[{"text":"Food Science"},{"text":"Food Technology"},{"text":"Food Safety"},{"text":"Food Quality Management"},{"text":"Food Microbiology"},{"text":"Bakery Science"},{"text":"Food Product Development"},{"text":"Food Manufacturing"}]},{"type":"p","text":"Potential destinations include:"},{"type":"list","items":[{"text":"Australia"},{"text":"Canada"},{"text":"UK"},{"text":"USA"},{"text":"Netherlands"},{"text":"Germany"},{"text":"New Zealand"},{"text":"France"}]},{"type":"p","text":"Always verify current programme eligibility and professional requirements."}]},{"heading":"Career Specialisations","kind":"other","blocks":[{"type":"h","text":"Track 1 — Bakery Quality Assurance"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Production quality"},{"text":"HACCP"},{"text":"CAPA"},{"text":"Audits"},{"text":"Quality systems"}]},{"type":"h","text":"Track 2 — Food Safety"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"HACCP"},{"text":"Microbiology"},{"text":"Food safety systems"},{"text":"Auditing"},{"text":"Regulatory compliance"}]},{"type":"h","text":"Track 3 — Product Quality / R&D"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Recipe development"},{"text":"Ingredient optimisation"},{"text":"Texture"},{"text":"Shelf life"},{"text":"Sensory evaluation"}]},{"type":"h","text":"Track 4 — Supplier Quality"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Ingredient suppliers"},{"text":"Supplier audits"},{"text":"Raw-material specifications"},{"text":"Supplier performance"},{"text":"Incoming quality"}]},{"type":"h","text":"Track 5 — Quality Analytics"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"SPC"},{"text":"Quality dashboards"},{"text":"Process capability"},{"text":"Defect prediction"},{"text":"Statistical analysis"}]}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"Quality Path"},{"type":"h","text":"B.Sc Culinary Science / Bakery & Confectionery"},{"type":"h","text":"QA/QC Intern"},{"type":"h","text":"Quality Analyst / QC Executive"},{"type":"h","text":"Senior QA/QC Executive"},{"type":"h","text":"QA Supervisor"},{"type":"h","text":"QA Manager"},{"type":"h","text":"Senior Quality Manager"},{"type":"h","text":"Head of Quality / Food Safety"},{"type":"h","text":"Quality Director"},{"type":"h","text":"Technical/R&D Path"},{"type":"h","text":"B.Sc"},{"type":"h","text":"Bakery R&D/Quality Trainee"},{"type":"h","text":"Product Development Executive"},{"type":"h","text":"Senior R&D Executive"},{"type":"h","text":"R&D Manager"},{"type":"h","text":"Technical Manager"},{"type":"h","text":"Head of Product Development"}]},{"heading":"PhD / Research Directions","kind":"other","blocks":[{"type":"p","text":"For students interested in advanced food science:"},{"type":"h","text":"Bakery Science"},{"type":"list","items":[{"text":"Gluten functionality"},{"text":"Dough rheology"},{"text":"Baking process optimisation"},{"text":"Shelf-life extension"}]},{"type":"h","text":"Food Chemistry"},{"type":"list","items":[{"text":"Starch modification"},{"text":"Protein functionality"},{"text":"Lipid oxidation"},{"text":"Food additives"}]},{"type":"h","text":"Food Microbiology"},{"type":"list","items":[{"text":"Spoilage organisms"},{"text":"Pathogen control"},{"text":"Preservation"},{"text":"Predictive microbiology"}]},{"type":"h","text":"Product Development"},{"type":"list","items":[{"text":"High-protein bakery products"},{"text":"Gluten-free products"},{"text":"Low-sugar products"},{"text":"Functional foods"},{"text":"Clean-label products"},{"text":"Sustainable ingredients"}]}]},{"