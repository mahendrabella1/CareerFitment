":"Dementia"},{"text":"Depression"},{"text":"Anxiety"},{"text":"Delirium"},{"text":"Behavioral symptoms"},{"text":"Cognitive decline"},{"text":"Caregiver stress"}]},{"type":"p","text":"The nurse should distinguish acute changes such as delirium from chronic cognitive decline, and escalate appropriately."}]},{"heading":"Digital Health Skills","kind":"other","blocks":[{"type":"p","text":"Modern psychiatric nursing increasingly interacts with digital healthcare."},{"type":"h","text":"Tools"},{"type":"list","items":[{"text":"Electronic Health Records"},{"text":"Hospital Information Systems"},{"text":"Telepsychiatry platforms"},{"text":"Digital patient monitoring"},{"text":"Electronic medication records"},{"text":"Secure communication platforms"}]},{"type":"h","text":"Data skills"},{"type":"p","text":"Useful skills include:"},{"type":"list","items":[{"text":"Excel"},{"text":"Basic healthcare analytics"},{"text":"Clinical dashboards"},{"text":"Documentation systems"},{"text":"Data privacy"},{"text":"Cybersecurity awareness"}]}]},{"heading":"Tele-Mental Health","kind":"other","blocks":[{"type":"p","text":"Telehealth can support:"},{"type":"list","items":[{"text":"Follow-up consultations"},{"text":"Medication adherence monitoring"},{"text":"Psychoeducation"},{"text":"Remote behavioural support"},{"text":"Family communication"},{"text":"Community mental-health programs"}]},{"type":"p","text":"A psychiatric nurse may help with:"},{"type":"flow","items":["Patient Registration","Digital Assessment Support","Remote Monitoring","Clinical Escalation","Follow-Up","Documentation"]}]},{"heading":"Projects During UG","kind":"build","blocks":[{"type":"h","text":"Project 1 — Psychiatric Nursing Assessment Template"},{"type":"p","text":"Create a structured academic template covering:"},{"type":"list","items":[{"text":"Patient demographics"},{"text":"Presenting concern"},{"text":"Mental-status examination"},{"text":"Risk assessment"},{"text":"Nursing problems"},{"text":"Intervention"},{"text":"Outcome"}]},{"type":"p","text":"Use fictional/synthetic cases for portfolio work."},{"type":"h","text":"Project 2 — Mental-Health Risk Dashboard"},{"type":"p","text":"Build a simple Excel/Power BI dashboard using synthetic data."},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Patient age group"},{"text":"Diagnosis category"},{"text":"Admission type"},{"text":"Risk category"},{"text":"Length of stay"},{"text":"Follow-up status"}]},{"type":"h","text":"Project 3 — Suicide Prevention Care Pathway"},{"type":"p","text":"Create a workflow:"},{"type":"flow","items":["Risk Screening","Risk Classification","Immediate Safety","Psychiatric Evaluation","Safety Planning","Family / Support System","Treatment","Follow-Up"]},{"type":"h","text":"Project 4 — De-addiction Nursing Workflow"},{"type":"p","text":"Document the nursing pathway from:"},{"type":"flow","items":["Admission","Assessment","Withdrawal Monitoring","Medical Management","Psychological Support","Rehabilitation","Relapse Prevention","Follow-Up"]},{"type":"h","text":"Project 5 — Tele-Mental-Health Model"},{"type":"p","text":"Design a conceptual system connecting:"},{"type":"list","items":[{"text":"Patient"},{"text":"Psychiatric nurse"},{"text":"Psychiatrist"},{"text":"Psychologist"},{"text":"Family"},{"text":"Digital health platform"}]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"h","text":"Highest-value clinical environments"},{"type":"list","items":[{"text":"Psychiatric hospitals"},{"text":"Government mental-health institutions"},{"text":"Medical-college psychiatry departments"},{"text":"De-addiction centres"},{"text":"Rehabilitation centres"},{"text":"Community mental-health programs"},{"text":"Child/adolescent mental-health services"},{"text":"Geriatric psychiatry services"},{"text":"General hospitals with psychiatry units"}]},{"type":"h","text":"Suitable internship exposure"},{"type":"list","items":[{"text":"Psychiatric Nursing Intern"},{"text":"Mental Health Nur