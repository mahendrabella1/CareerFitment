search"},{"text":"Fact-checking"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"WordPress/CMS"},{"text":"SEO"},{"text":"Content analytics"},{"text":"Basic HTML/CSS"},{"text":"Digital publishing"},{"text":"Newsletter platforms"}]},{"type":"h","text":"AI"},{"type":"list","items":[{"text":"AI-assisted research"},{"text":"Prompting"},{"text":"Fact verification"},{"text":"AI content evaluation"},{"text":"AI ethics"},{"text":"Responsible AI practices"}]},{"type":"h","text":"Specialised"},{"type":"p","text":"Choose one:"},{"type":"p","text":"Technical Writing / Journalism / Publishing / UX Writing / Corporate Communications / AI Ethics / Thought Leadership"},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Project management"},{"text":"Editorial planning"},{"text":"Stakeholder communication"},{"text":"Interviewing"},{"text":"Presentation"},{"text":"Personal branding"}]},{"type":"h","text":"Target progression"},{"type":"table","header":["Stage","Target"],"rows":[[{"text":"Year 1"},{"text":"Writing + philosophy + research fundamentals"}],[{"text":"Year 2"},{"text":"Editing + digital publishing + SEO"}],[{"text":"Year 3"},{"text":"Specialisation + portfolio + internships"}],[{"text":"Graduation"},{"text":"Writer / Editorial Assistant / Content Associate"}],[{"text":"Years 1–3"},{"text":"Build published portfolio + domain expertise"}],[{"text":"Years 3–6"},{"text":"Editor / Senior Writer / Specialist Writer"}],[{"text":"Years 6–10"},{"text":"Senior Editor / Content Strategist / Managing Editor"}],[{"text":"10+ years"},{"text":"Editorial Director / Content Director / Author / Consultant"}]]},{"type":"h","text":"Best employability combination"},{"type":"flow","items":["BA Philosophy","exceptional writing","editing/proofreading","research & fact-checking","digital publishing","SEO","AI literacy","strong portfolio","domain specialisation"],"sep":"+"},{"type":"note","label":"Key principle","text":"A Philosophy graduate should not compete only as a generic content writer. The stronger strategy is to use philosophical reasoning and clarity of thought as the foundation, then add a commercially valuable specialisation such as technical writing, AI ethics, journalism, publishing, UX writing, corporate communications or thought leadership."}]}]}