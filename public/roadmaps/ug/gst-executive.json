eply preparation"},{"text":"Documentation"},{"text":"Tax litigation basics"},{"text":"Record retention"},{"text":"Compliance calendars"}]},{"type":"p","text":"Also learn:"},{"type":"list","items":[{"text":"Power BI"},{"text":"SQL basics"},{"text":"Power Query"},{"text":"ERP systems"}]},{"type":"h","text":"Final year — GST portfolio"},{"type":"h","text":"Project 1 — GST Reconciliation System"},{"type":"p","text":"Create a dataset containing:"},{"type":"list","items":[{"text":"Purchase invoices"},{"text":"Sales invoices"},{"text":"GSTIN"},{"text":"Taxable value"},{"text":"CGST"},{"text":"SGST"},{"text":"IGST"},{"text":"Invoice date"},{"text":"Invoice number"}]},{"type":"p","text":"Build an Excel/Power BI reconciliation dashboard."},{"type":"p","text":"Identify:"},{"type":"list","items":[{"text":"Matched invoices"},{"text":"Missing invoices"},{"text":"Mismatched tax"},{"text":"Duplicate invoices"},{"text":"ITC exceptions"}]},{"type":"h","text":"Project 2 — GST Compliance Calendar"},{"type":"p","text":"Create a simulated company compliance system covering:"},{"type":"list","items":[{"text":"Monthly returns"},{"text":"Tax payment"},{"text":"E-invoicing"},{"text":"E-way bills"},{"text":"Reconciliation"},{"text":"Annual compliance"}]},{"type":"p","text":"Track:"},{"type":"flow","items":["Due Date","Responsible Person","Status","Exception","Resolution"]},{"type":"h","text":"Project 3 — GST Notice Response Simulation"},{"type":"p","text":"Create a fictional GST discrepancy and prepare:"},{"type":"list","items":[{"text":"Issue identification"},{"text":"Supporting documents"},{"text":"Reconciliation"},{"text":"Explanation"},{"text":"Draft response"},{"text":"Corrective action"}]},{"type":"p","text":"This demonstrates practical tax-compliance thinking."},{"type":"h","text":"Specialisation options"},{"type":"table","header":["Specialisation","Key skills"],"rows":[[{"text":"GST Compliance"},{"text":"Returns, ITC, reconciliations"}],[{"text":"GST Advisory"},{"text":"Tax interpreta