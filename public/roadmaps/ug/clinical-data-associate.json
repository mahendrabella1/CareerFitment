":"Technology pathway"},{"type":"flow","items":["Clinical Data Associate","Clinical Data Analyst","Clinical Data Standards Specialist","Clinical Data Engineer / Analytics","Clinical AI / Data Science"]}]},{"heading":"Emerging Technologies","kind":"other","blocks":[{"type":"p","text":"Clinical data management is becoming increasingly technology-driven."},{"type":"h","text":"Artificial Intelligence"},{"type":"p","text":"Potential applications include:"},{"type":"list","items":[{"text":"Automated data validation"},{"text":"Missing-data detection"},{"text":"Outlier detection"},{"text":"Intelligent query generation"},{"text":"Data-quality prediction"},{"text":"Automated document review"}]},{"type":"h","text":"Real-World Data"},{"type":"p","text":"Clinical research increasingly incorporates:"},{"type":"list","items":[{"text":"Electronic health records"},{"text":"Claims data"},{"text":"Patient registries"},{"text":"Wearable devices"},{"text":"Patient-generated data"},{"text":"Digital biomarkers"}]},{"type":"h","text":"Decentralized clinical trials"},{"type":"p","text":"Learn about:"},{"type":"list","items":[{"text":"Remote patient monitoring"},{"text":"Telemedicine visits"},{"text":"Digital consent"},{"text":"Wearable data"},{"text":"Remote data collection"}]},{"type":"h","text":"Automation"},{"type":"list","items":[{"text":"Robotic process automation"},{"text":"Automated reconciliation"},{"text":"Automated data checks"},{"text":"Workflow automation"}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"p","text":"By graduation, aim for:"},{"type":"p","text":"Clinical Research"},{"type":"p","text":"+"},{"type":"p","text":"Medical Terminology"},{"type":"p","text":"+"},{"type":"p","text":"Clinical Data Management"},{"type":"p","text":"+"},{"type":"p","text":"EDC Systems"},{"type":"p","text":"+"},{"type":"p","text":"eCRF"},{"type":"p","text":"+"},{"type":"p","text":"Data Cleaning"},{"type":"p","text":"+"},{"type":"p","text":"Query Management"},{"ty