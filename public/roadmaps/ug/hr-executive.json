mpetency Framework"},{"type":"p","text":"Select a role such as:"},{"type":"h","text":"Software Developer"},{"type":"p","text":"Create:"},{"type":"list","items":[{"text":"Job description"},{"text":"Required competencies"},{"text":"Technical skills"},{"text":"Behavioural competencies"},{"text":"Interview questions"},{"text":"Evaluation scorecard."}]},{"type":"p","text":"This demonstrates recruitment capability."},{"type":"h","text":"Project 4 — Employee Onboarding System"},{"type":"p","text":"Design an onboarding workflow:"},{"type":"flow","items":["Offer","Documentation","HR Orientation","Team Introduction","Training","30/60/90-Day Review"]},{"type":"p","text":"Create the workflow using:"},{"type":"list","items":[{"text":"Excel"},{"text":"Notion"},{"text":"Power Automate"},{"text":"HRIS simulation"},{"text":"Google Workspace/Microsoft 365."}]},{"type":"h","text":"Project 5 — Attrition Analysis"},{"type":"p","text":"Create a sample employee dataset and investigate:"},{"type":"list","items":[{"text":"Department"},{"text":"Tenure"},{"text":"Salary band"},{"text":"Performance"},{"text":"Promotion history"},{"text":"Engagement"},{"text":"Attrition."}]},{"type":"p","text":"Use statistical analysis to identify possible patterns."},{"type":"note","label":"Important","text":"correlations should not be presented as proof that a factor caused attrition."}]},{"heading":"Three-Year Skill Development Plan","kind":"build","blocks":[{"type":"table","header":["Skill","Year 1","Year 2","Year 3"],"rows":[[{"text":"Psychology"},{"text":"Strong"},{"text":"Advanced"},{"text":"Applied"}],[{"text":"Organisational Psychology"},{"text":"Introduction"},{"text":"Strong"},{"text":"Advanced"}],[{"text":"Recruitment"},{"text":"—"},{"text":"Basic"},{"text":"Advanced"}],[{"text":"HR Operations"},{"text":"—"},{"text":"Basic"},{"text":"Advanced"}],[{"text":"Employee Engagement"},{"text":"Basic"},{"text":"Intermediate"},{"text":"Advanced"}],[{"text":"Labour Law"},{"text":"—"},{"text":"Introduction"},{"text":"Intermediate"}],[{"text":"Excel"},{"text":"Basic"},{"text":"Intermediate"},{"text":"Advanced"}],[{"text":"Power BI"},{"text":"—"},{"text":"Basic"},{"text":"Intermediate"}],[{"text":"SQL"},{"text":"—"},{"text":"Basic"},{"text":"Intermediate"}],[{"text":"HR Analytics"},{"text":"—"},{"text":"Basic"},{"text":"Advanced"}],[{"text":"HRIS/HRMS"},{"text":"—"},{"text":"Introduction"},{"text":"Practical"}],[{"text":"Communication"},{"text":"Strong"},{"text":"Professional"}],[{"text":"Interviewing"},{"text":"—"},{"text":"Basic"},{"text":"Advanced"}]]}]},{"heading":"Specialisation Options","kind":"other","blocks":[{"type":"h","text":"A. Talent Acquisition"},{"type":"p","text":"Best fit for graduates who enjoy:"},{"type":"list","items":[{"text":"People interaction"},{"text":"Recruitment"},{"text":"Communication"},{"text":"Networking"},{"text":"Candidate assessment."}]},{"type":"h","text":"Roles"},{"type":"list","items":[{"text":"Talent Acquisition Associate"},{"text":"Recruiter"},{"text":"Recruitment Executive"},{"text":"Talent Acquisition Specialist."}]},{"type":"h","text":"B. Organisational Development"},{"type":"p","text":"Strongest connection to psychology."},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Organisational culture"},{"text":"Leadership development"},{"text":"Employee engagement"},{"text":"Change management"},{"text":"Team effectiveness"},{"text":"Behavioural interventions."}]},{"type":"h","text":"Roles"},{"type":"list","items":[{"text":"OD Associate"},{"text":"Organisational Development Specialist"},{"text":"Employee Experience Specialist"},{"text":"Learning & Development Specialist."}]},{"type":"h","text":"C. Learning & Development"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Training needs analysis"},{"text":"Learning design"},{"text":"Employee training"},{"text":"Leadership development"},{"text":"Skill-gap analysis"},{"text":"Training evaluation."}]},{"type":"h","text":"Roles"},{"type":"list","items":[{"text":"L&D Executive"},{"text":"Training Coordinator"},{"text":"Learning Specialist"},{"text":"Talent Development Specialist."}]},{"type":"h","text":"D. People Analytics"},{"type":"p","text":"One of the strongest future-oriented options."},{"type":"p","text":"Combine:"},{"type":"flow","items":["Psychology","HR","Statistics","Data"],"sep":"+"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Excel"},{"text":"SQL"},{"text":"Power BI"},{"text":"Python"},{"text":"Statistics"},{"text":"HR metrics"},{"text":"Predictive analytics."}]},{"type":"h","text":"Roles"},{"type":"list","items":[{"text":"People Analytics Analyst"},{"text":"HR Data Analyst"},{"text":"Workforce Analyst"},{"text":"People Insights Analyst."}]},{"type":"h","text":"E. Employee Relations"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Workplace communication"},{"text":"Grievance handling"},{"text":"Conflict resolution"},{"text":"HR policies"},{"text":"Employee relations"},{"text":"Labour-law fundamentals."}]},{"type":"p","text":"This requires strong understanding of the applicable employment-law framework."}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Internships are extremely important because HR is a practice-oriented business function."},{"type":"h","text":"Target companies"},{"type":"p","text":"Apply to:"},{"type":"list","items":[{"text":"Startups"},{"text":"IT companies"},{"text":"Consulting firms"},{"text":"EdTech companies"},{"text":"Healthcare companies"},{"text":"Manufacturing companies"},{"text":"Recruitment agencies"},{"text":"Staffing companies"},{"text":"Corporate HR departments"},{"text":"HR-tech companies."}]},{"type":"h","text":"Departments"},{"type":"p","text":"Target:"},{"type":"flow","items":["HR","Talent Acquisition","People Operations","L&D","Employee Engagement","People Analytics"]},{"type":"h","text":"What to actually do during an internship"},{"type":"p","text":"Try to gain experience in:"},{"type":"list","items":[{"text":"Candidate sourcing"},{"text":"Resume screening"},{"text":"Interview scheduling"},{"text":"HR documentation"},{"text":"Employee onboarding"},{"text":"HRMS updates"},{"text":"Attendance/leave coordination"},{"text":"Engagement surveys"},{"text":"HR reporting"},{"text":"Recruitment analytics."}]},{"type":"p","text":"An internship where you only make posters or perform administrative errands provides much less career value."}]},{"heading":"Certifications & Learning","kind":"certifications","blocks":[{"type":"p","text":"Prioritise skills and recognised learning over certificate accumulation."},{"type":"h","text":"Core HR"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"HR fundamentals"},{"text":"Recruitment"},{"text":"Talent acquisition"},{"text":"Performance management"},{"text":"Compensation basics"},{"text":"Employee engagement"},{"text":"Learning & development"},{"text":"HR operations."}]},{"type":"h","text":"Psychology"},{"type":"p","text":"Strengthen:"},{"type":"list","items":[{"text":"Organisational psychology"},{"text":"Industrial psychology"},{"text":"Behavioural assessment"},{"text":"Motivation"},{"text":"Leadership"},{"text":"Group dynamics."}]},{"type":"h","text":"Analytics"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Excel"},{"text":"Power BI"},{"text":"SQL"},{"text":"Statistics"},{"text":"Python basics."}]},{"type":"h","text":"Technology"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"ATS"},{"text":"HRMS/HRIS"},{"text":"Employee self-service systems"},{"text":"Workflow automation"},{"text":"AI-assisted recruitment concepts."}]}]},{"heading":"Jobs You Can Be Hired For","kind":"careers","blocks":[{"type":"h","text":"Direct-entry roles"},{"type":"p","text":"A B.Sc Psychology graduate can target:"},{"type":"list","items":[{"text":"HR Intern"},{"text":"HR Assistant"},{"text":"HR Executive"},{"text":"HR Operations Executive"},{"text":"Recruitment Executive"},{"text":"Talent Acquisition Associate"},{"text":"Recruiter"},{"text":"People Operations Associate"},{"text":"Employee Engagement Executive"},{"text":"L&D Coordinator"},{"text":"HR Coordinator"},{"text":"HR Associate."}]},{"type":"p","text":"The exact title and eligibility depend on the employer."},{"type":"h","text":"After 2–5 Years"},{"type":"p","text":"Possible roles:"},{"type":"list","items":[{"text":"Senior HR Executive"},{"text":"Senior Recruiter"},{"text":"HR Generalist"},{"text":"HR Business Partner Associate"},{"text":"Talent Acquisition Specialist"},{"text":"L&D Specialist"},{"text":"Employee Experience Specialist"},{"text":"People Analytics Analyst"},{"text":"HR Operations Specialist."}]}]},{"heading":"Postgraduate Options in India","kind":"pg_india","blocks":[{"type":"p","text":"A PG is not mandatory to start in HR, but it becomes valuable for specialist and managerial progression."},{"type":"h","text":"MBA / PGDM in Human Resources"},{"type":"p","text":"The most direct management-oriented option."},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"HR leadership"},{"text":"HRBP"},{"text":"Talent management"},{"text":"Compensation"},{"text":"Employee relations"},{"text":"Organisational development."}]},{"type":"p","text":"Possible entrance routes include institution-specific admissions and exams such as CAT, XAT, CMAT, MAT and others, depending on the institution."},{"type":"h","text":"M.A./M.Sc Industrial or Organisational Psychology"},{"type":"p","text":"One of the strongest options if you want to preserve the psychology foundation."},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Organisational behaviour"},{"text":"Assessment"},{"text":"Employee engagement"},{"text":"Leadership"},{"text":"Workplace research"},{"text":"Organisational development."}]},{"type":"h","text":"M.A./M.Sc Psychology"},{"type":"p","text":"Useful for deeper psychology expertise, although you should select the program based on its organisational/industrial orientation if HR is the target."},{"type":"h","text":"MBA / Master's in Business Analytics"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"People analytics"},{"text":"Workforce analytics"},{"text":"HR data science"},{"text":"Strategic HR."}]},{"type":"h","text":"Master's in Human Resource Management"},{"type":"p","text":"A direct specialisation for students who want to remain in HR."}]},{"heading":"Study Abroad","kind":"abroad","blocks":[{"type":"p","text":"Relevant fields include:"},{"type":"list","items":[{"text":"Human Resource Management"},{"text":"Human Resources & Organisational Psychology"},{"text":"Industrial/Organisational Psychology"},{"text":"Organisational Behaviour"},{"text":"People Analytics"},{"text":"Talent Management"},{"text":"Business Analytics."}]},{"type":"h","text":"Countries to consider"},{"type":"table","header":["Country","Relevant Areas"],"rows":[[{"text":"🇬🇧 UK"},{"text":"HRM, Organisational Psychology, People Analytics"}],[{"text":"🇨🇦 Canada"},{"text":"HRM, Organisational Behaviour, Business Analytics"}],[{"text":"🇺🇸 USA"},{"text":"Industrial/Organisational Psychology, HR, People Analytics"}],[{"text":"🇦🇺 Australia"},{"text":"HRM, Organisational Psychology, Business"}],[{"text":"🇳🇱 Netherlands"},{"text":"HRM, Organisational Behaviour, People Analytics"}],[{"text":"🇩🇪 Germany"},{"text":"HRM, Organisational Psychology, Management"}]]},{"type":"h","text":"Application profile"},{"type":"p","text":"Build:"},{"type":"list","items":[{"text":"Strong academic record"},{"text":"HR internship"},{"text":"Recruitment project"},{"text":"HR analytics project"},{"text":"Psychology research project"},{"text":"Leadership/activity evidence"},{"text":"Statement of purpose"},{"text":"Recommendations"},{"text":"English-language test where required."}]}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"p","text":"A realistic pathway:"},{"type":"h","text":"B.Sc Psychology"},{"type":"h","text":"HR Intern / HR Assistant"},{"type":"h","text":"HR Executive / Recruitment E