ctor"},{"type":"h","text":"Public Health Track"},{"type":"h","text":"Nutrition Programme Assistant"},{"type":"h","text":"Community Nutrition Coordinator"},{"type":"h","text":"Public Health Nutrition Specialist"},{"type":"h","text":"Programme Manager"},{"type":"h","text":"Public Health Nutrition Lead"},{"type":"h","text":"Research Track"},{"type":"h","text":"Research Assistant"},{"type":"h","text":"Research Coordinator"},{"type":"h","text":"Research Associate"},{"type":"h","text":"Senior Researcher"},{"type":"h","text":"Research Lead / Programme Scientist"},{"type":"p","text":"Advanced research roles typically require postgraduate and often doctoral qualifications."}]},{"heading":"Specialist Career Routes","kind":"other","blocks":[{"type":"h","text":"Route 1 — Community Nutrition"},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"Community assessment"},{"text":"Nutrition education"},{"text":"Public-health communication"},{"text":"Survey methods"},{"text":"Programme monitoring"},{"text":"Health promotion"}]},{"type":"p","text":"Potential employers:"},{"type":"list","items":[{"text":"NGOs"},{"text":"Public-health organisations"},{"text":"Government programmes"},{"text":"Research institutions"}]},{"type":"h","text":"Route 2 — Nutrition + Data"},{"type":"p","text":"Combine:"},{"type":"flow","items":["Nutrition","Excel","Power BI","Statistics","Research"],"sep":"+"},{"type":"p","text":"Build dashboards showing:"},{"type":"list","items":[{"text":"Nutrition indicators"},{"text":"Programme coverage"},{"text":"Demographics"},{"text":"Intervention outcomes"},{"text":"Food-security indicators"}]},{"type":"p","text":"This can lead toward nutrition programme analytics."},{"type":"h","text":"Route 3 — Food Industry"},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"Food composition"},{"text":"Food safety"},{"text":"Nutrition labelling"},{"text":"Quality assurance"},{"text":"HACCP"},{"text":"Product development"},{"text":"Regulatory awareness"}]},{"typ