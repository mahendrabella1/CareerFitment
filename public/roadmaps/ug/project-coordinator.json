{"text":"Reporting"}]},{"type":"h","text":"2030–2035"},{"type":"h","text":"Assistant Project Manager / Project Controls Specialist"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Cost"},{"text":"Schedule"},{"text":"Risk"},{"text":"Contractor management"}]},{"type":"h","text":"2035–2040"},{"type":"h","text":"Project Manager / Senior Project Manager"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"End-to-end delivery"},{"text":"Budget"},{"text":"Stakeholders"},{"text":"Risk"},{"text":"Teams"}]},{"type":"h","text":"2040–2045"},{"type":"p","text":"Potential roles:"},{"type":"list","items":[{"text":"Project Director"},{"text":"Programme Manager"},{"text":"Development Director"},{"text":"Head of Projects"},{"text":"Real Estate Development Director"}]}]},{"heading":"Ideal Graduate Profile","kind":"other","blocks":[{"type":"p","text":"By graduation, the student should have:"},{"type":"list","items":[{"text":"BBA/BMS/BBM in Real Estate/Construction Management"},{"text":"Construction lifecycle knowledge"},{"text":"Project management fundamentals"},{"text":"Advanced Excel"},{"text":"MS Project or Primavera"},{"text":"Power BI"},{"text":"Procurement fundamentals"},{"text":"Cost tracking"},{"text":"Risk management"},{"text":"Contract basics"},{"text":"Project documentation"},{"text":"Site exposure"},{"text":"1–2 internships"},{"text":"4–5 practical projects"},{"text":"Strong communication"},{"text":"Stakeholder-management skills"}]},{"type":"h","text":"Best Practical Path"},{"type":"h","text":"BBA Real Estate / Construction Management"},{"type":"flow","items":["Business + construction fundamentals","Project management","Advanced Excel","MS Project / Primavera","Procurement + cost tracking","Power BI","Risk + contract fundamentals","Construction/real-estate internship","Project Coordinator / Project Executive","Senior Project Coordinator","Assistant Project Manager","Project Manager","Senior Project Manager","Project Director / Development Director"]},{"type":"h","text":"Best strategic combination"},{"type":"p","text":"For this career, the strongest combination is:"},{"type":"flow","items":["Project Management","Construction Knowledge","Scheduling","Cost Control","Excel/Power BI","ERP/Project Software."],"sep":"+"},{"type":"p","text":"The biggest differentiator is real project exposure. A graduate who can demonstrate a construction schedule, project dashboard, procurement tracker, risk register and actual site/internship experience will be much more employable than a candidate with only theoretical project-management knowledge."}]}]}