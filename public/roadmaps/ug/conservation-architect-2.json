":"list","items":[{"text":"Minimum intervention"},{"text":"Authenticity"},{"text":"Integrity"},{"text":"Reversibility where appropriate"},{"text":"Compatibility of materials"},{"text":"Documentation"},{"text":"Significance-based conservation"},{"text":"Respect for historic fabric"},{"text":"Distinguishing new interventions from historic fabric"},{"text":"The objective is not always to make an old building look “new.”"},{"text":"The objective is to retain and communicate its heritage value while ensuring appropriate continued use and safety."}]}]},{"heading":"Adaptive Reuse","kind":"other","blocks":[{"type":"p","text":"Adaptive reuse is an important career specialization."},{"type":"p","text":"Examples:"},{"type":"flow","items":["Historic Building","Heritage Assessment","Significance Mapping","Condition Assessment","Structural Assessment","Adaptive-Reuse Strategy","Compatible New Functions","Minimal Intervention","Services Integration","Conservation + New Design"]},{"type":"p","text":"Potential new uses include:"},{"type":"list","items":[{"text":"Museum"},{"text":"Cultural centre"},{"text":"Boutique hotel"},{"text":"Library"},{"text":"Restaurant"},{"text":"Gallery"},{"text":"Community centre"},{"text":"Educational facility"},{"text":"Creative workspace"}]}]},{"heading":"Tools & Software","kind":"other","blocks":[{"type":"h","text":"Essential"},{"type":"list","items":[{"text":"AutoCAD"},{"text":"Revit"},{"text":"SketchUp"},{"text":"Photoshop"},{"text":"Illustrator"},{"text":"InDesign"},{"text":"Excel"}]},{"type":"h","text":"GIS"},{"type":"p","text":"Strongly recommended:"},{"type":"list","items":[{"text":"QGIS"},{"text":"ArcGIS"}]},{"type":"p","text":"Use GIS for:"},{"type":"list","items":[{"text":"Heritage mapping"},{"text":"Historic precinct mapping"},{"text":"Urban analysis"},{"text":"Spatial documentation"}]},{"type":"h","text":"3D Documentation"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Photogrammetry"},{"text":"3D modelling"},{"text":"Point 