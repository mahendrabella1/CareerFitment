"},{"text":"Industrial IoT Technician"},{"text":"Controls Technician"},{"text":"PLC Technician"},{"text":"SCADA Technician"},{"text":"Robotics Technician"},{"text":"Maintenance Automation Technician"},{"text":"Automation Test Technician"}]},{"type":"h","text":"With experience"},{"type":"list","items":[{"text":"Senior Automation Technician"},{"text":"Automation Engineer"},{"text":"Controls Engineer"},{"text":"PLC Engineer"},{"text":"SCADA Engineer"},{"text":"Robotics Engineer"},{"text":"IIoT Engineer"},{"text":"Industrial Automation Specialist"}]},{"type":"h","text":"Interview Questions"},{"type":"p","text":"Expect questions such as:"},{"type":"list","items":[{"text":"What is a PLC?"},{"text":"PLC vs microcontroller?"},{"text":"What is Ladder Logic?"},{"text":"What are digital and analog signals?"},{"text":"What is a proximity sensor?"},{"text":"How does a relay work?"},{"text":"What is Modbus?"},{"text":"Difference between Modbus RTU and TCP?"},{"text":"What is MQTT?"},{"text":"What is SCADA?"},{"text":"PLC vs SCADA?"},{"text":"What is an HMI?"},{"text":"How would you troubleshoot a machine that suddenly stops?"},{"text":"How do you identify a faulty sensor?"},{"text":"What is an interlock?"},{"text":"What is PID control?"},{"text":"What is OPC UA?"},{"text":"How would you connect a PLC to a dashboard?"},{"text":"How can IoT be used for predictive maintenance?"},{"text":"Explain your automation project."}]}]},{"heading":"Postgraduate Study in India","kind":"pg_india","blocks":[{"type":"p","text":"Useful options:"},{"type":"p","text":"M.Tech / M.E."},{"type":"p","text":"Depending on eligibility:"},{"type":"list","items":[{"text":"Automation & Robotics"},{"text":"Industrial Automation"},{"text":"Control Systems"},{"text":"Embedded Systems"},{"text":"IoT"},{"text":"Robotics"},{"text":"Artificial Intelligence"},{"text":"Computer Science"},{"text":"Mechatronics"}]},{"type":"h","text":"MCA"},{"type":"p","text":"Useful when the student wants to strengthen:"},{"type":"list"