ses"},{"type":"p","text":"+"},{"type":"p","text":"Regulatory Knowledge"},{"type":"p","text":"+"},{"type":"p","text":"GVP / ICH"},{"type":"p","text":"+"},{"type":"p","text":"Excel"},{"type":"p","text":"+"},{"type":"p","text":"Statistics"},{"type":"p","text":"+"},{"type":"p","text":"SQL / Power BI"},{"type":"p","text":"+"},{"type":"p","text":"AI / NLP Awareness"}]},{"heading":"Suggested 4-Year Development Plan","kind":"other","blocks":[{"type":"table","header":["Year","Primary Goal","Key Outcomes"],"rows":[[{"text":"Year 1"},{"text":"Medical foundation"},{"text":"Anatomy, physiology, terminology"}],[{"text":"Year 2"},{"text":"Drug science"},{"text":"Pharmacology, toxicology, therapeutics"}],[{"text":"Year 3"},{"text":"PV specialization"},{"text":"ICSR, MedDRA, case processing"}],[{"text":"Year 4"},{"text":"Industry readiness"},{"text":"Regulatory PV, safety databases, analytics"}],[{"text":"Graduation"},{"text":"Entry into industry"},{"text":"Drug Safety Associate / PV Associate"}],[{"text":"1–3 Years"},{"text":"Specialization"},{"text":"Case processing / quality / literature"}],[{"text":"3–6 Years"},{"text":"Advanced role"},{"text":"Safety Specialist / Safety Scientist"}],[{"text":"6+ Years"},{"text":"Leadership"},{"text":"PV Lead / PV Manager"}]]}]},{"heading":"Graduation Profile","kind":"other","blocks":[{"type":"p","text":"By graduation, the student should ideally have:"},{"type":"h","text":"Scientific Knowledge"},{"type":"list","items":[{"text":"Pharmacology"},{"text":"Pathophysiology"},{"text":"Pharmacotherapeutics"},{"text":"Toxicology"},{"text":"Clinical research"},{"text":"Medical terminology"}]},{"type":"h","text":"Pharmacovigilance"},{"type":"list","items":[{"text":"ICSR workflow"},{"text":"Case validity"},{"text":"Seriousness"},{"text":"Severity"},{"text":"Expectedness"},{"text":"Causality"},{"text":"Follow-up"},{"text":"Duplicate identification"},{"text":"Case narratives"},{"text":"Medical coding"},{"text":"Signal-detection fundamentals"}]},{"type":"h","text":"Regulatory"},{"type":"list","items":[{"text":"ICH principles"},{"text":"GVP concepts"},{"text":"Regulatory safety reporting"},{"text":"Risk management"},{"text":"Pharmacovigilance quality systems"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Excel"},{"text":"Safety database concepts"},{"text":"Data validation"},{"text":"Basic SQL"},{"text":"Power BI"},{"text":"Statistics"},{"text":"AI/NLP awareness"}]},{"type":"h","text":"Practical Experience"},{"type":"p","text":"Ideally:"},{"type":"list","items":[{"text":"1 PV internship"},{"text":"1 clinical research exposure"},{"text":"2–3 simulated ICSR projects"},{"text":"MedDRA learning/practice"},{"text":"Safety-data dashboard"},{"text":"Literature-surveillance project"}]}]},{"heading":"Best Overall Positioning","kind":"other","blocks":[{"type":"p","text":"B.Pharm – Pharma Data / Pharmacovigilance & Regulatory → Drug Safety Associate is a strong modern pharmacy career pathway because it combines pharmaceutical science with clinical data, safety monitoring, regulatory compliance, and healthcare technology."},{"type":"p","text":"The core employability combination is:"},{"type":"flow","items":["Pharmacology","Medical Terminology","Pharmacovigilance","ICSR Processing","MedDRA","Case Narrative Writing","Regulatory Knowledge"],"sep":"+"},{"type":"p","text":"For future-ready positioning, add:"},{"type":"flow","items":["Safety Data Analytics","Excel","SQL","Power BI","Statistics","AI/NLP","Automated Safety-Data Workflows"],"sep":"+"},{"type":"p","text":"This enables progression from Drug Safety Associate into Senior Safety Associate, Safety Specialist, Safety Scientist, Signal Detection Specialist, PV Quality Specialist, Safety Data Analyst, PV Team Lead, and Pharmacovigilance Manager."}]}]}