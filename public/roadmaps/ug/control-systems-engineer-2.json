pe":"list","items":[{"text":"Temperature sensor"},{"text":"PID controller"},{"text":"Heater"},{"text":"Fan"},{"text":"Data logging"}]},{"type":"h","text":"Project 3 — Industrial Conveyor Automation"},{"type":"p","text":"Implement:"},{"type":"list","items":[{"text":"Sensors"},{"text":"PLC"},{"text":"Motor"},{"text":"Conveyor"},{"text":"Object detection"},{"text":"HMI"}]},{"type":"h","text":"Project 4 — Predictive Maintenance System"},{"type":"p","text":"Use sensor data to identify:"},{"type":"list","items":[{"text":"Abnormal vibration"},{"text":"Temperature anomalies"},{"text":"Equipment degradation"}]},{"type":"h","text":"Project 5 — SCADA-Based Process Monitoring"},{"type":"p","text":"Develop a simulated industrial process with:"},{"type":"list","items":[{"text":"PLC"},{"text":"HMI"},{"text":"SCADA"},{"text":"Alarms"},{"text":"Historian"},{"text":"Dashboard"}]},{"type":"h","text":"Project 6 — Model Predictive Control"},{"type":"list","items":[{"text":"Develop a simulation-based MPC system for a multivariable process."},{"text":"This is particularly suitable for students targeting advanced control/R&D roles."}]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Target internships in:"},{"type":"h","text":"Process Industries"},{"type":"list","items":[{"text":"Oil & gas"},{"text":"Petrochemicals"},{"text":"Chemicals"},{"text":"Pharmaceuticals"},{"text":"Power plants"},{"text":"Steel"},{"text":"Cement"}]},{"type":"h","text":"Discrete Manufacturing"},{"type":"list","items":[{"text":"Automotive"},{"text":"Electronics"},{"text":"Consumer goods"},{"text":"Industrial machinery"}]},{"type":"h","text":"Automation Companies"},{"type":"p","text":"Look for exposure to:"},{"type":"list","items":[{"text":"PLC"},{"text":"SCADA"},{"text":"DCS"},{"text":"HMI"},{"text":"Industrial robotics"},{"text":"Industrial networking"},{"text":"Control panels"}]},{"type":"h","text":"Internship Responsibilities"},{"type":"p","text":"Prioritize hands-on exposure 