 route:"},{"type":"h","text":"Ward Coordinator"},{"type":"h","text":"Healthcare Operations Analyst"},{"type":"h","text":"Healthcare Data Analyst"},{"type":"h","text":"Senior Healthcare Analyst"},{"type":"h","text":"Healthcare Operations Manager"},{"type":"h","text":"Healthcare Analytics / Strategy Lead"},{"type":"h","text":"Emerging Technologies"},{"type":"h","text":"AI in Hospital Operations"},{"type":"h","text":"AI can support:"},{"type":"list","items":[{"text":"Patient-flow prediction"},{"text":"Bed-demand forecasting"},{"text":"Discharge planning"},{"text":"Appointment optimization"},{"text":"Operational alerts"}]},{"type":"h","text":"Hospital Analytics"},{"type":"p","text":"Modern hospitals increasingly use analytics for:"},{"type":"list","items":[{"text":"Bed occupancy"},{"text":"Length of stay"},{"text":"Patient throughput"},{"text":"Resource utilization"},{"text":"Readmission analysis"},{"text":"Quality indicators"}]},{"type":"h","text":"Electronic Health Records"},{"type":"h","text":"Professionals should understand how:"},{"type":"list","items":[{"text":"EMR/EHR"},{"text":"HIS/HMIS"},{"text":"Laboratory Information Systems"},{"text":"Radiology Information Systems"}]},{"type":"p","text":"connect across hospital operations."},{"type":"h","text":"Digital Health"},{"type":"h","text":"Knowledge of:"},{"type":"list","items":[{"text":"Telemedicine"},{"text":"Digital patient engagement"},{"text":"Remote monitoring"},{"text":"Health information exchange"},{"text":"Interoperability"}]},{"type":"p","text":"can create additional career opportunities."},{"type":"h","text":"Future-Ready Skill Stack"},{"type":"h","text":"Healthcare Knowledge"},{"type":"h","text":"+"},{"type":"h","text":"Hospital Operations"},{"type":"h","text":"+"},{"type":"h","text":"Patient Coordination"},{"type":"h","text":"+"},{"type":"h","text":"Medical Documentation"},{"type":"h","text":"+"},{"type":"h","text":"HIS / EMR"},{"type":"h","text":"+"},{"type":"h","text":"Excel"},{"type":"h","text":"+"},{