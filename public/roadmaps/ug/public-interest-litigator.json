tems":[{"text":"Background"},{"text":"Petition"},{"text":"Legal grounds"},{"text":"Evidence"},{"text":"Court reasoning"},{"text":"Final directions"},{"text":"Implementation"},{"text":"Long-term impact"}]},{"type":"h","text":"Project 3 — Legal Research Report"},{"type":"p","text":"Choose a public issue and prepare:"},{"type":"list","items":[{"text":"Problem statement"},{"text":"Applicable law"},{"text":"Existing policy"},{"text":"Evidence"},{"text":"Stakeholders"},{"text":"Legal remedies"},{"text":"Recommendations"}]},{"type":"h","text":"Project 4 — Writ Draft"},{"type":"p","text":"Prepare a hypothetical writ petition involving:"},{"type":"list","items":[{"text":"Public authority action"},{"text":"Constitutional rights"},{"text":"Administrative decision"},{"text":"Public-interest issue"}]}]},{"heading":"Technology Skills","kind":"other","blocks":[{"type":"p","text":"A modern public-interest lawyer should know:"},{"type":"table","header":["Area","Skills"],"rows":[[{"text":"Legal Research"},{"text":"Legal databases"}],[{"text":"Drafting"},{"text":"MS Word"}],[{"text":"Data"},{"text":"Excel"}],[{"text":"Evidence"},{"text":"Digital document management"}],[{"text":"Research"},{"text":"Reference-management tools"}],[{"text":"Visualization"},{"text":"Power BI basics"}],[{"text":"Collaboration"},{"text":"Cloud documents"}],[{"text":"Public Data"},{"text":"Government/open-data research"}],[{"text":"AI"},{"text":"Legal research assistance"}]]}]},{"heading":"AI in Public-Interest Litigation","kind":"other","blocks":[{"type":"p","text":"AI can assist with:"},{"type":"list","items":[{"text":"Large-document review"},{"text":"Case-law organization"},{"text":"Legal research"},{"text":"Chronology creation"},{"text":"Statutory comparison"},{"text":"Evidence indexing"},{"text":"Research summarization"},{"text":"Drafting outlines"},{"text":"Public-data analysis"}]},{"type":"p","text":"But public-interest litigation often involves sensitive personal information and vulnerable communities."},{"type":"p","text":"Therefore:"},{"type":"flow","items":["AI Assistance","Privacy Check","Source Verification","Legal Verification","Human Review","Final Legal Work"]},{"type":"p","text":"Never rely on AI-generated authorities without checking the actual judgment or statute."}]},{"heading":"Certifications & Additional Learning","kind":"certifications","blocks":[{"type":"p","text":"Useful areas include:"},{"type":"h","text":"Constitutional"},{"type":"list","items":[{"text":"Constitutional law"},{"text":"Human rights"},{"text":"Administrative law"},{"text":"Judicial review"}]},{"type":"h","text":"Public Interest"},{"type":"list","items":[{"text":"Environmental law"},{"text":"Disability rights"},{"text":"Child rights"},{"text":"Gender justice"},{"text":"Social justice"}]},{"type":"h","text":"Litigation"},{"type":"list","items":[{"text":"Legal drafting"},{"text":"Trial advocacy"},{"text":"Writ practice"},{"text":"Legal research"}]},{"type":"h","text":"Policy"},{"type":"list","items":[{"text":"Public policy"},{"text":"Governance"},{"text":"Legislative research"},{"text":"Public administration"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Legal technology"},{"text":"Data analysis"},{"text":"Digital evidence"},{"text":"AI-assisted research"}]},{"type":"p","text":"Certificates are supplementary; actual research, legal writing and litigation exposure carry greater practical value."}]},{"heading":"PG Options","kind":"pg_india","blocks":[{"type":"p","text":"Possible postgraduate pathways include:"},{"type":"p","text":"LL.M."},{"type":"list","items":[{"text":"Constitutional Law"},{"text":"Human Rights Law"},{"text":"Public Law"},{"text":"Administrative Law"},{"text":"Environmental Law"},{"text":"International Law"}]},{"type":"h","text":"Public Policy"},{"type":"list","items":[{"text":"M.A. Public Policy"},{"text":"Public Administration"},{"text":"Governance"}]},{"type":"h","text":"Social Sector"},{"type":"list","items":[{"text":"Social Work"},{"text":"Development Studies"},{"text":"Human Rights"}]},{"type":"h","text":"Research"},{"type":"list","items":[{"text":"LL.M."},{"text":"Ph.D. in Law"}]},{"type":"p","text":"For someone targeting high-level constitutional/public-law practice, an LL.M. can provide useful specialization, but strong litigation experience remains essential."}]},{"heading":"Career Specializations","kind":"other","blocks":[{"type":"p","text":"A Public Interest Litigator can specialize in:"},{"type":"h","text":"1. Constitutional Litigation"},{"type":"p","text":"Fundamental rights and constitutional challenges."},{"type":"h","text":"2. Human Rights"},{"type":"p","text":"Rights of vulnerable populations."},{"type":"h","text":"3. Environmental Litigation"},{"type":"p","text":"Environmental protection and regulatory compliance."},{"type":"h","text":"4. Disability Rights"},{"type":"p","text":"Accessibility and equal participation."},{"type":"h","text":"5. Child Rights"},{"type":"p","text":"Education, protection and welfare."},{"type":"h","text":"6. Gender Justice"},{"type":"p","text":"Equality and protection from discrimination/violence."},{"type":"h","text":"7. Administrative Law"},{"type":"p","text":"Government decision-making and public accountability."},{"type":"h","text":"8. Prison & Criminal Justice Reform"},{"type":"p","text":"Rights, detention and criminal-justice administration."},{"type":"h","text":"9. Education Law"},{"type":"p","text":"Access, equality and education policy."},{"type":"h","text":"10. Public Health Law"},{"type":"p","text":"Legal and policy issues affecting public health."}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"flow","items":["LL.B.","Legal Aid / NGO / Litigation Intern","Junior Litigation Associate","Constitutional / Civil Litigator","Public Interest Litigator","Senior Public Interest Counsel","Constitutional / Public Law Specialist","Senior Counsel / Public Law Practice Leader"]},{"type":"p","text":"Alternative:"},{"type":"flow","items":["LL.