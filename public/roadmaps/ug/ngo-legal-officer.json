:"Displacement"},{"text":"Environmental justice"},{"text":"Service-access mapping"},{"text":"Humanitarian programs"}]}]},{"heading":"Human Rights & Technology","kind":"other","blocks":[{"type":"p","text":"Technology is becoming increasingly important to human-rights work."},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Digital privacy"},{"text":"Surveillance"},{"text":"Online harassment"},{"text":"Digital identity"},{"text":"Internet access"},{"text":"Online censorship"},{"text":"Digital evidence"},{"text":"AI and human rights"},{"text":"Algorithmic discrimination"}]},{"type":"h","text":"AI & Human Rights"},{"type":"p","text":"Potential issues include:"},{"type":"list","items":[{"text":"Bias"},{"text":"Discrimination"},{"text":"Privacy"},{"text":"Automated decision-making"},{"text":"Transparency"},{"text":"Accountability"},{"text":"Access to remedy"},{"text":"A Legal Officer should be able to identify these risks and research applicable legal frameworks."}]}]},{"heading":"Certifications & Additional Learning","kind":"certifications","blocks":[{"type":"p","text":"Useful areas include:"},{"type":"h","text":"Human Rights"},{"type":"list","items":[{"text":"Human-rights law"},{"text":"International human-rights law"},{"text":"Child rights"},{"text":"Gender justice"},{"text":"Disability rights"}]},{"type":"h","text":"Legal"},{"type":"list","items":[{"text":"Constitutional law"},{"text":"Public interest litigation"},{"text":"Legal aid"},{"text":"Legal drafting"},{"text":"Policy research"}]},{"type":"h","text":"Development"},{"type":"list","items":[{"text":"NGO management"},{"text":"Monitoring & evaluation"},{"text":"Project management"},{"text":"Development studies"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Data protection"},{"text":"Digital rights"},{"text":"Technology and human rights"},{"text":"GIS fundamentals"},{"text":"Certificates should supplement real field experience, legal research and community work."}]}]},{"heading"