ch"},{"text":"Case analysis"},{"text":"Legal drafting"},{"text":"Client interviewing"},{"text":"Legal-aid coordination"},{"text":"Rights documentation"},{"text":"Policy research"},{"text":"Advocacy"}]},{"type":"h","text":"Field Experience"},{"type":"p","text":"Ideally:"},{"type":"list","items":[{"text":"NGO internship"},{"text":"Legal-aid camp"},{"text":"Community project"},{"text":"Human-rights research project"},{"text":"Public-interest litigation exposure"},{"text":"Policy-writing project"}]},{"type":"h","text":"Digital Skills"},{"type":"list","items":[{"text":"Excel"},{"text":"Power BI basics"},{"text":"Digital data collection"},{"text":"Document management"},{"text":"Online legal research"}]}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"list","items":[{"text":"Integrated Law Degree"},{"text":"+"},{"text":"Constitutional Law"},{"text":"+"},{"text":"Human Rights Law"},{"text":"+"},{"text":"Public Interest Law"},{"text":"+"},{"text":"Legal Research"},{"text":"+"},{"text":"Legal Drafting"},{"text":"+"},{"text":"Legal Aid"},{"text":"+"},{"text":"Community Engagement"},{"text":"+"},{"text":"Human Rights Documentation"},{"text":"+"},{"text":"Policy Research"},{"text":"+"},{"text":"Advocacy"},{"text":"+"},{"text":"NGO Compliance"},{"text":"+"},{"text":"Data / Impact Reporting"},{"text":"+"},{"text":"Digital Rights Awareness"},{"text":"+"},{"text":"Field Internship"}]}]},{"heading":"Best Overall Positioning","kind":"other","blocks":[{"type":"flow","items":["Integrated Law Degree","Constitutional & Human Rights Law","Legal-Aid / NGO Internship","Legal Research + Community Work","Legal Associate / Program Associate","NGO Legal Officer","Senior Legal Officer","Legal & Policy Manager","Legal/Advocacy Director"]},{"type":"p","text":"The strongest candidate combines legal knowledge with field sensitivity and policy thinking. An NGO Legal Officer should be able to take a real community problem, identify the affected rights, research the applic