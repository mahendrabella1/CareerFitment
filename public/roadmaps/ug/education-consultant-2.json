:"h","text":"Language & Literacy"},{"type":"h","text":"Assessment & Evaluation"},{"type":"h","text":"Teacher Development"},{"type":"h","text":"School Improvement"},{"type":"h","text":"EdTech Consulting"},{"type":"h","text":"Learning Analytics"},{"type":"h","text":"Inclusive Education"},{"type":"h","text":"Education Research"},{"type":"h","text":"Education Policy"},{"type":"h","text":"Learning Experience Design"},{"type":"h","text":"AI in Education"},{"type":"h","text":"Education Program Management"}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"flow","items":["Integrated Teacher Education Graduate","Teacher / Academic Associate","Curriculum / Academic Specialist","Academic Coordinator","Education Program Specialist","Education Consultant","Senior Education Consultant","Education Strategy Consultant","Education Program Director / Education Strategist"]},{"type":"h","text":"EdTech Path"},{"type":"flow","items":["Education Graduate","EdTech Academic Associate","Implementation Specialist","Learning Program Manager","EdTech Education Consultant","Education Technology Strategist"]},{"type":"h","text":"Emerging Technologies to Learn"},{"type":"p","text":"Future-focused Education Consultants should understand:"},{"type":"list","items":[{"text":"Generative AI"},{"text":"AI tutoring"},{"text":"Adaptive learning"},{"text":"Learning analytics"},{"text":"Automated assessment"},{"text":"AR/VR education"},{"text":"Gamification"},{"text":"Learning Experience Platforms"},{"text":"AI curriculum assistants"},{"text":"Educational chatbots"},{"text":"Digital credentials"},{"text":"Accessibility technology"},{"text":"AI-powered teacher assistants"}]},{"type":"p","text":"The strongest future profile is:"},{"type":"flow","items":["Pedagogy","Subject Expertise","Curriculum","Data","AI","Consulting"],"sep":"+"},{"type":"h","text":"Recommended Final Skill Stack"},{"type":"h","text":"Education Foundation"},{"type":"list","items":[{"text":"Integrated Teacher Education"},{"text":"+"},{"text":"Subject Expertise"},{"text":"+"},{"text":"Educational Psychology"},{"text":"+"},{"text":"Pedagogy"},{"text":"+"},{"text":"Assessment"}]},{"type":"h","text":"Consulting"},{"type":"list","items":[{"text":"Problem Identification"},{"text":"+"},{"text":"Research"},{"text":"+"},{"text":"Data Analysis"},{"text":"+"},{"text":"Solution Design"},{"text":"+"},{"text":"Implementation"},{"text":"+"},{"text":"Impact Measurement"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Excel"},{"text":"+"},{"text":"Power BI"},{"text":"+"},{"text":"LMS"},{"text":"+"},{"text":"EdTech"},{"text":"+"},{"text":"Generative AI"}]},{"type":"h","text":"Leadership"},{"type":"list","items":[{"text":"Communication"},{"text":"+"},{"text":"Presentation"},{"text":"+"},{"text":"Teacher Training"},{"text":"+"},{"text":"Stakeholder Management"},{"text":"+"},{"text":"Project Management"}]},{"type":"h","text":"Target Profile by Graduation"},{"type":"p","text":"By graduation, the student should ideally demonstrate:"},{"type":"list","items":[{"text":"Strong subject knowledge"},{"text":"Strong pedagogical foundation"},{"text":"Classroom teaching capability"},{"text":"Curriculum-design fundamentals"},{"text":"Assessment-design capability"},{"text":"Educational research skills"},{"text":"Teacher-training presentation ability"},{"text":"Educational technology familiarity"},{"text":"Excel and basic Power BI"},{"text":"AI literacy"},{"text":"Academic report-writing ability"},{"text":"Stakeholder communication"},{"text":"Education project experience"},{"text":"Problem-solving and consulting mindset"}]},{"type":"h","text":"Recommended Portfolio"},{"type":"list","items":[{"text":"5+ Lesson Plans"},{"text":"+"},{"text":"2 Curriculum Maps"},{"text":"+"},{"text":"2 Assessment / Rubric Samples"},{"text":"+"},{"text":"1 Educational Research Project"},{"text":"+"},{"text":"1 Learning Analytics Dashboard"},{"text":"+"},{"text":"1 Teacher Training Workshop"},{"text":"+"},{"text":"1 EdTech Implementation Project"},{"text":"+"},{"text":"1 AI-in-Education Project"},{"text":"+"},{"text":"1 School / Education Internship"}]},{"type":"h","text":"Best Overall Positioning"},{"type":"p","text":"For Education Consultant, the strongest positioning for an Integrated Teacher Education graduate is:"},{"type":"flow","items":["Subject Expertise","Pedagogy","Curriculum Design","Assessment","Teacher Development","Education Analytics","EdTech","AI"],"sep":"+"},{"type":"p","text":"This creates a strong pathway from teacher → academic specialist → coordinator → consultant → education strategist, while allowing the graduate to work across schools, EdTech companies, curriculum organizations, education consultancies, NGOs, assessment organizations, and education-focused programs."}]}]}