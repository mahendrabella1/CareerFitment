ring"},{"text":"Capacity monitoring"},{"text":"Log monitoring"},{"text":"Alert management"}]},{"type":"p","text":"Tools/platforms to gain exposure to:"},{"type":"list","items":[{"text":"Zabbix"},{"text":"Nagios"},{"text":"PRTG"},{"text":"SolarWinds"},{"text":"Grafana"},{"text":"Prometheus"},{"text":"ELK/OpenSearch-style logging platforms"},{"text":"The exact monitoring platform varies by employer."}]}]},{"heading":"Incident Management","kind":"other","blocks":[{"type":"p","text":"NOC engineers need operational discipline as much as technical knowledge."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Incident management"},{"text":"Problem management"},{"text":"Change management"},{"text":"Escalation procedures"},{"text":"Incident prioritization"},{"text":"SLA management"},{"text":"Service restoration"},{"text":"Root-cause analysis"},{"text":"Incident documentation"}]},{"type":"p","text":"Understand:"},{"type":"h","text":"Severity"},{"type":"list","items":[{"text":"Critical → Immediate response"},{"text":"High → Rapid escalation"},{"text":"Medium → Standard response"},{"text":"Low → Scheduled resolution"},{"text":"Actual severity definitions depend on the organization's SLA."}]}]},{"heading":"Linux & System Administration","kind":"other","blocks":[{"type":"p","text":"Linux is highly valuable for NOC and infrastructure roles."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Linux filesystem"},{"text":"Processes"},{"text":"Services"},{"text":"Permissions"},{"text":"Users/groups"},{"text":"SSH"},{"text":"Networking commands"},{"text":"Logs"},{"text":"Package management"},{"text":"System monitoring"},{"text":"Cron"},{"text":"Bash scripting"}]},{"type":"p","text":"Important commands:"},{"type":"list","items":[{"text":"ping"},{"text":"traceroute"},{"text":"ip"},{"text":"ss"},{"text":"netstat"},{"text":"nslookup"},{"text":"dig"},{"text":"curl"},{"text":"wget"},{"text":"tcpdump"},{"text":"grep"},{"text":"top"},{"text":"htop"},{"text":"df"},{"tex