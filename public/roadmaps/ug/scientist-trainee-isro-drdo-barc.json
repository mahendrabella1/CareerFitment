":[{"text":"Data cleaning"},{"text":"Time-series analysis"},{"text":"Visualization"},{"text":"Statistical analysis"},{"text":"Anomaly detection"}]},{"type":"h","text":"Project 3 — Digital Spectrometer/Data Analysis System"},{"type":"p","text":"Create a system that processes spectral measurements and identifies peaks."},{"type":"p","text":"Skills:"},{"type":"list","items":[{"text":"Signal processing"},{"text":"Fourier analysis"},{"text":"Peak detection"},{"text":"Scientific visualization"},{"text":"Python"}]},{"type":"h","text":"Project 4 — Radiation Detector Simulation"},{"type":"p","text":"Simulate radiation detection and counting statistics."},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Poisson statistics"},{"text":"Detector response"},{"text":"Background radiation"},{"text":"Signal-to-noise ratio"},{"text":"Statistical uncertainty"}]},{"type":"h","text":"Project 5 — Computational Physics Research Project"},{"type":"p","text":"Choose one:"},{"type":"list","items":[{"text":"Quantum tunnelling simulation"},{"text":"N-body simulation"},{"text":"Heat-transfer modelling"},{"text":"Fluid-flow simulation"},{"text":"Plasma simulation"},{"text":"Semiconductor modelling"},{"text":"Monte Carlo particle simulation"}]},{"type":"flow","items":["code","scientific methodology","results","technical report."],"sep":"+","label":"The final output should include"}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"During B.Sc, target research-oriented internships rather than generic internships."},{"type":"p","text":"Look for opportunities involving:"},{"type":"list","items":[{"text":"Space science"},{"text":"Astronomy"},{"text":"Nuclear science"},{"text":"Materials research"},{"text":"Semiconductor physics"},{"text":"Electronics"},{"text":"Photonics"},{"text":"Computational physics"},{"text":"Atmospheric science"},{"text":"Scientific instrumentation"}]},{"type":"p","text":"Potential ecosystems include:"},{"type":"list","items":[{