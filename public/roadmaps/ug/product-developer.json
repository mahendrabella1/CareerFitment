:"Marker/quality parameters"}]}]},{"heading":"Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Skill","Importance","Graduation Target"],"rows":[[{"text":"Cosmetic formulation"},{"text":"★★★★★"},{"text":"Advanced"}],[{"text":"Cosmetic chemistry"},{"text":"★★★★★"},{"text":"Strong"}],[{"text":"Pharmaceutics"},{"text":"★★★★★"},{"text":"Strong"}],[{"text":"Ingredient functionality"},{"text":"★★★★★"},{"text":"Advanced"}],[{"text":"Emulsion technology"},{"text":"★★★★★"},{"text":"Advanced"}],[{"text":"Surfactant systems"},{"text":"★★★★☆"},{"text":"Strong"}],[{"text":"Stability testing"},{"text":"★★★★★"},{"text":"Strong"}],[{"text":"Preservation"},{"text":"★★★★☆"},{"text":"Strong"}],[{"text":"Sensory evaluation"},{"text":"★★★★☆"},{"text":"Strong"}],[{"text":"Packaging compatibility"},{"text":"★★★★☆"},{"text":"Intermediate"}],[{"text":"Scale-up"},{"text":"★★★★☆"},{"text":"Intermediate"}],[{"text":"Quality control"},{"text":"★★★★☆"},{"text":"Strong"}],[{"text":"GMP"},{"text":"★★★★☆"},{"text":"Strong"}],[{"text":"Regulatory awareness"},{"text":"★★★★☆"},{"text":"Strong"}],[{"text":"Excel"},{"text":"★★★☆☆"},{"text":"Strong"}],[{"text":"Technical writing"},{"text":"★★★★☆"},{"text":"Strong"}]]}]},{"heading":"Digital & Technical Skills","kind":"other","blocks":[{"type":"h","text":"Essential"},{"type":"list","items":[{"text":"Microsoft Excel"},{"text":"Word"},{"text":"PowerPoint"},{"text":"Basic statistics"},{"text":"Technical documentation"}]},{"type":"h","text":"Useful"},{"type":"list","items":[{"text":"JMP"},{"text":"Minitab"},{"text":"Design of Experiments"},{"text":"LIMS"},{"text":"ERP systems"},{"text":"QMS"}]},{"type":"h","text":"Product-development analytics"},{"type":"p","text":"Use Excel/statistical tools for:"},{"type":"list","items":[{"text":"Stability trends"},{"text":"Formulation comparison"},{"text":"Ingredient optimization"},{"text":"Experimental design"},{"text":"Cost analysis"},{"text":"Quality trends"}]}]},{"heading":"Internship Strategy","kind":"i