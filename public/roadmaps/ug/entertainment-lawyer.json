n agreement"}]},{"type":"h","text":"Project 2 — Copyright Audit"},{"type":"p","text":"Select a fictional film and identify:"},{"type":"list","items":[{"text":"Story rights"},{"text":"Music rights"},{"text":"Image rights"},{"text":"Character rights"},{"text":"Trademark concerns"},{"text":"Third-party content"}]},{"type":"h","text":"Project 3 — OTT Licensing Analysis"},{"type":"p","text":"Prepare a sample OTT licensing agreement and identify:"},{"type":"list","items":[{"text":"Territory"},{"text":"Duration"},{"text":"Exclusivity"},{"text":"Revenue"},{"text":"Platform rights"},{"text":"Promotional rights"},{"text":"Termination"}]},{"type":"h","text":"Project 4 — Influencer Contract"},{"type":"p","text":"Create a professional influencer-brand agreement covering:"},{"type":"list","items":[{"text":"Deliverables"},{"text":"Payment"},{"text":"Usage rights"},{"text":"Exclusivity"},{"text":"Content ownership"},{"text":"Disclosure"},{"text":"Termination"}]},{"type":"h","text":"Project 5 — AI & Celebrity Rights"},{"type":"p","text":"Prepare a research paper on:"},{"type":"h","text":"“Legal Challenges of AI-Generated Digital Replicas of Actors and Public Figures.”"}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Prioritize internships with:"},{"type":"h","text":"Tier 1"},{"type":"list","items":[{"text":"Media & entertainment law firms"},{"text":"IP law firms"},{"text":"Corporate law firms with media clients"}]},{"type":"h","text":"Tier 2"},{"type":"list","items":[{"text":"Production houses"},{"text":"OTT companies"},{"text":"Music companies"},{"text":"Talent management agencies"},{"text":"Broadcasting companies"}]},{"type":"h","text":"Tier 3"},{"type":"list","items":[{"text":"Advertising agencies"},{"text":"Digital media companies"},{"text":"Creator-management companies"},{"text":"Film-production companies"}]},{"type":"h","text":"Internship progression"},{"type":"p","text":"Year 1"},{"type":"flow","items":["Legal Research Internship","Year 