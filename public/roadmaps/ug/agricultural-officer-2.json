ulatory knowledge"},{"text":"Recruitment qualification"}],[{"text":"Horticulture Officer"},{"text":"Horticulture + crop management"},{"text":"Horticulture knowledge"}],[{"text":"Soil Conservation Officer"},{"text":"Soil + water conservation"},{"text":"Soil/water project"}],[{"text":"Agricultural Research Assistant"},{"text":"Research + field/lab skills"},{"text":"Research internship"}],[{"text":"Agricultural Field Officer"},{"text":"Crops + farmer interaction"},{"text":"Field experience"}],[{"text":"Agri-Input Technical Officer"},{"text":"Crop protection + inputs"},{"text":"Product/crop knowledge"}]]},{"type":"h","text":"Adjacent careers"},{"type":"list","items":[{"text":"Agronomist"},{"text":"Crop Advisor"},{"text":"Soil Analyst"},{"text":"Plant Protection Officer"},{"text":"Agricultural Consultant"},{"text":"Agri-Tech Analyst"},{"text":"Precision Agriculture Analyst"},{"text":"GIS Agriculture Analyst"},{"text":"Farm Manager"},{"text":"Agricultural Marketing Executive"},{"text":"Rural Development Officer"},{"text":"Agri-Finance Officer"},{"text":"Agricultural Data Analyst"},{"text":"Seed Production Officer"},{"text":"Quality Control Executive"},{"text":"Food Supply-Chain Analyst"}]}]},{"heading":"Postgraduate study in India","kind":"pg_india","blocks":[{"type":"table","header":["Route","Entrance / route","Examples","Focus"],"rows":[[{"text":"M.Sc Agriculture"},{"text":"University-specific / relevant entrance"},{"text":"State Agricultural Universities"},{"text":"Advanced agriculture"}],[{"text":"M.Sc Agronomy"},{"text":"University-specific"},{"text":"Agricultural universities"},{"text":"Crop production"}],[{"text":"M.Sc Soil Science"},{"text":"University-specific"},{"text":"Agricultural universities"},{"text":"Soil/water"}],[{"text":"M.Sc Horticulture"},{"text":"University-specific"},{"text":"Agricultural universities"},{"text":"Horticultural crops"}],[{"text":"M.Sc Agricultural Economics"},{"text":"University-specific"},{"text":"Agricultural universities"},{"text":