{"title":"Career Roadmap: Correspondent","role":"Correspondent","summary":"Career Domain: Media, Communication, Arts & Design · Qualification Pathway: BJMC / B.A. Journalism & Mass Communication – Print & Digital Journalism · Target Career: Correspondent","facts":{"Current degree":"BJMC / B.A. Journalism & Mass Communication","Course":"Print & Digital Journalism"},"about":[{"label":"About this roadmap","text":"This roadmap was drafted with AI assistance from OneGrasp's related roadmaps and is awaiting expert review. Check fees, dates, eligibility and exam patterns on the official websites before you rely on them."}],"intro":[],"horizons":[],"sections":[{"heading":"Career Overview","kind":"other","blocks":[{"type":"p","text":"A Correspondent reports on a beat or region - politics, courts, business, health, a state or a country - building sources and breaking stories."},{"type":"h","text":"What a Correspondent does"},{"type":"list","items":[{"text":"Cover a beat or region"},{"text":"Build and protect sources"},{"text":"Report, write and file stories"},{"text":"Verify facts and follow up"}]},{"type":"p","text":"Where they work:"},{"type":"list","items":[{"text":"Newspapers"},{"text":"TV channels"},{"text":"News agencies"},{"text":"Digital media"}]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Career stage","Typical role"],"rows":[[{"text":"Entry-level"},{"text":"Reporter"}],[{"text":"Early career"},{"text":"Correspondent"}],[{"text":"Mid-level"},{"text":"Senior / Special Correspondent"}],[{"text":"Senior"},{"text":"Bureau Chief"}],[{"text":"Leadership"},{"text":"Editor"}]]}]},{"heading":"Year-by-Year Learning Roadmap","kind":"build","blocks":[{"type":"h","text":"Year 1: News basics"},{"type":"list","items":[{"text":"Reporting and writing"},{"text":"Pick a beat you love and read deeply on it"},{"text":"Learn shorthand or fast note-taking"}]},{"type":"h","text":"Year 2: Reporting craft"},{"type":"list","items":[{"text":"Learn interviewing and RTI"},{"text":"Learn media law"},{"text":"Report local stories for college media"}]},{"type":"h","text":"Year 3: Field experience"},{"type":"list","items":[{"text":"Intern as a reporter"},{"text":"File stories regularly"},{"text":"Build a contacts book"}]}]},{"heading":"Essential Skills","kind":"build","blocks":[{"type":"table","header":["Skill","Type"],"rows":[[{"text":"Reporting and interviewing"},{"text":"Technical"}],[{"text":"RTI and documents"},{"text":"Technical"}],[{"text":"Beat knowledge"},{"text":"Technical"}],[{"text":"Media law"},{"text":"Technical"}],[{"text":"Source-building"},{"text":"Professional"}],[{"text":"Persistence"},{"text":"Professional"}],[{"text":"Integrity"},{"text":"Professional"}]]}]},{"heading":"Tools and Technologies to Learn","kind":"build","blocks":[{"type":"list","items":[{"text":"Recorder"},{"text":"CMS"},{"text":"Spreadsheets"},{"text":"Secure messaging"}]}]},{"heading":"Internships and Practical Experience","kind":"internships","blocks":[{"type":"list","items":[{"text":"Newspapers"},{"text":"Agencies"},{"text":"Digital newsrooms"}]}]},{"heading":"Certifications and Additional Training","kind":"certifications","blocks":[{"type":"list","items":[{"text":"Investigative reporting workshops"},{"text":"Data journalism courses"}]},{"type":"note","label":"Before you enrol","text":"Check the current syllabus, fees and eligibility on the certifying body's official website."}]},{"heading":"Higher Education Options in India","kind":"pg_india","blocks":[{"type":"p","text":"Options after your degree:"},{"type":"list","items":[{"text":"PG Diploma in Journalism"},{"text":"MA in a beat subject (economics, law, politics)"}]},{"type":"p","text":"Entrance exams and tests to know:"},{"type":"list","items":[{"text":"IIMC entrance"},{"text":"CUET-PG"}]}]},{"heading":"Study Abroad Options","kind":"abroad","blocks":[{"type":"list","items":[{"text":"MA Journalism (UK, US)"}]}]},{"heading":"Career Opportunities","kind":"careers","blocks":[{"typ