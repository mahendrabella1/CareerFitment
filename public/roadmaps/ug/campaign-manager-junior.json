cs"},{"text":"Data Analytics"},{"text":"Research Methodology"},{"text":"Negotiation"},{"text":"Leadership"},{"text":"Business Communication"}]},{"type":"h","text":"Campaign skills"},{"type":"h","text":"Strategy"},{"type":"list","items":[{"text":"Campaign objectives"},{"text":"Audience segmentation"},{"text":"Issue mapping"},{"text":"Stakeholder mapping"},{"text":"Constituency analysis"},{"text":"Competitor/opponent analysis"},{"text":"Campaign messaging"},{"text":"Ground strategy"},{"text":"Volunteer strategy"},{"text":"Campaign calendars"},{"text":"Resource allocation"}]},{"type":"h","text":"Research"},{"type":"list","items":[{"text":"Survey design"},{"text":"Public-opinion research"},{"text":"Focus groups"},{"text":"Qualitative interviews"},{"text":"Secondary research"},{"text":"Poll interpretation"},{"text":"Demographic analysis"},{"text":"Constituency-level research"},{"text":"Policy research"}]},{"type":"h","text":"Communications"},{"type":"list","items":[{"text":"Speech/message development"},{"text":"Press releases"},{"text":"Social-media content"},{"text":"Public communication"},{"text":"Media relations"},{"text":"Event communication"},{"text":"Crisis communication"},{"text":"Campaign branding"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Social media"},{"text":"Content calendars"},{"text":"Digital advertising concepts"},{"text":"Web analytics"},{"text":"Audience analytics"},{"text":"Email/CRM concepts"},{"text":"Social listening"},{"text":"Dashboarding"}]},{"type":"h","text":"Data"},{"type":"list","items":[{"text":"Excel"},{"text":"SQL basics"},{"text":"Power BI"},{"text":"Statistics"},{"text":"Survey analysis"},{"text":"GIS basics"},{"text":"Data visualisation"},{"text":"Python/R basics"}]},{"type":"p","text":"Use political and voter data only where collection, processing and use are lawful and authorised. Avoid exposing personal or sensitive voter information."},{"type":"h","text":"Portfolio target"},{"type":"p","text":"Build 6–8 proje