ue Media Analysis"},{"type":"p","text":"Analyse media coverage of a public issue."},{"type":"p","text":"Measure:"},{"type":"list","items":[{"text":"Frequency"},{"text":"Framing"},{"text":"Themes"},{"text":"Sources"},{"text":"Sentiment"},{"text":"Narrative differences"}]},{"type":"p","text":"Maintain clear separation between describing media coverage and asserting that the coverage itself proves the underlying claim."},{"type":"h","text":"Project 4 — Brand Reputation Monitoring"},{"type":"p","text":"Build a hypothetical media-intelligence system:"},{"type":"flow","items":["Media Sources","Data Collection","Classification","Sentiment","Topic Analysis","Dashboard","Executive Report"]},{"type":"h","text":"Media Analysis Workflow"},{"type":"p","text":"A professional Media Analyst should understand:"},{"type":"h","text":"Define Monitoring Objective"},{"type":"h","text":"Identify Relevant Sources"},{"type":"h","text":"Collect Media Data"},{"type":"h","text":"Clean & Classify"},{"type":"h","text":"Analyse Topics & Sentiment"},{"type":"h","text":"Identify Trends"},{"type":"h","text":"Compare Competitors/Narratives"},{"type":"h","text":"Interpret Findings"},{"type":"h","text":"Build Dashboard"},{"type":"h","text":"Prepare Executive Brief"},{"type":"h","text":"Recommend Action"}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Internships should provide exposure to real media data."},{"type":"h","text":"Media Organisations"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Media Research Intern"},{"text":"Audience Research Intern"},{"text":"Digital Media Intern"},{"text":"Data Research Intern"}]},{"type":"h","text":"PR & Communications Agencies"},{"type":"p","text":"Potential roles:"},{"type":"list","items":[{"text":"Media Monitoring Intern"},{"text":"Communications Research Intern"},{"text":"Social Listening Intern"},{"text":"Reputation Intelligence Intern"}]},{"type":"h","text":"Digital Marketing Agencies"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Digital Analytics Intern"},{"text":"Social Media Analytics Intern"},{"text":"Content Analytics Intern"}]},{"type":"h","text":"Market Research Companies"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Research Intern"},{"text":"Consumer Insights Intern"},{"text":"Media Research Intern"},{"text":"Data Analyst Intern"}]},{"type":"h","text":"Corporate Communications"},{"type":"p","text":"Potential areas:"},{"type":"list","items":[{"text":"Corporate communications"},{"text":"Brand reputation"},{"text":"Public affairs"},{"text":"Media intelligence"},{"text":"Crisis communication"}]}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"type":"p","text":"The exact job title varies by employer."},{"type":"p","text":"Possible positions include:"},{"type":"list","items":[{"text":"Media Analyst"},{"text":"Junior Media Analyst"},{"text":"Media Monitoring Analyst"},{"text":"Social Listening Analyst"},{"text":"Media Research Analyst"},{"text":"Digital Media Analyst"},{"text":"Audience Insights Associate"},{"text":"Research Associate"},{"text":"Content Analyst"},{"text":"Communications Analyst"},{"text":"Brand Intelligence Analyst"},{"text":"Reputation Analyst"},{"text":"Digital Insights Analyst"},{"text":"Media Intelligence Associate"},{"text":"Consumer Insights Associate"}]},{"type":"h","text":"Specialisation Options"},{"type":"h","text":"1. Media Intelligence"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"News monitoring"},{"text":"Competitor analysis"},{"text":"Reputation"},{"text":"Public narratives"},{"text":"Executive reporting"}]},{"type":"h","text":"2. Social Listening"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Social conversations"},{"text":"Brand mentions"},{"text":"Sentiment"},{"text":"Influencers"},{"text":"Emerging trends"}]},{"type":"h","text":"3. Audience Analytics"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Audience segmentation"},{"text":"Engagement"},{"text":"Content performance"},{"text":"Behaviour"},{"text":"Conversion"}]},{"type":"h","text":"4. Political & Public Affairs Media Analysis"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Political communication"},{"text":"Public narratives"},{"text":"Policy communication"},{"text":"Reputation"},{"text":"Issue monitoring"}]},{"type":"p","text":"This area requires particularly careful source evaluation and political neutrality."},{"type":"h","text":"5. Brand & Reputation Intelligence"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Brand perception"},{"text":"Competitor monitoring"},{"text":"Crisis detection"},{"text":"Media sentiment"},{"text":"Corporate reputation"}]},{"type":"h","text":"6. AI/NLP Media Analysis"},{"type":"p","text":"Combine:"},{"type":"flow","items":["Humanities","Media","NLP","Data"],"sep":"+"},{"type":"p","text":"Work with:"},{"type":"list","items":[{"text":"Large text collections"},{"text":"Sentiment classification"},{"text":"Topic modelling"},{"text":"Entity extraction"},{"text":"Narrative analysis"},{"text":"Multilingual media analysis"}]},{"type":"p","text":"This is one of the strongest technology-oriented pathways from a Digital Humanities degree."},{"type":"h","text":"Employer Skill Matrix"},{"type":"table","header":["Employer Type","Most Valuable Skills"],"rows":[[{"text":"Media Companies"},{"text":"Audience + content analytics"}],[{"text":"PR Agencies"},{"text":"Media monitoring + reputation"}],[{"text":"Digital Agencies"},{"text":"Social + digital analytics"}],[{"text":"Market Research Firms"},{"text":"Research + statistics"}],[{"text":"Consulting Firms"},{"text":"Analytics + communication"}],[{"text":"Corporate Communications"},{"text":"Reputation + reporting"}],[{"text":"Public Affairs Firms"},{"text":"Issue monitoring + research"}],[{"text":"Advertising Agencies"},{"text":"Audience + campaign analytics"}],[{"text":"Technology Companies"},{"text":"Data + digital m