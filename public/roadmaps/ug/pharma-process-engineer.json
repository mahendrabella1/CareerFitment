text":"Biochemistry"}]},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Reaction kinetics"},{"text":"Equilibrium"},{"text":"Thermodynamics"},{"text":"pH"},{"text":"Solubility"},{"text":"Concentration"},{"text":"Material properties"}]},{"type":"h","text":"Pharmaceutical Fundamentals"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Dosage forms"},{"text":"APIs"},{"text":"Excipients"},{"text":"Drug formulation"},{"text":"Pharmaceutical manufacturing"},{"text":"Basic pharmacology"},{"text":"Drug stability"},{"text":"Drug-product quality"}]},{"type":"h","text":"Engineering Fundamentals"},{"type":"p","text":"Build knowledge in:"},{"type":"list","items":[{"text":"Fluid mechanics"},{"text":"Heat transfer"},{"text":"Mass transfer"},{"text":"Thermodynamics"},{"text":"Process calculations"},{"text":"Engineering mechanics"},{"text":"Material science"}]},{"type":"p","text":"These become the foundation for pharmaceutical manufacturing equipment and processes."},{"type":"h","text":"Year 2 — Process Engineering"},{"type":"h","text":"Material & Energy Balances"},{"type":"p","text":"Learn how to calculate:"},{"type":"list","items":[{"text":"Mass flow"},{"text":"Material balance"},{"text":"Component balance"},{"text":"Energy balance"},{"text":"Yield"},{"text":"Conversion"},{"text":"Losses"}]},{"type":"p","text":"Understand:"},{"type":"flow","items":["Raw Materials","Process","Intermediate","Purification","Final Product","Yield / Quality"]},{"type":"h","text":"Fluid Mechanics"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Flow"},{"text":"Pressure"},{"text":"Pumps"},{"text":"Piping"},{"text":"Valves"},{"text":"Flow meters"},{"text":"Pressure drop"},{"text":"Mixing"}]},{"type":"p","text":"Understand pharmaceutical process systems such as:"},{"type":"list","items":[{"text":"Liquid transfer"},{"text":"CIP systems"},{"text":"Utility distribution"},{"text":"Process piping"}]},{"type":"h","text":"Heat Transfer"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Conduction"},{"text":"Convection"},{"text":"Radiation"},{"text":"Heat exchangers"},{"text":"Heating/cooling systems"},{"text":"Steam"},{"text":"Chilled water"}]},{"type":"p","text":"Applications include:"},{"type":"list","items":[{"text":"Sterilization"},{"text":"Drying"},{"text":"Evaporation"},{"text":"Temperature control"}]},{"type":"h","text":"Mass Transfer"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Diffusion"},{"text":"Absorption"},{"text":"Extraction"},{"text":"Distillation"},{"text":"Drying"},{"text":"Membrane separation"}]},{"type":"p","text":"The exact relevance depends on the pharmaceutical manufacturing process."},{"type":"h","text":"Unit Operations"},{"type":"p","text":"Build strong understanding of:"},{"type":"list","items":[{"text":"Mixing"},{"text":"Filtration"},{"text":"Drying"},{"text":"Granulation"},{"text":"Milling"},{"text":"Compression"},{"text":"Coating"},{"text":"Crystallization"},{"text":"Extraction"},{"text":"Distillation"},{"text":"Separation"}]},{"type":"h","text":"Year 2–3 — Pharmaceutical Manufacturing"},{"type":"h","text":"Solid Dosage Manufacturing"},{"type":"p","text":"Understand the general workflow:"},{"type":"flow","items":["Raw Materials","Dispensing","Blending","Granulation","Drying","Milling","Lubrication","Compression","Coating","Packaging"]},{"type":"p","text":"Study critical process variables such as:"},{"type":"list","items":[{"text":"Mixing time"},{"text":"Moisture"},{"text":"Granulation parameters"},{"text":"Particle size"},{"text":"Compression force"},{"text":"Coating conditions"}]},{"type":"h","text":"Liquid Manufacturing"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Mixing"},{"text":"Dissolution"},{"text":"Homogenization"},{"text":"Filtration"},{"text":"Filling"},{"text":"Packaging"}]},{"type":"p","text":"Monitor:"},{"type":"list","items":[{"text":"pH"},{"text":"Viscosity"},{"text":"Temperature"},{"text":"Concentration"},{"text":"Homogeneity"}]},