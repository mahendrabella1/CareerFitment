sment"},{"text":"Process understanding"}]},{"type":"p","text":"Relationship:"},{"type":"flow","items":["Patient / Product Requirements","QTPP","CQAs","CMAs + CPPs","Process Design","Control Strategy"]},{"type":"h","text":"Process Validation"},{"type":"p","text":"Understand the lifecycle concept:"},{"type":"flow","items":["Process Development","Process Qualification","Continued Process Verification","Ongoing Monitoring","Continuous Improvement"]},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Validation protocols"},{"text":"Acceptance criteria"},{"text":"Sampling plans"},{"text":"Process capability"},{"text":"Continued monitoring"}]},{"type":"p","text":"Exact validation expectations depend on the product, process and applicable regulatory framework."},{"type":"h","text":"Risk Management"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"FMEA"},{"text":"Risk ranking"},{"text":"Root-cause analysis"},{"text":"Fishbone diagrams"},{"text":"5 Whys"},{"text":"Corrective actions"},{"text":"Preventive actions"}]},{"type":"h","text":"Year 3–4 — Process Control & Automation"},{"type":"p","text":"Modern pharmaceutical plants increasingly use automation and digital manufacturing."},{"type":"h","text":"Process Instrumentation"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Temperature sensors"},{"text":"Pressure sensors"},{"text":"Flow meters"},{"text":"Level sensors"},{"text":"pH sensors"},{"text":"Conductivity sensors"},{"text":"Load cells"}]},{"type":"h","text":"Process Control"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Feedback control"},{"text":"Feedforward control"},{"text":"PID control"},{"text":"Process variables"},{"text":"Setpoints"},{"text":"Alarms"},{"text":"Control loops"}]},{"type":"p","text":"Example:"},{"type":"flow","items":["Setpoint","Controller","Control Valve","Process","Sensor","Feedback"]},{"type":"p","text":"└──────────────→ Controller"},{"type":"h","text":"PLC / SCADA"},{"type":"p","text":"Develop basic understanding of:"},{"type":"list","items":[{"text":"PLC"},{"text":"HMI"},{"text":"SCADA"},{"text":"Industrial networks"},{"text":"Alarm management"},{"text":"Data logging"}]},{"type":"h","text":"Distributed Control Systems"},{"type":"p","text":"Understand the role of DCS in:"},{"type":"list","items":[{"text":"Large-scale process plants"},{"text":"Batch manufacturing"},{"text":"Process monitoring"},{"text":"Automated control"}]},{"type":"h","text":"PAT — Process Analytical Technology"},{"type":"p","text":"Learn the concept of real-time process monitoring."},{"type":"p","text":"Potential measurements include:"},{"type":"list","items":[{"text":"Temperature"},{"text":"Moisture"},{"text":"Particle size"},{"text":"Concentration"},{"text":"Chemical composition"}]},{"type":"p","text":"Goal:"},{"type":"flow","items":["Measure Process","Analyze Process","Detect Variation","Control Process","Improve Product Quality"]},{"type":"h","text":"Data Analytics for Pharma Manufacturing"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Excel"},{"text":"Python"},{"text":"Statistics"},{"text":"Power BI"},{"text":"SQL basics"}]},{"type":"p","text":"Analyze:"},{"type":"list","items":[{"text":"Batch data"},{"text":"Process deviations"},{"text":"Yield"},{"text":"Equipment performance"},{"text":"Process capability"},{"text":"Quality trends"}]},{"type":"h","text":"Year 4 — Scale-Up & Technology Transfer"},{"type":"h","text":"Scale-Up"},{"type":"p","text":"Understand the difference between:"},{"type":"list","items":[{"text":"Laboratory scale"},{"text":"Pilot scale"},{"text":"Commercial scale"}]},{"type":"p","text":"Key challenges:"},{"type":"list","items":[{"text":"Mixing"},{"text":"Heat transfer"},{"text":"Mass transfer"},{"text":"Equipment geometry"},{"text":"Residence time"},{"text":"Process variability"}]},{"type":"h","text":"Technology Transfer"},{"type":"p","text":"Understand:"},{"type":"flow","items":["R&D Process","Process Characterization","Technology Tra