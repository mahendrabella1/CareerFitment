":"p","text":"Potential routes include:"},{"type":"list","items":[{"text":"University scholarships"},{"text":"UGC fellowships"},{"text":"Research assistantships"},{"text":"Institution-funded PhD positions"},{"text":"PMRF where the doctoral discipline and programme are eligible"}]},{"type":"p","text":"PMRF","url":"https://www.pmrf.in/"},{"type":"p","text":"Funding amounts and eligibility should be verified for the specific programme and year."}]},{"heading":"Study abroad, country by country","kind":"abroad","blocks":[{"type":"table","header":["Country","Example universities","Relevant areas","Scholarship/funding"],"rows":[[{"text":"USA"},{"text":"Cornell, University of Michigan, University of Minnesota"},{"text":"HRM, Organisational Behaviour, People Analytics"},{"text":"University funding + Fulbright"}],[{"text":"UK"},{"text":"LSE, University of Manchester, King's College London"},{"text":"HRM, Organisational Psychology, Management"},{"text":"University scholarships"}],[{"text":"Germany"},{"text":"University of Mannheim, LMU Munich"},{"text":"Management, Organisational Behaviour, Analytics"},{"text":"DAAD/university funding"}],[{"text":"Canada"},{"text":"University of Toronto, Western, York"},{"text":"HRM, Management, Organisational Behaviour"},{"text":"University scholarships"}],[{"text":"Australia"},{"text":"University of Melbourne, Monash, UNSW"},{"text":"HRM, Management, People Analytics"},{"text":"University scholarships"}],[{"text":"Singapore"},{"text":"NUS, NTU, SMU"},{"text":"Management, Organisational Behaviour, Analytics"},{"text":"University scholarships"}]]},{"type":"p","text":"Programme names and exact specialisations vary, so verify the current programme curriculum."},{"type":"p","text":"Useful official resources:"},{"type":"p","text":"USIEF","url":"https://www.usief.org.in/"},{"type":"p","text":"DAAD India","url":"https://www.daad.in/en/"},{"type":"h","text":"Application profile"},{"type":"p","text":"Build:"},{"type":"list","items":[{"text":"Strong academic record"},{"text":"HR internship"},{"text":"Recruitment/HR operations experience"},{"text":"People analytics project"},{"text":"Leadership/volunteering experience"},{"text":"SOP"},{"text":"LORs"},{"text":"CV"},{"text":"English-language test if required"},{"text":"GMAT/GRE if required"}]},{"type":"p","text":"A strong profile would be:"},{"type":"flow","items":["B.Com HR","HR internship","HR analytics","Power BI","SQL","recruitment experience","leadership/project experience"],"sep":"+"}]},{"heading":"Going forward","kind":"growth","blocks":[{"type":"h","text":"Career progression"},{"type":"flow","items":["B.Com Student","HR Intern","HR Executive Trainee / HR Associate","HR Executive","Senior HR Executive / HR Generalist","Assistant HR Manager / HR Specialist","HR Manager / HR Business Partner","Senior HR Manager","HR Head / People & Culture Leader"]},{"type":"p","text":"Alternative specialist route:"},{"type":"flow","items":["HR Executive","HR Analytics","People Analytics Lead"]},{"type":"p","text":"or"},{"type":"flow","items":["HR Executive","Talent Acquisition","TA Manager","Head of Talent"]},{"type":"p","text":"or"},{"type":"flow","items":["HR Executive","HR Operations","HR Operations Manager","Head of People Operations"]},{"type":"h","text":"PhD routes"},{"type":"h","text":"Human Resource Management"},{"type":"flow","items":["B.Com","MBA/M.Com HR","PhD HRM"]},{"type":"p","text":"Research:"},{"type":"list","items":[{"text":"Employee retention"},{"text":"HR technology"},{"text":"Strategic HR"},{"text":"Workforce planning"},{"text":"Employee engagement"}]},{"type":"h","text":"Organisational Behaviour"},{"type":"flow","items":["B.Com","MBA/Organisational Psychology","PhD OB"]},{"type":"p","text":"Research:"},{"type":"list","items":[{"text":"Leadership"},{"text":"Motivation"},{"text":"Workplace behaviour"},{"text":"Organisational culture"}]},{"type":"h","text":"People Analytics"},{"type":"flow","items":["B.Com","MBA/M.Sc Analytics","PhD Business Analytics/HRM"]},