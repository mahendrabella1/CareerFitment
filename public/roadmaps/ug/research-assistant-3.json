cience universities"},{"text":"Anthropology/research"},{"text":"Programme language + eligibility"}]]},{"type":"h","text":"Scholarship routes"},{"type":"p","text":"Potential options include:"},{"type":"list","items":[{"text":"DAAD India","url":"https://www.daad.in/en/"},{"text":"USIEF / Fulbright-Nehru","url":"https://www.usief.org.in/"},{"text":"University-funded research positions"},{"text":"Doctoral research funding"}]},{"type":"h","text":"Application pack"},{"type":"p","text":"Build:"},{"type":"list","items":[{"text":"Academic transcripts"},{"text":"CV"},{"text":"Statement of Purpose"},{"text":"Research proposal where required"},{"text":"Writing sample"},{"text":"Fieldwork/research portfolio"},{"text":"Academic recommendations"},{"text":"Research publications/projects"},{"text":"English-language test where required"}]},{"type":"p","text":"For research-heavy postgraduate programmes, a well-defined research interest and strong writing sample can be particularly valuable."}]},{"heading":"Going forward","kind":"growth","blocks":[{"type":"h","text":"Career progression"},{"type":"flow","items":["B.Sc Anthropology","Research Intern","Research Assistant","Research Associate","Senior Research Associate","Researcher/Project Lead","Senior Researcher","Research Director/Principal Investigator"]},{"type":"p","text":"Academic route:"},{"type":"p","text":"B.Sc → M.Sc/M.A. Anthropology → Research Assistant → PhD → Postdoctoral/Research Fellow → Assistant Professor/Researcher → Senior Faculty/Research Lead"},{"type":"p","text":"Policy route:"},{"type":"flow","items":["B.Sc","Research Intern","Policy Research Assistant","Policy Research Associate","Senior Analyst","Policy Lead"]},{"type":"h","text":"PhD routes"},{"type":"p","text":"Possible research areas include:"},{"type":"list","items":[{"text":"Cultural Anthropology"},{"text":"Social Anthropology"},{"text":"Biological Anthropology"},{"text":"Medical Anthropology"},{"text":"Economic Anthropology"},{"text":"Political Anthropology"},{"text":"Urban Anthropology"},{"text":"Development Anthropology"},{"text":"Digital Anthropology"},{"text":"Environmental Anthropology"},{"text":"Tribal/Indigenous Studies"},{"text":"Migration Studies"},{"text":"Population Studies"},{"text":"Human Evolution"},{"text":"Human Biology"},{"text":"Archaeological Anthropology"},{"text":"Public Health"},{"text":"Gender and Society"},{"text":"Technology and Society"}]},{"type":"h","text":"2040–2046 evolution"},{"type":"p","text":"Research careers will increasingly combine traditional fieldwork with digital methods, computational analysis, GIS, large-scale datasets and AI-assisted research workflows."},{"type":"p","text":"A future-ready anthropological researcher should be able to combine:"},{"type":"flow","items":["Ethnography","Statistics","Qualitative Analysis","GIS","Digital Research","Research Ethics","AI/Data Literacy"],"sep":"+"},{"type":"p","text":"AI may accelerate transcription, literature discovery, coding and data analysis, but anthropological interpretation still requires context, field knowledge, ethical judgement and human understanding."}]}]}