"},{"text":"Risk management"},{"text":"Stakeholder management"},{"text":"Change management"}]},{"type":"h","text":"Scheduling Techniques"},{"type":"p","text":"Master:"},{"type":"list","items":[{"text":"Gantt charts"},{"text":"Milestones"},{"text":"Dependencies"},{"text":"Critical Path Method"},{"text":"PERT"},{"text":"Network diagrams"},{"text":"Baseline schedules"},{"text":"Schedule variance"}]},{"type":"h","text":"Operations Management"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Capacity planning"},{"text":"Production planning"},{"text":"Inventory management"},{"text":"Supply chain"},{"text":"Resource utilization"},{"text":"Process mapping"},{"text":"Productivity measurement"}]},{"type":"h","text":"Data Skills"},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"Advanced Excel"},{"text":"Pivot Tables"},{"text":"Power Query"},{"text":"Charts"},{"text":"Dashboards"},{"text":"Basic statistics"}]},{"type":"h","text":"Year 3 — Professional Project Coordination"},{"type":"p","text":"The student should now move from theory to practical project execution."},{"type":"h","text":"Project Documentation"},{"type":"p","text":"Learn how to prepare:"},{"type":"list","items":[{"text":"Project charter"},{"text":"Project plan"},{"text":"Action tracker"},{"text":"Meeting minutes"},{"text":"Status reports"},{"text":"Risk register"},{"text":"Issue log"},{"text":"Decision log"},{"text":"Change request"},{"text":"Resource tracker"},{"text":"Project dashboard"}]},{"type":"h","text":"Project Controls"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Planned vs actual"},{"text":"Schedule variance"},{"text":"Cost variance"},{"text":"Resource utilization"},{"text":"Project KPIs"},{"text":"Earned Value Management"},{"text":"Forecasting"}]},{"type":"p","text":"Important concepts:"},{"type":"h","text":"PV — Planned Value"},{"type":"h","text":"EV — Earned Value"},{"type":"h","text":"AC — Actual Cost"},{"type":"h","text":"SV — Schedule Variance"},{"type":"h","text":"CV — Cost Variance"},{"type":"h","text":"SPI — Schedule Performance Index"},{"type":"h","text":"CPI — Cost Performance Index"},{"type":"h","text":"Risk Management"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Risk identification"},{"text":"Risk probability"},{"text":"Risk impact"},{"text":"Risk matrix"},{"text":"Risk response"},{"text":"Risk mitigation"},{"text":"Risk monitoring"}]},{"type":"h","text":"Year 4 — Industry-Ready Project Coordinator"},{"type":"p","text":"The final year should focus on executing realistic projects and understanding professional project environments."},{"type":"h","text":"Project Management Methodologies"},{"type":"p","text":"Understand:"},{"type":"h","text":"Waterfall"},{"type":"p","text":"Useful for:"},{"type":"list","items":[{"text":"Manufacturing"},{"text":"Construction"},{"text":"Engineering"},{"text":"Infrastructure"},{"text":"Traditional project environments"}]},{"type":"h","text":"Agile"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Scrum"},{"text":"Kanban"},{"text":"Sprint"},{"text":"Product backlog"},{"text":"User stories"},{"text":"Daily stand-up"},{"text":"Sprint review"},{"text":"Retrospective"}]},{"type":"h","text":"Hybrid"},{"type":"p","text":"Understand how organizations combine Agile and traditional project management."},{"type":"h","text":"PMO Knowledge"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Project portfolio reporting"},{"text":"Project governance"},{"text":"Standard templates"},{"text":"Project KPIs"},{"text":"Resource tracking"},{"text":"Risk escalation"},{"text":"Management reporting"}]}]},{"heading":"Core Project Management Knowledge","kind":"other","blocks":[{"type":"p","text":"A strong Project Coordinator should understand the complete project lifecycle:"},{"type":"flow","items":["Initiation","Planning","Execution","Monitoring & Control","Closure"]},{"type":"h","text":"Initiation"},{"type":"list","items":[{"text":"Business case"},{"text":"Project objectives"},{"text":"Stakeholders"},{"text":"Scope"},{"text":"Project charter"}]},{"type":"h","text":"Planning"},{"type":"list","items":[{"text":"WBS"},{"text":"Schedule"},{"text":"Resources"},{"text":"Budget"},{"text":"Risks"},{"text":"Communication plan"}]},{"type":"h","text":"Execution"},{"type":"list","items":[{"text":"Task coordination"},{"text":"Team communication"},{"text":"Vendor coordination"},{"text":"Resource tracking"},{"text":"Issue resolution"}]},{"type":"h","text":"Monitoring"},{"type":"list","items":[{"text":"Progress tracking"},{"text":"KPI monitoring"},{"text":"Schedule control"},{"text":"Cost tracking"},{"text":"Risk monitoring"}]},{"type":"h","text":"Closure"},{"type":"list","items":[{"text":"Deliverable verification"},{"text":"Documentation"},{"text":"Lessons learned"},{"text":"Final reporting"},{"text":"Project handover"}]}]},{"heading":"Software & Tools","kind":"other","blocks":[{"type":"table","header":["Tool","Importance"],"rows":[[{"text":"Microsoft Excel"},{"text":"Essential"}],[{"text":"PowerPoint"},{"text":"Essential"}],[{"text":"Microsoft Project"},{"text":"Highly useful"}],[{"text":"Power BI"},{"text":"Highly useful"}],[{"text":"Jira"},{"text":"Highly useful for IT/Agile"}],[{"text":"Confluence"},{"text":"Useful"}],[{"text":"Smartsheet"},{"text":"Useful"}],[{"text":"Asana"},{"text":"Useful"}],[{"text":"Monday.com"},{"text":"Useful"}],[{"text":"Trello"},{"text":"Useful"}],[{"text":"Primavera P6"},{"text":"Useful for construction/infrastructure"}],[{"text":"SAP / ERP"},{"text":"Useful for industrial projects"}],[{"text":"SQL"},{"text":"Useful"}],[{"text":"Python"},{"text":"Useful for analytics"}]]},{"type":"p","text":"The student does not need to master every project-management platform. It is better to master one scheduling tool, one collaboration platform, Excel, and Power BI."}]},{"heading":"Recommended Projects","kind":"other","blocks":[{"type":"h","text":"Project 1 — Manufacturing Project Plan"},{"type":"p","text":"Create a complete project plan for launching a small manufacturing line."},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Project charter"},{"text":"WBS"},{"text":"Gantt chart"},{"text":"Resource plan"},{"text":"Risk register"},{"text":"Budget"},{"text":"Milestones"},{"text":"Project dashboard"}]},{"type":"h","text":"Project 2 — Event Management Project"},{"type":"p","text":"Manage a simulated technical conference."},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Tasks"},{"text":"Team members"},{"text":"Deadlines"},{"text":"Vendors"},{"text":"Budget"},{"text":"Risks"},{"text":"Dependencies"},{"text":"Event milestones"}]},{"type":"p","text":"This demonstrates coordination skills without requiring industrial equipment."},{"type":"h","text":"Project 3 — Production Line Improvement"},{"type":"p","text":"Create a project to improve manufacturing productivity."},{"type":"p","text":"Example:"},{"type":"p","text":"Reduce production cycle time by 15%."},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Baseline"},{"text":"Improvement actions"},{"text":"Resources"},{"text":"Timeline"},{"text":"KPIs"},{"text":"Risks"},{"text":"Final results"}]},{"type":"h","text":"Project 4 — Power BI Project Dashboard"},{"type":"p","text":"Build a dashboard containing:"},{"type":"list","items":[{"text":"Overall project status"},{"text":"Tasks completed"},{"text":"Tasks pending"},{"text":"Schedule variance"},{"text":"Budget utilization"},{"text":"Risk status"},{"text":"Milestone status"},{"text":"Resource allocation"}]},{"type":"h","text":"Project 5 — Critical Path Analysis"},{"type":"p","text":"Create a project with 20–30 activities and calculate:"},{"type":"list","items":[{"text":"Activity duration"},{"text":"Dependencies"},{"text":"Earliest start"},{"text":"Latest start"},{"text":"Slack"},{"text":"Critical path"}]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"h","text":"Year 1"},{"type":"p","text":"Target:"},{"type":"lis