,[{"text":"Construction"},{"text":"Primavera, scheduling, cost control"}],[{"text":"Infrastructure"},{"text":"Project controls, risk, scheduling"}],[{"text":"Consulting"},{"text":"Excel, PowerPoint, analytics, communication"}],[{"text":"Engineering Services"},{"text":"Technical documentation, scheduling"}],[{"text":"Supply Chain"},{"text":"Procurement, logistics, project planning"}],[{"text":"Energy"},{"text":"Risk, project controls, compliance"}],[{"text":"Product Companies"},{"text":"Agile, Jira, analytics, stakeholder management"}]]}]},{"heading":"Certifications & Learning","kind":"certifications","blocks":[{"type":"h","text":"High Priority"},{"type":"list","items":[{"text":"Project Management fundamentals"},{"text":"Advanced Excel"},{"text":"Microsoft Project"},{"text":"Power BI"},{"text":"Agile/Scrum fundamentals"}]},{"type":"h","text":"Valuable Professional Certifications"},{"type":"p","text":"Depending on experience and eligibility:"},{"type":"list","items":[{"text":"CAPM"},{"text":"PMP"},{"text":"PRINCE2"},{"text":"Professional Scrum Master / similar Scrum credentials"}]},{"type":"p","text":"PMP is generally more appropriate after gaining the required project-management experience rather than immediately after graduation. Current eligibility requirements should be checked with the certification provider."},{"type":"h","text":"Industry-Specific"},{"type":"p","text":"For construction/infrastructure:"},{"type":"list","items":[{"text":"Primavera P6"},{"text":"Project Controls"}]},{"type":"p","text":"For IT:"},{"type":"list","items":[{"text":"Scrum"},{"text":"Agile"},{"text":"Jira"},{"text":"Product management fundamentals"}]},{"type":"p","text":"For manufacturing:"},{"type":"list","items":[{"text":"Lean Six Sigma"},{"text":"ERP/SAP"},{"text":"Operations management"}]}]},{"heading":"PG Options","kind":"pg_india","blocks":[{"type":"p","text":"M.Tech / M.E."},{"type":"p","text":"Possible options:"},{"type":"list","items":[{"text":"Industrial Engineering"},{"text":"