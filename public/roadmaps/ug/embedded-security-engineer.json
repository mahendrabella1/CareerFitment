l Stack","kind":"other","blocks":[{"type":"list","items":[{"text":"EMBEDDED SECURITY ENGINEER"},{"text":"│"},{"text":"┌─────────────────────┼─────────────────────┐"},{"text":"↓ ↓ ↓"},{"text":"Embedded Security Hardware"},{"text":"│ │ │"},{"text":"C / C++ Cryptography MCU Architecture"},{"text":"ARM Threat Modeling Memory"},{"text":"RTOS Secure Coding Debug Interfaces"},{"text":"Firmware Network Security Secure Elements"},{"text":"Drivers IoT Security Root of Trust"},{"text":"│ │ │"}]},{"type":"flow","items":["└─────────────────────┼─────────────────────┘","Firmware Security"]},{"type":"p","text":"│"},{"type":"flow","items":["Reverse Engineering","Security Testing"]},{"type":"list","items":[{"text":"│"},{"text":"Product Security"}]}]},{"heading":"Target Profile by Graduation","kind":"other","blocks":[{"type":"p","text":"A strong graduate should be able to:"},{"type":"h","text":"Embedded"},{"type":"list","items":[{"text":"Program microcontrollers using C"},{"text":"Understand ARM architecture"},{"text":"Work with peripherals"},{"text":"Develop basic drivers"},{"text":"Debug firmware"},{"text":"Understand RTOS fundamentals"}]},{"type":"h","text":"Cybersecurity"},{"type":"list","items":[{"text":"Perform threat modeling"},{"text":"Identify embedded attack surfaces"},{"text":"Understand cryptographic primitives"},{"text":"Implement secure communication"},{"text":"Apply secure coding principles"},{"text":"Analyze vulnerabilities"}]},{"type":"h","text":"Firmware Security"},{"type":"list","items":[{"text":"Understand bootloaders"},{"text":"Understand secure boot"},{"text":"Analyze firmware images"},{"text":"Perform authorized firmware reverse engineering"},{"text":"Understand OTA security"},{"text":"Work with GDB/Ghidra"}]},{"type":"h","text":"IoT Security"},{"type":"list","items":[{"text":"Secure device identity"},{"text":"Secure MQTT/HTTP communication"},{"text":"Understand TLS"},{"text":"Analyze IoT architectures"},{"text":"Design secure device-to-cloud communication"}]},