","items":[{"text":"Supplier identification"},{"text":"Vendor evaluation"},{"text":"RFQ"},{"text":"Purchase orders"},{"text":"Negotiation"},{"text":"Supplier lead time"},{"text":"Supplier performance"},{"text":"Purchase price"},{"text":"Contract basics"},{"text":"Three-way matching"}]},{"type":"h","text":"Three-Way Match"},{"type":"h","text":"Purchase Order ↔ Goods Receipt ↔ Supplier Invoice"},{"type":"p","text":"This is an important control in procurement and accounts-payable processes."}]},{"heading":"Order Management","kind":"other","blocks":[{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Sales orders"},{"text":"Purchase orders"},{"text":"Order confirmation"},{"text":"Order allocation"},{"text":"Picking"},{"text":"Packing"},{"text":"Dispatch"},{"text":"Delivery"},{"text":"Proof of delivery"},{"text":"Returns"}]},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Order status"},{"text":"Delivery status"},{"text":"Pending orders"},{"text":"Delayed orders"},{"text":"Cancelled orders"},{"text":"Backorders"}]}]},{"heading":"Supply Chain Fundamentals","kind":"other","blocks":[{"type":"p","text":"Understand the broader supply chain:"},{"type":"flow","items":["Supplier","Procurement","Manufacturing","Warehouse","Distribution","Retail/Customer"]},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Supply planning"},{"text":"Demand planning"},{"text":"Sourcing"},{"text":"Production planning"},{"text":"Distribution"},{"text":"Inventory optimization"},{"text":"Supplier management"},{"text":"Customer fulfillment"}]},{"type":"h","text":"Key Principle"},{"type":"p","text":"The goal is not simply to move goods faster."},{"type":"p","text":"The goal is to achieve the right balance between:"},{"type":"flow","items":["Cost","Speed","Quality","Reliability","Inventory"],"sep":"+"}]},{"heading":"Logistics Documentation","kind":"other","blocks":[{"type":"p","text":"Become familiar with:"},{"type":"list","items":[{"text":"Purchase Order"},{"text":"Sales Order"},{"text":"Delivery Challan"},{"text":"Invoice"},{"text":"Packing List"},{"text":"Goods Receipt"},{"text":"Proof of Delivery"},{"text":"Transport documents"},{"text":"E-way bill concepts"},{"text":"Bill of Lading"},{"text":"Air Waybill"},{"text":"Freight invoice"},{"text":"Shipment documents"}]},{"type":"p","text":"Documentation requirements depend on the type of movement and applicable regulations."}]},{"heading":"Logistics Cost Management","kind":"other","blocks":[{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Transportation cost"},{"text":"Fuel cost"},{"text":"Warehousing cost"},{"text":"Handling cost"},{"text":"Packaging cost"},{"text":"Inventory carrying cost"},{"text":"Freight cost"},{"text":"Labour cost"},{"text":"Technology cost"},{"text":"Reverse-logistics cost"}]},{"type":"h","text":"Cost Analysis"},{"type":"p","text":"Build models comparing:"},{"type":"flow","items":["Transport Mode","Distance","Load","Transit Time","Cost","Service Level"]},{"type":"p","text":"This helps identify the most appropriate logistics option."}]},{"heading":"Excel Skills","kind":"other","blocks":[{"type":"p","text":"Excel is essential for Logistics Executives."},{"type":"h","text":"Core Functions"},{"type":"list","items":[{"text":"SUM"},{"text":"IF"},{"text":"IFS"},{"text":"IFERROR"},{"text":"SUMIFS"},{"text":"COUNTIFS"},{"text":"XLOOKUP"},{"text":"INDEX/MATCH"}]},{"type":"h","text":"Advanced"},{"type":"list","items":[{"text":"PivotTables"},{"text":"PivotCharts"},{"text":"Power Query"},{"text":"Conditional formatting"},{"text":"Data validation"},{"text":"Basic Power Pivot"},{"text":"Dashboard development"}]},{"type":"h","text":"Practical Applications"},{"type":"p","text":"Create:"},{"type":"list","items":[{"text":"Shipment tracker"},{"text":"Vehicle tracker"},{"text":"Inventory tracker"},{"text":"Vendor performance tracker"},{"text":"Delivery tracker"},{"text":"Freight-cost calculator"},{"text":"Warehouse dashboard"}]}]},{"heading":"Power BI & Logisti