xt":"Documentation"},{"text":"Evidence-based recommendations"},{"text":"Ethics"}]},{"type":"h","text":"Practical Scenario"},{"type":"p","text":"A client wants to lose weight and provides a 24-hour dietary recall."},{"type":"p","text":"A good nutrition professional should:"},{"type":"list","items":[{"text":"Collect relevant dietary and lifestyle information."},{"text":"Assess approximate energy and nutrient intake."},{"text":"Identify nutritional gaps and excessive intake."},{"text":"Consider activity level and realistic goals."},{"text":"Develop an appropriate meal strategy."},{"text":"Avoid unsupported or extreme dietary recommendations."},{"text":"Track progress using measurable indicators."},{"text":"Modify the plan based on adherence and outcomes."},{"text":"Refer medical conditions to the appropriate healthcare professional."}]},{"type":"h","text":"Government / Public Health Route"},{"type":"p","text":"A possible pathway is:"},{"type":"flow","items":["B.Sc Food Science & Nutrition","Nutrition/Public Health internship","Competitive recruitment or organisation-specific selection","Nutrition/Community Nutrition role","Senior Nutrition Professional","Programme Coordinator/Manager"]},{"type":"p","text":"Government eligibility and job titles vary by department, state and recruitment notification. Clinical positions may also have additional qualification requirements."}]},{"heading":"Postgraduate Study in India","kind":"pg_india","blocks":[{"type":"h","text":"Strong options"},{"type":"h","text":"M.Sc"},{"type":"list","items":[{"text":"Nutrition"},{"text":"Food & Nutrition"},{"text":"Clinical Nutrition"},{"text":"Dietetics"},{"text":"Food Science & Nutrition"},{"text":"Applied Nutrition"},{"text":"Public Health Nutrition"}]},{"type":"h","text":"Other relevant master's"},{"type":"list","items":[{"text":"Master of Public Health (MPH)"},{"text":"M.Sc Food Science"},{"text":"M.Sc Food Technology"},{"text":"M.Sc Biochemistry"},{"text":"M.Sc Biotechnology"},{"text":"M.Sc Nut