m"},{"text":"Expectation"},{"text":"Variance"},{"text":"Covariance"},{"text":"Correlation"},{"text":"Law of large numbers"},{"text":"Central limit theorem"}]},{"type":"h","text":"Statistics"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Estimation"},{"text":"Hypothesis testing"},{"text":"Regression"},{"text":"Maximum likelihood"},{"text":"Time-series fundamentals"},{"text":"Statistical inference"}]},{"type":"h","text":"Algorithms"},{"type":"p","text":"Master:"},{"type":"list","items":[{"text":"Sorting"},{"text":"Searching"},{"text":"Graph algorithms"},{"text":"Dynamic programming"},{"text":"Complexity analysis"},{"text":"Data structures"}]},{"type":"h","text":"Competitive Programming"},{"type":"p","text":"Practice:"},{"type":"list","items":[{"text":"LeetCode"},{"text":"Codeforces"},{"text":"AtCoder"},{"text":"ICPC-style problems"},{"text":"For quant recruiting, mathematical problem solving and algorithmic thinking can be particularly valuable."}]},{"type":"h","text":"Year 3 — Quantitative Finance"},{"type":"p","text":"Now introduce financial mathematics."},{"type":"h","text":"Financial Markets"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Equity markets"},{"text":"Bonds"},{"text":"Futures"},{"text":"Options"},{"text":"Swaps"},{"text":"Foreign exchange"},{"text":"Commodities"},{"text":"Market microstructure"}]},{"type":"h","text":"Derivatives"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Calls"},{"text":"Puts"},{"text":"Payoff diagrams"},{"text":"Hedging"},{"text":"Volatility"},{"text":"Greeks"}]},{"type":"p","text":"Important Greeks:"},{"type":"list","items":[{"text":"Delta"},{"text":"Gamma"},{"text":"Vega"},{"text":"Theta"},{"text":"Rho"}]},{"type":"h","text":"Pricing"},{"type":"p","text":"Understand the concepts behind:"},{"type":"list","items":[{"text":"No-arbitrage"},{"text":"Binomial models"},{"text":"Black-Scholes"},{"text":"Risk-neutral pricing"},{"text":"Monte Carlo simulation"}]},{"type":"h","text":"