 PG"}]}]},{"heading":"Study Abroad Options","kind":"abroad","blocks":[{"type":"list","items":[{"text":"MSc Animal Nutrition (Netherlands, UK)"}]}]},{"heading":"Career Opportunities","kind":"careers","blocks":[{"type":"p","text":"Roles a Feed Nutritionist can grow into or move across to:"},{"type":"list","items":[{"text":"Dairy Farm Manager"},{"text":"Poultry Manager"},{"text":"QC Analyst"},{"text":"Technical Sales Officer"}]}]},{"heading":"Recommended Career Progression","kind":"growth","blocks":[{"type":"flow","items":["Nutrition Executive","Feed Nutritionist","Senior Nutritionist","Head of Nutrition","Technical Director"]}]}],"drafted":true}