:"flow","items":["Linux","Git","Cloud","Docker","CI/CD"],"sep":"+"},{"type":"p","text":"rather than internships that only involve watching cloud tutorials."}]},{"heading":"Certifications","kind":"certifications","blocks":[{"type":"p","text":"Certifications can help at entry level, particularly when practical experience is limited."},{"type":"h","text":"Cloud"},{"type":"p","text":"Choose one ecosystem:"},{"type":"list","items":[{"text":"AWS"},{"text":"Microsoft Azure"},{"text":"Google Cloud"}]},{"type":"h","text":"Kubernetes"},{"type":"p","text":"After gaining container fundamentals:"},{"type":"list","items":[{"text":"Kubernetes-related certifications/training"}]},{"type":"h","text":"Terraform"},{"type":"p","text":"Learn Terraform and infrastructure-as-code concepts."},{"type":"h","text":"Linux"},{"type":"p","text":"Linux certifications can be useful but are not mandatory."},{"type":"h","text":"DevOps"},{"type":"p","text":"Prioritise practical DevOps projects over generic \"DevOps certificates.\""},{"type":"p","text":"Certification names, exam versions and prerequisites can change, so verify current requirements before registering."}]},{"heading":"Jobs You Can Target","kind":"careers","blocks":[{"type":"p","text":"After BCA Cloud Computing/DevOps:"},{"type":"table","header":["Entry-Level Role","Main Focus"],"rows":[[{"text":"DevOps Trainee"},{"text":"DevOps fundamentals"}],[{"text":"Junior DevOps Engineer"},{"text":"CI/CD + cloud"}],[{"text":"Cloud Support Engineer"},{"text":"Cloud operations"}],[{"text":"Cloud Engineer – Junior"},{"text":"Cloud infrastructure"}],[{"text":"DevOps Engineer – Junior"},{"text":"Automation"}],[{"text":"Build & Release Engineer"},{"text":"Software releases"}],[{"text":"CI/CD Engineer – Junior"},{"text":"Pipelines"}],[{"text":"Infrastructure Engineer – Junior"},{"text":"Infrastructure"}],[{"text":"Platform Engineer – Junior"},{"text":"Developer platforms"}],[{"text":"Site Reliability Engineer – Junior"},{"text":"Reliability"}],[{"text":"Sy