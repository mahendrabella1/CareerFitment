"},{"text":"Distributed tracing"},{"text":"Service dependencies"}]},{"type":"p","text":"Useful tools/ecosystems include:"},{"type":"list","items":[{"text":"Prometheus"},{"text":"Grafana"},{"text":"OpenTelemetry"},{"text":"Cloud-native monitoring services"},{"text":"ELK/OpenSearch-style logging stacks"}]}]},{"heading":"Security / DevSecOps","kind":"other","blocks":[{"type":"p","text":"Security should be included from the beginning."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"IAM"},{"text":"Least privilege"},{"text":"Secrets management"},{"text":"SSH security"},{"text":"TLS"},{"text":"Network security"},{"text":"Container security"},{"text":"Dependency vulnerabilities"},{"text":"Image scanning"},{"text":"Secure CI/CD"},{"text":"Environment separation"}]},{"type":"p","text":"Understand:"},{"type":"h","text":"DevOps + Security = DevSecOps"}]},{"heading":"Year-by-Year Development Plan","kind":"build","blocks":[{"type":"h","text":"Year 1"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Linux"},{"text":"Networking"},{"text":"Git"},{"text":"Bash"},{"text":"Python basics"},{"text":"SQL"},{"text":"Cloud fundamentals"}]},{"type":"h","text":"Project"},{"type":"h","text":"Linux Server Monitoring Script"},{"type":"p","text":"Build a Bash/Python script that monitors:"},{"type":"list","items":[{"text":"CPU"},{"text":"RAM"},{"text":"Disk"},{"text":"Processes"},{"text":"Network"},{"text":"Logs"}]},{"type":"h","text":"Year 2"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"AWS/Azure/GCP"},{"text":"Docker"},{"text":"CI/CD"},{"text":"Web servers"},{"text":"Cloud networking"}]},{"type":"h","text":"Project"},{"type":"h","text":"Containerised Web Application"},{"type":"p","text":"Deploy:"},{"type":"flow","items":["Application","PostgreSQL","Docker → Cloud"],"sep":"+"},{"type":"h","text":"Year 3"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Terraform"},{"text":"Ansible"},{"text":"Kubernetes"},{"text":"Monitoring"},{"text":"Security"}]},{"type":"h","text":"Project"},{"type":"h","text":"Automated Cloud Deployment"},{"type":"p","text":"Build:"},{"type":"flow","items":["GitHub","CI/CD","Docker","Terraform","Cloud","Monitoring"]},{"type":"h","text":"Year 4"},{"type":"p","text":"Build a production-style DevOps portfolio."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Advanced CI/CD"},{"text":"Kubernetes"},{"text":"Cloud architecture"},{"text":"Security"},{"text":"Observability"},{"text":"Cost optimisation"}]},{"type":"h","text":"Capstone"},{"type":"h","text":"Production Cloud Platform"},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"GitHub"},{"text":"CI/CD"},{"text":"Docker"},{"text":"Terraform"},{"text":"Kubernetes"},{"text":"Cloud"},{"text":"Monitoring"},{"text":"Logging"},{"text":"Security"},{"text":"Automated deployment"}]}]},{"heading":"Four-Year Skill Development","kind":"build","blocks":[{"type":"table","header":["Skill","Year 1","Year 2","Year 3","Year 4"],"rows":[[{"text":"Linux"},{"text":"★★★"},{"text":"★★★★"},{"text":"★★★★★"}],[{"text":"Networking"},{"text":"★★★"},{"text":"★★★★"},{"text":"★★★★★"}],[{"text":"Git"},{"text":"★★★"},{"text":"★★★★★"}],[{"text":"Bash"},{"text":"★★★"},{"text":"★★★★"},{"text":"★★★★★"}],[{"text":"Cloud"},{"text":"★"},{"text":"★★★★"},{"text":"★★★★★"}],[{"text":"Docker"},{"text":"—"},{"text":"★★★"},{"text":"★★★★★"}],[{"text":"CI/CD"},{"text":"—"},{"text":"★★"},{"text":"★★★★★"}],[{"text":"Terraform"},{"text":"—"},{"text":"★"},{"text":"★★★★"},{"text":"★★★★★"}],[{"text":"Ansible"},{"text":"—"},{"text":"★★★"},{"text":"★★★★"}],[{"text":"Kubernetes"},{"text":"—"},{"text":"★★★"},{"text":"★★★★★"}],[{"text":"Monitoring"},{"text":"—"},{"text":"★"},{"text":"★★★"},{"text":"★★★★★"}],[{"text":"Security"},{"text":"★"},{"text":"★★"},{"text":"★★★★"},{"text":"★★★★★"}],[{"text":"Python"},{"text":"★★"},{"text":"★★★"},{"text":"★★★★"}]]}]},{"heading":"Practical Projects","kind":"other","blocks":[{"type":"h","text":"Project 1 — CI/CD Pipeline"}