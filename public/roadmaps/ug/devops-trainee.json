text":"dig"},{"text":"netstat/ss"},{"text":"ssh"}]}]},{"heading":"Git & Version Control","kind":"other","blocks":[{"type":"p","text":"Git is essential."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Repositories"},{"text":"Branches"},{"text":"Commits"},{"text":"Pull requests"},{"text":"Merging"},{"text":"Rebasing"},{"text":"Tags"},{"text":"Release management"},{"text":"Conflict resolution"}]},{"type":"p","text":"Understand a professional workflow:"},{"type":"flow","items":["Feature branch","Pull Request","Code Review","Merge","Build","Test","Deploy"]},{"type":"p","text":"Use GitHub/GitLab/Bitbucket depending on the organisation."}]},{"heading":"Choose a Cloud Platform","kind":"other","blocks":[{"type":"p","text":"Do not try to learn AWS, Azure and GCP simultaneously."},{"type":"p","text":"Choose one primary cloud platform."},{"type":"h","text":"AWS"},{"type":"p","text":"For example, learn:"},{"type":"list","items":[{"text":"EC2"},{"text":"S3"},{"text":"IAM"},{"text":"VPC"},{"text":"RDS"},{"text":"Lambda"},{"text":"CloudWatch"},{"text":"Load Balancer"},{"text":"Auto Scaling"},{"text":"Route 53"},{"text":"ECR"},{"text":"ECS/EKS fundamentals"}]},{"type":"p","text":"You do not need to memorise every cloud service."},{"type":"p","text":"Understand:"},{"type":"p","text":"Why a service is used + how services interact."}]},{"heading":"Cloud Networking","kind":"other","blocks":[{"type":"p","text":"This is an important area for DevOps roles."},{"type":"p","text":"Understand:"},{"type":"flow","items":["Internet","Load Balancer","Application","Database"]},{"type":"p","text":"Then learn:"},{"type":"list","items":[{"text":"VPC"},{"text":"Public/private subnets"},{"text":"Route tables"},{"text":"Internet Gateway"},{"text":"NAT Gateway"},{"text":"Security groups"},{"text":"Network ACLs"},{"text":"Availability Zones"}]},{"type":"p","text":"This knowledge becomes important when deploying production applications."}]},{"heading":"Docker","kind":"other","blocks":[{"type":"p","text":"Docker is one of the most important DevOps skills."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Images"},{"text":"Containers"},{"text":"Dockerfiles"},{"text":"Registries"},{"text":"Volumes"},{"text":"Networks"},{"text":"Environment variables"},{"text":"Container logs"},{"text":"Docker Compose"}]},{"type":"p","text":"Understand:"},{"type":"flow","items":["Application","Docker Image","Container","Deployment"]}]},{"heading":"Container Project","kind":"other","blocks":[{"type":"p","text":"Take a Python/Java application and containerise it."},{"type":"p","text":"Example:"},{"type":"flow","items":["Frontend","Backend API","PostgreSQL"]},{"type":"p","text":"Create:"},{"type":"list","items":[{"text":"Dockerfile"},{"text":"Docker Compose"},{"text":"Database container"},{"text":"Application container"},{"text":"Environment configuration"}]},{"type":"p","text":"Then deploy it to a cloud environment."}]},{"heading":"CI/CD","kind":"other","blocks":[{"type":"p","text":"CI/CD is at the centre of modern DevOps."},{"type":"p","text":"Understand:"},{"type":"h","text":"Continuous Integration"},{"type":"flow","items":["Code","Build","Test"]},{"type":"h","text":"Continuous Delivery/Deployment"},{"type":"h","text":"Tested code → Deployment"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"GitHub Actions"},{"text":"Jenkins"},{"text":"GitLab CI/CD"}]},{"type":"p","text":"At minimum, create a pipeline:"},{"type":"flow","items":["Git Push","Build","Unit Tests","Docker Build","Security/Quality Checks","Deploy"]}]},{"heading":"Infrastructure as Code","kind":"other","blocks":[{"type":"p","text":"Once you understand basic cloud infrastructure, learn Infrastructure as Code (IaC)."},{"type":"h","text":"Terraform"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Providers"},{"text":"Resources"},{"text":"Variables"},{"text":"Outputs"},{"text":"Modules"},{"text":"State"},{"text":"Plan"},{"text":"Apply"},{"text":"Destroy"}]},{"type":"p","tex