rd:"},{"type":"flow","items":["Automation","advanced biologics","data","AI","personalised medicine"],"sep":"+"},{"type":"p","text":"Important future areas include:"},{"type":"list","items":[{"text":"AI-assisted drug discovery"},{"text":"AI-assisted bioprocess optimisation"},{"text":"Continuous manufacturing"},{"text":"Automated laboratories"},{"text":"Digital twins for bioprocesses"},{"text":"Cell and gene therapy"},{"text":"mRNA therapeutics"},{"text":"Advanced vaccines"},{"text":"Biosimilars"},{"text":"Precision medicine"},{"text":"Genomic medicine"},{"text":"Real-time process monitoring"},{"text":"Predictive quality"},{"text":"Digital regulatory systems"}]},{"type":"p","text":"A future-ready professional should combine:"},{"type":"flow","items":["Biological Science","GMP/Quality","Bioprocessing","Data","AI","Business Understanding"],"sep":"+"}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"h","text":"Government / research organisations"},{"type":"table","header":["Organisation","Potential exposure"],"rows":[[{"text":"Department of Biotechnology (DBT)","url":"https://dbtindia.gov.in/"},{"text":"Biotechnology and biopharma research ecosystem"}],[{"text":"ICMR","url":"https://www.icmr.gov.in/"},{"text":"Immunology, virology, diagnostics and biomedical research"}],[{"text":"CSIR","url":"https://www.csir.res.in/"},{"text":"Microbiology, biotechnology and industrial research"}],[{"text":"IIT/IISc laboratories"},{"text":"Molecular biology, microbiology and bioprocess research"}],[{"text":"Government medical research institutes"},{"text":"Virology, immunology and diagnostics"}],[{"text":"University biotechnology laboratories"},{"text":"Research and laboratory experience"}],[{"text":"National research laboratories"},{"text":"Bioprocessing and biological sciences"}],[{"text":"PM Internship Scheme"},{"text":"Industry exposure where current eligibility permits"}]]},{"type":"h","text":"Private / industry internships"},{"type":"p","text":"Potential employer