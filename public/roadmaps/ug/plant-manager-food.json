ctive maintenance"},{"text":"Breakdown analysis"},{"text":"MTBF"},{"text":"MTTR"},{"text":"Spare-parts planning"},{"text":"Equipment reliability"}]},{"type":"p","text":"Modern plants increasingly use:"},{"type":"list","items":[{"text":"IoT sensors"},{"text":"Predictive maintenance"},{"text":"Condition monitoring"},{"text":"Digital maintenance systems"}]}]},{"heading":"Supply Chain Knowledge","kind":"other","blocks":[{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Procurement"},{"text":"Supplier management"},{"text":"Raw-material inventory"},{"text":"Warehouse management"},{"text":"Cold-chain logistics"},{"text":"Finished-goods inventory"},{"text":"Demand forecasting"},{"text":"Distribution"}]},{"type":"p","text":"Food manufacturing requires special attention to:"},{"type":"list","items":[{"text":"Shelf life"},{"text":"Temperature"},{"text":"Expiry"},{"text":"Batch traceability"},{"text":"FIFO"},{"text":"FEFO"}]}]},{"heading":"Software & Tools","kind":"other","blocks":[{"type":"table","header":["Category","Tools"],"rows":[[{"text":"ERP"},{"text":"SAP, Oracle, Microsoft Dynamics"}],[{"text":"Production planning"},{"text":"ERP/MRP systems"}],[{"text":"Data analysis"},{"text":"Excel, Python"}],[{"text":"Dashboards"},{"text":"Power BI"}],[{"text":"Statistics"},{"text":"Minitab, Excel"}],[{"text":"Quality"},{"text":"QMS/eQMS platforms"}],[{"text":"Maintenance"},{"text":"CMMS systems"}],[{"text":"Process control"},{"text":"SCADA"}],[{"text":"Automation"},{"text":"PLC systems"}],[{"text":"Documentation"},{"text":"MS Office"}],[{"text":"Project management"},{"text":"MS Project / similar tools"}]]},{"type":"flow","items":["A future Plant Manager should understand ERP","MES/SCADA","analytics, not just production operations."],"sep":"+"}]},{"heading":"Five Recommended Projects","kind":"other","blocks":[{"type":"h","text":"Project 1 — Food Plant Production Dashboard"},{"type":"p","text":"Build a Power BI dashboard showing:"},{"type":"list","items":[{"text":"Pr