":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Target internships with:"},{"type":"list","items":[{"text":"FMCG companies"},{"text":"Dairy plants"},{"text":"Beverage manufacturers"},{"text":"Food-processing plants"},{"text":"Bakery companies"},{"text":"Frozen-food companies"},{"text":"Grain-processing plants"},{"text":"Meat/seafood processing companies"},{"text":"Food ingredient manufacturers"},{"text":"Nutraceutical companies"}]},{"type":"h","text":"Best departments"},{"type":"list","items":[{"text":"Production"},{"text":"Process Engineering"},{"text":"Quality Assurance"},{"text":"Food Safety"},{"text":"Manufacturing Excellence"},{"text":"Supply Chain"},{"text":"Maintenance"},{"text":"Packaging"}]},{"type":"p","text":"Plant-floor exposure is essential for this career."}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"type":"p","text":"A graduate will usually enter through roles such as:"},{"type":"list","items":[{"text":"Production Engineer"},{"text":"Food Process Engineer"},{"text":"Production Executive"},{"text":"Manufacturing Engineer"},{"text":"Quality Executive"},{"text":"Food Safety Executive"},{"text":"Production Planning Executive"},{"text":"Operations Executive"},{"text":"Process Improvement Engineer"},{"text":"Maintenance/Operations Coordinator"}]},{"type":"p","text":"Then progress toward:"},{"type":"flow","items":["Assistant Production Manager","Production Manager","Plant Manager"]}]},{"heading":"Employer Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Employer Type","Most Valuable Skills"],"rows":[[{"text":"FMCG"},{"text":"Production, OEE, Lean, quality"}],[{"text":"Dairy"},{"text":"Food safety, cold chain, process control"}],[{"text":"Beverages"},{"text":"Process engineering, automation, packaging"}],[{"text":"Bakery"},{"text":"Production planning, quality, equipment"}],[{"text":"Frozen Foods"},{"text":"Cold chain, food safety, operations"}],[{"text":"Grain Processing"},{"text":"Milli