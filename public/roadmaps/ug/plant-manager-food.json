","text":"Focus on:"},{"type":"list","items":[{"text":"HACCP"},{"text":"GMP"},{"text":"Audits"},{"text":"Traceability"},{"text":"Compliance"}]},{"type":"h","text":"3. Manufacturing Excellence"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Lean"},{"text":"Six Sigma"},{"text":"OEE"},{"text":"Continuous improvement"}]},{"type":"h","text":"4. Smart Food Manufacturing"},{"type":"p","text":"Combine food processing with:"},{"type":"list","items":[{"text":"IoT"},{"text":"Automation"},{"text":"MES"},{"text":"SCADA"},{"text":"AI"},{"text":"Predictive maintenance"}]},{"type":"h","text":"5. Supply Chain & Operations"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Procurement"},{"text":"Inventory"},{"text":"Warehousing"},{"text":"Logistics"},{"text":"Demand planning"}]},{"type":"h","text":"6. Sustainability"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Energy efficiency"},{"text":"Water efficiency"},{"text":"Food waste reduction"},{"text":"Packaging optimization"},{"text":"Circular manufacturing"}]}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"Operations Path"},{"type":"flow","items":["Production Trainee","Production / Process Engineer","Senior Production Engineer","Assistant Production Manager","Production Manager","Plant Manager","Senior Plant Manager","Manufacturing / Operations Head"]},{"type":"h","text":"Manufacturing Excellence Path"},{"type":"flow","items":["Process Engineer","Continuous Improvement Engineer","Manufacturing Excellence Lead","Operational Excellence Manager","Plant Manager","Manufacturing Excellence Director"]}]},{"heading":"Emerging Technologies","kind":"other","blocks":[{"type":"h","text":"Smart Food Factories"},{"type":"p","text":"Modern food plants increasingly combine:"},{"type":"list","items":[{"text":"IoT"},{"text":"Sensors"},{"text":"PLCs"},{"text":"SCADA"},{"text":"MES"},{"text":"ERP"},{"text":"AI analytics"}]},{"type":"flow","items":["Production Equipmen