,{"text":"Product"},{"text":"Monthly sales"},{"text":"Target vs achievement"}]},{"type":"h","text":"5. Sales Pitch Portfolio"},{"type":"p","text":"Create sales pitches for:"},{"type":"list","items":[{"text":"Consumer product"},{"text":"SaaS product"},{"text":"Financial product"},{"text":"Retail product"},{"text":"B2B service"}]},{"type":"p","text":"Practise:"},{"type":"flow","items":["Opening","Discovery","Need","Solution","Value","Objection Handling","Closing"]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Target:"},{"type":"h","text":"High Priority"},{"type":"list","items":[{"text":"Sales Intern"},{"text":"Business Development Intern"},{"text":"Retail Sales Intern"},{"text":"Marketing & Sales Intern"},{"text":"Inside Sales Intern"},{"text":"Account Management Intern"}]},{"type":"h","text":"Also Useful"},{"type":"list","items":[{"text":"Customer Success Intern"},{"text":"Digital Marketing Intern"},{"text":"Market Research Intern"},{"text":"Retail Operations Intern"},{"text":"Sales Operations Intern"}]},{"type":"p","text":"The most valuable internship is one where the student receives exposure to real customers, CRM systems, sales targets, and measurable conversion outcomes."}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"type":"p","text":"Potential roles include:"},{"type":"list","items":[{"text":"Sales Executive"},{"text":"Sales Associate"},{"text":"Business Development Executive"},{"text":"Business Development Associate"},{"text":"Inside Sales Executive"},{"text":"Field Sales Executive"},{"text":"Retail Sales Executive"},{"text":"Relationship Executive"},{"text":"Customer Relationship Executive"},{"text":"Account Executive"},{"text":"Sales Coordinator"},{"text":"Sales Operations Executive"},{"text":"Customer Success Associate"}]},{"type":"h","text":"Sales Specialisation Options"},{"type":"h","text":"1. B2C Sales"},{"type":"p","text":"Examples:"},{"type":"list","items":[{"text":"Retail"},{"text":"Co