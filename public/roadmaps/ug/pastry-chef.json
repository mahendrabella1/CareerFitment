text":"Yield"},{"text":"Cost"},{"text":"Final photograph"},{"text":"Problems encountered"},{"text":"Improvements"}]},{"type":"h","text":"Project 2 — Café Dessert Menu"},{"type":"p","text":"Develop a 10–15 item dessert menu."},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Product description"},{"text":"Ingredient list"},{"text":"Portion size"},{"text":"Food cost"},{"text":"Selling price"},{"text":"Preparation time"},{"text":"Shelf life"},{"text":"Allergen information"},{"text":"Presentation concept"}]},{"type":"h","text":"Project 3 — Pastry Production Plan"},{"type":"p","text":"Design production for a hotel pastry section."},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Daily forecast"},{"text":"Mise en place"},{"text":"Production schedule"},{"text":"Ingredient requirements"},{"text":"Equipment"},{"text":"Staffing"},{"text":"Storage"},{"text":"Waste control"},{"text":"Quality checks"}]}]},{"heading":"Advanced Capstone","kind":"other","blocks":[{"type":"h","text":"Professional Pastry Product Development & Kitchen Management Project"},{"type":"p","text":"Develop a complete pastry concept for a:"},{"type":"h","text":"Boutique Patisserie / Hotel Pastry Section"},{"type":"h","text":"Deliverables"},{"type":"list","items":[{"text":"Brand concept"},{"text":"Target customer"},{"text":"15–20 item menu"},{"text":"Standardized recipes"},{"text":"Food-cost sheets"},{"text":"Supplier plan"},{"text":"Production schedule"},{"text":"Kitchen layout concept"},{"text":"Hygiene/HACCP framework"},{"text":"Inventory model"},{"text":"Waste-reduction strategy"},{"text":"Product photographs"},{"text":"Customer feedback"},{"text":"Final menu presentation"}]},{"type":"p","text":"This demonstrates both chef skills and business understanding."}]},{"heading":"Tools & Equipment","kind":"other","blocks":[{"type":"h","text":"Essential Kitchen Equipment"},{"type":"list","items":[{"text":"Planetary mixer"},{"text":"Spiral mixer awareness"},{"text":"Deck/convection oven"},{"text":"Proofing cabinet"},{"text":"Blast chiller awareness"},{"text":"Refrigerator/freezer"},{"text":"Induction/cooking equipment"},{"text":"Food processor"},{"text":"Chocolate tempering equipment"}]},{"type":"h","text":"Hand Tools"},{"type":"list","items":[{"text":"Digital weighing scale"},{"text":"Thermometer"},{"text":"Bench scraper"},{"text":"Pallet knife"},{"text":"Piping bags"},{"text":"Piping tips"},{"text":"Pastry brushes"},{"text":"Rolling pins"},{"text":"Pastry cutters"},{"text":"Silicone moulds"},{"text":"Chocolate moulds"}]},{"type":"p","text":"Precision equipment should be selected according to the kitchen's production scale."}]},{"heading":"Digital Tools","kind":"other","blocks":[{"type":"p","text":"Useful for professional development:"},{"type":"list","items":[{"text":"Excel"},{"text":"Google Sheets"},{"text":"Canva"},{"text":"PowerPoint"},{"text":"Recipe-management software"},{"text":"Inventory software"},{"text":"POS systems"},{"text":"Hotel management systems"}]},{"type":"p","text":"For advanced business roles:"},{"type":"list","items":[{"text":"Food-costing software"},{"text":"Inventory-management systems"},{"text":"Procurement systems"},{"text":"Hospitality analytics"}]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"This is one of the most important components of the pathway."},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"Five-star hotels"},{"text":"Luxury resorts"},{"text":"Boutique hotels"},{"text":"Patisseries"},{"text":"Bakeries"},{"text":"Fine-dining restaurants"},{"text":"Café chains"},{"text":"Cruise companies"},{"text":"Airlines/catering companies"},{"text":"Chocolate companies"},{"text":"Dessert brands"},{"text":"Central kitchens"},{"text":"Food-production companies"}]},{"type":"h","text":"Ideal Internship"},{"type":"p","text":"Spend substantial time in a professional pastry/bakery section, rather than only general hotel operations."},{"type":"p","text":"Gain exposure to:"},{"type":"list","items":[{"text":"Mise en place"},{"text":"Production"},{"text":"Bakery"},{"text":"Pastry"},{"text":"Chocolate"},{"text":"Desserts"},{"text":"Plating"},{"text":"Inventory"},{"text":"Food safety"},{"text":"Service"}]}]},{"heading":"Certifications & Learning","kind":"certifications","blocks":[{"type":"p","text":"Useful supplementary certifications:"},{"type":"list","items":[{"text":"Food Safety"},{"text":"HACCP"},{"text":"Bakery & Pastry Arts"},{"text":"Chocolate"},{"text":"Cake Decoration"},{"text":"Artisan Bread"},{"text":"Advanced Pastry"},{"text":"Food Costing"},{"text":"Hospitality Operations"}]},{"type":"p","text":"Optional:"},{"type":"list","items":[{"text":"Barista skills"},{"text":"Food photography"},{"text":"Restaurant entrepreneurship"},{"text":"Hospitality management"},{"text":"Nutrition fundamentals"}]},{"type":"p","text":"Food-safety certifications should be aligned with the requirements of the country and employer."}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"type":"p","text":"After graduation, realistic roles include:"},{"type":"list","items":[{"text":"Commis Pastry"},{"text":"Commis Chef – Pastry"},{"text":"Junior Pastry Cook"},{"text":"Bakery Commis"},{"text":"Pastry Production Assistant"},{"text":"Bakery Production Associate"},{"text":"Demi Chef – Pastry, where experience/skill requirements are met"},{"text":"Pastry Kitchen Trainee"},{"text":"Cake Decorator"},{"text":"Chocolate Production Assistant"},{"text":"Dessert Station Assistant"},{"text":"Bakery Supervisor Trainee"}]},{"type":"p","text":"A graduate should generally not expect to enter directly as an Executive Pastry Chef or Pastry Sous Chef without substantial professional experience."}]},{"heading":"Postgraduate Options in India","kind":"pg_india","blocks":[{"type":"p","text":"Relevant options include:"},{"type":"list","items":[{"text":"Advanced Diploma in Bakery & Patisserie"},{"text":"Advanced Pastry Arts"},{"text":"PG Diploma in Culinary Arts"},{"text":