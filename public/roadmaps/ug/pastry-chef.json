"},{"text":"Hydration"},{"text":"Fermentation"},{"text":"Proofing"},{"text":"Dough development"},{"text":"Shaping"},{"text":"Scoring"},{"text":"Baking"},{"text":"Cooling"}]},{"type":"h","text":"Advanced"},{"type":"list","items":[{"text":"Preferments"},{"text":"Levain"},{"text":"Poolish"},{"text":"Biga"},{"text":"Long fermentation"},{"text":"Sourdough management"}]}]},{"heading":"Cakes & Sponges","kind":"other","blocks":[{"type":"p","text":"Master:"},{"type":"list","items":[{"text":"Butter cakes"},{"text":"Pound cakes"},{"text":"Sponge cakes"},{"text":"Genoise"},{"text":"Chiffon"},{"text":"Angel food"},{"text":"Chocolate cakes"},{"text":"Carrot cakes"},{"text":"Fruit cakes"}]},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Layering"},{"text":"Filling"},{"text":"Soaking"},{"text":"Frosting"},{"text":"Ganache"},{"text":"Glazing"},{"text":"Finishing"},{"text":"Decoration"}]}]},{"heading":"Pastry Arts","kind":"other","blocks":[{"type":"p","text":"Learn different pastry families:"},{"type":"h","text":"Shortcrust"},{"type":"list","items":[{"text":"Tart shells"},{"text":"Pâte sucrée"},{"text":"Pâte sablée"}]},{"type":"h","text":"Laminated"},{"type":"list","items":[{"text":"Croissants"},{"text":"Danish pastries"},{"text":"Puff pastry"}]},{"type":"h","text":"Choux"},{"type":"list","items":[{"text":"Éclairs"},{"text":"Profiteroles"},{"text":"Paris-Brest"}]},{"type":"h","text":"Other"},{"type":"list","items":[{"text":"Mille-feuille"},{"text":"Strudel"},{"text":"Filled pastries"},{"text":"Modern plated pastry"}]}]},{"heading":"Chocolate & Confectionery","kind":"other","blocks":[{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Chocolate tempering"},{"text":"Ganache"},{"text":"Truffles"},{"text":"Pralines"},{"text":"Bonbons"},{"text":"Chocolate decorations"},{"text":"Chocolate moulding"},{"text":"Cocoa applications"}]},{"type":"h","text":"Confectionery"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Caramel"},{"text":"Nougat"},{"tex