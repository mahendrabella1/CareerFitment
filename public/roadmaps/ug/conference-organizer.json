:"flow","items":["Hospitality/Tourism Degree","Event Internship","Live Conference Experience","Venue Management","Speaker Coordination","Sponsorship","Budgeting","Vendor Management","Event Marketing","Registration Technology","Risk Management","Excel","Project Management","Hybrid Event Skills","AI-Assisted Event Operations","Documented Conference Portfolio."],"sep":"+"}]}]}