},{"text":"HPLC, GC, TLC"}],[{"text":"Materials Chemistry"},{"text":"Polymers, composites, nanomaterials"}],[{"text":"Formulation"},{"text":"Composition, stability, optimization"}],[{"text":"Laboratory Science"},{"text":"Sample preparation, calibration, documentation"}],[{"text":"Statistics"},{"text":"Experimental design, uncertainty, data interpretation"}],[{"text":"Research"},{"text":"Literature review, hypothesis formation, experimental design"}]]}]},{"heading":"Laboratory & Instrumentation Skills","kind":"other","blocks":[{"type":"p","text":"A good R&D Chemist needs strong hands-on laboratory capability."},{"type":"p","text":"Learn the principles and practical operation of:"},{"type":"list","items":[{"text":"Analytical balance"},{"text":"pH meter"},{"text":"Conductivity meter"},{"text":"UV-Visible spectrophotometer"},{"text":"FTIR"},{"text":"HPLC"},{"text":"GC"},{"text":"TLC"},{"text":"Karl Fischer titration"},{"text":"Melting-point apparatus"},{"text":"Centrifuge"},{"text":"Autoclave where relevant"},{"text":"Heating/stirring systems"},{"text":"Vacuum systems"},{"text":"Basic electrochemical instruments"}]},{"type":"p","text":"At advanced levels, understand:"},{"type":"list","items":[{"text":"NMR"},{"text":"Mass spectrometry"},{"text":"XRD"},{"text":"SEM"},{"text":"TEM"},{"text":"DSC"},{"text":"TGA"},{"text":"Particle-size analysis"}]},{"type":"p","text":"The objective is not simply to operate an instrument but to understand:"},{"type":"flow","items":["Sample","Method","Measurement","Calibration","Data","Interpretation","Conclusion"]}]},{"heading":"Analytical Chemistry Skills","kind":"other","blocks":[{"type":"p","text":"Analytical capability is highly valuable in industrial R&D."},{"type":"p","text":"Learn:"},{"type":"h","text":"Chromatography"},{"type":"list","items":[{"text":"HPLC"},{"text":"GC"},{"text":"TLC"},{"text":"Ion chromatography fundamentals"}]},{"type":"h","text":"Spectroscopy"},{"type":"list","items":[{"text":"UV-Vis"},{"text":"FTIR"},{"text":"NMR fundamentals"},{"text":"Mass spectrometry"}]},{"type":"h","text":"Materials Characterization"},{"type":"list","items":[{"text":"XRD"},{"text":"SEM"},{"text":"EDS"},{"text":"DSC"},{"text":"TGA"},{"text":"DLS where relevant"}]},{"type":"h","text":"Data Analysis"},{"type":"p","text":"Learn to interpret:"},{"type":"list","items":[{"text":"Calibration curves"},{"text":"Detection limits"},{"text":"Precision"},{"text":"Accuracy"},{"text":"Recovery"},{"text":"Repeatability"},{"text":"Statistical significance"},{"text":"Method validation concepts"}]}]},{"heading":"Chemistry + Programming","kind":"other","blocks":[{"type":"p","text":"Modern R&D laboratories increasingly use digital data workflows."},{"type":"h","text":"Learn Python"},{"type":"p","text":"Useful libraries:"},{"type":"list","items":[{"text":"NumPy"},{"text":"pandas"},{"text":"Matplotlib"},{"text":"SciPy"},{"text":"scikit-learn"},{"text":"RDKit"}]},{"type":"p","text":"Use Python for:"},{"type":"list","items":[{"text":"Experimental data analysis"},{"text":"Spectral processing"},{"text":"Reaction-data analysis"},{"text":"Statistical modelling"},{"text":"Chemical-property prediction"},{"text":"Visualization"},{"text":"Automation"}]},{"type":"h","text":"Additional Tools"},{"type":"list","items":[{"text":"Excel"},{"text":"MATLAB"},{"text":"Origin"},{"text":"ChemDraw"},{"text":"PubChem"},{"text":"SciFinder/Reaxys where institutionally available"},{"text":"Electronic Laboratory Notebooks (ELN)"}]}]},{"heading":"Recommended Projects","kind":"other","blocks":[{"type":"h","text":"Project 1 — HPLC/Chromatography Data Analysis"},{"type":"p","text":"Build a workflow that analyzes chromatographic data."},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Baseline correction"},{"text":"Peak detection"},{"text":"Retention-time analysis"},{"text":"Peak-area calculation"},{"text":"Calibration curve"},{"text":"Concentration estimation"}]},{"type":"note","label":"Tools","text":"Python, pandas, SciPy, Matplotlib"},{"ty