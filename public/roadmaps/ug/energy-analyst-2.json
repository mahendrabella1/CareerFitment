llows organizations to compare energy performance across facilities or production periods."}]}]},{"heading":"Year 3 — Energy Data Analytics","kind":"other","blocks":[{"type":"p","text":"This is one of the most important areas for an Energy Analyst."},{"type":"h","text":"Excel"},{"type":"p","text":"Become advanced in:"},{"type":"list","items":[{"text":"Pivot Tables"},{"text":"Power Query"},{"text":"XLOOKUP"},{"text":"Statistical functions"},{"text":"Scenario analysis"},{"text":"Solver"},{"text":"Financial modeling"},{"text":"Dashboard development"}]},{"type":"h","text":"SQL"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"SELECT"},{"text":"WHERE"},{"text":"JOIN"},{"text":"GROUP BY"},{"text":"CASE"},{"text":"Aggregations"},{"text":"Window functions"}]},{"type":"p","text":"Use SQL to analyze:"},{"type":"list","items":[{"text":"Smart-meter data"},{"text":"Electricity consumption"},{"text":"Equipment data"},{"text":"Renewable generation"},{"text":"Utility records"}]}]},{"heading":"Python for Energy Analytics","kind":"other","blocks":[{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"NumPy"},{"text":"pandas"},{"text":"matplotlib"},{"text":"basic statistics"},{"text":"time-series analysis"},{"text":"forecasting"},{"text":"optimization"}]},{"type":"h","text":"Applications"},{"type":"p","text":"Python can be used for:"},{"type":"list","items":[{"text":"Energy-demand forecasting"},{"text":"Solar-generation forecasting"},{"text":"Wind-generation analysis"},{"text":"Load-profile analysis"},{"text":"Energy benchmarking"},{"text":"Anomaly detection"},{"text":"Energy optimization"}]}]},{"heading":"Power BI & Energy Dashboards","kind":"other","blocks":[{"type":"p","text":"Develop dashboards showing:"},{"type":"h","text":"Energy Dashboard"},{"type":"flow","items":["Total Energy Consumption","Daily / Monthly Trend","Peak Demand","Energy Intensity","Renewable Contribution","Energy Cost","Carbon Emissions"]},{"type":"h","text":"Useful KPIs"},{"type":"list","i