ry"},{"text":"DAX"},{"text":"Data modelling"},{"text":"Basic statistics"}]},{"type":"h","text":"Strong additions"},{"type":"list","items":[{"text":"Python"},{"text":"pandas"},{"text":"NumPy"},{"text":"matplotlib"},{"text":"seaborn"},{"text":"Jupyter"},{"text":"R"},{"text":"Tableau"}]},{"type":"h","text":"Data platforms"},{"type":"list","items":[{"text":"PostgreSQL"},{"text":"MySQL"},{"text":"SQL Server"},{"text":"BigQuery/Snowflake fundamentals"}]},{"type":"h","text":"Engineering"},{"type":"list","items":[{"text":"Git/GitHub"},{"text":"APIs"},{"text":"ETL/ELT"},{"text":"Data validation"},{"text":"Documentation"}]},{"type":"h","text":"Cloud"},{"type":"list","items":[{"text":"AWS/Azure/GCP analytics fundamentals"}]},{"type":"p","text":"For learning, use Microsoft Learn, Python documentation and PostgreSQL documentation.","url":"https://learn.microsoft.com/"},{"type":"h","text":"Portfolio target"},{"type":"p","text":"By graduation, build 5–7 serious analytics projects:"},{"type":"list","items":[{"text":"Sales KPI dashboard"},{"text":"Customer/churn analysis"},{"text":"Marketing campaign dashboard"},{"text":"Financial performance dashboard"},{"text":"HR analytics dashboard"},{"text":"Operations/supply-chain dashboard"},{"text":"End-to-end automated reporting project"}]},{"type":"p","text":"Each project should include:"},{"type":"list","items":[{"text":"Business problem"},{"text":"Data source"},{"text":"Data cleaning"},{"text":"Data model"},{"text":"KPI definitions"},{"text":"Dashboard"},{"text":"Key insights"},{"text":"Recommendations"},{"text":"README/documentation"}]},{"type":"h","text":"Specialisation"},{"type":"table","header":["Lane","Core stack","Learn from","Senior role it leads to"],"rows":[[{"text":"Business Intelligence"},{"text":"Power BI, SQL, DAX"},{"text":"Enterprise reporting"},{"text":"BI Analyst/Lead"}],[{"text":"Data Analytics"},{"text":"SQL, Python, statistics"},{"text":"Business analysis"},{"text":"Senior Data Analyst"}],[{"text":"BI Development"},{"