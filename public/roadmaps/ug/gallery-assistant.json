text":"Statement of purpose"},{"text":"Writing sample"},{"text":"Art research sample"},{"text":"Exhibition/curatorial project"},{"text":"Artwork portfolio where requested"},{"text":"Internship certificates"},{"text":"Exhibition credits"},{"text":"Recommendation letters"},{"text":"English-language test where required"},{"text":"Research proposal for research programmes"}]},{"type":"p","text":"Exact university requirements and deadlines are: check the official site for the application year."}]},{"heading":"Going Forward","kind":"growth","blocks":[{"type":"h","text":"Career progression"},{"type":"flow","items":["BA Fine Arts Student","Gallery Intern","Gallery Assistant","Gallery Coordinator / Exhibition Assistant","Senior Gallery Coordinator","Gallery Manager / Curatorial Associate","Curator / Arts Manager / Exhibition Manager"]},{"type":"p","text":"Alternative routes:"},{"type":"flow","items":["Gallery Assistant","Curatorial Assistant","Curator"]},{"type":"flow","items":["Gallery Assistant","Collections Assistant","Collections Manager"]},{"type":"flow","items":["Gallery Assistant","Exhibition Assistant","Exhibition Manager"]},{"type":"flow","items":["Gallery Assistant","Art Sales Assistant","Art Consultant / Art Sales Manager"]},{"type":"flow","items":["Gallery Assistant","Arts Administration","Cultural Programme Manager"]},{"type":"h","text":"PhD Routes"},{"type":"p","text":"A research-oriented student can consider:"},{"type":"list","items":[{"text":"PhD in Fine Arts"},{"text":"PhD in Art History"},{"text":"PhD in Museology"},{"text":"PhD in Museum Studies"},{"text":"PhD in Visual Culture"},{"text":"PhD in Cultural Studies"},{"text":"PhD in Heritage Studies"},{"text":"PhD in Art Conservation"},{"text":"PhD in Digital Humanities"},{"text":"PhD in Cultural Management"}]},{"type":"p","text":"Possible research areas include:"},{"type":"list","items":[{"text":"Contemporary Indian art"},{"text":"Digital art"},{"text":"Museum digitisation"},{"text":"Art and AI"},{"text":"Digital preservation"},{"text":"Cultural heritage"},{"text":"Indigenous art"},{"text":"Museum accessibility"},{"text":"Art markets"},{"text":"Curatorial practices"},{"text":"Virtual museums"},{"text":"Immersive exhibitions"},{"text":"Public art"},{"text":"Art and social change"}]},{"type":"note","label":"2035–2046","text":"Long-Term Career Evolution"},{"type":"p","text":"The traditional gallery professional is increasingly becoming a hybrid art-and-technology professional."},{"type":"p","text":"Future opportunities may include:"},{"type":"h","text":"Gallery Assistant → Gallery Manager"},{"type":"flow","items":["Curatorial Assistant","Curator","Senior Curator"]},{"type":"h","text":"Collections Assistant → Digital Collections Manager"},{"type":"h","text":"Exhibition Assistant → Exhibition Producer"},{"type":"h","text":"Art Researcher → Art Historian"},{"type":"h","text":"Arts Administrator → Cultural Programme Director"},{"type":"h","text":"Digital Collections Specialist → Digital Curator"},{"type":"p","text":"The strongest future profile will combine:"},{"type":"flow","items":["Fine Arts","Art History","Curatorial Knowledge","Collections","Exhibition Management","Digital Skills","Cultural Management","AI Literacy"],"sep":"+"}]}]}