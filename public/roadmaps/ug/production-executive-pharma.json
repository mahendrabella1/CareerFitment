kind":"internships","blocks":[{"type":"h","text":"Year 1–2"},{"type":"h","text":"Look for exposure to:"},{"type":"h","text":"Pharmaceutical manufacturing"},{"type":"h","text":"Quality-control laboratories"},{"type":"h","text":"Drug-testing laboratories"},{"type":"h","text":"Pharmaceutics labs"},{"type":"h","text":"Year 3"},{"type":"h","text":"Target:"},{"type":"h","text":"Formulation plants"},{"type":"h","text":"API plants"},{"type":"h","text":"Contract manufacturing organisations"},{"type":"h","text":"QA/QC departments"},{"type":"h","text":"Final Year"},{"type":"p","text":"Prioritize production-focused internships involving:"},{"type":"h","text":"Manufacturing"},{"type":"h","text":"Batch documentation"},{"type":"h","text":"GMP"},{"type":"h","text":"Production planning"},{"type":"h","text":"Equipment"},{"type":"h","text":"In-process controls"},{"type":"h","text":"Deviation/CAPA exposure"},{"type":"h","text":"Ideal Internship Rotation"},{"type":"h","text":"Production"},{"type":"h","text":"Quality Control"},{"type":"h","text":"Quality Assurance"},{"type":"h","text":"Warehouse"},{"type":"h","text":"Engineering"},{"type":"h","text":"Production Planning"},{"type":"p","text":"This cross-functional understanding makes a production candidate much stronger."}]},{"heading":"Employer Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Employer Type","High-Value Skills"],"rows":[[{"text":"Formulation Plant"},{"text":"Manufacturing, GMP, documentation"}],[{"text":"API Plant"},{"text":"Process knowledge, safety, GMP"}],[{"text":"Sterile Plant"},{"text":"Aseptic processing, cleanroom principles"}],[{"text":"Contract Manufacturer"},{"text":"Batch execution, documentation, compliance"}],[{"text":"Biopharma Plant"},{"text":"Process operations, GMP, validation"}],[{"text":"Generic Pharma"},{"text":"High-volume production, process control"}],[{"text":"Vaccine Manufacturer"},{"text":"Sterile/biological manufacturing principles"}],[{"text":"Pharmaceutical Packaging"},{"text