try","Example universities","Scholarship route","Gate to check"],"rows":[[{"text":"USA"},{"text":"University of Washington, University of Miami, Scripps/UC San Diego, MIT"},{"text":"University funding + assistantships"},{"text":"Programme + English requirements"}],[{"text":"UK"},{"text":"University of Southampton, University of Plymouth, University of Exeter"},{"text":"University scholarships + external funding"},{"text":"Programme + English requirements"}],[{"text":"Germany"},{"text":"University of Bremen, GEOMAR-linked programmes, Kiel University"},{"text":"DAAD + university funding"},{"text":"Programme/degree equivalence"}],[{"text":"Netherlands"},{"text":"TU Delft, Wageningen University, Utrecht University"},{"text":"University scholarships"},{"text":"Programme-specific requirements"}],[{"text":"Australia"},{"text":"University of Tasmania, University of Sydney, University of Queensland"},{"text":"RTP + university scholarships"},{"text":"Programme + English requirements"}],[{"text":"Canada"},{"text":"University of British Columbia, Dalhousie University, Memorial University"},{"text":"University funding + scholarships"},{"text":"Programme-specific requirements"}]]},{"type":"h","text":"Application portfolio"},{"type":"p","text":"Build:"},{"type":"list","items":[{"text":"Strong B.Sc. academic record"},{"text":"Marine/oceanography research project"},{"text":"Field or laboratory internship"},{"text":"GIS/remote-sensing project"},{"text":"Python/R data-analysis project"},{"text":"Academic CV"},{"text":"Statement of purpose/research statement"},{"text":"Strong recommendation letters"},{"text":"Research poster/publication where possible"},{"text":"English-language test where required"}]},{"type":"p","text":"For research programmes, identify specific laboratories and supervisors whose research matches your interests rather than applying only by university name."}]},{"heading":"Going forward","kind":"growth","blocks":[{"type":"h","text":"Career progression"},{"type":"flow","items":["Marine Research Intern","Research Assistant","Project/Research Associate","Scientist","Senior Scientist","Principal Scientist","Research Lead/Director"]},{"type":"p","text":"Alternative technical route:"},{"type":"flow","items":["Marine Research Assistant","Ocean Data Analyst","Ocean Data Scientist","Senior Ocean Data Scientist","Marine AI/Modelling Lead"]},{"type":"h","text":"PhD specialisations"},{"type":"list","items":[{"text":"Physical Oceanography"},{"text":"Chemical Oceanography"},{"text":"Biological Oceanography"},{"text":"Geological Oceanography"},{"text":"Marine Ecology"},{"text":"Marine Geophysics"},{"text":"Ocean-Atmosphere Interaction"},{"text":"Climate and Ocean Science"},{"text":"Coastal Oceanography"},{"text":"Marine Pollution"},{"text":"Marine Biogeochemistry"},{"text":"Ocean Modelling"},{"text":"Marine Remote Sensing"},{"text":"Ocean Data Science"},{"text":"Marine Conservation"},{"text":"Polar Oceanography"},{"text":"Deep-Sea Science"},{"text":"Marine Biotechnology"}]},{"type":"h","text":"2040–2046"},{"type":"p","text":"A high-value long-term profile combines marine domain expertise with computational and observational capabilities. Researchers who can work with autonomous ocean platforms, satellite observations, climate datasets, numerical models, GIS and AI will be positioned for increasingly interdisciplinary marine-science roles."}]}]}