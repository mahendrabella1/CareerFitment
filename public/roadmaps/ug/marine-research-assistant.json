y"},{"text":"Cartopy"},{"text":"scikit-learn"}]},{"type":"h","text":"R"},{"type":"list","items":[{"text":"tidyverse"},{"text":"ggplot2"},{"text":"spatial analysis"},{"text":"statistical modelling"}]},{"type":"h","text":"Scientific data formats"},{"type":"p","text":"Learn to work with:"},{"type":"list","items":[{"text":"NetCDF"},{"text":"HDF"},{"text":"CSV"},{"text":"GeoTIFF"},{"text":"GRIB concepts"}]},{"type":"h","text":"Important ocean datasets/tools"},{"type":"list","items":[{"text":"NOAA datasets"},{"text":"NASA Earth observation data"},{"text":"Copernicus Marine data"},{"text":"Argo ocean observations"},{"text":"GEBCO bathymetry"},{"text":"Ocean Data View (ODV)"}]},{"type":"h","text":"Specialisation"},{"type":"table","header":["Lane","Core stack","Learn from","Senior role it leads to"],"rows":[[{"text":"Physical Oceanography"},{"text":"Ocean circulation + modelling + Python"},{"text":"Research labs + ocean datasets"},{"text":"Physical Oceanographer"}],[{"text":"Marine Biology"},{"text":"Ecology + biodiversity + fieldwork"},{"text":"Marine institutes"},{"text":"Marine Biologist"}],[{"text":"Chemical Oceanography"},{"text":"Marine chemistry + analytical methods"},{"text":"Marine laboratories"},{"text":"Chemical Oceanographer"}],[{"text":"Geological Oceanography"},{"text":"Sediments + marine geology + GIS"},{"text":"Geological/ocean institutes"},{"text":"Marine Geologist"}],[{"text":"Climate & Ocean Science"},{"text":"Climate + ocean-atmosphere + modelling"},{"text":"Climate research groups"},{"text":"Climate Scientist"}],[{"text":"Marine Pollution"},{"text":"Chemistry + toxicology + environmental monitoring"},{"text":"Environmental laboratories"},{"text":"Marine Pollution Scientist"}],[{"text":"Remote Sensing"},{"text":"GIS + satellite data + Python"},{"text":"Earth-observation programmes"},{"text":"Marine Remote Sensing Scientist"}],[{"text":"Ocean Modelling"},{"text":"Mathematics + numerical modelling + HPC"},{"text":"Research institutes"},{"text":"Ocean Modeller"}],[{"text":"Marine Data Science"},{"text":"Python + statistics + ML + ocean datasets"},{"text":"Open datasets/research groups"},{"text":"Ocean Data Scientist"}],[{"text":"Coastal Science"},{"text":"Coastal processes + GIS + remote sensing"},{"text":"Coastal research institutes"},{"text":"Coastal Scientist"}]]},{"type":"h","text":"Evolve and stay relevant, 2035–2046"},{"type":"p","text":"Build the combination of ocean science + data science + remote sensing + numerical modelling. Future marine research increasingly depends on large observational datasets, autonomous platforms, satellite observations, climate models and AI-assisted analysis."}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"h","text":"Government and research organisations"},{"type":"table","header":["Organisation","Relevant exposure"],"rows":[[{"text":"National Institute of Ocean Technology (NIOT)","url":"https://www.niot.res.in/"},{"text":"Ocean technology, instrumentation and marine observations"}],[{"text":"National Centre for Coastal Research (NCCR)","url":"https://nccr.gov.in/"},{"text":"Coastal and marine research"}],[{"text":"National Centre for Antarctic and Ocean Research (NCPOR)","url":"https://ncpor.res.in/"},{"text":"Polar and ocean research"}],[{"text":"CSIR-National Institute of Oceanography (CSIR-NIO)","url":"https://www.nio.res.in/"},{"text":"Oceanography, marine biology, chemistry and geology"}],[{"text":"Indian National Centre for Ocean Information Services (INCOIS)","url":"https://incois.gov.in/"},{"text":"Ocean observations, forecasting and marine data"}],[{"text":"Indian Institute of Tropical Meteorology (IITM)","url":"https://www.tropmet.res.in/"},{"text":"Climate-ocean interactions"}],[{"text":"Indian Space Research Organisation (ISRO)","url":"https://www.isro.gov.in/"},{"text":"Ocean remote sensing and Earth observation"}],[{"text":"National Institute of Oceanography (NIO)","url":"https://www.nio.res.in/"},{"text":"Marine research and field studies"}]]},{