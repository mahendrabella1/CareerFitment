rs"},{"text":"Impact indicators"},{"text":"Data quality"},{"text":"Evaluation methodology"}]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"For NGO careers, field experience is one of the most important employability factors."},{"type":"h","text":"Target organisations"},{"type":"p","text":"Look for:"},{"type":"list","items":[{"text":"Tribal development NGOs"},{"text":"Rural development NGOs"},{"text":"Education NGOs"},{"text":"Healthcare NGOs"},{"text":"Livelihood organisations"},{"text":"Women's development organisations"},{"text":"Child-rights organisations"},{"text":"Indigenous/community organisations"},{"text":"Human-rights organisations"},{"text":"Environmental NGOs"},{"text":"Social enterprises"},{"text":"CSR foundations"},{"text":"Development research organisations"},{"text":"Humanitarian organisations"}]},{"type":"h","text":"Internship titles"},{"type":"p","text":"Search for:"},{"type":"list","items":[{"text":"NGO Intern"},{"text":"Program Intern"},{"text":"Project Intern"},{"text":"Field Intern"},{"text":"Community Development Intern"},{"text":"Research Intern"},{"text":"Monitoring & Evaluation Intern"},{"text":"Social Impact Intern"},{"text":"Development Intern"},{"text":"Livelihood Programme Intern"}]},{"type":"h","text":"Ideal progression"},{"type":"flow","items":["Volunteer/community experience","Year 2: Field research internship","Year 3: Programme/M&E internship","Year 4: Programme management internship"],"label":"Year 1"}]},{"heading":"Community Engagement Skills","kind":"other","blocks":[{"type":"p","text":"Because Tribal/Regional Studies is strongly community-oriented, develop practical field capabilities."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Participatory Rural Appraisal"},{"text":"Community meetings"},{"text":"Focus group discussions"},{"text":"Key informant interviews"},{"text":"Household surveys"},{"text":"Community mapping"},{"text":"Needs assessment"},{"text":"Stakeholder consultation"},{"text":"Local-language communication"},{"text":"Conflict-sensitive engagement"}]},{"type":"h","text":"Important professional principle"},{"type":"p","text":"When working with indigenous or tribal communities, the professional should respect:"},{"type":"list","items":[{"text":"Informed consent"},{"text":"Cultural practices"},{"text":"Community ownership"},{"text":"Local leadership"},{"text":"Privacy"},{"text":"Data protection"},{"text":"Indigenous knowledge"},{"text":"Safeguarding"},{"text":"Do-no-harm principles"}]},{"type":"p","text":"Avoid treating communities simply as \"beneficiaries\"; strong development practice involves participation and local decision-making."}]},{"heading":"Certifications & Learning","kind":"certifications","blocks":[{"type":"p","text":"Certificates should complement field experience."},{"type":"h","text":"High-value areas"},{"type":"list","items":[{"text":"Monitoring & Evaluation"},{"text":"Project Management"},{"text":"Development Studies"},{"text":"Social Research"},{"text":"Community Development"},{"text":"Human Rights"},{"text":"Public Policy"},{"text":"Data Analytics"},{"text":"GIS"},{"text":"Grant/Proposal Writing"},{"text":"NGO Management"},{"text":"Impact Evaluation"}]},{"type":"h","text":"Technical learning"},{"type":"p","text":"Prioritise:"},{"type":"flow","items":["Advanced Excel","Power BI","KoboToolbox/ODK","QGIS","Basic SQL","Basic Python"]}]},{"heading":"Programme Proposal Skills","kind":"other","blocks":[{"type":"p","text":"An NGO Program Officer should eventually be able to create a basic project proposal."},{"type":"p","text":"Learn how to structure:"},{"type":"list","items":[{"text":"Executive summary"},{"text":"Background"},{"text":"Problem statement"},{"text":"Target population"},{"text":"Needs assessment"},{"text":"Programme objectives"},{"text":"Activities"},{"text":"Implementation plan"},{"text":"Timeline"},{"text":"Budget"},{"text":"Monitoring framework"},{"text":"Risk management"},{"text":"Sustainability"},{"t