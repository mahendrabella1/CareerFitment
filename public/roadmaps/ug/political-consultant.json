"}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"type":"p","text":"After BBA, realistic roles include:"},{"type":"list","items":[{"text":"Political Research Associate"},{"text":"Political Research Analyst"},{"text":"Political Consultant Trainee"},{"text":"Campaign Associate"},{"text":"Campaign Operations Associate"},{"text":"Public Policy Associate"},{"text":"Policy Research Associate"},{"text":"Public Affairs Associate"},{"text":"Governance Analyst"},{"text":"Research Analyst"},{"text":"Constituency Research Associate"},{"text":"Political Data Analyst"},{"text":"Survey Research Associate"},{"text":"Communications Associate"},{"text":"Legislative Research Assistant"},{"text":"Government Relations Associate"},{"text":"Development Programme Associate"},{"text":"Strategy Associate"}]}]},{"heading":"Postgraduate Options in India","kind":"pg_india","blocks":[{"type":"h","text":"Management"},{"type":"list","items":[{"text":"MBA Public Policy"},{"text":"MBA Strategy"},{"text":"MBA Business Analytics"},{"text":"MBA Public Affairs"},{"text":"MBA Political Management where available"}]},{"type":"h","text":"Social Sciences & Policy"},{"type":"list","items":[{"text":"MA Public Policy"},{"text":"MA Political Science"},{"text":"MA Public Administration"},{"text":"MA International Relations"},{"text":"MA Development Studies"},{"text":"MSc Public Policy"},{"text":"MSc Political Economy"}]},{"type":"h","text":"Quantitative"},{"type":"list","items":[{"text":"MSc Data Analytics"},{"text":"MSc Statistics"},{"text":"MSc Economics"},{"text":"MSc Development Economics"}]},{"type":"p","text":"Programme eligibility should be checked individually because some policy/economics programmes require specific undergraduate coursework."}]},{"heading":"Study Abroad","kind":"abroad","blocks":[{"type":"p","text":"Relevant programmes include:"},{"type":"list","items":[{"text":"Master of Public Policy (MPP)"},{"text":"Master of Public Administration (MPA)"},{"text":"MSc Public P