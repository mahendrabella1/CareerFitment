 brief"},{"text":"1 consulting-style strategy presentation"},{"text":"1 public-policy/political research internship"}]},{"type":"flow","items":["Strong Excel","SQL","Power BI","statistics skills"],"sep":"+"},{"type":"list","items":[{"text":"Strong research and professional writing ability"}]},{"type":"h","text":"Target Graduate Profile"},{"type":"flow","items":["BBA Public Policy/Political Management","Political Science & Governance","Economics","Public Policy","Political Research","Survey Research","Constituency Analysis","Campaign & Political Operations","Data Analytics","GIS","Policy Evaluation","Political/Public-Affairs Internship","Research/Policy Associate","Political Consultant","Senior Consultant","Project Lead","Director / Public Policy & Political Strategy Leadership"]},{"type":"table","header":["ID","Level","Stream","Degree","Specialization","Career",""],"rows":[[{"text":"1344"},{"text":"UG"},{"text":"Management"},{"text":"BBA / BMS / BBM (Bachelor of Business Administration / Management Studies)"},{"text":"BBA – Public Policy / Political Management"},{"text":"Government Affairs Executive"},{"text":""}]]}]}]}