ory"},{"text":"Performance"},{"text":"Stagecraft"}]},{"type":"h","text":"Broadcasting"},{"type":"list","items":[{"text":"Radio presentation"},{"text":"Voice modulation"},{"text":"Broadcasting"},{"text":"Scriptwriting"},{"text":"Interviewing"}]},{"type":"h","text":"Audio"},{"type":"list","items":[{"text":"Audio engineering"},{"text":"Sound recording"},{"text":"Audio editing"},{"text":"Podcast production"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Social media"},{"text":"Digital content"},{"text":"YouTube/podcast distribution"},{"text":"Audience analytics"}]},{"type":"h","text":"Portfolio Strategy"},{"type":"p","text":"A Radio Artist should graduate with a professional audio portfolio."},{"type":"h","text":"Recommended portfolio"},{"type":"h","text":"1. Radio demo reel"},{"type":"p","text":"3–5 minutes showing:"},{"type":"list","items":[{"text":"introduction"},{"text":"music presentation"},{"text":"transitions"},{"text":"voice modulation"},{"text":"personality"}]},{"type":"h","text":"2. Podcast series"},{"type":"p","text":"Produce 5–10 episodes."},{"type":"h","text":"3. Music performance recordings"},{"type":"p","text":"Include high-quality vocal/instrumental recordings."},{"type":"h","text":"4. Interview portfolio"},{"type":"p","text":"Interview:"},{"type":"list","items":[{"text":"musicians"},{"text":"artists"},{"text":"teachers"},{"text":"cultural experts"}]},{"type":"h","text":"5. Audio production project"},{"type":"p","text":"Show:"},{"type":"list","items":[{"text":"raw recording"},{"text":"edited version"},{"text":"sound design"},{"text":"final broadcast version"}]},{"type":"h","text":"6. Digital content portfolio"},{"type":"p","text":"Connect radio/audio content with:"},{"type":"list","items":[{"text":"Instagram"},{"text":"YouTube"},{"text":"podcast platforms"},{"text":"short-form video"}]}]},{"heading":"PG Study Options","kind":"pg_india","blocks":[{"type":"p","text":"A postgraduate degree is not mandatory for becoming a radio artist."},{