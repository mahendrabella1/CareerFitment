{"title":"Vedic Studies Scholar Roadmap","role":"Vedic Studies Scholar","summary":"Study important interpretive traditions and commentarial approaches without treating any single interpretation as the only scholarly position.","facts":{"Current degree":"BA (General / Honours) — Sanskrit"},"about":[],"intro":[],"horizons":[],"sections":[{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Stage","Typical Roles"],"rows":[[{"text":"Entry"},{"text":"Research Assistant, Sanskrit Research Intern, Academic Assistant"}],[{"text":"Early Career"},{"text":"Vedic Studies Researcher, Project Researcher, Sanskrit Scholar"}],[{"text":"Academic"},{"text":"PhD Scholar, Research Fellow, Assistant Professor"}],[{"text":"Mid Career"},{"text":"Senior Researcher, Sanskrit/Vedic Studies Faculty"}],[{"text":"Senior"},{"text":"Professor, Research Director, Vedic Studies Centre Head"}],[{"text":"Alternative"},{"text":"Manuscript Specialist, Translator, Digital Humanities Researcher"}]]}]},{"heading":"What to Build Each Year","kind":"build","blocks":[{"type":"h","text":"Year 1 — Sanskrit Foundation"},{"type":"p","text":"Study:"},{"type":"list","items":[{"text":"Sanskrit grammar"},{"text":"Sandhi"},{"text":"Samasa"},{"text":"Dhatu systems"},{"text":"Sanskrit vocabulary"},{"text":"Basic translation"},{"text":"Introduction to Vedic literature"},{"text":"Indian philosophy"},{"text":"Indian cultural history"}]},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"Devanagari proficiency"},{"text":"Sanskrit reading"},{"text":"Transliteration"},{"text":"Academic writing"},{"text":"Text annotation"},{"text":"Research note-taking"}]},{"type":"p","text":"Become familiar with:"},{"type":"list","items":[{"text":"Rigveda"},{"text":"Samaveda"},{"text":"Yajurveda"},{"text":"Atharvaveda"}]},{"type":"note","label":"Project","text":"Select a small set of Sanskrit passages and prepare their Devanagari text, transliteration, literal translation, and grammatical analysis."