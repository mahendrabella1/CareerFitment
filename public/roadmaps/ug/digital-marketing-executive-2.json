}],[{"text":"Singapore"},{"text":"E-commerce and digital marketing"}],[{"text":"Netherlands"},{"text":"Marketing analytics and digital commerce"}]]}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"Performance marketing route"},{"type":"flow","items":["Digital Marketing Executive","Performance Marketing Specialist","Senior Performance Marketer","Growth Marketing Manager","Head of Growth"]},{"type":"h","text":"SEO route"},{"type":"flow","items":["SEO Executive","SEO Specialist","Senior SEO Specialist","SEO Manager","Head of SEO"]},{"type":"h","text":"General marketing route"},{"type":"flow","items":["Digital Marketing Executive","Digital Marketing Manager","Senior Marketing Manager","Head of Digital Marketing","Marketing Director"]},{"type":"h","text":"Analytics route"},{"type":"flow","items":["Marketing Analyst","Marketing Analytics Specialist","Growth Analyst","Growth/Marketing Analytics Manager"]}]},{"heading":"Emerging Technologies","kind":"other","blocks":[{"type":"p","text":"Digital marketing is increasingly influenced by:"},{"type":"list","items":[{"text":"Generative AI"},{"text":"AI-powered search"},{"text":"Marketing automation"},{"text":"Predictive analytics"},{"text":"Customer data platforms"},{"text":"Personalization"},{"text":"Conversational AI"},{"text":"AI creative tools"},{"text":"Automated campaign optimization"},{"text":"Retail media"},{"text":"First-party data strategies"},{"text":"Marketing mix modelling"}]},{"type":"p","text":"The future marketer will increasingly work at the intersection of:"},{"type":"flow","items":["Marketing","Data","Technology","AI"],"sep":"+"}]},{"heading":"Recommended Final Skill Stack","kind":"other","blocks":[{"type":"h","text":"Acquisition"},{"type":"flow","items":["SEO","Google Ads","Meta Ads","Social Media"],"sep":"+"},{"type":"h","text":"Content"},{"type":"flow","items":["Copywriting","Video","Content Strategy","Storytelling"],"sep":"+"},{"type":"h","text":"Analytics"},{"type":"flow","i