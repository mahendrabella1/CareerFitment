:"Institutions"},{"text":"Festivals"},{"text":"Philosophical ideas"},{"text":"Social influence"}]},{"type":"p","text":"Avoid reducing complex traditions to simplistic lists of similarities and differences."},{"type":"h","text":"Teaching Skills"},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"Lesson planning"},{"text":"Educational psychology"},{"text":"Classroom management"},{"text":"Question design"},{"text":"Discussion facilitation"},{"text":"Assessment"},{"text":"Inclusive teaching"}]},{"type":"h","text":"Portfolio"},{"type":"p","text":"Create:"},{"type":"list","items":[{"text":"10 lesson plans"},{"text":"5 comparative-religion presentations"},{"text":"5 classroom activities"},{"text":"3 educational videos"},{"text":"3 discussion guides"}]},{"type":"h","text":"Year 3 — Curriculum + Research"},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"Curriculum mapping"},{"text":"Religious literacy"},{"text":"Interfaith education"},{"text":"Ethics education"},{"text":"Historical interpretation"},{"text":"Textual analysis"},{"text":"Research methodology"},{"text":"Student assessment"}]},{"type":"h","text":"Digital Teaching"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"PowerPoint"},{"text":"Google Workspace"},{"text":"LMS platforms"},{"text":"Digital quizzes"},{"text":"Video lessons"},{"text":"Interactive timelines"},{"text":"Digital archives"}]},{"type":"h","text":"Strong Project"},{"type":"p","text":"Create a complete:"},{"type":"h","text":"Comparative Religion Learning Module"},{"type":"p","text":"Example structure:"},{"type":"flow","items":["Buddhism","Historical Context","Core Teachings","Texts","Practices","Ethics","Cultural Influence","Modern Context"]},{"type":"p","text":"Repeat the framework for other traditions while preserving their individual historical and theological contexts."},{"type":"h","text":"Year 4 — Professional Teaching Preparation"},{"type":"p","text":"Develop:"},{"type":"list","items":[{"text":"Classro