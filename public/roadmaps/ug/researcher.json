iate"},{"text":"Research Analyst"},{"text":"Policy Research Associate"},{"text":"Social Research Associate"},{"text":"Programme Research Associate"},{"text":"Academic Research Assistant"},{"text":"Research Executive"}]},{"type":"h","text":"Specialist"},{"type":"list","items":[{"text":"Policy Researcher"},{"text":"Social Researcher"},{"text":"Ethics Researcher"},{"text":"AI Ethics Researcher"},{"text":"Education Researcher"},{"text":"Governance Researcher"},{"text":"Sustainability Researcher"},{"text":"Research Consultant"}]},{"type":"h","text":"Senior"},{"type":"list","items":[{"text":"Senior Researcher"},{"text":"Senior Research Associate"},{"text":"Research Lead"},{"text":"Research Manager"},{"text":"Research Program Manager"},{"text":"Research Director"}]},{"type":"h","text":"What Employers / Research Institutions May Test"},{"type":"h","text":"Research design"},{"type":"note","label":"Question","text":"How would you investigate whether AI is affecting student learning?"},{"type":"p","text":"A strong approach:"},{"type":"list","items":[{"text":"Define the research question"},{"text":"Review existing literature"},{"text":"Define variables"},{"text":"Select population/sample"},{"text":"Design research methodology"},{"text":"Collect data"},{"text":"Analyse results"},{"text":"Consider limitations"},{"text":"Draw evidence-based conclusions"}]},{"type":"h","text":"Critical thinking"},{"type":"p","text":"What is the difference between an argument and an opinion?"},{"type":"p","text":"An argument provides reasons/evidence intended to support a conclusion; an opinion may be a belief or judgement without a developed evidentiary structure."},{"type":"h","text":"Research quality"},{"type":"p","text":"How do you determine whether a source is reliable?"},{"type":"p","text":"Consider:"},{"type":"list","items":[{"text":"Author expertise"},{"text":"Publication venue"},{"text":"Methodology"},{"text":"Evidence"},{"text":"Citations"},{"text":"Peer review where applicable"},{"text":"