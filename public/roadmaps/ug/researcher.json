s","ML fundamentals","AI systems","AI governance","AI ethics"]},{"type":"h","text":"Interested in academic research"},{"type":"p","text":"Prioritise:"},{"type":"flow","items":["Research methodology","dissertation","publications","conferences","MA","PhD"]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Research experience is extremely important."},{"type":"h","text":"Seek opportunities with"},{"type":"list","items":[{"text":"Universities"},{"text":"Think tanks"},{"text":"Policy institutes"},{"text":"Research organisations"},{"text":"NGOs"},{"text":"Public-policy organisations"},{"text":"Social research organisations"},{"text":"Academic research centres"},{"text":"Ethics/research institutes"},{"text":"Digital humanities laboratories"},{"text":"Education research organisations"},{"text":"Technology-policy organisations"}]},{"type":"h","text":"Useful internship responsibilities"},{"type":"list","items":[{"text":"Literature review"},{"text":"Data collection"},{"text":"Survey research"},{"text":"Interview transcription"},{"text":"Qualitative coding"},{"text":"Policy research"},{"text":"Desk research"},{"text":"Data analysis"},{"text":"Report writing"},{"text":"Research documentation"},{"text":"Research presentation"}]},{"type":"h","text":"Build a Research Portfolio"},{"type":"p","text":"Create a professional portfolio containing:"},{"type":"h","text":"1. Research papers"},{"type":"p","text":"2–4 strong papers are more valuable than many superficial certificates."},{"type":"h","text":"2. Literature review"},{"type":"p","text":"Show:"},{"type":"list","items":[{"text":"Search methodology"},{"text":"Source evaluation"},{"text":"Research gaps"}]},{"type":"h","text":"3. Data project"},{"type":"p","text":"Example:"},{"type":"h","text":"Public attitudes toward AI ethics"},{"type":"p","text":"Use:"},{"type":"list","items":[{"text":"Survey"},{"text":"Excel/Python"},{"text":"Statistical analysis"},{"text":"Visualisations"},{"text":"Research findings"}]