":"h","text":"Chief Data / Analytics Leadership"}]},{"heading":"Business Intelligence Route","kind":"other","blocks":[{"type":"p","text":"A strong technical MIS Analyst can transition into:"},{"type":"h","text":"MIS Analyst"},{"type":"flow","items":["BI Analyst","BI Developer","Senior BI Developer","BI Architect / BI Manager"]},{"type":"p","text":"Skills:"},{"type":"list","items":[{"text":"SQL"},{"text":"Power BI"},{"text":"DAX"},{"text":"Data modelling"},{"text":"ETL"},{"text":"Data warehouses"},{"text":"Cloud"},{"text":"Data governance"}]},{"type":"p","text":"This is one of the strongest technical career paths from MIS."}]},{"heading":"Business Analyst Route","kind":"other","blocks":[{"type":"p","text":"Another pathway is:"},{"type":"h","text":"MIS Analyst"},{"type":"flow","items":["Business Analyst","Senior Business Analyst","Product/Business Consultant","Business Analysis Manager"]},{"type":"p","text":"The student should strengthen:"},{"type":"list","items":[{"text":"Requirements gathering"},{"text":"Process modelling"},{"text":"Stakeholder management"},{"text":"Business process analysis"},{"text":"User stories"},{"text":"BRDs/FRDs"},{"text":"SQL"},{"text":"Data analysis"}]}]},{"heading":"Analytics Route","kind":"other","blocks":[{"type":"p","text":"For students who want deeper data science:"},{"type":"h","text":"MIS Analyst"},{"type":"flow","items":["Data Analyst","Senior Data Analyst","Analytics Specialist","Data Scientist / Analytics Manager"]},{"type":"p","text":"Additional skills:"},{"type":"list","items":[{"text":"Python"},{"text":"Statistics"},{"text":"Machine Learning"},{"text":"Forecasting"},{"text":"Experimentation"},{"text":"Data engineering fundamentals"}]}]},{"heading":"AI and Future of MIS","kind":"other","blocks":[{"type":"p","text":"Traditional MIS:"},{"type":"flow","items":["Collect","Clean","Report"]},{"type":"p","text":"Future AI-enabled MIS:"},{"type":"flow","items":["Collect","Clean","Analyse","Explain","Predict","Recommend","Act"]},{"type":