s"},{"text":"Flooring plans"},{"text":"Wall elevations"},{"text":"Joinery"},{"text":"Millwork"},{"text":"Material schedules"},{"text":"Door schedules"},{"text":"Lighting layouts"},{"text":"Interior details"},{"text":"Wet-area detailing"},{"text":"Kitchen detailing"},{"text":"Bathroom detailing"}]},{"type":"h","text":"Building systems"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"HVAC"},{"text":"Electrical"},{"text":"Plumbing"},{"text":"Fire protection"},{"text":"Lighting"},{"text":"Acoustics"},{"text":"Building structure"},{"text":"The Design Manager must understand enough of every system to coordinate them effectively."}]},{"type":"h","text":"Year 2–3 — BIM"},{"type":"p","text":"BIM becomes a major career accelerator for Design Management."},{"type":"h","text":"Priority"},{"type":"h","text":"Revit"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Architectural modelling"},{"text":"Families"},{"text":"Materials"},{"text":"Schedules"},{"text":"Sheets"},{"text":"Detailing"},{"text":"Phasing"},{"text":"Design options"},{"text":"Worksharing"},{"text":"Model coordination"}]},{"type":"p","text":"Then understand:"},{"type":"list","items":[{"text":"Navisworks"},{"text":"Clash detection"},{"text":"BIM coordination"},{"text":"Model federation"},{"text":"Common Data Environments"},{"text":"BIM information management"}]},{"type":"h","text":"Design coordination"},{"type":"list","items":[{"text":"Architecture"},{"text":"+"},{"text":"Interior"},{"text":"+"},{"text":"Structure"},{"text":"+"},{"text":"HVAC"},{"text":"+"},{"text":"Electrical"},{"text":"+"},{"text":"Plumbing"},{"text":"+"}]},{"type":"flow","items":["Fire","Federated BIM Model","Clash Detection","Design Resolution","Construction Documentation"]},{"type":"h","text":"Year 3 — Project & Design Management"},{"type":"p","text":"This is the transition from designer to design coordinator."},{"type":"h","text":"Learn"},{"type":"list","items":[{"text":"Design briefs"},{"text":"Project scope"