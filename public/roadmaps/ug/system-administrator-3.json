":[{"text":"Install and administer Linux systems"},{"text":"Manage Windows Server environments"},{"text":"Configure users and permissions"},{"text":"Troubleshoot networking"},{"text":"Configure DNS and DHCP"},{"text":"Manage SSH"},{"text":"Deploy web services"},{"text":"Manage storage"},{"text":"Monitor system performance"},{"text":"Configure backups"},{"text":"Perform basic disaster recovery"},{"text":"Understand virtualization"},{"text":"Deploy basic cloud infrastructure"},{"text":"Configure IAM"},{"text":"Automate tasks using Bash/Python/PowerShell"},{"text":"Use Ansible"},{"text":"Understand Terraform"},{"text":"Use Git"},{"text":"Work with Docker"},{"text":"Understand Kubernetes fundamentals"},{"text":"Investigate incidents systematically"},{"text":"Document infrastructure"}]},{"type":"h","text":"Ideal Portfolio"},{"type":"p","text":"Build 5–7 infrastructure projects rather than only coding projects."},{"type":"h","text":"Recommended portfolio"},{"type":"h","text":"Linux Server Administration Lab"},{"type":"h","text":"Active Directory / Windows Server Lab"},{"type":"h","text":"Network Troubleshooting Lab"},{"type":"h","text":"Cloud Infrastructure Deployment"},{"type":"h","text":"Automated Server Configuration with Ansible"},{"type":"h","text":"Prometheus + Grafana Monitoring System"},{"type":"h","text":"Terraform + Cloud Infrastructure Project"},{"type":"p","text":"A strong project should demonstrate:"},{"type":"flow","items":["Infrastructure Requirement","Architecture","Deployment","Security","Automation","Monitoring","Backup","Failure Testing","Documentation"]},{"type":"h","text":"Best Overall Positioning"},{"type":"p","text":"The strongest positioning is:"},{"type":"p","text":"“A systems-focused computer science professional who can administer Linux and Windows infrastructure, troubleshoot networks, secure systems, automate operations, manage cloud resources and build reliable infrastructure through modern DevOps practices.”"},{"type":"h","text":"Recommended progression"},{"type":"flow","items":["B.Sc. Computer Science","Operating Systems + Networking","Linux","Windows Server","Server Administration","Virtualization","Cloud","Security + Monitoring","Bash / Python / PowerShell","Ansible + Terraform","System Administrator","Cloud / Infrastructure Engineer","DevOps / SRE / Platform Engineer","Infrastructure / Cloud Architect"]},{"type":"flow","items":["Linux","Networking","Cloud","Security","Bash/Python","Ansible","Terraform","Monitoring","Docker/Kubernetes","Infrastructure as Code."],"sep":"+","label":"Best long-term combination"}]}]}