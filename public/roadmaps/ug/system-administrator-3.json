oute."},{"type":"h","text":"5. Site Reliability Engineer"},{"type":"flow","items":["Infrastructure","Automation","Monitoring","Software Engineering"],"sep":"+"},{"type":"p","text":"Requires deeper programming and distributed-systems knowledge."},{"type":"h","text":"6. Infrastructure Security"},{"type":"flow","items":["Linux","Networking","IAM","Security","Monitoring"],"sep":"+"},{"type":"p","text":"Suitable for candidates interested in cybersecurity."}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"Route 1 — Traditional Systems"},{"type":"flow","items":["B.Sc. Computer Science","IT Support / Junior SysAdmin","System Administrator","Senior System Administrator","Infrastructure Lead","IT Infrastructure Manager","Infrastructure Director"]},{"type":"h","text":"Route 2 — Cloud"},{"type":"flow","items":["B.Sc. Computer Science","System Administrator","Cloud Administrator","Cloud Engineer","Senior Cloud Engineer","Cloud Infrastructure Lead","Cloud Architect"]},{"type":"h","text":"Route 3 — DevOps"},{"type":"flow","items":["B.Sc. Computer Science","System Administrator","Linux / Cloud Administrator","DevOps Engineer","Senior DevOps Engineer","Platform Engineer","DevOps / Platform Lead"]},{"type":"h","text":"Route 4 — SRE"},{"type":"flow","items":["B.Sc. Computer Science","System Administrator","Infrastructure Engineer","SRE","Senior SRE","Reliability Lead","SRE / Platform Engineering Manager"]},{"type":"h","text":"Emerging Technologies"},{"type":"h","text":"1. Infrastructure Automation"},{"type":"p","text":"Manual administration is increasingly being replaced by:"},{"type":"list","items":[{"text":"Infrastructure as Code"},{"text":"Configuration management"},{"text":"Automated patching"},{"text":"Automated provisioning"},{"text":"Self-service infrastructure"}]},{"type":"h","text":"2. AI-Assisted Operations"},{"type":"p","text":"AIOps platforms can help identify:"},{"type":"list","items":[{"text":"Anomalies"},{"text":"Infrastructure failures"}