es"},{"text":"Blood conservation"}]},{"type":"h","text":"Year 1 objective"},{"type":"p","text":"Develop a strong understanding of cardiovascular, respiratory and blood physiology before progressing into extracorporeal support."},{"type":"h","text":"Year 2 — Perfusion Technology Foundation"},{"type":"p","text":"The student should develop strong understanding of cardiopulmonary bypass and extracorporeal circulation."},{"type":"h","text":"Perfusion principles"},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Extracorporeal circulation"},{"text":"Blood-flow principles"},{"text":"Pump systems"},{"text":"Oxygenators"},{"text":"Heat exchangers"},{"text":"Reservoirs"},{"text":"Cannulation concepts"},{"text":"Arterial and venous circuits"},{"text":"Pressure monitoring"}]},{"type":"h","text":"Cardiopulmonary bypass"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"CPB circuit components"},{"text":"Priming concepts"},{"text":"Pump flow"},{"text":"Oxygenation"},{"text":"Ventilation during bypass"},{"text":"Temperature management"},{"text":"Hemoconcentration"},{"text":"Anticoagulation monitoring"}]},{"type":"h","text":"Equipment"},{"type":"p","text":"Become familiar with:"},{"type":"list","items":[{"text":"Roller pumps"},{"text":"Centrifugal pumps"},{"text":"Oxygenators"},{"text":"Heat exchangers"},{"text":"Cardioplegia systems"},{"text":"Pressure monitors"},{"text":"Blood gas analysis"},{"text":"Temperature monitoring"}]},{"type":"h","text":"Year 3 — Advanced Perfusion & ECMO Foundation"},{"type":"h","text":"ECMO principles"},{"type":"p","text":"Understand:"},{"type":"list","items":[{"text":"Extracorporeal life support"},{"text":"VV ECMO"},{"text":"VA ECMO"},{"text":"Veno-arterial support"},{"text":"Veno-venous support"},{"text":"Oxygenation"},{"text":"CO₂ removal"},{"text":"Blood-flow requirements"},{"text":"Preload and afterload concepts"},{"text":"Native cardiac output"},{"text":"Native lung function"}]},{"type":"h","text":"ECMO circuit"},{"t