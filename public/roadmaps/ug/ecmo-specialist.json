"},{"text":"Adult VA ECMO"},{"text":"Cardiogenic shock"},{"text":"Severe respiratory failure"}]},{"type":"h","text":"2. Pediatric ECMO"},{"type":"p","text":"Requires additional specialized training in:"},{"type":"list","items":[{"text":"Pediatric physiology"},{"text":"Pediatric cannulation"},{"text":"Neonatal critical care"},{"text":"Pediatric circuit management"}]},{"type":"h","text":"3. Cardiac ECMO"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Cardiogenic shock"},{"text":"Post-cardiotomy support"},{"text":"Cardiac arrest support"},{"text":"Advanced cardiac ICU"}]},{"type":"h","text":"4. Respiratory ECMO"},{"type":"p","text":"Focus on:"},{"type":"list","items":[{"text":"Severe respiratory failure"},{"text":"VV ECMO"},{"text":"Lung-protective strategies"}]},{"type":"h","text":"5. ECMO + CRRT"},{"type":"p","text":"Specialize in patients requiring:"},{"type":"list","items":[{"text":"Extracorporeal respiratory/cardiac support"},{"text":"Renal replacement"},{"text":"Complex fluid management"}]},{"type":"h","text":"6. ECMO Education & Simulation"},{"type":"p","text":"Develop expertise in:"},{"type":"list","items":[{"text":"Simulation"},{"text":"Emergency drills"},{"text":"Team training"},{"text":"Protocol development"},{"text":"Clinical education"}]}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"Clinical pathway"},{"type":"flow","items":["Perfusion / Cardiovascular Technologist","ECMO Trainee","ECMO Specialist","Senior ECMO Specialist","Lead ECMO Specialist","ECMO Coordinator"]},{"type":"h","text":"Advanced specialty pathway"},{"type":"flow","items":["ECMO Specialist","Adult ECMO"]},{"type":"p","text":"+"},{"type":"p","text":"Cardiac ECMO"},{"type":"p","text":"+"},{"type":"flow","items":["CRRT","Advanced ECMO Specialist"]},{"type":"h","text":"Education pathway"},{"type":"flow","items":["ECMO Specialist","Clinical Experience","ECMO Educator","Simulation / Training Lead","ECMO Program Education Coordinator"]},{"type":