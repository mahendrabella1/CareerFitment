t":"Conciseness"},{"text":"Consistency"},{"text":"Fact-checking"},{"text":"Reading comprehension"}]},{"type":"p","text":"An editor should be able to identify not just what is grammatically wrong, but also what is unclear, inaccurate, repetitive, poorly structured, unsupported, or inappropriate for the intended audience."}]},{"heading":"Copyediting","kind":"other","blocks":[{"type":"p","text":"Learn to identify:"},{"type":"list","items":[{"text":"Grammar errors"},{"text":"Spelling errors"},{"text":"Punctuation errors"},{"text":"Inconsistent terminology"},{"text":"Repetition"},{"text":"Ambiguous sentences"},{"text":"Incorrect formatting"},{"text":"Citation inconsistencies"},{"text":"Capitalisation inconsistencies"},{"text":"Number/date inconsistencies"},{"text":"Broken references"},{"text":"Style-guide violations"}]},{"type":"h","text":"Editing workflow"},{"type":"flow","items":["Read","Understand","Fact-check","Structure","Edit","Verify","Proofread","Final QA"]}]},{"heading":"Developmental editing","kind":"other","blocks":[{"type":"p","text":"Move beyond grammar."},{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"Structure"},{"text":"Narrative flow"},{"text":"Argument development"},{"text":"Chapter organisation"},{"text":"Logical consistency"},{"text":"Audience fit"},{"text":"Content gaps"},{"text":"Redundancy"},{"text":"Transitions"},{"text":"Tone"},{"text":"Overall readability"}]},{"type":"p","text":"This is particularly valuable for:"},{"type":"list","items":[{"text":"Books"},{"text":"Academic publications"},{"text":"Research reports"},{"text":"Long-form journalism"},{"text":"Cultural publications"},{"text":"Educational content"}]}]},{"heading":"Digital publishing","kind":"other","blocks":[{"type":"p","text":"Learn:"},{"type":"list","items":[{"text":"WordPress"},{"text":"CMS concepts"},{"text":"Markdown"},{"text":"HTML basics"},{"text":"Web content formatting"},{"text":"Headings"},{"text":"Metadata"},{"text":"Image captions"},{"text":"Alt text"},{"tex