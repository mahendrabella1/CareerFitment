"},{"type":"p","text":"Target:"},{"type":"list","items":[{"text":"PLM Engineering Intern"},{"text":"PLM Consultant Intern"},{"text":"Digital Thread Intern"},{"text":"Manufacturing Systems Intern"},{"text":"Product Data Management Intern"},{"text":"Engineering Systems Intern"}]}]},{"heading":"Entry-Level Job Titles","kind":"other","blocks":[{"type":"p","text":"Search for:"},{"type":"list","items":[{"text":"PLM Specialist"},{"text":"PLM Analyst"},{"text":"Junior PLM Consultant"},{"text":"PLM Engineer"},{"text":"PDM Engineer"},{"text":"Product Data Analyst"},{"text":"PLM Administrator"},{"text":"Engineering Systems Analyst"},{"text":"Digital Manufacturing Engineer"},{"text":"Product Lifecycle Analyst"},{"text":"CAD/PLM Engineer"},{"text":"Manufacturing Systems Engineer"},{"text":"PLM Application Support Engineer"}]}]},{"heading":"Core Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Skill","Required Level"],"rows":[[{"text":"PLM Concepts"},{"text":"Advanced"}],[{"text":"Product Lifecycle"},{"text":"Advanced"}],[{"text":"PDM"},{"text":"Strong"}],[{"text":"BOM Management"},{"text":"Advanced"}],[{"text":"CAD"},{"text":"Strong"}],[{"text":"Engineering Change Management"},{"text":"Advanced"}],[{"text":"Workflow Configuration"},{"text":"Strong"}],[{"text":"PLM Administration"},{"text":"Strong"}],[{"text":"Manufacturing Processes"},{"text":"Strong"}],[{"text":"ERP Concepts"},{"text":"Intermediate"}],[{"text":"MES Concepts"},{"text":"Intermediate"}],[{"text":"SQL"},{"text":"Strong"}],[{"text":"Python"},{"text":"Intermediate"}],[{"text":"Java/JavaScript"},{"text":"Intermediate"}],[{"text":"REST APIs"},{"text":"Strong"}],[{"text":"Data Migration"},{"text":"Strong"}],[{"text":"Data Governance"},{"text":"Strong"}],[{"text":"Digital Thread"},{"text":"Intermediate–Strong"}],[{"text":"Digital Twin"},{"text":"Intermediate"}],[{"text":"Systems Integration"},{"text":"Strong"}]]}]},{"heading":"Employer Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Ind