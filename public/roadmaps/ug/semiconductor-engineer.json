pe":"p","text":"Understand:"},{"type":"list","items":[{"text":"Wafer yield"},{"text":"Die yield"},{"text":"Defect density"},{"text":"Critical dimension"},{"text":"Threshold voltage"},{"text":"Leakage current"},{"text":"Breakdown voltage"},{"text":"Mobility"},{"text":"Sheet resistance"},{"text":"Process capability"},{"text":"Wafer-to-wafer variation"},{"text":"Lot-to-lot variation"},{"text":"Cycle time"},{"text":"Equipment utilization"},{"text":"Reliability failure rate"}]},{"type":"p","text":"The engineer should be able to connect:"},{"type":"flow","items":["Material","Process","Device Parameter","Yield","Reliability"]}]},{"heading":"Final-Year Project Ideas","kind":"other","blocks":[{"type":"h","text":"Project 1 — MOSFET Device Simulation"},{"type":"p","text":"Model a MOSFET and study how changes in:"},{"type":"list","items":[{"text":"Channel length"},{"text":"Doping"},{"text":"Oxide thickness"},{"text":"Gate voltage"},{"text":"affect device performance."}]},{"type":"p","text":"Tools:"},{"type":"list","items":[{"text":"TCAD"},{"text":"Python/MATLAB"}]},{"type":"h","text":"Project 2 — Semiconductor Material Characterization"},{"type":"p","text":"Study a material such as:"},{"type":"list","items":[{"text":"Silicon"},{"text":"GaN"},{"text":"SiC"},{"text":"Thin-film semiconductor"}]},{"type":"p","text":"Analyze:"},{"type":"list","items":[{"text":"Structural properties"},{"text":"Optical properties"},{"text":"Electrical properties"}]},{"type":"h","text":"Project 3 — Wafer Defect Classification"},{"type":"p","text":"Build an ML model to classify semiconductor defects."},{"type":"p","text":"Workflow:"},{"type":"flow","items":["Wafer Images","Preprocessing","Feature Extraction","Classification","Defect Analysis"]},{"type":"p","text":"Possible tools:"},{"type":"list","items":[{"text":"Python"},{"text":"OpenCV"},{"text":"scikit-learn"},{"text":"PyTorch/TensorFlow"}]},{"type":"h","text":"Project 4 — Semiconductor Yield Prediction"},{"type":"p","text":"Use process parameters t