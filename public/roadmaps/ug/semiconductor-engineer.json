:"★★★★★"}],[{"text":"Python"},{"text":"★★★★☆"}],[{"text":"TCAD"},{"text":"★★★★☆"}],[{"text":"Semiconductor Characterization"},{"text":"★★★★☆"}],[{"text":"SPC/DOE"},{"text":"★★★★☆"}],[{"text":"Electronics"},{"text":"★★★★☆"}],[{"text":"Cleanroom Experience"},{"text":"★★★★☆"}],[{"text":"Communication"},{"text":"★★★★☆"}]]}]},{"heading":"Certifications & Short Courses","kind":"certifications","blocks":[{"type":"p","text":"Useful supplementary learning:"},{"type":"h","text":"Semiconductor"},{"type":"list","items":[{"text":"Semiconductor device physics"},{"text":"Semiconductor fabrication"},{"text":"VLSI technology"},{"text":"Nanofabrication"},{"text":"Semiconductor characterization"},{"text":"Semiconductor reliability"}]},{"type":"h","text":"Analytics"},{"type":"list","items":[{"text":"Python for scientific computing"},{"text":"Statistics"},{"text":"Machine learning"},{"text":"SQL"},{"text":"Data visualization"}]},{"type":"h","text":"Quality"},{"type":"list","items":[{"text":"Six Sigma Green Belt"},{"text":"Statistical Process Control"},{"text":"Design of Experiments"}]},{"type":"h","text":"Simulation"},{"type":"list","items":[{"text":"TCAD"},{"text":"COMSOL"},{"text":"MATLAB"},{"text":"Certifications are secondary to laboratory work, semiconductor projects, fabrication exposure and technical depth."}]}]},{"heading":"PG Options","kind":"pg_india","blocks":[{"type":"p","text":"For an Engineering Physics graduate targeting semiconductor engineering, postgraduate specialization can be especially valuable."},{"type":"p","text":"M.Tech / M.E."},{"type":"list","items":[{"text":"Microelectronics"},{"text":"VLSI"},{"text":"Semiconductor Technology"},{"text":"Nanotechnology"},{"text":"Materials Engineering"},{"text":"Electronics Engineering"},{"text":"Electrical Engineering"},{"text":"Semiconductor Devices"},{"text":"Materials Science"}]},{"type":"h","text":"Master's"},{"type":"list","items":[{"text":"MSc Semiconductor Technology"},{"text":"MSc Microelectronics"},{"text":"MSc Nano