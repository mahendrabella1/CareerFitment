:"Possible specializations:"},{"type":"list","items":[{"text":"Labour Law"},{"text":"Employment Law"},{"text":"Corporate Law"},{"text":"Business Law"},{"text":"Human Rights Law"},{"text":"Constitutional Law"}]},{"type":"h","text":"Management"},{"type":"list","items":[{"text":"MBA HR"},{"text":"MBA Labour Relations"},{"text":"MBA Human Resources"},{"text":"Master's in Industrial Relations"}]},{"type":"h","text":"Other"},{"type":"list","items":[{"text":"Labour Studies"},{"text":"Industrial Relations"},{"text":"Human Resource Management"},{"text":"Employment Relations"}]}]},{"heading":"Career Specializations","kind":"other","blocks":[{"type":"h","text":"1. Labour Compliance Consultant"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Statutory compliance"},{"text":"Audits"},{"text":"Registrations"},{"text":"Records"},{"text":"Regulatory requirements"}]},{"type":"h","text":"2. Employment Law Consultant"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Employment contracts"},{"text":"Termination"},{"text":"Employee disputes"},{"text":"HR policies"}]},{"type":"h","text":"3. Industrial Relations Consultant"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Trade unions"},{"text":"Collective bargaining"},{"text":"Industrial disputes"}]},{"type":"h","text":"4. Workplace Investigation Specialist"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Employee complaints"},{"text":"Internal investigations"},{"text":"Disciplinary processes"}]},{"type":"h","text":"5. HR Legal Consultant"},{"type":"p","text":"Combines:"},{"type":"flow","items":["Law","HR","compliance"],"sep":"+"},{"type":"h","text":"6. Employment Litigation Specialist"},{"type":"p","text":"Focus:"},{"type":"list","items":[{"text":"Labour disputes"},{"text":"Employment claims"},{"text":"Court/tribunal proceedings"}]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"flow","items":["LLB – Labour & Employment Law","Labour Law Internship","Legal / Com