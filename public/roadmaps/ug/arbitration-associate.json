tern"},{"text":"Commercial Litigation Intern"},{"text":"International Law Intern"},{"text":"Legal Research Intern"},{"text":"Contract Law Intern"}]},{"type":"h","text":"Ideal Progression"},{"type":"flow","items":["Legal Research Internship","Commercial Litigation","Arbitration Internship","Moot Court / Arbitration Competition","Junior Dispute Resolution Role","Arbitration Associate"]}]},{"heading":"Projects During UG","kind":"build","blocks":[{"type":"h","text":"Project 1 — Mock Arbitration"},{"type":"p","text":"Create a fictional commercial dispute."},{"type":"p","text":"Students can prepare:"},{"type":"list","items":[{"text":"Contract"},{"text":"Notice"},{"text":"Statement of claim"},{"text":"Defence"},{"text":"Evidence bundle"},{"text":"Witness statement"},{"text":"Final submissions"},{"text":"Mock award"}]},{"type":"h","text":"Project 2 — Arbitration Clause Analysis"},{"type":"p","text":"Compare arbitration clauses covering:"},{"type":"list","items":[{"text":"Seat"},{"text":"Venue"},{"text":"Governing law"},{"text":"Institutional rules"},{"text":"Arbitrator appointment"},{"text":"Language"},{"text":"Identify potential drafting risks."}]},{"type":"h","text":"Project 3 — International Arbitration Case Brief"},{"type":"p","text":"Analyse a major arbitration decision covering:"}]},{"heading":"Project 4 — Evidence Matrix","kind":"other","blocks":[{"type":"table","header":["Issue","Contract Clause","Evidence","Witness","Authority"],"rows":[[{"text":"Breach"},{"text":"Clause X"},{"text":"Document A"},{"text":"Witness 1"},{"text":"Case/Award"}],[{"text":"Damages"},{"text":"Clause Y"},{"text":"Report B"},{"text":"Expert"},{"text":"Authority"}],[{"text":"Jurisdiction"},{"text":"Clause Z"},{"text":"Contract"},{"text":"Party"},{"text":"Judgment"}]]}]},{"heading":"Moot Courts & Competitions","kind":"other","blocks":[{"type":"p","text":"Participation in arbitration moots is highly valuable."},{"type":"p","text":"Students should consider competitions involving:"},{"type":"list