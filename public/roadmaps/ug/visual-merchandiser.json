":"Visual merchandising route"},{"type":"h","text":"BBA Retail Management"},{"type":"h","text":"VM Intern"},{"type":"h","text":"Visual Merchandiser"},{"type":"h","text":"Senior Visual Merchandiser"},{"type":"h","text":"VM Team Lead"},{"type":"h","text":"VM Manager"},{"type":"h","text":"Regional VM Manager"},{"type":"h","text":"Head of Visual Merchandising"},{"type":"h","text":"Retail Experience Director"},{"type":"h","text":"Brand experience route"},{"type":"h","text":"Visual Merchandiser"},{"type":"flow","items":["Brand VM Specialist","Brand Experience Manager","Retail Experience Manager","Brand Experience Director","Chief Brand/Experience Leadership"]},{"type":"note","label":"Emerging specialisations","text":"2030–2040"},{"type":"h","text":"1. AI-assisted Visual Merchandising"},{"type":"p","text":"AI will increasingly help with:"},{"type":"list","items":[{"text":"Display concept generation"},{"text":"Store-layout alternatives"},{"text":"Customer-behaviour prediction"},{"text":"Product placement"},{"text":"Campaign personalisation"},{"text":"Visual trend analysis"}]},{"type":"p","text":"The human VM will remain responsible for brand interpretation, creative judgement and physical execution."},{"type":"h","text":"2. Digital Merchandising"},{"type":"p","text":"As physical and digital retail converge, professionals will work across:"},{"type":"flow","items":["Store","Website","App","Social Commerce"],"sep":"+"},{"type":"p","text":"Digital merchandising includes:"},{"type":"list","items":[{"text":"Product photography"},{"text":"Website layout"},{"text":"Product ranking"},{"text":"Digital banners"},{"text":"Personalised recommendations"},{"text":"Online category presentation"}]},{"type":"h","text":"3. Retail Experience Design"},{"type":"p","text":"The focus will shift from:"},{"type":"h","text":"\"How does the store look?\""},{"type":"p","text":"to:"},{"type":"h","text":"\"How does the customer experience the brand?\""},{"type":"p","text":"This includes:"},{"type":"list","items":[{"text":"Lighting"},{"text":"Music"},{"text":"Scent"},{"text":"Navigation"},{"text":"Interaction"},{"text":"Digital displays"},{"text":"Checkout experience"}]},{"type":"h","text":"4. Data-driven Merchandising"},{"type":"p","text":"Visual decisions will increasingly use:"},{"type":"list","items":[{"text":"Footfall data"},{"text":"Heat maps"},{"text":"Camera analytics"},{"text":"Sales data"},{"text":"Conversion data"},{"text":"Customer behaviour"}]},{"type":"h","text":"5. Immersive Retail"},{"type":"p","text":"Emerging experiences include:"},{"type":"list","items":[{"text":"AR product visualisation"},{"text":"Interactive displays"},{"text":"Digital mirrors"},{"text":"Virtual try-on"},{"text":"Smart shelves"},{"text":"Interactive screens"},{"text":"Mixed-reality retail"}]},{"type":"note","label":"2040–2046","text":"How the Visual Merchandiser role evolves"},{"type":"p","text":"Traditional VM:"},{"type":"flow","items":["Design display","Arrange products","Execute campaign"]},{"type":"p","text":"Future VM:"},{"type":"flow","items":["Analyse customer behaviour","Design experience","Simulate layout","Deploy","Measure","Optimise"]},{"type":"p","text":"The role increasingly becomes a combination of:"},{"type":"flow","items":["Creative Design","Retail Strategy","Consumer Psychology","Data","Technology"],"sep":"+"},{"type":"h","text":"Recommended final skill stack"},{"type":"h","text":"Visual"},{"type":"list","items":[{"text":"Visual merchandising"},{"text":"Colour theory"},{"text":"Composition"},{"text":"Typography"},{"text":"Styling"},{"text":"Photography"},{"text":"Brand guidelines"}]},{"type":"h","text":"Design"},{"type":"list","items":[{"text":"Photoshop"},{"text":"Illustrator"},{"text":"Figma"},{"text":"Canva"},{"text":"3D visualisation"},{"text":"Store-layout software"}]},{"type":"h","text":"Retail"},{"type":"list","items":[{"text":"Planograms"},{"text":"Store operations"},{"text":"Category management"},{"text":"Product placement"},{"text":"Customer journey"},{"text":"Retail campaigns"}]},{"type":"h","text":"Analytics"},{"type":"list","items":[{"text":"Excel"},{"text":"Power BI"},{"text":"Retail KPIs"},{"text":"Footfall analysis"},{"text":"Conversion analysis"},{"text":"Sell-through analysis"}]},{"type":"h","text":"Business"},{"type":"list","items":[{"text":"Budgeting"},{"text":"Vendor management"},{"text":"Project management"},{"text":"Sales analysis"},{"text":"Consumer behaviour"}]},{"type":"h","text":"Future technology"},{"type":"list","items":[{"text":"AI design tools"},{"text":"AR/VR"},{"text":"Digital signage"},{"text":"Computer vision"},{"text":"Retail analytics"},{"text":"Omnichannel merchandising"}]},{"type":"h","text":"Target progression"},{"type":"flow","items":["Retail + design fundamentals + consumer psychology","Year 2: Visual merchandising + Photoshop/Illustrator + store layouts","Year 3: Planograms + retail analytics + Power BI","Final Year: Store-design portfolio + campaign project + retail internship","0–2 Years: Visual Merchandiser","2–5 Years: Senior Visual Merchandiser","5–8 Years: VM Manager / Brand VM Manager","8–15 Years: Regional VM Manager / Head of VM","15+ Years: Retail Experience / Brand Experience Director"],"label":"Year 1"},{"type":"h","text":"Best employability combination"},{"type":"flow","items":["BBA Retail Management","VM Internship","Visual Merchandising","Consumer Psychology","Photoshop","Illustrator","Store Planning","Planograms","Retail Analytics","Excel","Power BI","Photography","AI/AR Retail Tools","strong visual portfolio"],"sep":"+"},{"type":"note","label":"Key principle","text":"A strong Visual Merchandiser is not simply someone with good design taste. The valuable professional can translate brand strategy into physical and digital experiences, understand customer behaviour, optimise product visibility, execute campaigns consistently, and prove that visual decisions improve retail performance."}]}]}