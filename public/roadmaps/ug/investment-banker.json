{"title":"Career Roadmap: Investment Banker","role":"Investment Banker","summary":"Career Domain: Business, Finance & Entrepreneurship · Qualification Pathway: Professional Certifications - CA / CS / CMA / ACCA / CFA / CPA-India – Chartered Accountancy (CA - ICAI) · Target Career: Investment Banker","facts":{"Current degree":"Professional Certifications - CA / CS / CMA / ACCA / CFA / CPA-India","Course":"Chartered Accountancy (CA - ICAI)"},"about":[{"label":"About this roadmap","text":"This roadmap was drafted with AI assistance from OneGrasp's related roadmaps and is awaiting expert review. Check fees, dates, eligibility and exam patterns on the official websites before you rely on them."}],"intro":[],"horizons":[],"sections":[{"heading":"Career Overview","kind":"other","blocks":[{"type":"p","text":"An Investment Banker helps companies raise money (IPOs, debt) and buy or merge with other companies, doing valuation, deal work and negotiations."},{"type":"h","text":"What a Investment Banker does"},{"type":"list","items":[{"text":"Build financial models and valuations"},{"text":"Prepare pitch books and offer documents"},{"text":"Run due diligence and deal processes"},{"text":"Work with clients, lawyers and regulators"}]},{"type":"p","text":"Where they work:"},{"type":"list","items":[{"text":"Investment banks and merchant bankers"},{"text":"Big 4 transaction advisory"},{"text":"Boutique M&A firms"},{"text":"Private equity (later)"}]}]},{"heading":"Career Horizons","kind":"horizons","blocks":[{"type":"table","header":["Career stage","Typical role"],"rows":[[{"text":"Entry-level"},{"text":"Analyst"}],[{"text":"Early career"},{"text":"Associate"}],[{"text":"Mid-level"},{"text":"Vice President"}],[{"text":"Senior"},{"text":"Director"}],[{"text":"Leadership"},{"text":"Managing Director"}]]}]},{"heading":"Year-by-Year Learning Roadmap","kind":"build","blocks":[{"type":"h","text":"Foundation: Basics"},{"type":"list","items":[{"text":"Clear CA Foundation"},{"text":"Read deal news daily"},{"text":"Learn Excel deeply"}]},{"type":"h","text":"Intermediate: Finance skills"},{"type":"list","items":[{"text":"Clear CA Intermediate"},{"text":"Learn financial modelling and valuation"},{"text":"Start CFA Level I if you can"}]},{"type":"h","text":"Articleship: Deal exposure"},{"type":"list","items":[{"text":"Try for a firm with transaction or valuation work"},{"text":"Build models for real cases"},{"text":"Network with bankers"}]},{"type":"h","text":"Final and career: Qualify and enter"},{"type":"list","items":[{"text":"Clear CA Final"},{"text":"Apply to IB analyst roles"},{"text":"Clear NISM Series IX (Merchant Banking)"}]}]},{"heading":"Essential Skills","kind":"build","blocks":[{"type":"table","header":["Skill","Type"],"rows":[[{"text":"Financial modelling"},{"text":"Technical"}],[{"text":"Valuation (DCF, comparables)"},{"text":"Technical"}],[{"text":"Deal documentation"},{"text":"Technical"}],[{"text":"Capital-market rules (SEBI ICDR)"},{"text":"Technical"}],[{"text":"Long hours"},{"text":"Professional"}],[{"text":"Polish and presentation"},{"text":"Professional"}],[{"text":"Negotiation"},{"text":"Professional"}]]}]},{"heading":"Tools and Technologies to Learn","kind":"build","blocks":[{"type":"list","items":[{"text":"Excel"},{"text":"PowerPoint"},{"text":"Capital IQ / Bloomberg (at firms)"}]}]},{"heading":"Internships and Practical Experience","kind":"internships","blocks":[{"type":"list","items":[{"text":"Investment banks"},{"text":"Transaction advisory teams"}]}]},{"heading":"Certifications and Additional Training","kind":"certifications","blocks":[{"type":"list","items":[{"text":"NISM Series IX - Merchant Banking"},{"text":"CFA programme"},{"text":"Financial modelling courses"}]},{"type":"note","label":"Before you enrol","text":"Check the current syllabus, fees and eligibility on the certifying body's official website."}]},{"heading":"Higher Education Options in India","kind":"pg_india","blocks":[{"type":"p","text":"Options after your degree:"},{"type":"list","items":[{"text":"MBA Finance (top schools)"},{"text":"CFA charter"}]},{"type":"p","text":"Entrance exams and tests to know:"},{"type":"list","items":[{"text":"CA exams"},{"text":"CAT (for MBA)"}]}]},{"heading":"Study Abroad Options","kind":"abroad","blocks":[{"type":"list","items":[{"text":"MBA or MSc Finance (UK, US) for global IB roles"}]}]},{"heading":"Career Opportunities","kind":"careers","blocks":[{"type":"p","text":"Roles a Investment Banker can grow into or move across to:"},{"type":"list","items":[{"text":"Equity Analyst"},{"text":"Private Equity Associate"},{"text":"Corporate Development"},{"text":"Valuation Analyst"}]}]},{"heading":"Recommended Career Progression","kind":"growth","blocks":[{"type":"flow","items":["Analyst","Associate","Vice President","Director","Managing Director"]}]}],"drafted":true}