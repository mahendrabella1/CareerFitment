y utilization"},{"text":"Storage"},{"text":"Cloud cost"},{"text":"Estimated energy"},{"text":"Estimated carbon impact"}]},{"type":"p","text":"Provide recommendations such as:"},{"type":"flow","items":["Idle Resource Detected","Rightsize Instance","Reduce Cost","Reduce Resource Consumption"]},{"type":"h","text":"Project 3 — Smart Building Energy Platform"},{"type":"p","text":"Use IoT sensors to monitor:"},{"type":"list","items":[{"text":"Electricity"},{"text":"Temperature"},{"text":"Occupancy"},{"text":"HVAC usage"},{"text":"Lighting"}]},{"type":"p","text":"Architecture:"},{"type":"flow","items":["IoT Sensors","MQTT","Cloud","Time-Series DB","Analytics","Grafana Dashboard"]},{"type":"h","text":"Project 4 — AI Energy Forecasting System"},{"type":"p","text":"Build an ML model that predicts:"},{"type":"list","items":[{"text":"Hourly energy demand"},{"text":"Daily demand"},{"text":"Peak consumption"},{"text":"Potential anomalies"}]},{"type":"p","text":"Add an optimization recommendation layer."},{"type":"p","text":"Example:"},{"type":"flow","items":["Energy History","Forecasting Model","Peak Demand Prediction","Optimization Recommendation"]},{"type":"h","text":"Project 5 — Enterprise Carbon Accounting Platform"},{"type":"p","text":"Build a simplified enterprise sustainability platform."},{"type":"p","text":"Modules:"},{"type":"p","text":"Energy Data"},{"type":"p","text":"+"},{"type":"p","text":"Travel Data"},{"type":"p","text":"+"},{"type":"p","text":"Cloud Data"},{"type":"p","text":"+"},{"type":"flow","items":["Supply Chain Data","Emission Factors","CO₂e Engine","Carbon Database","Analytics","Sustainability Dashboard"]},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Scope 1"},{"text":"Scope 2"},{"text":"Scope 3"},{"text":"Data validation"},{"text":"Reporting"},{"text":"Audit trail"}]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Target internships such as:"},{"type":"list","items":[{"text":"Sustainability Softwar