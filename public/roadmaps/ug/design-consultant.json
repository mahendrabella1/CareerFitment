"},{"text":"Colour"},{"text":"Materials"},{"text":"Furniture"},{"text":"Lighting"},{"text":"Spatial storytelling"}]},{"type":"h","text":"Technical"},{"type":"list","items":[{"text":"AutoCAD"},{"text":"SketchUp"},{"text":"Revit"},{"text":"3D modelling"},{"text":"Rendering"},{"text":"Technical drawings"},{"text":"BIM"}]},{"type":"h","text":"Materials"},{"type":"list","items":[{"text":"Wood"},{"text":"Stone"},{"text":"Glass"},{"text":"Metal"},{"text":"Ceramics"},{"text":"Fabrics"},{"text":"Sustainable materials"}]},{"type":"h","text":"Project management"},{"type":"list","items":[{"text":"BOQ"},{"text":"Estimation"},{"text":"Procurement"},{"text":"Scheduling"},{"text":"Vendor management"},{"text":"Site coordination"},{"text":"Quality control"}]},{"type":"h","text":"Client management"},{"type":"list","items":[{"text":"Requirement gathering"},{"text":"Presentation"},{"text":"Negotiation"},{"text":"Proposal writing"},{"text":"Scope management"},{"text":"Client relationship management"}]},{"type":"h","text":"Business"},{"type":"list","items":[{"text":"Pricing"},{"text":"Design fees"},{"text":"Business development"},{"text":"Sales"},{"text":"Portfolio marketing"}]},{"type":"h","text":"Future"},{"type":"list","items":[{"text":"AI"},{"text":"Generative design"},{"text":"BIM"},{"text":"Digital twins"},{"text":"VR/AR"},{"text":"Smart interiors"}]}]},{"heading":"Internships","kind":"internships","blocks":[{"type":"p","text":"Practical project experience is critical."},{"type":"h","text":"Good internship targets"},{"type":"list","items":[{"text":"Interior design studios"},{"text":"Architecture firms"},{"text":"Design consultancies"},{"text":"Hospitality design firms"},{"text":"Retail design companies"},{"text":"Workplace design firms"},{"text":"Furniture companies"},{"text":"Real-estate developers"},{"text":"Construction companies"},{"text":"Design-build companies"},{"text":"Exhibition design studios"},{"text":"Luxury interior firms"},{"text":"BIM/design technology firms"}]},{"typ