text":"Finding regulations"},{"text":"Reading judgments"},{"text":"Tracking amendments"},{"text":"Comparing provisions"},{"text":"Identifying precedent"},{"text":"Preparing legal opinions"}]},{"type":"h","text":"Research Question Example"},{"type":"p","text":"Instead of searching:"},{"type":"p","text":"\"M&A law\""},{"type":"p","text":"learn to formulate:"},{"type":"p","text":"\"What approvals are required for this specific transaction structure?\""},{"type":"p","text":"Then identify:"},{"type":"list","items":[{"text":"Governing legislation"},{"text":"Regulations"},{"text":"Relevant authorities"},{"text":"Judicial decisions"},{"text":"Current position"},{"text":"Practical implications"}]}]},{"heading":"Technology Stack","kind":"other","blocks":[{"type":"h","text":"Essential"},{"type":"list","items":[{"text":"MS Word"},{"text":"Excel"},{"text":"PowerPoint"},{"text":"PDF tools"},{"text":"Google Workspace"},{"text":"Document management systems"}]},{"type":"h","text":"Legal"},{"type":"list","items":[{"text":"Legal research databases"},{"text":"Contract management systems"},{"text":"Virtual data rooms"},{"text":"E-signature platforms"},{"text":"Legal document automation"}]},{"type":"h","text":"Advanced"},{"type":"list","items":[{"text":"Excel financial modeling"},{"text":"Power BI"},{"text":"SQL basics"},{"text":"Data-room analytics"},{"text":"Contract AI"},{"text":"Legal research AI"}]}]},{"heading":"AI in M&A","kind":"other","blocks":[{"type":"p","text":"AI can help with:"},{"type":"list","items":[{"text":"Document classification"},{"text":"Contract summarization"},{"text":"Clause extraction"},{"text":"Risk identification"},{"text":"Due-diligence organization"},{"text":"Comparing agreements"},{"text":"Creating document chronologies"},{"text":"Finding inconsistent provisions"},{"text":"Research organization"},{"text":"Drafting first-pass checklists"}]},{"type":"h","text":"AI-Assisted Due Diligence"},{"type":"flow","items":["Large Document Set","AI Classification","Relev