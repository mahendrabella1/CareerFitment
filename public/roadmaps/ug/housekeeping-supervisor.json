 Abroad","kind":"abroad","blocks":[{"type":"p","text":"Relevant programmes include:"},{"type":"h","text":"Master's in Hospitality Management"},{"type":"p","text":"For:"},{"type":"list","items":[{"text":"Hotel management"},{"text":"Resort management"},{"text":"Hospitality leadership"}]},{"type":"h","text":"Master's in Hotel Management"},{"type":"p","text":"For:"},{"type":"list","items":[{"text":"Rooms division"},{"text":"Hotel operations"}]},{"type":"h","text":"Master's in International Hospitality Management"},{"type":"p","text":"For:"},{"type":"list","items":[{"text":"International hotel groups"},{"text":"Global hospitality operations"}]},{"type":"h","text":"Master's in Hospitality Business Analytics"},{"type":"p","text":"For:"},{"type":"list","items":[{"text":"Hotel analytics"},{"text":"Operations intelligence"},{"text":"Guest analytics"}]},{"type":"h","text":"Master's in Facility Management"},{"type":"p","text":"For:"},{"type":"list","items":[{"text":"Large hotels"},{"text":"Resorts"},{"text":"Integrated property operations"}]}]},{"heading":"Career Progression","kind":"growth","blocks":[{"type":"h","text":"Route 1 — Housekeeping"},{"type":"flow","items":["Housekeeping Associate","Housekeeping Supervisor","Assistant Executive Housekeeper","Executive Housekeeper","Director of Housekeeping"]},{"type":"h","text":"Route 2 — Rooms Division"},{"type":"flow","items":["Housekeeping Supervisor","Assistant Executive Housekeeper","Rooms Division Manager","Director of Rooms","Hotel Operations Manager"]},{"type":"h","text":"Route 3 — Hotel Operations"},{"type":"flow","items":["Housekeeping Supervisor","Department Manager","Rooms Division","Operations Manager","Hotel General Manager"]},{"type":"h","text":"Route 4 — Facility Management"},{"type":"flow","items":["Housekeeping Executive","Facility Operations Executive","Facility Manager","Senior Facility Manager","Facility Head"]},{"type":"h","text":"2040–2046 Career Evolution"},{"type":"h","text":"1. Smart Housekeeping"},{"type":