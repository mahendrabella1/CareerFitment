":"p","text":"Learn:"},{"type":"list","items":[{"text":"Scheduled refreshes"},{"text":"Power Query automation"},{"text":"SQL-based reporting"},{"text":"Power BI Service"},{"text":"Automated Excel workflows"},{"text":"Email/report distribution"},{"text":"API-based data extraction"}]},{"type":"p","text":"The progression should be:"},{"type":"flow","items":["Manual Report","Repeatable Report","Automated Report","Self-service Dashboard"]}]},{"heading":"Five Recommended UG Projects","kind":"other","blocks":[{"type":"h","text":"Project 1 — Sales Reporting Dashboard"},{"type":"p","text":"Build a complete sales reporting system."},{"type":"p","text":"Include:"},{"type":"list","items":[{"text":"Revenue"},{"text":"Sales volume"},{"text":"Product performance"},{"text":"Regional performance"},{"text":"Monthly trends"},{"text":"Salesperson performance"},{"text":"Growth analysis"}]},{"type":"flow","items":["SQL","Excel","Power BI"],"sep":"+","label":"Stack"},{"type":"h","text":"Project 2 — HR Reporting Dashboard"},{"type":"p","text":"Analyze:"},{"type":"list","items":[{"text":"Employee count"},{"text":"Attrition"},{"text":"Department distribution"},{"text":"Hiring trends"},{"text":"Absenteeism"},{"text":"Tenure"},{"text":"Employee demographics where appropriate and legally/ethically handled"}]},{"type":"p","text":"Create:"},{"type":"h","text":"HR KPI Dashboard + Monthly Report"},{"type":"h","text":"Project 3 — Finance Reporting System"},{"type":"p","text":"Build a dashboard showing:"},{"type":"list","items":[{"text":"Revenue"},{"text":"Expenses"},{"text":"Budget"},{"text":"Actuals"},{"text":"Variance"},{"text":"Profitability"},{"text":"Monthly trends"},{"text":"Add automated variance calculations."}]},{"type":"h","text":"Project 4 — Customer Support Reporting"},{"type":"p","text":"Analyze:"},{"type":"list","items":[{"text":"Tickets received"},{"text":"Tickets resolved"},{"text":"Resolution time"},{"text":"SLA compliance"},{"text":"Agent performance"},{"text":"Customer satisfaction"},{"text":"Open-ticket backlog"},{"text":"Build a management dashboard with drill-down functionality."}]},{"type":"h","text":"Project 5 — Automated Reporting Pipeline"},{"type":"p","text":"Create a workflow:"},{"type":"flow","items":["CSV/API","Python","Data Cleaning","SQL Database","Power BI","Automated Dashboard"]},{"type":"p","text":"Add:"},{"type":"list","items":[{"text":"Data-quality checks"},{"text":"Refresh logic"},{"text":"KPI calculations"},{"text":"Documentation"},{"text":"This is an excellent portfolio project because it demonstrates the complete reporting lifecycle."}]}]},{"heading":"Internship Strategy","kind":"internships","blocks":[{"type":"p","text":"Target:"},{"type":"h","text":"Reporting & MIS"},{"type":"list","items":[{"text":"Reporting Intern"},{"text":"MIS Intern"},{"text":"Business Intelligence Intern"},{"text":"Data Analyst Intern"}]},{"type":"h","text":"Business Functions"},{"type":"p","text":"Look for analytics internships in:"},{"type":"list","items":[{"text":"Sales"},{"text":"Finance"},{"text":"Marketing"},{"text":"HR"},{"text":"Operations"},{"text":"Supply Chain"},{"text":"Customer Success"}]},{"type":"h","text":"What to Prioritize"},{"type":"p","text":"Choose internships where you actually work with:"},{"type":"flow","items":["SQL","Excel","Power BI","business data"],"sep":"+"},{"type":"p","text":"rather than spending most of the internship manually updating spreadsheets."}]},{"heading":"Entry-Level Career Options","kind":"careers","blocks":[{"type":"p","text":"Potential roles include:"},{"type":"h","text":"Reporting Analyst"},{"type":"list","items":[{"text":"MIS Analyst"},{"text":"Reporting Executive"},{"text":"Junior Data Analyst"},{"text":"Business Intelligence Analyst"},{"text":"BI Reporting Analyst"},{"text":"Operations Reporting Analyst"},{"text":"Sales Reporting Analyst"},{"text":"Financial Reporting Analyst"},{"text":"Marketing Reporting Analyst"},{"text":"Data Quality Analyst"},{"text":"Dashboard Analyst"}]}]},{"heading":"Empl