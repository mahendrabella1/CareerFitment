"},{"type":"h","text":"BAMS Intern"},{"type":"h","text":"Junior Ayurvedic Physician"},{"type":"h","text":"AYUSH Medical Officer"},{"type":"h","text":"Ayurvedic Physician"},{"type":"h","text":"Experienced"},{"type":"h","text":"Senior Medical Officer"},{"type":"h","text":"Senior Ayurvedic Physician"},{"type":"h","text":"Clinical Specialist"},{"type":"h","text":"Research Physician"},{"type":"h","text":"Administrative / Leadership"},{"type":"h","text":"Program Medical Officer"},{"type":"h","text":"District-level AYUSH responsibilities"},{"type":"h","text":"Public-health program leadership"},{"type":"h","text":"Hospital administration"},{"type":"h","text":"AYUSH program management"},{"type":"h","text":"Academic / Research"},{"type":"h","text":"BAMS"},{"type":"h","text":"Clinical Experience"},{"type":"h","text":"MD/MS Ayurveda"},{"type":"h","text":"Research / Teaching"},{"type":"h","text":"Assistant Professor"},{"type":"h","text":"Associate Professor"},{"type":"h","text":"Professor"},{"type":"h","text":"Academic / Research Leadership"},{"type":"p","text":"Specific government designations and promotional pathways vary by department and recruitment rules."}]},{"heading":"Employment Skill Matrix","kind":"other","blocks":[{"type":"table","header":["Employer","High-Value Skills"],"rows":[[{"text":"Government AYUSH Department"},{"text":"Clinical + Public Health + Documentation"}],[{"text":"AYUSH Hospital"},{"text":"Clinical Practice + Patient Management"}],[{"text":"Government Dispensary"},{"text":"Primary Healthcare + Community Health"}],[{"text":"Research Institute"},{"text":"Research + Clinical Knowledge"}],[{"text":"Ayurvedic Hospital"},{"text":"Ayurveda + Panchakarma + Patient Care"}],[{"text":"Public Health Program"},{"text":"Community Medicine + Data"}],[{"text":"Healthcare Organization"},{"text":"Clinical + Administration"}],[{"text":"Wellness Organization"},{"text":"Preventive Care + Lifestyle Counselling"}],[{"text":"Academic Institution"},{"text":"Clinical + Teaching