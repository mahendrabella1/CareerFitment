e"},{"type":"h","text":"Public Health"},{"type":"h","text":"Community health"},{"type":"h","text":"Health camps"},{"type":"h","text":"Preventive medicine"},{"type":"h","text":"Health education"},{"type":"h","text":"Disease surveillance concepts"}]},{"heading":"Core Clinical Skill Stack","kind":"other","blocks":[{"type":"table","header":["Skill Area","Required Capability"],"rows":[[{"text":"Ayurveda"},{"text":"Strong classical and clinical foundation"}],[{"text":"Clinical Assessment"},{"text":"History and examination"}],[{"text":"Diagnosis"},{"text":"Ayurvedic assessment + biomedical awareness"}],[{"text":"Pharmacology"},{"text":"Ayurvedic medicines and safety"}],[{"text":"Dravyaguna"},{"text":"Medicinal substances"}],[{"text":"Panchakarma"},{"text":"Procedures and patient selection"}],[{"text":"Preventive Care"},{"text":"Lifestyle and wellness"}],[{"text":"Public Health"},{"text":"Community healthcare"}],[{"text":"Documentation"},{"text":"Accurate medical records"}],[{"text":"Communication"},{"text":"Patient counselling"}],[{"text":"Referral"},{"text":"Recognizing cases requiring escalation"}],[{"text":"Ethics"},{"text":"Professional healthcare conduct"}],[{"text":"Digital Health"},{"text":"Electronic healthcare systems"}],[{"text":"Evidence-Based Practice"},{"text":"Critical evaluation of research"}]]}]},{"heading":"Patient Consultation Workflow","kind":"other","blocks":[{"type":"p","text":"A Medical Officer should develop a structured consultation process."},{"type":"h","text":"Patient Registration"},{"type":"h","text":"Chief Complaint"},{"type":"h","text":"History Taking"},{"type":"h","text":"Clinical Examination"},{"type":"h","text":"Ayurvedic Assessment"},{"type":"h","text":"Relevant Investigations"},{"type":"h","text":"Clinical Assessment"},{"type":"h","text":"Treatment Plan"},{"type":"h","text":"Patient Counselling"},{"type":"h","text":"Documentation"},{"type":"h","text":"Follow-Up"},{"type":"h","text":"Referral / Escalation When Required"}]},{"heading":"Ayurvedic Clinical Knowledge","kind":"other","blocks":[{"type":"h","text":"Develop strong understanding of:"},{"type":"h","text":"Kayachikitsa"},{"type":"h","text":"General medicine"},{"type":"h","text":"Chronic diseases"},{"type":"h","text":"Lifestyle disorders"},{"type":"h","text":"Metabolic conditions"},{"type":"h","text":"Digestive disorders"},{"type":"h","text":"Respiratory conditions"},{"type":"h","text":"Panchakarma"},{"type":"h","text":"Understand:"},{"type":"h","text":"Therapeutic rationale"},{"type":"h","text":"Patient selection"},{"type":"h","text":"Contraindications"},{"type":"h","text":"Preparation"},{"type":"h","text":"Procedure monitoring"},{"type":"h","text":"Post-procedure care"},{"type":"h","text":"Swasthavritta"},{"type":"h","text":"Focus on:"},{"type":"h","text":"Dinacharya"},{"type":"h","text":"Ritucharya"},{"type":"h","text":"Nutrition"},{"type":"h","text":"Lifestyle"},{"type":"h","text":"Preventive healthcare"},{"type":"h","text":"Health promotion"},{"type":"h","text":"Dravyaguna"},{"type":"h","text":"Study:"},{"type":"h","text":"Medicinal plants"},{"type":"h","text":"Pharmacological properties"},{"type":"h","text":"Therapeutic applications"},{"type":"h","text":"Identification"},{"type":"h","text":"Safety considerations"}]},{"heading":"Modern Medical Knowledge","kind":"other","blocks":[{"type":"p","text":"An AYUSH Medical Officer also benefits from strong biomedical understanding."},{"type":"h","text":"Maintain competence in recognizing:"},{"type":"h","text":"Hypertension"},{"type":"h","text":"Diabetes"},{"type":"h","text":"Asthma"},{"type":"h","text":"Cardiovascular disease"},{"type":"h","text":"Infections"},{"type":"h","text":"Common gastrointestinal disorders"},{"type":"h","text":"Neurological warning signs"},{"type":"h","text":"Acute emergencies"},{"type":"h","text":"Mental-health concerns"},{"type":"h","text":"Maternal emergencies"},{"type":"h","text":"Pediatric emergencies"},{"type":"p","text":"The objective is not to blur professional systems but to ensure safe clinical assessment, recognition of red flags and appropriate referral."}]},{"heading":"Emergency Recognition","kind":"other","blocks":[{"type":"p","text":"A critical competency is knowing when Ayurvedic outpatient management is inappropriate or insufficient."},{"type":"h","text":"Recognize warning signs such as:"},{"type":"h","text":"Severe chest pain"},{"type":"h","text":"Sudden neurological deficits"},{"type":"h","text":"Severe breathing difficulty"},{"type":"h","text":"Major trauma"},{"type":"h","text":"Uncontrolled bleeding"},{"type":"h","text":"Altered consciousness"},{"type":"h","text":"Severe allergic reaction"},{"type":"h","text":"Pregnancy-related emergencies"},{"type":"h","text":"Severe dehydration"},{"type":"h","text":"Suspected sepsis"},{"type":"h","text":"Workflow:"},{"type":"h","text":"Clinical Presentation"},{"type":"h","text":"Recognize Red Flags"},{"type":"h","text":"Immediate Stabilization / First Response"},{"type":"h","text":"Appropriate Referral"},{"type":"h","text":"Emergency / Specialist Care"},{"type":"h","text":"Follow-Up"}]},{"heading":"Public Health Responsibilities","kind":"other","blocks":[{"type":"p","text":"Government AYUSH Medical Officers may participate in community-oriented healthcare activities depending on the program."},{"type":"h","text":"Potential responsibilities:"},{"type":"h","text":"Community health camps"},{"type":"h","text":"Preventive-health education"},{"type":"h","text":"Lifestyle counselling"},{"type":"h","text":"Screening activities"},{"type":"h","text":"Maternal/child-health awareness"},{"type":"h","text":"Non-communicable disease programs"},{"type":"h","text":"School health initiatives"},{"type":"h","text":"Health awareness campaigns"},{"type":"h","text":"Documentation and reporting"},{"type":"h","text":"Community outreach"}]},{"heading":"Government Healthcare Skills","kind":"other","blocks":[{"type":"p","text":"For government AYUSH positions, develop knowledge of:"},{"type":"h","text":"Public-health administration"},{"type":"h","text":"Health-program implementation"},{"type":"h","text":"Government reporting"},{"type":"h","text":"Patient registers"},{"type":"h","text":"Health indicators"},{"type":"h","text":"Referral systems"},{"type":"h","text":"Community outreach"},{"type":"h","text":"Healthcare documentation"},{"type":"h","text":"Basic health statistics"},{"type":"h","text":"Team coordination"},{"type":"h","text":"A Medical Officer may work with:"},{"type":"h","text":"Nurses"},{"type":"h","text":"Pharmacists"},{"type":"h","text":"Community health workers"},{"type":"h","text":"Laboratory personnel"},{"type":"h","text":"Other medical professionals"},{"type":"h","text":"Public-health officials"},{"type":"h","text":"Administrative staff"}]},{"heading":"Documentation & Medical Records","kind":"other","blocks":[{"type":"h","text":"Develop professional skills in:"},{"type":"h","text":"Case sheets"},{"type":"h","text":"Patient history"},{"type":"h","text":"Clinical notes"},{"type":"h","text":"Prescription records"},{"type":"h","text":"Follow-up documentation"},{"type":"h","text":"Referral notes"},{"type":"h","text":"Discharge summaries"},{"type":"h","text":"Medicine records"},{"type":"h","text":"Adverse-event documentation"},{"type":"h","text":"Program reports"},{"type":"h","text":"Good documentation should be:"},{"type":"flow","items":["Accurate","Timely","Objective","Confidential","Legible/Structured"],"sep":"+"}]},{"heading":"Patient Counselling","kind":"other","blocks":[{"type":"p","text":"A strong AYUSH Medical Officer should be able to explain:"},{"type":"h","text":"Diagnosis/clinical assessment"},{"type":"h","text":"Treatment rationale"},{"type":"h","text":"Medicine usage"},{"type":"h","text":"Diet"},{"type":"h","text":"Lifestyle"},{"type":"h","text":"Follow-up"},{"type":"h","text":"Expected course"},{"type":"h","text":"Warning signs"},{"type":"h","text":"When to seek additional medical care"},{"type":"p","text":"Communication should be culturally appropriate and understandable."}]},{"heading":"Ayurvedic Medicine Safety","kind":"other","blocks":[{"type":"h","text":"Develop strong awareness of:"},{"type":"h","text":"Correct identification of medicines"},{"type":"h","text":"Dosage"},{"type":"h","text":"Contraindications"},{"type":"h","text":"Drug interactions"},{"type":"h","text":"Adverse effects"},{"type":"h","text":"Patient-specific risks"},{"type":"h","text":"Quality of medicines"},{"type":"h","text":"Storage"},{"type":"h","text":"Appropriate duration"},{"type":"h","text":"Pregnancy/lactation considerations"},{"type":"p","text":"Avoid assuming that \"natural\" automatically means risk-free."}]},{"heading":"Evidence-Based Ayurveda","kind":"other","blocks":[{"type":"p","text":"Develop the ability to critically evaluate research."},{"type":"h","text":"Learn:"},{"type":"h","text":"Clinical trial design"},{"type":"h","text":"Systematic reviews"},{"type":"h","text":"Meta-analysis"},{"type":"h","text":"Evidence hierarchy"},{"type":"h","text":"Statistical significance"},{"type":"h","text":"Effect size"},{"type":"h","text":"Confidence intervals"},{"type":"h","text":"Bias"},{"type":"h","text":"Study limitations"},{"type":"h","text":"Research ethics"},{"type":"h","text":"Evidence evaluation workflow"},{"type":"h","text":"Ayurvedic Intervention"},{"type":"h","text":"Research Question"},{"type":"h","text":"Literature Search"},{"type":"h","text":"Study Quality Assessment"},{"type":"h","text":"Clinical Evidence"},{"type":"h","text":"Risk-Benefit Assessment"},{"type":"h","text":"Appropriate Clinical Application"},{"type":"p","text":"This is especially valuable as integrative medicine increasingly intersects with modern clinical research."}]},{"heading":"Digital Healthcare Skills","kind":"other","blocks":[{"type":"h","text":"Become comfortable with:"},{"type":"h","text":"Electronic Health Records"},{"type":"h","text":"Hospital Information Systems"},{"type":"h","text":"Digital prescriptions"},{"type":"h","text":"Telemedicine platforms"},{"type":"h","text":"Patient scheduling systems"},{"type":"h","text":"Digital documentation"},{"type":"h","text":"Excel"},{"type":"h","text":"PowerPoint"},{"type":"h","text":"Electronic reporting systems"},{"type":"h","text":"Useful additional skills"},{"type":"h","text":"Basic data analysis"},{"type":"h","text":"Healthcare dashboards"},{"type":"h","text":"Medical databases"},{"type":"h","text":"Digital health platforms"}]},{"heading":"AI in AYUSH Healthcare","kind":"other","blocks":[{"type":"p","text":"AI can support healthcare workflows but should not replace professional clinical judgment."},{"type":"h","text":"Potential applications include:"},{"type":"h","text":"Clinical documentation assistance"},{"type":"h","text":"Literature searching"},{"type":"h","text":"Patient education material"},{"type":"h","text":"Research support"},{"type":"h","text":"Data analysis"},{"type":"h","text":"Appointment systems"},{"type":"h","text":"Healthcare dashboards"},{"type":"h","text":"Medical knowledge retrieval"},{"type":"h","text":"Pharmacovigilance support"},{"type":"h","text":"Safe workflow"},{"type":"h","text":"AI-Assisted Information"},{"type":"h","text":"Medical Verification"},{"type":"h","text":"Clinical Context"},{"type":"h","text":"Professional Judgment"},{"type":"h","text":"Patient-Specific Decision"},{"type":"p","text":"Never rely on unverified AI-generated recommendations for diagnosis or treatment."}]},{"heading":"Research Skills","kind":"other","blocks":[{"type":"p","text":"An aspiring Medical Officer should consider participating in:"},{"type":"h","text":"Clinical research"},{"type":"h","text":"Case reports"},{"type":"h","text":"Observational studies"},{"type":"h","text":"Public-health studies"},{"type":"h","text":"Ayurvedic intervention studies"},{"type":"h","text":"Literature reviews"},{"type":"h","text":"Epidemiological research"},{"type":"h","text":"Research portfolio"},{"type":"h","text":"Aim for:"},{"type":"h","text":"1–2 research projects"},{"type":