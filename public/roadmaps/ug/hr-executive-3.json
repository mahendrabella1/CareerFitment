:"AI productivity tools"}]},{"type":"h","text":"Professional"},{"type":"list","items":[{"text":"Communication"},{"text":"Interviewing"},{"text":"Negotiation"},{"text":"Conflict resolution"},{"text":"Business writing"},{"text":"Presentation"},{"text":"Confidentiality"},{"text":"Documentation"}]}]},{"heading":"Final Portfolio Target","kind":"other","blocks":[{"type":"p","text":"By graduation, the student should have:"},{"type":"list","items":[{"text":"1 recruitment-management project"},{"text":"1 HR analytics dashboard"},{"text":"1 employee-engagement study"},{"text":"1 HR policy/process project"},{"text":"1 integrated HR capstone"},{"text":"Advanced Excel"},{"text":"Power BI"},{"text":"Basic SQL"},{"text":"Exposure to at least one HRIS/recruitment platform"},{"text":"At least 1 HR internship"},{"text":"Practical understanding of recruitment and HR operations"},{"text":"Working awareness of Indian employment/HR compliance"}]},{"type":"h","text":"Target Graduate Profile"},{"type":"flow","items":["BBA/BMS/BBM General","Management","Organizational Behaviour","HRM","Recruitment","HR Operations","Payroll","Performance Management","Employee Engagement","Talent Management","HR Analytics","Excel","Power BI","SQL","HRIS","Internship","HR Executive","Senior HR Executive","HR Generalist/HRBP","HR Manager","Senior HR Manager","Head of HR / CHRO"]},{"type":"table","header":["1224","UG","Management","BBA / BMS / BBM (Bachelor of Business Administration / Management Studies)","BBA General","Marketing Executive"],"rows":[]}]}]}