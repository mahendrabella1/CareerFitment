n analytics"},{"text":"Near-miss analysis"},{"text":"Safety performance trends"}]},{"type":"h","text":"Advanced"},{"type":"p","text":"Explore:"},{"type":"list","items":[{"text":"BIM"},{"text":"Autodesk Construction Cloud"},{"text":"Navisworks"},{"text":"Digital inspection platforms"},{"text":"Mobile HSE management systems"},{"text":"GIS"},{"text":"IoT-based safety monitoring"}]}]},{"heading":"Safety KPIs to Understand","kind":"other","blocks":[{"type":"p","text":"Learn to track:"},{"type":"list","items":[{"text":"Total Recordable Incident Rate"},{"text":"Lost-Time Injury Frequency Rate"},{"text":"Lost-Time Injury Severity Rate"},{"text":"Near-miss frequency"},{"text":"Safety observations"},{"text":"Unsafe-act frequency"},{"text":"Unsafe-condition frequency"},{"text":"Training hours"},{"text":"Inspection completion"},{"text":"Corrective-action closure"},{"text":"Permit compliance"},{"text":"Toolbox-talk completion"}]},{"type":"p","text":"Do not focus only on injury counts. Strong safety management also uses leading indicators such as inspections, observations, training, hazard reports, and corrective-action closure."}]},{"heading":"Projects to Build","kind":"other","blocks":[{"type":"h","text":"Project 1 — Construction Site Risk Assessment"},{"type":"p","text":"Select a hypothetical building project."},{"type":"p","text":"Identify:"},{"type":"list","items":[{"text":"Construction activities"},{"text":"Hazards"},{"text":"Risk levels"},{"text":"Existing controls"},{"text":"Additional controls"},{"text":"Responsible person"},{"text":"Target completion date"}]},{"type":"note","label":"Output","text":"Professional construction risk register."},{"type":"h","text":"Project 2 — Construction Safety Audit"},{"type":"p","text":"Conduct a simulated safety audit covering:"},{"type":"list","items":[{"text":"PPE"},{"text":"Scaffolding"},{"text":"Electrical systems"},{"text":"Fire safety"},{"text":"Housekeeping"},{"text":"Excavation"},{"text":"Lifting"},{"text":"Working at height"}]},{"type":"p","text":"Create:"},{"type":"list","items":[{"text":"Audit checklist"},{"text":"Findings"},{"text":"Risk classification"},{"text":"Corrective actions"},{"text":"Closure tracker"}]},{"type":"h","text":"Project 3 — Incident Investigation"},{"type":"p","text":"Create a realistic construction incident scenario."},{"type":"p","text":"Example:"},{"type":"p","text":"Worker falls from an elevated work platform."},{"type":"p","text":"Analyze:"},{"type":"list","items":[{"text":"What happened?"},{"text":"Immediate causes"},{"text":"Contributing factors"},{"text":"Root causes"},{"text":"Failed controls"},{"text":"Corrective actions"},{"text":"Preventive actions"}]},{"type":"p","text":"Produce a professional incident investigation report."}]},{"heading":"Advanced Capstone Project","kind":"other","blocks":[{"type":"h","text":"Smart Construction Safety Management System"},{"type":"p","text":"Build a digital HSE monitoring system for a construction project."},{"type":"h","text":"Components"},{"type":"h","text":"1. Risk Register"},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Activity"},{"text":"Hazard"},{"text":"Probability"},{"text":"Severity"},{"text":"Risk score"},{"text":"Controls"}]},{"type":"h","text":"2. Incident Database"},{"type":"p","text":"Track:"},{"type":"list","items":[{"text":"Incident type"},{"text":"Date"},{"text":"Location"},{"text":"Severity"},{"text":"Root cause"},{"text":"Corrective action"}]},{"type":"h","text":"3. Safety Dashboard"},{"type":"p","text":"Use:"},{"type":"h","text":"Excel / Power BI"},{"type":"p","text":"Display:"},{"type":"list","items":[{"text":"Incident trends"},{"text":"Near misses"},{"text":"Open corrective actions"},{"text":"Inspection completion"},{"text":"Safety observations"},{"text":"Training status"}]},{"type":"h","text":"4. Optional IoT Layer"},{"type":"p","text":"Add sensors for:"},{"type":"list","items":[{"text":"Worker location"},{"text":"Gas detection"},{"text":"Temperature"},{"text":"Noise"},{"text":"Eq