,"Research Information Specialist","Research Library Leadership"]}]},{"heading":"Study abroad","kind":"abroad","blocks":[{"type":"table","header":["Country","Strong areas"],"rows":[[{"text":"🇺🇸 USA"},{"text":"Library & Information Science, Digital Libraries"}],[{"text":"🇬🇧 UK"},{"text":"Information Science, Digital Libraries"}],[{"text":"🇨🇦 Canada"},{"text":"Library Science, Archives"}],[{"text":"🇦🇺 Australia"},{"text":"Information Management, Library Science"}],[{"text":"🇳🇱 Netherlands"},{"text":"Information Science, Digital Knowledge"}],[{"text":"🇩🇪 Germany"},{"text":"Information Science, Digital Libraries"}],[{"text":"🇸🇬 Singapore"},{"text":"Information Management, Digital Knowledge"}]]},{"type":"p","text":"Useful master's areas:"},{"type":"list","items":[{"text":"Library & Information Science"},{"text":"Information Science"},{"text":"Digital Libraries"},{"text":"Archives & Records Management"},{"text":"Knowledge Management"},{"text":"Information Management"},{"text":"Data/Research Information Management"}]},{"type":"note","label":"Important","text":"Professional librarian roles can have specific qualification and accreditation requirements in different countries and institutions."}]},{"heading":"Career progression","kind":"growth","blocks":[{"type":"h","text":"Academic library pathway"},{"type":"flow","items":["Library Trainee","Assistant Librarian","Librarian","Senior Librarian","Library Manager / Deputy Librarian","University/Chief Librarian","Director of Library Services"]},{"type":"h","text":"Digital pathway"},{"type":"flow","items":["Library Intern","Digital Library Assistant","Digital Librarian","Digital Library Specialist","Digital Knowledge Manager"]},{"type":"h","text":"Research pathway"},{"type":"flow","items":["Library Assistant","Research Support Librarian","Research Librarian","Research Information Specialist","Head of Research Services"]},{"type":"note","label":"Emerging specialisations","text":"2030–2040"},{"type":"h","text":"1. AI-Powered Libraries"},{"type":"p","text":"AI will increasingly support:"},{"type":"list","items":[{"text":"Natural-language search"},{"text":"Semantic search"},{"text":"Metadata generation"},{"text":"Document classification"},{"text":"Recommendation systems"},{"text":"Research discovery"},{"text":"Knowledge extraction"}]},{"type":"p","text":"The librarian's role will increasingly shift toward information quality, verification, governance and research support."},{"type":"h","text":"2. Research Data Management"},{"type":"p","text":"Universities and research institutions will increasingly need professionals who can manage:"},{"type":"list","items":[{"text":"Research datasets"},{"text":"Data repositories"},{"text":"Metadata"},{"text":"Data documentation"},{"text":"Open research"},{"text":"Data preservation"}]},{"type":"h","text":"3. Bibliometrics & Research Intelligence"},{"type":"p","text":"Librarians can specialise in analysing:"},{"type":"list","items":[{"text":"Citations"},{"text":"Publications"},{"text":"Research impact"},{"text":"Collaboration networks"},{"text":"Institutional research performance"},{"text":"Scholarly communication"}]},{"type":"p","text":"Potential role:"},{"type":"h","text":"Research Information Analyst / Bibliometrics Specialist"},{"type":"h","text":"4. Digital Preservation"},{"type":"p","text":"Increasingly important areas include:"},{"type":"list","items":[{"text":"Digital archives"},{"text":"Born-digital materials"},{"text":"Long-term preservation"},{"text":"Digital repositories"},{"text":"Institutional memory"}]},{"type":"h","text":"5. Knowledge Management"},{"type":"p","text":"Corporate and research organisations increasingly need professionals who can manage:"},{"type":"flow","items":["Information","Knowledge","Discovery","Decision-making"]},{"type":"p","text":"This opens opportunities beyond traditional libraries."},{"type":"note","label":"2040–2046","text":"How the role evolves"},{"type":"p","text":"The traditional image of a librarian managing shelves will become increasingly outdated."},{"type":"p","text":"Routine activities such as:"},{"type":"list","items":[{"text":"Basic cataloguing"},{"text":"Search assistance"},{"text":"Circulation"},{"text":"Classification support"},{"text":"Metadata generation"}]},{"type":"p","text":"will increasingly be automated."},{"type":"p","text":"Human librarians will become more valuable for:"},{"type":"list","items":[{"text":"Research support"},{"text":"Information literacy"},{"text":"Source evaluation"},{"text":"Research data management"},{"text":"Digital preservation"},{"text":"Knowledge management"},{"text":"Copyright/information governance"},{"text":"Research analytics"},{"text":"Complex information discovery"}]},{"type":"p","text":"The future librarian is therefore increasingly a knowledge professional and information strategist."},{"type":"h","text":"Recommended final skill stack"},{"type":"h","text":"Library science"},{"type":"list","items":[{"text":"Cataloguing"},{"text":"Classification"},{"text":"Reference services"},{"text":"Collection development"},{"text":"Information retrieval"},{"text":"Library management"}]},{"type":"h","text":"Metadata"},{"type":"list","items":[{"text":"MARC"},{"text":"RDA"},{"text":"Dublin Core"},{"text":"Authority control"},{"text":"Subject indexing"}]},{"type":"h","text":"Digital"},{"type":"list","items":[{"text":"Digital libraries"},{"text":"Institutional repositories"},{"text":"OPAC"},{"text":"Library automation"},{"text":"Digital preservation"}]},{"type":"h","text":"Technology"},{"type":"list","items":[{"text":"Excel"},{"text":"SQL"},{"text":"Databases"},{"text":"Basic Python"},{"text":"Web fundamentals"},{"text":"Data visualisation"}]},{"type":"h","text":"Research"},{"type":"list","items":[{"text":"Research databases"},{"text":"Bibliometrics"},{"text":"Citation analysis"},{"text":"Research data management"},{"text":"Scholarly communication"}]},{"type":"h","text":"Emerging"},{"type":"list","items":[{"text":"AI-assisted search"},{"text":"Semantic search"},{"text":"Knowledge graphs"},{"text":"Research intelligence"},{"text":"Digital humanities"}]},{"type":"h","text":"Target progression"},{"type":"table","header":["Stage","Target"],"rows":[[{"text":"Year 1"},{"text":"Library science + information fundamentals"}],[{"text":"Year 2"},{"text":"Cataloguing + classification + metadata"}],[{"text":"Year 3"},{"text":"Digital libraries + research support + technology"}],[{"text":"Graduation"},{"text":"Library Assistant / Trainee / Junior Librarian"}],[{"text":"Years 1–3"},{"text":"Librarian + professional LIS experience"}],[{"text":"Years 3–6"},{"text":"Senior Librarian / Digital Librarian"}],[{"text":"Years 6–10"},{"text":"Library Manager / Research Information Specialist"}],[{"text":"10+ years"},{"text":"Chief Librarian / Director / Knowledge Management Leader"}]]},{"type":"h","text":"Best employability combination"},{"type":"flow","items":["BLIS/B.Lib","MLIS","cataloguing/classification","digital-library systems","metadata","research databases","SQL/data skills","bibliometrics","AI literacy","practical library experience"],"sep":"+"},{"type":"note","label":"Key principle","text":"The modern Librarian should not be limited to managing books. The strongest professionals combine information organisation, digital libraries, metadata, research support, data management and technology to help people discover, evaluate and use reliable knowledge effectively."}]}]}